/// How busy this node is, by the host's measures: the processes waiting to
/// run, the schedulers' time, and the processor, the memory and the disks
/// the host's services watch.
///
/// A program puts the library on its load path when it is compiled and
/// when it is run; report Appendix G says where an installation keeps it.
///
/// **The host's services.** `cpu`, `memory` and `disk` read the host's
/// services `cpu_sup`, `memsup` and `disksup`, which a node starts where its
/// `ernest.conf` names `cpu`, `memory` and `disk` under `measures` (report
/// §8.7). Where the service does not run, as in a program that is no node,
/// each answers `None`. `runQueue` and `schedulers` read the runtime itself,
/// and answer in any program.
///
/// **A measure.** The library `Balancer` places work by a measure, a
/// function answering a load from 0.0 to 1.0, which a program declares over
/// these: `fn busy() : Float with m = Load.schedulers(100)`, the schedulers'
/// load over a window of 100 milliseconds.
///
/// ## Examples
///
/// The processes waiting to run, none or more:
///
/// ```ernest
/// Load.runQueue() >= 0
/// // => true
/// ```
///
/// A program that is no node runs none of the host's services:
///
/// ```ernest
/// #(Load.cpu(), Load.memory(), Load.disk())
/// // => #(None, None, None)
/// ```
///
/// since 0.4.0

/// The processes ready to run and waiting for a scheduler, over all of the
/// node's schedulers, as the host counts them at the call.
///
/// ### Examples
///
/// ```ernest
/// Load.runQueue() >= 0
/// // => true
/// ```
export fn runQueue() : Int with m =
    count(Foreign.atom("total_run_queue_lengths"))

/// The fraction of the schedulers' time spent running processes over a
/// window of the next `window` milliseconds, from 0.0 to 1.0, which the call
/// waits for; a window below 1 is 1. The host keeps the schedulers' time
/// while this measures it, and as long as another process measures too.
///
/// ### Examples
///
/// ```ernest
/// {
///     let busy = Load.schedulers(10);
///     busy >= 0.0 && busy <= 1.0
/// }
/// // => true
/// ```
export fn schedulers(window : Int) : Float with m = {
    let flag = Foreign.atom("scheduler_wall_time");
    let _ = setFlag(flag, Foreign.term(true));
    let first = wallTimes(flag);
    receive {
        after Int.max(window, 1) -> Unit
    };
    let second = wallTimes(flag);
    // the host counts each process's setting: this one's is taken back,
    // and the time is kept while another's stands
    let _ = setFlag(flag, Foreign.term(false));
    let total = spent(second, totalTime) - spent(first, totalTime);
    if total > 0 then
        Int.toFloat(spent(second, activeTime) - spent(first, activeTime)) / Int.toFloat(total)
    else
        0.0
}

// A part of each scheduler's times, the active or the total, summed over
// the schedulers.
fn spent(times : List(#(Int, Int, Int)), part : (#(Int, Int, Int)) -> Int) : Int =
    List.foldLeft(times, 0, fn(acc, scheduler) = acc + part(scheduler))

// A scheduler's times as the host gives them, #(its number, the time it
// ran processes, the time it ran in all), since the host began to keep
// them: the time it ran processes.
fn activeTime(#(_, time, _) : #(Int, Int, Int)) : Int =
    time

// The time it ran in all.
fn totalTime(#(_, _, time) : #(Int, Int, Int)) : Int =
    time

/// The fraction of the processor's time busy, from 0.0 to 1.0, since the
/// calling process's previous call, by the host's `cpu_sup`, which keeps the
/// time of each process's call; `None` where the node's `measures` do not run
/// it. At a process's first call, and its first since the service started
/// again, the host does not promise the value, which is on most systems the
/// fraction since the machine started.
///
/// ### Examples
///
/// ```ernest
/// Load.cpu()
/// // => None
/// ```
export fn cpu() : Optional(Float) with m =
    if runs("cpu_sup") then Some(utilisation() / 100.0) else None

/// The fraction of the machine's memory in use, from 0.0 to 1.0, by the
/// host's `memsup`: what is not available, of the total; `None` where the
/// node's `measures` do not run it.
///
/// ### Examples
///
/// ```ernest
/// Load.memory()
/// // => None
/// ```
export fn memory() : Optional(Float) with m =
    if runs("memsup") then {
        let data = memoryData();
        let total = valued(data, "total_memory");
        let available = match valued(data, "available_memory") {
            0 -> valued(data, "free_memory")
          | known -> known
        };
        Some(if total > 0 then 1.0 - Int.toFloat(available) / Int.toFloat(total) else 0.0)
    } else
        None

// The value the host's data gives under the name, or 0 where it gives none.
fn valued(data : List(#(Foreign.Term, Int)), name : String) : Int = {
    let key = Foreign.atom(name);
    match List.find(data, fn(#(named, _)) = named == key) {
        Some(#(_, value)) -> value
      | None -> 0
    }
}

/// The fraction used of the fullest of the machine's disks, from 0.0 to
/// 1.0, by the host's `disksup`, which reads them every half hour unless
/// `measures` says otherwise; `None` where the node's `measures` do not run
/// it.
///
/// ### Examples
///
/// ```ernest
/// Load.disk()
/// // => None
/// ```
export fn disk() : Optional(Float) with m =
    if runs("disksup") then
        Some(Int.toFloat(List.foldLeft(diskData(),
                                       0,
                                       fn(fullest, #(_, _, used)) = Int.max(fullest, used)))
                 / 100.0)
    else
        None

// Whether the host's service runs on the node, by its registered name.
fn runs(service : String) : Bool with m =
    registered(Foreign.atom(service)) != Foreign.atom("undefined")

//
// The tests (report §9.3), run by `ern test` as every library's are. A
// regression test, written after the code, returned here from the
// integration tests by MVP 3.1, under which a test, a binding, keeps no
// function of the module from a peer (report §8.7): the measure left its
// setting of the host's keeping of the schedulers' time standing where the
// host kept the time already.
//

let schedulersTakeBack =
    Test.Case(name = "a measure of the schedulers takes back its own setting of the host's keeping",
              run = fn() = {
                  let flag = Foreign.atom("scheduler_wall_time");
                  let _ = setFlag(flag, Foreign.term(true));
                  let _ = schedulers(1);
                  let _ = setFlag(flag, Foreign.term(false));
                  Test.equal(statistic(flag) != Foreign.atom("undefined"), false)
              })

//
// The host's functions
//

foreign fn count(item : Foreign.Term) : Int with m =
    "erlang:statistics/1"

foreign fn wallTimes(item : Foreign.Term) : List(#(Int, Int, Int)) with m =
    "erlang:statistics/1"

foreign fn statistic(item : Foreign.Term) : Foreign.Term with m =
    "erlang:statistics/1"

foreign fn setFlag(flag : Foreign.Term, value : Foreign.Term) : Bool with m =
    "erlang:system_flag/2"

foreign fn registered(name : Foreign.Term) : Foreign.Term with m =
    "erlang:whereis/1"

foreign fn utilisation() : Float with m =
    "cpu_sup:util/0"

foreign fn memoryData() : List(#(Foreign.Term, Int)) with m =
    "memsup:get_system_memory_data/0"

foreign fn diskData() : List(#(Foreign.Term, Int, Int)) with m =
    "disksup:get_disk_data/0"
