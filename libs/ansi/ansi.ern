/// Styles and cursor movement for text written to a terminal.
///
/// Use it to make a program's output bold, coloured or underlined, or to redraw
/// part of the screen. Each function answers a string of ECMA-48's control
/// sequences, the standard a terminal speaks, which the program writes with
/// `Io.print` (report Appendix G.3). Reading keys and the terminal's size is
/// `Terminal`'s work.
///
/// A program puts the library on its load path when it is compiled and
/// when it is run; report Appendix G says where an installation keeps it.
///
/// **Only for a terminal.** The sequences mean something to a terminal alone;
/// written to a file or a pipe they are kept as bytes. `Terminal.size` answers
/// `Left(NotATerminal)` where standard output is not a terminal, which tells a
/// program to leave them out.
///
/// **Styled text lines up.** `Terminal.columns` counts styled text as its text,
/// so it lines up as plain text does.
///
/// ## Examples
///
/// A word in bold, then the rest of the screen cleared, as the sequences they
/// write:
///
/// ```ernest
/// Ansi.styled("warning", Ansi.Bold) <> Ansi.clearBelow
/// // => "\u{1B}[1mwarning\u{1B}[22m\u{1B}[J"
/// ```
///
/// ## See also
///
/// `Terminal.columns` for the columns styled text takes, `Io.print` to
/// write it.
///
/// since 0.2.0

/// The eight colours of ECMA-48.
///
/// ### Examples
///
/// ```ernest
/// Ansi.Foreground(Ansi.Red)
/// // => Foreground(Red)
/// ```
export type Colour = Black | Red | Green | Yellow | Blue | Magenta | Cyan | White

/// How text is drawn: bold or dim, in italics, underlined, or in a colour.
///
/// ### Examples
///
/// ```ernest
/// Ansi.styled("warning", Ansi.Bold)
/// // => "\u{1B}[1mwarning\u{1B}[22m"
/// ```
export type Style = Bold | Dim | Italic | Underline | Foreground(Colour)

/// `text` in `style`, the style turned off after it.
///
/// The code that turns it off turns off every style of its kind: `Bold` and
/// `Dim` are one kind, `Italic` one, `Underline` one, and the colours one. So a
/// style of another kind around the text stays on, and one of the same kind is
/// turned off with it: a colour around a colour, italics around italics, `Bold`
/// around `Dim`.
///
/// ### Examples
///
/// ```ernest
/// Ansi.styled("fault", Ansi.Foreground(Ansi.Red))
/// // => "\u{1B}[31mfault\u{1B}[39m"
/// ```
export fn styled(text : String, style : Style) : String = {
    let #(on, off) = match style {
        Bold -> #("1", "22")
      | Dim -> #("2", "22")
      | Italic -> #("3", "23")
      | Underline -> #("4", "24")
      | Foreground(colour) -> #("3" <> Int.toString(colourCode(colour)), "39")
    };
    sequence(on <> "m") <> text <> sequence(off <> "m")
}

fn colourCode(colour : Colour) : Int =
    match colour {
        Black -> 0
      | Red -> 1
      | Green -> 2
      | Yellow -> 3
      | Blue -> 4
      | Magenta -> 5
      | Cyan -> 6
      | White -> 7
    }

/// The sequence that moves the cursor up `count` rows, or `""` where `count` is
/// below 1.
///
/// ### Examples
///
/// ```ernest
/// Ansi.up(2)
/// // => "\u{1B}[2A"
/// ```
export fn up(count : Int) : String =
    move(count, "A")

/// The sequence that moves the cursor down `count` rows, or `""` where `count`
/// is below 1.
///
/// ### Examples
///
/// ```ernest
/// Ansi.down(0)
/// // => ""
/// ```
export fn down(count : Int) : String =
    move(count, "B")

/// The sequence that moves the cursor left `count` columns, or `""` where
/// `count` is below 1.
///
/// ### Examples
///
/// ```ernest
/// Ansi.left(3)
/// // => "\u{1B}[3D"
/// ```
export fn left(count : Int) : String =
    move(count, "D")

/// The sequence that moves the cursor right `count` columns, or `""` where
/// `count` is below 1.
///
/// ### Examples
///
/// ```ernest
/// Ansi.right(1)
/// // => "\u{1B}[1C"
/// ```
export fn right(count : Int) : String =
    move(count, "C")

fn move(count : Int, direction : String) : String =
    if count < 1 then "" else sequence(Int.toString(count) <> direction)

/// The sequence that erases from the cursor to the end of the screen.
///
/// ### Examples
///
/// ```ernest
/// "\r" <> Ansi.clearBelow
/// // => "\r\u{1B}[J"
/// ```
export let clearBelow = sequence("J")

/// The sequence that erases the screen and puts the cursor at its top left.
///
/// ### Examples
///
/// ```ernest
/// Ansi.clearScreen
/// // => "\u{1B}[2J\u{1B}[H"
/// ```
export let clearScreen = sequence("2J") <> sequence("H")

// ECMA-48's control sequence introducer and what follows it.
fn sequence(body : String) : String =
    "\u{1b}[" <> body
