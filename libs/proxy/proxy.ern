/// A proxy for a service a peer offers: one address for the service across
/// its end and its return.
///
/// A program puts the library on its load path when it is compiled and
/// when it is run; report Appendix G says where an installation keeps it.
///
/// **What it does.** `start` spawns the proxy's process, which finds the
/// service and forwards to it each message it is sent, and answers the
/// proxy's address, which the program sends to. When the find fails, the
/// service ends or its node is lost, the process finds the service again
/// when the next message comes; a message that comes while a find is under
/// way waits for it and shares its outcome, so that one find is under way at
/// a time. A message that comes
/// while the service is away, and whose find fails, goes to the last address
/// held, where it is lost as a message to an ended process is, or reaches the
/// service where its node is back; a call through the proxy's address then
/// answers `None` at its own time, which says nothing of whether the request
/// ran. A service the configuration does not list is never found. A find that
/// answers `OtherType` is no absence but a protocol the two builds disagree
/// on: the process faults, naming the service, and the address is dead from
/// then on. At a shell prompt the caller is the input's process, which ends
/// with the input, so a proxy used from the prompt is started in a process
/// that lives on. `start` spawns two processes, the forwarder and one that
/// ends at once and stands where no address has been found. The process ends
/// with the process that called `start`.
///
/// **What it is not.** It is an ordinary process on the message's way: a
/// message through it may pass one sent to the service directly, and it
/// keeps nothing of a message it could not deliver. A program that is to
/// monitor the service itself holds the address `Peer.find` gives (report
/// §8.7).
///
/// ## Examples
///
/// A client of the counter, whose calls go to the counter wherever it is
/// back:
///
/// ```ernest
/// {
///     let service : Peer.Service(Int) = Peer.service("counter");
///     Proxy.start(service, 5000)
/// }
/// ```
///
/// since 0.4.0

// What the proxy's process takes: a message for the service, and the end
// of the service it holds or of the process that started it.
type Msg(m) = Message(m) | Went(Down)

/// Spawns the process of a proxy for `service`, and answers the proxy's
/// address. The process finds the service within `ms` milliseconds, and again
/// within `ms` at the first message after the find failed, the service ended
/// or its node was lost, a message that comes during a find sharing its
/// outcome, and forwards each message to the service. A message that comes
/// while the service is away and whose find fails goes to the last address
/// held, lost where that process has ended (report §6.2); a call through the
/// address then answers `None` at its own time. A find that answers
/// `OtherType` faults the process with a cause that names the service by its
/// name, `the service counter is offered at another type`. The process ends
/// with the process that called `start`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let service : Peer.Service(Int) = Peer.service("counter");
///     send(Proxy.start(service, 5000), 1)
/// }
/// ```
export fn start(service : Peer.Service(m), ms : Int) : Address(m) with n = {
    let caller = Process.fromAddress(self());
    let proxy = spawn(fn() : Unit with Msg(m) = {
        monitor(caller, Went);
        // where a message goes while the service has never been found: a
        // process that has ended, at which a message is lost (report §6.2)
        let nowhere : Address(m) = spawn(fn() : Unit with m = Unit);
        let #(address, present) = found(service, ms, nowhere);
        held(service, ms, caller, shared(address, present))
    });
    adapted(proxy, Message)
}

// The address the next message goes to, and whether it is the service's:
// the service's where a find gives it, monitored from then on, and else
// `away`, where the service was last, which may have ended. A service
// offered at another type is no absence, and no later find mends it: the
// process faults.
fn found(service : Peer.Service(m), ms : Int, away : Address(m)) : #(Address(m), Bool) with Msg(m) =
    match Peer.find(service, ms) {
        Right(address) -> {
            monitor(Process.fromAddress(address), Went);
            #(address, true)
        }
      | Left(Io.OtherType) ->
            fault("the service " <> Peer.name(service) <> " is offered at another type")
      | Left(_) -> #(away, false)
    }

// The target a find gave, each message that came while the find was under
// way sent to it first, so that one find is under way at a time: the
// messages the mailbox holds now, none waited for.
fn shared(address : Address(m), present : Bool) : #(Address(m), Bool) with Msg(m) =
    receive {
        Message(message) -> {
            send(address, message);
            shared(address, present)
        }
      | after 0 -> #(address, present)
    }

// Each message forwarded, the service found again first where it is away,
// until the process that started this one ends.
fn held(service : Peer.Service(m),
        ms : Int,
        caller : Process,
        target : #(Address(m), Bool)) : Unit with Msg(m) =
    receive {
        Message(message) -> match target {
            #(address, true) -> {
                send(address, message);
                held(service, ms, caller, target)
            }
          | #(away, false) -> {
                let #(address, present) = found(service, ms, away);
                send(address, message);
                held(service, ms, caller, shared(address, present))
            }
        }
      | Went(down) -> if down.process == caller then
            Unit
        else
            held(service, ms, caller, without(target, down.process))
    }

// The target, no longer the service's where the process that ended is the
// service.
fn without(target : #(Address(m), Bool), ended : Process) : #(Address(m), Bool) =
    match target {
        #(address, true) -> #(address, Process.fromAddress(address) != ended)
      | #(_, false) -> target
    }

//
// The tests (report §9.3), run by `ern test` as every library's are, in a
// program that is no node, where a find answers `NotListed` (report §8.7):
// what a proxy does while its service is away. Its finding the
// service, and finding it again after the service's node restarts, are the
// real nodes' (test/ern_nodes_tests.erl). Regression tests, written after
// the code.
//

// A service's protocol, which carries a reply.
type Probe = Ask(reply : Reply(Int))

// What the test of the process's end takes.
type Seen = Started(Process) | Ended(Down)

let away =
    Test.Case(name = "a call through a proxy whose service is away answers None", run = fn() = {
        let service : Peer.Service(Probe) = Peer.service("probe");
        let proxy = start(service, 100);
        let first = Address.call(proxy, fn(reply) = Ask(reply = reply), 100);
        let second = Address.call(proxy, fn(reply) = Ask(reply = reply), 100);
        Test.equal(#(first, second), #(None, None))
    })

let endsWithItsCaller =
    Test.Case(name = "a proxy's process ends with the process that started it", run = fn() = {
        let me = self();
        let starter = spawn(fn() : Unit with Unit = {
            let service : Peer.Service(Probe) = Peer.service("probe");
            send(me, Started(Process.fromAddress(start(service, 100))));
            receive {
                _ -> Unit
            }
        });
        receive {
            Started(proxy) -> {
                monitor(proxy, Ended);
                send(starter, Unit);
                receive {
                    Ended(down) -> Test.equal(down.reason, Returned)
                  | Started(_) -> Test.Failed("a second start")
                }
            }
          | Ended(_) -> Test.Failed("an end before the start")
        }
    })
