/// CommonMark 0.31, the specification at commonmark.org, read into blocks
/// and inlines, and rendered as text for a terminal or as a manual page.
/// `parse` reads the blocks a document is made of, headings, paragraphs,
/// code blocks, block quotes, lists, and thematic breaks, and inside them
/// code spans, emphasis, strong emphasis, links, images, and hard line
/// breaks; `render` lays them out at a width, and `roff` writes them as a
/// manual page in the roff of man(7). What it does not read is kept as
/// written: an HTML block is a `Raw` block, and inline HTML, an entity, and
/// a link by reference stay in the text. An HTML block begins with a
/// comment, a declaration, a processing instruction, or a tag alone on its
/// line, and a tag alone does not end a paragraph. Emphasis follows a
/// simpler rule than the specification's: a mark opens before a character
/// other than a space and closes after one, the nearest run of as many
/// marks closes it, and a run of three or more is text. A tab in a line's
/// indentation, quote marks and list markers reaches to the next multiple
/// of four columns, and one elsewhere is kept, in a code block's content as
/// in text. A line may end in a line feed, a carriage return and a line
/// feed, or a carriage return. A program puts the library on its load path, when it is compiled
/// and when it is run.
///
/// ## Examples
///
/// ```ernest
/// Markdown.render(Markdown.parse("# Title\n\nSome *words*."), 80, Markdown.Plain)
/// // => ["Title", "", "Some *words*."]
/// ```
///
/// ```ernest
/// Markdown.render(Markdown.parse("- one\n- two"), 80, Markdown.Plain)
/// // => ["• one", "• two"]
/// ```
///
/// ## See also
///
/// `String.lines`, which `parse` splits a document with.
///
/// since 0.1.0

/// A span of text inside a block.
///
/// ### Examples
///
/// ```ernest
/// Markdown.Link(address = "https://example.org", text = [Markdown.Text("home")])
/// // => Link(address = "https://example.org", text = [Text("home")])
/// ```
export type Inline =
    /// Text as it reads.
    Text(String)
  /// A code span, its text taken literally.
  | CodeSpan(String)
  /// Emphasis, shown in italics.
  | Emphasis(List(Inline))
  /// Strong emphasis, shown bold.
  | Strong(List(Inline))
  /// A link or an image, by the text it shows and the address it names.
  | Link(text : List(Inline), address : String)
  /// A hard line break.
  | Break

/// A block of a document.
///
/// ### Examples
///
/// ```ernest
/// Markdown.Heading(level = 2, text = [Markdown.Text("Usage")])
/// // => Heading(level = 2, text = [Text("Usage")])
/// ```
export type Block =
    /// A heading, its level from 1 to 6.
    Heading(level : Int, text : List(Inline))
  /// A paragraph.
  | Paragraph(List(Inline))
  /// A code block: the info string after its opening fence, empty for an
  /// indented one, and its lines.
  | Code(info : String, lines : List(String))
  /// A block quote.
  | Quote(List(Block))
  /// A list: the number its first item carries, `None` for a bullet list,
  /// and the blocks of each item.
  | Items(start : Optional(Int), items : List(List(Block)))
  /// A thematic break.
  | Rule
  /// Lines that are not read, an HTML block's, kept as written.
  | Raw(List(String))

/// How `render` writes a document: each span as it is written, or with
/// the terminal's styles.
///
/// ### Examples
///
/// ```ernest
/// Markdown.render(Markdown.parse("Some *words*."), 80, Markdown.Plain)
/// // => ["Some *words*."]
/// ```
export type Style =
    /// Emphasis, strong emphasis and code spans as they are written.
    Plain
  /// Bold, italics and colour, in the terminal's escape sequences.
  | Styled

/// What a manual page's header and its NAME line say: the page's name, the
/// section of the manual it is in, what follows the name on the NAME line,
/// the source the footer names, and the title of the manual the header
/// names.
///
/// ### Examples
///
/// ```ernest
/// Markdown.Manual(name = "ern",
///                 section = "1",
///                 summary = [Markdown.Text("the Ernest toolchain")],
///                 source = "Ernest 0.1.0",
///                 title = "Ernest Manual").section
/// // => "1"
/// ```
export type Manual =
    Manual(name : String, section : String, summary : List(Inline), source : String, title : String)

//
// Reading the blocks
//

/// The blocks of the document, in order.
///
/// ### Examples
///
/// ```ernest
/// Markdown.parse("## Usage\n\nRun `ern`")
/// // => [Heading(level = 2, text = [Text("Usage")]), Paragraph([Text("Run "), CodeSpan("ern")])]
/// ```
export fn parse(text : String) : List(Block) =
    blocks(String.lines(lineFeeds(text)))

// Report §2.2 reads CommonMark 0.31, whose lines may end in a carriage return
// too, alone or before the line feed.
fn lineFeeds(text : String) : String =
    String.replace(String.replace(text, "\r\n", "\n"), "\r", "\n")

fn blocks(lines : List(String)) : List(Block) =
    match lines {
        [] -> []
      | line :: rest -> if isBlank(line) then
            blocks(rest)
        else {
            let #(b, later) = block(line, rest);
            b :: blocks(later)
        }
    }

// The block that begins at a line that is not blank, and the lines after it:
// the first kind of block that begins there, and a paragraph where none does.
fn block(line : String, rest : List(String)) : #(Block, List(String)) =
    if indent(line) >= 4 then indented(line :: rest, []) else begun(starts(), line, rest)

fn begun(tries : List((String, List(String)) -> Optional(#(Block, List(String)))),
         line : String,
         rest : List(String)) : #(Block, List(String)) =
    match tries {
        [] -> paragraph(rest, [unindented(line)])
      | start :: more -> match start(line, rest) {
            Some(found) -> found
          | None -> begun(more, line, rest)
        }
    }

// Each kind of block that may begin at a line, in the order they are tried;
// a function rather than a `let`, which would be a cycle, since they reach back to it (§8.5).
fn starts() : List((String, List(String)) -> Optional(#(Block, List(String)))) =
    [headingStart, ruleStart, fenceStart, quoteStart, listStart, htmlStart]

fn headingStart(line : String, rest : List(String)) : Optional(#(Block, List(String))) =
    Optional.map(atx(unindented(line)), fn(h) = #(h, rest))

fn ruleStart(line : String, rest : List(String)) : Optional(#(Block, List(String))) =
    if isRule(unindented(line)) then Some(#(Rule, rest)) else None

fn fenceStart(line : String, rest : List(String)) : Optional(#(Block, List(String))) =
    Optional.map(fenceOf(unindented(line)),
                 fn(#(mark, size, info)) = fenced(mark, size, info, indent(line), rest, []))

fn quoteStart(line : String, rest : List(String)) : Optional(#(Block, List(String))) =
    if String.startsWith(unindented(line), ">") then Some(quoted(line :: rest, [])) else None

fn listStart(line : String, rest : List(String)) : Optional(#(Block, List(String))) =
    Optional.map(markerOf(unindented(line)), fn(m) = listed(line :: rest, m, []))

fn htmlStart(line : String, rest : List(String)) : Optional(#(Block, List(String))) =
    if isHtml(unindented(line)) then Some(raw(line :: rest, [])) else None

// Whether a line begins a block other than a paragraph, and so ends one.
fn interrupts(line : String) : Bool =
    indent(line) < 4
        && {
            let s = unindented(line);
            atx(s) != None
                || isRule(s)
                || fenceOf(s) != None
                || String.startsWith(s, ">")
                || htmlOpens(s)
                || interruptingMarker(s)
        }

// A list interrupts a paragraph only with an item that is not empty, and
// an ordered one only when it starts at 1.
fn interruptingMarker(s : String) : Bool =
    match markerOf(s) {
        Some(Marker(start = start, width = width)) ->
            !isBlank(String.slice(s, width, String.size(s) - width))
                && (start == None || start == Some(1))
      | None -> false
    }

// A tab stands for the spaces to the next multiple of four columns where
// it decides a line's structure: in the line's prefix of indentation, quote
// marks and list markers. Elsewhere it is kept, in a code block's content
// as in text.
fn structured(line : String) : String =
    String.fromList(prefixExpanded(String.toList(line), 0))

fn prefixExpanded(chars : List(Char), col : Int) : List(Char) =
    match chars {
        '\t' :: rest -> List.repeat(' ', 4 - col % 4) <> prefixExpanded(rest, col + 4 - col % 4)
      | c :: rest when c == ' '
            || c == '>'
            || c == '-'
            || c == '*'
            || c == '+'
            || c == '.'
            || c == ')'
            || Char.isAsciiDigit(c) -> c :: prefixExpanded(rest, col + 1)
      | other -> other
    }

fn isBlank(line : String) : Bool =
    String.isEmpty(String.trim(line))

fn indent(line : String) : Int = {
    let #(spaces, _) = List.span(String.toList(structured(line)), fn(c) = c == ' ');
    List.size(spaces)
}

fn unindented(line : String) : String = {
    let s = structured(line);
    String.slice(s, indent(line), String.size(s))
}

// A line without the first n columns of its indentation, or all of them
// where it has fewer; a tab that reaches past the n columns leaves the
// spaces it stands for there, and the rest of the line is as written.
fn dedented(line : String, n : Int) : String =
    String.fromList(cut(String.toList(line), 0, n))

fn cut(chars : List(Char), col : Int, n : Int) : List(Char) =
    if col >= n then
        chars
    else match chars {
        ' ' :: rest -> cut(rest, col + 1, n)
      | '\t' :: rest -> {
            let next = col + 4 - col % 4;
            if next <= n then cut(rest, next, n) else List.repeat(' ', next - n) <> rest
        }
      | _ -> chars
    }

//
// Headings, thematic breaks, and code
//

// A heading of one to six `#`s and the space after them, the closing `#`s
// dropped.
fn atx(s : String) : Optional(Block) = {
    let #(marks, rest) = List.span(String.toList(s), fn(c) = c == '#');
    let level = List.size(marks);
    let text = String.fromList(rest);
    if level < 1 || level > 6 then
        None
    else if String.isEmpty(text) then
        Some(Heading(level = level, text = []))
    else if !String.startsWith(text, " ") then
        None
    else
        Some(Heading(level = level, text = inlines(closed(String.trim(text)))))
}

fn closed(text : String) : String = {
    let chars = List.reverse(String.toList(text));
    let #(marks, rest) = List.span(chars, fn(c) = c == '#');
    match #(marks, rest) {
        #([], _) -> text
      | #(_, []) -> ""
      | #(_, ' ' :: _) -> String.trim(String.fromList(List.reverse(rest)))
      | _ -> text
    }
}

// Three or more of one of `-`, `*`, `_`, spaces between them allowed.
fn isRule(s : String) : Bool =
    match List.filter(String.toList(s), fn(c) = c != ' ') {
        first :: rest ->
            (first == '-' || first == '*' || first == '_')
                && List.size(rest) >= 2
                && List.all(rest, fn(c) = c == first)
      | [] -> false
    }

// An opening fence: its character, its length, and its info string.
fn fenceOf(s : String) : Optional(#(Char, Int, String)) =
    match String.toList(s) {
        c :: _ when c == '`' || c == '~' -> {
            let #(marks, rest) = List.span(String.toList(s), fn(d) = d == c);
            let info = String.trim(String.fromList(rest));
            if List.size(marks) < 3 || (c == '`' && String.contains(info, "`")) then
                None
            else
                Some(#(c, List.size(marks), info))
        }
      | _ -> None
    }

// A fenced block runs to a closing fence of its character at least as
// long as the opening one, or to the end of the document; its lines lose
// the indentation the opening fence had.
fn fenced(mark : Char,
          size : Int,
          info : String,
          by : Int,
          lines : List(String),
          done : List(String)) : #(Block, List(String)) =
    match lines {
        [] -> #(Code(info = info, lines = List.reverse(done)), [])
      | line :: rest -> if closes(line, mark, size) then
            #(Code(info = info, lines = List.reverse(done)), rest)
        else
            fenced(mark, size, info, by, rest, dedented(line, by) :: done)
    }

fn closes(line : String, mark : Char, size : Int) : Bool =
    indent(line) < 4
        && {
            let #(marks, rest) = List.span(String.toList(unindented(line)), fn(c) = c == mark);
            List.size(marks) >= size && isBlank(String.fromList(rest))
        }

// An indented block is its lines indented four columns or more, the blank
// lines between them included and those after them left.
fn indented(lines : List(String), done : List(String)) : #(Block, List(String)) =
    match lines {
        line :: rest when isBlank(line) || indent(line) >= 4 ->
            indented(rest, dedented(line, 4) :: done)
      | _ -> {
            let #(blanks, kept) = List.span(done, isBlank);
            #(Code(info = "", lines = List.reverse(kept)), List.map(blanks, fn(_) = "") <> lines)
        }
    }

//
// Block quotes, lists, HTML, and paragraphs
//

// A block quote is its lines that begin with `>`, without it and a space
// after it, and the lines of a paragraph that continue it lazily.
fn quoted(lines : List(String), done : List(String)) : #(Block, List(String)) =
    match lines {
        line :: rest when indent(line) < 4 && String.startsWith(unindented(line), ">") -> {
            let s = String.slice(unindented(line), 1, String.size(unindented(line)) - 1);
            quoted(rest, (if String.startsWith(s, " ") then dedented(s, 1) else s) :: done)
        }
      | line :: rest when continues(line, done) -> quoted(rest, line :: done)
      | _ -> #(Quote(blocks(List.reverse(done))), lines)
    }

// A line continues a paragraph lazily when the line before it was
// paragraph text, and not a heading, a rule or a fence, and it begins no
// block of its own.
fn continues(line : String, done : List(String)) : Bool =
    match done {
        previous :: _ ->
            !isBlank(line)
                && !isBlank(previous)
                && !interrupts(line)
                && indent(previous) < 4
                && paragraphText(unindented(previous))
      | [] -> false
    }

fn paragraphText(s : String) : Bool =
    atx(s) == None && !isRule(s) && fenceOf(s) == None

// A list item's marker: the number an ordered item carries, the character
// that makes it, a bullet or the delimiter after the number, and the
// columns up to the item's text.
type Marker = Marker(start : Optional(Int), mark : Char, width : Int)

fn markerOf(s : String) : Optional(Marker) =
    match String.toList(s) {
        c :: rest when c == '-' || c == '*' || c == '+' -> spaced(None, c, 1, rest)
      | chars -> {
            // a list number is ASCII digits, where `Char.isDigit` is any script's
            let #(digits, rest) = List.span(chars, Char.isAsciiDigit);
            match rest {
                d :: later when (d == '.' || d == ')') && digits != [] && List.size(digits) <= 9 ->
                    spaced(String.toInt(String.fromList(digits)), d, List.size(digits) + 1, later)
              | _ -> None
            }
        }
    }

// The marker is followed by one to four spaces, or by the end of the
// line; more than four leave the rest to the item as indentation.
fn spaced(start : Optional(Int), mark : Char, size : Int, rest : List(Char)) : Optional(Marker) = {
    let #(spaces, text) = List.span(rest, fn(c) = c == ' ');
    let n = List.size(spaces);
    if text == [] || n > 4 then
        Some(Marker(start = start, mark = mark, width = size + 1))
    else if n == 0 then
        None
    else
        Some(Marker(start = start, mark = mark, width = size + n))
}

// A list is its items while each begins with a marker of the same kind.
fn listed(lines : List(String),
          first : Marker,
          items : List(List(Block))) : #(Block, List(String)) =
    match lines {
        line :: rest -> match markerOf(unindented(line)) {
            Some(Marker(width = width) as m) when indent(line) < 4 && sameKind(m, first) -> {
                let at = indent(line) + width;
                let laid = structured(line);
                let text = String.slice(laid, at, String.size(laid) - at);
                let #(body, later) = itemLines(rest, at, [text]);
                let more = items <> [blocks(body)];
                match later {
                    next :: _ when isBlank(next) -> {
                        let #(_, beyond) = List.span(later, isBlank);
                        match beyond {
                            b :: _ when startsItem(b, first) -> listed(beyond, first, more)
                          | _ -> #(listOf(first, more), later)
                        }
                    }
                  | _ -> listed(later, first, more)
                }
            }
          | _ -> #(listOf(first, items), lines)
        }
      | [] -> #(listOf(first, items), [])
    }

fn listOf(marker : Marker, items : List(List(Block))) : Block =
    Items(start = marker.start, items = items)

fn sameKind(a : Marker, b : Marker) : Bool =
    match #(a, b) {
        #(Marker(start = None, mark = x), Marker(start = None, mark = y)) -> x == y
      | #(Marker(start = Some(_), mark = x), Marker(start = Some(_), mark = y)) -> x == y
      | _ -> false
    }

fn startsItem(line : String, first : Marker) : Bool =
    indent(line) < 4
        && match markerOf(unindented(line)) {
            Some(m) -> sameKind(m, first)
          | None -> false
        }

// An item's lines after its first: those indented to its text, the blank
// lines followed by one, and the lines of a paragraph that continue it
// lazily.
fn itemLines(lines : List(String), at : Int, done : List(String)) : #(List(String), List(String)) =
    match lines {
        [] -> #(List.reverse(done), [])
      | line :: rest -> if isBlank(line) then match List.find(rest, fn(l) = !isBlank(l)) {
            Some(next) when indent(next) >= at -> itemLines(rest, at, "" :: done)
          | _ -> #(List.reverse(done), lines)
        } else if indent(line) >= at then
            itemLines(rest, at, dedented(line, at) :: done)
        else if continues(line, done) && markerOf(unindented(line)) == None then
            itemLines(rest, at, unindented(line) :: done)
        else
            #(List.reverse(done), lines)
    }

// An HTML block begins with a comment, a declaration, a processing
// instruction, or a tag alone on its line, and runs to a blank line. A tag
// with text after it on its line is inline HTML, which stays in the text,
// and `<` before an address is an autolink and not HTML.
fn isHtml(s : String) : Bool =
    htmlOpens(s) || tagAlone(s)

// What begins an HTML block wherever it stands, and so ends a paragraph: a
// comment, a declaration, a processing instruction.
fn htmlOpens(s : String) : Bool =
    match String.toList(s) {
        '<' :: '!' :: c :: _ -> c == '-' || c == '[' || Char.isAlpha(c)
      | '<' :: '?' :: _ -> true
      | _ -> false
    }

// A tag alone on its line, `<div>` or `</div>`, which begins an HTML block
// but does not end a paragraph.
fn tagAlone(s : String) : Bool =
    match String.toList(String.trimEnd(s)) {
        '<' :: c :: rest -> {
            let #(tag, beyond) = List.span(rest, fn(d) = d != '>');
            (Char.isAlpha(c) || c == '/')
                && beyond == ['>']
                && !List.any(tag, fn(d) = d == ':' || d == '@')
        }
      | _ -> false
    }

fn raw(lines : List(String), done : List(String)) : #(Block, List(String)) =
    match lines {
        line :: rest when !isBlank(line) -> raw(rest, line :: done)
      | _ -> #(Raw(List.reverse(done)), lines)
    }

// A paragraph runs to a blank line or a line that begins another block; a
// line of `=` or `-` under it makes it a heading.
fn paragraph(lines : List(String), done : List(String)) : #(Block, List(String)) =
    match lines {
        line :: rest when indent(line) < 4 && underline(unindented(line)) > 0 ->
            #(Heading(level = underline(unindented(line)), text = textOf(done)), rest)
      | line :: rest when !isBlank(line) && !interrupts(line) ->
            paragraph(rest, unindented(line) :: done)
      | _ -> #(Paragraph(textOf(done)), lines)
    }

fn textOf(done : List(String)) : List(Inline) =
    inlines(String.join(List.reverse(done), "\n"))

// 1 for a line of `=`, 2 for a line of `-`, 0 for any other.
fn underline(s : String) : Int =
    match String.toList(String.trim(s)) {
        c :: rest when (c == '=' || c == '-') && List.all(rest, fn(d) = d == c) -> if c == '=' then
            1
        else
            2
      | _ -> 0
    }

//
// Reading the inlines
//

fn inlines(text : String) : List(Inline) =
    merged(scan(String.toList(String.trim(text)), []))

// The inlines of the characters, `pending` holding the text read so far,
// last first.
fn scan(chars : List(Char), pending : List(Char)) : List(Inline) =
    match chars {
        [] -> flushed(pending, [])
      | '\\' :: '\n' :: rest -> flushed(pending, Break :: scan(rest, []))
      | '\\' :: c :: rest when isPunctuation(c) -> scan(rest, c :: pending)
      | '\n' :: rest -> {
            let #(spaces, before) = List.span(pending, fn(c) = c == ' ');
            if List.size(spaces) >= 2 then
                flushed(before, Break :: scan(rest, []))
            else
                scan(rest, ' ' :: before)
        }
      | '`' :: _ -> {
            let #(ticks, rest) = List.span(chars, fn(c) = c == '`');
            match closingTicks(rest, List.size(ticks), []) {
                Some(#(code, later)) -> flushed(pending, CodeSpan(code) :: scan(later, []))
              | None -> scan(rest, List.reverse(ticks) <> pending)
            }
        }
      | c :: _ when c == '*' || c == '_' -> emphasis(c, chars, pending)
      | '!' :: '[' :: rest -> match linked(rest) {
            Some(#(link, later)) -> flushed(pending, link :: scan(later, []))
          | None -> scan(rest, '[' :: '!' :: pending)
        }
      | '[' :: rest -> match linked(rest) {
            Some(#(link, later)) -> flushed(pending, link :: scan(later, []))
          | None -> scan(rest, '[' :: pending)
        }
      | '<' :: rest -> match autolink(rest, []) {
            Some(#(link, later)) -> flushed(pending, link :: scan(later, []))
          | None -> scan(rest, '<' :: pending)
        }
      | c :: rest -> scan(rest, c :: pending)
    }

fn flushed(pending : List(Char), later : List(Inline)) : List(Inline) =
    if pending == [] then later else Text(String.fromList(List.reverse(pending))) :: later

fn merged(xs : List(Inline)) : List(Inline) =
    match xs {
        Text(a) :: Text(b) :: rest -> merged(Text(a <> b) :: rest)
      | x :: rest -> x :: merged(rest)
      | [] -> []
    }

fn isPunctuation(c : Char) : Bool =
    String.contains("!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~", Char.toString(c))

// A code span closes at a run of exactly as many backticks; a line break
// in it is a space, and one space at each end is dropped when both are
// there and the span is not all spaces.
fn closingTicks(chars : List(Char),
                size : Int,
                done : List(Char)) : Optional(#(String, List(Char))) =
    match chars {
        [] -> None
      | '`' :: _ -> {
            let #(ticks, rest) = List.span(chars, fn(c) = c == '`');
            if List.size(ticks) == size then
                Some(#(spanText(List.reverse(done)), rest))
            else
                closingTicks(rest, size, ticks <> done)
        }
      | '\n' :: rest -> closingTicks(rest, size, ' ' :: done)
      | c :: rest -> closingTicks(rest, size, c :: done)
    }

fn spanText(chars : List(Char)) : String =
    match chars {
        ' ' :: rest when rest != []
            && List.last(rest) == Some(' ')
            && List.any(rest, fn(c) = c != ' ') -> String.fromList(List.dropLast(rest))
      | _ -> String.fromList(chars)
    }

// Emphasis is one `*` or `_`, strong emphasis two, around text that does
// not begin or end with a space; `_` inside a word is text. A run with no
// closing one, and a run of three or more, is text.
fn emphasis(mark : Char, chars : List(Char), pending : List(Char)) : List(Inline) = {
    let #(run, rest) = List.span(chars, fn(c) = c == mark);
    let size = List.size(run);
    let intraword =
        mark == '_'
            && match pending {
                p :: _ -> isWordChar(p)
              | [] -> false
            };
    let opens = match rest {
        c :: _ -> c != ' ' && c != '\n'
      | [] -> false
    };
    if size > 2 || intraword || !opens then
        scan(rest, run <> pending)
    else match closingRun(rest, mark, size, []) {
        Some(#(inner, later)) -> {
            let text = inlines(String.fromList(inner));
            let styled = if size == 2 then Strong(text) else Emphasis(text);
            flushed(pending, styled :: scan(later, []))
        }
      | None -> scan(rest, run <> pending)
    }
}

// The text up to a run of exactly that many marks that follows a
// character other than a space; a code span is passed over whole, so a
// mark inside it closes nothing.
fn closingRun(chars : List(Char),
              mark : Char,
              size : Int,
              done : List(Char)) : Optional(#(List(Char), List(Char))) =
    match chars {
        [] -> None
      | '`' :: _ -> {
            let #(ticks, rest) = List.span(chars, fn(c) = c == '`');
            match closingTicks(rest, List.size(ticks), []) {
                Some(#(_, later)) -> {
                    let spanned = List.take(chars, List.size(chars) - List.size(later));
                    closingRun(later, mark, size, List.reverse(spanned) <> done)
                }
              | None -> closingRun(rest, mark, size, ticks <> done)
            }
        }
      | c :: _ when c == mark -> {
            let #(run, rest) = List.span(chars, fn(d) = d == mark);
            let afterText = match done {
                p :: _ -> p != ' ' && p != '\n'
              | [] -> false
            };
            let closes =
                List.size(run) == size
                    && afterText
                    && !(mark == '_'
                             && match rest {
                                 n :: _ -> isWordChar(n)
                               | [] -> false
                             });
            if closes then
                Some(#(List.reverse(done), rest))
            else
                closingRun(rest, mark, size, run <> done)
        }
      | c :: rest -> closingRun(rest, mark, size, c :: done)
    }

fn isWordChar(c : Char) : Bool =
    Char.isAlpha(c) || Char.isDigit(c)

// A link: its text up to the `]` that balances the `[`, then `(`, the
// address, an optional title in quotes, and `)`.
fn linked(chars : List(Char)) : Optional(#(Inline, List(Char))) =
    match bracketed(chars, 0, []) {
        Some(#(text, '(' :: rest)) -> match destination(rest, 0, []) {
            Some(#(address, later)) ->
                Some(#(Link(text = inlines(String.fromList(text)), address = address), later))
          | None -> None
        }
      | _ -> None
    }

fn bracketed(chars : List(Char),
             depth : Int,
             done : List(Char)) : Optional(#(List(Char), List(Char))) =
    match chars {
        [] -> None
      | '\\' :: c :: rest -> bracketed(rest, depth, c :: '\\' :: done)
      | ']' :: rest -> if depth == 0 then
            Some(#(List.reverse(done), rest))
        else
            bracketed(rest, depth - 1, ']' :: done)
      | '[' :: rest -> bracketed(rest, depth + 1, '[' :: done)
      | c :: rest -> bracketed(rest, depth, c :: done)
    }

// The address runs to a space or to the `)` that balances; a title after
// a space is read past and not kept.
fn destination(chars : List(Char),
               depth : Int,
               done : List(Char)) : Optional(#(String, List(Char))) =
    match chars {
        [] -> None
      | ')' :: rest -> if depth == 0 then
            Some(#(String.fromList(List.reverse(done)), rest))
        else
            destination(rest, depth - 1, ')' :: done)
      | '(' :: rest -> destination(rest, depth + 1, '(' :: done)
      | c :: rest when c == ' ' || c == '\n' -> match titled(rest) {
            Some(later) -> Some(#(String.fromList(List.reverse(done)), later))
          | None -> None
        }
      | c :: rest -> destination(rest, depth, c :: done)
    }

fn titled(chars : List(Char)) : Optional(List(Char)) = {
    let #(_, rest) = List.span(chars, fn(c) = c == ' ' || c == '\n');
    match rest {
        ')' :: later -> Some(later)
      | q :: more when q == '"' || q == '\'' -> {
            let #(_, tail) = List.span(more, fn(c) = c != q);
            match tail {
                _ :: later -> {
                    let #(_, closing) = List.span(later, fn(c) = c == ' ');
                    match closing {
                        ')' :: beyond -> Some(beyond)
                      | _ -> None
                    }
                }
              | [] -> None
            }
        }
      | _ -> None
    }
}

// An autolink: `<`, a scheme and `:` or an address with `@`, and `>`,
// with no space inside.
fn autolink(chars : List(Char), done : List(Char)) : Optional(#(Inline, List(Char))) =
    match chars {
        '>' :: rest -> {
            let address = String.fromList(List.reverse(done));
            if String.contains(address, ":") || String.contains(address, "@") then
                Some(#(Link(text = [Text(address)], address = address), rest))
            else
                None
        }
      | c :: rest when c != ' ' && c != '<' && c != '\n' -> autolink(rest, c :: done)
      | _ -> None
    }

//
// Rendering
//

/// The document as rows of text at most that many columns wide where a
/// word allows, with the terminal's styles when the style is `Styled`. A
/// heading is its text, bold with styles; a code block is indented four
/// columns and never wrapped; a list item follows a bullet, or its number
/// and a period whichever delimiter it was written with; a block quote
/// follows a bar; a thematic break is a line across the width; and a link
/// is its text with its address after it. Emphasis is in italics, strong
/// emphasis bold, and a code span cyan with styles, and each is as
/// written without them. Blocks are separated by an empty row.
///
/// ### Examples
///
/// ```ernest
/// Markdown.render(Markdown.parse("A [link](https://example.org).\n\n    code"),
///                 80,
///                 Markdown.Plain)
/// // => ["A link (https://example.org).", "", "    code"]
/// ```
export fn render(blocks : List(Block), width : Int, style : Style) : List(String) =
    match blocks {
        [] -> []
      | first :: rest ->
            rendered(first, width, style)
                <> List.flatMap(rest, fn(b) = "" :: rendered(b, width, style))
    }

fn rendered(b : Block, width : Int, style : Style) : List(String) =
    match b {
        Heading(text = text) ->
            standing(style,
                     wrapped(paint(style, Terminal.Bold, spans(unstrong(text), style)), width))
      | Paragraph(text) -> standing(style, wrapped(spans(text, style), width))
      | Code(lines = lines) ->
            List.map(lines, fn(line) = if isBlank(line) then "" else "    " <> line)
      | Quote(inner) -> List.map(render(inner, width - 2, style), fn(row) = "│ " <> row)
      | Items(start = start, items = items) -> itemRows(start, items, width, style)
      | Rule -> [String.repeat("─", width)]
      | Raw(lines) -> lines
    }

// Each item after its bullet or number, the rows after its first under
// its text; the numbers are as wide as the widest of them.
fn itemRows(start : Optional(Int),
            items : List(List(Block)),
            width : Int,
            style : Style) : List(String) = {
    let labels = match start {
        None -> List.map(items, fn(_) = "•")
      | Some(n) -> List.map(List.indexed(items), fn(#(i, _)) = Int.toString(n + i) <> ".")
    };
    let size = List.foldLeft(labels, 0, fn(most, label) = Int.max(most, String.size(label))) + 1;
    List.flatMap(List.zip(labels, items),
                 fn(#(label, item)) = match render(item, width - size, style) {
                     [] -> [label]
                   | first :: rest ->
                         (String.padEnd(label, size, ' ') <> first)
                             :: List.map(rest,
                                         fn(row) = if String.isEmpty(row) then
                                             row
                                         else
                                             String.repeat(" ", size) <> row)
                 })
}

// A heading is bold already, so strong emphasis inside it is its text; its
// own bold would end the heading's where it ends.
fn unstrong(xs : List(Inline)) : List(Inline) =
    List.flatMap(xs, fn(x) = match x {
        Strong(inner) -> unstrong(inner)
      | Emphasis(inner) -> [Emphasis(unstrong(inner))]
      | Link(text = inner, address = address) -> [Link(address = address, text = unstrong(inner))]
      | other -> [other]
    })

fn spans(xs : List(Inline), style : Style) : String =
    String.join(List.map(xs, fn(x) = span(x, style)), "")

fn span(x : Inline, style : Style) : String =
    match x {
        Text(s) -> s
      | CodeSpan(s) -> marked(style, Terminal.Foreground(Terminal.Cyan), "`", s)
      | Emphasis(xs) -> marked(style, Terminal.Italic, "*", spans(xs, style))
      | Strong(xs) -> marked(style, Terminal.Bold, "**", spans(xs, style))
      | Link(text = text, address = address) -> if plain(text) == address then
            address
        else
            spans(text, style) <> " (" <> address <> ")"
      | Break -> "\n"
    }

// Text in the terminal's look where the rendering is styled; the terminal
// turns a look off by its own code, so one inside another leaves the outer
// one on (report Appendix E.16).
fn paint(style : Style, look : Terminal.Style, text : String) : String =
    if style == Styled then Terminal.styled(text, look) else text

// Inline markup: in the terminal's style where there is one, and as it is
// written where there is none, the only way plain text can show it.
fn marked(style : Style, look : Terminal.Style, mark : String, text : String) : String =
    if style == Styled then paint(style, look, text) else mark <> text <> mark

fn plain(xs : List(Inline)) : String =
    String.join(List.map(xs, fn(x) = match x {
                    Text(s) -> s
                  | CodeSpan(s) -> s
                  | Emphasis(inner) -> plain(inner)
                  | Strong(inner) -> plain(inner)
                  | Link(text = inner) -> plain(inner)
                  | Break -> " "
                }),
                "")

// Each styled row stands alone: a look a row leaves on is turned off at
// its end and on again at the next row's start, so that a row shown
// without those after it, as a listing cut short shows it, leaves no look
// on. The looks are Terminal.styled's, each turned off by a code of its
// own.
fn standing(style : Style, rows : List(String)) : List(String) =
    if style == Styled then balanced(rows, []) else rows

// The rows, `open` the looks on as the first begins, the latest first.
fn balanced(rows : List(String), open : List(String)) : List(String) =
    match rows {
        [] -> []
      | row :: rest -> {
            let left = looksAfter(String.toList(row), open);
            let reopened = String.join(List.map(List.reverse(open), sgr), "");
            let closed = String.join(List.map(left, fn(on) = sgr(offCode(on))), "");
            (reopened <> row <> closed) :: balanced(rest, left)
        }
    }

// The looks on after the characters, given those on before them.
fn looksAfter(chars : List(Char), open : List(String)) : List(String) =
    match chars {
        [] -> open
      | '\u{1b}' :: '[' :: rest -> {
            let #(digits, beyond) = List.span(rest, Char.isAsciiDigit);
            match beyond {
                'm' :: more -> looksAfter(more, switched(String.fromList(digits), open))
              | _ -> looksAfter(beyond, open)
            }
        }
      | _ :: rest -> looksAfter(rest, open)
    }

// A code turns its look on, or turns off every look it ends; `0` ends all.
fn switched(code : String, open : List(String)) : List(String) =
    if code == "0" then
        []
    else if List.contains(["22", "23", "24", "39"], code) then
        List.filter(open, fn(on) = offCode(on) != code)
    else
        code :: open

fn offCode(on : String) : String =
    match on {
        "1" -> "22"
      | "2" -> "22"
      | "3" -> "23"
      | "4" -> "24"
      | _ -> if String.startsWith(on, "3") then "39" else "0"
    }

fn sgr(code : String) : String =
    "\u{1b}[" <> code <> "m"

// Text broken at spaces into rows of at most the width, a word longer
// than the width alone on its row; a hard break always starts a row, and
// the spaces between two words on one row are kept as they were.
fn wrapped(text : String, width : Int) : List(String) =
    List.flatMap(String.split(text, "\n"),
                 fn(line) = filled(pieces(String.toList(line), [], []), width, "", []))

// The words and the runs of spaces between them, alternately, in order.
fn pieces(chars : List(Char), current : List(Char), done : List(String)) : List(String) =
    match chars {
        [] -> List.reverse(if current == [] then
                               done
                           else
                               String.fromList(List.reverse(current)) :: done)
      | c :: rest -> match current {
            p :: _ when (p == ' ') != (c == ' ') ->
                pieces(rest, [c], String.fromList(List.reverse(current)) :: done)
          | _ -> pieces(rest, c :: current, done)
        }
    }

fn filled(pieces : List(String), width : Int, row : String, rows : List(String)) : List(String) =
    match pieces {
        [] -> List.reverse(if String.isEmpty(row) then rows else row :: rows)
      | spaces :: word :: rest when String.startsWith(spaces, " ") -> if String.isEmpty(row) then
            filled(rest, width, word, rows)
        else if Terminal.columns(row) + String.size(spaces) + Terminal.columns(word) <= width then
            filled(rest, width, row <> spaces <> word, rows)
        else
            filled(rest, width, word, row :: rows)
      | [spaces] when String.startsWith(spaces, " ") -> filled([], width, row, rows)
      | word :: rest -> filled(rest, width, row <> word, rows)
    }

//
// Manual pages
//

/// The document as a manual page in the roff of man(7), which groff and
/// mandoc render, a line of the page's source each: the header and the
/// NAME line from the page, the blocks before the first heading of level 1
/// under DESCRIPTION, a heading of level 1 a section, one of level 2 a
/// subsection, and a deeper one a paragraph in bold. Lines are filled to
/// the left margin alone and no word is hyphenated, so that a name in the
/// text is never spread or broken. A code span and strong
/// emphasis are bold, emphasis is in italics, a code block is indented and
/// not filled, a list item follows its bullet or its number, a block quote
/// is indented, a thematic break is a row of asterisks, a link is its text
/// with its address after it, and a `Raw` block is as written. Every
/// character roff would change is written as roff's escape for it, so that
/// code copied from the page is the code written, and the rest is UTF-8,
/// which man-db and mandoc read.
///
/// ### Examples
///
/// The page from its NAME line on, after its header's four lines:
///
/// ```ernest
/// List.drop(Markdown.roff(Markdown.Manual(name = "hello",
///                                         section = "1",
///                                         summary = [Markdown.Text("greet")],
///                                         source = "Hello 1.0",
///                                         title = "Hello Manual"),
///                         Markdown.parse("Says *hello*.")),
///           4)
/// // => [".SH NAME", "hello \\- greet", ".SH DESCRIPTION", ".PP", "Says \\fIhello\\fR."]
/// ```
export fn roff(page : Manual, blocks : List(Block)) : List(String) = {
    let description = match blocks {
        [] -> []
      | Heading(level = 1) :: _ -> []
      | _ -> [".SH DESCRIPTION"]
    };
    header(page) <> description <> List.flatMap(blocks, roffed)
}

// The header and the NAME line. No word is hyphenated and lines are filled
// to the left margin alone; groff's macros set the adjustment again from
// the string AD at each item of a list, so the string says it too.
fn header(page : Manual) : List(String) = {
    let fields = [page.name, page.section, "", page.source, page.title];
    [".TH " <> String.join(List.map(fields, fn(f) = "\"" <> escaped(f) <> "\""), " "),
     ".nh",
     ".ds AD l",
     ".ad l",
     ".SH NAME",
     textLine(escaped(page.name) <> " \\- " <> escaped(plain(page.summary)))]
}

/// The first sentence of the document: the text of its first paragraph up
/// to the first period a space follows outside emphasis, code spans, and
/// links, or all of it where there is none, and nothing where the document
/// has no paragraph.
///
/// ### Examples
///
/// ```ernest
/// Markdown.firstSentence(Markdown.parse("# Title\n\nOne `a`. Two."))
/// // => [Text("One "), CodeSpan("a"), Text(".")]
/// ```
export fn firstSentence(blocks : List(Block)) : List(Inline) =
    match List.find(blocks, isParagraph) {
        Some(Paragraph(xs)) -> upToStop(xs)
      | _ -> []
    }

fn isParagraph(b : Block) : Bool =
    match b {
        Paragraph(_) -> true
      | _ -> false
    }

fn upToStop(xs : List(Inline)) : List(Inline) =
    match xs {
        [] -> []
      | Text(s) :: rest -> match String.indexOf(s, ". ") {
            Some(i) -> [Text(String.slice(s, 0, i + 1))]
          | None -> Text(s) :: upToStop(rest)
        }
      | x :: rest -> x :: upToStop(rest)
    }

// The font text is set in: roff has one for each of the four.
type Font = Roman | Bold | Italic | BoldItalic

fn roffed(b : Block) : List(String) =
    match b {
        Heading(level = 1, text = text) -> [".SH", textLine(heading(text))]
      | Heading(level = 2, text = text) -> [".SS", textLine(heading(text))]
      | Heading(text = text) -> [".PP", textLine("\\fB" <> heading(text) <> "\\fR")]
      | Paragraph(text) -> ".PP" :: textLines(roffSpans(text, Roman))
      | Code(lines = lines) ->
            [".PP", ".RS 4", ".nf"] <> List.map(lines, codeLine) <> [".fi", ".RE"]
      | Quote(inner) -> [".RS 4"] <> List.flatMap(inner, roffed) <> [".RE"]
      | Items(start = start, items = items) -> roffItems(start, items)
      | Rule -> [".PP", "   *   *   *   *   *"]
      | Raw(lines) -> [".PP", ".nf"] <> List.map(lines, codeLine) <> [".fi"]
    }

// A heading is set in bold already, so its text begins in bold; a hard
// break in it is a space, since a heading is one line.
fn heading(text : List(Inline)) : String =
    String.replace(roffSpans(text, Bold), "\n", " ")

// Each item after its bullet or number, the item's text at the width of the
// widest label and a space; a paragraph that begins the item follows its
// label, and every other block of the item stands under the item's text.
fn roffItems(start : Optional(Int), items : List(List(Block))) : List(String) = {
    let labels = match start {
        None -> List.map(items, fn(_) = "\\(bu")
      | Some(n) -> List.map(List.indexed(items), fn(#(i, _)) = Int.toString(n + i) <> ".")
    };
    let widest = match start {
        None -> 1
      | Some(_) -> List.foldLeft(labels, 0, fn(most, label) = Int.max(most, String.size(label)))
    };
    let width = Int.toString(widest + 1);
    List.flatMap(List.zip(labels, items), fn(#(label, item)) = {
        let #(first, rest) = match item {
            Paragraph(text) :: more -> #(textLines(roffSpans(text, Roman)), more)
          | _ -> #([], item)
        };
        (".IP " <> label <> " " <> width)
            :: first <> List.flatMap(rest, fn(b) = (".RS " <> width) :: roffed(b) <> [".RE"])
    })
}

// The spans in roff, begun in the font given and ended in it; a hard break
// is a line feed, which `textLines` turns into roff's break.
fn roffSpans(xs : List(Inline), font : Font) : String =
    String.join(List.map(xs, fn(x) = roffSpan(x, font)), "")

fn roffSpan(x : Inline, font : Font) : String =
    match x {
        Text(s) -> escaped(s)
      | CodeSpan(s) -> inFont(withBold(font), font, escaped(s))
      | Emphasis(xs) -> inFont(withItalic(font), font, roffSpans(xs, withItalic(font)))
      | Strong(xs) -> inFont(withBold(font), font, roffSpans(xs, withBold(font)))
      | Link(text = text, address = address) -> if plain(text) == address then
            escaped(address)
        else
            roffSpans(text, font) <> " (" <> escaped(address) <> ")"
      | Break -> "\n"
    }

// Text in a font, and the font it stood in after it.
fn inFont(inner : Font, outer : Font, text : String) : String =
    if inner == outer then text else fontCode(inner) <> text <> fontCode(outer)

fn fontCode(font : Font) : String =
    match font {
        Roman -> "\\fR"
      | Bold -> "\\fB"
      | Italic -> "\\fI"
      | BoldItalic -> "\\f(BI"
    }

fn withBold(font : Font) : Font =
    match font {
        Roman -> Bold
      | Italic -> BoldItalic
      | other -> other
    }

fn withItalic(font : Font) : Font =
    match font {
        Roman -> Italic
      | Bold -> BoldItalic
      | other -> other
    }

// A paragraph's text as lines of the page's source, one for each hard
// break and roff's break between them; roff reads an empty line as space
// between paragraphs, so there is none.
fn textLines(text : String) : List(String) =
    match List.filter(String.split(text, "\n"), fn(line) = !String.isEmpty(line)) {
        [] -> []
      | first :: rest -> textLine(first) :: List.flatMap(rest, fn(line) = [".br", textLine(line)])
    }

// A line of escaped text, which roff would read as a request where it
// begins with a period, so it begins with roff's empty character; an
// apostrophe, the other mark of a request, is escaped already.
fn textLine(text : String) : String =
    if String.startsWith(text, ".") then "\\&" <> text else text

// A line of a code block or of raw lines, as it is written: roff keeps its
// spaces in a block it does not fill.
fn codeLine(line : String) : String =
    textLine(escaped(line))

// Text as roff writes it: a backslash, a hyphen, a quote, and the marks roff
// would turn into typographic ones by their escapes, and a line feed, which
// would end the line, as a space. The rest stands as it is, in UTF-8: an
// escape by code point would be the text of the NAME line that man-db's
// `apropos` shows.
fn escaped(text : String) : String =
    String.join(List.map(String.toList(text), escapedChar), "")

fn escapedChar(c : Char) : String =
    match c {
        '\\' -> "\\(rs"
      | '-' -> "\\-"
      | '\'' -> "\\(aq"
      | '`' -> "\\(ga"
      | '"' -> "\\(dq"
      | '~' -> "\\(ti"
      | '^' -> "\\(ha"
      | '\n' -> " "
      | other -> Char.toString(other)
    }

//
// The tests (report §9.3), run by `ern test` as every library's are.
//

let headings =
    Test(name = "an ATX heading drops its closing marks",
         run = fn() =
             blocksAre(parse("### Three ###\n####### seven"),
                       [Heading(level = 3, text = [Text("Three")]),
                        Paragraph([Text("####### seven")])]))

let setext =
    Test(name = "a line of = or - under a paragraph makes it a heading",
         run = fn() =
             blocksAre(parse("One\n===\n\nTwo\n---"),
                       [Heading(level = 1, text = [Text("One")]),
                        Heading(level = 2, text = [Text("Two")])]))

let fences =
    Test(name = "a fence runs to one as long, and keeps what is inside",
         run = fn() =
             blocksAre(parse("````ernest\n```\n# not a heading\n````\nafter"),
                       [Code(info = "ernest", lines = ["```", "# not a heading"]),
                        Paragraph([Text("after")])]))

let unclosedFence =
    Test(name = "a fence that never closes runs to the end",
         run = fn() = blocksAre(parse("```\na\n\nb"), [Code(info = "", lines = ["a", "", "b"])]))

let indentedCode =
    Test(name = "an indented block keeps its inner blank lines",
         run = fn() =
             blocksAre(parse("    a\n\n    b\n\nc"),
                       [Code(info = "", lines = ["a", "", "b"]), Paragraph([Text("c")])]))

let tabs =
    Test(name = "a tab is four columns",
         run = fn() = blocksAre(parse("\tcode"), [Code(info = "", lines = ["code"])]))

// a regression test: every tab was expanded, a code block's content among
// them, so a Makefile's lines lost theirs (findings.md's E22)
let tabsInCode =
    Test(name = "a tab in a code block's content is kept",
         run = fn() =
             blocksAre(parse("```\n\tx\n```\n\n    a\tb\n\n>\tquoted"),
                       [Code(info = "", lines = ["\tx"]),
                        Code(info = "", lines = ["a\tb"]),
                        Quote([Paragraph([Text("quoted")])])]))

let quotes =
    Test(name = "a quote holds blocks, and a lazy line continues it",
         run = fn() =
             blocksAre(parse("> # In\n> text\nlazy"),
                       [Quote([Heading(level = 1, text = [Text("In")]),
                               Paragraph([Text("text lazy")])])]))

let ordered =
    Test(name = "an ordered list keeps its first number",
         run = fn() =
             blocksAre(parse("3. a\n4. b"),
                       [Items(start = Some(3),
                              items = [[Paragraph([Text("a")])], [Paragraph([Text("b")])]])]))

let kinds =
    Test(name = "a different bullet begins a new list",
         run = fn() =
             blocksAre(parse("- a\n+ b"),
                       [Items(start = None, items = [[Paragraph([Text("a")])]]),
                        Items(start = None, items = [[Paragraph([Text("b")])]])]))

let looseItems =
    Test(name = "an item holds the indented blocks after a blank line",
         run = fn() =
             blocksAre(parse("- a\n\n  b\n- c"),
                       [Items(start = None,
                              items = [[Paragraph([Text("a")]), Paragraph([Text("b")])],
                                       [Paragraph([Text("c")])]])]))

let interrupted =
    Test(name = "a list interrupts a paragraph, a number other than 1 does not",
         run = fn() =
             blocksAre(parse("a\n- b\n\nc\n2. d"),
                       [Paragraph([Text("a")]),
                        Items(start = None, items = [[Paragraph([Text("b")])]]),
                        Paragraph([Text("c 2. d")])]))

// a regression test: the line after a quoted heading was read into the
// quote, though only paragraph text continues lazily (findings.md's E21)
let lazyAfterHeading =
    Test(name = "a line after a quoted heading is outside the quote",
         run = fn() =
             blocksAre(parse("> # Heading\nlazy"),
                       [Quote([Heading(level = 1, text = [Text("Heading")])]),
                        Paragraph([Text("lazy")])]))

// a regression test: a tag that began a line made the line a Raw block,
// and ended the paragraph before it (findings.md's E8)
let inlineHtml =
    Test(name = "a tag with text after it is inline HTML, and ends no paragraph",
         run = fn() =
             blocksAre(parse("Some text\n<b>bold</b> more\n\n<em>hi</em> there"),
                       [Paragraph([Text("Some text <b>bold</b> more")]),
                        Paragraph([Text("<em>hi</em> there")])]))

let html =
    Test(name = "an HTML block is kept as written, an autolink is not HTML",
         run = fn() =
             blocksAre(parse("<div>\n*x*\n</div>\n\n<https://a.org>"),
                       [Raw(["<div>", "*x*", "</div>"]),
                        Paragraph([Link(address = "https://a.org",
                                        text = [Text("https://a.org")])])]))

let escapes =
    Test(name = "a backslash escapes punctuation and ends a line hard",
         run = fn() =
             inlinesAre("\\*a\\* b\\\nc  \nd", [Text("*a* b"), Break, Text("c"), Break, Text("d")]))

let codeSpans =
    Test(name = "a code span is literal, and trims one space at each end",
         run = fn() =
             inlinesAre("`` a ` b `` and `*x*`",
                        [CodeSpan("a ` b"), Text(" and "), CodeSpan("*x*")]))

let nesting =
    Test(name = "emphasis nests inside strong emphasis",
         run = fn() =
             inlinesAre("**a *b* c**", [Strong([Text("a "), Emphasis([Text("b")]), Text(" c")])]))

let intraword =
    Test(name = "an underscore inside a word is text",
         run = fn() =
             inlinesAre("snake_case_name and _it_",
                        [Text("snake_case_name and "), Emphasis([Text("it")])]))

let unmatched =
    Test(name = "a mark that nothing closes is text",
         run = fn() = inlinesAre("a * b and *c", [Text("a * b and *c")]))

let links =
    Test(name = "a link's title is read past, an image is a link",
         run = fn() =
             inlinesAre("[a [b]](u \"t\") ![i](p)",
                        [Link(address = "u", text = [Text("a [b]")]),
                         Text(" "),
                         Link(address = "p", text = [Text("i")])]))

let notALink =
    Test(name = "brackets with no address after them are text",
         run = fn() = inlinesAre("[a] and [b][ref]", [Text("[a] and [b][ref]")]))

let lineEndings =
    Test(name = "a line may end in a carriage return, alone or before a feed",
         run = fn() =
             blocksAre(parse("a\r\nb\r\n\r\nc\rd"),
                       [Paragraph([Text("a b")]), Paragraph([Text("c d")])]))

let asciiNumbers =
    Test(name = "a list number is ASCII digits, not any script's",
         run = fn() = blocksAre(parse("\u{661}. x"), [Paragraph([Text("\u{661}. x")])]))

let styles =
    Test(name = "with styles, each is turned off by its own code",
         run = fn() =
             rowsAre(render(parse("**a *b* `c`**"), 80, Styled),
                     ["\u{1b}[1ma \u{1b}[3mb\u{1b}[23m \u{1b}[36mc\u{1b}[39m\u{1b}[22m"]))

let wrapping =
    Test(name = "a word longer than the width stands alone on its row",
         run = fn() =
             rowsAre(render(parse("a abcdefghijklmnopqrstuvwxyz b"), 20, Plain),
                     ["a", "abcdefghijklmnopqrstuvwxyz", "b"]))

// a regression test: bold was turned on in the first row and off in the
// last, so a listing cut after the first left it on (findings.md's E5)
let styledRowsStandAlone =
    Test(name = "a style a row leaves on is turned off at its end and on again after",
         run = fn() =
             rowsAre(render(parse("# A long heading here"), 8, Styled),
                     ["\u{1b}[1mA long\u{1b}[22m",
                      "\u{1b}[1mheading\u{1b}[22m",
                      "\u{1b}[1mhere\u{1b}[22m"]))

let styledWidth =
    Test(name = "a style takes no column when a row is filled",
         run = fn() =
             rowsAre(render(parse("*aaaa* *bbbb* *cccc* *dddd*"), 20, Styled),
                     [String.join(List.map(["aaaa", "bbbb", "cccc", "dddd"],
                                           fn(w) = "\u{1b}[3m" <> w <> "\u{1b}[23m"),
                                  " ")]))

let boldHeading =
    Test(name = "strong emphasis in a heading leaves the heading bold",
         run = fn() =
             rowsAre(render(parse("# a **b** c"), 80, Styled), ["\u{1b}[1ma b c\u{1b}[22m"]))

let separated =
    Test(name = "blocks are separated by one empty row",
         run = fn() =
             rowsAre(render(parse("a\n\n\n\nb\n\n    c"), 80, Plain), ["a", "", "b", "", "    c"]))

let nestedRows =
    Test(name = "a quote inside an item is under the item's text",
         run = fn() =
             rowsAre(render(parse("1. a\n\n   > q\n2. b"), 80, Plain),
                     ["1. a", "", "   │ q", "2. b"]))

let manualHeader =
    Test(name = "a manual page begins with its header and its NAME line",
         run = fn() =
             rowsAre(roff(hello(), []),
                     [".TH \"hello\" \"1\" \"\" \"Hello 1.0\" \"Hello Manual\"",
                      ".nh",
                      ".ds AD l",
                      ".ad l",
                      ".SH NAME",
                      "hello \\- greet"]))

let manualDescription =
    Test(name = "the blocks before a first section are the page's DESCRIPTION",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("Text.\n\n# USAGE\n\nMore.")), 6),
                     [".SH DESCRIPTION", ".PP", "Text.", ".SH", "USAGE", ".PP", "More."]))

let manualSection =
    Test(name = "a page that begins with a section has no DESCRIPTION of its own",
         run = fn() = rowsAre(List.drop(roff(hello(), parse("# USAGE")), 6), [".SH", "USAGE"]))

let manualHeadings =
    Test(name = "a heading of level 2 is a subsection and a deeper one a bold paragraph",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("## Two `x`\n### Three *y*")), 7),
                     [".SS", "Two x", ".PP", "\\fBThree \\f(BIy\\fB\\fR"]))

let manualFonts =
    Test(name = "each font returns to the one around it",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("**a *b* `c`** `d` *e `f`*")), 8),
                     ["\\fBa \\f(BIb\\fB c\\fR \\fBd\\fR \\fIe \\f(BIf\\fI\\fR"]))

let manualEscapes =
    Test(name = "what roff would change is written by its escape, and the rest as it is",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("a-b \\\\ 'c' ~ ^ \"d\" § \u{1f600}")), 8),
                     ["a\\-b \\(rs \\(aqc\\(aq \\(ti \\(ha \\(dqd\\(dq § \u{1f600}"]))

let manualLineStarts =
    Test(name = "a line that begins with a period is not a request",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("\\.a\\\n.b\n\n    .c")), 8),
                     ["\\&.a", ".br", "\\&.b", ".PP", ".RS 4", ".nf", "\\&.c", ".fi", ".RE"]))

let manualCode =
    Test(name = "a code block keeps its lines and its spaces, blank lines among them",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("```\nf(x)\n\n  `y`\n```")), 7),
                     [".PP", ".RS 4", ".nf", "f(x)", "", "  \\(gay\\(ga", ".fi", ".RE"]))

let manualItems =
    Test(name = "an item follows its label, and its later blocks stand under its text",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("- a\n\n  b\n- c\n  - d")), 7),
                     [".IP \\(bu 2",
                      "a",
                      ".RS 2",
                      ".PP",
                      "b",
                      ".RE",
                      ".IP \\(bu 2",
                      "c",
                      ".RS 2",
                      ".IP \\(bu 2",
                      "d",
                      ".RE"]))

let manualNumbers =
    Test(name = "an ordered list's text is as far in as its widest number",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("9. a\n10. b")), 7),
                     [".IP 9. 4", "a", ".IP 10. 4", "b"]))

let manualRest =
    Test(name = "a quote is indented, a rule is asterisks, raw lines are as written",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("> q\n\n---\n\n<div>\n</div>")), 7),
                     [".RS 4",
                      ".PP",
                      "q",
                      ".RE",
                      ".PP",
                      "   *   *   *   *   *",
                      ".PP",
                      ".nf",
                      "<div>",
                      "</div>",
                      ".fi"]))

let manualLinks =
    Test(name = "a link is its text with its address after it",
         run = fn() =
             rowsAre(List.drop(roff(hello(), parse("[home](https://a.org) <https://b.org>")), 8),
                     ["home (https://a.org) https://b.org"]))

let sentences =
    Test(name = "the first sentence ends at a period a space follows outside emphasis",
         run = fn() =
             if firstSentence(parse("# T\n\nOne. Two.")) == [Text("One.")]
                 && firstSentence(parse("One *a. b* c"))
                     == [Text("One "), Emphasis([Text("a. b")]), Text(" c")]
                 && firstSentence(parse("# T")) == [] then
                 Passed
             else
                 Failed(plain(firstSentence(parse("# T\n\nOne. Two.")))))

fn hello() : Manual =
    Manual(name = "hello",
           section = "1",
           summary = [Text("greet")],
           source = "Hello 1.0",
           title = "Hello Manual")

fn blocksAre(blocks : List(Block), expected : List(Block)) : TestResult =
    if blocks == expected then Passed else Failed(Int.toString(List.size(blocks)) <> " blocks")

fn inlinesAre(text : String, expected : List(Inline)) : TestResult =
    match parse(text) {
        [Paragraph(xs)] -> if xs == expected then Passed else Failed(plain(xs))
      | _ -> Failed("not one paragraph")
    }

fn rowsAre(rows : List(String), expected : List(String)) : TestResult =
    if rows == expected then
        Passed
    else
        Failed(String.replace(String.join(rows, " | "), "\u{1b}", "ESC"))
