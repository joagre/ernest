/// The least busy of a program's peers, by what each says of how busy it
/// is.
///
/// A program puts the library on its load path when it is compiled and
/// when it is run; report Appendix G says where an installation keeps it.
///
/// **What it does.** `leastBusy` asks every name it is given at once how
/// busy its peer is, `Peer.utilisation(name, ms)` for each, and answers the
/// name whose peer answered the least, the first given where two answered
/// the same, or `None` where none answered. A program that is no node has
/// no peers, and every ask there answers `NotListed` (report §8.7).
///
/// **Its wait.** Each ask ends within `ms` milliseconds, with the runtime's
/// step of making the attempt beside them, and the pick ends when every ask
/// has, so a pick waits as long as its slowest ask whatever the count; it
/// chooses no time of its own. A pick runs in processes of its own, one for
/// each name and one that gathers their answers, which end once the asks
/// have.
///
/// **Its rule.** Every name is asked, and not a sample: a program with many
/// peers and many pickers passes a sample it drew itself. The rule is the
/// function's name, and another rule is another function, written over
/// `Peer.utilisation` as this one is. How busy a peer says it is, on one
/// scale with 1.0 every scheduler busy, is as its own configuration
/// measures it (report §8.7, Appendix E.27).
///
/// ## Examples
///
/// A name no peer has, in a program that is no node:
///
/// ```ernest
/// Placement.leastBusy(["worker"], 1000)
/// // => None
/// ```
///
/// since 0.4.0

/// The name of the least busy of the peers named, of those that answered
/// within `ms` milliseconds, or `None` where none answered.
///
/// Every name is asked at once. The pick waits for every ask. Of two names
/// whose peers answered the same, the one given first is picked. A name
/// whose ask failed, `NotListed`, `Unreachable` or `Timeout`, is passed
/// over. An empty list answers `None`.
///
/// ### Examples
///
/// Work run on the least busy of the peers, or on this node where none
/// answered, as in a program that is no node:
///
/// ```ernest
/// match Placement.leastBusy(Peer.peers(), 1000) {
///     Some(name) -> Peer.compute(name, fn() = 6 * 7, 5000)
///   | None -> Right(6 * 7)
/// }
/// // => Right(42)
/// ```
export fn leastBusy(names : List(String), ms : Int) : Optional(String) with n = {
    let caller = Process.fromAddress(self());
    let gatherer = spawn(fn() : Unit with Gathering = gather(caller, names, ms));
    // a call without a time, since the gatherer always answers, once every
    // ask has ended, each within ms and the attempt's step (report §8.7); a
    // time derived from ms would end the pick while an ask may still answer
    // within its own (report §0, Time)
    Address.callForever(gatherer, fn(reply) = LeastBusy(reply = reply))
}

// What a pick's process takes: the caller's request, a name's answer by its
// index among the names, and the caller's end.
type Gathering =
    LeastBusy(reply : Reply(Optional(String)))
  | Answered(index : Int, utilisation : Either(Io.Error, Float))
  | Ended(Down)

// The pick's process: at the caller's request, every name asked at once,
// each by a process of its own, and their answers taken in the names'
// order; or nothing, where the caller ended before it asked.
fn gather(caller : Process, names : List(String), ms : Int) : Unit with Gathering = {
    monitor(caller, Ended);
    receive {
        LeastBusy(reply = reply) -> {
            let me = self();
            let indexed = List.indexed(names);
            List.forEach(indexed, fn(#(index, name)) = ask(me, index, name, ms));
            let answers = List.map(indexed, fn(#(index, name)) = #(name, answered(index)));
            answer(reply, least(answers))
        }
      | Ended(_) -> Unit
    }
}

// A process that asks the peer of the name how busy it is, and tells the
// gatherer.
fn ask(gatherer : Address(Gathering), index : Int, name : String, ms : Int) : Unit with m = {
    let _ = spawn(fn() : Unit with Never = {
        let utilisation = Peer.utilisation(name, ms);
        send(gatherer, Answered(index = index, utilisation = utilisation))
    });
    Unit
}

// The answer of the name at the index, whichever came before it.
fn answered(index : Int) : Either(Io.Error, Float) with Gathering =
    receive {
        Answered(index = answeredIndex, utilisation = utilisation) when answeredIndex == index ->
            utilisation
    }

// The name of the least utilisation among the answers, the first of two
// that are equal, or None where none is a utilisation.
fn least(answers : List(#(String, Either(Io.Error, Float)))) : Optional(String) = {
    let lowest =
        List.foldLeft(answers, None, fn(acc, #(name, utilisation)) = match #(acc, utilisation) {
            #(Some(#(_, leastSoFar)), Right(busy)) when leastSoFar <= busy -> acc
          | #(_, Right(busy)) -> Some(#(name, busy))
          | #(_, Left(_)) -> acc
        });
    Optional.map(lowest, fn(#(name, _)) = name)
}

//
// The tests (report §9.3), run by `ern test` as every library's are, in a
// program that is no node, where every ask answers `NotListed` (report
// §8.7): a pick over no name and over names no peer has, and the rule over
// the answers, which needs no peer. A pick over peers that answer is the
// real nodes' (test/ern_nodes_tests.erl). Regression tests, written after
// the code; they do not cover the pick's process ending where its caller
// ended before it asked.
//

let noName =
    Test.Case(name = "a pick over no name answers None",
              run = fn() = Test.equal(leastBusy([], 1000), None))

let noPeer =
    Test.Case(name = "a pick over names no peer has answers None",
              run = fn() = Test.equal(leastBusy(["a", "b"], 1000), None))

let leastAnswered =
    Test.Case(name = "the least utilisation answered is picked, the first given at a tie",
              run = fn() = {
                  let answers =
                      [#("a", Right(0.5)),
                       #("b", Left(Io.Timeout)),
                       #("c", Right(0.25)),
                       #("d", Right(0.25)),
                       #("e", Right(0.75))];
                  Test.equal(least(answers), Some("c"))
              })

let noneAnswered =
    Test.Case(name = "names whose asks all failed pick none",
              run = fn() =
                  Test.equal(least([#("a", Left(Io.Unreachable)), #("b", Left(Io.NotListed))]),
                             None))
