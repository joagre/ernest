/// Tables of the runtime, keyed by a value of type `k`. A table belongs to
/// the process that made it and ends with it, or with `close`, and every
/// operation on a table that has ended faults. Any process on the node that
/// holds a table reads and writes it: a table is state that processes share,
/// which is why this is a library and not the standard library's (report
/// §10). Keys are compared as the runtime compares its terms. Appendix D of
/// the report shows this library, with a shorter documentation, as its
/// example of a shim. A program puts the library on its load path, when it
/// is compiled and when it is run.
///
/// ## Examples
///
/// ```ernest
/// {
///     let table = Ets.new();
///     Ets.put(table, "a", 1);
///     Ets.get(table, "a")
/// }
/// // => Some(1)
/// ```
///
/// ```ernest
/// {
///     let table = Ets.new();
///     Ets.put(table, 1, "one");
///     Ets.remove(table, 1);
///     #(Ets.contains(table, 1), Ets.size(table))
/// }
/// // => #(false, 0)
/// ```
///
/// ## See also
///
/// `Map` for a value the program holds itself, `Erl` for what a shim needs
/// from Erlang.
///
/// since 0.1.0

/// A table of the runtime, keyed by `k` with values of type `v`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let table : Ets.Table(String, Int) = Ets.new();
///     Ets.size(table)
/// }
/// // => 0
/// ```
export foreign type Table(k=, v)

/// A fresh empty table, owned by the calling process.
export fn new() : Table(k, v) with m =
    rawNew(Erl.atom("ernest"), [Erl.atom("set"), Erl.atom("public")])

foreign fn rawNew(name : Foreign.Term, options : List(Foreign.Term)) : Table(k, v) with m =
    "ets:new/2"

/// Puts the value at that key, replacing any entry the key had.
///
/// ### Errors
///
/// On a table that has ended, faults as a foreign function that raises
/// does (report §7.4).
export fn put(table : Table(k, v), key : k, value : v) : Unit with m = {
    let _ = rawInsert(table, #(key, value));
    Unit
}

foreign fn rawInsert(table : Table(k, v), entry : #(k, v)) : Bool with m =
    "ets:insert/2"

/// The value at that key, or `None` where the table has no entry for it.
///
/// ### Errors
///
/// On a table that has ended, faults as a foreign function that raises
/// does (report §7.4).
export fn get(table : Table(k, v), key : k) : Optional(v) with m =
    match rawLookup(table, key) {
        [#(_, value)] -> Some(value)
      | _ -> None
    }

foreign fn rawLookup(table : Table(k, v), key : k) : List(#(k, v)) with m =
    "ets:lookup/2"

/// `true` when the table has an entry with that key.
///
/// ### Errors
///
/// On a table that has ended, faults as a foreign function that raises
/// does (report §7.4).
export fn contains(table : Table(k, v), key : k) : Bool with m =
    Optional.isSome(get(table, key))

/// Removes the entry at that key, which need not be there.
///
/// ### Errors
///
/// On a table that has ended, faults as a foreign function that raises
/// does (report §7.4).
export fn remove(table : Table(k, v), key : k) : Unit with m = {
    let _ = rawDelete(table, key);
    Unit
}

foreign fn rawDelete(table : Table(k, v), key : k) : Bool with m =
    "ets:delete/2"

/// The number of entries.
///
/// ### Errors
///
/// On a table that has ended, faults with `Fault("the table has ended")`.
export fn size(table : Table(k, v)) : Int with m =
    match Foreign.toInt(rawInfo(table, Erl.atom("size"))) {
        Some(count) -> count
      | None -> fault("the table has ended")
    }

foreign fn rawInfo(table : Table(k, v), item : Foreign.Term) : Foreign.Term with m =
    "ets:info/2"

/// Removes every entry, leaving the table.
///
/// ### Errors
///
/// On a table that has ended, faults as a foreign function that raises
/// does (report §7.4).
///
/// ### Examples
///
/// ```ernest
/// {
///     let table = Ets.new();
///     Ets.put(table, "k", "v");
///     Ets.clear(table);
///     Ets.toList(table)
/// }
/// // => []
/// ```
export fn clear(table : Table(k, v)) : Unit with m = {
    let _ = rawDeleteAllObjects(table);
    Unit
}

foreign fn rawDeleteAllObjects(table : Table(k, v)) : Bool with m =
    "ets:delete_all_objects/1"

/// Closes the table, deleting it; every operation on it after this faults.
///
/// ### Errors
///
/// On a table that has ended, faults as a foreign function that raises
/// does (report §7.4).
///
/// ### Examples
///
/// ```ernest
/// {
///     let table = Ets.new();
///     Ets.put(table, "k", "v");
///     Ets.close(table);
///     "closed"
/// }
/// // => "closed"
/// ```
export fn close(table : Table(k, v)) : Unit with m = {
    let _ = rawDeleteTable(table);
    Unit
}

foreign fn rawDeleteTable(table : Table(k, v)) : Bool with m =
    "ets:delete/1"

/// The entries as pairs, in unspecified order.
///
/// ### Errors
///
/// On a table that has ended, faults as a foreign function that raises
/// does (report §7.4).
export foreign fn toList(table : Table(k, v)) : List(#(k, v)) with m =
    "ets:tab2list/1"
