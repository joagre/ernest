#!/usr/bin/env escript
%% -*- erlang -*-
%% The Ernest compiler, report §11.1. Thin: puts the toolchain's erl/*/ebin,
%% the standard library's build/stdlib and the shell's build/shell, all
%% found relative to this script, on the code path, and calls ern_cli.

main(Args) ->
    Lib = filename:join([filename:dirname(filename:absname(escript:script_name())), "..", "erl"]),
    code:add_pathsa(filelib:wildcard(filename:join([Lib, "*", "ebin"]))),
    code:add_patha(filename:join([Lib, "..", "build", "stdlib"])),
    code:add_patha(filename:join([Lib, "..", "build", "shell"])),
    ern_cli:main(ernc, Args).
