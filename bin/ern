#!/bin/sh
# The Ernest toolchain, report §11: one command whose first word is its
# job, which ern_cli carries out. This launcher finds the toolchain's tree
# by following its own links, so that a link to it from a directory on the
# path works wherever the tree is (docs/design/install.md); it
# refuses a working directory whose name is not UTF-8 before the host
# starts, since the host hangs as it boots in one whose name is not UTF-8
# (report §11), but for --help and --version; and it starts the host with
# the tree's code on its path. The host reads no
# input of its own (-noinput), so that standard input is the runtime's
# alone (report §8.2), and -noinput comes after -noshell, since the host
# takes the last of the two; its break handler is off (+B), so that the
# interrupt ends it (report §8.6); and it reads no ~/.erlang. The host's
# flags from the environment, ERL_AFLAGS, ERL_FLAGS and ERL_ZFLAGS, and its
# code path from ERL_LIBS, are cleared, since they would change the host,
# or run code with -eval, with nothing in the command saying so. A
# standard output or standard error closed as the job begins can no longer
# be written, and the host would open /dev/null in its place: ern exits
# with status 141, and writes nothing (report §11.8).

self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
tree=$(cd "$(dirname "$self")/.." && pwd -P)

# Report §11: `ern --help` and `ern --version` read nothing of the working
# directory, so the host starts for them in the root directory, whose name
# is UTF-8, wherever ern was started.
case "$#:${1-}" in
    1:--help | 1:--version)
        cd /
        ;;
    *)
        if ! command -v iconv >/dev/null 2>&1; then
            echo "ern: iconv, which tells whether the working directory's name is UTF-8," \
                 "is not on the path" >&2
            exit 1
        fi
        if ! pwd -P | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then
            echo "ern: the working directory's name is not UTF-8" >&2
            exit 1
        fi
        ;;
esac

if ! command -v erl >/dev/null 2>&1; then
    echo "ern: erl, of Erlang/OTP 29, is not on the path" >&2
    exit 1
fi

if ! { true; } 2>/dev/null 3>&1 || ! { true; } 3>&2; then
    exit 141
fi

# Report Appendix E.23: a program's environment is the one ern was started
# in, so what is cleared here, and what the host's own launcher sets or
# changes, is kept as it was given under ERN_GIVEN_ and its name, which the
# runtime's helper puts back for a program and takes away (ern_exec.c).
for name in PATH BINDIR EMU PROGNAME ROOTDIR ERL_AFLAGS ERL_FLAGS ERL_ZFLAGS ERL_LIBS \
            ERL_CRASH_DUMP_SECONDS; do
    if eval "[ \"\${$name+set}\" = set ]"; then
        eval "ERN_GIVEN_$name=\$$name"
        export "ERN_GIVEN_$name"
    else
        unset "ERN_GIVEN_$name"
    fi
done
ERN_GIVEN=1
export ERN_GIVEN

unset ERL_AFLAGS ERL_FLAGS ERL_ZFLAGS ERL_LIBS

# Report §10, §11.8: a program that exhausts the host's memory ends with
# status 1 and the host's message, and the host writes no crash dump into
# the working directory, since its internals are no part of the outcome.
ERL_CRASH_DUMP_SECONDS=0
export ERL_CRASH_DUMP_SECONDS

# Report §8.7: a node's host takes its carrier only as it boots, so where
# the job's own words, of a job that makes a node, run, test or shell, hold
# --config-dir the host runs once first, parsing the command line as its
# job does and writing the flags a node's host boots with after a marker,
# which the second start takes. It writes none where the command starts no
# node or is refused, and the second start then says what was refused;
# what it writes without the marker is taken for nothing. The words of
# `ern run` from its file on, the file after a `--` among them, are the
# program's (report §11.2), so the scan ends at the file or the `--`, as
# the job's own reading of its words does (ern_cli's program_words/3), an
# option's value passed over: the options of `ern run` that take one are
# named here. Every word of `ern test` and `ern shell` is the job's.
# Another job, `ern config`, `ern reload` or `ern stop`, makes no node, and
# the host starts once.
node=
case ${1-} in
    run | test | shell)
        job=$1
        shift
        value=
        for word do
            if [ -n "$value" ]; then
                value=
            elif [ "$word" = --config-dir ]; then
                node=1
                value=1
            elif [ "$job" = run ]; then
                case $word in
                    --load-path | --libs-dir | --main) value=1 ;;
                    --) break ;;
                    -?*) ;;
                    *) break ;;
                esac
            fi
        done
        set -- "$job" "$@"
        ;;
esac
flags=
if [ -n "$node" ]; then
    flags=$(erl +B -boot no_dot_erlang -noshell -noinput \
        -pa "$tree"/erl/*/ebin -run ern_cli node_flags -extra "$@" 2>/dev/null) || flags=
    case $flags in
        "ern-node-flags "*) flags=${flags#ern-node-flags } ;;
        *) flags= ;;
    esac
fi
eval "set -- $flags -run ern_signals install -run ern_cli start -extra \"\$@\""

# Report §8.6: ern takes the host's signals as the first thing the host
# runs, before the entry's module is loaded, since until then the host's
# own handler ends a program with status 0.
exec erl +B -boot no_dot_erlang -noshell -noinput \
    -pa "$tree"/erl/*/ebin "$@"
