/// A value or the cause of its absence. `Either(e, a)` is `Left(e)`, the
/// cause, or `Right(a)`, the value, a prelude type (report §9.3); this module
/// holds the operations over it. A function that can fail with a cause
/// returns an `Either` (Appendix E.0 shape rule 4), and `<-` in a block unwraps one
/// (report §5.5).
///
/// ## Examples
///
/// ```ernest
/// let found : Either(String, Int) = Right(2);
/// Either.map(found, fn(n) = n * 10)
/// // => Right(20)
/// ```
///
/// ```ernest
/// Either.andThen(Right(3), fn(n) = if n > 5 then Right(n) else Left("small"))
/// // => Left("small")
/// ```
///
/// ```ernest
/// Either.withDefault(Left("gone"), 0)
/// // => 0
/// ```
///
/// ## See also
///
/// `Optional`, when the absence needs no cause.
///
/// since 0.1.0

/// `true` for `Left`.
///
/// ### Examples
///
/// ```ernest
/// Either.isLeft(Left(1))
/// // => true
/// ```
export fn isLeft(either : Either(e, a)) : Bool =
    match either {
        Left(_) -> true
      | Right(_) -> false
    }

/// `true` for `Right`.
///
/// ### Examples
///
/// ```ernest
/// Either.isRight(Left(1))
/// // => false
/// ```
export fn isRight(either : Either(e, a)) : Bool =
    match either {
        Left(_) -> false
      | Right(_) -> true
    }

/// The value in `Right`, or the default for `Left`.
export fn withDefault(either : Either(e, a), default : a) : a =
    match either {
        Right(value) -> value
      | Left(_) -> default
    }

/// `Right` of the function applied to the value, or the `Left` unchanged;
/// the function is not called on `Left`.
export fn map(either : Either(e, a), f : (a) -> b with x) : Either(e, b) with x =
    match either {
        Right(value) -> Right(f(value))
      | Left(cause) -> Left(cause)
    }

/// `Left` of the function applied to the cause, or the `Right` unchanged.
///
/// ### Examples
///
/// ```ernest
/// let failed : Either(String, Int) = Left("bad");
/// Either.mapLeft(failed, fn(s) = s <> "!")
/// // => Left("bad!")
/// ```
export fn mapLeft(either : Either(e, a), f : (e) -> b with x) : Either(b, a) with x =
    match either {
        Left(cause) -> Left(f(cause))
      | Right(value) -> Right(value)
    }

/// The function's result for `Right`, or the `Left` unchanged without
/// calling it: one step of a chain in which any step may fail.
export fn andThen(either : Either(e, a), f : (a) -> Either(e, b) with x) : Either(e, b) with x =
    match either {
        Right(value) -> f(value)
      | Left(cause) -> Left(cause)
    }

/// `Some` of the value in `Right`, or `None`; the cause is dropped.
///
/// ### Examples
///
/// ```ernest
/// Either.toOptional(Right(3))
/// // => Some(3)
/// ```
export fn toOptional(either : Either(e, a)) : Optional(a) =
    match either {
        Right(value) -> Some(value)
      | Left(_) -> None
    }

/// `Right` of the value in `Some`, or `Left` of the given cause for `None`.
///
/// ### Examples
///
/// ```ernest
/// let nothing : Optional(Int) = None;
/// Either.fromOptional(nothing, "missing")
/// // => Left("missing")
/// ```
export fn fromOptional(optional : Optional(a), cause : e) : Either(e, a) =
    match optional {
        Some(value) -> Right(value)
      | None -> Left(cause)
    }
