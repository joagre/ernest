/// Text: Unicode strings, held as UTF-8.
///
/// Use a `String` for text a person reads or writes. For the bytes of a file or
/// a socket use `Bytes`, and convert with `toUtf8` and `fromUtf8`. A string is
/// a value: every function here answers a new string and leaves the one it was
/// given as it was.
///
/// **Letters, not bytes.** A string is counted and indexed in graphemes, each
/// what a reader sees as one letter. `size`, `slice`, `indexOf`, `lastIndexOf`,
/// `padStart` and `padEnd` count graphemes, so `"é"` has size 1 whether its
/// accent is a letter of its own or a mark after an `e`. Every search matches
/// whole graphemes: `String.contains("e\u{301}", "e")` is `false`, since the
/// `e` there is part of a larger letter (report Appendix E.5).
///
/// **Chars.** `toList` gives the string's `Char`s, one Unicode scalar value
/// each, and `fromList` builds a string from them. A grapheme may be several
/// `Char`s, and `graphemes` gives the graphemes themselves.
///
/// ## Examples
///
/// Text split, each part in upper case, and joined again:
///
/// ```ernest
/// String.join(List.map(String.split("a,b", ","), String.toUpper), "-")
/// // => "A-B"
/// ```
///
/// Three characters from index 1:
///
/// ```ernest
/// String.slice("hello", 1, 3)
/// // => "ell"
/// ```
///
/// A number read from text:
///
/// ```ernest
/// String.toInt("-12")
/// // => Some(-12)
/// ```
///
/// ## See also
///
/// `Char` for one scalar value, `Bytes` for octets, `Int.toString` and
/// `Float.toString` for numbers as text.
///
/// since 0.1.0

/// The first string, then the second.
export fn String.<>(left : String, right : String) : String =
    left <> right

/// The number of graphemes, what a reader counts as letters. It is neither the
/// number of bytes nor the number of `Char`s: `e` with a combining accent is
/// one grapheme of two `Char`s.
///
/// ### Examples
///
/// ```ernest
/// #(String.size("héj"), String.isEmpty(""))
/// // => #(3, true)
/// ```
///
/// ```ernest
/// #(String.size("e\u{301}"), List.size(String.toList("e\u{301}")))
/// // => #(1, 2)
/// ```
export foreign fn size(text : String) : Int =
    "string:length/1"

/// The graphemes in order, each a `String`: what a reader sees as one letter,
/// where `toList` gives the `Char`s.
///
/// ### Examples
///
/// ```ernest
/// String.graphemes("a中!")
/// // => ["a", "中", "!"]
/// ```
///
/// ```ernest
/// #(List.size(String.graphemes("e\u{301}")), List.size(String.toList("e\u{301}")))
/// // => #(1, 2)
/// ```
export foreign fn graphemes(text : String) : List(String) =
    "ern_string:graphemes/1"

/// `true` for the empty string, `""`.
export fn isEmpty(text : String) : Bool =
    text == ""

/// Compares two strings by their code points, which `<` and the other
/// comparisons on strings use. It is not alphabetical order in any language:
/// every capital letter of ASCII comes before every small one, so `"Z" < "a"`.
///
/// ### Examples
///
/// ```ernest
/// String.compare("a", "b")
/// // => Less
/// ```
export fn compare(left : String, right : String) : Ordering =
    if left < right then Less else if left > right then Greater else Equal

/// `true` when `part` stands somewhere in `text`, as whole graphemes. An empty
/// `part` is always there.
///
/// ### Examples
///
/// ```ernest
/// #(String.contains("hello", "ell"), String.contains("hello", "x"))
/// // => #(true, false)
/// ```
///
/// ```ernest
/// String.contains("e\u{301}", "e")
/// // => false
/// ```
export fn contains(text : String, part : String) : Bool =
    Optional.isSome(indexOf(text, part))

/// The index, in graphemes, at which `part` first begins in `text`, or `None`
/// where it is not there. An empty `part` is at 0.
///
/// ### Examples
///
/// ```ernest
/// #(String.indexOf("hello", "ll"), String.indexOf("hello", "x"))
/// // => #(Some(2), None)
/// ```
export foreign fn indexOf(text : String, part : String) : Optional(Int) =
    "ern_string:index_of/2"

/// The index, in graphemes, at which `part` last begins in `text`, or `None`
/// where it is not there. An empty `part` is at the size of `text`.
///
/// ### Examples
///
/// ```ernest
/// #(String.lastIndexOf("hello", "l"), String.lastIndexOf("hello", "x"))
/// // => #(Some(3), None)
/// ```
export foreign fn lastIndexOf(text : String, part : String) : Optional(Int) =
    "ern_string:last_index_of/2"

/// `true` when `text` begins with `prefix`, as whole graphemes. Every string
/// begins with the empty string.
///
/// ### Examples
///
/// ```ernest
/// #(String.startsWith("hello", "he"), String.endsWith("hello", "lo"))
/// // => #(true, true)
/// ```
export fn startsWith(text : String, prefix : String) : Bool =
    slice(text, 0, size(prefix)) == prefix

/// `true` when `text` ends with `suffix`, as whole graphemes. Every string ends
/// with the empty string.
export fn endsWith(text : String, suffix : String) : Bool = {
    let count = size(suffix);
    size(text) >= count && slice(text, size(text) - count, count) == suffix
}

/// `text` with each occurrence of `old` replaced by `new`. Occurrences are
/// found from the left and do not overlap, so `replace("aaa", "aa", "b")` is
/// `"ba"`. An empty `old` changes nothing.
///
/// ### Examples
///
/// ```ernest
/// String.replace("a-b-c", "-", "+")
/// // => "a+b+c"
/// ```
export fn replace(text : String, old : String, new : String) : String =
    if isEmpty(old) then text else join(split(text, old), new)

/// The `count` graphemes of `text` from `index`, or as many as there are. An
/// `index` below 0 starts at the beginning, and a `count` below 1 gives the
/// empty string.
///
/// ### Examples
///
/// ```ernest
/// #(String.slice("hello", -1, 3), String.slice("hello", 3, 9))
/// // => #("hel", "lo")
/// ```
export fn slice(text : String, index : Int, count : Int) : String =
    if count <= 0 then "" else sliced(text, Int.max(index, 0), count)

foreign fn sliced(text : String, index : Int, count : Int) : String =
    "ern_string:slice/3"

/// `text` with copies of `pad` put in front until it has `count` graphemes, the
/// last copy cut to fit. A text that already has `count` or more is answered as
/// it is, and an empty `pad` adds nothing. A `pad` that begins with a combining
/// mark joins the grapheme beside it, and the text stays short.
///
/// ### Examples
///
/// ```ernest
/// #(String.padStart("7", 3, "0"), String.padEnd("7", 4, "ab"))
/// // => #("007", "7aba")
/// ```
///
/// ```ernest
/// String.size(String.padStart("ab", 4, "\u{301}"))
/// // => 3
/// ```
export fn padStart(text : String, count : Int, pad : String) : String =
    padding(text, count, pad) <> text

/// `text` with copies of `pad` put at its end until it has `count` graphemes,
/// as `padStart` puts them in front.
export fn padEnd(text : String, count : Int, pad : String) : String =
    text <> padding(text, count, pad)

fn padding(text : String, count : Int, pad : String) : String = {
    let missing = count - size(text);
    if isEmpty(pad) then
        ""
    else
        slice(repeat(pad, (missing + size(pad) - 1) / size(pad)), 0, missing)
}

/// `text` repeated `count` times. A `count` below 1 gives the empty string.
///
/// ### Examples
///
/// ```ernest
/// String.repeat("ab", 3)
/// // => "ababab"
/// ```
export fn repeat(text : String, count : Int) : String =
    copies(text, count, "")

fn copies(text : String, count : Int, acc : String) : String =
    if count <= 0 then acc else copies(text, count - 1, acc <> text)

/// `text` without whitespace at its start and its end. Whitespace is the
/// graphemes whose first code point is Unicode White_Space, as `Char.isSpace`
/// says: spaces, tabs, line ends and the like.
///
/// ### Examples
///
/// ```ernest
/// String.trim("  hi\n")
/// // => "hi"
/// ```
///
/// ```ernest
/// String.trim("\u{a0}a\u{3000}")
/// // => "a"
/// ```
export fn trim(text : String) : String =
    trimEnd(trimStart(text))

/// `text` without whitespace at its start, whitespace as `trim` has it.
///
/// ### Examples
///
/// ```ernest
/// #(String.trimStart("  a "), String.trimEnd("  a "))
/// // => #("a ", "  a")
/// ```
export fn trimStart(text : String) : String =
    if isSpaceFirst(slice(text, 0, 1)) then trimStart(drop(text, 1)) else text

/// `text` without whitespace at its end, whitespace as `trim` has it.
export fn trimEnd(text : String) : String =
    match lastGrapheme(text) {
        Some(#(rest, last)) when isSpaceFirst(last) -> trimEnd(rest)
      | _ -> text
    }

// Whether a grapheme's first code point is White_Space, which a trim
// removes it for (report Appendix E.5).
fn isSpaceFirst(grapheme : String) : Bool =
    match toList(grapheme) {
        first :: _ -> Char.isSpace(first)
      | [] -> false
    }

// Report Appendix E.5: the string without its last grapheme, and that
// grapheme, found from the string's end without a walk from its start, a
// primitive since graphemes are the host's (E.0 rule 1).
foreign fn lastGrapheme(text : String) : Optional(#(String, String)) =
    "ern_string:last_grapheme/1"

/// `text` in lower case, by Unicode's rules, which may change its size: one
/// letter may become two.
///
/// ### Examples
///
/// ```ernest
/// #(String.toLower("ÉH"), String.toUpper("éh"))
/// // => #("éh", "ÉH")
/// ```
export foreign fn toLower(text : String) : String =
    "ern_string:to_lower/1"

/// `text` in upper case, by Unicode's rules, which may change its size: `"ß"`
/// becomes `"SS"`.
export foreign fn toUpper(text : String) : String =
    "ern_string:to_upper/1"

/// The lines of `text`, split at each line feed and at each carriage return
/// followed by a line feed. A line end at the very end adds no empty line, and
/// `""` has no lines.
///
/// ### Examples
///
/// ```ernest
/// #(String.lines("a\nb\n"), String.lines("a\r\nb"))
/// // => #(["a", "b"], ["a", "b"])
/// ```
export fn lines(text : String) : List(String) =
    if isEmpty(text) then
        []
    else {
        let parts = List.flatMap(split(text, "\r\n"), fn(part) = split(part, "\n"));
        match List.last(parts) {
            Some("") -> List.dropLast(parts, 1)
          | _ -> parts
        }
    }

/// The words of `text`: the parts between runs of whitespace, whitespace as
/// `trim` has it, none of them empty. A grapheme is never split, so a combining
/// mark after a space goes with the space.
///
/// ### Examples
///
/// ```ernest
/// #(String.words("  one two\tthree\n"), String.words(" "))
/// // => #(["one", "two", "three"], [])
/// ```
///
/// ```ernest
/// String.words("a \u{301}b")
/// // => ["a", "b"]
/// ```
///
/// since 0.2.0
export fn words(text : String) : List(String) =
    List.reverse(wordsFrom(graphemes(text), [], []))

// The words before the graphemes, in reverse, the one being read's
// graphemes in reverse too.
fn wordsFrom(graphemes : List(String), word : List(String), acc : List(String)) : List(String) =
    match graphemes {
        [] -> withWord(word, acc)
      | grapheme :: rest when isSpaceFirst(grapheme) -> wordsFrom(rest, [], withWord(word, acc))
      | grapheme :: rest -> wordsFrom(rest, grapheme :: word, acc)
    }

fn withWord(word : List(String), acc : List(String)) : List(String) =
    match word {
        [] -> acc
      | _ -> join(List.reverse(word), "") :: acc
    }

/// The parts of `text` between the occurrences of `separator`, empty parts
/// included: `"a,,b"` split at `","` is `["a", "", "b"]`. An empty `separator`
/// gives `[text]`, and so does a text without one.
///
/// ### Examples
///
/// ```ernest
/// String.split("a,,b", ",")
/// // => ["a", "", "b"]
/// ```
export fn split(text : String, separator : String) : List(String) =
    if isEmpty(separator) then [text] else List.reverse(parts(text, separator, size(separator), []))

// The parts found so far, the last first, and the rest of the string, each
// step reading only as far as the next separator.
fn parts(text : String,
         separator : String,
         separatorSize : Int,
         acc : List(String)) : List(String) =
    match indexOf(text, separator) {
        None -> text :: acc
      | Some(index) ->
            parts(drop(text, index + separatorSize),
                  separator,
                  separatorSize,
                  slice(text, 0, index) :: acc)
    }

// Report Appendix E.5: the string after that many graphemes, walking only
// those, a primitive since graphemes are the host's.
foreign fn drop(text : String, count : Int) : String =
    "ern_string:drop/2"

/// The strings of `parts` joined, with `separator` between each two.
///
/// ### Examples
///
/// ```ernest
/// String.join(["a", "b"], ", ")
/// // => "a, b"
/// ```
export fn join(parts : List(String), separator : String) : String =
    match parts {
        [] -> ""
      | first :: rest -> List.foldLeft(rest, first, fn(acc, part) = acc <> separator <> part)
    }

/// The number the decimal digits of `text` write, with an optional leading `-`,
/// or `None` for any other text: a space, a `+`, an `_` or a point among them.
///
/// ### Examples
///
/// ```ernest
/// #(String.toInt("12"), String.toInt("1x"))
/// // => #(Some(12), None)
/// ```
export fn toInt(text : String) : Optional(Int) =
    toIntBase(text, 10)

/// The number `text` writes in `base`, 2 to 36, with digits and letters in
/// either case and an optional leading `-`, or `None` for any other text, a
/// leading `+` among it, and for a base outside 2 to 36.
///
/// ### Examples
///
/// ```ernest
/// #(String.toIntBase("ff", 16), String.toIntBase("fg", 16))
/// // => #(Some(255), None)
/// ```
export fn toIntBase(text : String, base : Int) : Optional(Int) =
    if base < 2 || base > 36 then
        None
    else match toList(text) {
        '-' :: rest -> Optional.map(number(rest, base), Int.negate)
      | chars -> number(chars, base)
    }

// The number the digits spell in the base, at least one of them.
fn number(chars : List(Char), base : Int) : Optional(Int) =
    match digits(chars, base, []) {
        Some(values) when !List.isEmpty(values) -> Some(valueOf(values, List.size(values), base))
      | _ -> None
    }

// The digits' values in order, or `None` where a character is no digit in
// the base.
fn digits(chars : List(Char), base : Int, acc : List(Int)) : Optional(List(Int)) =
    match chars {
        [] -> Some(List.reverse(acc))
      | char :: rest -> match Char.digitValue(char, base) {
            Some(value) -> digits(rest, base, value :: acc)
          | None -> None
        }
    }

// The value of the digits, count of them, read in halves past forty, so
// that a long numeral costs what multiplying its halves costs and not the
// square of its length.
fn valueOf(values : List(Int), count : Int, base : Int) : Int =
    if count <= 40 then
        List.foldLeft(values, 0, fn(acc, value) = acc * base + value)
    else {
        let low = count / 2;
        let high = count - low;
        valueOf(List.take(values, high), high, base) * power(base, low)
            + valueOf(List.drop(values, high), low, base)
    }

// The base to the exponent, 0 or more, by squaring.
fn power(base : Int, exponent : Int) : Int =
    if exponent == 0 then
        1
    else {
        let half = power(base, exponent / 2);
        if exponent % 2 == 0 then half * half else half * half * base
    }

/// `Some(true)` for `"true"` and `Some(false)` for `"false"`, or `None` for any
/// other text; the inverse of `Bool.toString`.
///
/// ### Examples
///
/// ```ernest
/// #(String.toBool("true"), String.toBool("yes"))
/// // => #(Some(true), None)
/// ```
export fn toBool(text : String) : Optional(Bool) =
    if text == "true" then Some(true) else if text == "false" then Some(false) else None

/// The `Float` the text writes as a float literal, `"2.5"` or `"1e10"`, with an
/// optional leading `-` and without `_`, or `None` for any other text and for a
/// value too large for a `Float`. A value too small to hold is the nearest
/// `Float`, `0.0` among them (report §2.5, §3.1).
///
/// ### Examples
///
/// ```ernest
/// #(String.toFloat("1.5"), String.toFloat("1"))
/// // => #(Some(1.5), None)
/// ```
export foreign fn toFloat(text : String) : Optional(Float) =
    "ern_string:to_float/1"

/// The `Char`s of the string, its Unicode scalar values, in order. A grapheme
/// may be several of them; `graphemes` gives the graphemes.
///
/// ### Examples
///
/// ```ernest
/// String.fromList(List.filter(String.toList("a1b"), Char.isAlpha))
/// // => "ab"
/// ```
export foreign fn toList(text : String) : List(Char) =
    "ern_string:to_list/1"

/// The string of those `Char`s, in order.
export foreign fn fromList(chars : List(Char)) : String =
    "ern_string:from_list/1"

/// The string's bytes, in UTF-8, as a file or a socket takes them.
///
/// ### Examples
///
/// ```ernest
/// #(String.toUtf8("hi"), String.fromUtf8(<<104, 105>>))
/// // => #(<<104, 105>>, Some("hi"))
/// ```
export foreign fn toUtf8(text : String) : Bytes =
    "ern_string:to_utf8/1"

/// The string that `bytes` holds in UTF-8, or `None` where they are not UTF-8.
export foreign fn fromUtf8(bytes : Bytes) : Optional(String) =
    "ern_string:from_utf8/1"
