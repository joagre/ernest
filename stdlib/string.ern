/// Operations on `String`, a Unicode string (report §3.1). A `String` is
/// a container read through `toList`, which gives its `Char`s. `size`,
/// `slice`, `indexOf`, `lastIndexOf`, `padStart`, and `padEnd` count and
/// index in graphemes, extended grapheme clusters, each what a reader sees
/// as one letter; `toList` and `fromList` are `Char`s, one scalar value
/// each. The primitives are `size`, `graphemes`, `indexOf`, `lastIndexOf`,
/// and the slice `slice` makes once it has clipped its index and count,
/// the operations that need Unicode's tables, with the private `drop` and
/// `lastGrapheme`, `toLower`, and `toUpper`, and the conversions
/// `toFloat`, `toList`, `fromList`, `toUtf8`, and `fromUtf8`, the
/// runtime's; the rest is written over them, so every search matches whole
/// graphemes (report Appendix E.0 rule 1).
///
/// ## Examples
///
/// ```ernest
/// String.join(List.map(String.split("a,b", ","), String.toUpper), "-")
/// // => "A-B"
/// ```
///
/// ```ernest
/// String.slice("hello", 1, 3)
/// // => "ell"
/// ```
///
/// ```ernest
/// String.toInt("-12")
/// // => Some(-12)
/// ```
///
/// ## See also
///
/// `Char` for one scalar value, `Bytes` for octets, `Int.toString` and
/// `Float.toString` for numbers as text.
///
/// since 0.1.0

/// The first, then the second.
export fn String.<>(left : String, right : String) : String =
    left <> right

/// The number of graphemes, extended grapheme clusters, which is neither
/// the number of octets nor the number of `Char`s: `e` with a combining
/// acute is one grapheme of two `Char`s.
///
/// ### Examples
///
/// ```ernest
/// #(String.size("héj"), String.isEmpty(""))
/// // => #(3, true)
/// ```
///
/// ```ernest
/// #(String.size("e\u{301}"), List.size(String.toList("e\u{301}")))
/// // => #(1, 2)
/// ```
export foreign fn size(text : String) : Int =
    "string:length/1"

/// The graphemes in order, each a `String`: what a reader sees as one
/// letter, where `toList` gives the `Char`s.
///
/// ### Examples
///
/// ```ernest
/// String.graphemes("a中!")
/// // => ["a", "中", "!"]
/// ```
///
/// ```ernest
/// #(List.size(String.graphemes("e\u{301}")), List.size(String.toList("e\u{301}")))
/// // => #(1, 2)
/// ```
export foreign fn graphemes(text : String) : List(String) =
    "ern_string:graphemes/1"

/// `true` for the empty string.
export fn isEmpty(text : String) : Bool =
    text == ""

/// The order of the code points, which `<` and the other comparisons use.
///
/// ### Examples
///
/// ```ernest
/// String.compare("a", "b")
/// // => Less
/// ```
export fn compare(left : String, right : String) : Ordering =
    if left < right then Less else if left > right then Greater else Equal

/// `true` when the second is somewhere in the first, as whole graphemes; an
/// empty second is always there.
///
/// ### Examples
///
/// ```ernest
/// #(String.contains("hello", "ell"), String.contains("hello", "x"))
/// // => #(true, false)
/// ```
///
/// ```ernest
/// String.contains("e\u{301}", "e")
/// // => false
/// ```
export fn contains(text : String, part : String) : Bool =
    indexOf(text, part) != None

/// Where the second begins in the first, and `None` where it is not
/// there. An empty second is at 0.
///
/// ### Examples
///
/// ```ernest
/// #(String.indexOf("hello", "ll"), String.indexOf("hello", "x"))
/// // => #(Some(2), None)
/// ```
export foreign fn indexOf(text : String, part : String) : Optional(Int) =
    "ern_string:index_of/2"

/// Where the second begins last in the first, and `None` where it is not
/// there. An empty second is at the first's size.
///
/// ### Examples
///
/// ```ernest
/// #(String.lastIndexOf("hello", "l"), String.lastIndexOf("hello", "x"))
/// // => #(Some(3), None)
/// ```
export foreign fn lastIndexOf(text : String, part : String) : Optional(Int) =
    "ern_string:last_index_of/2"

/// `true` when the string begins with the second, as whole graphemes, and
/// for an empty second.
///
/// ### Examples
///
/// ```ernest
/// #(String.startsWith("hello", "he"), String.endsWith("hello", "lo"))
/// // => #(true, true)
/// ```
export fn startsWith(text : String, prefix : String) : Bool =
    slice(text, 0, size(prefix)) == prefix

/// `true` when the string ends with the second, as whole graphemes, and for
/// an empty second.
export fn endsWith(text : String, suffix : String) : Bool = {
    let count = size(suffix);
    size(text) >= count && slice(text, size(text) - count, count) == suffix
}

/// Every occurrence of the second replaced by the third; an empty second
/// changes nothing.
///
/// ### Examples
///
/// ```ernest
/// String.replace("a-b-c", "-", "+")
/// // => "a+b+c"
/// ```
export fn replace(text : String, old : String, new : String) : String =
    if isEmpty(old) then text else join(split(text, old), new)

/// From the index, that many graphemes, clipped to what is there; a
/// negative index starts at the beginning, and a negative count gives the
/// empty string.
///
/// ### Examples
///
/// ```ernest
/// #(String.slice("hello", -1, 3), String.slice("hello", 3, 9))
/// // => #("hel", "lo")
/// ```
export fn slice(text : String, index : Int, count : Int) : String =
    if count <= 0 then "" else sliced(text, Int.max(index, 0), count)

foreign fn sliced(text : String, index : Int, count : Int) : String =
    "ern_string:slice/3"

/// The pad's copies in front until the text has that many graphemes, the
/// last copy cut to fit; an empty pad adds none. A pad that begins no
/// grapheme, a combining mark, joins the grapheme beside it, and the text
/// stays short.
///
/// ### Examples
///
/// ```ernest
/// #(String.padStart("7", 3, "0"), String.padEnd("7", 4, "ab"))
/// // => #("007", "7aba")
/// ```
///
/// ```ernest
/// String.size(String.padStart("ab", 4, "\u{301}"))
/// // => 3
/// ```
export fn padStart(text : String, count : Int, pad : String) : String =
    padding(text, count, pad) <> text

/// The pad's copies at the end until the text has that many graphemes, as
/// `padStart` puts them in front.
export fn padEnd(text : String, count : Int, pad : String) : String =
    text <> padding(text, count, pad)

fn padding(text : String, count : Int, pad : String) : String = {
    let missing = count - size(text);
    if isEmpty(pad) then
        ""
    else
        slice(repeat(pad, (missing + size(pad) - 1) / size(pad)), 0, missing)
}

/// The string `count` times; `count` below 0 gives the empty string.
///
/// ### Examples
///
/// ```ernest
/// String.repeat("ab", 3)
/// // => "ababab"
/// ```
export fn repeat(text : String, count : Int) : String =
    copies(text, count, "")

fn copies(text : String, count : Int, acc : String) : String =
    if count <= 0 then acc else copies(text, count - 1, acc <> text)

/// Without leading and trailing whitespace: the graphemes whose first code
/// point is White_Space, as `Char.isSpace` says. It is `trimStart` then
/// `trimEnd`, a pair the library keeps named (report Appendix E.0 rule 4).
///
/// ### Examples
///
/// ```ernest
/// String.trim("  hi\n")
/// // => "hi"
/// ```
///
/// ```ernest
/// String.trim("\u{a0}a\u{3000}")
/// // => "a"
/// ```
export fn trim(text : String) : String =
    trimEnd(trimStart(text))

/// Without leading whitespace, as `trim` has it.
///
/// ### Examples
///
/// ```ernest
/// #(String.trimStart("  a "), String.trimEnd("  a "))
/// // => #("a ", "  a")
/// ```
export fn trimStart(text : String) : String =
    if isSpaceFirst(slice(text, 0, 1)) then trimStart(drop(text, 1)) else text

/// Without trailing whitespace, as `trim` has it.
export fn trimEnd(text : String) : String =
    match lastGrapheme(text) {
        Some(#(rest, last)) when isSpaceFirst(last) -> trimEnd(rest)
      | _ -> text
    }

// Whether a grapheme's first code point is White_Space, which a trim
// removes it for (report Appendix E.5).
fn isSpaceFirst(grapheme : String) : Bool =
    match toList(grapheme) {
        first :: _ -> Char.isSpace(first)
      | [] -> false
    }

// Report Appendix E.5: the string without its last grapheme, and that
// grapheme, found from the string's end without a walk from its start, a
// primitive since graphemes are the host's (E.0 rule 1).
foreign fn lastGrapheme(text : String) : Optional(#(String, String)) =
    "ern_string:last_grapheme/1"

/// The lower-case form, by Unicode.
///
/// ### Examples
///
/// ```ernest
/// #(String.toLower("ÉH"), String.toUpper("éh"))
/// // => #("éh", "ÉH")
/// ```
export foreign fn toLower(text : String) : String =
    "ern_string:to_lower/1"

/// The upper-case form, by Unicode.
export foreign fn toUpper(text : String) : String =
    "ern_string:to_upper/1"

/// The lines, split at each line feed and at each carriage return with a
/// line feed, which is one grapheme; a line's end at the end adds no empty
/// line, and `""` has no lines.
///
/// ### Examples
///
/// ```ernest
/// #(String.lines("a\nb\n"), String.lines("a\r\nb"))
/// // => #(["a", "b"], ["a", "b"])
/// ```
export fn lines(text : String) : List(String) =
    if isEmpty(text) then
        []
    else {
        let parts = List.flatMap(split(text, "\r\n"), fn(part) = split(part, "\n"));
        match List.last(parts) {
            Some("") -> List.dropLast(parts, 1)
          | _ -> parts
        }
    }

/// The words: the parts between runs of White_Space, the Unicode property
/// `Char.isSpace` reads, none of them empty.
///
/// ### Examples
///
/// ```ernest
/// #(String.words("  one two\tthree\n"), String.words(" "))
/// // => #(["one", "two", "three"], [])
/// ```
///
/// since 0.2.0
export fn words(text : String) : List(String) =
    List.reverse(wordsFrom(toList(text), [], []))

// The words before the characters, in reverse, the one being read's
// characters in reverse too.
fn wordsFrom(chars : List(Char), word : List(Char), acc : List(String)) : List(String) =
    match chars {
        [] -> withWord(word, acc)
      | char :: rest when Char.isSpace(char) -> wordsFrom(rest, [], withWord(word, acc))
      | char :: rest -> wordsFrom(rest, char :: word, acc)
    }

fn withWord(word : List(Char), acc : List(String)) : List(String) =
    match word {
        [] -> acc
      | _ -> fromList(List.reverse(word)) :: acc
    }

/// The parts between the occurrences of the second, the empty parts
/// included; an empty second gives the string alone.
///
/// ### Examples
///
/// ```ernest
/// String.split("a,,b", ",")
/// // => ["a", "", "b"]
/// ```
export fn split(text : String, separator : String) : List(String) =
    if isEmpty(separator) then [text] else List.reverse(parts(text, separator, size(separator), []))

// The parts found so far, the last first, and the rest of the string, each
// step reading only as far as the next separator.
fn parts(text : String,
         separator : String,
         separatorSize : Int,
         acc : List(String)) : List(String) =
    match indexOf(text, separator) {
        None -> text :: acc
      | Some(index) ->
            parts(drop(text, index + separatorSize),
                  separator,
                  separatorSize,
                  slice(text, 0, index) :: acc)
    }

// Report Appendix E.5: the string after that many graphemes, walking only
// those, a primitive since graphemes are the host's.
foreign fn drop(text : String, count : Int) : String =
    "ern_string:drop/2"

/// The parts with the second between them.
///
/// ### Examples
///
/// ```ernest
/// String.join(["a", "b"], ", ")
/// // => "a, b"
/// ```
export fn join(parts : List(String), separator : String) : String =
    match parts {
        [] -> ""
      | first :: rest -> List.foldLeft(rest, first, fn(acc, part) = acc <> separator <> part)
    }

/// The digits 0 to 9 as an `Int`, with an optional leading `-`, or `None`
/// for anything else.
///
/// ### Examples
///
/// ```ernest
/// #(String.toInt("12"), String.toInt("1x"))
/// // => #(Some(12), None)
/// ```
export fn toInt(text : String) : Optional(Int) =
    toIntBase(text, 10)

/// The digits and letters in that base, 2 to 36, in either case, with an
/// optional leading `-`, or `None` for anything else, a leading `+` among
/// it, and for a base outside those.
///
/// ### Examples
///
/// ```ernest
/// #(String.toIntBase("ff", 16), String.toIntBase("fg", 16))
/// // => #(Some(255), None)
/// ```
export fn toIntBase(text : String, base : Int) : Optional(Int) =
    if base < 2 || base > 36 then
        None
    else match toList(text) {
        '-' :: rest -> Optional.map(number(rest, base), Int.negate)
      | chars -> number(chars, base)
    }

// The number the digits spell in the base, at least one of them.
fn number(chars : List(Char), base : Int) : Optional(Int) =
    match List.tryMap(chars, fn(char) = digitIn(char, base)) {
        Right(values) when !List.isEmpty(values) -> Some(valueOf(values, List.size(values), base))
      | _ -> None
    }

// A digit's value in the base, or the character that is none.
fn digitIn(char : Char, base : Int) : Either(Char, Int) =
    match digitValue(char) {
        Some(value) when value < base -> Right(value)
      | _ -> Left(char)
    }

// The value of the digits, count of them, read in halves past forty, so
// that a long numeral costs what multiplying its halves costs and not the
// square of its length.
fn valueOf(values : List(Int), count : Int, base : Int) : Int =
    if count <= 40 then
        List.foldLeft(values, 0, fn(acc, value) = acc * base + value)
    else {
        let low = count / 2;
        let high = count - low;
        valueOf(List.take(values, high), high, base) * power(base, low)
            + valueOf(List.drop(values, high), low, base)
    }

// The base to the exponent, 0 or more, by squaring.
fn power(base : Int, exponent : Int) : Int =
    if exponent == 0 then
        1
    else {
        let half = power(base, exponent / 2);
        if exponent % 2 == 0 then half * half else half * half * base
    }

// A digit's value, the letters after 9 in either case: `a` and `A` are 10.
fn digitValue(char : Char) : Optional(Int) =
    if char >= '0' && char <= '9' then
        Some(Char.toInt(char) - Char.toInt('0'))
    else if char >= 'a' && char <= 'z' then
        Some(Char.toInt(char) - Char.toInt('a') + 10)
    else if char >= 'A' && char <= 'Z' then
        Some(Char.toInt(char) - Char.toInt('A') + 10)
    else
        None

/// `true` for `"true"` and `false` for `"false"`, or `None` for anything
/// else; the inverse of `Bool.toString`.
///
/// ### Examples
///
/// ```ernest
/// #(String.toBool("true"), String.toBool("yes"))
/// // => #(Some(true), None)
/// ```
export fn toBool(text : String) : Optional(Bool) =
    if text == "true" then Some(true) else if text == "false" then Some(false) else None

/// The float literal form of report §2.5 without `_`, with an optional
/// leading `-`, as a `Float`, or `None` for anything else and for a value
/// beyond the finite range of report §3.1; one below the smallest
/// subnormal is the nearest `Float`, `0.0` among them.
///
/// ### Examples
///
/// ```ernest
/// #(String.toFloat("1.5"), String.toFloat("1"))
/// // => #(Some(1.5), None)
/// ```
export foreign fn toFloat(text : String) : Optional(Float) =
    "ern_string:to_float/1"

/// The code points, in order.
///
/// ### Examples
///
/// ```ernest
/// String.fromList(List.filter(String.toList("a1b"), Char.isAlpha))
/// // => "ab"
/// ```
export foreign fn toList(text : String) : List(Char) =
    "ern_string:to_list/1"

/// The string of those code points.
export foreign fn fromList(chars : List(Char)) : String =
    "ern_string:from_list/1"

/// The UTF-8 octets of the string.
///
/// ### Examples
///
/// ```ernest
/// #(String.toUtf8("hi"), String.fromUtf8(<<104, 105>>))
/// // => #(<<104, 105>>, Some("hi"))
/// ```
export foreign fn toUtf8(text : String) : Bytes =
    "ern_string:to_utf8/1"

/// The string those octets spell, or `None` when they are not UTF-8.
export foreign fn fromUtf8(bytes : Bytes) : Optional(String) =
    "ern_string:from_utf8/1"
