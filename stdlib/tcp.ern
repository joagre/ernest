/// TCP over its system process, which opens sockets (report §8.2).
/// A socket is a process: its address can be sent, monitored, killed, and
/// adapted with `via` like any other. It is owned by the process that
/// opened it, the caller of `accept` or `connect`, until `Tcp.give` gives
/// it another, and it lives until `Tcp.close` or until its owner dies,
/// which kills it; a read after its end faults. Once its connection has closed from the far
/// end, each read and each write answers `Left(Closed)`.
/// A listener lives until `Tcp.closeListener`. A read, an accept, or a
/// connect that times out has taken nothing, so bytes that arrive later
/// wait for the next read. There are no socket options; framing is
/// bitstrings (report §5.11). The last argument of a function that waits
/// is the milliseconds.
///
/// ## Examples
///
/// A listener, a process that echoes what the connection it accepts sends,
/// and a connection to it, one message each way:
///
/// ```ernest
/// {
///     let listener <- Tcp.listen("127.0.0.1", 0);
///     let port <- Tcp.port(listener);
///     let _ = spawn(Local, fn() = match Tcp.accept(listener, 1000) {
///         Right(peer) -> {
///             let _ = match Tcp.read(peer, 1000) {
///                 Right(bytes) -> Tcp.write(peer, bytes)
///               | Left(e) -> Left(e)
///             };
///             Tcp.close(peer)
///         }
///       | Left(_) -> Unit
///     });
///     let client <- Tcp.connect("127.0.0.1", port, 1000);
///     let _ <- Tcp.write(client, String.toUtf8("ping"));
///     let answer = Tcp.read(client, 1000);
///     Tcp.close(client);
///     Tcp.closeListener(listener);
///     answer
/// }
/// ```
///
/// ## See also
///
/// `Bytes` for what a socket carries, `monitor` for learning that a
/// socket was closed.
///
/// since 0.1.0

/// What a listener takes; a program uses `Tcp.accept`, `Tcp.port`, and
/// `Tcp.closeListener` (report Appendix E.18).
///
/// ### Examples
///
/// ```ernest
/// {
///     let listener <- Tcp.listen("127.0.0.1", 0);
///     Tcp.closeListener(listener);
///     Right(Unit)
/// }
/// ```
export abstract type ListenerMsg =
    Accept(ms : Int, owner : Process, reply : Reply(Either(Io.Error, Address(SockMsg))))
  | Port(reply : Reply(Either(Io.Error, Int)))
  | CloseListener

/// What a connected socket takes; a program uses `Tcp.read`, `Tcp.write`,
/// `Tcp.close`, `Tcp.give`, `Tcp.peer`, and `Tcp.local` (report Appendix
/// E.18).
///
/// ### Examples
///
/// ```ernest
/// Tcp.connect("127.0.0.1", 7000, 1000)
/// ```
export abstract type SockMsg =
    Recv(ms : Int, reply : Reply(Either(Io.Error, Bytes)))
  | Send(bytes : Bytes, reply : Reply(Either(Io.Error, Unit)))
  | Close
  | Give(owner : Process)
  | FarEnd(reply : Reply(Either(Io.Error, Endpoint)))
  | NearEnd(reply : Reply(Either(Io.Error, Endpoint)))

/// An end of a connection: the host's address as text, and the port.
///
/// ### Examples
///
/// ```ernest
/// Tcp.Endpoint(host = "127.0.0.1", port = 7000).port
/// // => 7000
/// ```
export type Endpoint = Endpoint(host : String, port : Int)

// What TCP's system process takes.
type Msg =
    Listen(host : String, port : Int, reply : Reply(Either(Io.Error, Address(ListenerMsg))))
  | Connect(host : String,
            port : Int,
            ms : Int,
            owner : Process,
            reply : Reply(Either(Io.Error, Address(SockMsg))))

// Report §8.2: the system reference, the runtime's address of the TCP process,
// bound at each start.
let reference : Address(Msg) = system(Erl.atom("tcp"))

foreign fn system(name : Foreign) : Address(Msg) with m =
    "ern_rt:sys/1"

/// A listener on the port of the host's interface that the name or the
/// address names: `"127.0.0.1"` is the loopback alone, `"0.0.0.0"` every
/// interface of IPv4, and `"::"` every interface of IPv6. Port 0 asks the
/// system for a free one, which `Tcp.port` tells.
export fn listen(host : String, port : Int) : Either(Io.Error, Address(ListenerMsg)) with m =
    Address.callForever(reference, fn(r) = Listen(host = host, port = port, reply = r))

/// The port the listener listens on.
///
/// ### Errors
///
/// On a listener that has ended, closed or killed, faults as
/// `Address.callForever` does on an ended process.
///
/// ### Examples
///
/// ```ernest
/// {
///     let listener <- Tcp.listen("127.0.0.1", 0);
///     let port <- Tcp.port(listener);
///     Tcp.closeListener(listener);
///     Right(port > 0)
/// }
/// // => Right(true)
/// ```
export fn port(listener : Address(ListenerMsg)) : Either(Io.Error, Int) with m =
    Address.callForever(listener, fn(r) = Port(reply = r))

/// The next connection to the listener, owned by the caller, or
/// `Left(Io.Timeout)` when none comes in time, having taken none;
/// `Left(Io.Closed)` when the listener is closed while it waits.
///
/// ### Errors
///
/// On a listener that has ended, closed or killed, faults as
/// `Address.callForever` does on an ended process.
///
/// ### Examples
///
/// ```ernest
/// {
///     let listener <- Tcp.listen("127.0.0.1", 0);
///     let answer = Tcp.accept(listener, 10);
///     Tcp.closeListener(listener);
///     answer
/// }
/// ```
export fn accept(listener : Address(ListenerMsg),
                 ms : Int) : Either(Io.Error, Address(SockMsg)) with m = {
    let owner = Process.fromAddress(self());
    Address.callForever(listener, fn(r) = Accept(ms = ms, owner = owner, reply = r))
}

/// A connection to that host and port, owned by the caller, or
/// `Left(Io.Timeout)` when it is not made in time; one made later is
/// closed.
export fn connect(host : String,
                  port : Int,
                  ms : Int) : Either(Io.Error, Address(SockMsg)) with m = {
    let owner = Process.fromAddress(self());
    Address.callForever(reference,
                        fn(r) =
                            Connect(host = host, port = port, ms = ms, owner = owner, reply = r))
}

/// What has arrived, at least one byte, or `Left(Io.Closed)` once the
/// connection has closed and what came before is read, or
/// `Left(Io.Timeout)` when nothing comes in time, having taken nothing.
///
/// ### Errors
///
/// On a socket that has ended, closed or killed, faults as
/// `Address.callForever` does on an ended process.
export fn read(socket : Address(SockMsg), ms : Int) : Either(Io.Error, Bytes) with m =
    Address.callForever(socket, fn(r) = Recv(ms = ms, reply = r))

/// Writes the bytes to the socket, and answers `Right(Unit)` once the
/// socket has taken them, waiting while the connection is behind. That the
/// socket took them does not mean that the far end has them.
///
/// ### Errors
///
/// Answers `Left(Closed)` once the connection has closed, from either end
/// or by a failure, and `Left(Other(text))`, the host's reason, when the
/// host refuses the bytes for another. A write to a socket that has been
/// closed with `Tcp.close` faults as `Address.callForever` does on an
/// ended process.
export fn write(socket : Address(SockMsg), bytes : Bytes) : Either(Io.Error, Unit) with m =
    Address.callForever(socket, fn(r) = Send(bytes = bytes, reply = r))

/// Closes the socket, which ends its process.
export fn close(socket : Address(SockMsg)) : Unit with m =
    send(socket, Close)

/// Makes the process the socket's owner, so that the socket is killed when
/// that process dies and no longer when the one before did; a process that
/// has ended already takes it with it at once. Nothing happens on a socket
/// that has ended.
///
/// ### Examples
///
/// ```ernest
/// {
///     let listener <- Tcp.listen("127.0.0.1", 0);
///     let port <- Tcp.port(listener);
///     let client <- Tcp.connect("127.0.0.1", port, 1000);
///     let keeper = spawn(Local, fn() : Unit with Never = receive {
///         after 1000 -> Unit
///     });
///     Tcp.give(client, Process.fromAddress(keeper));
///     Tcp.close(client);
///     Tcp.closeListener(listener);
///     Right(Unit)
/// }
/// ```
export fn give(socket : Address(SockMsg), owner : Process) : Unit with m =
    send(socket, Give(owner = owner))

/// Stops the listener, which ends its process; an accept waiting on it
/// answers `Left(Io.Closed)`.
export fn closeListener(listener : Address(ListenerMsg)) : Unit with m =
    send(listener, CloseListener)

/// The connection's far end, in TCP's sense, not a peer of report §8.3, or
/// `Left(Io.Closed)` once the connection has closed.
///
/// ### Errors
///
/// On a socket that has ended, closed or killed, faults as
/// `Address.callForever` does on an ended process.
///
/// ### Examples
///
/// ```ernest
/// {
///     let listener <- Tcp.listen("127.0.0.1", 0);
///     let port <- Tcp.port(listener);
///     let client <- Tcp.connect("127.0.0.1", port, 1000);
///     let far = Tcp.peer(client);
///     Tcp.close(client);
///     Tcp.closeListener(listener);
///     Either.map(far, fn(e) = e.port == port)
/// }
/// // => Right(true)
/// ```
export fn peer(socket : Address(SockMsg)) : Either(Io.Error, Endpoint) with m =
    Address.callForever(socket, fn(r) = FarEnd(reply = r))

/// The connection's near end, or `Left(Io.Closed)` once the connection has
/// closed.
///
/// ### Errors
///
/// On a socket that has ended, closed or killed, faults as
/// `Address.callForever` does on an ended process.
///
/// ### Examples
///
/// ```ernest
/// {
///     let listener <- Tcp.listen("127.0.0.1", 0);
///     let port <- Tcp.port(listener);
///     let client <- Tcp.connect("127.0.0.1", port, 1000);
///     let near = Tcp.local(client);
///     Tcp.close(client);
///     Tcp.closeListener(listener);
///     Either.map(near, fn(e) = e.host)
/// }
/// // => Right("127.0.0.1")
/// ```
export fn local(socket : Address(SockMsg)) : Either(Io.Error, Endpoint) with m =
    Address.callForever(socket, fn(r) = NearEnd(reply = r))
