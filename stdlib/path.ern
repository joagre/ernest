/// Operations on `Path`, a file system path in the runtime's syntax
/// (report §9.3, Appendix E.14). A `Path` is `Path(String)`, so a path is
/// built from text and `toString` gives it back. There is no `fromString`:
/// the constructor is it, `Path("/etc/hosts")`. The primitives are
/// `isAbsolute` and `separator`, private, the host's separator, both the
/// runtime's; the rest is Ernest over `String` (report Appendix E.0 rule 1).
/// An absolute path's first segment is its root, the text up to its first
/// separator and that separator.
///
/// ## Examples
///
/// ```ernest
/// Path.toString(Path("/etc") <> Path("hosts"))
/// // => "/etc/hosts"
/// ```
///
/// ```ernest
/// #(Path.name(Path("/tmp/report.txt")), Path.extension(Path("/tmp/report.txt")))
/// // => #(Some("report.txt"), Some("txt"))
/// ```
///
/// ## See also
///
/// `Fs` for reading and writing what a path names, `String` for the text.
///
/// since 0.1.0

/// The second path under the first, one separator between their segments;
/// an absolute second stands alone (report §9.6).
///
/// ### Examples
///
/// ```ernest
/// #(Path.toString(Path("/etc/") <> Path("hosts")), Path.toString(Path("/etc") <> Path("/var")))
/// // => #("/etc/hosts", "/var")
/// ```
///
/// since 0.2.0
export fn Path.<>(path : Path, under : Path) : Path =
    if isAbsolute(under) then under else join(split(path) <> split(under))

/// The segments as a path, the inverse of `split`: a root first stays a
/// root, and one separator stands between the others.
///
/// ### Examples
///
/// ```ernest
/// Path.toString(Path.join(Path.split(Path("/etc//hosts"))))
/// // => "/etc/hosts"
/// ```
export fn join(segments : List(String)) : Path =
    Path(written(segments))

// Segments as a path's text: after a root the next directly, else each
// after a separator.
fn written(segments : List(String)) : String =
    match segments {
        [] -> ""
      | first :: rest -> if String.endsWith(first, separator()) then
            first <> String.join(rest, separator())
        else
            String.join(segments, separator())
    }

foreign fn separator() : String =
    "ern_path:separator/0"

/// The segments; an absolute path's first segment is the root.
///
/// ### Examples
///
/// ```ernest
/// Path.split(Path("/etc/hosts"))
/// // => ["/", "etc", "hosts"]
/// ```
export fn split(path : Path) : List(String) = {
    let text = toString(path);
    let segmentsOf =
        fn(part) =
            List.filter(String.split(part, separator()), fn(segment) = !String.isEmpty(segment));
    match String.indexOf(text, separator()) {
        Some(index) when isAbsolute(path) -> {
            let root = String.slice(text, 0, index + 1);
            root :: segmentsOf(String.slice(text, index + 1, String.size(text)))
        }
      | _ -> segmentsOf(text)
    }
}

/// The path without its last segment, or `None` for a bare name and for the
/// root.
///
/// ### Examples
///
/// ```ernest
/// #(Path.parent(Path("/etc/hosts")), Path.parent(Path("hosts")))
/// // => #(Some(Path("/etc")), None)
/// ```
///
/// ```ernest
/// #(Path.parent(Path("a/b/")), Path.parent(Path("./x")), Path.parent(Path("/")))
/// // => #(Some(Path("a")), Some(Path(".")), None)
/// ```
export fn parent(path : Path) : Optional(Path) =
    match List.dropLast(split(path), 1) {
        [] -> None
      | segments -> Some(join(segments))
    }

/// The last segment, or `None` for the root, which has none, as it has no
/// `parent`.
///
/// ### Examples
///
/// ```ernest
/// #(Path.name(Path("a/b.txt")), Path.name(Path("/")))
/// // => #(Some("b.txt"), None)
/// ```
export fn name(path : Path) : Optional(String) =
    match split(path) {
        [_] when isAbsolute(path) -> None
      | segments -> List.last(segments)
    }

/// What follows the last `.` of the name, without the dot, or `None` when
/// the name has none. The dots that begin the name begin no extension, so
/// `.bashrc`, `.` and `..` have none.
export fn extension(path : Path) : Optional(String) = {
    let named <- name(path);
    let bare = withoutLeadingDots(named);
    match String.lastIndexOf(bare, ".") {
        Some(index) -> Some(String.slice(bare, index + 1, String.size(bare)))
      | None -> None
    }
}

fn withoutLeadingDots(named : String) : String =
    if String.startsWith(named, ".") then
        withoutLeadingDots(String.slice(named, 1, String.size(named)))
    else
        named

/// The path with that extension in place of any it had, after a dot; an
/// empty one leaves the dot. The rest of the path stays as it was written.
/// The root, `.` and `..` have no name to extend, and are left as they
/// are.
///
/// ### Examples
///
/// ```ernest
/// #(Path.toString(Path.withExtension(Path("a/b.txt"), "md")),
///   Path.toString(Path.withExtension(Path("a/b"), "")))
/// // => #("a/b.md", "a/b.")
/// ```
export fn withExtension(path : Path, extension : String) : Path =
    if List.contains([None, Some("."), Some("..")], name(path)) then
        path
    else
        extended(path, "." <> extension)

/// The path without its extension, the rest as it was written. The root,
/// `.` and `..` have no name to shorten, and are left as they are.
///
/// ### Examples
///
/// ```ernest
/// #(Path.toString(Path.withoutExtension(Path("a/b.txt"))),
///   Path.toString(Path.withoutExtension(Path(".bashrc"))))
/// // => #("a/b", ".bashrc")
/// ```
///
/// since 0.2.0
export fn withoutExtension(path : Path) : Path =
    if List.contains([None, Some("."), Some("..")], name(path)) then path else extended(path, "")

// The name's extension replaced by the suffix where the name ends, before
// any separators after it.
fn extended(path : Path, suffix : String) : Path = {
    let text = toString(path);
    let trimmed = withoutTrailingSeparators(text);
    let trailing = String.slice(text, String.size(trimmed), String.size(text));
    let stem = match extension(path) {
        Some(old) -> String.slice(trimmed, 0, String.size(trimmed) - String.size(old) - 1)
      | None -> trimmed
    };
    Path(stem <> suffix <> trailing)
}

fn withoutTrailingSeparators(text : String) : String =
    if String.endsWith(text, separator()) then {
        let kept = String.size(text) - String.size(separator());
        withoutTrailingSeparators(String.slice(text, 0, kept))
    } else
        text

/// The path placed under the root, where it is relative and each of its
/// segments names an entry: `None` for an absolute path, an empty one, or
/// one with a `.` or `..` segment, so that a name from outside the program
/// stays under the root, where `<>` would let it leave. It reads the text
/// alone: a link under the root may still lead out of it, which is the
/// file system's (Appendix E.17).
///
/// ### Examples
///
/// ```ernest
/// #(Optional.map(Path.under(Path("/srv"), Path("site/index.html")), Path.toString),
///   Path.under(Path("/srv"), Path("../etc")),
///   Path.under(Path("/srv"), Path("/etc")))
/// // => #(Some("/srv/site/index.html"), None, None)
/// ```
///
/// since 0.2.0
export fn under(root : Path, path : Path) : Optional(Path) =
    match split(path) {
        [] -> None
      | segments -> if isAbsolute(path) || List.any(segments, isStep) then
            None
        else
            Some(root <> path)
    }

// A segment that names no entry but a step from where it stands.
fn isStep(segment : String) : Bool =
    segment == "." || segment == ".."

/// `true` when the path starts at a root.
///
/// ### Examples
///
/// ```ernest
/// #(Path.isAbsolute(Path("/etc")), Path.isAbsolute(Path("etc")))
/// // => #(true, false)
/// ```
export foreign fn isAbsolute(path : Path) : Bool =
    "ern_path:is_absolute/1"

/// The path as text, as it was written.
export fn toString(path : Path) : String =
    match path {
        Path(text) -> text
    }
