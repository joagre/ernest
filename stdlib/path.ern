/// Operations on `Path`, a file system path in the runtime's syntax
/// (report §9.3, Appendix E.14). A `Path` is `Path(String)`, so a path is
/// built from text and `toString` gives it back. There is no `fromString`:
/// the constructor is it, `Path("/etc/hosts")`. The primitives are
/// `isAbsolute` and `separator`, private, the host's separator, both the
/// runtime's; the rest is Ernest over `String` (report Appendix E.0 rule 1).
/// An absolute path's first segment is its root, the text up to its first
/// separator and that separator.
///
/// ## Examples
///
/// ```ernest
/// Path.toString(Path.join(Path("/etc"), Path("hosts")))
/// // => "/etc/hosts"
/// ```
///
/// ```ernest
/// #(Path.name(Path("/tmp/report.txt")), Path.extension(Path("/tmp/report.txt")))
/// // => #("report.txt", Some("txt"))
/// ```
///
/// ## See also
///
/// `Fs` for reading and writing what a path names, `String` for the text.
///
/// since 0.1.0

/// The second path under the first; an absolute second stands alone.
///
/// ### Examples
///
/// ```ernest
/// Path.toString(Path.join(Path("/etc"), Path("/var")))
/// // => "/var"
/// ```
export fn join(p : Path, under : Path) -> Path =
    if isAbsolute(under) then under else Path(written(split(p) <> split(under)))

// Segments as a path's text: after a root the next directly, else each
// after a separator.
fn written(segments : List(String)) -> String = match segments {
    [] -> ""
  | first :: rest ->
        if String.endsWith(first, separator()) then first <> String.join(rest, separator())
        else String.join(segments, separator())
}

/// The segments; an absolute path's first segment is the root.
///
/// ### Examples
///
/// ```ernest
/// Path.split(Path("/etc/hosts"))
/// // => ["/", "etc", "hosts"]
/// ```
export fn split(p : Path) -> List(String) = {
    let text = toString(p);
    let named = fn(t) = List.filter(String.split(t, separator()), fn(s) = !String.isEmpty(s));
    match String.indexOf(text, separator()) {
        Some(at) when isAbsolute(p) -> {
            let root = String.slice(text, 0, at + 1);
            root :: named(String.slice(text, at + 1, String.size(text)))
        }
      | _ -> named(text)
    }
}

foreign fn separator() -> String = "ern_path:separator/0"

/// The path without its last segment, or `None` for a bare name and for the
/// root.
///
/// ### Examples
///
/// ```ernest
/// #(Path.parent(Path("/etc/hosts")), Path.parent(Path("hosts")))
/// // => #(Some(Path("/etc")), None)
/// ```
///
/// ```ernest
/// #(Path.parent(Path("a/b/")), Path.parent(Path("./x")), Path.parent(Path("/")))
/// // => #(Some(Path("a")), Some(Path(".")), None)
/// ```
export fn parent(p : Path) -> Optional(Path) = match List.dropLast(split(p)) {
    [] -> None
  | first :: rest -> Some(List.foldLeft(rest, Path(first), fn(up, s) = join(up, Path(s))))
}

/// The last segment.
export fn name(p : Path) -> String = match split(p) {
    [_] when isAbsolute(p) -> ""
  | segments -> Optional.withDefault(List.last(segments), "")
}

/// What follows the last `.` of the name, without the dot, or `None` when
/// the name has none.
export fn extension(p : Path) -> Optional(String) = {
    let n = name(p);
    match String.lastIndexOf(n, ".") {
        Some(at) -> Some(String.slice(n, at + 1, String.size(n)))
      | None -> None
    }
}

/// The path with that extension in place of any it had; an empty string
/// removes it.
///
/// ### Examples
///
/// ```ernest
/// #(Path.toString(Path.withExtension(Path("a/b.txt"), "md")),
///   Path.toString(Path.withExtension(Path("a/b.txt"), "")))
/// // => #("a/b.md", "a/b")
/// ```
export fn withExtension(p : Path, ext : String) -> Path = {
    let text = written(split(p));
    let stem = match extension(p) {
        Some(old) -> String.slice(text, 0, String.size(text) - String.size(old) - 1)
      | None -> text
    };
    if String.isEmpty(ext) then Path(stem) else Path(stem <> "." <> ext)
}

/// `true` when the path starts at a root.
///
/// ### Examples
///
/// ```ernest
/// #(Path.isAbsolute(Path("/etc")), Path.isAbsolute(Path("etc")))
/// // => #(true, false)
/// ```
export foreign fn isAbsolute(p : Path) -> Bool = "ern_path:is_absolute/1"

/// The path as text, as it was written.
export fn toString(p : Path) -> String = match p { Path(text) -> text }
