/// Operations on `Int`, the integers of arbitrary precision (report §3.1).
/// The arithmetic and the ordering are the prelude's (report §9.6); this
/// module provides them with the rest.
///
/// ## Examples
///
/// ```ernest
/// Int.toString(Int.max(Int.abs(-7), 3))
/// // => "7"
/// ```
///
/// ```ernest
/// #(Int.div(-7, 3), Int.rem(-7, 3), Int.div(1, 0))
/// // => #(Some(-2), Some(-1), None)
/// ```
///
/// ## See also
///
/// `Float`, `String.toInt`.
///
/// since 0.1.0

/// The sum.
export fn Int.+(left : Int, right : Int) : Int =
    left + right

/// The difference.
export fn Int.-(left : Int, right : Int) : Int =
    left - right

/// The product.
export fn Int.*(left : Int, right : Int) : Int =
    left * right

/// The quotient, truncated toward zero: `-7 / 3` is `-2`.
///
/// ### Errors
///
/// Faults with `Fault("division by zero")` when `divisor` is `0`; `Int.div` does not.
export fn Int./(dividend : Int, divisor : Int) : Int =
    dividend / divisor

/// The remainder of `/`, with the sign of `dividend`: `-7 % 3` is `-1`.
///
/// ### Errors
///
/// Faults with `Fault("division by zero")` when `divisor` is `0`; `Int.rem` does not.
export fn Int.%(dividend : Int, divisor : Int) : Int =
    dividend % divisor

/// `-int`, which prefix `-` calls.
///
/// ### Examples
///
/// ```ernest
/// Int.negate(5)
/// // => -5
/// ```
export fn negate(int : Int) : Int =
    -int

/// `dividend / divisor`, truncated toward zero, or `None` when `divisor` is
/// `0`.
export fn div(dividend : Int, divisor : Int) : Optional(Int) =
    if divisor == 0 then None else Some(dividend / divisor)

/// `dividend % divisor`, the remainder with the sign of `dividend`, or
/// `None` when `divisor` is `0`.
export fn rem(dividend : Int, divisor : Int) : Optional(Int) =
    if divisor == 0 then None else Some(dividend % divisor)

/// The numeric order, which `<` and the other comparisons use.
///
/// ### Examples
///
/// ```ernest
/// Int.compare(1, 2)
/// // => Less
/// ```
export fn compare(left : Int, right : Int) : Ordering =
    if left < right then Less else if left > right then Greater else Equal

/// The magnitude.
export fn abs(int : Int) : Int =
    if int < 0 then -int else int

/// The smaller.
///
/// ### Examples
///
/// ```ernest
/// Int.min(1, 2)
/// // => 1
/// ```
export fn min(left : Int, right : Int) : Int =
    if left < right then left else right

/// The larger.
export fn max(left : Int, right : Int) : Int =
    if left > right then left else right

/// Bitwise and, on the two's complement form.
///
/// ### Examples
///
/// ```ernest
/// #(Int.bitAnd(6, 3), Int.bitOr(6, 3), Int.bitXor(6, 3), Int.bitNot(6))
/// // => #(2, 7, 5, -7)
/// ```
export foreign fn bitAnd(left : Int, right : Int) : Int =
    "erlang:band/2"

/// Bitwise or, on the two's complement form.
export foreign fn bitOr(left : Int, right : Int) : Int =
    "erlang:bor/2"

/// Bitwise exclusive or, on the two's complement form.
export foreign fn bitXor(left : Int, right : Int) : Int =
    "erlang:bxor/2"

/// Bitwise complement, `-int - 1`.
export foreign fn bitNot(int : Int) : Int =
    "erlang:bnot/1"

/// `int` shifted left by `count` bits: `int` times two to the power `count`; a
/// count below 0 is none (report §7.4).
///
/// ### Examples
///
/// ```ernest
/// #(Int.shiftLeft(3, 2), Int.shiftRight(-7, 2), Int.shiftLeft(3, -1))
/// // => #(12, -2, 3)
/// ```
export fn shiftLeft(int : Int, count : Int) : Int =
    shiftedLeft(int, max(count, 0))

foreign fn shiftedLeft(int : Int, count : Int) : Int =
    "erlang:bsl/2"

/// `int` shifted right by `count` bits, the sign kept: `int` divided by two to
/// the power `count`, rounded toward negative infinity; a count below 0 is
/// none.
export fn shiftRight(int : Int, count : Int) : Int =
    shiftedRight(int, max(count, 0))

foreign fn shiftedRight(int : Int, count : Int) : Int =
    "erlang:bsr/2"

/// The decimal form, with a leading `-` when negative.
export foreign fn toString(int : Int) : String =
    "erlang:integer_to_binary/1"

/// `base` raised to `exponent`, exactly, or `None` when the exponent is
/// negative, since that is not an `Int`.
///
/// ### Examples
///
/// ```ernest
/// #(Int.pow(2, 10), Int.pow(2, -1))
/// // => #(Some(1024), None)
/// ```
export fn pow(base : Int, exponent : Int) : Optional(Int) =
    if exponent < 0 then None else Some(power(base, exponent, 1))

fn power(base : Int, exponent : Int, acc : Int) : Int =
    if exponent == 0 then
        acc
    else if exponent % 2 == 1 then
        power(base * base, exponent / 2, acc * base)
    else
        power(base * base, exponent / 2, acc)

/// The digits of `int` in that base, 2 to 36, letters upper case, with a
/// leading `-` when negative; `None` outside those bases.
///
/// ### Examples
///
/// ```ernest
/// #(Int.toStringBase(255, 16), Int.toStringBase(5, 1))
/// // => #(Some("FF"), None)
/// ```
export fn toStringBase(int : Int, base : Int) : Optional(String) =
    if base < 2 || base > 36 then None else Some(inBase(int, base))

foreign fn inBase(int : Int, base : Int) : String =
    "erlang:integer_to_binary/2"

/// The nearest `Float`, ties to even.
///
/// ### Errors
///
/// Faults with `Fault("Int out of Float range")` beyond the largest finite
/// `Float` (report §3.1).
///
/// ### Examples
///
/// ```ernest
/// Int.toFloat(7)
/// // => 7.0
/// ```
export foreign fn toFloat(int : Int) : Float =
    "ern_int:to_float/1"
