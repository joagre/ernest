/// Lists: values in order, the same type throughout.
///
/// Use a list for values in an order, read from the front. For a value
/// looked up by its key use a `Map`, for membership a `Set`, and for text a
/// `String`. A list is a value: every function here answers a new list and
/// leaves the one it was given as it was.
///
/// `[]` is the empty list, and `x :: rest` the list with `x` in front of
/// `rest`; both are the language's, so neither is a function here.
///
/// **Cost.** A list is walked from its front. Putting an element in front
/// with `::` costs nothing, whatever the list's length. `size`, `get`,
/// `last` and `<>` walk the list, and take time in proportion to its
/// length. A list built one element at a time is built in front, and
/// `reverse`d once at the end.
///
/// **Equality.** `contains` and `unique` compare elements with `==`, so the
/// element type needs equality: a list of functions has neither.
///
/// **Replies.** A list may hold a `Reply`, which must be answered exactly once
/// (report §6.6). A function that drops or copies elements, `size`, `filter`
/// and `take` among them, refuses such a list, and its printed type marks the
/// element `!`: `List.size : (List(a!)) -> Int`. One that uses each element
/// once, `map` or `foldLeft`, takes it.
///
/// ## Examples
///
/// Each element doubled, and a list appended:
///
/// ```ernest
/// List.map([1, 2, 3], fn(n) = n * 2) <> [0]
/// // => [2, 4, 6, 0]
/// ```
///
/// The even numbers from 1 to 10, summed:
///
/// ```ernest
/// List.foldLeft(List.filter(List.range(1, 10), fn(n) = n % 2 == 0), 0, Int.+)
/// // => 30
/// ```
///
/// Words sorted by the order of `String`:
///
/// ```ernest
/// List.sort(["pear", "fig", "apple"], String.compare)
/// // => ["apple", "fig", "pear"]
/// ```
///
/// ## See also
///
/// `Map` and `Set` for lookup by key, `String.toList` for the characters of
/// a string.
///
/// since 0.1.0

/// The elements of the first list, then those of the second. The first list
/// is copied, so the cost grows with its length, and not with the second's.
///
/// ### Examples
///
/// ```ernest
/// [1, 2] <> [3]
/// // => [1, 2, 3]
/// ```
export fn List.<>(list : List(a), other : List(a)) : List(a) =
    match list {
        [] -> other
      | head :: rest -> head :: (rest <> other)
    }

/// The number of elements. The whole list is walked to count them.
///
/// ### Examples
///
/// ```ernest
/// #(List.size([1, 2, 3]), List.isEmpty([]))
/// // => #(3, true)
/// ```
export foreign fn size(list : List(a)) : Int =
    "erlang:length/1"

/// `true` for the empty list.
export fn isEmpty(list : List(a)) : Bool =
    match list {
        [] -> true
      | _ -> false
    }

/// `true` when some element of the list is `==` to `element`.
///
/// ### Examples
///
/// ```ernest
/// #(List.contains([1, 2], 2), List.contains([1, 2], 3))
/// // => #(true, false)
/// ```
export fn contains(list : List(a), element : a) : Bool =
    match list {
        [] -> false
      | head :: rest -> if head == element then true else contains(rest, element)
    }

/// The element at `index`, counting from 0, or `None` where the list has
/// no element there: past its end, or at an index below 0. The list is
/// walked to the index.
///
/// ### Examples
///
/// ```ernest
/// #(List.get(["a", "b"], 1), List.get(["a", "b"], 2))
/// // => #(Some("b"), None)
/// ```
export fn get(list : List(a), index : Int) : Optional(a) =
    if index < 0 then
        None
    else match list {
        [] -> None
      | head :: rest -> if index == 0 then Some(head) else get(rest, index - 1)
    }

/// The list without the element at `index`, counting from 0, as `get`
/// counts. A list with no element there, past its end or at an index below
/// 0, is answered as it was. The list is walked to the index. To remove an
/// element by its value, `filter` keeps the others.
///
/// ### Examples
///
/// ```ernest
/// #(List.remove(["a", "b", "c"], 1), List.remove(["a", "b"], 2))
/// // => #(["a", "c"], ["a", "b"])
/// ```
export fn remove(list : List(a), index : Int) : List(a) =
    if index < 0 then
        list
    else match list {
        [] -> []
      | head :: rest -> if index == 0 then rest else head :: remove(rest, index - 1)
    }

/// The list of `f(x)` for each element `x`, in order. `f` is called for the
/// elements from the first.
export fn map(list : List(a), f : (a) -> b with e) : List(b) with e =
    match list {
        [] -> []
      | head :: rest -> f(head) :: map(rest, f)
    }

/// The elements `keep` answers `true` for, in their order.
///
/// ### Examples
///
/// ```ernest
/// List.filter([1, 2, 3, 4], fn(n) = n > 2)
/// // => [3, 4]
/// ```
export fn filter(list : List(a), keep : (a) -> Bool with e) : List(a) with e =
    match list {
        [] -> []
      | head :: rest -> if keep(head) then head :: filter(rest, keep) else filter(rest, keep)
    }

/// The values `f` answers `Some` for, in order. An element `f` answers
/// `None` for is left out, so it maps and filters in one pass.
///
/// ### Examples
///
/// ```ernest
/// List.filterMap(["1", "x", "3"], String.toInt)
/// // => [1, 3]
/// ```
export fn filterMap(list : List(a), f : (a) -> Optional(b) with e) : List(b) with e =
    match list {
        [] -> []
      | head :: rest -> match f(head) {
            Some(value) -> value :: filterMap(rest, f)
          | None -> filterMap(rest, f)
        }
    }

/// What `step` answers for the last element. `step` is called on each element
/// in order: first with `acc` and the first element, then with what it answered
/// before and the next element. The empty list answers `acc`.
///
/// ### Examples
///
/// ```ernest
/// List.foldLeft([1, 2, 3], 0, fn(sum, n) = sum + n)
/// // => 6
/// ```
export fn foldLeft(list : List(a), acc : b, step : (b, a) -> b with e) : b with e =
    match list {
        [] -> acc
      | head :: rest -> foldLeft(rest, step(acc, head), step)
    }

/// The elements folded into one value, from the last. `step(acc, x)` is
/// called with the given `acc` for the last element, and with what `step`
/// answered for the one after it for the rest. The accumulator comes first,
/// as in `foldLeft`. The empty list answers `acc`.
///
/// ### Examples
///
/// ```ernest
/// List.foldRight(["a", "b"], "", fn(acc, text) = text <> acc)
/// // => "ab"
/// ```
export fn foldRight(list : List(a), acc : b, step : (b, a) -> b with e) : b with e =
    match list {
        [] -> acc
      | head :: rest -> step(foldRight(rest, acc, step), head)
    }

/// Calls `f` for each element, in order, for its effect, and answers `Unit`.
///
/// ### Examples
///
/// Prints `1` and `2`, each on a line:
///
/// ```ernest
/// List.foreach([1, 2], fn(n) = Io.println(Int.toString(n)))
/// // => Unit
/// ```
export fn foreach(list : List(a), f : (a) -> Unit with e) : Unit with e =
    match list {
        [] -> Unit
      | head :: rest -> {
            let _ = f(head);
            foreach(rest, f)
        }
    }

/// `true` when `test` holds for at least one element, and `false` for the
/// empty list. `test` is not called after the first element it holds for.
///
/// ### Examples
///
/// ```ernest
/// #(List.any([1, 2], fn(n) = n > 1), List.all([1, 2], fn(n) = n > 1))
/// // => #(true, false)
/// ```
export fn any(list : List(a), test : (a) -> Bool with e) : Bool with e =
    match list {
        [] -> false
      | head :: rest -> if test(head) then true else any(rest, test)
    }

/// `true` when `test` holds for every element, and for the empty list.
/// `test` is not called after the first element it fails for.
export fn all(list : List(a), test : (a) -> Bool with e) : Bool with e =
    match list {
        [] -> true
      | head :: rest -> if test(head) then all(rest, test) else false
    }

/// The first element `test` holds for, or `None` where there is none.
///
/// ### Examples
///
/// ```ernest
/// List.find([1, 2, 3], fn(n) = n > 1)
/// // => Some(2)
/// ```
export fn find(list : List(a), test : (a) -> Bool with e) : Optional(a) with e =
    match list {
        [] -> None
      | head :: rest -> if test(head) then Some(head) else find(rest, test)
    }

/// The last element, or `None` for the empty list. The whole list is walked
/// to reach it.
///
/// ### Examples
///
/// The empty list needs its element type written, since nothing else settles
/// it:
///
/// ```ernest
/// {
///     let empty : List(Int) = [];
///     #(List.last([1, 2]), List.last(empty))
/// }
/// // => #(Some(2), None)
/// ```
export fn last(list : List(a)) : Optional(a) =
    match list {
        [] -> None
      | [element] -> Some(element)
      | _ :: rest -> last(rest)
    }

/// The first `count` elements, or all of them where there are fewer. A
/// `count` below 0 takes none.
///
/// ### Examples
///
/// ```ernest
/// #(List.take([1, 2, 3], 2), List.drop([1, 2, 3], 2))
/// // => #([1, 2], [3])
/// ```
export fn take(list : List(a), count : Int) : List(a) =
    if count <= 0 then
        []
    else match list {
        [] -> []
      | head :: rest -> head :: take(rest, count - 1)
    }

/// The list without its first `count` elements, or empty where there are
/// fewer. A `count` below 0 drops none.
export fn drop(list : List(a), count : Int) : List(a) =
    if count <= 0 then
        list
    else match list {
        [] -> []
      | _ :: rest -> drop(rest, count - 1)
    }

/// The last `count` elements, or all of them where there are fewer. A
/// `count` below 0 takes none. The whole list is walked to find them.
///
/// ### Examples
///
/// ```ernest
/// #(List.takeLast([1, 2, 3], 2), List.takeLast([1, 2, 3], 5))
/// // => #([2, 3], [1, 2, 3])
/// ```
///
/// since 0.4.0
export fn takeLast(list : List(a), count : Int) : List(a) =
    if count <= 0 then [] else drop(list, size(list) - count)

/// The list without its last `count` elements, or empty where there are
/// fewer. A `count` below 0 drops none.
///
/// ### Examples
///
/// ```ernest
/// #(List.dropLast([1, 2, 3], 1), List.dropLast([1, 2, 3], 5))
/// // => #([1, 2], [])
/// ```
export fn dropLast(list : List(a), count : Int) : List(a) =
    if count <= 0 then list else take(list, size(list) - count)

/// The list split where `test` first fails: the elements before that one,
/// all of which `test` holds for, and the rest, from that one on.
///
/// ### Examples
///
/// ```ernest
/// List.span([1, 2, 3, 1], fn(n) = n < 3)
/// // => #([1, 2], [3, 1])
/// ```
export fn span(list : List(a), test : (a) -> Bool with e) : #(List(a), List(a)) with e =
    match list {
        [] -> #([], [])
      | head :: rest -> if test(head) then {
            let #(prefix, suffix) = span(rest, test);
            #(head :: prefix, suffix)
        } else
            #([], list)
    }

/// The elements `test` holds for, and those it does not, each in their
/// order.
///
/// ### Examples
///
/// ```ernest
/// List.partition([1, 2, 3, 4], fn(n) = n % 2 == 0)
/// // => #([2, 4], [1, 3])
/// ```
export fn partition(list : List(a), test : (a) -> Bool with e) : #(List(a), List(a)) with e =
    match list {
        [] -> #([], [])
      | head :: rest -> {
            // the predicate meets the elements in order, as filter's does
            let holds = test(head);
            let #(yes, no) = partition(rest, test);
            if holds then #(head :: yes, no) else #(yes, head :: no)
        }
    }

/// The list without repeats: the first occurrence of each element is kept,
/// in order.
///
/// ### Examples
///
/// ```ernest
/// List.unique([2, 1, 2, 3])
/// // => [2, 1, 3]
/// ```
export foreign fn unique(list : List(a=)) : List(a) =
    "lists:uniq/1"

/// Each element paired with its index, counting from 0.
///
/// ### Examples
///
/// ```ernest
/// List.indexed(["a", "b"])
/// // => [#(0, "a"), #(1, "b")]
/// ```
export fn indexed(list : List(a)) : List(#(Int, a)) =
    indexedFrom(list, 0)

fn indexedFrom(list : List(a), index : Int) : List(#(Int, a)) =
    match list {
        [] -> []
      | head :: rest -> #(index, head) :: indexedFrom(rest, index + 1)
    }

/// A list of `count` copies of `element`. A `count` below 0 gives the empty
/// list.
///
/// ### Examples
///
/// ```ernest
/// List.repeat("ha", 2)
/// // => ["ha", "ha"]
/// ```
export fn repeat(element : a, count : Int) : List(a) =
    if count <= 0 then [] else element :: repeat(element, count - 1)

/// The elements in the opposite order.
///
/// ### Examples
///
/// ```ernest
/// List.reverse([1, 2, 3])
/// // => [3, 2, 1]
/// ```
export fn reverse(list : List(a)) : List(a) =
    foldLeft(list, [], fn(acc, element) = element :: acc)

/// The elements sorted by `compare`, smallest first. `compare` is an order
/// (report §3.10), `Int.compare` or one of the program's.
///
/// The sort is stable: two elements `compare` calls `Equal` keep the order they
/// had. So to sort by age, and by name among equal ages, sort by name first and
/// then by age.
///
/// ### Examples
///
/// ```ernest
/// List.sort([3, 1, 2], Int.compare)
/// // => [1, 2, 3]
/// ```
export fn sort(list : List(a), compare : (a, a) -> Ordering with e) : List(a) with e = {
    let ordered = sorted(fn(left, right) = isInOrder(left, right, compare), indexed(list));
    let #(_, elements) = unzip(ordered);
    elements
}

// Report Appendix E.2: the host's sort promises no stability, and wants
// an order that calls two elements equal only where they are one. Each
// element carries its index, and two that `compare` calls `Equal` are in
// the order of their indexes, which keeps the sort stable. The host's
// sort reads a sorted list as one run (E.0 rule 1).
fn isInOrder(left : #(Int, a),
             right : #(Int, a),
             compare : (a, a) -> Ordering with e) : Bool with e = {
    let #(leftIndex, leftElement) = left;
    let #(rightIndex, rightElement) = right;
    match compare(leftElement, rightElement) {
        Less -> true
      | Greater -> false
      | Equal -> leftIndex <= rightIndex
    }
}

foreign fn sorted(isLessOrEqual : (a, a) -> Bool with e, list : List(a)) : List(a) with e =
    "lists:sort/2"

/// The pairs of the elements at each index of both lists. The longer list's
/// extra elements are left out.
///
/// ### Examples
///
/// ```ernest
/// List.zip([1, 2, 3], ["a", "b"])
/// // => [#(1, "a"), #(2, "b")]
/// ```
export fn zip(list : List(a), other : List(b)) : List(#(a, b)) =
    match #(list, other) {
        #(head :: rest, otherHead :: otherRest) -> #(head, otherHead) :: zip(rest, otherRest)
      | _ -> []
    }

/// The pairs taken apart: the list of their first components and the list
/// of their second, each in order.
///
/// ### Examples
///
/// ```ernest
/// List.unzip([#(1, "a"), #(2, "b")])
/// // => #([1, 2], ["a", "b"])
/// ```
export fn unzip(pairs : List(#(a, b))) : #(List(a), List(b)) =
    match pairs {
        [] -> #([], [])
      | #(first, second) :: rest -> {
            let #(firsts, seconds) = unzip(rest);
            #(first :: firsts, second :: seconds)
        }
    }

/// The lists `f` answers for the elements, joined in order.
///
/// ### Examples
///
/// ```ernest
/// List.flatMap([1, 2], fn(n) = [n, n * 10])
/// // => [1, 10, 2, 20]
/// ```
export fn flatMap(list : List(a), f : (a) -> List(b) with e) : List(b) with e =
    match list {
        [] -> []
      | head :: rest -> f(head) <> flatMap(rest, f)
    }

/// The integers from `first` to `last`, both included, counting up. Where
/// `first` is greater than `last` the list is empty.
///
/// ### Examples
///
/// ```ernest
/// #(List.range(1, 4), List.range(2, 1))
/// // => #([1, 2, 3, 4], [])
/// ```
export fn range(first : Int, last : Int) : List(Int) =
    if first > last then [] else first :: range(first + 1, last)

/// Calls `step` on each element in order. Where every call answers `Right(y)`,
/// the answer is `Right` of the list of the `y`s. At the first `Left(e)` the
/// answer is `Left(e)`, and `step` is not called again. The empty list answers
/// `Right([])`.
///
/// ### Examples
///
/// ```ernest
/// List.tryMap(["1", "x"], fn(s) = Either.fromOptional(String.toInt(s), s))
/// // => Left("x")
/// ```
export fn tryMap(list : List(a), step : (a) -> Either(e, b) with x) : Either(e, List(b)) with x =
    match list {
        [] -> Right([])
      | head :: rest -> {
            let value <- step(head);
            let values <- tryMap(rest, step);
            Right(value :: values)
        }
    }

/// Folds the list as `foldLeft` does, `step` answering `Right` of the next
/// accumulator. Where every call answers a `Right`, the answer is `Right` of
/// the last accumulator. At the first `Left(e)` the answer is `Left(e)`, and
/// `step` is not called again. The empty list answers `Right(acc)`.
///
/// ### Examples
///
/// ```ernest
/// List.tryFold([1, 2], 0, fn(acc, n) = if n > 1 then Left("big") else Right(acc + n))
/// // => Left("big")
/// ```
export fn tryFold(list : List(a),
                  acc : b,
                  step : (b, a) -> Either(e, b) with x) : Either(e, b) with x =
    match list {
        [] -> Right(acc)
      | head :: rest -> {
            let next <- step(acc, head);
            tryFold(rest, next, step)
        }
    }
