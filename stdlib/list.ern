/// Operations on `List(a)`, the singly linked list of the language (report
/// §3.3). `[]` is the empty list and `::` puts an element in front, so
/// neither is a function here, and `toList` and `fromList` would be the
/// identity, so the module has neither. `contains`, `remove`, and
/// `unique` compare elements, so their element type needs equality
/// (report §3.10).
///
/// ## Examples
///
/// ```ernest
/// List.map([1, 2, 3], fn(n) = n * 2) <> [0]
/// // => [2, 4, 6, 0]
/// ```
///
/// ```ernest
/// List.foldLeft(List.filter(List.range(1, 10), fn(n) = n % 2 == 0), 0, Int.+)
/// // => 30
/// ```
///
/// ```ernest
/// List.sort(["pear", "fig", "apple"], String.compare)
/// // => ["apple", "fig", "pear"]
/// ```
///
/// ## See also
///
/// `Map` and `Set` for lookup by key, `String.toList` for the characters of
/// a string.
///
/// since 0.1.0

/// The elements of the first list, then those of the second.
///
/// ### Examples
///
/// ```ernest
/// [1, 2] <> [3]
/// // => [1, 2, 3]
/// ```
export fn List.<>(list : List(a), other : List(a)) : List(a) =
    match list {
        [] -> other
      | head :: rest -> head :: (rest <> other)
    }

/// The number of elements.
///
/// ### Examples
///
/// ```ernest
/// #(List.size([1, 2, 3]), List.isEmpty([]))
/// // => #(3, true)
/// ```
export fn size(list : List(a)) : Int =
    sizeFrom(list, 0)

fn sizeFrom(list : List(a), count : Int) : Int =
    match list {
        [] -> count
      | _ :: rest -> sizeFrom(rest, count + 1)
    }

/// `true` for the empty list.
export fn isEmpty(list : List(a)) : Bool =
    match list {
        [] -> true
      | _ -> false
    }

/// `true` when some element of the list equals `element`.
///
/// ### Examples
///
/// ```ernest
/// #(List.contains([1, 2], 2), List.contains([1, 2], 3))
/// // => #(true, false)
/// ```
export fn contains(list : List(a), element : a) : Bool =
    match list {
        [] -> false
      | head :: rest -> if head == element then true else contains(rest, element)
    }

/// The element at `index`, counting from 0, or `None` beyond either end.
///
/// ### Examples
///
/// ```ernest
/// #(List.get(["a", "b"], 1), List.get(["a", "b"], 2))
/// // => #(Some("b"), None)
/// ```
export fn get(list : List(a), index : Int) : Optional(a) =
    if index < 0 then
        None
    else match list {
        [] -> None
      | head :: rest -> if index == 0 then Some(head) else get(rest, index - 1)
    }

/// The list without the first of its elements that equals `element`, or
/// the list itself when none does.
///
/// ### Examples
///
/// ```ernest
/// List.remove([1, 2, 1], 1)
/// // => [2, 1]
/// ```
export fn remove(list : List(a), element : a) : List(a) =
    match list {
        [] -> []
      | head :: rest -> if head == element then rest else head :: remove(rest, element)
    }

/// The function applied to each element, in order.
export fn map(list : List(a), f : (a) -> b with e) : List(b) with e =
    match list {
        [] -> []
      | head :: rest -> f(head) :: map(rest, f)
    }

/// The elements the predicate holds for, in order.
///
/// ### Examples
///
/// ```ernest
/// List.filter([1, 2, 3, 4], fn(n) = n > 2)
/// // => [3, 4]
/// ```
export fn filter(list : List(a), keep : (a) -> Bool with e) : List(a) with e =
    match list {
        [] -> []
      | head :: rest -> if keep(head) then head :: filter(rest, keep) else filter(rest, keep)
    }

/// The values of the `Some` results, in order: mapping and filtering in one
/// pass.
///
/// ### Examples
///
/// ```ernest
/// List.filterMap(["1", "x", "3"], String.toInt)
/// // => [1, 3]
/// ```
export fn filterMap(list : List(a), f : (a) -> Optional(b) with e) : List(b) with e =
    match list {
        [] -> []
      | head :: rest -> match f(head) {
            Some(value) -> value :: filterMap(rest, f)
          | None -> filterMap(rest, f)
        }
    }

/// The accumulator after the function has seen each element from the left,
/// the accumulator first.
export fn foldLeft(list : List(a), acc : b, step : (b, a) -> b with e) : b with e =
    match list {
        [] -> acc
      | head :: rest -> foldLeft(rest, step(acc, head), step)
    }

/// The accumulator after the function has seen each element from the
/// right, the element first.
///
/// ### Examples
///
/// ```ernest
/// List.foldRight(["a", "b"], "", fn(s, acc) = s <> acc)
/// // => "ab"
/// ```
export fn foldRight(list : List(a), acc : b, step : (a, b) -> b with e) : b with e =
    match list {
        [] -> acc
      | head :: rest -> step(head, foldRight(rest, acc, step))
    }

/// The function applied to each element for its effect.
///
/// ### Examples
///
/// ```ernest
/// List.foreach([1, 2], fn(n) = Io.println(Int.toString(n)))
/// // => Unit
/// ```
export fn foreach(list : List(a), f : (a) -> Unit with e) : Unit with e =
    match list {
        [] -> Unit
      | head :: rest -> {
            let _ = f(head);
            foreach(rest, f)
        }
    }

/// `true` when the predicate holds for some element; it is not called after
/// the first that satisfies it.
///
/// ### Examples
///
/// ```ernest
/// #(List.any([1, 2], fn(n) = n > 1), List.all([1, 2], fn(n) = n > 1))
/// // => #(true, false)
/// ```
export fn any(list : List(a), test : (a) -> Bool with e) : Bool with e =
    match list {
        [] -> false
      | head :: rest -> if test(head) then true else any(rest, test)
    }

/// `true` when the predicate holds for every element, and for the empty
/// list; it is not called after the first that fails.
export fn all(list : List(a), test : (a) -> Bool with e) : Bool with e =
    match list {
        [] -> true
      | head :: rest -> if test(head) then all(rest, test) else false
    }

/// The first element the predicate holds for.
///
/// ### Examples
///
/// ```ernest
/// List.find([1, 2, 3], fn(n) = n > 1)
/// // => Some(2)
/// ```
export fn find(list : List(a), test : (a) -> Bool with e) : Optional(a) with e =
    match list {
        [] -> None
      | head :: rest -> if test(head) then Some(head) else find(rest, test)
    }

/// The last element.
///
/// ### Examples
///
/// ```ernest
/// let empty : List(Int) = [];
/// #(List.last([1, 2]), List.last(empty))
/// // => #(Some(2), None)
/// ```
export fn last(list : List(a)) : Optional(a) =
    match list {
        [] -> None
      | [element] -> Some(element)
      | _ :: rest -> last(rest)
    }

/// The first `count` elements, or all of them when there are fewer;
/// `count` below 0 takes none.
///
/// ### Examples
///
/// ```ernest
/// #(List.take([1, 2, 3], 2), List.drop([1, 2, 3], 2))
/// // => #([1, 2], [3])
/// ```
export fn take(list : List(a), count : Int) : List(a) =
    if count <= 0 then
        []
    else match list {
        [] -> []
      | head :: rest -> head :: take(rest, count - 1)
    }

/// All but the first `count` elements; `count` below 0 drops none.
export fn drop(list : List(a), count : Int) : List(a) =
    if count <= 0 then
        list
    else match list {
        [] -> []
      | _ :: rest -> drop(rest, count - 1)
    }

/// All but the last `count` elements; `count` below 0 drops none.
///
/// ### Examples
///
/// ```ernest
/// #(List.dropLast([1, 2, 3], 1), List.dropLast([1, 2, 3], 5))
/// // => #([1, 2], [])
/// ```
export fn dropLast(list : List(a), count : Int) : List(a) =
    if count <= 0 then list else take(list, size(list) - count)

/// The longest prefix the predicate holds for, and the rest.
///
/// ### Examples
///
/// ```ernest
/// List.span([1, 2, 3, 1], fn(n) = n < 3)
/// // => #([1, 2], [3, 1])
/// ```
export fn span(list : List(a), test : (a) -> Bool with e) : #(List(a), List(a)) with e =
    match list {
        [] -> #([], [])
      | head :: rest -> if test(head) then {
            let #(prefix, tail) = span(rest, test);
            #(head :: prefix, tail)
        } else
            #([], list)
    }

/// The elements the predicate holds for and those it does not, each in
/// order.
///
/// ### Examples
///
/// ```ernest
/// List.partition([1, 2, 3, 4], fn(n) = n % 2 == 0)
/// // => #([2, 4], [1, 3])
/// ```
export fn partition(list : List(a), test : (a) -> Bool with e) : #(List(a), List(a)) with e =
    match list {
        [] -> #([], [])
      | head :: rest -> {
            // the predicate meets the elements in order, as filter's does
            let holds = test(head);
            let #(yes, no) = partition(rest, test);
            if holds then #(head :: yes, no) else #(yes, head :: no)
        }
    }

/// The first occurrence of each element, in order.
///
/// ### Examples
///
/// ```ernest
/// List.unique([2, 1, 2, 3])
/// // => [2, 1, 3]
/// ```
export fn unique(list : List(a)) : List(a) =
    match list {
        [] -> []
      | head :: rest -> head :: unique(filter(rest, fn(other) = other != head))
    }

/// Each element with its index, counting from 0.
///
/// ### Examples
///
/// ```ernest
/// List.indexed(["a", "b"])
/// // => [#(0, "a"), #(1, "b")]
/// ```
export fn indexed(list : List(a)) : List(#(Int, a)) =
    indexedFrom(list, 0)

fn indexedFrom(list : List(a), index : Int) : List(#(Int, a)) =
    match list {
        [] -> []
      | head :: rest -> #(index, head) :: indexedFrom(rest, index + 1)
    }

/// `count` copies of the value; `count` below 0 gives none.
///
/// ### Examples
///
/// ```ernest
/// List.repeat("ha", 2)
/// // => ["ha", "ha"]
/// ```
export fn repeat(element : a, count : Int) : List(a) =
    if count <= 0 then [] else element :: repeat(element, count - 1)

/// The elements in the opposite order.
///
/// ### Examples
///
/// ```ernest
/// List.reverse([1, 2, 3])
/// // => [3, 2, 1]
/// ```
export fn reverse(list : List(a)) : List(a) =
    foldLeft(list, [], fn(acc, element) = element :: acc)

/// The elements in the order `compare` gives, stable: two elements it calls
/// `Equal` keep the order they had.
///
/// ### Examples
///
/// ```ernest
/// List.sort([3, 1, 2], Int.compare)
/// // => [1, 2, 3]
/// ```
export fn sort(list : List(a), compare : (a, a) -> Ordering with e) : List(a) with e =
    match list {
        [] -> list
      | [_] -> list
      | _ -> {
            let #(left, right) = halves(list);
            merge(sort(left, compare), sort(right, compare), compare)
        }
    }

// A merge sort: the halves are sorted and then merged, and a merge that
// takes the left element when the two compare `Equal` is what makes the
// sort stable.
fn halves(list : List(a)) : #(List(a), List(a)) = {
    let half = size(list) / 2;
    #(take(list, half), drop(list, half))
}

fn merge(left : List(a), right : List(a), compare : (a, a) -> Ordering with e) : List(a) with e =
    match #(left, right) {
        #([], _) -> right
      | #(_, []) -> left
      | #(leftHead :: leftRest, rightHead :: rightRest) -> match compare(leftHead, rightHead) {
            Greater -> rightHead :: merge(left, rightRest, compare)
          | _ -> leftHead :: merge(leftRest, right, compare)
        }
    }

/// The pairs of elements at the same index, to the length of the shorter
/// list.
///
/// ### Examples
///
/// ```ernest
/// List.zip([1, 2, 3], ["a", "b"])
/// // => [#(1, "a"), #(2, "b")]
/// ```
export fn zip(list : List(a), other : List(b)) : List(#(a, b)) =
    match #(list, other) {
        #(head :: rest, otherHead :: otherRest) -> #(head, otherHead) :: zip(rest, otherRest)
      | _ -> []
    }

/// The first components and the second components, each in order.
///
/// ### Examples
///
/// ```ernest
/// List.unzip([#(1, "a"), #(2, "b")])
/// // => #([1, 2], ["a", "b"])
/// ```
export fn unzip(pairs : List(#(a, b))) : #(List(a), List(b)) =
    match pairs {
        [] -> #([], [])
      | #(first, second) :: rest -> {
            let #(firsts, seconds) = unzip(rest);
            #(first :: firsts, second :: seconds)
        }
    }

/// The lists the function gives, one after another.
///
/// ### Examples
///
/// ```ernest
/// List.flatMap([1, 2], fn(n) = [n, n * 10])
/// // => [1, 10, 2, 20]
/// ```
export fn flatMap(list : List(a), f : (a) -> List(b) with e) : List(b) with e =
    match list {
        [] -> []
      | head :: rest -> f(head) <> flatMap(rest, f)
    }

/// The integers from the first to the second, both included; empty when the
/// first is greater.
///
/// ### Examples
///
/// ```ernest
/// #(List.range(1, 4), List.range(2, 1))
/// // => #([1, 2, 3, 4], [])
/// ```
export fn range(first : Int, last : Int) : List(Int) =
    if first > last then [] else first :: range(first + 1, last)

/// The mapped elements, or the first `Left` the function gives, which ends
/// the walk.
///
/// ### Examples
///
/// ```ernest
/// List.tryMap(["1", "x"], fn(s) = Either.fromOptional(String.toInt(s), s))
/// // => Left("x")
/// ```
export fn tryMap(list : List(a), step : (a) -> Either(e, b) with x) : Either(e, List(b)) with x =
    match list {
        [] -> Right([])
      | head :: rest -> {
            let value <- step(head);
            let values <- tryMap(rest, step);
            Right(value :: values)
        }
    }

/// The accumulator after the function has seen each element, or the first
/// `Left` it gives, which ends the walk.
///
/// ### Examples
///
/// ```ernest
/// List.tryFold([1, 2], 0, fn(acc, n) = if n > 1 then Left("big") else Right(acc + n))
/// // => Left("big")
/// ```
export fn tryFold(list : List(a),
                  acc : b,
                  step : (b, a) -> Either(e, b) with x) : Either(e, b) with x =
    match list {
        [] -> Right(acc)
      | head :: rest -> {
            let next <- step(acc, head);
            tryFold(rest, next, step)
        }
    }
