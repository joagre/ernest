/// Operations on `Float`, IEEE 754 double precision restricted to the
/// finite range (report §3.1). The arithmetic and the ordering are the
/// prelude's (report §9.6); this module provides them with the rest. No
/// operation here returns an infinity or a NaN: one that would, faults.
///
/// ## Examples
///
/// ```ernest
/// Float.toString(Float.abs(-2.5) * 2.0)
/// // => "5.0"
/// ```
///
/// ```ernest
/// #(Float.round(2.5), Float.round(3.5), Float.floor(-2.5), Float.ceil(-2.5))
/// // => #(2, 4, -3, -2)
/// ```
///
/// ## See also
///
/// `Int.toFloat`, `String.toFloat`.
///
/// since 0.1.0

/// The sum, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1). `-`, `*`, and `/` fault the same way.
export foreign fn Float.+(a : Float, b : Float) -> Float = "ern_float:add/2"

/// The difference, rounded to the nearest `Float`.
export foreign fn Float.-(a : Float, b : Float) -> Float = "ern_float:subtract/2"

/// The product, rounded to the nearest `Float`.
export foreign fn Float.*(a : Float, b : Float) -> Float = "ern_float:multiply/2"

/// The quotient, rounded to the nearest `Float`; division by zero faults.
export foreign fn Float./(a : Float, b : Float) -> Float = "ern_float:divide/2"

/// `-x`, which prefix `-` calls; `0.0` becomes `-0.0`.
///
/// ### Examples
///
/// ```ernest
/// Float.negate(1.5)
/// // => -1.5
/// ```
export foreign fn negate(x : Float) -> Float = "ern_float:negate/1"

/// The numeric order, which `<` and the other comparisons use; `-0.0` and
/// `0.0` are `Equal`.
///
/// ### Examples
///
/// ```ernest
/// Float.compare(2.0, 1.0)
/// // => Greater
/// ```
export fn compare(a : Float, b : Float) -> Ordering =
    if a < b then Less else if a > b then Greater else Equal

/// The magnitude, `0.0` for `-0.0`.
export foreign fn abs(x : Float) -> Float = "erlang:abs/1"

/// The smaller.
///
/// ### Examples
///
/// ```ernest
/// #(Float.min(1.0, 2.0), Float.max(1.0, 2.0))
/// // => #(1.0, 2.0)
/// ```
export fn min(a : Float, b : Float) -> Float = if a < b then a else b

/// The larger.
export fn max(a : Float, b : Float) -> Float = if a > b then a else b

/// The shortest decimal that reads back as the same value, always with a
/// fraction: `100.0`, not `100`.
export foreign fn toString(x : Float) -> String = "ern_float:to_string/1"

/// The nearest `Int`, ties to even.
export fn round(x : Float) -> Int = {
    let f = floor(x);
    let d = x - Int.toFloat(f);
    if d < 0.5 then f else if d > 0.5 then f + 1 else if f % 2 == 0 then f else f + 1
}

/// The greatest `Int` not above `x`.
export foreign fn floor(x : Float) -> Int = "erlang:floor/1"

/// The least `Int` not below `x`.
export foreign fn ceil(x : Float) -> Int = "erlang:ceil/1"
