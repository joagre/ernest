/// Operations on `Float`, IEEE 754 double precision restricted to the
/// finite range (report §3.1). The arithmetic and the ordering are the
/// prelude's (report §9.6); this module provides them with the rest. No
/// operation here returns an infinity or a NaN: one that would, faults,
/// and one with no answer gives `None`. The module holds the operations of
/// the type itself; mathematics over collections of floats is a library.
///
/// ## Examples
///
/// ```ernest
/// Float.toString(Float.abs(-2.5) * 2.0)
/// // => "5.0"
/// ```
///
/// ```ernest
/// #(Float.round(2.5), Float.round(3.5), Float.floor(-2.5), Float.ceil(-2.5))
/// // => #(2, 4, -3, -2)
/// ```
///
/// ## See also
///
/// `Int.toFloat`, `String.toFloat`.
///
/// since 0.1.0

/// The sum, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1).
export fn Float.+(a : Float, b : Float) -> Float = a + b

/// The difference, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1).
export fn Float.-(a : Float, b : Float) -> Float = a - b

/// The product, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1).
export fn Float.*(a : Float, b : Float) -> Float = a * b

/// The quotient, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1), which a divisor of `0.0` makes it.
export fn Float./(a : Float, b : Float) -> Float = a / b

/// `-x`, which prefix `-` calls.
///
/// ### Examples
///
/// ```ernest
/// Float.negate(1.5)
/// // => -1.5
/// ```
export fn negate(x : Float) -> Float = -x

/// The numeric order, which `<` and the other comparisons use.
///
/// ### Examples
///
/// ```ernest
/// Float.compare(2.0, 1.0)
/// // => Greater
/// ```
export fn compare(a : Float, b : Float) -> Ordering =
    if a < b then Less else if a > b then Greater else Equal

/// The magnitude.
export fn abs(x : Float) -> Float = if x < 0.0 then -x else x

/// The smaller.
///
/// ### Examples
///
/// ```ernest
/// #(Float.min(1.0, 2.0), Float.max(1.0, 2.0))
/// // => #(1.0, 2.0)
/// ```
export fn min(a : Float, b : Float) -> Float = if a < b then a else b

/// The larger.
export fn max(a : Float, b : Float) -> Float = if a > b then a else b

/// The shortest decimal that reads back as the same value, always with a
/// fraction: `100.0`, not `100`.
export foreign fn toString(x : Float) -> String = "ern_float:to_string/1"

/// The nearest `Int`, ties to even.
export fn round(x : Float) -> Int = {
    let f = floor(x);
    let d = x - Int.toFloat(f);
    if d < 0.5 then f else if d > 0.5 then f + 1 else if f % 2 == 0 then f else f + 1
}

/// Toward zero, so `-2.7` gives `-2`.
///
/// ### Examples
///
/// ```ernest
/// #(Float.truncate(-2.7), Float.floor(-2.7))
/// // => #(-2, -3)
/// ```
export foreign fn truncate(x : Float) -> Int = "erlang:trunc/1"

/// The greatest `Int` not above `x`.
export foreign fn floor(x : Float) -> Int = "erlang:floor/1"

/// The least `Int` not below `x`.
export foreign fn ceil(x : Float) -> Int = "erlang:ceil/1"

/// The square root, or `None` below zero.
///
/// ### Examples
///
/// ```ernest
/// #(Float.sqrt(9.0), Float.sqrt(-1.0))
/// // => #(Some(3.0), None)
/// ```
export fn sqrt(x : Float) -> Optional(Float) =
    if x < 0.0 then None else Some(squareRoot(x))

foreign fn squareRoot(x : Float) -> Float = "math:sqrt/1"

/// `base` raised to `exponent`, or `None` where no real number is: a
/// negative base with a fractional exponent, and zero to a negative power.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is too
/// large to be finite, as `Float.exp` does (report §3.1).
///
/// ### Examples
///
/// ```ernest
/// #(Float.pow(2.0, 10.0), Float.pow(-8.0, 0.5), Float.pow(0.0, -1.0))
/// // => #(Some(1024.0), None, None)
/// ```
export fn pow(base : Float, exponent : Float) -> Optional(Float) =
    if base < 0.0 && Int.toFloat(truncate(exponent)) != exponent then None
    else if base == 0.0 && exponent < 0.0 then None
    else Some(power(base, exponent))

foreign fn power(base : Float, exponent : Float) -> Float = "ern_float:pow/2"

/// `e` raised to `x`.
///
/// ### Examples
///
/// ```ernest
/// Float.exp(0.0)
/// // => 1.0
/// ```
export foreign fn exp(x : Float) -> Float = "ern_float:exp/1"

/// The natural logarithm, or `None` at zero and below.
///
/// ### Examples
///
/// ```ernest
/// #(Float.log(1.0), Float.log(0.0))
/// // => #(Some(0.0), None)
/// ```
export fn log(x : Float) -> Optional(Float) =
    if x <= 0.0 then None else Some(naturalLog(x))

foreign fn naturalLog(x : Float) -> Float = "math:log/1"

/// The sine of an angle in radians, as the other trigonometric functions
/// take and give.
///
/// ### Examples
///
/// ```ernest
/// #(Float.sin(0.0), Float.cos(0.0), Float.tan(0.0))
/// // => #(0.0, 1.0, 0.0)
/// ```
export foreign fn sin(x : Float) -> Float = "math:sin/1"

/// The cosine.
export foreign fn cos(x : Float) -> Float = "math:cos/1"

/// The tangent.
export foreign fn tan(x : Float) -> Float = "math:tan/1"

/// The angle whose sine is `x`, or `None` outside -1.0 to 1.0.
///
/// ### Examples
///
/// ```ernest
/// #(Float.asin(0.0), Float.acos(2.0))
/// // => #(Some(0.0), None)
/// ```
export fn asin(x : Float) -> Optional(Float) =
    if x < -1.0 || x > 1.0 then None else Some(arcSin(x))

foreign fn arcSin(x : Float) -> Float = "math:asin/1"

/// The angle whose cosine is `x`, or `None` outside -1.0 to 1.0.
export fn acos(x : Float) -> Optional(Float) =
    if x < -1.0 || x > 1.0 then None else Some(arcCos(x))

foreign fn arcCos(x : Float) -> Float = "math:acos/1"

/// The angle whose tangent is `x`.
///
/// ### Examples
///
/// ```ernest
/// Float.atan(0.0)
/// // => 0.0
/// ```
export foreign fn atan(x : Float) -> Float = "math:atan/1"

/// The angle of the point `#(x, y)`, the `y` given first, which keeps the
/// quadrant that `atan(y / x)` loses.
///
/// ### Examples
///
/// ```ernest
/// Float.atan2(0.0, 1.0)
/// // => 0.0
/// ```
export foreign fn atan2(y : Float, x : Float) -> Float = "math:atan2/2"
