/// Operations on `Float`, IEEE 754 double precision restricted to the
/// finite range (report §3.1). The arithmetic and the ordering are the
/// prelude's (report §9.6); this module provides them with the rest. No
/// operation here returns an infinity or a NaN: one that would, faults,
/// and one with no answer gives `None`. The module holds the operations of
/// the type itself; mathematics over collections of floats is a library.
///
/// ## Examples
///
/// ```ernest
/// Float.toString(Float.abs(-2.5) * 2.0)
/// // => "5.0"
/// ```
///
/// ```ernest
/// #(Float.round(2.5), Float.round(3.5), Float.floor(-2.5), Float.ceil(-2.5))
/// // => #(2, 4, -3, -2)
/// ```
///
/// ## See also
///
/// `Int.toFloat`, `String.toFloat`.
///
/// since 0.1.0

/// The sum, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1).
export fn Float.+(left : Float, right : Float) : Float =
    left + right

/// The difference, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1).
export fn Float.-(left : Float, right : Float) : Float =
    left - right

/// The product, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1).
export fn Float.*(left : Float, right : Float) : Float =
    left * right

/// The quotient, rounded to the nearest `Float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1), which a divisor of `0.0` makes it.
export fn Float./(dividend : Float, divisor : Float) : Float =
    dividend / divisor

/// `-float`, which prefix `-` calls.
///
/// ### Examples
///
/// ```ernest
/// Float.negate(1.5)
/// // => -1.5
/// ```
export fn negate(float : Float) : Float =
    -float

/// The numeric order, which `<` and the other comparisons use.
///
/// ### Examples
///
/// ```ernest
/// Float.compare(2.0, 1.0)
/// // => Greater
/// ```
export fn compare(left : Float, right : Float) : Ordering =
    if left < right then Less else if left > right then Greater else Equal

/// The magnitude.
export fn abs(float : Float) : Float =
    if float < 0.0 then -float else float

/// The smaller.
///
/// ### Examples
///
/// ```ernest
/// #(Float.min(1.0, 2.0), Float.max(1.0, 2.0))
/// // => #(1.0, 2.0)
/// ```
export fn min(left : Float, right : Float) : Float =
    if left < right then left else right

/// The larger.
export fn max(left : Float, right : Float) : Float =
    if left > right then left else right

/// The shortest digits that read back as the same value, always with a
/// fraction: `100.0`, not `100`. From 0.0001 to below 1.0e16 they are
/// written plain; beyond, as one digit, the point, the rest, and the
/// exponent, whose sign is written only when it is negative.
///
/// ### Examples
///
/// ```ernest
/// #(Float.toString(1.0e15), Float.toString(1.0e16), Float.toString(0.00001))
/// // => #("1000000000000000.0", "1.0e16", "1.0e-5")
/// ```
export foreign fn toString(float : Float) : String =
    "ern_float:to_string/1"

/// The nearest `Int`, ties to even.
export fn round(float : Float) : Int = {
    let floored = floor(float);
    let fraction = float - Int.toFloat(floored);
    if fraction < 0.5 then
        floored
    else if fraction > 0.5 then
        floored + 1
    else if floored % 2 == 0 then
        floored
    else
        floored + 1
}

/// Toward zero, so `-2.7` gives `-2`.
///
/// ### Examples
///
/// ```ernest
/// #(Float.truncate(-2.7), Float.floor(-2.7))
/// // => #(-2, -3)
/// ```
export foreign fn truncate(float : Float) : Int =
    "erlang:trunc/1"

/// The greatest `Int` not above `float`.
///
/// ### Examples
///
/// ```ernest
/// #(Float.floor(2.7), Float.floor(-2.7))
/// // => #(2, -3)
/// ```
export foreign fn floor(float : Float) : Int =
    "erlang:floor/1"

/// The least `Int` not below `float`.
///
/// ### Examples
///
/// ```ernest
/// #(Float.ceil(2.2), Float.ceil(-2.2))
/// // => #(3, -2)
/// ```
export foreign fn ceil(float : Float) : Int =
    "erlang:ceil/1"

/// The square root, or `None` below zero.
///
/// ### Examples
///
/// ```ernest
/// #(Float.sqrt(9.0), Float.sqrt(-1.0))
/// // => #(Some(3.0), None)
/// ```
export fn sqrt(float : Float) : Optional(Float) =
    if float < 0.0 then None else Some(squareRoot(float))

foreign fn squareRoot(float : Float) : Float =
    "math:sqrt/1"

/// `base` raised to `exponent`, or `None` where no real number is: a
/// negative base with a fractional exponent, and zero to a negative power.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is too
/// large to be finite, as `Float.exp` does (report §3.1).
///
/// ### Examples
///
/// ```ernest
/// #(Float.pow(2.0, 10.0), Float.pow(-8.0, 0.5), Float.pow(0.0, -1.0))
/// // => #(Some(1024.0), None, None)
/// ```
export fn pow(base : Float, exponent : Float) : Optional(Float) =
    if base < 0.0 && Int.toFloat(truncate(exponent)) != exponent then
        None
    else if base == 0.0 && exponent < 0.0 then
        None
    else
        Some(power(base, exponent))

foreign fn power(base : Float, exponent : Float) : Float =
    "ern_float:pow/2"

/// `e` raised to the power `float`.
///
/// ### Errors
///
/// Faults with `Fault("float arithmetic error")` when the result is not
/// finite (report §3.1).
///
/// ### Examples
///
/// ```ernest
/// Float.exp(0.0)
/// // => 1.0
/// ```
export foreign fn exp(float : Float) : Float =
    "ern_float:exp/1"

/// The natural logarithm, or `None` at zero and below.
///
/// ### Examples
///
/// ```ernest
/// #(Float.log(1.0), Float.log(0.0))
/// // => #(Some(0.0), None)
/// ```
export fn log(float : Float) : Optional(Float) =
    if float <= 0.0 then None else Some(naturalLog(float))

foreign fn naturalLog(float : Float) : Float =
    "math:log/1"

/// The ratio of a circle's circumference to its diameter, the nearest
/// `Float` to it, a constant of the type (report Appendix E.0 rule 3).
///
/// ### Examples
///
/// ```ernest
/// Float.cos(Float.pi)
/// // => -1.0
/// ```
///
/// since 0.2.0
export let pi : Float = 3.141592653589793

/// The sine of an angle in radians, as the other trigonometric functions
/// take and give.
///
/// ### Examples
///
/// ```ernest
/// #(Float.sin(0.0), Float.cos(0.0), Float.tan(0.0))
/// // => #(0.0, 1.0, 0.0)
/// ```
export foreign fn sin(float : Float) : Float =
    "math:sin/1"

/// The cosine.
export foreign fn cos(float : Float) : Float =
    "math:cos/1"

/// The tangent.
export foreign fn tan(float : Float) : Float =
    "math:tan/1"

/// The angle whose sine is `float`, or `None` outside -1.0 to 1.0.
///
/// ### Examples
///
/// ```ernest
/// #(Float.asin(0.0), Float.acos(2.0))
/// // => #(Some(0.0), None)
/// ```
export fn asin(float : Float) : Optional(Float) =
    if float < -1.0 || float > 1.0 then None else Some(arcSin(float))

foreign fn arcSin(float : Float) : Float =
    "math:asin/1"

/// The angle whose cosine is `float`, or `None` outside -1.0 to 1.0.
export fn acos(float : Float) : Optional(Float) =
    if float < -1.0 || float > 1.0 then None else Some(arcCos(float))

foreign fn arcCos(float : Float) : Float =
    "math:acos/1"

/// The angle whose tangent is `float`.
///
/// ### Examples
///
/// ```ernest
/// Float.atan(0.0)
/// // => 0.0
/// ```
export foreign fn atan(float : Float) : Float =
    "math:atan/1"

/// The angle of the point `#(x, y)`, the `y` given first, which keeps the
/// quadrant that `atan(y / x)` loses.
///
/// ### Examples
///
/// ```ernest
/// Float.atan2(0.0, 1.0)
/// // => 0.0
/// ```
export foreign fn atan2(y : Float, x : Float) : Float =
    "ern_float:atan2/2"
