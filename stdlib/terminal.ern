/// The terminal through its system process, which reads it
/// (report §8.2). A subscriber is sent every key pressed from then on,
/// the text of a paste as one `Pasted`, and the new size whenever the
/// window changes, wrapped for its own mailbox, as `monitor` and
/// `Clock.alarm` deliver. Where standard input is not a terminal there are
/// no keys, and a subscription is refused. The terminal read as keys and
/// the terminal read as lines are the same one, so a program subscribes
/// here or reads lines with `Io.readLine`, never both.
///
/// ## Examples
///
/// ```ernest
/// match Terminal.subscribe(fn(event) = event) {
///     Right(_) -> "keys"
///   | Left(Io.NotATerminal) -> "lines"
///   | Left(_) -> "neither"
/// }
/// ```
///
/// ## See also
///
/// `Io.readLine` for the same terminal read as lines, `Clock.alarm` for the
/// other message that arrives later.
///
/// since 0.1.0

/// The terminal's window, in rows and columns, as the terminal reports it
/// (report §8.2).
///
/// ### Examples
///
/// ```ernest
/// Terminal.Size(rows = 24, columns = 80)
/// ```
export type Size = Size(rows : Int, columns : Int)

/// What the terminal delivers to its subscriber: a key, an arrow, `Enter`,
/// `Escape`, the interrupt, a paste, or a new size (report §8.2).
///
/// ### Examples
///
/// ```ernest
/// match Terminal.Key('q') { Terminal.Key(c) -> c == 'q' | _ -> false }
/// // => true
/// ```
export type Event =
    Key(Char) | ArrowUp | ArrowDown | ArrowLeft | ArrowRight | Enter
  | Escape | Interrupt | Pasted(String) | Resized(Size)

// What the terminal takes.
type Msg =
    Subscribe(to : Address(Event), reply : Reply(Either(Io.Error, Unit)))
  | Measure(reply : Reply(Optional(Size)))

// Report §8.2: the system reference, the runtime's address of the terminal,
// bound at each start.
let reference : Address(Msg) = system(Erl.atom("terminal"))

foreign fn system(name : Foreign) -> Address(Msg) with m = "ern_rt:sys/1"

/// Every key pressed and every resize from now on, wrapped, in the
/// caller's mailbox. It answers once the terminal is in the mode the keys
/// need, so that nothing typed after it returns is echoed (report §8.2),
/// or with `Left(Io.NotATerminal)` where standard input is not a terminal,
/// claiming nothing, so that the program can read lines instead. A process
/// holds one subscription: a second call replaces the first, and the keys
/// come wrapped the new way from then on. The terminal applies each
/// subscriber's wrap itself, in order, so a wrap that does not finish
/// delays that subscriber's keys and no other's.
export fn subscribe(wrap : (Event) -> m) -> Either(Io.Error, Unit) with m = {
    let to = via(wrap, self());
    Address.callForever(reference, fn(r) = Subscribe(to = to, reply = r))
}

/// The terminal's size now, and `None` where standard output is not a
/// terminal or its size is unknown. A program that draws asks at each
/// redraw and hears of a change as `Resized`.
///
/// ### Examples
///
/// ```ernest
/// match Terminal.size() {
///     None -> 24
///   | Some(Size(rows = rows)) -> rows
/// }
/// ```
export fn size() -> Optional(Size) with m =
    Address.callForever(reference, fn(r) = Measure(reply = r))

//
// Writing to the terminal: ECMA-48's sequences, as text a program writes
// with `Io.print` (report Appendix E.16)
//

/// The eight colours of ECMA-48.
///
/// ### Examples
///
/// ```ernest
/// Terminal.Foreground(Terminal.Red)
/// ```
export type Colour = Black | Red | Green | Yellow | Blue | Magenta | Cyan | White

/// How text is drawn: its weight, its slant, a line under it, or its
/// colour.
///
/// ### Examples
///
/// ```ernest
/// Terminal.styled("warning", Terminal.Bold)
/// // => "\u{1B}[1mwarning\u{1B}[22m"
/// ```
export type Style = Bold | Dim | Italic | Underline | Foreground(Colour)

/// The text in the style, which is turned off after it by the style's own
/// code, so that a style around it stays on. `Bold` and `Dim` are turned
/// off together, since ECMA-48 has one code for both.
///
/// ### Examples
///
/// ```ernest
/// Terminal.styled("fault", Terminal.Foreground(Terminal.Red))
/// // => "\u{1B}[31mfault\u{1B}[39m"
/// ```
export fn styled(text : String, style : Style) -> String = {
    let #(on, off) = match style {
        Bold -> #("1", "22")
      | Dim -> #("2", "22")
      | Italic -> #("3", "23")
      | Underline -> #("4", "24")
      | Foreground(colour) -> #("3" <> Int.toString(colourCode(colour)), "39")
    };
    sequence(on <> "m") <> text <> sequence(off <> "m")
}

fn colourCode(colour : Colour) -> Int = match colour {
    Black -> 0
  | Red -> 1
  | Green -> 2
  | Yellow -> 3
  | Blue -> 4
  | Magenta -> 5
  | Cyan -> 6
  | White -> 7
}

/// The cursor up that many rows; `""` for a number below 1.
///
/// ### Examples
///
/// ```ernest
/// Terminal.up(2)
/// // => "\u{1B}[2A"
/// ```
export fn up(n : Int) -> String = move(n, "A")

/// The cursor down that many rows; `""` for a number below 1.
///
/// ### Examples
///
/// ```ernest
/// Terminal.down(0)
/// // => ""
/// ```
export fn down(n : Int) -> String = move(n, "B")

/// The cursor left that many columns; `""` for a number below 1.
///
/// ### Examples
///
/// ```ernest
/// Terminal.left(3)
/// // => "\u{1B}[3D"
/// ```
export fn left(n : Int) -> String = move(n, "D")

/// The cursor right that many columns; `""` for a number below 1.
///
/// ### Examples
///
/// ```ernest
/// Terminal.right(1)
/// // => "\u{1B}[1C"
/// ```
export fn right(n : Int) -> String = move(n, "C")

fn move(n : Int, direction : String) -> String =
    if n < 1 then "" else sequence(Int.toString(n) <> direction)

/// Erases from the cursor to the end of the screen.
///
/// ### Examples
///
/// ```ernest
/// Io.print("\r" <> Terminal.clearBelow)
/// ```
export let clearBelow = sequence("J")

/// Erases the screen and puts the cursor at its top left.
///
/// ### Examples
///
/// ```ernest
/// Io.print(Terminal.clearScreen)
/// ```
export let clearScreen = sequence("2J") <> sequence("H")

// ECMA-48's control sequence introducer and what follows it.
fn sequence(body : String) -> String = "\u{1b}[" <> body
