/// Time from the clock, the system process that keeps it (report §8.2).
/// Times are milliseconds since the epoch; `monotonic` is the clock to
/// measure a duration by, since `now` moves when the clock is set. An
/// alarm fires once, and a program cannot cancel it: a process that no
/// longer wants it ignores the message, and a periodic tick is scheduled
/// again after the previous one is handled. A restart of the process that
/// set it cancels it (report §6.9).
///
/// ## Examples
///
/// ```ernest
/// Clock.now() > 0
/// // => true
/// ```
///
/// ## See also
///
/// `Random.seed` for a sequence that differs between runs.
///
/// since 0.1.0

// What the clock takes: times in milliseconds, the time an alarm fires
// sent to its `address`. An alarm is answered once the clock holds it, so that
// the caller goes on only when it is counted as pending (report §8.6).
type Msg =
    Alarm(ms : Int, address : Address(Int), reply : Reply(Unit))
  | AlarmAt(time : Int, address : Address(Int), reply : Reply(Unit))
  | Now(reply : Reply(Int))

// Report §8.2: the system reference, the runtime's address of the clock,
// bound at each start.
let reference : Address(Msg) = system(Erl.atom("clock"))

foreign fn system(name : Foreign.Term) : Address(Msg) with m =
    "ern_rt:system_process/1"

/// The time now.
export fn now() : Int with m =
    Address.callForever(reference, fn(reply) = Now(reply = reply))

/// Milliseconds since a moment the runtime chose, which never go back, so
/// that the difference of two readings is the time the host ran between
/// them; where the host's monotonic clock stops while the machine is
/// suspended, that time is left out. Its value alone says nothing; `now` is
/// the time of day.
///
/// ### Examples
///
/// ```ernest
/// {
///     let start = Clock.monotonic();
///     Clock.monotonic() - start >= 0
/// }
/// // => true
/// ```
export foreign fn monotonic() : Int with m =
    "ern_rt:monotonic/0"

/// After that many milliseconds, `wrap(t)` arrives in the caller's mailbox,
/// `t` the time it fired. A single-positional constructor passes as
/// `wrap` directly, `Clock.alarm(100, Tick)` for `Tick(Int)`.
///
/// ### Examples
///
/// ```ernest
/// Clock.alarm(10, fn(_) = Unit)
/// ```
export fn alarm(ms : Int, wrap : (Int) -> m) : Unit with m = {
    let address = via(self(), wrap);
    Address.callForever(reference, fn(reply) = Alarm(ms = ms, address = address, reply = reply))
}

/// At that time, `wrap(t)` arrives in the caller's mailbox, `t` the time it
/// fired; a time already past arrives at once.
///
/// ### Examples
///
/// ```ernest
/// Clock.alarmAt(Clock.now() + 10, fn(_) = Unit)
/// ```
export fn alarmAt(time : Int, wrap : (Int) -> m) : Unit with m = {
    let address = via(self(), wrap);
    Address.callForever(reference,
                        fn(reply) = AlarmAt(time = time, address = address, reply = reply))
}
