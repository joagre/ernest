/// Output to standard output and standard error, and input from standard
/// input, through the module's system references `stdout`, `stderr`, and
/// `stdin` (report §8.2). Each is a system process, so printing is a
/// message and carries the caller's mailbox effect; pure code cannot print.
/// A write returns once its stream has taken the bytes, and waits while the
/// stream is behind, so a program is held to the pace of what reads it.
/// `Error` is the error of every system module.
///
/// ## Examples
///
/// ```ernest
/// Io.println("hello, world")
/// // => Unit
/// ```
///
/// ```ernest
/// Io.debug(Optional.map(Some(2), fn(n) = n * 10))
/// // => Some(20)
/// ```
///
/// ## See also
///
/// `String` for building what is printed, `Terminal` for the keys and the
/// screen themselves.
///
/// since 0.1.0

/// Why an operation of a system module found no answer: `NotFound`, the
/// file or the host is not there; `Denied`, access was refused; `Refused`
/// and `Closed`, the connection was refused or has closed; `Timeout`, the
/// time ran out; `NotATerminal`, standard input is not a terminal;
/// `NotAFile`, a path names something other than a regular file; `Exists`,
/// a path names something where nothing may stand; `NotUtf8(bytes)`, text
/// that is not UTF-8, a name or a link's target among them, its bytes
/// carried; `Invalid`, an argument holds U+0000 or a port is out of range;
/// and `Other(text)`, another reason as the host describes it, `"address
/// already in use"`, or as the host writes it where it has no description
/// (report Appendix E.1).
///
/// ### Examples
///
/// ```ernest
/// match Fs.read(Path("/no/such/file"), 1000) {
///     Left(Io.NotFound) -> "missing"
///   | Left(_) -> "failed"
///   | Right(_) -> "read"
/// }
/// ```
export type Error =
    NotFound
  | Denied
  | Refused
  | Closed
  | Timeout
  | NotATerminal
  | NotAFile
  | Exists
  | NotUtf8(Bytes)
  | Invalid
  | Other(String)

// What standard input takes.
type StdinMsg = ReadLine(reply : Reply(Optional(String))) | Read(reply : Reply(Optional(Bytes)))

// What standard output and standard error take: bytes to write, answered
// once the stream has taken them (report §8.2).
type OutMsg = Write(bytes : Bytes, reply : Reply(Unit))

// Report §8.2: the system references, the runtime's addresses of standard
// output, standard error and standard input, bound at each start.
let stdout : Address(OutMsg) = system(Erl.atom("stdout"))

let stderr : Address(OutMsg) = system(Erl.atom("stderr"))

let stdin : Address(StdinMsg) = system(Erl.atom("stdin"))

foreign fn system(name : Foreign.Term) : Address(a) with m =
    "ern_rt:sys/1"

/// The string to standard output, as it is, without a line feed.
///
/// ### Examples
///
/// ```ernest
/// Io.print("half ");
/// Io.println("and half")
/// // => Unit
/// ```
export fn print(s : String) : Unit with m =
    written(stdout, String.toUtf8(s))

/// The string to standard output, with a line feed after it.
export fn println(s : String) : Unit with m =
    written(stdout, String.toUtf8(s <> "\n"))

// The bytes to a stream, once it has taken them.
fn written(stream : Address(OutMsg), bytes : Bytes) : Unit with m =
    Address.callForever(stream, fn(r) = Write(bytes = bytes, reply = r))

/// The string to standard error, as it is, without a line feed. Standard
/// error is a second sink, for a program whose output something else reads;
/// it is not a level of severity.
///
/// ### Examples
///
/// ```ernest
/// Io.printError("cannot ");
/// Io.printlnError("open the file")
/// // => Unit
/// ```
export fn printError(s : String) : Unit with m =
    written(stderr, String.toUtf8(s))

/// The string to standard error, with a line feed after it.
export fn printlnError(s : String) : Unit with m =
    written(stderr, String.toUtf8(s <> "\n"))

/// The next line from standard input, without its line feed and without
/// one carriage return before it, or `None` at end of input. A last line
/// without a line feed is a line. Standard input is read as UTF-8, and a
/// line that is not faults the caller. A program reads lines or
/// subscribes to keys, not both (report §8.2).
///
/// ### Examples
///
/// ```ernest
/// Io.readLine()
/// ```
export fn readLine() : Optional(String) with m =
    Address.callForever(stdin, fn(r) = ReadLine(reply = r))

/// What has arrived on standard input, at least one byte, or `None` at end
/// of input. Lines and bytes are read from one stream, so a read takes up
/// where the line before it stopped (report §8.2).
///
/// ### Examples
///
/// ```ernest
/// Io.read()
/// ```
export fn read() : Optional(Bytes) with m =
    Address.callForever(stdin, fn(r) = Read(reply = r))

/// The bytes to standard output, as they are.
///
/// ### Examples
///
/// ```ernest
/// Io.write(<<104, 105, 10>>)
/// // => Unit
/// ```
export fn write(b : Bytes) : Unit with m =
    written(stdout, b)

/// The bytes to standard error, as they are, `write`'s twin as
/// `printError` is `print`'s.
///
/// ### Examples
///
/// ```ernest
/// Io.writeError(<<104, 105, 10>>)
/// // => Unit
/// ```
export fn writeError(b : Bytes) : Unit with m =
    written(stderr, b)

/// The value as Ernest writes it, by its type at the call: a value as its
/// literal or construction is written, a named constructor's fields in
/// declared order (report §3.5), an address as the process behind it,
/// `<address 84>`, and a function as `<function>`. The type at the call is
/// known whole, with no type variable in it, so that in a generic function
/// `Io.show` at the function's type variable is a type error (report
/// Appendix E.1). It is pure.
///
/// ### Examples
///
/// ```ernest
/// Io.show(#('a', Some([1, 2]), <<104, 105>>))
/// // => "#('a', Some([1, 2]), <<104, 105>>)"
/// ```
export foreign fn show(value : a) : String =
    "ern_io:show/1"

/// The value printed as `Io.show` writes it, with a line feed, to
/// standard error, and returned, so it wraps an expression where it
/// stands: `let n = Io.debug(f(x))`. Its type at the call is known whole,
/// as `Io.show`'s is.
export foreign fn debug(value : a) : a with m =
    "ern_io:debug/1"
