/// Pseudo-random numbers, drawn from a seed the program carries.
///
/// Use it for numbers that need only look random: a shuffle, a simulation, a
/// test's cases. It is not for secrets: its generator, SplitMix64, is not
/// cryptographic, and its draws can be predicted from earlier ones.
///
/// **A seed is carried.** `seed` makes a `Seed` from a number, and each draw
/// answers a number and the seed to draw with next. There is no hidden state
/// and no process, so every function here is pure (report Appendix E.13), and
/// the same seed gives the same sequence on every node and every version. A
/// program that wants a sequence that differs between runs seeds from
/// `Clock.now()`.
///
/// ## Examples
///
/// Two throws of a die, the seed the first answers carried to the second:
///
/// ```ernest
/// let #(first, seed1) = Random.next(Random.seed(2026), 5);
/// let #(second, _) = Random.next(seed1, 5);
/// #(first + 1, second + 1)
/// // => #(2, 6)
/// ```
///
/// The same seed draws the same number:
///
/// ```ernest
/// Random.next(Random.seed(42), 100) == Random.next(Random.seed(42), 100)
/// // => true
/// ```
///
/// ## See also
///
/// `Clock.now` for a seed that differs between runs.
///
/// since 0.1.0

/// The generator's state, which a draw takes and gives back. It is a value like
/// any other, which can be stored, compared and sent to another node.
///
/// ### Examples
///
/// ```ernest
/// Random.next(Random.seed(42), 100) == Random.next(Random.seed(42), 100)
/// // => true
/// ```
export abstract type Seed = Seed(Int)

/// The seed `int` names. The same number gives the same sequence, and so do two
/// numbers equal in their low 64 bits.
export fn seed(int : Int) : Seed =
    Seed(Int.bitAnd(int, mask))

/// A number from 0 to `bound`, both included, and the seed to draw with next. A
/// negative `bound` draws from `bound` to 0, and a `bound` of 0 always draws 0.
/// Every number in the range is equally likely.
///
/// ### Examples
///
/// ```ernest
/// let #(x, _) = Random.next(Random.seed(1), -3);
/// x <= 0 && x >= -3
/// // => true
/// ```
export fn next(seed : Seed, bound : Int) : #(Int, Seed) = {
    let #(drawn, seed1) = below(seed, Int.abs(bound) + 1);
    if bound < 0 then #(Int.negate(drawn), seed1) else #(drawn, seed1)
}

// A number from 0 to below `bound`, from as many 64-bit draws as span
// `bound`, those at or above the largest multiple of `bound` the draws can
// reach drawn again.
fn below(seed : Seed, bound : Int) : #(Int, Seed) = {
    let #(value, span, seed1) = spanning(seed, bound, 0, 1);
    if value < span - span % bound then #(value % bound, seed1) else below(seed1, bound)
}

// A value drawn from as many 64-bit draws as span `bound`, the span they
// reach, and the seed after them.
fn spanning(seed : Seed, bound : Int, value : Int, span : Int) : #(Int, Int, Seed) =
    if span >= bound && span > 1 then
        #(value, span, seed)
    else {
        let #(draw, seed1) = splitMix(seed);
        spanning(seed1, bound, value * drawSpan + draw, span * drawSpan)
    }

// SplitMix64: the counter advanced by the golden gamma, and its new value
// mixed into the draw.
fn splitMix(seed : Seed) : #(Int, Seed) =
    match seed {
        Seed(state) -> {
            let counter = Int.bitAnd(state + 0x9E37_79B9_7F4A_7C15, mask);
            let mixed =
                Int.bitAnd(Int.bitXor(counter, Int.shiftRight(counter, 30)) * 0xBF58_476D_1CE4_E5B9,
                           mask);
            let mixed1 =
                Int.bitAnd(Int.bitXor(mixed, Int.shiftRight(mixed, 27)) * 0x94D0_49BB_1331_11EB,
                           mask);
            #(Int.bitXor(mixed1, Int.shiftRight(mixed1, 31)), Seed(counter))
        }
    }

/// A number above 0.0 and below 1.0, and the seed to draw with next. It never
/// draws 0.0 or 1.0, and its draws are evenly spaced, 2^-52 apart.
///
/// ### Examples
///
/// ```ernest
/// let #(x, _) = Random.nextFloat(Random.seed(3));
/// x > 0.0 && x < 1.0
/// // => true
/// ```
export fn nextFloat(seed : Seed) : #(Float, Seed) = {
    let #(draw, seed1) = splitMix(seed);
    #((Int.toFloat(Int.shiftRight(draw, 12)) + 0.5) / fractionSpan, seed1)
}

let mask = 0xFFFF_FFFF_FFFF_FFFF

// How many values one draw takes, 2^64.
let drawSpan = mask + 1

// How many fractions a draw's top 52 bits write, 2^52.
let fractionSpan = Int.toFloat(Int.shiftLeft(1, 52))
