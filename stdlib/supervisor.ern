/// A supervisor restarts a group of processes, its children, together
/// (report Appendix E.22). `group(strategy, limit)` is the function a
/// supervisor runs and `child(sup, f)` the function a child runs. The
/// caller spawns each, as it spawns what `restarting` answers, so a fault
/// line names the binding that holds the process (report §6.9) and a
/// service binding reaches it (report §6.5).
///
/// A child restarts in place after a fault, as `restarting` does, and the
/// strategy says which of its siblings restart with it. A sibling runs on
/// until it next waits and restarts there, keeping its address and its
/// mailbox (report §6.9). A group whose children fault more often than its
/// limit allows faults. A supervisor that is itself a child restarts in
/// place, and asks each of its own children to restart. When a
/// supervisor dies, its children are killed after it, the last spawned
/// first, each once the one before has ended, by a watcher the module
/// spawns beside it; so `kill(sup)` stops a group. A child that must finish
/// its work first is sent a message of its own protocol before, since a
/// killed process runs nothing more.
///
/// A child tells its supervisor when it joins and when it restarts after a
/// fault, and not when it restarts because it was asked. The supervisor does
/// not subscribe to `Process.faults`, which delivers every fault of the
/// runtime where a supervisor needs its own children's.
///
/// ## Examples
///
/// A group of one, a child that answers, and the group stopped. The child's
/// mailbox takes a bare `Reply(Int)`, so the call makes its message with
/// `fn(r) = r`:
///
/// ```ernest
/// {
///     let sup =
///         spawn(Local,
///               Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     let echo = spawn(Local, Supervisor.child(sup, fn() : Unit with Reply(Int) = receive {
///         r -> answer(r, 42)
///     }));
///     let n = Address.callForever(echo, fn(r) = r);
///     kill(sup);
///     n
/// }
/// // => 42
/// ```
///
/// ## See also
///
/// `restarting`, which restarts one process in place; `kill`; `monitor`.
///
/// since 0.1.0

/// What else a child's fault restarts: nothing, every other child, or the
/// children spawned after it, in the order the runtime spawned them,
/// whatever order they joined in.
///
/// ### Examples
///
/// ```ernest
/// Supervisor.RestForOne
/// ```
export type Strategy = OneForOne | OneForAll | RestForOne

/// What a supervisor takes: its children's joins and faults, and what it
/// sends itself; only this module makes it.
///
/// ### Examples
///
/// ```ernest
/// {
///     let sup : Address(Supervisor.Msg) =
///         spawn(Local,
///               Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     kill(sup)
/// }
/// // => Unit
/// ```
export abstract type Msg =
    Join(process : Process,
         stop : () -> Unit with Watch,
         watch : ((Down) -> Watch) -> Unit with Watch,
         reply : Reply(Unit))
  | Faulted(process : Process, reply : Reply(Optional(Address(Watch))))
  | WatcherIs(Address(Watch))
  | Expired(Int)
  | Settled(Process)

// What the watcher takes: a child to watch, the children in the order they
// were spawned, the number of a new run of the supervisor, a child that
// ended, the supervisor's end, and a child that waits for either of the
// last two.
type Watch =
    Add(Member)
  | Members(reply : Reply(List(Process)))
  | Run(reply : Reply(Int))
  | Gone(Process)
  | SupervisorDied
  | Hold(reply : Reply(Unit))

// The replies of the children that wait, which the watcher holds until the
// supervisor's next run or its end.
type Held = Holding(reply : Reply(Unit), next : Held) | Nobody

// A child as the watcher holds it: its process, where it stands in the
// order of spawns, how to kill it, and how to monitor it.
type Member =
    Member(process : Process,
           spawned : Int,
           stop : () -> Unit with Watch,
           watch : ((Down) -> Watch) -> Unit with Watch)

// Why a child's function began: the first time, after a fault, or because
// its supervisor asked.
type Start = First | AfterFault | Asked

// A supervisor's run: what it was given, its watcher, and the number the
// watcher gave this run, which its alarms carry.
type Group = Group(strategy : Strategy, limit : RestartLimit, watcher : Address(Watch), run : Int)

// The children that faulted and wait to run again, each with the siblings
// its fault restarts that have not yet restarted or ended.
type Waiting =
    Waiting(reply : Reply(Optional(Address(Watch))), asked : List(Process), next : Waiting)
  | NoOne

/// The function a supervisor runs, which the caller spawns. When the
/// children's faults pass `limit`, counted as `restarting` counts them
/// (report §6.9), it faults. A supervisor that is itself a child restarts in
/// place, and asks each of its children to restart; they keep their order.
///
/// ### Errors
///
/// `Fault("supervisor restart limit reached")` when the children's faults
/// pass `limit`.
///
/// ### Examples
///
/// ```ernest
/// spawn(Local, Supervisor.group(Supervisor.OneForAll, RestartLimit(restarts = 5, within = 10000)))
/// ```
export fn group(strategy : Strategy, limit : RestartLimit) : () -> Unit with Msg =
    fn() = {
        let sup = self();
        // the watcher outlives a restart in place: its address waits in the
        // mailbox, which a restart keeps, and is put back at once
        let watcher = receive {
            WatcherIs(w) -> w
          | after 0 -> spawn(Local, fn() : Unit with Watch = watch(sup))
        };
        send(sup, WatcherIs(watcher));
        let run = Address.callForever(watcher, fn(r) = Run(reply = r));
        // a supervisor restarted in place restarts its subtree with it
        match startCause() {
            First -> Unit
          | _ -> List.foreach(members(watcher), askRestart)
        };
        supervise(Group(strategy = strategy, limit = limit, watcher = watcher, run = run), 0, NoOne)
    }

// The supervisor's loop. `recent` counts the faults within the limit's
// window. Each one expires by an alarm, so no clock is read, and an alarm
// set by an earlier run, before a restart in place, is taken and ignored.
// A child waits for its fault's answer before it runs again, so each fault
// is counted before the next can come; `Unlimited` counts none (§6.9).
// The fault the group gives up at is answered with the watcher before the
// supervisor faults, so that the child waits there for the group's end or
// its restart in place, rather than fault of the supervisor's end.
fn supervise(g : Group, recent : Int, waiting : Waiting) : Unit with Msg =
    receive {
        Join(process = p, stop = s, watch = w, reply = r) -> {
            send(g.watcher, Add(Member(process = p, spawned = spawnOrder(p), stop = s, watch = w)));
            answer(r, Unit);
            supervise(g, recent, waiting)
        }
      | Faulted(process = p, reply = r) -> match g.limit {
            Unlimited -> restarted(g, p, r, recent, waiting)
          | RestartLimit(restarts = n, within = t) -> if recent < n then {
                let run = g.run;
                Clock.alarm(Int.max(t, 1), fn(_) = Expired(run));
                restarted(g, p, r, recent + 1, waiting)
            } else {
                answer(r, Some(g.watcher));
                fault("supervisor restart limit reached")
            }
        }
      | Expired(run) -> supervise(g, if run == g.run then recent - 1 else recent, waiting)
      | Settled(q) -> supervise(g, recent, settled(waiting, q))
    }

// Appendix E.22: a child's fault that the group restarts. The siblings its
// strategy names are asked to restart, and the child runs again once each
// of them has restarted or ended, so that a call to it after its fault is
// answered by the group restarted whole.
fn restarted(g : Group,
             p : Process,
             r : Reply(Optional(Address(Watch))),
             recent : Int,
             waiting : Waiting) : Unit with Msg = {
    let asked = siblings(g.strategy, p, g.watcher);
    List.foreach(asked, askRestart);
    if List.isEmpty(asked) then {
        answer(r, None);
        supervise(g, recent, waiting)
    } else
        supervise(g, recent, Waiting(reply = r, asked = asked, next = waiting))
}

fn siblings(strategy : Strategy,
            faulted : Process,
            watcher : Address(Watch)) : List(Process) with Msg =
    match strategy {
        OneForOne -> []
      | OneForAll -> List.filter(members(watcher), fn(q) = q != faulted)
      | RestForOne -> spawnedAfter(members(watcher), faulted)
    }

// The children that wait with `q` no longer among the siblings they wait
// for; one that waits for none now runs again.
fn settled(waiting : Waiting, q : Process) : Waiting with Msg =
    match waiting {
        NoOne -> NoOne
      | Waiting(reply = r, asked = asked, next = rest) -> {
            let left = List.filter(asked, fn(x) = x != q);
            if List.isEmpty(left) then {
                answer(r, None);
                settled(rest, q)
            } else
                Waiting(reply = r, asked = left, next = settled(rest, q))
        }
    }

// The children spawned after `p`, which the watcher holds in that order.
fn spawnedAfter(children : List(Process), p : Process) : List(Process) =
    match children {
        [] -> []
      | q :: rest -> if q == p then rest else spawnedAfter(rest, p)
    }

fn members(watcher : Address(Watch)) : List(Process) with Msg =
    Address.callForever(watcher, fn(r) = Members(reply = r))

// Report §6.9: the child restarts at its next wait; one that has ended is
// not asked.
foreign fn askRestart(child : Process) : Unit with m =
    "ern_rt:ask_restart/1"

// Where a process stands in the order the runtime spawned its processes,
// which `RestForOne` reads and the watcher keeps its children in.
foreign fn spawnOrder(p : Process) : Int with m =
    "ern_rt:spawn_order/1"

// The watcher: it holds the children in the order they were spawned,
// forgets one that ends and tells the supervisor, which may be waiting for
// it to restart, and when the supervisor dies kills them, the last first.
fn watch(sup : Address(Msg)) : Unit with Watch = {
    monitor(sup, fn(_) = SupervisorDied);
    watching(sup, [], 0, Nobody)
}

fn watching(sup : Address(Msg),
            children : List(Member),
            runs : Int,
            held : Held) : Unit with Watch =
    receive {
        Add(m) -> if List.any(children, fn(c) = c.process == m.process) then
            watching(sup, children, runs, held)
        else {
            let Member(process = p, spawned = _, stop = _, watch = w) = m;
            w(fn(_) = Gone(p));
            watching(sup, inOrder(children, m), runs, held)
        }
      | Members(reply = r) -> {
            answer(r, List.map(children, fn(c) = c.process));
            watching(sup, children, runs, held)
        }
      | Run(reply = r) -> {
            released(held);
            answer(r, runs + 1);
            watching(sup, children, runs + 1, Nobody)
        }
      | Gone(p) -> {
            send(sup, Settled(p));
            watching(sup, List.filter(children, fn(c) = c.process != p), runs, held)
        }
      | Hold(reply = r) -> watching(sup, children, runs, Holding(reply = r, next = held))
      | SupervisorDied -> {
            stopAll(List.reverse(children));
            released(held)
        }
    }

// The children that waited go on: to the restart their supervisor asks of
// them, or to the end its watcher has already given them.
fn released(held : Held) : Unit with Watch =
    match held {
        Nobody -> Unit
      | Holding(reply = r, next = rest) -> {
            answer(r, Unit);
            released(rest)
        }
    }

// The children with a new one among them, in the order they were spawned.
fn inOrder(children : List(Member), m : Member) : List(Member) =
    match children {
        [] -> [m]
      | c :: rest -> if m.spawned < c.spawned then m :: children else c :: inOrder(rest, m)
    }

fn stopAll(children : List(Member)) : Unit with Watch =
    match children {
        [] -> Unit
      | Member(process = p, spawned = _, stop = stop, watch = _) :: rest -> {
            stop();
            receive {
                Gone(q) when q == p -> Unit
            };
            stopAll(rest)
        }
    }

/// The function a child runs, which the caller spawns. It joins `sup`'s
/// group, waiting until the supervisor has it, and runs `f`; after a fault
/// it runs `f` again in place until the group gives up. A child that
/// returns or is killed leaves the group.
///
/// ### Errors
///
/// `Fault("the supervisor has ended")` when `sup` has ended before the
/// child joins, and `Fault("a child runs on its supervisor's node")` when
/// `sup` is on another node.
///
/// ### Examples
///
/// ```ernest
/// {
///     let sup =
///         spawn(Local,
///               Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     spawn(Local, Supervisor.child(sup, fn() : Unit with Int = receive {
///         _ -> Unit
///     }))
/// }
/// ```
export fn child(sup : Address(Msg), f : () -> Unit with m) : () -> Unit with m =
    fn() = {
        let me = self();
        let p = Process.fromAddress(me);
        join(sup, p, fn() = kill(me), fn(wrap) = monitor(me, wrap));
        // the group's limit decides when a child stops, so its own is none
        restarting(Unlimited, fn() = match startCause() {
            First -> f()
          | AfterFault -> counted(sup, me, f)
          | Asked -> {
                // the child that faulted waits for this one (Appendix E.22)
                send(sup, Settled(p));
                f()
            }
        })()
    }

// After a fault, the child runs again once its supervisor has counted the
// fault. Where the group gives up at it, the child waits with the watcher:
// the group's end kills it there, and a restart in place asks it to
// restart. A child whose supervisor has ended is killed as the others are.
fn counted(sup : Address(Msg), me : Address(m), f : () -> Unit with m) : Unit with m =
    match Process.info(Process.fromAddress(sup)) {
        None -> kill(me)
      | Some(_) -> {
            let report = fn(r) = Faulted(process = Process.fromAddress(me), reply = r);
            match Address.callForever(sup, report) {
                None -> f()
              | Some(watcher) -> {
                    Address.callForever(watcher, fn(r) = Hold(reply = r));
                    f()
                }
            }
        }
    }

// The child joins, and waits until the supervisor has it. A call that ends
// unanswered was made as the supervisor restarted, and is made again; one
// made twice is joined once, since the watcher keeps a child once.
fn join(sup : Address(Msg),
        p : Process,
        s : () -> Unit with Watch,
        w : ((Down) -> Watch) -> Unit with Watch) : Unit with m =
    match Address.call(sup, fn(r) = Join(process = p, stop = s, watch = w, reply = r), 1000) {
        Some(_) -> Unit
      | None -> match Process.info(Process.fromAddress(sup)) {
            None -> fault("the supervisor has ended")
          | Some(_) -> join(sup, p, s, w)
        }
    }

// Why the restarting function the caller runs in began.
foreign fn startCause() : Start with m =
    "ern_rt:start_cause/0"
