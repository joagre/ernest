/// A group of processes, restarted together when one of them faults.
///
/// Use it where processes depend on one another, so that a fault in one must
/// restart others too, or where independent processes should share one restart
/// limit and stop together, one child per connection among them. A single
/// process that restarts alone is `restarting`'s work. Spawn `group(strategy,
/// limit)` as the supervisor, then spawn `child(supervisor, f)` for each child,
/// `f` the work it does. The caller spawns each, as it spawns what `restarting`
/// answers, so a fault line names the binding that holds the process (report
/// §6.9), and a service binding can reach it (report §6.5).
///
/// **What restarts.** A child that faults runs `f` again in place, keeping its
/// address, as under `restarting`. The `Strategy` says which of its siblings
/// restart with it. The child that faulted runs again once each of those
/// siblings has restarted or ended, so a call to it after its fault is answered
/// by the group restarted whole.
///
/// **When a sibling restarts.** A sibling restarts at its next wait, a
/// `receive` or a call waiting for its answer, and runs on until then; a
/// sibling that never waits never restarts. It keeps its address, and its
/// mailbox is emptied, as every restart empties it (report §6.9).
///
/// **The limit.** A group whose children fault more often than `limit` allows
/// faults itself. A supervisor that is itself a child of another group then
/// restarts in place, and asks each of its own children to restart.
///
/// **Stopping a group.** `kill(supervisor)` stops the group: when a supervisor
/// dies, its children are killed after it, the last spawned first, each once
/// the one before has ended. A child that must finish its work first is sent a
/// message of its own protocol before, since a killed process runs nothing
/// more.
///
/// ## Examples
///
/// A group of one, a child that answers, and the group stopped. The child's
/// mailbox takes a bare `Reply(Int)`, so the call makes its message with
/// `fn(reply) = reply`:
///
/// ```ernest
/// {
///     let supervisor =
///         spawn(Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     let echo = spawn(Supervisor.child(supervisor, fn() : Unit with Reply(Int) = receive {
///         reply -> answer(reply, 42)
///     }));
///     let answered = Address.callForever(echo, fn(reply) = reply);
///     kill(supervisor);
///     answered
/// }
/// // => 42
/// ```
///
/// ## See also
///
/// `restarting`, which restarts one process in place; `kill`; `monitor`.
///
/// since 0.1.0

/// What else a child's fault restarts: nothing, under `OneForOne`; every other
/// child, under `OneForAll`; or the children spawned after it, under
/// `RestForOne`. The order is the one the runtime spawned them in, whatever
/// order they joined in.
///
/// ### Examples
///
/// A group whose later children use the earlier ones, restarted from the child
/// that faulted onwards:
///
/// ```ernest
/// spawn(Supervisor.group(Supervisor.RestForOne, RestartLimit(restarts = 3, within = 5000)))
/// ```
export type Strategy = OneForOne | OneForAll | RestForOne

// A child tells its supervisor when it joins, when it faults, and when it
// has restarted as it was asked, which is what a faulted sibling waits
// for. It tells of its fault through the watcher, which a restart of the
// supervisor in place does not end, so that the child waits on through
// that restart. The supervisor does not subscribe to `Process.faults`,
// which delivers every fault of the runtime where a supervisor needs its
// own children's. It takes its children's joins, their faults as the
// watcher passes them on, their restarts, and the ends of the alarms it
// sets itself.

/// What a supervisor takes. Its constructors are hidden; only this module makes
/// them.
///
/// ### Examples
///
/// ```ernest
/// {
///     let supervisor : Address(Supervisor.Msg) =
///         spawn(Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     kill(supervisor)
/// }
/// // => Unit
/// ```
export abstract type Msg =
    Join(process : Process, stop : () -> Unit with WatcherMsg, reply : Reply(Address(WatcherMsg)))
  | Faulted(process : Process, reply : Reply(Bool))
  | Expired
  | Settled(Process)

// What the watcher takes: a child to watch, the children in the order they
// were spawned, a run of the supervisor, answered whether this process runs
// the group, the children that waited going on, a child's fault to pass
// on to the supervisor's run, a child that ended, the supervisor's end,
// and a child that waits for the last or for its restart.
type WatcherMsg =
    Add(Member)
  | Children(reply : Reply(List(Process)))
  | Run(supervisor : Address(Msg), reply : Reply(Bool))
  | Release
  | Report(process : Process, reply : Reply(Bool))
  | Gone(Process)
  | SupervisorDied
  | Hold(reply : Reply(Unit))

// A child as the watcher holds it: its process, where it stands in the
// order of spawns, and how to kill it, which needs its address.
type Member = Member(process : Process, spawned : Int, stop : () -> Unit with WatcherMsg)

// Why a child's function began: the first time, after a fault, or because
// its supervisor asked.
type Start = First | AfterFault | Asked

// A group as its supervisor holds it: its strategy, its limit and its watcher.
type Group = Group(strategy : Strategy, limit : RestartLimit, watcher : Address(WatcherMsg))

// How long a call to the watcher or the supervisor waits before it is made
// again. A callee that ends or restarts answers `None` at once (report
// §6.6), so the limit bounds only one that lives and has not answered,
// which both do at once; its value changes nothing but how soon such a
// call is made again.
let retryMs = 1000

/// The function a supervisor runs, for the caller to spawn:
/// `spawn(Supervisor.group(strategy, limit))`. The children's faults are
/// counted against `limit` as `restarting` counts a process's (report §6.9).
///
/// Spawn the function `group` answers once. A second process that runs the same
/// function faults, even after the first has ended; a second group is a second
/// call of `group`. The call also spawns a process that keeps the group's
/// children and kills them when the supervisor dies. A restart of the
/// supervisor does not end it, and `Process.live` lists it.
///
/// A supervisor that is itself a child restarts in place, and asks each of its
/// children to restart; they keep their order.
///
/// ### Errors
///
/// Faults where the children's faults pass `limit`, with the cause `supervisor
/// restart limit reached`, and in a second process that runs it, with the cause
/// `a group runs in one process`.
///
/// ### Examples
///
/// ```ernest
/// spawn(Supervisor.group(Supervisor.OneForAll, RestartLimit(restarts = 5, within = 10000)))
/// ```
export fn group(strategy : Strategy, limit : RestartLimit) : (() -> Unit with Msg) with m = {
    // the watcher outlives a restart in place, which empties the
    // supervisor's mailbox, so each run finds it here (report §6.9)
    let watcher = spawn(watch);
    fn() = {
        if runs(watcher, self()) then Unit else fault("a group runs in one process");
        // a supervisor restarted in place restarts its subtree with it; the
        // children that waited on its last run go on once each is asked,
        // so that one runs `f` once
        match startCause() {
            First -> Unit
          | _ -> {
                List.foreach(children(watcher), fn(process) = {
                    let _ = askRestart(process);
                    Unit
                });
                send(watcher, Release)
            }
        };
        supervise(Group(strategy = strategy, limit = limit, watcher = watcher), 0, [])
    }
}

// Whether this process runs the group. The watcher answers at once, so a
// call it has not answered is made again while it lives; one that has
// ended ended with the group's first supervisor.
fn runs(watcher : Address(WatcherMsg), supervisor : Address(Msg)) : Bool with Msg =
    match Address.call(watcher, fn(reply) = Run(supervisor = supervisor, reply = reply), retryMs) {
        Some(runsGroup) -> runsGroup
      | None -> match Process.info(Process.fromAddress(watcher)) {
            None -> false
          | Some(_) -> runs(watcher, supervisor)
        }
    }

// The supervisor's loop. `recent` counts the faults within the limit's
// window. Each one expires by an alarm, so no clock is read; a restart in
// place cancels the run's alarms (report §6.9), so each that comes is this
// run's. `waiting` holds the children that faulted and wait to run again,
// each with the siblings its fault restarts that have not yet restarted or
// ended. A child waits for its fault's answer before it runs again, so
// each fault is counted before the next can come; `Unlimited` counts none
// (§6.9). The fault the group gives up at is answered before the
// supervisor faults, so that the child waits with the watcher for the
// group's end or its restart in place, rather than fault of the
// supervisor's end.
fn supervise(group : Group,
             recent : Int,
             waiting : List(#(Reply(Bool), List(Process)))) : Unit with Msg =
    receive {
        Join(process = process, stop = stop, reply = reply) -> {
            send(group.watcher,
                 Add(Member(process = process, spawned = spawnOrder(process), stop = stop)));
            answer(reply, group.watcher);
            supervise(group, recent, waiting)
        }
      // a child that faults has restarted as its faulted siblings wait for
      // it to, whether or not it had taken the restart they asked of it
      | Faulted(process = process, reply = reply) -> {
            let left = settled(waiting, process);
            match group.limit {
                Unlimited -> restartSiblings(group, process, reply, recent, left)
              | RestartLimit(restarts = restarts, within = within) -> if recent < restarts then {
                    Clock.alarm(Int.max(within, 1), fn(_) = Expired);
                    restartSiblings(group, process, reply, recent + 1, left)
                } else {
                    answer(reply, true);
                    fault("supervisor restart limit reached")
                }
            }
        }
      | Expired -> supervise(group, recent - 1, waiting)
      | Settled(child) -> supervise(group, recent, settled(waiting, child))
    }

// Appendix E.22: a child's fault that the group restarts. The siblings its
// strategy names are asked to restart, and the child runs again once each
// of them it could ask has restarted or ended, so that a call to it after
// its fault is answered by the group restarted whole. A sibling that has
// not yet begun its first run is not asked, and not waited for.
fn restartSiblings(group : Group,
                   faulted : Process,
                   reply : Reply(Bool),
                   recent : Int,
                   waiting : List(#(Reply(Bool), List(Process)))) : Unit with Msg = {
    let asked = List.filter(siblings(group.strategy, faulted, group.watcher), askRestart);
    if List.isEmpty(asked) then {
        answer(reply, false);
        supervise(group, recent, waiting)
    } else
        supervise(group, recent, #(reply, asked) :: waiting)
}

fn siblings(strategy : Strategy,
            faulted : Process,
            watcher : Address(WatcherMsg)) : List(Process) with Msg =
    match strategy {
        OneForOne -> []
      | OneForAll -> List.filter(children(watcher), fn(child) = child != faulted)
      | RestForOne -> spawnedAfter(children(watcher), faulted)
    }

// The children that wait with `child` no longer among the siblings they wait
// for; one that waits for none now runs again.
fn settled(waiting : List(#(Reply(Bool), List(Process))),
           child : Process) : List(#(Reply(Bool), List(Process))) with Msg =
    List.filterMap(waiting, fn(#(reply, asked)) = {
        let left = List.filter(asked, fn(sibling) = sibling != child);
        if List.isEmpty(left) then {
            answer(reply, false);
            None
        } else
            Some(#(reply, left))
    })

// The children spawned after `child`, which the watcher holds in that order.
fn spawnedAfter(children : List(Process), child : Process) : List(Process) =
    match children {
        [] -> []
      | head :: rest -> if head == child then rest else spawnedAfter(rest, child)
    }

fn children(watcher : Address(WatcherMsg)) : List(Process) with Msg =
    Address.callForever(watcher, fn(reply) = Children(reply = reply))

// Report §6.9: the child restarts at its next wait, and the answer says
// whether it was asked; one that has ended, or has not yet begun to run
// what restarts, is not.
foreign fn askRestart(child : Process) : Bool with m =
    "ern_rt:ask_restart/1"

// Report §8.7: whether a process runs on the caller's node; a supervisor
// and its children run on one.
foreign fn isOnThisNode(process : Process) : Bool with m =
    "ern_rt:on_this_node/1"

// Where a process stands in the order the runtime spawned its processes,
// which `RestForOne` reads and the watcher keeps its children in.
foreign fn spawnOrder(process : Process) : Int with m =
    "ern_rt:spawn_order/1"

// The watcher: it holds the children in the order they were spawned,
// passes a child's fault on to the supervisor's run, forgets one that ends
// and tells the supervisor, which may be waiting for it to restart, and
// when the supervisor dies kills them, the last first. The supervisor's
// first run makes itself known.
fn watch() : Unit with WatcherMsg =
    receive {
        Run(supervisor = supervisor, reply = reply) -> {
            monitor(Process.fromAddress(supervisor), fn(_) = SupervisorDied);
            answer(reply, true);
            watching(supervisor, [], [])
        }
    }

// The watcher's loop: the members in the order they were spawned, and the
// replies of the children that wait, which it holds until the supervisor's
// next run or its end.
fn watching(supervisor : Address(Msg),
            members : List(Member),
            held : List(Reply(Unit))) : Unit with WatcherMsg =
    receive {
        Add(member) -> if List.any(members, fn(known) = known.process == member.process) then
            watching(supervisor, members, held)
        else {
            monitor(member.process, fn(_) = Gone(member.process));
            watching(supervisor, inOrder(members, member), held)
        }
      | Children(reply = reply) -> {
            answer(reply, List.map(members, fn(member) = member.process));
            watching(supervisor, members, held)
        }
      | Run(supervisor = other, reply = reply) -> {
            answer(reply, Process.fromAddress(other) == Process.fromAddress(supervisor));
            watching(supervisor, members, held)
        }
      | Release -> {
            release(held);
            watching(supervisor, members, [])
        }
      // the child's reply goes with it, and the supervisor answers it; a
      // restart of the supervisor in place loses the fault and leaves the
      // child's call waiting here, where the new run's ask restarts it
      | Report(process = process, reply = reply) -> {
            send(supervisor, Faulted(process = process, reply = reply));
            watching(supervisor, members, held)
        }
      | Gone(process) -> {
            send(supervisor, Settled(process));
            watching(supervisor, List.filter(members, fn(member) = member.process != process), held)
        }
      | Hold(reply = reply) -> watching(supervisor, members, reply :: held)
      | SupervisorDied -> {
            stopAll(List.reverse(members));
            release(held)
        }
    }

// The children that waited go on: to the restart their supervisor asked of
// them, or to the end its watcher has already given them.
fn release(held : List(Reply(Unit))) : Unit with WatcherMsg =
    List.foreach(held, fn(reply) = answer(reply, Unit))

// The members with a new one among them, in the order they were spawned.
fn inOrder(members : List(Member), member : Member) : List(Member) =
    match members {
        [] -> [member]
      | head :: rest -> if member.spawned < head.spawned then
            member :: members
        else
            head :: inOrder(rest, member)
    }

fn stopAll(members : List(Member)) : Unit with WatcherMsg =
    match members {
        [] -> Unit
      | Member(process = process, spawned = _, stop = stop) :: rest -> {
            stop();
            receive {
                Gone(gone) when gone == process -> Unit
            };
            stopAll(rest)
        }
    }

/// The function a child runs, for the caller to spawn:
/// `spawn(Supervisor.child(supervisor, f))`. It joins `supervisor`'s group,
/// waiting until the supervisor has it, then runs `f`. After a fault it runs
/// `f` again in place, until the group gives up. A child that returns or is
/// killed leaves the group.
///
/// ### Errors
///
/// Faults where `supervisor` has ended before the child joins, with the cause
/// `the supervisor has ended`, and where `supervisor` runs on another node,
/// with the cause `a child runs on its supervisor's node`, before it joins.
///
/// ### Examples
///
/// ```ernest
/// {
///     let supervisor =
///         spawn(Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     spawn(Supervisor.child(supervisor, fn() : Unit with Int = receive {
///         _ -> Unit
///     }))
/// }
/// ```
export fn child(supervisor : Address(Msg), f : () -> Unit with m) : () -> Unit with m =
    fn() = {
        if isOnThisNode(Process.fromAddress(supervisor)) then
            Unit
        else
            fault("a child runs on its supervisor's node");
        let address = self();
        let process = Process.fromAddress(address);
        let watcher = join(supervisor, process, fn() = kill(address));
        // the group's limit decides when a child stops, so its own is none
        restarting(Unlimited, fn() = match startCause() {
            First -> f()
          | AfterFault -> runAgain(supervisor, watcher, process, f)
          | Asked -> {
                // the child that faulted waits for this one (Appendix E.22)
                send(supervisor, Settled(process));
                f()
            }
        })()
    }

// After a fault, the child runs again once its supervisor has counted the
// fault, which it tells through the watcher. Where the group gives up at
// it, the child waits with the watcher: the group's end kills it there, and
// a restart in place asks it to restart. A child whose supervisor has
// ended is killed as the others are.
fn runAgain(supervisor : Address(Msg),
            watcher : Address(WatcherMsg),
            process : Process,
            f : () -> Unit with m) : Unit with m =
    match Process.info(Process.fromAddress(supervisor)) {
        None -> kill(self())
      | Some(_) -> {
            if Address.callForever(watcher,
                                   fn(reply) = Report(process = process, reply = reply)) then
                Address.callForever(watcher, fn(reply) = Hold(reply = reply))
            else
                Unit;
            f()
        }
    }

// The child joins, and waits until the supervisor has it, which answers
// with the group's watcher. A call that ends unanswered was made as the
// supervisor restarted, and is made again; one made twice is joined once,
// since the watcher keeps a child once.
fn join(supervisor : Address(Msg),
        process : Process,
        stop : () -> Unit with WatcherMsg) : Address(WatcherMsg) with m = {
    let request = fn(reply) = Join(process = process, stop = stop, reply = reply);
    match Address.call(supervisor, request, retryMs) {
        Some(watcher) -> watcher
      | None -> match Process.info(Process.fromAddress(supervisor)) {
            None -> fault("the supervisor has ended")
          | Some(_) -> join(supervisor, process, stop)
        }
    }
}

// Why the restarting function the caller runs in began.
foreign fn startCause() : Start with m =
    "ern_rt:start_cause/0"
