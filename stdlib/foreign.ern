/// Operations on `Term`, any value of the runtime, which a `foreign fn`
/// gives back where its result has no Ernest type (report §3.8, §8.4).
/// These functions ask what a term is, each answering `None` when it is
/// something else. `from` goes the other way: it gives a value as foreign
/// code is given an argument of the value's type.
///
/// ## Examples
///
/// ```ernest
/// #(Foreign.toInt(Foreign.from(42)), Foreign.toInt(Foreign.from("42")))
/// // => #(Some(42), None)
/// ```
///
/// ```ernest
/// let terms = Foreign.toList(Foreign.from([1, 2]));
/// Optional.map(terms, fn(list) = List.filterMap(list, Foreign.toInt))
/// // => Some([1, 2])
/// ```
///
/// ## See also
///
/// `Erl` for what a shim over an Erlang API needs, `String.toInt` for text.
///
/// since 0.1.0

/// Any value of the runtime, which the language does not inspect. It is a
/// foreign type, so its `==` is the runtime's exact equality (report
/// §3.10).
///
/// ### Examples
///
/// ```ernest
/// #(Foreign.from(1) == Foreign.from(1), Foreign.from(1) == Foreign.from(1.0))
/// // => #(true, false)
/// ```
///
/// since 0.2.0
export foreign type Term

/// The value as it crosses into foreign code, which a `foreign fn` may
/// take where it declares `Term`. It crosses as an argument of its type
/// does: an address in it behind the check of what foreign code sends it,
/// and a function with the check of what foreign code calls it with (report
/// §8.4). The type is the one `from` is used at, and is known whole there;
/// on a type variable `from` is a type error.
export foreign fn from(value : a) : Term =
    "ern_foreign:from/1"

/// The `Int` it is, or `None`.
export foreign fn toInt(value : Term) : Optional(Int) =
    "ern_foreign:to_int/1"

/// The `Float` it is, or `None`.
///
/// ### Examples
///
/// ```ernest
/// Foreign.toFloat(Foreign.from(1.5))
/// // => Some(1.5)
/// ```
export foreign fn toFloat(value : Term) : Optional(Float) =
    "ern_foreign:to_float/1"

/// The `String` it is, or `None`; a binary that is not UTF-8 is `None`.
///
/// ### Examples
///
/// ```ernest
/// Foreign.toString(Foreign.from("hi"))
/// // => Some("hi")
/// ```
export foreign fn toString(value : Term) : Optional(String) =
    "ern_foreign:to_string/1"

/// The `Bytes` it is, or `None`: any binary, UTF-8 or not, a `String`
/// among them.
///
/// ### Examples
///
/// ```ernest
/// #(Foreign.toBytes(Foreign.from(<<255>>)), Foreign.toBytes(Foreign.from(1)))
/// // => #(Some(<<255>>), None)
/// ```
///
/// since 0.2.0
export foreign fn toBytes(value : Term) : Optional(Bytes) =
    "ern_foreign:to_bytes/1"

/// The `Bool` it is, or `None`.
///
/// ### Examples
///
/// ```ernest
/// #(Foreign.toBool(Foreign.from(true)), Foreign.toBool(Erl.atom("ready")))
/// // => #(Some(true), None)
/// ```
export foreign fn toBool(value : Term) : Optional(Bool) =
    "ern_foreign:to_bool/1"

/// The list it is, its elements still terms, or `None`.
export foreign fn toList(value : Term) : Optional(List(Term)) =
    "ern_foreign:to_list/1"
