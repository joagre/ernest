/// Operations on a value that may be absent, `Optional(a)`: `Some(a)` or
/// `None`.
///
/// A function that may find nothing answers an `Optional`: `List.get` past the
/// end of a list, or `Map.get` for a key the map does not hold. Where the
/// absence has a cause the caller should know, an `Either` says it instead.
///
/// A `match` takes an `Optional` apart. In a block, `let x <- e` unwraps a
/// `Some` and goes on, and ends the block with `None` where `e` is `None`
/// (report §5.5).
///
/// ## Examples
///
/// ```ernest
/// Optional.map(Some(2), fn(n) = n * 10)
/// // => Some(20)
/// ```
///
/// ```ernest
/// Optional.andThen(Some(4), fn(n) = if n > 0 then Some(n - 1) else None)
/// // => Some(3)
/// ```
///
/// ```ernest
/// Optional.withDefault(None, 0)
/// // => 0
/// ```
///
/// ## See also
///
/// `Either`, when the absence has a cause.
///
/// since 0.1.0

/// `true` for a `Some`.
///
/// ### Examples
///
/// ```ernest
/// Optional.isSome(Some(1))
/// // => true
/// ```
export fn isSome(optional : Optional(a)) : Bool =
    match optional {
        Some(_) -> true
      | None -> false
    }

/// `true` for `None`.
///
/// ### Examples
///
/// ```ernest
/// Optional.isNone(Some(1))
/// // => false
/// ```
export fn isNone(optional : Optional(a)) : Bool =
    match optional {
        Some(_) -> false
      | None -> true
    }

/// The value in a `Some`, or `default` for `None`.
export fn withDefault(optional : Optional(a), default : a) : a =
    match optional {
        Some(value) -> value
      | None -> default
    }

/// `Some(f(x))` for `Some(x)`, or `None` for `None`, where `f` is not called.
export fn map(optional : Optional(a), f : (a) -> b with e) : Optional(b) with e =
    match optional {
        Some(value) -> Some(f(value))
      | None -> None
    }

/// `f(x)` for `Some(x)`, or `None` for `None`, where `f` is not called. It
/// chains steps each of which may find nothing, as `<-` does in a block.
export fn andThen(optional : Optional(a), f : (a) -> Optional(b) with e) : Optional(b) with e =
    match optional {
        Some(value) -> f(value)
      | None -> None
    }
