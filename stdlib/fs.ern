/// The file system through its system process, which reaches it
/// (report §8.2). Every function answers `Right` with what it read or did,
/// or `Left` with an `Io.Error`; the last argument is how many milliseconds
/// to wait, and a slower answer than that is `Left(Io.Timeout)`, which does
/// not undo the request: a write, a rename or a removal may still take
/// place. A path is a `Path`, which `Path` builds and takes apart; a
/// relative one names a file under `Os.workingDirectory`, and one that
/// holds U+0000 names none, `Left(Io.Invalid)`. A name that is not UTF-8
/// makes `list` answer `Left(Io.NotUtf8(name))`. `Io.Other` holds the host's
/// description of a reason it has no constructor for, `"illegal operation
/// on a directory"` or `"not a directory"` (report Appendix E.1).
///
/// ## Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("greeting.txt"), String.toUtf8("hello"), 5000);
///     Either.map(Fs.read(Path("greeting.txt"), 5000), String.fromUtf8)
/// }
/// // => Right(Some("hello"))
/// ```
///
/// ```ernest
/// Fs.read(Path("no-such-file"), 5000)
/// // => Left(NotFound)
/// ```
///
/// ## See also
///
/// `Path` for building and reading a path, `Bytes` and `String.toUtf8` for
/// what a file holds.
///
/// since 0.1.0

/// What a path names: a regular file, a directory, a symbolic link, or
/// something else, a named pipe, a device, or a socket (report Appendix
/// E.17).
///
/// ### Examples
///
/// ```ernest
/// Either.map(Fs.stat(Path("."), 5000), fn(e) = e.kind == Fs.Directory)
/// // => Right(true)
/// ```
export type Kind = File | Directory | Link | Other

/// What `Fs.stat` and `Fs.list` tell of a file: its path, its modification
/// time in milliseconds since the epoch, as `Clock.now`, read to the second
/// and so a multiple of 1000, its size in bytes, and its kind (report
/// Appendix E.17).
///
/// ### Examples
///
/// ```ernest
/// Fs.Entry(path = Path("a.txt"), mtime = 0, size = 5, kind = Fs.File)
/// ```
export type Entry = Entry(path : Path, mtime : Int, size : Int, kind : Kind)

// What the file system takes.
type Msg =
    Read(path : Path, reply : Reply(Either(Io.Error, Bytes)))
  | ReadRange(path : Path, offset : Int, count : Int, reply : Reply(Either(Io.Error, Bytes)))
  | Write(path : Path, bytes : Bytes, reply : Reply(Either(Io.Error, Unit)))
  | Append(path : Path, bytes : Bytes, reply : Reply(Either(Io.Error, Unit)))
  | List(path : Path, reply : Reply(Either(Io.Error, List(Entry))))
  | Stat(path : Path, reply : Reply(Either(Io.Error, Entry)))
  | MakeDir(path : Path, reply : Reply(Either(Io.Error, Unit)))
  | Remove(path : Path, reply : Reply(Either(Io.Error, Unit)))
  | RemoveAll(path : Path, reply : Reply(Either(Io.Error, Unit)))
  | Rename(source : Path, destination : Path, reply : Reply(Either(Io.Error, Unit)))
  | Copy(source : Path, destination : Path, reply : Reply(Either(Io.Error, Unit)))
  | MakeLink(path : Path, target : Path, reply : Reply(Either(Io.Error, Unit)))
  | MakeHardLink(path : Path, target : Path, reply : Reply(Either(Io.Error, Unit)))
  | ReadLink(path : Path, reply : Reply(Either(Io.Error, Optional(Path))))
  | MakeFile(path : Path, bytes : Bytes, reply : Reply(Either(Io.Error, Unit)))
  | SetModified(path : Path, mtime : Int, reply : Reply(Either(Io.Error, Unit)))
  | SetMode(path : Path, mode : Int, reply : Reply(Either(Io.Error, Unit)))

// Report §8.2: the system reference, the runtime's address of the file system,
// bound at each start.
let reference : Address(Msg) = system(Erl.atom("fs"))

foreign fn system(name : Foreign.Term) : Address(Msg) with m =
    "ern_rt:system_process/1"

/// The file's octets.
export fn read(path : Path, ms : Int) : Either(Io.Error, Bytes) with m =
    answered(Address.call(reference, fn(reply) = Read(path = path, reply = reply), ms))

/// Up to `count` octets of the file from `offset`, fewer at its end and
/// none past it, the rest of the file never held: how a file too large to
/// hold whole is read, a part at a time. An offset or a count below 0 is
/// none (report §7.4).
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("alphabet.txt"), String.toUtf8("abcdef"), 5000);
///     #(Fs.readRange(Path("alphabet.txt"), 1, 3, 5000),
///       Fs.readRange(Path("alphabet.txt"), 4, 9, 5000))
/// }
/// // => #(Right(<<98, 99, 100>>), Right(<<101, 102>>))
/// ```
export fn readRange(path : Path,
                    offset : Int,
                    count : Int,
                    ms : Int) : Either(Io.Error, Bytes) with m = {
    let request = fn(reply) = ReadRange(path = path, offset = offset, count = count, reply = reply);
    answered(Address.call(reference, request, ms))
}

/// Writes the octets, creating the file or replacing what it held.
export fn write(path : Path, bytes : Bytes, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference,
                          fn(reply) = Write(path = path, bytes = bytes, reply = reply),
                          ms))

/// Writes the octets after what the file holds, creating it when it is not
/// there.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("log.txt"), String.toUtf8("a"), 5000);
///     let _ = Fs.append(Path("log.txt"), String.toUtf8("b"), 5000);
///     Either.map(Fs.read(Path("log.txt"), 5000), String.fromUtf8)
/// }
/// // => Right(Some("ab"))
/// ```
export fn append(path : Path, bytes : Bytes, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference,
                          fn(reply) = Append(path = path, bytes = bytes, reply = reply),
                          ms))

/// The entries of the directory, in unspecified order, each path the
/// directory's joined with the entry's name, and each described as it is:
/// a link is a `Link`, whatever it leads to.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.makeDir(Path("shelf"), 5000);
///     let _ = Fs.write(Path("shelf/one.txt"), <<>>, 5000);
///     Either.map(Fs.list(Path("shelf"), 5000),
///                fn(es) = List.filterMap(es, fn(e) = Path.name(e.path)))
/// }
/// // => Right(["one.txt"])
/// ```
///
/// ```ernest
/// {
///     let _ = Fs.makeDir(Path("kinds"), 5000);
///     let _ = Fs.makeLink(Path("kinds/link"), Path("elsewhere"), 5000);
///     Either.map(Fs.list(Path("kinds"), 5000), fn(es) = List.map(es, fn(e) = e.kind))
/// }
/// // => Right([Link])
/// ```
export fn list(path : Path, ms : Int) : Either(Io.Error, List(Entry)) with m =
    answered(Address.call(reference, fn(reply) = List(path = path, reply = reply), ms))

/// What the path leads to, its links followed: its size, its modification
/// time, and its kind.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("three.txt"), String.toUtf8("abc"), 5000);
///     Either.map(Fs.stat(Path("three.txt"), 5000), fn(e) = e.size)
/// }
/// // => Right(3)
/// ```
export fn stat(path : Path, ms : Int) : Either(Io.Error, Entry) with m =
    answered(Address.call(reference, fn(reply) = Stat(path = path, reply = reply), ms))

/// Makes the directory and any parent it needs; a directory already there
/// is not an error.
export fn makeDir(path : Path, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference, fn(reply) = MakeDir(path = path, reply = reply), ms))

/// Removes a file, a link, or an empty directory; a link is removed, not
/// what it leads to.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("gone.txt"), <<>>, 5000);
///     let _ = Fs.remove(Path("gone.txt"), 5000);
///     Fs.read(Path("gone.txt"), 5000)
/// }
/// // => Left(NotFound)
/// ```
export fn remove(path : Path, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference, fn(reply) = Remove(path = path, reply = reply), ms))

/// Renames the first path to the second.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("before.txt"), String.toUtf8("x"), 5000);
///     let _ = Fs.rename(Path("before.txt"), Path("after.txt"), 5000);
///     Either.map(Fs.read(Path("after.txt"), 5000), String.fromUtf8)
/// }
/// // => Right(Some("x"))
/// ```
export fn rename(source : Path, destination : Path, ms : Int) : Either(Io.Error, Unit) with m = {
    let request = fn(reply) = Rename(source = source, destination = destination, reply = reply);
    answered(Address.call(reference, request, ms))
}

/// Copies the file at the first path to the second, replacing what is
/// there.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("source.txt"), String.toUtf8("y"), 5000);
///     let _ = Fs.copy(Path("source.txt"), Path("copy.txt"), 5000);
///     Either.map(Fs.read(Path("copy.txt"), 5000), String.fromUtf8)
/// }
/// // => Right(Some("y"))
/// ```
export fn copy(source : Path, destination : Path, ms : Int) : Either(Io.Error, Unit) with m = {
    let request = fn(reply) = Copy(source = source, destination = destination, reply = reply);
    answered(Address.call(reference, request, ms))
}

/// Makes a symbolic link at the first path that leads to the second, which
/// is kept as it is written and may name nothing. A first path that names
/// something is `Left(Exists)`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("target.txt"), String.toUtf8("t"), 5000);
///     let _ = Fs.makeLink(Path("pointer"), Path("target.txt"), 5000);
///     Either.map(Fs.read(Path("pointer"), 5000), String.fromUtf8)
/// }
/// // => Right(Some("t"))
/// ```
export fn makeLink(path : Path, target : Path, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference,
                          fn(reply) = MakeLink(path = path, target = target, reply = reply),
                          ms))

/// Makes a hard link at the first path to the regular file the second
/// names: a second name for the file, which outlives the first. A first
/// path that names something is `Left(Exists)`, and a second that names
/// anything but a regular file, a link among them, is `Left(NotAFile)`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("original.txt"), String.toUtf8("o"), 5000);
///     let _ = Fs.makeHardLink(Path("twin.txt"), Path("original.txt"), 5000);
///     let _ = Fs.remove(Path("original.txt"), 5000);
///     Either.map(Fs.read(Path("twin.txt"), 5000), String.fromUtf8)
/// }
/// // => Right(Some("o"))
/// ```
///
/// since 0.2.0
export fn makeHardLink(path : Path, target : Path, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference,
                          fn(reply) = MakeHardLink(path = path, target = target, reply = reply),
                          ms))

/// The path a symbolic link holds, as it was written, or `None` where the
/// path names something that is not a link. A link whose target is not
/// UTF-8 is `Left(NotUtf8(target))`, the target's bytes.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.makeLink(Path("sign"), Path("somewhere"), 5000);
///     let _ = Fs.write(Path("plain.txt"), <<>>, 5000);
///     #(Fs.readLink(Path("sign"), 5000), Fs.readLink(Path("plain.txt"), 5000))
/// }
/// // => #(Right(Some(Path("somewhere"))), Right(None))
/// ```
export fn readLink(path : Path, ms : Int) : Either(Io.Error, Optional(Path)) with m =
    answered(Address.call(reference, fn(reply) = ReadLink(path = path, reply = reply), ms))

/// Writes a new file, or none where the path names something already,
/// which is `Left(Exists)`: the one way to claim a name, as a lock
/// file or a temporary file needs.
///
/// ### Examples
///
/// ```ernest
/// {
///     let first = Fs.makeFile(Path("claimed.txt"), String.toUtf8("mine"), 5000);
///     let second = Fs.makeFile(Path("claimed.txt"), String.toUtf8("yours"), 5000);
///     #(first, second)
/// }
/// // => #(Right(Unit), Left(Exists))
/// ```
export fn makeFile(path : Path, bytes : Bytes, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference,
                          fn(reply) = MakeFile(path = path, bytes = bytes, reply = reply),
                          ms))

/// Removes a directory and everything under it, or a file or a link. A link
/// is removed and not followed, wherever it stands, so what it leads to is
/// left, even where another process puts it in a directory's place while
/// the removal runs. It waits the milliseconds given once, for the whole
/// removal, and faults its caller where the runtime's helper fails, as
/// `Os.start` does.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.makeDir(Path("tree/branch"), 5000);
///     let _ = Fs.write(Path("tree/branch/leaf.txt"), <<>>, 5000);
///     let _ = Fs.removeAll(Path("tree"), 5000);
///     Either.isLeft(Fs.stat(Path("tree"), 5000))
/// }
/// // => true
/// ```
export fn removeAll(path : Path, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference, fn(reply) = RemoveAll(path = path, reply = reply), ms))

/// Sets the modification time, in milliseconds since the epoch as
/// `Clock.now` gives it, kept to the second as the file system keeps it.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.write(Path("dated.txt"), <<>>, 5000);
///     let _ = Fs.setModified(Path("dated.txt"), 86400000, 5000);
///     Either.map(Fs.stat(Path("dated.txt"), 5000), fn(e) = e.mtime)
/// }
/// // => Right(86400000)
/// ```
export fn setModified(path : Path, mtime : Int, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference,
                          fn(reply) = SetModified(path = path, mtime = mtime, reply = reply),
                          ms))

/// Sets the permission bits of a file or a directory to the mode, as the
/// host writes them: `0o600` is its owner's alone to read and write, and a
/// directory made `0o700` before a file is written in it keeps the file
/// from others as it is written. A mode outside 0 to `0o7777` is
/// `Left(Invalid)`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Fs.makeDir(Path("own"), 5000);
///     Fs.setMode(Path("own"), 0o700, 5000)
/// }
/// // => Right(Unit)
/// ```
///
/// since 0.2.0
export fn setMode(path : Path, mode : Int, ms : Int) : Either(Io.Error, Unit) with m =
    answered(Address.call(reference,
                          fn(reply) = SetMode(path = path, mode = mode, reply = reply),
                          ms))

fn answered(answer : Optional(Either(Io.Error, a))) : Either(Io.Error, a) =
    Optional.withDefault(answer, Left(Io.Timeout))
