/// Operations on `Map(k=, v)`, a finite map from keys to values (report
/// §9.2). The key type needs equality, which the type itself requires
/// (report §3.10), so a key holding a function or an address is a type
/// error. The order of `keys`, `values`, `toList`, `foldLeft`, `foreach`,
/// and `find` is unspecified, and so is the order in which `map`,
/// `filter`, `filterMap`, `any`, `all`, and `mergeWith` meet the entries.
/// The primitives are `empty`, `size`, `get`, `put`, `remove`, and
/// `toList`, the runtime's; the rest is written over them (report Appendix
/// E.0 rule 1).
///
/// ## Examples
///
/// ```ernest
/// Map.get(Map.put(Map.empty, "a", 1), "a")
/// // => Some(1)
/// ```
///
/// ```ernest
/// Map.toList(Map.map(Map.fromList([#("a", 1)]), fn(_, n) = n * 10))
/// // => [#("a", 10)]
/// ```
///
/// ## See also
///
/// `Set` for elements without values, `List` for order and position.
///
/// since 0.1.0

/// The map with no entries.
export let empty : Map(k, v) = emptyMap()

foreign fn emptyMap() : Map(k, v) =
    "ern_map:empty/0"

/// The number of entries.
///
/// ### Examples
///
/// ```ernest
/// #(Map.size(Map.fromList([#("a", 1)])), Map.isEmpty(Map.empty))
/// // => #(1, true)
/// ```
export foreign fn size(map : Map(k, v)) : Int =
    "ern_map:size/1"

/// `true` for the map with no entries.
export fn isEmpty(map : Map(k, v)) : Bool =
    size(map) == 0

/// `true` when the map has an entry with that key.
///
/// ### Examples
///
/// ```ernest
/// #(Map.contains(Map.fromList([#("a", 1)]), "a"), Map.contains(Map.empty, "a"))
/// // => #(true, false)
/// ```
export fn contains(map : Map(k, v), key : k) : Bool =
    match get(map, key) {
        Some(_) -> true
      | None -> false
    }

/// The value at that key.
export foreign fn get(map : Map(k, v), key : k) : Optional(v) =
    "ern_map:get/2"

/// The map with that entry, replacing any entry with the same key.
export foreign fn put(map : Map(k, v), key : k, value : v) : Map(k, v) =
    "ern_map:put/3"

/// The map without that key, which need not be present.
///
/// ### Examples
///
/// ```ernest
/// Map.toList(Map.remove(Map.fromList([#("a", 1)]), "a"))
/// // => []
/// ```
export foreign fn remove(map : Map(k, v), key : k) : Map(k, v) =
    "ern_map:remove/2"

/// The map with the entry at that key replaced by the function's value; the
/// function sees `None` when there is no entry.
///
/// ### Examples
///
/// ```ernest
/// Map.get(Map.update(Map.empty, "n", fn(o) = Optional.withDefault(o, 0) + 1), "n")
/// // => Some(1)
/// ```
export fn update(map : Map(k, v), key : k, f : (Optional(v)) -> v with e) : Map(k, v) with e =
    put(map, key, f(get(map, key)))

/// Each value replaced by the function's, the key beside it.
export fn map(map : Map(k, v), f : (k, v) -> w with e) : Map(k, w) with e =
    List.foldLeft(toList(map), empty, fn(acc, #(key, value)) = put(acc, key, f(key, value)))

/// The entries the predicate holds for.
///
/// ### Examples
///
/// ```ernest
/// Map.toList(Map.filter(Map.fromList([#("a", 1), #("b", 2)]), fn(_, n) = n > 1))
/// // => [#("b", 2)]
/// ```
export fn filter(map : Map(k, v), keep : (k, v) -> Bool with e) : Map(k, v) with e =
    List.foldLeft(toList(map),
                  map,
                  fn(acc, #(key, value)) = if keep(key, value) then acc else remove(acc, key))

/// The entries whose value the function answers `Some` for, that value in
/// their place.
///
/// ### Examples
///
/// ```ernest
/// Map.toList(Map.filterMap(Map.fromList([#("a", "1"), #("b", "x")]), fn(_, s) = String.toInt(s)))
/// // => [#("a", 1)]
/// ```
export fn filterMap(map : Map(k, v), f : (k, v) -> Optional(w) with e) : Map(k, w) with e =
    List.foldLeft(toList(map), empty, fn(acc, #(key, value)) = match f(key, value) {
        Some(mapped) -> put(acc, key, mapped)
      | None -> acc
    })

/// The accumulator after the function has seen each entry, the accumulator
/// first.
///
/// ### Examples
///
/// ```ernest
/// Map.foldLeft(Map.fromList([#("a", 1), #("b", 2)]), 0, fn(acc, key, n) = acc + n)
/// // => 3
/// ```
export fn foldLeft(map : Map(k, v), acc : b, step : (b, k, v) -> b with e) : b with e =
    List.foldLeft(toList(map), acc, fn(folded, #(key, value)) = step(folded, key, value))

/// The function applied to each entry for its effect.
///
/// ### Examples
///
/// ```ernest
/// Map.foreach(Map.fromList([#("a", 1)]), fn(key, _) = Io.println(key))
/// // => Unit
/// ```
export fn foreach(map : Map(k, v), f : (k, v) -> Unit with e) : Unit with e =
    List.foreach(toList(map), fn(#(key, value)) = f(key, value))

/// `true` when the predicate holds for some entry.
///
/// ### Examples
///
/// ```ernest
/// #(Map.any(Map.fromList([#("a", 1)]), fn(_, n) = n > 0),
///   Map.all(Map.fromList([#("a", 1)]), fn(_, n) = n > 1))
/// // => #(true, false)
/// ```
export fn any(map : Map(k, v), test : (k, v) -> Bool with e) : Bool with e =
    List.any(toList(map), fn(#(key, value)) = test(key, value))

/// `true` when the predicate holds for every entry, and for the map with no
/// entries.
export fn all(map : Map(k, v), test : (k, v) -> Bool with e) : Bool with e =
    List.all(toList(map), fn(#(key, value)) = test(key, value))

/// Some entry the predicate holds for.
///
/// ### Examples
///
/// ```ernest
/// Map.find(Map.fromList([#("a", 1)]), fn(_, n) = n == 1)
/// // => Some(#("a", 1))
/// ```
export fn find(map : Map(k, v), test : (k, v) -> Bool with e) : Optional(#(k, v)) with e =
    List.find(toList(map), fn(#(key, value)) = test(key, value))

/// The entries of both, the second winning a shared key.
///
/// ### Examples
///
/// ```ernest
/// Map.toList(Map.merge(Map.fromList([#("a", 1)]), Map.fromList([#("a", 2)])))
/// // => [#("a", 2)]
/// ```
export fn merge(map : Map(k, v), other : Map(k, v)) : Map(k, v) =
    List.foldLeft(toList(other), map, fn(acc, #(key, value)) = put(acc, key, value))

/// The entries of both, a shared key given the function of the key, the
/// first's value and the second's.
///
/// ### Examples
///
/// ```ernest
/// Map.toList(Map.mergeWith(Map.fromList([#("a", 1), #("b", 1)]),
///                          Map.fromList([#("a", 2), #("b", 2)]),
///                          fn(key, a, b) = if key == "a" then a + b else b))
/// // => [#("a", 3), #("b", 2)]
/// ```
export fn mergeWith(map : Map(k, v),
                    other : Map(k, v),
                    f : (k, v, v) -> v with e) : Map(k, v) with e =
    List.foldLeft(toList(other),
                  map,
                  fn(acc, #(key, value)) = update(acc, key, fn(mine) = match mine {
                      Some(existing) -> f(key, existing, value)
                    | None -> value
                  }))

/// The map of those pairs, a later pair winning its key.
export fn fromList(pairs : List(#(k, v))) : Map(k, v) =
    List.foldLeft(pairs, empty, fn(acc, #(key, value)) = put(acc, key, value))

/// The entries as pairs, in unspecified order.
export foreign fn toList(map : Map(k, v)) : List(#(k, v)) =
    "ern_map:to_list/1"

/// The keys, in unspecified order.
///
/// ### Examples
///
/// ```ernest
/// #(Map.keys(Map.fromList([#("a", 1)])), Map.values(Map.fromList([#("a", 1)])))
/// // => #(["a"], [1])
/// ```
export fn keys(map : Map(k, v)) : List(k) =
    List.map(toList(map), fn(#(key, _)) = key)

/// The values, in unspecified order.
export fn values(map : Map(k, v)) : List(v) =
    List.map(toList(map), fn(#(_, value)) = value)
