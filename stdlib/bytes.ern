/// Operations on `Bytes`, a sequence of octets (report §3.1). A `Bytes` is
/// not a container: its octets are reached through `toList`, each an `Int`
/// from 0 to 255, and `<<...>>` builds and matches one at the bit level
/// (report §5.11), so there is no constructor here. The primitives are
/// `size` and `slice`, the runtime's; the rest is written with the bit
/// syntax (report Appendix E.0 rule 1).
///
/// ## Examples
///
/// ```ernest
/// Bytes.toList(<<104, 105>> <> <<33>>)
/// // => [104, 105, 33]
/// ```
///
/// ```ernest
/// Bytes.fromList([104, 105])
/// // => Some(<<104, 105>>)
/// ```
///
/// ## See also
///
/// `String.toUtf8` and `String.fromUtf8` for text, `Int` for the octets.
///
/// since 0.1.0

/// The octets of the first, then those of the second.
export fn Bytes.<>(a : Bytes, b : Bytes) -> Bytes = a <> b

/// The number of octets.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.size(<<1, 2, 3>>), Bytes.isEmpty(<<>>))
/// // => #(3, true)
/// ```
export foreign fn size(b : Bytes) -> Int = "erlang:byte_size/1"

/// `true` for the empty `Bytes`.
export fn isEmpty(b : Bytes) -> Bool = size(b) == 0

/// The octet at the index, counting from 0, or `None` beyond either end.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.get(<<7, 8>>, 1), Bytes.get(<<7, 8>>, 2))
/// // => #(Some(8), None)
/// ```
export fn get(b : Bytes, i : Int) -> Optional(Int) =
    match slice(b, i, 1) {
        <<n>> when i >= 0 -> Some(n)
      | _ -> None
    }

/// The octets from the index, that many of them, clipped to what is there;
/// a negative index or count is 0.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.slice(<<1, 2, 3>>, 1, 5), Bytes.slice(<<1, 2, 3>>, -1, 2))
/// // => #(<<2, 3>>, <<1, 2>>)
/// ```
export fn slice(b : Bytes, from : Int, count : Int) -> Bytes = {
    let start = Int.max(from, 0);
    if count <= 0 || start >= size(b) then <<>>
    else part(b, start, Int.min(count, size(b) - start))
}

foreign fn part(b : Bytes, from : Int, count : Int) -> Bytes = "binary:part/3"

/// The octets, each from 0 to 255.
export fn toList(b : Bytes) -> List(Int) = List.reverse(octets(b, []))

// The octets before the rest of b, the last first.
fn octets(b : Bytes, done : List(Int)) -> List(Int) = match b {
    <<n, rest:bytes>> -> octets(rest, n :: done)
  | _ -> done
}

/// The `Bytes` of those octets, or `None` when one is outside 0 to 255.
///
/// ### Examples
///
/// ```ernest
/// Bytes.fromList([256])
/// // => None
/// ```
export fn fromList(octets : List(Int)) -> Optional(Bytes) =
    if List.all(octets, fn(n) = n >= 0 && n <= 255)
    then Some(List.foldLeft(octets, <<>>, fn(done, n) = <<done:bytes, n>>))
    else None
