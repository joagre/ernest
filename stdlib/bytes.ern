/// Operations on `Bytes`, a sequence of octets (report §3.1). A `Bytes` is
/// a container read through `toList`, which gives its octets, each an `Int`
/// from 0 to 255, and `<<...>>` builds and matches one at the bit level
/// (report §5.11), so there is no constructor here. The primitive is
/// `size`, the runtime's; the rest is written over it and with the bit
/// syntax (report Appendix E.0 rule 1).
///
/// ## Examples
///
/// ```ernest
/// Bytes.toList(<<104, 105>> <> <<33>>)
/// // => [104, 105, 33]
/// ```
///
/// ```ernest
/// Bytes.fromList([104, 105])
/// // => Some(<<104, 105>>)
/// ```
///
/// ## See also
///
/// `String.toUtf8` and `String.fromUtf8` for text, `Int` for the octets.
///
/// since 0.1.0

/// The octets of the first, then those of the second.
export fn Bytes.<>(left : Bytes, right : Bytes) : Bytes =
    left <> right

/// The number of octets.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.size(<<1, 2, 3>>), Bytes.isEmpty(<<>>))
/// // => #(3, true)
/// ```
export foreign fn size(bytes : Bytes) : Int =
    "erlang:byte_size/1"

/// `true` for the empty `Bytes`.
export fn isEmpty(bytes : Bytes) : Bool =
    size(bytes) == 0

/// The octet at the index, counting from 0, or `None` beyond either end.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.get(<<7, 8>>, 1), Bytes.get(<<7, 8>>, 2))
/// // => #(Some(8), None)
/// ```
export fn get(bytes : Bytes, index : Int) : Optional(Int) =
    match bytes {
        <<_:size(index)-bytes, octet, _:bytes>> -> Some(octet)
      | _ -> None
    }

/// The octets from the index, that many of them, clipped to what is there;
/// a negative index or count is 0.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.slice(<<1, 2, 3>>, 1, 5), Bytes.slice(<<1, 2, 3>>, -1, 2))
/// // => #(<<2, 3>>, <<1, 2>>)
/// ```
export fn slice(bytes : Bytes, index : Int, count : Int) : Bytes = {
    let clipped = Int.max(index, 0);
    let taken = Int.max(Int.min(count, size(bytes) - clipped), 0);
    match bytes {
        <<_:size(clipped)-bytes, sliced:size(taken)-bytes, _:bytes>> -> sliced
      | _ -> <<>>
    }
}

/// The octets, each from 0 to 255.
export fn toList(bytes : Bytes) : List(Int) =
    List.reverse(octets(bytes, []))

// The octets before the rest of `bytes`, the last first.
fn octets(bytes : Bytes, acc : List(Int)) : List(Int) =
    match bytes {
        <<octet, rest:bytes>> -> octets(rest, octet :: acc)
      | _ -> acc
    }

/// The `Bytes` of those octets, or `None` when one is outside 0 to 255.
///
/// ### Examples
///
/// ```ernest
/// Bytes.fromList([256])
/// // => None
/// ```
export fn fromList(octets : List(Int)) : Optional(Bytes) =
    if List.all(octets, fn(octet) = octet >= 0 && octet <= 255) then
        Some(List.foldLeft(octets, <<>>, fn(acc, octet) = <<acc:bytes, octet>>))
    else
        None

/// `true` when the second occurs in the first; an empty second always does.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.contains(<<1, 2, 3>>, <<2, 3>>), Bytes.contains(<<1, 2>>, <<3>>))
/// // => #(true, false)
/// ```
export fn contains(bytes : Bytes, part : Bytes) : Bool =
    indexOf(bytes, part) != None

/// Where the second begins in the first, the first place it does, and
/// `None` where it is not there. An empty second is at 0.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.indexOf(<<1, 2, 1, 2>>, <<1, 2>>), Bytes.indexOf(<<1>>, <<2>>))
/// // => #(Some(0), None)
/// ```
export fn indexOf(bytes : Bytes, part : Bytes) : Optional(Int) =
    indexFrom(bytes, part, 0)

// The first place from the index where the part begins.
fn indexFrom(bytes : Bytes, part : Bytes, index : Int) : Optional(Int) =
    if index + size(part) > size(bytes) then
        None
    else if slice(bytes, index, size(part)) == part then
        Some(index)
    else
        indexFrom(bytes, part, index + 1)

/// Where the second begins in the first, the last place it does, and
/// `None` where it is not there. An empty second is at the end.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.lastIndexOf(<<1, 2, 1, 2>>, <<1, 2>>), Bytes.lastIndexOf(<<1>>, <<2>>))
/// // => #(Some(2), None)
/// ```
export fn lastIndexOf(bytes : Bytes, part : Bytes) : Optional(Int) =
    lastIndexFrom(bytes, part, size(bytes) - size(part))

// The last place at or before the index where the part begins.
fn lastIndexFrom(bytes : Bytes, part : Bytes, index : Int) : Optional(Int) =
    if index < 0 then
        None
    else if slice(bytes, index, size(part)) == part then
        Some(index)
    else
        lastIndexFrom(bytes, part, index - 1)

/// `true` when the first begins with the second, and for an empty second.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.startsWith(<<1, 2, 3>>, <<1, 2>>), Bytes.startsWith(<<1>>, <<1, 2>>))
/// // => #(true, false)
/// ```
export fn startsWith(bytes : Bytes, prefix : Bytes) : Bool =
    slice(bytes, 0, size(prefix)) == prefix

/// `true` when the first ends with the second, and for an empty second.
///
/// ### Examples
///
/// ```ernest
/// Bytes.endsWith(<<1, 2, 3>>, <<3>>)
/// // => true
/// ```
export fn endsWith(bytes : Bytes, suffix : Bytes) : Bool = {
    let count = size(suffix);
    size(bytes) >= count && slice(bytes, size(bytes) - count, count) == suffix
}

/// The parts between the occurrences of the second, the empty parts
/// included; an empty second gives the first alone.
///
/// ### Examples
///
/// ```ernest
/// Bytes.split(<<1, 0, 0, 2>>, <<0>>)
/// // => [<<1>>, <<>>, <<2>>]
/// ```
export fn split(bytes : Bytes, separator : Bytes) : List(Bytes) =
    if isEmpty(separator) then [bytes] else List.reverse(parts(bytes, separator, []))

// The parts found so far, the last first, and the rest of the octets.
fn parts(bytes : Bytes, separator : Bytes, acc : List(Bytes)) : List(Bytes) =
    match indexOf(bytes, separator) {
        None -> bytes :: acc
      | Some(index) -> {
            let beyond = index + size(separator);
            parts(slice(bytes, beyond, size(bytes) - beyond),
                  separator,
                  slice(bytes, 0, index) :: acc)
        }
    }

/// Every occurrence of the second replaced by the third, the first
/// occurrence first; an empty second changes nothing.
///
/// ### Examples
///
/// ```ernest
/// Bytes.replace(<<1, 0, 2, 0>>, <<0>>, <<9, 9>>)
/// // => <<1, 9, 9, 2, 9, 9>>
/// ```
export fn replace(bytes : Bytes, old : Bytes, new : Bytes) : Bytes =
    if isEmpty(old) then bytes else join(split(bytes, old), new)

/// The parts with the second between them.
///
/// ### Examples
///
/// ```ernest
/// Bytes.join([<<1>>, <<2>>], <<0>>)
/// // => <<1, 0, 2>>
/// ```
export fn join(parts : List(Bytes), separator : Bytes) : Bytes =
    match parts {
        [] -> <<>>
      | first :: rest -> List.foldLeft(rest, first, fn(acc, part) = acc <> separator <> part)
    }

/// The octets `count` times; `count` below 0 gives the empty `Bytes`.
///
/// ### Examples
///
/// ```ernest
/// Bytes.repeat(<<1, 2>>, 2)
/// // => <<1, 2, 1, 2>>
/// ```
export fn repeat(bytes : Bytes, count : Int) : Bytes =
    copies(bytes, count, <<>>)

fn copies(bytes : Bytes, count : Int, acc : Bytes) : Bytes =
    if count <= 0 then acc else copies(bytes, count - 1, acc <> bytes)

/// Each octet as two hexadecimal digits, with upper-case letters as
/// `Int.toStringBase` writes them.
///
/// ### Examples
///
/// ```ernest
/// Bytes.toHex(<<0, 171, 255>>)
/// // => "00ABFF"
/// ```
export fn toHex(bytes : Bytes) : String =
    String.join(List.map(toList(bytes), fn(octet) = digit(octet / 16) <> digit(octet % 16)), "")

fn digit(value : Int) : String =
    String.slice("0123456789ABCDEF", value, 1)

/// The octets two hexadecimal digits write each, in either case, or `None`
/// for an odd number of digits or a character that is none.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.fromHex("00abFF"), Bytes.fromHex("0"), Bytes.fromHex("zz"))
/// // => #(Some(<<0, 171, 255>>), None, None)
/// ```
export fn fromHex(text : String) : Optional(Bytes) =
    octetsOf(String.toList(text), <<>>)

// The octets the digits write, after those already read.
fn octetsOf(digits : List(Char), acc : Bytes) : Optional(Bytes) =
    match digits {
        [] -> Some(acc)
      | high :: low :: rest -> match #(value(high), value(low)) {
            #(Some(highValue), Some(lowValue)) ->
                octetsOf(rest, <<acc:bytes, (highValue * 16 + lowValue)>>)
          | _ -> None
        }
      | [_] -> None
    }

fn value(char : Char) : Optional(Int) =
    if char >= '0' && char <= '9' then
        Some(Char.toInt(char) - Char.toInt('0'))
    else if char >= 'a' && char <= 'f' then
        Some(Char.toInt(char) - Char.toInt('a') + 10)
    else if char >= 'A' && char <= 'F' then
        Some(Char.toInt(char) - Char.toInt('A') + 10)
    else
        None
