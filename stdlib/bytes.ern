/// Sequences of bytes, as a file or a socket holds them.
///
/// Use `Bytes` for data that is not text: what `Fs.read` and `Tcp.read` answer,
/// and what a binary format is made of. For text use a `String`, and convert
/// with `String.toUtf8` and `String.fromUtf8`.
///
/// A `Bytes` is built and taken apart with bitstrings, which the language
/// provides: `<<1, 2, 3>>`, and in a pattern `<<length:size(16), rest:bytes>>`
/// reads a 16-bit number and the bytes after it (report §5.11). This module
/// holds the operations bitstrings do not: searching, splitting and the
/// conversions. A `Bytes` is a value, which no function here changes.
///
/// `toList` gives the bytes as `Int`s, each from 0 to 255, and `fromList`
/// builds a `Bytes` from them.
///
/// ## Examples
///
/// Two byte sequences joined with `<>`, and the bytes as numbers:
///
/// ```ernest
/// Bytes.toList(<<104, 105>> <> <<33>>)
/// // => [104, 105, 33]
/// ```
///
/// Bytes made from numbers, each from 0 to 255:
///
/// ```ernest
/// Bytes.fromList([104, 105])
/// // => Some(<<104, 105>>)
/// ```
///
/// ## See also
///
/// `String.toUtf8` and `String.fromUtf8` for text, `Int` for the octets.
///
/// since 0.1.0

/// The bytes of the first, then those of the second.
export fn Bytes.<>(left : Bytes, right : Bytes) : Bytes =
    left <> right

/// The number of bytes.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.size(<<1, 2, 3>>), Bytes.isEmpty(<<>>))
/// // => #(3, true)
/// ```
export foreign fn size(bytes : Bytes) : Int =
    "erlang:byte_size/1"

/// `true` for the empty `Bytes`, `<<>>`.
export fn isEmpty(bytes : Bytes) : Bool =
    size(bytes) == 0

/// The byte at `index`, counting from 0, as an `Int` from 0 to 255, or `None`
/// where there is no byte there: past the end, or at an index below 0.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.get(<<7, 8>>, 1), Bytes.get(<<7, 8>>, 2))
/// // => #(Some(8), None)
/// ```
export fn get(bytes : Bytes, index : Int) : Optional(Int) =
    match bytes {
        <<_:size(index)-bytes, octet, _:bytes>> -> Some(octet)
      | _ -> None
    }

/// The `count` bytes from `index`, or as many as there are. An `index` or a
/// `count` below 0 counts as 0.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.slice(<<1, 2, 3>>, 1, 5), Bytes.slice(<<1, 2, 3>>, -1, 2))
/// // => #(<<2, 3>>, <<1, 2>>)
/// ```
export fn slice(bytes : Bytes, index : Int, count : Int) : Bytes = {
    let clipped = Int.max(index, 0);
    let taken = Int.max(Int.min(count, size(bytes) - clipped), 0);
    match bytes {
        <<_:size(clipped)-bytes, sliced:size(taken)-bytes, _:bytes>> -> sliced
      | _ -> <<>>
    }
}

/// The bytes in order, each an `Int` from 0 to 255.
export foreign fn toList(bytes : Bytes) : List(Int) =
    "erlang:binary_to_list/1"

/// The `Bytes` of those numbers, or `None` where one is outside 0 to 255.
///
/// ### Examples
///
/// ```ernest
/// Bytes.fromList([256])
/// // => None
/// ```
export fn fromList(octets : List(Int)) : Optional(Bytes) =
    if List.all(octets, fn(octet) = octet >= 0 && octet <= 255) then
        Some(fromOctets(octets))
    else
        None

// Raises on a value outside 0 to 255, which `fromList` answers itself.
foreign fn fromOctets(octets : List(Int)) : Bytes =
    "erlang:list_to_binary/1"

/// `true` when `part` occurs somewhere in `bytes`. An empty `part` always does.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.contains(<<1, 2, 3>>, <<2, 3>>), Bytes.contains(<<1, 2>>, <<3>>))
/// // => #(true, false)
/// ```
export fn contains(bytes : Bytes, part : Bytes) : Bool =
    Optional.isSome(indexOf(bytes, part))

/// The index at which `part` first begins in `bytes`, or `None` where it is not
/// there. An empty `part` is at 0.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.indexOf(<<1, 2, 1, 2>>, <<1, 2>>), Bytes.indexOf(<<1>>, <<2>>))
/// // => #(Some(0), None)
/// ```
export fn indexOf(bytes : Bytes, part : Bytes) : Optional(Int) =
    if isEmpty(part) then
        Some(0)
    else match firstSplit(bytes, part) {
        [before, _] -> Some(size(before))
      | _ -> None
    }

// The octets before the part's first occurrence and those after it, or
// the octets alone; raises on an empty part, which `indexOf` answers
// itself.
foreign fn firstSplit(bytes : Bytes, part : Bytes) : List(Bytes) =
    "binary:split/2"

/// The index at which `part` last begins in `bytes`, or `None` where it is not
/// there. An empty `part` is at the end, the size of `bytes`.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.lastIndexOf(<<1, 2, 1, 2>>, <<1, 2>>), Bytes.lastIndexOf(<<1>>, <<2>>))
/// // => #(Some(2), None)
/// ```
export fn lastIndexOf(bytes : Bytes, part : Bytes) : Optional(Int) =
    lastIndexFrom(bytes, part, size(bytes) - size(part))

// The last place at or before the index where the part begins.
fn lastIndexFrom(bytes : Bytes, part : Bytes, index : Int) : Optional(Int) =
    if index < 0 then
        None
    else if slice(bytes, index, size(part)) == part then
        Some(index)
    else
        lastIndexFrom(bytes, part, index - 1)

/// `true` when `bytes` begins with `prefix`, and always for an empty `prefix`.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.startsWith(<<1, 2, 3>>, <<1, 2>>), Bytes.startsWith(<<1>>, <<1, 2>>))
/// // => #(true, false)
/// ```
export fn startsWith(bytes : Bytes, prefix : Bytes) : Bool =
    slice(bytes, 0, size(prefix)) == prefix

/// `true` when `bytes` ends with `suffix`, and always for an empty `suffix`.
///
/// ### Examples
///
/// ```ernest
/// Bytes.endsWith(<<1, 2, 3>>, <<3>>)
/// // => true
/// ```
export fn endsWith(bytes : Bytes, suffix : Bytes) : Bool = {
    let count = size(suffix);
    size(bytes) >= count && slice(bytes, size(bytes) - count, count) == suffix
}

/// The parts of `bytes` between the occurrences of `separator`, empty parts
/// included. An empty `separator` gives `[bytes]`.
///
/// ### Examples
///
/// ```ernest
/// Bytes.split(<<1, 0, 0, 2>>, <<0>>)
/// // => [<<1>>, <<>>, <<2>>]
/// ```
export fn split(bytes : Bytes, separator : Bytes) : List(Bytes) =
    if isEmpty(separator) then [bytes] else parts(bytes, separator)

// Raises on an empty separator, which `split` answers itself.
foreign fn parts(bytes : Bytes, separator : Bytes) : List(Bytes) =
    "ern_bytes:split/2"

/// `bytes` with each occurrence of `old` replaced by `new`, found from the left
/// without overlaps. An empty `old` changes nothing.
///
/// ### Examples
///
/// ```ernest
/// Bytes.replace(<<1, 0, 2, 0>>, <<0>>, <<9, 9>>)
/// // => <<1, 9, 9, 2, 9, 9>>
/// ```
export fn replace(bytes : Bytes, old : Bytes, new : Bytes) : Bytes =
    if isEmpty(old) then bytes else replaced(bytes, old, new)

// Raises on an empty old part, which `replace` answers itself.
foreign fn replaced(bytes : Bytes, old : Bytes, new : Bytes) : Bytes =
    "ern_bytes:replace/3"

/// The parts joined, with `separator` between each two.
///
/// ### Examples
///
/// ```ernest
/// Bytes.join([<<1>>, <<2>>], <<0>>)
/// // => <<1, 0, 2>>
/// ```
export fn join(parts : List(Bytes), separator : Bytes) : Bytes =
    match parts {
        [] -> <<>>
      | first :: rest -> List.foldLeft(rest, first, fn(acc, part) = acc <> separator <> part)
    }

/// `bytes` repeated `count` times. A `count` below 1 gives the empty `Bytes`.
///
/// ### Examples
///
/// ```ernest
/// Bytes.repeat(<<1, 2>>, 2)
/// // => <<1, 2, 1, 2>>
/// ```
export fn repeat(bytes : Bytes, count : Int) : Bytes =
    copies(bytes, count, <<>>)

fn copies(bytes : Bytes, count : Int, acc : Bytes) : Bytes =
    if count <= 0 then acc else copies(bytes, count - 1, acc <> bytes)

/// Each byte as two hexadecimal digits, letters in upper case: `<<255, 1>>` is
/// `"FF01"`.
///
/// ### Examples
///
/// ```ernest
/// Bytes.toHex(<<0, 171, 255>>)
/// // => "00ABFF"
/// ```
export foreign fn toHex(bytes : Bytes) : String =
    "binary:encode_hex/1"

/// The bytes that `text` writes two hexadecimal digits each, letters in either
/// case, or `None` for an odd number of digits or a character that is no digit.
///
/// ### Examples
///
/// ```ernest
/// #(Bytes.fromHex("00abFF"), Bytes.fromHex("0"), Bytes.fromHex("zz"))
/// // => #(Some(<<0, 171, 255>>), None, None)
/// ```
export foreign fn fromHex(text : String) : Optional(Bytes) =
    "ern_bytes:from_hex/1"
