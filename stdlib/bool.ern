/// Operations on `Bool`, the type of `true` and `false`. The language
/// itself has `&&`, `||`, and `if`; this module holds the rest.
///
/// ## Examples
///
/// ```ernest
/// Bool.not(1 < 2)
/// // => false
/// ```
///
/// ```ernest
/// Bool.toString(true)
/// // => "true"
/// ```
///
/// since 0.1.0

/// The other truth value.
export fn not(b : Bool) -> Bool = if b then false else true

/// `"true"` or `"false"`.
export fn toString(b : Bool) -> String = if b then "true" else "false"
