/// Operations on `Bool`, the type of `true` and `false`. The language
/// itself has `&&`, `||`, `!`, and `if`; this module holds the rest.
///
/// ## Examples
///
/// ```ernest
/// Bool.not(1 < 2)
/// // => false
/// ```
///
/// ```ernest
/// Bool.toString(true)
/// // => "true"
/// ```
///
/// since 0.1.0

/// The other truth value, which prefix `!` also gives (report §4.8).
export fn not(bool : Bool) : Bool =
    !bool

/// `"true"` or `"false"`.
export fn toString(bool : Bool) : String =
    if bool then "true" else "false"
