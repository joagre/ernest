//
// The Ernest shell (report §11.2), designed in docs/shell_design.md.
//
// An input is checked against the session, compiled as a module of its own
// and run in a process of its own; its value is printed with its type, or
// what it declared is. Three processes: the session holds the state, the
// reader owns the keys, and the screen is the only writer, which is what
// the sinks are bound to. When input is not a terminal the shell reads
// lines instead.
//

//
// The front end
//

foreign type Env
foreign type Checked
foreign type Value

// What running an input came to: its value, or the cause of the fault
// that ended it (report §11.2, §6.9).
type Outcome = Ok(env : Env, value : Value) | Faulted(String)

foreign fn start() -> Env with m = "ern_shell:start/0"
foreign fn program() -> Optional(Address(Never)) with m = "ern_shell:program/0"
foreign fn watchDeaths(to : Address(Down)) -> Unit with m = "ern_shell:deaths/1"
foreign fn mine() -> Unit with m = "ern_shell:mine/0"
foreign fn faults() -> List(Down) with m = "ern_shell:faults/0"
foreign fn processes() -> List(String) with m = "ern_shell:processes/0"
foreign fn load(env : Env, name : String) -> Either(String, #(Env, String)) with m =
    "ern_shell:load/2"
foreign fn reload(env : Env) -> Either(String, #(Env, List(String))) with m =
    "ern_shell:reload/1"
foreign fn output(path : String) -> Either(String, String) with m = "ern_shell:output/1"
// Report §11.2: the parser cannot finish what is typed, so another line
// may. The parser is the compiler's, and only it knows.
foreign fn needsMore(input : String) -> Bool = "ern_shell:needs_more/1"
// Report §11.2: every name completion may reach, as the session stands.
// Reading the compiled interfaces is the host's; the matching is
// `Shell.Complete`'s.
foreign fn names() -> List(Shell.Complete.Name) with m = "ern_shell:names/0"
// Report §11.2: what may stand at the cursor, which the parser knows,
// since it says what it wanted where it stopped.
foreign fn context(before : String) -> Shell.Complete.Where with m = "ern_shell:context/1"
// Report §11.2: the page for a name, which `Shift-Tab` shows a first
// sentence of and then the whole of.
foreign fn documentation(name : String) -> Optional(String) with m =
    "ern_shell:documentation/1"
foreign fn check(env : Env, from : String, input : String) -> Either(String, #(Env, Checked))
    with m = "ern_shell:check/3"
// The host's alone: where the startup files are, the person's first and
// then the node's. Whether they are there, and what they hold, is read
// here (report §11.2).
foreign fn startupFiles() -> List(String) with m = "ern_shell:startup_files/0"
foreign fn typeText(c : Checked) -> String = "ern_shell:type_text/1"
foreign fn declared(c : Checked) -> List(String) = "ern_shell:declared/1"
// Report §11.2: the value is printed, and `it` is left as it was when
// this input did not settle its type.
foreign fn unbound(c : Checked) -> Bool = "ern_shell:unbound/1"
foreign fn spawnInput(env : Env, c : Checked, to : Address(Outcome)) -> Address(Never) with m =
    "ern_shell:run/3"
foreign fn show(v : Value, depth : Int, length : Int) -> String = "ern_shell:show/3"
foreign fn bindings(env : Env) -> List(String) = "ern_shell:bindings/1"
foreign fn forget(env : Env, name : String) -> Either(String, Env) = "ern_shell:forget/2"
foreign fn browse(env : Env, name : String) -> Either(String, List(String)) with m =
    "ern_shell:browse/2"
foreign fn doc(env : Env, name : String) -> Either(String, String) with m = "ern_shell:doc/2"
foreign fn isTerminal() -> Bool with m = "ern_shell:is_terminal/0"
foreign fn write(text : String) -> Unit with m = "ern_shell:write/1"
foreign fn setScreen(to : Address(String)) -> Unit with m = "ern_shell:screen/1"
foreign fn holdTerminal(reader : Address(a)) -> Unit with m = "ern_rt:hold_terminal/1"

//
// The session
//

type ShellMsg = Typed(String) | Eof | Interrupted | Done(Outcome) | Died(Down)
  | ReaderDied(Down) | Ready

// What the session carries between inputs: the front end's environment and
// the settings `:set` changes, which are ordinary values.
type State = State(env : Env, settings : Settings)
type Settings = Settings(depth : Int, length : Int, timing : Bool, output : Int)

// Report §11.2: a value is printed to a depth and a length, and 0 is
// neither. The defaults print what a prompt is used for whole and stop a
// value that would scroll the session away.
let defaults = Settings(depth = 10, length = 100, timing = false, output = Shell.Region.tailRows)

export fn main() -> Unit with ShellMsg = {
    mine();
    let screen = spawn(Local, fn() = {
        mine();
        screenLoop(Shell.Region.new(Terminal.size(), isTerminal()))
    });
    // report §11.2: what a program writes goes to the tail, what the
    // session says is committed to the transcript
    setScreen(via(Wrote, screen));
    send(screen, Said("Ernest 0.1.0. :help for the commands, :quit to leave.\n"));
    let state = State(env = start(), settings = defaults);
    // report §11.2: a process that faults is news at the prompt, whichever
    // it is; the watcher is in place before the program's entry point runs
    watchDeaths(via(Died, self()));
    match program() {
        None -> Unit
      | Some(_) -> Unit
    };
    if isTerminal() then {
        let me = self();
        // report §11.2: the inputs of the sessions before this one
        let earlier = match Shell.History.read() {
            Right(inputs) -> inputs
          | Left(why) -> {
                say(screen, "the history could not be read: " <> trouble(why));
                []
            }
        };
        let reader = spawn(Local, fn() = {
            mine();
            Terminal.subscribe(K);
            send(me, Ready);
            readLoop(me, screen, Reading(editing = Shell.Editor.start(earlier),
                keeping = true, hinted = false, last = Ordinary))
        });
        holdTerminal(reader);
        // report §11.2: an editor that cannot read keys is no shell, so
        // the reader's death is said and the session ends with it; it is
        // the shell's own process, which a fault report leaves out
        monitor(reader, ReaderDied);
        // report §8.2: the prompt waits for the reader to hold the
        // keyboard, since until then the terminal is still echoing lines
        receive { Ready -> Unit };
        let state2 = startup(state, screen);
        send(screen, Said("> "));
        keyLoop(state2, screen)
    } else {
        // report §11.2: in line mode the session reads the lines itself,
        // and holds the terminal so that no input takes one
        holdTerminal(self());
        lineLoop(startup(state, screen), screen)
    }
}

// One input, from either reader: checked, run in a process of its own, its
// value printed with its type. An expression of type Unit prints nothing.
fn evaluate(state : State, screen : Address(ScreenMsg), input : String) -> State with ShellMsg =
    run(state, screen, "input", input, true)

// Report §11.2: an input from a startup file is checked and run as a typed
// one, and its value is not printed; what fails is reported with the file
// it came from.
fn quietly(state : State, screen : Address(ScreenMsg), from : String, input : String)
    -> State with ShellMsg = run(state, screen, from, input, false)

fn run(
    state : State,
    screen : Address(ScreenMsg),
    from : String,
    input : String,
    show : Bool
) -> State with ShellMsg = {
    let State(env = env) = state;
    match check(env, from, input) {
        Left(text) -> { send(screen, Said(text)); state }
      | Right(#(env2, checked)) -> {
            // report §11.2: the run is what timing measures, not the check
            let started = Clock.now();
            let child = spawnInput(env2, checked, via(Done, self()));
            await(State(..state, env = env2), screen, checked, child, started, show)
        }
    }
}

// Report §11.2: the inputs of the startup files, the person's first and
// then the node's, a line an input, each with the file it came from so
// that a failure names it rather than `input`.
fn startup(state : State, screen : Address(ScreenMsg)) -> State with ShellMsg =
    fromFiles(state, screen,
        List.flatMap(startupFiles(), fn(file) = fileInputs(screen, file)))

// A file that is not there is no error; one that cannot be read is said
// and the session goes on.
fn fileInputs(screen : Address(ScreenMsg), file : String)
    -> List(#(String, String)) with m = match Fs.read(Path(file), fileWait) {
    Left(NotFound) -> []
  | Left(why) -> { say(screen, file <> " could not be read: " <> trouble(why)); [] }
  | Right(bytes) -> {
        let text = Optional.withDefault(String.fromUtf8(bytes), "");
        let lines = List.filter(String.lines(text), fn(line) = !String.isEmpty(String.trim(line)));
        List.map(lines, fn(line) = #(file, line))
    }
}

fn fromFiles(state : State, screen : Address(ScreenMsg), inputs : List(#(String, String)))
    -> State with ShellMsg = match inputs {
    [] -> state
  | #(from, input) :: rest -> fromFiles(quietly(state, screen, from, input), screen, rest)
}

// The reader stays live, so an interruption reaches the session while the
// input runs and kills it (report §11.2).
fn await(
    state : State,
    screen : Address(ScreenMsg),
    checked : Checked,
    child : Address(Never),
    started : Int,
    showValue : Bool
) -> State with ShellMsg = receive {
    Done(Ok(env = env2, value = value)) -> {
        let State(settings = settings) = state;
        let Settings(depth = depth, length = length) = settings;
        let shown = typeText(checked);
        if showValue then {
            match declared(checked) {
                [] -> if shown == "Unit" then Unit
                else {
                    say(screen, show(value, depth, length) <> " : " <> shown);
                    if unbound(checked) then
                        say(screen, "`it` is unchanged: this input did not determine"
                            <> " the type of its value")
                    else Unit
                }
              | lines -> printLines(screen, lines)
            };
            timed(screen, settings, started)
        } else Unit;
        State(..state, env = env2)
    }
  | Done(Faulted(text)) -> {
        say(screen, "fault: " <> text);
        let State(settings = settings) = state;
        if showValue then timed(screen, settings, started) else Unit;
        state
    }
  | Interrupted -> { kill(child); say(screen, "Killed"); state }
  | Died(down) -> {
        reportDeath(screen, down);
        await(state, screen, checked, child, started, showValue)
    }
  | Typed(_) or Eof -> await(state, screen, checked, child, started, showValue)
}

// Report §11.2: with timing on, a result is followed by the time the run
// took.
fn timed(screen : Address(ScreenMsg), settings : Settings, started : Int) -> Unit with m =
    match settings {
        Settings(timing = false) -> Unit
      | Settings(timing = true) -> say(screen, "(" <> Int.toString(Clock.now() - started)
            <> " ms)")
    }

fn say(screen : Address(ScreenMsg), text : String) -> Unit with m =
    send(screen, Said(text <> "\n"))

// What the input declared, a line for each, in the order they were written
// (report §11.2).
fn printLines(screen : Address(ScreenMsg), lines : List(String)) -> Unit with m =
    match lines {
        [] -> Unit
      | line :: rest -> {
            send(screen, Said(line <> "\n"));
            printLines(screen, rest)
        }
    }

//
// Commands (report §11.2)
//

// A command is `:` and a name, and is not an Ernest function. Any prefix
// of the name selects it, an ambiguous prefix the first in this order,
// which is the order `:help` gives. One list holds all three, the order,
// what a command takes after its name, and the line `:help` prints, so
// that they cannot drift apart.
type Command = Type | Browse | Load | Reload | Quit | Doc | Help | Forget
  | Bindings | Processes | Faults | Output | Set

type Entry = Entry(name : String, command : Command, takes : Optional(String), about : String)

type Next = Continue(State) | Leave

let commands = [
    Entry(name = "type", command = Type, takes = Some("an expression"),
        about = " e         the type of e, which is not run"),
    Entry(name = "browse", command = Browse, takes = Some("a module"),
        about = " Module  the exports of Module with their types"),
    Entry(name = "load", command = Load, takes = Some("a module"),
        about = " Module    the module by its namespace, compiled from its source"),
    Entry(name = "reload", command = Reload, takes = None,
        about = "         every loaded module whose source has changed"),
    Entry(name = "quit", command = Quit, takes = None,
        about = "           leave, as C-d on an empty line does"),
    Entry(name = "doc", command = Doc, takes = Some("a name"),
        about = " Name       the documentation of Name, which GHCi calls :info"),
    Entry(name = "help", command = Help, takes = None,
        about = "           this text"),
    Entry(name = "forget", command = Forget, takes = Some("a name, or * for all of them"),
        about = " name    forget a name the session declared, or * for all of them"),
    Entry(name = "bindings", command = Bindings, takes = None,
        about = "       what the session declares, with their types"),
    Entry(name = "processes", command = Processes, takes = None,
        about = "      the live processes of the session, by spawn site"),
    Entry(name = "faults", command = Faults, takes = None,
        about = "         the faults reported since the session began"),
    Entry(name = "output", command = Output, takes = None,
        about = "         a path, so a second window shows what programs write; - for the tail"),
    Entry(name = "set", command = Set, takes = None,
        about = "            depth n, length n, timing on or off; :set alone shows them")
]

// An input is a command or Ernest.
fn submit(state : State, screen : Address(ScreenMsg), input : String) -> Next with ShellMsg =
    if String.startsWith(input, ":") then perform(state, screen, input)
    else Continue(evaluate(state, screen, input))

fn perform(state : State, screen : Address(ScreenMsg), input : String) -> Next with ShellMsg = {
    let #(word, arg) = splitWord(input, 0);
    let name = String.slice(word, 1, String.size(word) - 1);
    match pick(commands, name) {
        None -> {
            say(screen, "no command " <> word <> "; :help lists them");
            Continue(state)
        }
      | Some(Entry(name = full, command = c, takes = Some(what))) ->
            if String.isEmpty(arg) then {
                say(screen, ":" <> full <> " takes " <> what);
                Continue(state)
            } else obey(state, screen, c, arg)
      | Some(Entry(command = c)) -> obey(state, screen, c, arg)
    }
}

fn pick(cs : List(Entry), name : String) -> Optional(Entry) =
    if String.isEmpty(name) then None
    else match cs {
        [] -> None
      | first :: rest -> match first {
            Entry(name = full) ->
                if String.startsWith(full, name) then Some(first) else pick(rest, name)
        }
    }

fn obey(state : State, screen : Address(ScreenMsg), c : Command, arg : String)
    -> Next with ShellMsg = {
    let State(env = env, settings = settings) = state;
    match c {
        Quit -> Leave
      | Help -> { printLines(screen, help()); Continue(state) }
      | Bindings -> match bindings(env) {
            [] -> { say(screen, "the session declares nothing yet"); Continue(state) }
          | lines -> { printLines(screen, lines); Continue(state) }
        }
      | Type -> match check(env, "input", arg) {
            Left(text) -> { send(screen, Said(text)); Continue(state) }
          | Right(#(env2, checked)) -> {
                say(screen, arg <> " : " <> typeText(checked));
                Continue(State(..state, env = env2))
            }
        }
      | Forget -> match forget(env, arg) {
            Left(text) -> { say(screen, text); Continue(state) }
          | Right(env2) -> Continue(State(..state, env = env2))
        }
      | Browse -> match browse(env, arg) {
            Left(text) -> { say(screen, text); Continue(state) }
          | Right(lines) -> { printLines(screen, lines); Continue(state) }
        }
      | Doc -> match doc(env, arg) {
            Left(text) -> { say(screen, text); Continue(state) }
          | Right(text) -> { send(screen, Said(text)); Continue(state) }
        }
      | Output -> match output(arg) {
            Left(text) -> { say(screen, text); Continue(state) }
          | Right(text) -> { say(screen, text); Continue(state) }
        }
      | Set -> Continue(State(..state, settings = set(screen, settings, arg)))
      | Processes -> match processes() {
            [] -> { say(screen, "no process of the session's is running"); Continue(state) }
          | sites -> { printLines(screen, sites); Continue(state) }
        }
      | Faults -> match faults() {
            [] -> { say(screen, "no process has faulted"); Continue(state) }
          | downs -> { printLines(screen, List.map(downs, faultLine)); Continue(state) }
        }
      | Load -> match load(env, arg) {
            Left(text) -> { send(screen, Said(text)); Continue(state) }
          | Right(#(env2, line)) -> {
                say(screen, line);
                Continue(State(..state, env = env2))
            }
        }
      | Reload -> match reload(env) {
            Left(text) -> { send(screen, Said(text)); Continue(state) }
          | Right(#(env2, lines)) -> {
                printLines(screen, lines);
                Continue(State(..state, env = env2))
            }
        }
    }
}

// Report §11.2: the depth and the length a value is printed to, and
// whether a result is followed by the time its run took.
fn set(screen : Address(ScreenMsg), settings : Settings, arg : String) -> Settings with m = {
    let #(what, rest) = splitWord(arg, 0);
    if String.isEmpty(what) then { printLines(screen, settingLines(settings)); settings }
    else if what == "depth" then
        number(screen, settings, rest, fn(n) = Settings(..settings, depth = n))
    else if what == "length" then
        number(screen, settings, rest, fn(n) = Settings(..settings, length = n))
    else if what == "timing" then
        if rest == "on" then Settings(..settings, timing = true)
        else if rest == "off" then Settings(..settings, timing = false)
        else { say(screen, ":set timing takes on or off"); settings }
    else if what == "output" then
        // report §11.2: the rows the tail takes, and none at 0
        match String.toInt(rest) {
            Some(n) -> if n < 0 then { say(screen, "a height is 0 or more"); settings }
            else {
                send(screen, Height(n));
                Settings(..settings, output = n)
            }
          | None -> { say(screen, ":set output takes a number of rows"); settings }
        }
    else { say(screen, ":set takes depth, length, timing, or output"); settings }
}

fn number(
    screen : Address(ScreenMsg),
    settings : Settings,
    text : String,
    f : (Int) -> Settings
) -> Settings with m = match String.toInt(text) {
    Some(n) -> if n < 0 then { say(screen, "a depth and a length are 0 or more"); settings }
    else f(n)
  | None -> { say(screen, "that is not a number"); settings }
}

fn settingLines(settings : Settings) -> List(String) = match settings {
    Settings(depth = d, length = l, timing = t, output = o) ->
        ["depth " <> Int.toString(d), "length " <> Int.toString(l),
            "timing " <> (if t then "on" else "off"),
            "output " <> Int.toString(o)]
}

// The first word of a line and what follows it, trimmed.
fn splitWord(s : String, i : Int) -> #(String, String) =
    if i >= String.size(s) then #(s, "")
    else if String.slice(s, i, 1) == " " then
        #(String.slice(s, 0, i), String.trim(String.slice(s, i, String.size(s) - i)))
    else splitWord(s, i + 1)

// Report §11.2: the commands and their prefixes, from the one list.
fn help() -> List(String) =
    ["Commands, which any prefix of the name selects:"]
        <> List.map(commands, fn(e) = match e { Entry(name = n, about = a) -> "  :" <> n <> a })
        <> ["The value of the last expression is `it`."]

//
// The screen: the only process that writes to the terminal
//

// Report §11.2: a line the shell has finished with is committed, written
// into the terminal and never touched again, so that the scrollback, the
// search and the selection stay the terminal's own. The last rows are
// live: the tail of what programs have written, and the line being typed
// under it. Nothing is ever written below the live region, which is what
// makes `erase` correct.
//
// The shell never addresses a row. It did not clear the screen and does
// not know where on it the region sits: it moves up from the line being
// typed to the region's first row, erases to the end of the screen, and
// paints again. With no terminal there is no region at all and the text
// is written as it arrives.

// Report §11.2: the messages the region takes. The screen process holds
// the region of `Shell.Region` and writes what it answers; the region
// itself is pure and draws nothing.
type ScreenMsg = Said(String)                        // the shell's own
  | Noted(String)                       // and while an input is typed
  | Wrote(String)                       // a program's
  | Typing(text : String, at : Int)     // the line being typed, and the cursor
  | Entered                             // and now it is finished
  | Resize
  | Clear                               // `C-l`, a clean screen
  | Height(Int)                         // `:set output n`
  | Flush(reply : Reply(Unit))

// How long to wait for the file system, which is a local file.
let fileWait = 5000

// Report §11.2: how many candidates a second `Tab` lists before it
// stops, since a listing is committed and a long one scrolls the
// transcript away.
let listRows = 40

fn screenLoop(r : Shell.Region.Region) -> Unit with ScreenMsg = {
    let #(next, bytes) = receive {
        Said(text) -> Shell.Region.said(r, text)
      | Noted(text) -> Shell.Region.noted(r, text)
      | Wrote(text) -> Shell.Region.wrote(r, text)
      | Typing(text = text, at = at) -> Shell.Region.typing(r, text, at)
      | Entered -> Shell.Region.entered(r)
      | Resize -> Shell.Region.resized(r, Terminal.size())
      | Clear -> Shell.Region.cleared(r)
      | Height(rows) -> Shell.Region.output(r, rows)
      | Flush(reply = reply) -> { answer(reply, Unit); #(r, "") }
    };
    write(bytes);
    screenLoop(next)
}

// Report §11.2: on quitting, the region goes and the cursor is left on a
// fresh line, so the terminal is as the shell found it.
fn finish(screen : Address(ScreenMsg), text : String) -> Unit with m = {
    send(screen, Said(text));
    send(screen, Height(0));
    send(screen, Typing(text = "", at = 0));
    send(screen, Said("\n"));
    drain(screen)
}

// The prompt comes after what the input printed, whatever order the two
// processes sent in: the screen is drained first.
fn prompt(screen : Address(ScreenMsg)) -> Unit with m = {
    drain(screen);
    send(screen, Said("> "))
}

fn drain(screen : Address(ScreenMsg)) -> Unit with m =
    match Address.call(screen, fn(r) = Flush(reply = r), 5000) { _ -> Unit }

//
// The reader, on a terminal: it owns the keys and the line being edited,
// and draws nothing itself. What a key does is `edit`, a pure function;
// the reader sends the screen the line and the session what was entered.
//

type ReaderMsg = K(Event)

// What the reader carries between keys: the line being edited, whether
// the history file still takes what is typed, and whether this session
// has said how a multi-line input is run (report §11.2).
type Reading = Reading(editing : Shell.Editor.State, keeping : Bool, hinted : Bool,
    last : Last)

// What the key before this one did, since `Tab` twice lists and
// `Shift-Tab` twice shows the whole page (report §11.2).
type Last = Ordinary | Tabbed | Documented

fn readLoop(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading)
    -> Unit with ReaderMsg = {
    let Reading(editing = editing, keeping = keeping) = reading;
    receive {
        K(Resized(_)) -> {
            send(screen, Resize);
            readLoop(session, screen, reading)
        }
      | K(event) -> match Shell.Editor.edit(editing, event) {
            Shell.Editor.Typing(next) -> showing(session, screen, reading, next)
          | Shell.Editor.Submit(next) ->
                // report §11.2: another line where the parser cannot
                // finish the input, and the input where it can
                if continues(text(next)) then
                    showing(session, screen, reading, Shell.Editor.newline(next))
                else {
                    let kept = remember(screen, next, keeping);
                    send(screen, Entered);
                    send(session, Typed(text(next)));
                    readLoop(session, screen,
                        Reading(..reading, editing = Shell.Editor.next(next),
                            keeping = kept, last = Ordinary))
                }
          | Shell.Editor.Cancel -> {
                // what was typed stays in the transcript, abandoned, and
                // in the history to recall and mend
                let kept = remember(screen, editing, keeping);
                send(screen, Entered);
                send(session, Interrupted);
                readLoop(session, screen,
                    Reading(..reading, editing = Shell.Editor.next(editing),
                        keeping = kept, last = Ordinary))
            }
          | Shell.Editor.Clear(next) -> {
                send(screen, Clear);
                showing(session, screen, reading, next)
            }
          | Shell.Editor.Completing(next) -> completing(session, screen, reading, next)
          | Shell.Editor.Documenting(next) -> documenting(session, screen, reading, next)
          | Shell.Editor.Leave -> send(session, Eof)
        }
    }
}

// Report §11.2: `Tab` completes the word before the cursor; a second
// `Tab` lists what it could still be, above the region, where the
// transcript keeps it and the region stays the size it was.
fn completing(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    state : Shell.Editor.State) -> Unit with ReaderMsg = {
    let Reading(last = last) = reading;
    let Shell.Editor.State(text = line, at = at) = state;
    let typed = Shell.Complete.word(String.slice(line, 0, at));
    if String.startsWith(line, ":") && at <= commandEnd(line) then
        // report §11.2: a command is the shell's own word, not the
        // language's, so the parser is not asked about it
        offering(session, screen, reading,
            Shell.Complete.complete(String.slice(line, 0, commandEnd(line)),
                commandNames(), Shell.Complete.Expression),
            String.slice(line, 0, commandEnd(line)), state)
    else if String.isEmpty(typed) then
        // report §11.2: nothing before the cursor to complete, so `Tab`
        // indents. Four spaces and no tab: the style guide's rule, and
        // a tab in the line is invisible where spaces are what they
        // look like (§0, principle 3)
        showing(session, screen, reading, indented(state, line, at))
    else {
        // the parser is asked about the text before the word being
        // completed: with the word there it has been read already, and
        // what may stand at the cursor is what may stand in its place
        let where = context(String.slice(line, 0, at - String.size(typed)));
        let completion = Shell.Complete.complete(typed, names(), where);
        offering(session, screen, reading, completion, typed, state)
    }
}

// What a completion does to the line: the word it gives stands in
// place of the one typed, and a second `Tab` lists what is left.
fn offering(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    completion : Shell.Complete.Completion, typed : String,
    state : Shell.Editor.State) -> Unit with ReaderMsg = {
    let Reading(last = last) = reading;
    let Shell.Editor.State(text = line, at = at) = state;
    let #(text, next) = Shell.Complete.applied(line, at, typed, completion);
    if last == Tabbed then listing(screen, completion) else Unit;
    let shown = Shell.Editor.typed(state, text, next);
    let said = hint(screen, reading, shown);
    send(screen, typing(shown));
    readLoop(session, screen,
        Reading(..reading, editing = shown, hinted = said, last = Tabbed))
}

// Report §11.2: a command's own word is everything up to the first
// space, which is where its argument begins.
fn commandEnd(line : String) -> Int = match String.indexOf(line, " ") {
    None -> String.size(line)
  | Some(i) -> i
}

fn commandNames() -> List(Shell.Complete.Name) =
    List.map(commands, fn(entry) = match entry {
        Entry(name = name, about = about) ->
            Shell.Complete.Name(text = ":" <> name, kind = Shell.Complete.Value,
                shown = ":" <> name <> about)
    })

let indent = "    "

fn indented(state : Shell.Editor.State, line : String, at : Int) -> Shell.Editor.State =
    Shell.Editor.typed(state,
        String.slice(line, 0, at) <> indent
            <> String.slice(line, at, String.size(line) - at),
        at + String.size(indent))

// Report §11.2: `Shift-Tab` says what the name at the cursor is: its
// type and the first sentence about it, and the whole page when it is
// pressed again. Above the region, as a listing is.
fn documenting(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    state : Shell.Editor.State) -> Unit with ReaderMsg = {
    let Reading(last = last) = reading;
    let Shell.Editor.State(text = line, at = at) = state;
    let name = Shell.Complete.word(String.slice(line, 0, at));
    match documentation(name) {
        None -> Unit
      | Some(page) ->
            List.foreach(if last == Documented then String.lines(page) else brief(page),
                fn(row) = send(screen, Noted(row)))
    };
    send(screen, typing(state));
    readLoop(session, screen, Reading(..reading, editing = state, last = Documented))
}

// The type and the first sentence of a page, which is its code block
// and the first line of prose after it.
fn brief(page : String) -> List(String) = {
    let rows = List.filter(String.lines(page), fn(row) = !String.isEmpty(String.trim(row))
        && !String.startsWith(row, "#")
        && row != "```ernest" && row != "```");
    List.take(rows, 2)
}

// Report §11.2: the candidates, a line each with the type they carry,
// committed above the region as anything the shell says is.
fn listing(screen : Address(ScreenMsg), completion : Shell.Complete.Completion) -> Unit with m =
    match completion {
        Shell.Complete.Completion(candidates = []) -> Unit
      | Shell.Complete.Completion(candidates = [_]) -> Unit
      | Shell.Complete.Completion(candidates = candidates) -> {
            List.foreach(List.take(candidates, listRows), fn(name) =
                match name { Shell.Complete.Name(shown = shown) -> send(screen, Noted(shown)) });
            let left = List.size(candidates) - listRows;
            if left > 0 then send(screen, Noted("and " <> Int.toString(left) <> " more"))
            else Unit
        }
    }

// The screen is told what is being typed, and the session is told once
// how a multi-line input is run.
fn showing(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    next : Shell.Editor.State) -> Unit with ReaderMsg = {
    let said = hint(screen, reading, next);
    send(screen, typing(next));
    // a key that only begins a sequence, `Escape` and the `[` after
    // it, leaves the last key as it was: `Shift-Tab` twice is two
    // presses, not six keys (report §8.2)
    let Reading(last = last) = reading;
    readLoop(session, screen, Reading(..reading, editing = next, hinted = said,
        last = if midSequence(next) then last else Ordinary))
}

fn midSequence(state : Shell.Editor.State) -> Bool = match state {
    Shell.Editor.State(pending = Shell.Editor.Plain) -> false
  | _ -> true
}

// Report §11.2: the first input of a session to take a second line says
// how it is run, once, above the region rather than on the prompt, where
// it would move the column the input is typed in.
fn hint(screen : Address(ScreenMsg), reading : Reading, next : Shell.Editor.State)
    -> Bool with m = match reading {
    Reading(hinted = true) -> true
  | Reading(hinted = false) ->
        if String.contains(text(next), "\n") then {
            send(screen, Noted("M-Enter adds a line, Enter runs."));
            true
        } else false
}

// Report §11.2: `Enter` takes another line where the parser cannot
// finish the input, and runs what there is on an empty line, so that an
// input that cannot parse is shown its error rather than asked for more.
// An input with nothing in it runs, though the parser cannot finish it:
// `Enter` at an empty prompt has always given a new one.
fn continues(input : String) -> Bool =
    !String.isEmpty(String.trim(input)) && !lastLineBlank(input) && needsMore(input)

fn lastLineBlank(input : String) -> Bool = match String.lastIndexOf(input, "\n") {
    None -> false
  | Some(i) ->
        String.isEmpty(String.trim(String.slice(input, i + 1, String.size(input) - i - 1)))
}

// Report §11.2: an input the history keeps is appended as the shell
// takes it.
fn remember(screen : Address(ScreenMsg), editing : Shell.Editor.State, keeping : Bool)
    -> Bool with m = {
    let line = text(editing);
    if !keeping || !Shell.Editor.keeps(editing, line) then keeping
    else match Shell.History.add(line) {
        Right(_) -> true
      | Left(why) -> {
            say(screen, "the history is not kept: " <> trouble(why));
            false
        }
    }
}

fn trouble(why : IoError) -> String = match why {
    NotFound -> "the file is not there"
  | Denied -> "permission was denied"
  | Refused -> "the file system refused"
  | Closed -> "the file was closed"
  | Timeout -> "the file system did not answer"
  | Other(text) -> text
}

// What the reader shows is the editor's, since a search shows its own
// prompt and the input it found rather than the line (report §11.2).
fn typing(editing : Shell.Editor.State) -> ScreenMsg =
    Typing(text = Shell.Editor.shown(editing), at = Shell.Editor.cursor(editing))

fn text(editing : Shell.Editor.State) -> String =
    match editing { Shell.Editor.State(text = text) -> text }

fn keyLoop(state : State, screen : Address(ScreenMsg)) -> Unit with ShellMsg = receive {
    Typed(line) -> match String.trim(line) {
        "" -> { prompt(screen); keyLoop(state, screen) }
      | input -> match submit(state, screen, input) {
            Leave -> finish(screen, "")
          | Continue(state2) -> { prompt(screen); keyLoop(state2, screen) }
        }
    }
  | Eof -> finish(screen, "\n")
  | Interrupted -> { prompt(screen); keyLoop(state, screen) }
  | Died(down) -> { reportDeath(screen, down); keyLoop(state, screen) }
  | ReaderDied(down) -> match down {
        Down(reason = Returned) -> finish(screen, "")
      | other -> finish(screen, "the shell stopped reading the keyboard: "
            <> faultLine(other) <> "\n")
    }
  | Done(_) -> keyLoop(state, screen)
}

// Report §11.2: what died while the session was reading. In line mode the
// session blocks in `Io.readLine`, so a death is reported before the next
// prompt instead; §6.4 leaves every other message in the mailbox.
fn deaths(screen : Address(ScreenMsg)) -> Unit with ShellMsg = receive {
    Died(down) -> { reportDeath(screen, down); deaths(screen) }
  | after 0 -> Unit
}

// Report §11.2: a process that faults is reported with its spawn site and
// cause; returning, being killed, and the program's end are not news.
fn reportDeath(screen : Address(ScreenMsg), down : Down) -> Unit with m =
    say(screen, faultLine(down))

fn faultLine(down : Down) -> String = match down {
    Down(reason = Fault(text), function = where) -> where <> " faulted: " <> text
  | Down(reason = _, function = where) -> where <> " ended"
}

//
// The reader, when input is not a terminal: lines, no editing
//

fn lineLoop(state : State, screen : Address(ScreenMsg)) -> Unit with ShellMsg = {
    deaths(screen);
    prompt(screen);
    match Io.readLine() {
        None -> finish(screen, "\n")
      | Some(line) -> match String.trim(line) {
            "" -> lineLoop(state, screen)
          | input -> match submit(state, screen, input) {
                Leave -> finish(screen, "")
              | Continue(state2) -> lineLoop(state2, screen)
            }
        }
    }
}
