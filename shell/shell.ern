//
// The Ernest shell (report §11.2), designed in docs/shell_design.md.
//
// An input is checked against the session, compiled as a module of its own
// and run in a process of its own; its value is printed with its type, or
// what it declared is. Three processes: the session holds the state, the
// reader owns the keys, and the screen is the only writer, which is what
// the sinks are bound to. When input is not a terminal the shell reads
// lines instead.
//

//
// The front end
//

foreign type Env
foreign type Checked
foreign type Value

// What running an input came to: its value, or the cause of the fault
// that ended it (report §11.2, §6.9).
type Outcome = Ok(env : Env, value : Value) | Faulted(String)

foreign fn start() -> Env with m = "ern_shell:start/0"
foreign fn program() -> Optional(Address(Never)) with m = "ern_shell:program/0"
foreign fn watchDeaths(to : Address(Down)) -> Unit with m = "ern_shell:deaths/1"
foreign fn mine() -> Unit with m = "ern_shell:mine/0"
foreign fn faults() -> List(Down) with m = "ern_shell:faults/0"
foreign fn processes() -> List(String) with m = "ern_shell:processes/0"
foreign fn load(env : Env, name : String) -> Either(String, #(Env, String)) with m =
    "ern_shell:load/2"
foreign fn reload(env : Env) -> Either(String, #(Env, List(String))) with m =
    "ern_shell:reload/1"
foreign fn output(path : String) -> Either(String, String) with m = "ern_shell:output/1"
// Report §11.2: the parser cannot finish what is typed, so another line
// may. The parser is the compiler's, and only it knows.
foreign fn needsMore(input : String) -> Bool = "ern_shell:needs_more/1"
// Report §11.2: every name completion may reach, as the session stands.
// Reading the compiled interfaces is the host's; the matching is
// `Shell.Complete`'s.
foreign fn names() -> List(Shell.Complete.Name) with m = "ern_shell:names/0"
// Report §11.2: the names the session declares, which `:forget` takes,
// and the source root `:load` compiles from; the session is the front
// end's to hold.
foreign fn sessionNames() -> List(Shell.Complete.Name) with m = "ern_shell:session_names/0"
foreign fn sourceRoot() -> String with m = "ern_shell:source_root/0"
// Report §11.2: every name the session declares, as it is written.
foreign fn sessionTexts() -> List(String) with m = "ern_shell:session_texts/0"
// Report §11.2: what may stand at the cursor, which the parser knows,
// since it says what it wanted where it stopped.
foreign fn context(before : String) -> Shell.Complete.Where with m = "ern_shell:context/1"
// Report §11.2: the page for a name, which `Shift-Tab` shows a first
// sentence of and then the whole of.
foreign fn documentation(name : String) -> Optional(String) with m =
    "ern_shell:documentation/1"
// Report §11.2: the signature of the call the input stops inside, with the
// parameter at the cursor marked, which `Shift-Tab` shows where no name
// before the cursor is documented.
foreign fn signature(before : String) -> Optional(#(String, String, String)) with m =
    "ern_shell:signature/1"
// Report §11.2: an input checked against the session; a diagnostic names
// the file it came from and the line it starts on there, `input` and 1 for
// one typed.
foreign fn check(env : Env, from : String, line : Int, input : String)
    -> Either(String, #(Env, Checked)) with m = "ern_shell:check/4"
// The host's alone: where the startup files are, the person's first and
// then the node's. Whether they are there, and what they hold, is read
// here (report §11.2).
foreign fn startupFiles() -> List(String) with m = "ern_shell:startup_files/0"
foreign fn typeText(c : Checked) -> String = "ern_shell:type_text/1"
// Report §11.2: a value of type `Unit` prints nothing.
foreign fn isUnit(c : Checked) -> Bool = "ern_shell:is_unit/1"
foreign fn declared(c : Checked) -> List(String) = "ern_shell:declared/1"
// Report §11.2: the value is printed, and `it` is left as it was when
// this input did not settle its type.
foreign fn unbound(c : Checked) -> Bool = "ern_shell:unbound/1"
foreign fn spawnInput(env : Env, c : Checked, to : Address(Outcome)) -> Address(Never) with m =
    "ern_shell:run/3"
foreign fn show(v : Value, depth : Int, length : Int) -> String = "ern_shell:show/3"
foreign fn bindings(env : Env) -> List(String) = "ern_shell:bindings/1"
foreign fn forget(env : Env, name : String) -> Either(String, Env) = "ern_shell:forget/2"
foreign fn browse(env : Env, name : String) -> Either(String, List(String)) with m =
    "ern_shell:browse/2"
foreign fn doc(env : Env, name : String) -> Either(String, String) with m = "ern_shell:doc/2"
foreign fn isTerminal() -> Bool with m = "ern_shell:is_terminal/0"
// The toolchain's version, which the host was built with.
foreign fn version() -> String = "ern_shell:version/0"
// Report §11.2: whether the shell colours what it says, at a terminal and
// without `NO_COLOR`.
foreign fn colours() -> Bool with m = "ern_shell:colours/0"
foreign fn write(text : String) -> Unit with m = "ern_shell:write/1"
foreign fn setScreen(to : Address(String)) -> Unit with m = "ern_shell:screen/1"
foreign fn holdTerminal(reader : Address(a)) -> Unit with m = "ern_rt:hold_terminal/1"

//
// The session
//

type ShellMsg = Typed(String) | Eof | Interrupted | Done(Outcome) | Died(Down)
  | ReaderDied(Down) | Ready

// What the session carries between inputs: the front end's environment, the
// settings `:set` changes, which are ordinary values, and whether it colours
// what it says, read once at the start (report §11.2).
type State = State(env : Env, settings : Settings, colour : Bool)
type Settings = Settings(depth : Int, length : Int, timing : Bool, output : Int)

// Report §11.2: a value is printed to a depth and a length, and 0 is
// neither. The defaults print what a prompt is used for whole and stop a
// value that would scroll the session away.
let defaults = Settings(depth = 10, length = 100, timing = false, output = Shell.Region.tailRows)

export fn main() -> Unit with ShellMsg = {
    mine();
    // report §11.2: at a terminal the keys are read and a region painted;
    // elsewhere lines are read and what is said is written as it comes
    let size = if isTerminal() then Terminal.size() else None;
    let colour = colours();
    let screen = spawn(Local, fn() = {
        mine();
        match size {
            Some(s) -> screenLoop(Shell.Region.new(s))
          | None -> plainLoop()
        }
    });
    // report §11.2: what a program writes goes to the tail, what the
    // session says is committed to the transcript
    setScreen(via(Wrote, screen));
    send(screen, Said("Ernest " <> version() <> ". :help for the commands, :quit to leave.\n"));
    let state = State(env = start(), settings = defaults, colour = colour);
    // report §11.2: a process that faults is news at the prompt, whichever
    // it is; the watcher is in place before the program's entry point runs
    watchDeaths(via(Died, self()));
    // report §11.2: the file's entry point is spawned beside the prompt,
    // and its faults reach the watcher as any other process's do
    let _ = program();
    if size != None then {
        let me = self();
        // report §11.2: the inputs of the sessions before this one
        let earlier = match Shell.History.file() {
            None -> {
                say(screen, "the history is not kept, since HOME is not set");
                []
            }
          | Some(_) -> match Shell.History.read() {
                Right(inputs) -> inputs
              | Left(why) -> {
                    say(screen, "the history could not be read: " <> trouble(why));
                    []
                }
            }
        };
        let reader = spawn(Local, fn() = {
            mine();
            Terminal.subscribe(K);
            send(me, Ready);
            readLoop(me, screen, Reading(editing = Shell.Editor.start(earlier),
                keeping = true, hinted = false, last = Ordinary, colour = colour))
        });
        holdTerminal(reader);
        // report §11.2: an editor that cannot read keys is no shell, so
        // the reader's death is said and the session ends with it; it is
        // the shell's own process, which a fault report leaves out
        monitor(reader, ReaderDied);
        // report §8.2: the prompt waits for the reader to hold the
        // keyboard, since until then the terminal is still echoing lines
        receive { Ready -> Unit };
        match startup(state, screen) {
            Continue(state2) -> { send(screen, Said("> ")); keyLoop(state2, screen) }
          | Leave -> finish(screen, "")
        }
    } else {
        // report §11.2: in line mode the session reads the lines itself,
        // and holds the terminal so that no input takes one
        holdTerminal(self());
        match startup(state, screen) {
            Continue(state2) -> lineLoop(state2, screen)
          | Leave -> finish(screen, "")
        }
    }
}

// One input, from either reader: checked, run in a process of its own, its
// value printed with its type. An expression of type Unit prints nothing.
fn evaluate(state : State, screen : Address(ScreenMsg), input : String) -> State with ShellMsg =
    run(state, screen, "input", 1, input, true)

// Report §11.2: an input from a startup file is checked and run as a typed
// one, and its value is not printed; what fails is reported with the file
// it came from.
fn quietly(state : State, screen : Address(ScreenMsg), from : String, line : Int,
    input : String) -> State with ShellMsg = run(state, screen, from, line, input, false)

fn run(state : State, screen : Address(ScreenMsg), from : String, line : Int, input : String,
    printing : Bool) -> State with ShellMsg = {
    let State(env = env, colour = colour) = state;
    match check(env, from, line, input) {
        Left(text) -> { diagnose(screen, colour, text); state }
      | Right(#(env2, checked)) -> {
            // report §11.2: the run is what timing measures, not the check
            let started = Clock.now();
            let child = spawnInput(env2, checked, via(Done, self()));
            await(State(..state, env = env2), screen, checked, child, started, printing)
        }
    }
}

// Report §11.2: the inputs of the startup files, the person's first and
// then the node's, a line an input, each with the file it came from so
// that a failure names it rather than `input`.
fn startup(state : State, screen : Address(ScreenMsg)) -> Next with ShellMsg =
    fromFiles(state, screen,
        List.flatMap(startupFiles(), fn(file) = fileInputs(screen, file)))

// A file that is not there is no error; one that cannot be read is said
// and the session goes on. Each input carries the line it is on.
fn fileInputs(screen : Address(ScreenMsg), file : String)
    -> List(#(String, Int, String)) with m = match Fs.read(Path(file), fileWait) {
    Left(NotFound) -> []
  | Left(why) -> { say(screen, file <> " could not be read: " <> trouble(why)); [] }
  | Right(bytes) -> {
        let text = Optional.withDefault(String.fromUtf8(bytes), "");
        let numbered = List.indexed(String.lines(text));
        List.filterMap(numbered, fn(#(i, line)) =
            if String.isEmpty(String.trim(line)) then None else Some(#(file, i + 1, line)))
    }
}

// Report §11.2: a startup input runs as a typed one, a command among them,
// and a `:quit` there ends the session; a diagnostic names its file and
// line.
fn fromFiles(state : State, screen : Address(ScreenMsg),
    inputs : List(#(String, Int, String))) -> Next with ShellMsg = match inputs {
    [] -> Continue(state)
  | #(from, line, input) :: rest ->
        if String.startsWith(input, ":") then match perform(state, screen, input) {
            Continue(state2) -> fromFiles(state2, screen, rest)
          | Leave -> Leave
        }
        else fromFiles(quietly(state, screen, from, line, input), screen, rest)
}

// The reader stays live, so an interruption reaches the session while the
// input runs and kills it, and an input typed meanwhile waits in the
// mailbox for this one to end (report §11.2).
fn await(
    state : State,
    screen : Address(ScreenMsg),
    checked : Checked,
    child : Address(Never),
    started : Int,
    printing : Bool
) -> State with ShellMsg = receive {
    Done(Ok(env = env2, value = value)) -> {
        let State(settings = settings, colour = colour) = state;
        let Settings(depth = depth, length = length) = settings;
        let shown = typeText(checked);
        if printing then {
            match declared(checked) {
                [] -> if isUnit(checked) then Unit
                else {
                    say(screen, show(value, depth, length)
                        <> Shell.Style.quiet(colour, " : " <> shown));
                    if unbound(checked) then
                        say(screen, "`it` is unchanged: this input did not determine"
                            <> " the type of its value")
                    else Unit
                }
              | lines -> printLines(screen, lines)
            };
            timed(screen, settings, started)
        } else Unit;
        State(..state, env = env2)
    }
  | Done(Faulted(text)) -> {
        let State(settings = settings, colour = colour) = state;
        say(screen, Shell.Style.fault(colour, "fault: " <> text));
        if printing then timed(screen, settings, started) else Unit;
        state
    }
  | Interrupted -> { kill(child); say(screen, "Killed"); state }
  | Died(down) -> {
        let State(colour = colour) = state;
        reportDeath(screen, colour, down);
        await(state, screen, checked, child, started, printing)
    }
    // an input typed meanwhile, and the end of input, are left in the
    // mailbox: they wait for this one, and run after it (report §11.2)
}

// Report §11.2: with timing on, a result is followed by the time the run
// took.
fn timed(screen : Address(ScreenMsg), settings : Settings, started : Int) -> Unit with m =
    match settings {
        Settings(timing = false) -> Unit
      | Settings(timing = true) -> say(screen, "(" <> Int.toString(Clock.now() - started)
            <> " ms)")
    }

// A diagnostic, its first line coloured as a fault (report §11.2).
fn diagnose(screen : Address(ScreenMsg), colour : Bool, text : String) -> Unit with m =
    send(screen, Said(Shell.Style.diagnostic(colour, text)))

fn say(screen : Address(ScreenMsg), text : String) -> Unit with m =
    send(screen, Said(text <> "\n"))

// Report §11.2: what the shell refuses is red, as a diagnostic's first
// line is, and what it answers is plain.
fn refuse(screen : Address(ScreenMsg), colour : Bool, text : String) -> Unit with m =
    say(screen, Shell.Style.fault(colour, text))

// What the input declared, a line for each, in the order they were written
// (report §11.2).
fn printLines(screen : Address(ScreenMsg), lines : List(String)) -> Unit with m =
    match lines {
        [] -> Unit
      | line :: rest -> {
            send(screen, Said(line <> "\n"));
            printLines(screen, rest)
        }
    }

//
// Commands (report §11.2)
//

// A command is `:` and a name, and is not an Ernest function. Its name
// selects it, and so does a prefix of its name that begins no other
// command's name; `:help` lists them alphabetically. One list holds it
// all, the order, what a command takes after its name, what completes
// there, and the line `:help` prints, so that they cannot drift apart.
type Command = Bindings | Browse | Doc | Faults | Forget | Help | Load | Output | Processes
  | Quit | Reload | Set | Type

// Report §11.2: what completes after a command. A path is an argument
// but does not complete.
type Argument = NoArgument | AnExpression | AModule | ASourceModule | AName | ASessionName
  | ASetting | APath

type Entry = Entry(name : String, command : Command, takes : Optional(String),
    argument : Argument, about : String)

type Next = Continue(State) | Leave

let commands = [
    Entry(name = "bindings", command = Bindings, takes = None, argument = NoArgument,
        about = "       what the session declares, with their types"),
    Entry(name = "browse", command = Browse, takes = Some("a module"), argument = AModule,
        about = " Module  the exports of Module with their types"),
    Entry(name = "doc", command = Doc, takes = Some("a name"), argument = AName,
        about = " Name       the documentation of Name, which GHCi calls :info"),
    Entry(name = "faults", command = Faults, takes = None, argument = NoArgument,
        about = "         the faults reported since the session began"),
    Entry(name = "forget", command = Forget, takes = Some("a name, or * for all of them"),
        argument = ASessionName,
        about = " name    forget a name the session declared, or * for all of them"),
    Entry(name = "help", command = Help, takes = None, argument = NoArgument,
        about = "           this text"),
    Entry(name = "load", command = Load, takes = Some("a module"), argument = ASourceModule,
        about = " Module    the module by its namespace, compiled from its source"),
    Entry(name = "output", command = Output, takes = None, argument = APath,
        about = " path    send what programs write to path, or - back to the tail"),
    Entry(name = "processes", command = Processes, takes = None, argument = NoArgument,
        about = "      the live processes of the session, by spawn site"),
    Entry(name = "quit", command = Quit, takes = None, argument = NoArgument,
        about = "           leave, as C-d on an empty line does"),
    Entry(name = "reload", command = Reload, takes = None, argument = NoArgument,
        about = "         every loaded module whose source has changed"),
    Entry(name = "set", command = Set, takes = None, argument = ASetting,
        about = "            depth n, length n, output n, timing on or off; :set alone shows them"),
    Entry(name = "type", command = Type, takes = Some("an expression"), argument = AnExpression,
        about = " e         the type of e, which is not run")
]

// Report §11.2: the words `:set` takes first, which complete after it.
let settings = [#("depth", "depth n"), #("length", "length n"), #("output", "output n"),
    #("timing", "timing on or off")]

// An input is a command or Ernest.
fn submit(state : State, screen : Address(ScreenMsg), input : String) -> Next with ShellMsg =
    if String.startsWith(input, ":") then perform(state, screen, input)
    else Continue(evaluate(state, screen, input))

fn perform(state : State, screen : Address(ScreenMsg), input : String) -> Next with ShellMsg = {
    let State(colour = colour) = state;
    let #(word, arg) = splitWord(input, 0);
    let name = String.slice(word, 1, String.size(word) - 1);
    match pick(name) {
        Unknown -> {
            refuse(screen, colour, "no command " <> word <> "; :help lists them");
            Continue(state)
        }
      | Ambiguous(names) -> {
            refuse(screen, colour, word <> " is " <> alternatives(names));
            Continue(state)
        }
      | Picked(Entry(name = full, command = c, takes = Some(what))) ->
            if String.isEmpty(arg) then {
                refuse(screen, colour, ":" <> full <> " takes " <> what);
                Continue(state)
            } else obey(state, screen, c, arg)
      | Picked(Entry(name = full, argument = NoArgument)) when !String.isEmpty(arg) -> {
            refuse(screen, colour, ":" <> full <> " takes no argument");
            Continue(state)
        }
      | Picked(Entry(command = c)) -> obey(state, screen, c, arg)
    }
}

// What a command's name selects: one command, none, or several, which
// report §11.2 refuses with their names.
type Picked = Picked(Entry) | Unknown | Ambiguous(List(String))

fn pick(name : String) -> Picked = {
    let begun = List.filter(commands, fn(e) = String.startsWith(entryName(e), name));
    match List.filter(begun, fn(e) = entryName(e) == name) {
        [whole] -> Picked(whole)
      | _ ->
            if String.isEmpty(name) then Unknown
            else match begun {
                [] -> Unknown
              | [one] -> Picked(one)
              | many -> Ambiguous(List.map(many, entryName))
            }
    }
}

fn entryName(e : Entry) -> String = match e { Entry(name = name) -> name }

// `:bindings or :browse`, and `:a, :b or :c` for three.
fn alternatives(names : List(String)) -> String = {
    let colons = List.map(names, fn(name) = ":" <> name);
    match List.last(colons) {
        None -> ""
      | Some(last) ->
            if List.size(colons) == 1 then last
            else String.join(List.dropLast(colons), ", ") <> " or " <> last
    }
}

fn obey(state : State, screen : Address(ScreenMsg), c : Command, arg : String)
    -> Next with ShellMsg = {
    let State(env = env, settings = settings, colour = colour) = state;
    match c {
        Quit -> Leave
      | Help -> { printLines(screen, help()); Continue(state) }
      | Bindings -> match bindings(env) {
            [] -> { say(screen, "the session declares nothing yet"); Continue(state) }
          | lines -> { printLines(screen, lines); Continue(state) }
        }
      | Type -> match check(env, "input", 1, arg) {
            Left(text) -> { diagnose(screen, colour, text); Continue(state) }
          | Right(#(env2, checked)) -> {
                say(screen, arg <> " : " <> typeText(checked));
                Continue(State(..state, env = env2))
            }
        }
      | Forget -> match forget(env, arg) {
            Left(text) -> { refuse(screen, colour, text); Continue(state) }
          | Right(env2) -> Continue(State(..state, env = env2))
        }
      | Browse -> match browse(env, arg) {
            Left(text) -> { refuse(screen, colour, text); Continue(state) }
          | Right(lines) -> { printLines(screen, lines); Continue(state) }
        }
      | Doc -> match doc(env, arg) {
            Left(text) -> { refuse(screen, colour, text); Continue(state) }
          | Right(text) -> {
                printLines(screen, rendered(text, screenWidth(), colour));
                Continue(state)
            }
        }
      | Output -> match output(arg) {
            Left(text) -> { refuse(screen, colour, text); Continue(state) }
          | Right(text) -> { say(screen, text); Continue(state) }
        }
      | Set -> Continue(State(..state, settings = set(screen, colour, settings, arg)))
      | Processes -> match processes() {
            [] -> { say(screen, "no process of the session's is running"); Continue(state) }
          | sites -> { printLines(screen, sites); Continue(state) }
        }
      | Faults -> match faults() {
            [] -> { say(screen, "no process has faulted"); Continue(state) }
          | downs -> {
                printLines(screen,
                    List.map(downs, fn(d) = Shell.Style.fault(colour, faultLine(d))));
                Continue(state)
            }
        }
      | Load -> match load(env, arg) {
            Left(text) -> { diagnose(screen, colour, text); Continue(state) }
          | Right(#(env2, line)) -> {
                say(screen, line);
                Continue(State(..state, env = env2))
            }
        }
      | Reload -> match reload(env) {
            Left(text) -> { diagnose(screen, colour, text); Continue(state) }
          | Right(#(env2, lines)) -> {
                printLines(screen, lines);
                Continue(State(..state, env = env2))
            }
        }
    }
}

// Report §11.2: the depth and the length a value is printed to, and
// whether a result is followed by the time its run took.
fn set(screen : Address(ScreenMsg), colour : Bool, settings : Settings, arg : String)
    -> Settings with m = {
    let #(what, rest) = splitWord(arg, 0);
    if String.isEmpty(what) then { printLines(screen, settingLines(settings)); settings }
    else if what == "depth" then
        number(screen, colour, settings, "depth", rest, fn(n) = Settings(..settings, depth = n))
    else if what == "length" then
        number(screen, colour, settings, "length", rest, fn(n) = Settings(..settings, length = n))
    else if what == "timing" then
        if rest == "on" then Settings(..settings, timing = true)
        else if rest == "off" then Settings(..settings, timing = false)
        else { refuse(screen, colour, ":set timing takes on or off"); settings }
    else if what == "output" then
        // report §11.2: the rows the tail takes, and none at 0
        match String.toInt(rest) {
            Some(n) -> if n < 0 then { refuse(screen, colour, "a height is 0 or more"); settings }
            else {
                send(screen, Height(n));
                Settings(..settings, output = n)
            }
          | None -> { refuse(screen, colour, ":set output takes a number"); settings }
        }
    else { refuse(screen, colour, ":set takes depth, length, output, or timing"); settings }
}

fn number(screen : Address(ScreenMsg), colour : Bool, settings : Settings, what : String,
    text : String, f : (Int) -> Settings) -> Settings with m = match String.toInt(text) {
    Some(n) -> if n < 0 then {
        refuse(screen, colour, "a depth and a length are 0 or more");
        settings
    }
    else f(n)
  | None -> { refuse(screen, colour, ":set " <> what <> " takes a number"); settings }
}

fn settingLines(settings : Settings) -> List(String) = match settings {
    Settings(depth = d, length = l, timing = t, output = o) ->
        ["depth " <> Int.toString(d), "length " <> Int.toString(l),
            "output " <> Int.toString(o), "timing " <> (if t then "on" else "off")]
}

// The first word of a line and what follows it, trimmed.
fn splitWord(s : String, i : Int) -> #(String, String) =
    if i >= String.size(s) then #(s, "")
    else if String.slice(s, i, 1) == " " then
        #(String.slice(s, 0, i), String.trim(String.slice(s, i, String.size(s) - i)))
    else splitWord(s, i + 1)

// Report §11.2: the commands and their prefixes, from the one list.
fn help() -> List(String) =
    ["Commands, which a prefix of the name selects where it begins no other:"]
        <> List.map(commands, fn(e) = match e { Entry(name = n, about = a) -> "  :" <> n <> a })
        <> ["The value of the last expression is `it`."]

//
// The screen: the only process that writes to the terminal
//

// Report §11.2: a line the shell has finished with is committed, written
// into the terminal and never touched again, so that the scrollback, the
// search and the selection stay the terminal's own. The last rows are
// live: the tail of what programs have written, and the line being typed
// under it. Nothing is ever written below the live region, which is what
// makes `erase` correct.
//
// The shell never addresses a row. It did not clear the screen and does
// not know where on it the region sits: it moves up from the line being
// typed to the region's first row, erases to the end of the screen, and
// paints again. With no terminal there is no region at all and the text
// is written as it arrives.

// Report §11.2: the messages the region takes. The screen process holds
// the region of `Shell.Region` and writes what it answers; the region
// itself is pure and draws nothing.
type ScreenMsg = Said(String)                        // the shell's own
  | Noted(String)                       // and while an input is typed
  | Wrote(String)                       // a program's
  | Typing(text : String, at : Int, offered : List(String)) // the line, and under it
  | Entered                             // and now it is finished
  | Taken                               // the session has taken an input
  | Resize
  | Clear                               // `C-l`, a clean screen
  | Height(Int)                         // `:set output n`
  | Flush(reply : Reply(Unit))

// How long to wait for the file system, which is a local file.
let fileWait = 5000

fn screenLoop(r : Shell.Region.Region) -> Unit with ScreenMsg = {
    let #(next, bytes) = receive {
        Said(text) -> Shell.Region.said(r, text)
      | Noted(text) -> Shell.Region.noted(r, text)
      | Wrote(text) -> Shell.Region.wrote(r, text)
      | Typing(text = text, at = at, offered = offered) ->
            Shell.Region.typing(r, text, at, offered)
      | Entered -> Shell.Region.entered(r)
      | Taken -> Shell.Region.taken(r)
      | Resize -> match Terminal.size() {
            Some(size) -> Shell.Region.resized(r, size)
          | None -> #(r, "")
        }
      | Clear -> Shell.Region.cleared(r)
      | Height(rows) -> Shell.Region.output(r, rows)
      | Flush(reply = reply) -> { answer(reply, Unit); #(r, "") }
    };
    write(bytes);
    screenLoop(next)
}

// Report §11.2: without a terminal there is no region, and what the screen
// is sent is written as it comes, a note on a line of its own.
fn plainLoop() -> Unit with ScreenMsg = {
    receive {
        Said(text) -> write(text)
      | Wrote(text) -> write(text)
      | Noted(text) -> write(text <> "\n")
      | Flush(reply = reply) -> answer(reply, Unit)
      | Typing(text = _, at = _, offered = _) -> Unit
      | Entered -> Unit
      | Taken -> Unit
      | Resize -> Unit
      | Clear -> Unit
      | Height(_) -> Unit
    };
    plainLoop()
}

// Report §11.2: on quitting, the region goes and the cursor is left on a
// fresh line, so the terminal is as the shell found it.
fn finish(screen : Address(ScreenMsg), text : String) -> Unit with m = {
    send(screen, Said(text));
    send(screen, Height(0));
    send(screen, Typing(text = "", at = 0, offered = []));
    send(screen, Said("\n"));
    drain(screen)
}

// The prompt comes after what the input printed, whatever order the two
// processes sent in: the screen is drained first.
fn prompt(screen : Address(ScreenMsg)) -> Unit with m = {
    drain(screen);
    send(screen, Said("> "))
}

fn drain(screen : Address(ScreenMsg)) -> Unit with m =
    match Address.call(screen, fn(r) = Flush(reply = r), 5000) { _ -> Unit }

//
// The reader, on a terminal: it owns the keys and the line being edited,
// and draws nothing itself. What a key does is `edit`, a pure function;
// the reader sends the screen the line and the session what was entered.
//

type ReaderMsg = K(Event)

// What the reader carries between keys: the line being edited, whether
// the history file still takes what is typed, whether this session has
// said how a multi-line input is run, what the key before did, and whether
// the shell colours (report §11.2).
type Reading = Reading(editing : Shell.Editor.State, keeping : Bool, hinted : Bool,
    last : Last, colour : Bool)

// What the key before this one did, since `Tab` twice lists and
// `Shift-Tab` twice shows the whole page (report §11.2).
type Last = Ordinary | Tabbed | Documented

fn readLoop(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading)
    -> Unit with ReaderMsg = {
    let Reading(editing = editing, keeping = keeping) = reading;
    receive {
        K(Resized(_)) -> {
            send(screen, Resize);
            readLoop(session, screen, reading)
        }
      | K(event) -> match Shell.Editor.edit(editing, event) {
            Shell.Editor.Typing(next) -> showing(session, screen, reading, next)
          | Shell.Editor.Submit(next) ->
                // report §11.2: another line where the parser cannot
                // finish the input, and the input where it can
                if continues(text(next)) then
                    showing(session, screen, reading, Shell.Editor.newline(next))
                else {
                    let kept = remember(screen, next, keeping);
                    send(screen, Entered);
                    send(session, Typed(text(next)));
                    readLoop(session, screen,
                        Reading(..reading, editing = Shell.Editor.next(next),
                            keeping = kept, last = Ordinary))
                }
          | Shell.Editor.Cancel -> {
                // what was typed stays in the transcript, abandoned, and
                // in the history to recall and mend
                let kept = remember(screen, editing, keeping);
                send(screen, Entered);
                send(session, Interrupted);
                readLoop(session, screen,
                    Reading(..reading, editing = Shell.Editor.next(editing),
                        keeping = kept, last = Ordinary))
            }
          | Shell.Editor.Clear(next) -> {
                send(screen, Clear);
                showing(session, screen, reading, next)
            }
          | Shell.Editor.Completing(next) -> completing(session, screen, reading, next)
          | Shell.Editor.Documenting(next) -> documenting(session, screen, reading, next)
          | Shell.Editor.Leave -> send(session, Eof)
        }
    }
}

// Report §11.2: `Tab` completes the word before the cursor; a second
// `Tab` lists what it could still be, under the line, until the next
// key.
fn completing(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    state : Shell.Editor.State) -> Unit with ReaderMsg = {
    let Reading(last = last) = reading;
    let Shell.Editor.State(text = line, at = at) = state;
    let typed = Shell.Complete.word(String.slice(line, 0, at));
    if String.startsWith(line, ":") && at <= commandEnd(line) then {
        // report §11.2: a command is the shell's own word, not the
        // language's, so the parser is not asked about it
        let word = String.slice(line, 0, commandEnd(line));
        offering(session, screen, reading, commandWord(word, line), word, state)
    }
    else if String.startsWith(line, ":") then
        offering(session, screen, reading, argument(line, at, typed), typed, state)
    else if String.isEmpty(String.trim(rowBefore(line, at))) then
        // report §11.2: only spaces before the cursor on its row, so `Tab`
        // indents. Four spaces and no tab: the style guide's rule, and
        // a tab in the line is invisible where spaces are what they
        // look like (§0, principle 3)
        showing(session, screen, reading, indented(state, line, at))
    else {
        // the parser is asked about the text before the word being
        // completed: with the word there it has been read already, and
        // what may stand at the cursor is what may stand in its place
        let where = context(String.slice(line, 0, at - String.size(typed)));
        let completion = Shell.Complete.complete(typed, offered(typed), where);
        offering(session, screen, reading, completion, typed, state)
    }
}

// What a completion does to the line: the word it gives stands in
// place of the one typed, and a second `Tab` lists what is left. Report
// §11.2: so does a first `Tab` that adds nothing to the line, since a
// key that changes nothing would say nothing, and a lone candidate is
// listed whenever it is reached, since its line says what was completed.
fn offering(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    completion : Shell.Complete.Completion, typed : String,
    state : Shell.Editor.State) -> Unit with ReaderMsg = {
    let Reading(last = last) = reading;
    let Shell.Editor.State(text = line, at = at) = state;
    let #(text, next) = Shell.Complete.applied(line, at, typed, completion);
    let shown = Shell.Editor.typed(state, text, next);
    let said = hint(screen, reading, shown);
    let Reading(colour = colour) = reading;
    let listed = last == Tabbed || text == line || lone(completion);
    let rows = if listed then listing(completion, colour) else [];
    send(screen, under(shown, rows));
    readLoop(session, screen,
        Reading(..reading, editing = shown, hinted = said, last = Tabbed))
}

// Report §11.2: a command's own word is everything up to the first
// space, which is where its argument begins.
fn commandEnd(line : String) -> Int = match String.indexOf(line, " ") {
    None -> String.size(line)
  | Some(i) -> i
}

// Report §11.2: the names a word completes against, every one once
// something is typed; with nothing typed, the starting points: what the
// session declares, the modules in scope, and the prelude's names that no
// module qualifies, its constructors aside, which are mostly the messages
// of system processes and complete from a letter.
fn offered(typed : String) -> List(Shell.Complete.Name) with m = {
    let all = Shell.Complete.withNamespaces(names());
    if !String.isEmpty(typed) then all
    else {
        // nothing typed reaches the names of one segment, so what is left
        // to leave out is the prelude's constructors
        let own = sessionTexts();
        List.filter(all, fn(name) = match name {
            Shell.Complete.Name(text = text, kind = Shell.Complete.Constructor) ->
                List.contains(own, text)
          | _ -> true
        })
    }
}

fn lone(completion : Shell.Complete.Completion) -> Bool = match completion {
    Shell.Complete.Completion(candidates = [_]) -> true
  | _ -> false
}

// Report §11.2: a lone candidate is completed as far as it goes, so one
// that takes a value after it, a command with an argument or a setting,
// is followed by a space, where the line has none after it already.
fn withSpace(completion : Shell.Complete.Completion, takes : Bool)
    -> Shell.Complete.Completion = match completion {
    Shell.Complete.Completion(word = whole, candidates = [only]) ->
        if takes then Shell.Complete.Completion(word = whole <> " ", candidates = [only])
        else completion
  | _ -> completion
}

fn commandWord(word : String, line : String) -> Shell.Complete.Completion = {
    let completion = Shell.Complete.complete(word, commandNames(), Shell.Complete.Anything);
    match completion {
        Shell.Complete.Completion(word = whole) ->
            withSpace(completion, commandEnd(line) == String.size(line) && takesArgument(whole))
    }
}

fn takesArgument(word : String) -> Bool =
    match pick(String.slice(word, 1, String.size(word) - 1)) {
        Picked(Entry(argument = NoArgument)) -> false
      | Picked(_) -> true
      | _ -> false
    }

// Report §11.2: after a command, what completes is what the command
// takes, and after another command nothing. An expression's names are
// the parser's to choose, as at the start of a line; anything else is
// one word, the argument's first.
fn argument(line : String, at : Int, typed : String) -> Shell.Complete.Completion with m = {
    let end = commandEnd(line);
    let start = at - String.size(typed);
    let before = String.slice(line, end, start - end);
    match pick(String.slice(line, 1, end - 1)) {
        Picked(Entry(argument = AnExpression)) ->
            Shell.Complete.complete(typed, offered(typed), context(before))
      // every setting takes a value after it, and `timing`'s is a word
      | Picked(Entry(argument = ASetting)) -> match String.trim(before) {
            "" ->
                withSpace(Shell.Complete.complete(typed, argumentNames(ASetting, typed),
                    Shell.Complete.Anything), at == String.size(line))
          | "timing" -> Shell.Complete.complete(typed, List.map(["on", "off"], fn(word) =
                Shell.Complete.Name(text = word, kind = Shell.Complete.Value, shown = word)),
                Shell.Complete.Anything)
          | _ -> Shell.Complete.nothing
        }
      | Picked(Entry(argument = kind)) ->
            if String.isEmpty(String.trim(before)) then
                Shell.Complete.complete(typed, argumentNames(kind, typed), Shell.Complete.Anything)
            else Shell.Complete.nothing
      | _ -> Shell.Complete.nothing
    }
}

fn argumentNames(kind : Argument, typed : String) -> List(Shell.Complete.Name) with m =
    match kind {
        // a module completes as it is written, without the dot a name
        // inside it would need, and is listed by its name alone, since
        // every candidate here is a module; the namespaces they are in,
        // `Http` for `Http.Parser`, complete with their dots
        AModule -> Shell.Complete.withNamespaces(List.filterMap(names(), fn(name) =
            match name {
                Shell.Complete.Name(text = text, kind = Shell.Complete.Module) ->
                    Some(Shell.Complete.Name(text = text, kind = Shell.Complete.Value,
                        shown = text))
              | _ -> None
            }))
      | ASourceModule -> sourceModules(typed)
      | AName -> offered(typed)
      | ASessionName -> sessionNames()
      | ASetting -> List.map(settings, fn(#(word, shown)) =
            Shell.Complete.Name(text = word, kind = Shell.Complete.Value, shown = shown))
      | _ -> []
    }

// Report §11.2: the modules `:load` may compile, read from the source
// root a directory at a time: the one the typed word's finished segments
// name, so that a large root is never walked whole. A directory is a
// namespace and a `.ern` file a module, each named by §11.1's path shape.
fn sourceModules(typed : String) -> List(Shell.Complete.Name) with m = {
    let finished = List.dropLast(String.split(typed, "."));
    let dir = List.foldLeft(finished, Path(sourceRoot()),
        fn(path, segment) = Path.join(path, Path(String.toLower(segment))));
    let prefix = String.join(List.map(finished, fn(segment) = segment <> "."), "");
    match Fs.list(dir, fileWait) {
        Left(_) -> []
      | Right(entries) -> List.filterMap(entries, fn(entry) = sourceModule(prefix, entry))
    }
}

fn sourceModule(prefix : String, entry : Prelude.Entry) -> Optional(Shell.Complete.Name) =
    match entry {
        Prelude.Entry(path = path, isDir = true) ->
            if isPathWord(Path.name(path)) then {
                let text = prefix <> capital(Path.name(path));
                Some(Shell.Complete.Name(text = text, kind = Shell.Complete.Module,
                    shown = text <> "."))
            } else None
      | Prelude.Entry(path = path) -> {
            let stem = Path.name(Path.withExtension(path, ""));
            if Path.extension(path) == Some("ern") && isPathWord(stem) then {
                let text = prefix <> capital(stem);
                Some(Shell.Complete.Name(text = text, kind = Shell.Complete.Value, shown = text))
            } else None
        }
    }

// Report §11.1: a path component is a lowercase letter followed by
// lowercase letters and digits.
fn isPathWord(word : String) -> Bool = match String.toList(word) {
    [] -> false
  | first :: rest -> within(first, 'a', 'z')
        && List.all(rest, fn(c) = within(c, 'a', 'z') || within(c, '0', '9'))
}

fn within(c : Char, low : Char, high : Char) -> Bool = c >= low && c <= high

fn capital(word : String) -> String = match String.toList(word) {
    [] -> ""
  | first :: rest -> String.fromList(Char.toUpper(first) :: rest)
}

fn commandNames() -> List(Shell.Complete.Name) =
    List.map(commands, fn(entry) = match entry {
        Entry(name = name, about = about) ->
            Shell.Complete.Name(text = ":" <> name, kind = Shell.Complete.Value,
                shown = ":" <> name <> about)
    })

let indent = "    "

// The row the cursor is on, up to the cursor: a multi-line input's rows
// are its lines.
fn rowBefore(line : String, at : Int) -> String = {
    let before = String.slice(line, 0, at);
    match String.lastIndexOf(before, "\n") {
        None -> before
      | Some(i) -> String.slice(before, i + 1, String.size(before) - i - 1)
    }
}

fn indented(state : Shell.Editor.State, line : String, at : Int) -> Shell.Editor.State =
    Shell.Editor.typed(state,
        String.slice(line, 0, at) <> indent
            <> String.slice(line, at, String.size(line) - at),
        at + String.size(indent))

// Report §11.2: `Shift-Tab` says what the name at the cursor is: its
// type, the first sentence about it, and the version it appeared in, and
// the whole page when it is pressed again. Where no name at the cursor is
// documented and the cursor is inside a call or a constructor, it shows
// the call's signature instead. Under the line, as a listing is.
fn documenting(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    state : Shell.Editor.State) -> Unit with ReaderMsg = {
    let Reading(last = last, colour = colour) = reading;
    let Shell.Editor.State(text = line, at = at) = state;
    // report §11.2: the whole name the cursor stands in, and a call is
    // looked for in a command's argument as in any input
    let name = Shell.Complete.wordAt(line, at);
    let page = if String.isEmpty(name) then None else documentation(name);
    let from = if String.startsWith(line, ":") then Int.min(commandEnd(line), at) else 0;
    let rows = match page {
        Some(text) -> if last == Documented then rendered(text, screenWidth(), colour)
        else brief(text, screenWidth(), colour)
      | None -> match signature(String.slice(line, from, at - from)) {
            Some(#(head, marked, rest)) -> [head <> Shell.Style.emphasis(colour, marked) <> rest]
          | None -> []
        }
    };
    send(screen, under(state, rows));
    readLoop(session, screen, Reading(..reading, editing = state, last = Documented))
}

// The type, the first sentence, and the version a page's declaration
// appeared in: the first line of its first code block, the first sentence
// of its first paragraph, and its `Since` paragraph, the name before the
// type bold.
fn brief(text : String, width : Int, colour : Bool) -> List(String) = {
    let blocks = Markdown.parse(text);
    let types = List.flatMap(blocks, fn(b) = match b {
        Markdown.Code(lines = lines) -> List.take(lines, 1)
      | _ -> []
    });
    let paragraphs = List.filter(blocks, fn(b) = match b {
        Markdown.Paragraph(_) -> true
      | _ -> false
    });
    let #(versions, prose) = List.partition(paragraphs, isVersion);
    List.map(List.take(types, 1), fn(t) = Shell.Style.named(colour, t))
        <> Markdown.render(List.map(List.take(prose, 1), sentence), width, colour)
        <> Markdown.render(List.take(versions, 1), width, colour)
}

// Report §11.2: a paragraph's first sentence, which ends at the first `. `
// in its text.
fn sentence(b : Markdown.Block) -> Markdown.Block = match b {
    Markdown.Paragraph(xs) -> Markdown.Paragraph(upToStop(xs))
  | other -> other
}

fn upToStop(xs : List(Markdown.Inline)) -> List(Markdown.Inline) = match xs {
    [] -> []
  | Markdown.Text(s) :: rest -> match String.indexOf(s, ". ") {
        Some(i) -> [Markdown.Text(String.slice(s, 0, i + 1))]
      | None -> Markdown.Text(s) :: upToStop(rest)
    }
  | x :: rest -> x :: upToStop(rest)
}

// The line §11.4 writes for the version a declaration appeared in.
fn isVersion(b : Markdown.Block) -> Bool = match b {
    Markdown.Paragraph([Markdown.Emphasis([Markdown.Text(text)])]) ->
        String.startsWith(text, "Since ")
  | _ -> false
}

// Report §11.2: a page of documentation rendered for the terminal, at its
// width, or at 80 columns where there is no terminal.
fn rendered(text : String, width : Int, colour : Bool) -> List(String) =
    Markdown.render(Markdown.parse(text), width, colour)

fn screenWidth() -> Int with m = match Terminal.size() {
    Some(Size(columns = columns)) -> columns
  | None -> 80
}

// Report §11.2: the candidates, a lone one too, a line each with the
// type they carry, or a command's help line. The region cuts the listing
// to the rows the screen has.
fn listing(completion : Shell.Complete.Completion, colour : Bool) -> List(String) =
    match completion {
        Shell.Complete.Completion(candidates = candidates) ->
            List.map(candidates, fn(Shell.Complete.Name(shown = shown)) =
                Shell.Style.named(colour, shown))
    }

// The screen is told what is being typed, and the session is told once
// how a multi-line input is run.
fn showing(session : Address(ShellMsg), screen : Address(ScreenMsg), reading : Reading,
    next : Shell.Editor.State) -> Unit with ReaderMsg = {
    let said = hint(screen, reading, next);
    send(screen, typing(next));
    // a key that only begins a sequence, `Escape` and the `[` after
    // it, leaves the last key as it was: `Shift-Tab` twice is two
    // presses, not six keys (report §8.2)
    let Reading(last = last) = reading;
    readLoop(session, screen, Reading(..reading, editing = next, hinted = said,
        last = if midSequence(next) then last else Ordinary))
}

fn midSequence(state : Shell.Editor.State) -> Bool = match state {
    Shell.Editor.State(pending = Shell.Editor.Plain) -> false
  | _ -> true
}

// Report §11.2: the first input of a session to take a second line says
// how it is run, once, above the region rather than on the prompt, where
// it would move the column the input is typed in.
fn hint(screen : Address(ScreenMsg), reading : Reading, next : Shell.Editor.State)
    -> Bool with m = match reading {
    Reading(hinted = true) -> true
  | Reading(hinted = false) ->
        if String.contains(text(next), "\n") then {
            send(screen, Noted("M-Enter adds a line, Enter runs."));
            true
        } else false
}

// Report §11.2: `Enter` takes another line where the parser cannot
// finish the input, and runs what there is on an empty line, so that an
// input that cannot parse is shown its error rather than asked for more.
// An input with nothing in it runs, though the parser cannot finish it:
// `Enter` at an empty prompt has always given a new one.
fn continues(input : String) -> Bool =
    !String.isEmpty(String.trim(input)) && !lastLineBlank(input) && needsMore(input)

fn lastLineBlank(input : String) -> Bool = match String.lastIndexOf(input, "\n") {
    None -> false
  | Some(i) ->
        String.isEmpty(String.trim(String.slice(input, i + 1, String.size(input) - i - 1)))
}

// Report §11.2: an input the history keeps is appended as the shell
// takes it.
fn remember(screen : Address(ScreenMsg), editing : Shell.Editor.State, keeping : Bool)
    -> Bool with m = {
    let line = text(editing);
    if !keeping || !Shell.Editor.keeps(editing, line) then keeping
    else match Shell.History.add(line) {
        Right(_) -> true
      | Left(why) -> {
            say(screen, "the history is not kept: " <> trouble(why));
            false
        }
    }
}

fn trouble(why : IoError) -> String = match why {
    NotFound -> "the file is not there"
  | Denied -> "permission was denied"
  | Refused -> "the file system refused"
  | Closed -> "the file was closed"
  | Timeout -> "the file system did not answer"
  | Other(text) -> text
}

// What the reader shows is the editor's, since a search shows its own
// prompt and the input it found rather than the line (report §11.2).
fn typing(editing : Shell.Editor.State) -> ScreenMsg = under(editing, [])

// The line being typed with rows shown under it, which the next key
// takes away (report §11.2).
fn under(editing : Shell.Editor.State, rows : List(String)) -> ScreenMsg =
    Typing(text = Shell.Editor.shown(editing), at = Shell.Editor.cursor(editing),
        offered = rows)

fn text(editing : Shell.Editor.State) -> String =
    match editing { Shell.Editor.State(text = text) -> text }

fn keyLoop(state : State, screen : Address(ScreenMsg)) -> Unit with ShellMsg = receive {
    Typed(line) -> { send(screen, Taken); taking(state, screen, line) }
  | Eof -> finish(screen, "\n")
  | Interrupted -> { prompt(screen); keyLoop(state, screen) }
  | Died(down) -> {
        let State(colour = colour) = state;
        reportDeath(screen, colour, down);
        keyLoop(state, screen)
    }
  | ReaderDied(down) -> {
        let State(colour = colour) = state;
        readerDied(screen, colour, down)
    }
  | Done(_) -> keyLoop(state, screen)
}

// Report §11.2: an input, which may have been typed while the one before it
// ran and so waited for it.
fn taking(state : State, screen : Address(ScreenMsg), line : String) -> Unit with ShellMsg =
    match String.trim(line) {
        "" -> { prompt(screen); keyLoop(state, screen) }
      | input -> match submit(state, screen, input) {
            Leave -> finish(screen, "")
          | Continue(state2) -> { prompt(screen); keyLoop(state2, screen) }
        }
    }

fn readerDied(screen : Address(ScreenMsg), colour : Bool, down : Down) -> Unit with ShellMsg =
    match down {
        Down(reason = Returned) -> finish(screen, "")
      | other -> finish(screen, Shell.Style.fault(colour,
            "the shell stopped reading the keyboard: " <> faultLine(other)) <> "\n")
    }

// Report §11.2: what died while the session was reading. In line mode the
// session blocks in `Io.readLine`, so a death is reported before the next
// prompt instead; §6.4 leaves every other message in the mailbox.
fn deaths(screen : Address(ScreenMsg), colour : Bool) -> Unit with ShellMsg = receive {
    Died(down) -> { reportDeath(screen, colour, down); deaths(screen, colour) }
  | after 0 -> Unit
}

// Report §11.2: a process that faults is reported with its spawn site and
// cause; returning, being killed, and the program's end are not news.
fn reportDeath(screen : Address(ScreenMsg), colour : Bool, down : Down) -> Unit with m =
    say(screen, Shell.Style.fault(colour, faultLine(down)))

fn faultLine(down : Down) -> String = match down {
    Down(reason = Fault(text), function = where) -> where <> " faulted: " <> text
  | Down(reason = _, function = where) -> where <> " ended"
}

//
// The reader, when input is not a terminal: lines, no editing
//

fn lineLoop(state : State, screen : Address(ScreenMsg)) -> Unit with ShellMsg = {
    let State(colour = colour) = state;
    deaths(screen, colour);
    prompt(screen);
    match Io.readLine() {
        // the prompt's line is ended by `finish`, as a `:quit` ends it
        None -> finish(screen, "")
      | Some(line) -> match String.trim(line) {
            "" -> lineLoop(state, screen)
          | input -> match submit(state, screen, input) {
                Leave -> finish(screen, "")
              | Continue(state2) -> lineLoop(state2, screen)
            }
        }
    }
}
