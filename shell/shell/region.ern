/// The shell's live region (report §11.2), designed in
/// docs/shell_design.md: the bottom rows of the terminal, a tail of what
/// programs have written, the input being typed under it, and under that
/// what `Tab` or `Shift-Tab` showed. Everything above it is the
/// transcript, written into the terminal and scrolled by it.
///
/// Pure: each event takes the region and what happened, and gives the
/// region after it and the bytes to write. The screen process in `shell.ern` writes
/// them and holds nothing else, which is what makes the drawing testable:
/// the tests at the foot of this file read the bytes. There is a region only
/// at a terminal; elsewhere the screen writes what it is sent as it comes.
///
/// The region never addresses a row, and does not know where on the screen
/// it sits: it moves up from the line being typed to its first row, erases
/// to the end of the screen, and paints again. Only `C-l` clears the screen.
/// Nothing is written below the region, which is what makes the erase
/// correct.

/// What the region shows: the tail of what programs wrote, the part of a
/// line that has arrived without its line feed, the prompt and the input
/// being typed after it with the cursor in it, the rows shown under the
/// input, the row the cursor was left on, how many rows the tail may take,
/// and the terminal's size. Abstract (report §4.4): the region alone keeps
/// the tail within its rows and the cursor within what is typed.
export abstract type Region =
    Region(tail : List(String),
           writing : String,
           prompt : String,
           typed : String,
           cursor : Int,
           offered : List(String),
           resting : Int,
           outputRows : Int,
           size : Terminal.Size)

/// Report §11.2: the tail's rows to begin with, which `:set output n`
/// changes and `0` takes away.
export let tailRows = 5

// Report §11.2: the rows of an input after its first.
let continuation = "... "

// A tab moves to the next multiple of this, which is every terminal's
// default and the only stop the region assumes.
let tabStop = 8

/// A region at the foot of a terminal of that size.
export fn new(size : Terminal.Size) : Region =
    Region(tail = [],
           writing = "",
           prompt = "",
           typed = "",
           cursor = 0,
           offered = [],
           resting = 0,
           outputRows = tailRows,
           size = size)

/// What the session says is committed as it is produced; what it leaves
/// without a line feed is the prompt, which the input is typed after.
export fn said(region : Region, text : String) : #(Region, String) = {
    let #(lines, rest) = split(region.prompt <> text);
    // report §11.2: what the tail holds is committed before what the
    // session says, so that the scrollback reads in the order the lines
    // were written
    painted(Region(..region, prompt = rest, tail = []), region.tail <> lines)
}

/// Report §11.2: a line the shell writes while an input is being typed.
/// It joins the transcript above the region and the prompt stays, since
/// the input that prompt belongs to is still being typed; what the
/// session says takes the prompt with it, an input having finished.
export fn noted(region : Region, text : String) : #(Region, String) =
    painted(Region(..region, tail = []), region.tail <> [text])

/// What a program writes goes to the tail. A line the tail no longer has
/// room for is committed as it leaves, so the terminal's scrollback holds
/// every line in the order it was written. A line not yet ended adds to
/// the tail each row it fills at the window's width, since only its last
/// row can still change, and so the region holds a row of it at most.
export fn wrote(region : Region, text : String) : #(Region, String) = {
    let #(lines, rest) = split(region.writing <> text);
    let #(rows, left) = filled(rest, region.size.columns);
    aged(Region(..region, tail = region.tail <> lines <> rows, writing = left), [])
}

/// The line being typed, where the cursor is in it, and the rows shown
/// under it. Report §11.2: what `Tab` and `Shift-Tab` show stands under
/// the input until the next key, which says what stands there next,
/// nothing for a key that is neither.
export fn typing(region : Region,
                 text : String,
                 cursor : Int,
                 offered : List(String)) : #(Region, String) =
    painted(Region(..region, typed = text, cursor = cursor, offered = offered), [])

/// The input is finished: it joins the transcript, a row for each of its
/// lines with the prompt each was typed after, and the region stops
/// drawing it and what was shown under it.
export fn entered(region : Region) : #(Region, String) =
    match region {
        // nothing typed and no prompt, an input typed ahead and interrupted,
        // leaves no row
        Region(tail = tail, prompt = "", typed = "") ->
            painted(Region(..region, cursor = 0, offered = [], tail = []), tail)
      | Region(tail = tail) ->
            painted(Region(..region, prompt = "", typed = "", cursor = 0, offered = [], tail = []),
                    tail <> inputRows(region))
    }

/// Report §11.2: the session has taken an input, so the prompt it said is
/// spent. An input typed while another ran was entered with no prompt, and
/// the prompt said after that other's answer is not this input's; it goes,
/// so that what the session says next starts a row of its own.
export fn taken(region : Region) : #(Region, String) =
    if String.isEmpty(region.prompt) then
        #(region, "")
    else
        painted(Region(..region, prompt = ""), [])

/// The window has changed; the tail may no longer fit.
export fn resized(region : Region, size : Terminal.Size) : #(Region, String) =
    aged(Region(..region, size = size), [])

/// Report §11.2: `:set output n` gives the tail n rows, and 0 takes the
/// tail away, which interleaves what programs write with the transcript.
export fn output(region : Region, rows : Int) : #(Region, String) =
    aged(Region(..region, outputRows = Int.max(0, rows)), [])

/// Report §11.2: `C-l` gives a clean screen. What is committed stays in
/// the terminal's scrollback; the region is painted again at the top.
export fn cleared(region : Region) : #(Region, String) = {
    let #(region1, bytes) = painted(Region(..region, resting = 0), []);
    #(region1, Ansi.clearScreen <> bytes)
}

//
// Committing and drawing
//

// A line the tail no longer has room for is committed as it leaves, so
// that a tail made shorter, or a window made smaller, loses nothing.
fn aged(region : Region, commits : List(String)) : #(Region, String) = {
    let Region(tail = tail) = region;
    let over = List.size(tail) - height(region);
    if over <= 0 then
        painted(region, commits)
    else
        painted(Region(..region, tail = List.drop(tail, over)), commits <> List.take(tail, over))
}

// Erase the region, commit what has left it, paint it again: one write,
// so that a redraw is never seen half done.
fn painted(region : Region, commits : List(String)) : #(Region, String) = {
    let rows = rowsOf(region);
    let row = resting(region);
    #(Region(..region, resting = row),
      erase(region) <> written(commits) <> paint(rows, row, column(region)))
}

fn erase(region : Region) : String =
    "\r" <> Ansi.up(region.resting) <> Ansi.clearBelow

fn written(lines : List(String)) : String =
    String.join(List.map(lines, fn(line) = line <> "\n"), "")

fn paint(rows : List(String), row : Int, column : Int) : String =
    String.join(rows, "\n") <> Ansi.up(List.size(rows) - 1 - row) <> "\r" <> Ansi.right(column - 1)

// The region's rows: the tail, the rows the input is typed on, and what
// is shown under them. Each is painted with its tabs already spaces,
// since a row is placed by its columns and a tab's width depends on
// where it falls.
fn rowsOf(region : Region) : List(String) =
    List.map(tailRowsOf(region), fn(line) = clip(expand(line), region.size.columns))
        <> screenInput(region)
        <> offeredRows(region)

// Report §11.2: the rows the input takes on the screen. Each of its lines
// wraps at the window's edge, so what is typed past it stays in sight; a
// line that fills the width exactly takes an empty row after it, where
// the cursor goes on.
fn screenInput(region : Region) : List(String) =
    List.flatMap(inputRows(region), fn(line) = onScreen(expand(line), region.size.columns))

fn onScreen(line : String, width : Int) : List(String) = {
    let rows = wrapped(line, width);
    let columns = Terminal.columns(line);
    if width > 0 && columns > 0 && columns % width == 0 then rows <> [""] else rows
}

// Report §11.2: what is shown under the input wraps at the window's
// edge, since a name's type or a sentence cut short says less than it
// did, and takes the rows the screen has left. A line with no room is
// counted on the last row instead.
fn offeredRows(region : Region) : List(String) = {
    let room = region.size.rows - List.size(tailRowsOf(region)) - List.size(screenInput(region));
    let lines = List.map(region.offered, fn(line) = wrapped(expand(line), region.size.columns));
    let all = List.flatMap(lines, fn(rows) = rows);
    if List.size(all) <= room then
        all
    else if room < 1 then
        []
    else {
        let shown = fitting(lines, room - 1);
        let more = List.size(lines) - List.size(shown);
        List.flatMap(shown, fn(rows) = rows) <> ["and " <> Int.toString(more) <> " more"]
    }
}

// The lines, each its rows, that fit in that many rows, from the first.
fn fitting(lines : List(List(String)), room : Int) : List(List(String)) =
    match lines {
        [] -> []
      | rows :: rest -> if List.size(rows) > room then
            []
        else
            rows :: fitting(rest, room - List.size(rows))
    }

// A row cut into rows of the window's width. Each continuation begins
// with every escape sequence the rows before it held, in order, so that
// it is painted as it would have been unbroken.
fn wrapped(line : String, width : Int) : List(String) =
    if Terminal.columns(line) <= width || width < 1 then
        [line]
    else {
        let #(sequences, rest) = past(String.graphemes(line), width, "", false);
        let more = if List.isEmpty(rest) then
            []
        else
            wrapped(sequences <> String.join(rest, ""), width);
        clip(line, width) :: more
    }

// The escape sequences among the first columns of a row, and the row
// after them. A grapheme wider than what is left ends the row, but for
// the first, which a row always takes, so a narrow window moves on.
fn past(graphemes : List(String),
        left : Int,
        sequences : String,
        taken : Bool) : #(String, List(String)) =
    match sequence(graphemes) {
        Some(#(escape, remaining)) -> past(remaining, left, sequences <> escape, taken)
      | None -> match graphemes {
            grapheme :: rest when fits(grapheme, left, taken) ->
                past(rest, left - Terminal.columns(grapheme), sequences, true)
          | _ -> #(sequences, graphemes)
        }
    }

// Whether the grapheme goes on the row with that many columns left.
fn fits(grapheme : String, left : Int, taken : Bool) : Bool = {
    let columns = Terminal.columns(grapheme);
    columns <= left || !taken && columns > 0
}

// An escape sequence at the head of the graphemes, `ESC [` to its final
// character, and what follows it.
fn sequence(graphemes : List(String)) : Optional(#(String, List(String))) =
    match graphemes {
        "\u{1b}" :: "[" :: rest -> {
            let remaining = afterSequence(rest);
            let escape = List.take(graphemes, List.size(graphemes) - List.size(remaining));
            Some(#(String.join(escape, ""), remaining))
        }
      | _ -> None
    }

fn afterSequence(graphemes : List(String)) : List(String) =
    match graphemes {
        [] -> []
      | grapheme :: rest -> if isFinal(grapheme) then rest else afterSequence(rest)
    }

// The character that ends a sequence, `m` among them.
fn isFinal(grapheme : String) : Bool =
    match String.toList(grapheme) {
        [char] -> Char.toInt(char) >= 0x40 && Char.toInt(char) <= 0x7E
      | _ -> false
    }

fn tailRowsOf(region : Region) : List(String) = {
    let all = if String.isEmpty(region.writing) then
        region.tail
    else
        region.tail <> [region.writing];
    List.drop(all, Int.max(0, List.size(all) - height(region)))
}

// Report §11.2: an input may span lines, the first typed after the
// prompt and the rest after `... `. `String.lines` is not this split: a
// text that ends in a line feed is being typed on a new empty row, and
// that row is shown.
fn inputRows(region : Region) : List(String) =
    match String.split(region.typed, "\n") {
        [] -> [region.prompt]
      | first :: rest ->
            (region.prompt <> pictured(first))
                :: List.map(rest, fn(line) = continuation <> pictured(line))
    }

// Report §11.2, §11.5: a control character of what is typed is painted as
// its picture, `␛` for U+001B, one of U+0080 to U+009F as U+FFFD, so that
// none reaches the terminal as itself, a paste's or the history's among
// them; the input keeps it as typed. A tab is painted by `expand`.
fn pictured(text : String) : String =
    String.join(List.map(String.toList(text), picture), "")

fn picture(char : Char) : String = {
    let code = Char.toInt(char);
    if code == 9 || code >= 32 && code < 127 || code > 159 then
        Char.toString(char)
    else if code < 32 then
        Optional.withDefault(Optional.map(Char.fromInt(0x2400 + code), Char.toString), "\u{FFFD}")
    else if code == 127 then
        "\u{2421}"
    else
        "\u{FFFD}"
}

// The tail's height: what `:set output` asks for, and never more than
// the screen has room for, the input having the last word.
fn height(region : Region) : Int =
    Int.min(region.outputRows, Int.max(0, region.size.rows / 2 - 1))

// The row of the region the cursor rests on: the tail's rows, the screen
// rows of the input's lines before the cursor's, and the rows the cursor's
// own line wraps onto before it.
fn resting(region : Region) : Int = {
    let lineIndex = List.size(String.split(String.slice(region.typed, 0, region.cursor), "\n")) - 1;
    let earlier =
        List.flatMap(List.take(inputRows(region), lineIndex),
                     fn(row) = onScreen(expand(row), region.size.columns));
    List.size(tailRowsOf(region))
        + List.size(earlier)
        + columnsBefore(region) / Int.max(1, region.size.columns)
}

// The column the cursor rests in, on the row its line wraps onto: what the
// line holds before the cursor, tabs and all, is as many columns as it
// paints.
fn column(region : Region) : Int =
    columnsBefore(region) % Int.max(1, region.size.columns) + 1

// The columns before the cursor on its line, the prompt or `... ` among
// them.
fn columnsBefore(region : Region) : Int = {
    let before = String.slice(region.typed, 0, region.cursor);
    let head = match String.lastIndexOf(before, "\n") {
        None -> region.prompt <> pictured(before)
      | Some(index) ->
            continuation
                <> pictured(String.slice(before, index + 1, String.size(before) - index - 1))
    };
    Terminal.columns(expand(head))
}

// Report §11.2: a tab is painted as the spaces to the next stop. The
// region places its rows and its cursor by column, so it writes what it
// has measured rather than leaving the tab to the terminal's own stops;
// every other grapheme takes the columns `Terminal.columns` gives it.
fn expand(row : String) : String =
    expanding(String.graphemes(row), "")

fn expanding(graphemes : List(String), acc : String) : String =
    match graphemes {
        [] -> acc
      | "\t" :: rest ->
            expanding(rest, acc <> String.repeat(" ", tabStop - Terminal.columns(acc) % tabStop))
      | grapheme :: rest -> expanding(rest, acc <> grapheme)
    }

// A row cut to the window's width keeps its escape sequences whole, and
// one cut short after a sequence ends with the reset, so the colour of
// what was cut off does not run on into the next row: the sequences cut
// may be any, and the reset is the one sequence that ends them all.
fn clip(line : String, width : Int) : String =
    if Terminal.columns(line) <= width then
        line
    else
        clipping(String.graphemes(line), width, "", false, false)

fn clipping(graphemes : List(String),
            left : Int,
            acc : String,
            inStyle : Bool,
            taken : Bool) : String =
    match sequence(graphemes) {
        Some(#(escape, remaining)) -> clipping(remaining, left, acc <> escape, true, taken)
      | None -> match graphemes {
            grapheme :: rest when fits(grapheme, left, taken) ->
                clipping(rest, left - Terminal.columns(grapheme), acc <> grapheme, inStyle, true)
          | _ -> if inStyle then acc <> "\u{1b}[0m" else acc
        }
    }

// The rows a line fills at the window's width, as the terminal wraps it,
// and what is left of it. A grapheme wider than what is left of a row
// begins the next, and a tab takes the columns to its stop and never
// passes the edge. A row after the first begins with the escape sequences
// since the last reset, the style in force, so that it is painted as it
// would have been unbroken.
fn filled(line : String, width : Int) : #(List(String), String) =
    if width < 1 then #([], line) else filling(String.graphemes(line), width, 0, "", "", [])

fn filling(graphemes : List(String),
           width : Int,
           used : Int,
           row : String,
           style : String,
           rows : List(String)) : #(List(String), String) =
    match sequence(graphemes) {
        Some(#(escape, remaining)) ->
            filling(remaining, width, used, row <> escape, styled(style, escape), rows)
      | None -> match graphemes {
            [] -> #(List.reverse(rows), row)
          | grapheme :: rest -> {
                let columns = if grapheme == "\t" then
                    tabStop - used % tabStop
                else
                    Terminal.columns(grapheme);
                if used > 0 && (used >= width || grapheme != "\t" && used + columns > width) then
                    filling(graphemes, width, 0, style, style, row :: rows)
                else
                    filling(rest,
                            width,
                            Int.min(used + columns, width),
                            row <> grapheme,
                            style,
                            rows)
            }
        }
    }

// The style after a sequence: a reset ends every sequence before it.
fn styled(style : String, escape : String) : String =
    if escape == "\u{1b}[0m" || escape == "\u{1b}[m" then "" else style <> escape

// The text up to each line feed, and what is left without one.
fn split(text : String) : #(List(String), String) =
    match String.split(text, "\n") {
        [] -> #([], "")
      | parts -> #(List.dropLast(parts, 1), Optional.withDefault(List.last(parts), ""))
    }

//
// The tests (report §9.3), run by `ern test`, which `make test` does.
// The region is pure, so a test reads the bytes it would have written.
//

let spansRows =
    Test.Case(name = "an input takes a row for each of its lines",
              run = fn() = rowsAre(inputRows(typed("a\nb", 3)), ["> a", "... b"]))

let showsTheEmptyRow =
    Test.Case(name = "a text that ends in a line feed shows its empty row",
              run = fn() = rowsAre(inputRows(typed("a\n", 2)), ["> a", "... "]))

let restsWhereTyped =
    Test.Case(name = "the cursor rests on the row and column it is typed at",
              run = fn() = restsAt(typed("a\nbc", 4), 1, 7))

// Report §11.2, §11.5. A regression test: a paste's OSC reached the
// terminal as itself, and the cursor was placed past what it painted
let picturesControls =
    Test.Case(name = "a control character typed or pasted is painted as its picture", run = fn() = {
        let region = typed("x\u{1b}]0;t\u{7}y\u{7f}\u{85}", 10);
        match rowsAre(inputRows(region), ["> x\u{241b}]0;t\u{2407}y\u{2421}\u{fffd}"]) {
            Test.Passed -> restsAt(region, 0, 13)
          | failed -> failed
        }
    })

let restsOnTheFirstRow =
    Test.Case(name = "a one-line input rests after its prompt",
              run = fn() = restsAt(typed("abc", 2), 0, 5))

let wideGlyphs =
    Test.Case(name = "a wide glyph takes two columns and is never split",
              run = fn() =
                  rowsAre(wrapped("中中中", 4) <> [clip("a中b", 2)] <> wrapped("中中", 1),
                          ["中中", "中", "a", "中", "中"]))

let restsAfterWide =
    Test.Case(name = "the cursor rests after a wide glyph's two columns",
              run = fn() = restsAt(typed("中a", 2), 0, 6))

let escapesTakeNoColumn = Test.Case(name = "an escape sequence takes no column", run = fn() = {
    let text = "a\u{1b}[36mbc\u{1b}[0md";
    if Terminal.columns(text) == 4 then
        Test.Passed
    else
        Test.Failed(Int.toString(Terminal.columns(text)))
})

let clipKeepsSequences =
    Test.Case(name = "a row cut short keeps its sequences and resets",
              run = fn() = same(clip("ab\u{1b}[36mcdef\u{1b}[0m", 4), "ab\u{1b}[36mcd\u{1b}[0m"))

let tabsAfterSequences =
    Test.Case(name = "a tab stop is counted without escape sequences",
              run = fn() = same(expand("\u{1b}[36ma\u{1b}[0m\tb"), "\u{1b}[36ma\u{1b}[0m       b"))

let takenPrompt =
    Test.Case(name = "a prompt spent on no input is dropped before the next answer", run = fn() = {
        let region = new(Terminal.Size(rows = 24, columns = 80));
        let #(region1, _) = said(region, "1 : Int\n> ");
        let #(region2, _) = taken(region1);
        let #(_, bytes) = said(region2, "4 : Int\n> ");
        if String.indexOf(bytes, "> 4 : Int") == None
            && String.indexOf(bytes, "4 : Int") != None then
            Test.Passed
        else
            Test.Failed(String.replace(bytes, "\u{1b}", "ESC"))
    })

let expandsTabs =
    Test.Case(name = "a tab is painted to the next stop",
              run = fn() = rowsAre([expand("> a\tb"), expand("\t.")], ["> a     b", "        ."]))

let restsAfterATab =
    Test.Case(name = "the cursor rests where the tab left it",
              run = fn() = restsAt(typed("a\tb", 2), 0, 9))

let paintsTheLine = Test.Case(name = "typing erases the region and paints it again", run = fn() = {
    let #(_, bytes) = typing(prompted(), "hi", 2, []);
    // the region is one row, so nothing is climbed; the cursor is put
    // after the prompt and what is typed
    same(bytes, "\r\u{1b}[J> hi\r\u{1b}[4C")
})

let commitsWhatIsEntered =
    Test.Case(name = "an input entered joins the transcript, a row a line", run = fn() = {
        let #(typed, _) = typing(prompted(), "a\nb", 3, []);
        let #(_, bytes) = entered(typed);
        same(bytes, "\r\u{1b}[1A\u{1b}[J> a\n... b\n\r")
    })

let offersUnderTheInput =
    Test.Case(name = "what Tab shows stands under the input, the cursor in it", run = fn() = {
        let #(region, bytes) = typing(prompted(), "Li", 2, ["List.map : a", "List.size : b"]);
        // three rows painted, and the cursor climbs the two under it
        if rowsOf(region) == ["> Li", "List.map : a", "List.size : b"] && resting(region) == 0 then
            same(bytes, offeredBytes)
        else
            Test.Failed(String.join(rowsOf(region), " | "))
    })

// What typing "Li" writes with two rows offered under it.
let offeredBytes = "\r\u{1b}[J> Li\nList.map : a\nList.size : b\u{1b}[2A\r\u{1b}[4C"

let nextKeyTakesItAway = Test.Case(name = "the next key takes away what Tab showed", run = fn() = {
    let #(region, _) = typing(prompted(), "Li", 2, ["List.map : a"]);
    let #(region1, _) = typing(region, "Lis", 3, []);
    rowsAre(rowsOf(region1), ["> Lis"])
})

let enteredTakesItAway =
    Test.Case(name = "an input entered takes away what Tab showed", run = fn() = {
        let #(region, _) = typing(prompted(), "Li", 2, ["List.map : a"]);
        let #(region1, bytes) = entered(region);
        if rowsOf(region1) == [""] && String.indexOf(bytes, "List.map") == None then
            Test.Passed
        else
            Test.Failed(String.join(rowsOf(region1), " | "))
    })

let offerWraps = Test.Case(name = "a row shown under the input wraps at the edge", run = fn() = {
    let #(region, _) = said(new(Terminal.Size(rows = 24, columns = 6)), "> ");
    let #(region1, _) = typing(region, "", 0, ["abcdefgh"]);
    rowsAre(rowsOf(region1), ["> ", "abcdef", "gh"])
})

let wrapKeepsColour =
    Test.Case(name = "a wrapped row is coloured on as it was",
              run = fn() =
                  rowsAre(wrapped("\u{1b}[1mabcdefgh\u{1b}[0m", 6),
                          ["\u{1b}[1mabcdef\u{1b}[0m", "\u{1b}[1mgh\u{1b}[0m"]))

let offerCounted = Test.Case(name = "what the screen has no room for is counted", run = fn() = {
    // six rows: one for the input, four for lines, one for the count
    let region = new(Terminal.Size(rows = 6, columns = 80));
    let #(region1, _) = said(region, "> ");
    let #(region2, _) = typing(region1, "", 0, ["a", "b", "c", "d", "e", "f", "g"]);
    rowsAre(rowsOf(region2), ["> ", "a", "b", "c", "d", "and 3 more"])
})

let enteredEmpty = Test.Case(name = "nothing typed after no prompt leaves no row", run = fn() = {
    let #(_, bytes) = entered(typed("", 0));
    let #(region, _) = said(new(Terminal.Size(rows = 24, columns = 80)), "");
    let #(_, none) = entered(region);
    // a row committed would end in a line feed
    if String.contains(bytes, "> \n") && !String.contains(none, "\n") then
        Test.Passed
    else
        Test.Failed(String.replace(none, "\u{1b}", "ESC"))
})

let wrapsTheInput =
    Test.Case(name = "a line wider than the screen wraps, the cursor after it", run = fn() = {
        let #(region, _) = said(new(Terminal.Size(rows = 24, columns = 10)), "> ");
        let #(region1, _) = typing(region, "abcdefghijkl", 12, []);
        // `> ` and twelve characters are fourteen columns: two rows
        if rowsOf(region1) == ["> abcdefgh", "ijkl"]
            && resting(region1) == 1
            && column(region1) == 5 then
            Test.Passed
        else
            Test.Failed(String.join(rowsOf(region1), " | ")
                            <> " at "
                            <> Int.toString(resting(region1))
                            <> ","
                            <> Int.toString(column(region1)))
    })

let fillsTheWidth =
    Test.Case(name = "a line that fills the width puts the cursor on the next row", run = fn() = {
        let #(region, _) = said(new(Terminal.Size(rows = 24, columns = 10)), "> ");
        let #(region1, _) = typing(region, "abcdefgh", 8, []);
        if rowsOf(region1) == ["> abcdefgh", ""]
            && resting(region1) == 1
            && column(region1) == 1 then
            Test.Passed
        else
            Test.Failed(String.join(rowsOf(region1), " | "))
    })

let unendedRows =
    Test.Case(name = "a line not yet ended gives the tail each row it fills", run = fn() = {
        let region = new(Terminal.Size(rows = 24, columns = 10));
        let #(region1, _) = wrote(region, "abcdefghijklmnopqrstuvwxy");
        let #(begun, _) = wrote(new(Terminal.Size(rows = 24, columns = 10)), "abcdefg");
        let #(continued, _) = wrote(begun, "hijklm");
        if tailRowsOf(region1) == ["abcdefghij", "klmnopqrst", "uvwxy"]
            && tailRowsOf(continued) == ["abcdefghij", "klm"] then
            Test.Passed
        else
            Test.Failed(String.join(tailRowsOf(region1) <> ["/"] <> tailRowsOf(continued), " | "))
    })

let unendedStyle =
    Test.Case(name = "a row of a line not yet ended begins with the style in force", run = fn() = {
        let #(rows, left) = filled("\u{1b}[31mabcdefghijkl", 10);
        let #(resetRows, resetLeft) = filled("\u{1b}[31mab\u{1b}[0mcdefghijkl", 10);
        if rows == ["\u{1b}[31mabcdefghij"]
            && left == "\u{1b}[31mkl"
            && resetRows == ["\u{1b}[31mab\u{1b}[0mcdefghij"]
            && resetLeft == "kl" then
            Test.Passed
        else
            Test.Failed(String.replace(String.join(rows <> [left] <> resetRows <> [resetLeft],
                                                   " | "),
                                       "\u{1b}",
                                       "ESC"))
    })

let unendedHeld =
    Test.Case(name = "a line that never ends holds a row of the region at most", run = fn() = {
        let region =
            List.foldLeft(List.repeat(".", 1000),
                          new(Terminal.Size(rows = 24, columns = 10)),
                          fn(acc, dot) = {
                              let #(next, _) = wrote(acc, dot);
                              next
                          });
        if String.size(region.writing) <= 10 then
            Test.Passed
        else
            Test.Failed(Int.toString(String.size(region.writing)))
    })

// A region with a prompt written, which is where an input is typed.
fn prompted() : Region = {
    let #(region, _) = said(new(Terminal.Size(rows = 24, columns = 80)), "> ");
    region
}

// A region with an input being typed in it, without the bytes that drew
// it: the geometry is what these tests read.
fn typed(text : String, cursor : Int) : Region = {
    let #(region, _) = typing(prompted(), text, cursor, []);
    region
}

fn rowsAre(rows : List(String), expected : List(String)) : Test.Result =
    if rows == expected then Test.Passed else Test.Failed(String.join(rows, " | "))

fn restsAt(region : Region, expectedRow : Int, expectedColumn : Int) : Test.Result =
    if resting(region) == expectedRow && column(region) == expectedColumn then
        Test.Passed
    else
        Test.Failed("row "
                        <> Int.toString(resting(region))
                        <> ", column "
                        <> Int.toString(column(region)))

fn same(bytes : String, expected : String) : Test.Result =
    if bytes == expected then Test.Passed else Test.Failed(String.replace(bytes, "\u{1b}", "ESC"))
