//
// The shell's live region (report §11.2), designed in
// docs/shell_design.md: the bottom rows of the terminal, a tail of what
// programs have written, the input being typed under it, and under that
// what `Tab` or `Shift-Tab` showed. Everything above it is the
// transcript, written into the terminal and scrolled by it.
//
// Pure: each event takes the region and what happened, and gives the
// region after it and the bytes to write. The screen process in `shell.ern` writes
// them and holds nothing else, which is what makes the drawing testable:
// the tests at the foot of this file read the bytes. There is a region only
// at a terminal; elsewhere the screen writes what it is sent as it comes.
//
// The region never addresses a row, and does not know where on the screen
// it sits: it moves up from the line being typed to its first row, erases
// to the end of the screen, and paints again. Only `C-l` clears the screen.
// Nothing is written below the region, which is what makes the erase
// correct.
//

// What the region shows: the tail of what programs wrote, the part of a
// line that has arrived without its line feed, the prompt and the input
// being typed after it with the cursor in it, the rows shown under the
// input, the row the cursor was left on, how many rows the tail may take,
// and the terminal's size. Abstract (report §4.4): the region alone keeps
// the tail within its rows and the cursor within what is typed.
export abstract type Region = Region(
    tail : List(String),
    writing : String,
    prompt : String,
    typed : String,
    at : Int,
    offered : List(String),
    resting : Int,
    output : Int,
    size : Terminal.Size
)

// Report §11.2: the tail's rows to begin with, which `:set output n`
// changes and `0` takes away.
export let tailRows = 5

// Report §11.2: the rows of an input after its first.
let continuation = "... "

// A tab moves to the next multiple of this, which is every terminal's
// default and the only stop the region assumes.
let tabStop = 8

// A region at the foot of a terminal of that size.
export fn new(size : Terminal.Size) -> Region =
    Region(tail = [], writing = "", prompt = "", typed = "", at = 0, offered = [], resting = 0,
        output = tailRows, size = size)

// What the session says is committed as it is produced; what it leaves
// without a line feed is the prompt, which the input is typed after.
export fn said(r : Region, text : String) -> #(Region, String) = {
    let #(lines, rest) = split(r.prompt <> text);
    // report §11.2: what the tail holds is committed before what the
    // session says, so that the scrollback reads in the order the lines
    // were written
    painted(Region(..r, prompt = rest, tail = []), r.tail <> lines)
}

// Report §11.2: a line the shell writes while an input is being typed.
// It joins the transcript above the region and the prompt stays, since
// the input that prompt belongs to is still being typed; what the
// session says takes the prompt with it, an input having finished.
export fn noted(r : Region, text : String) -> #(Region, String) = {
    painted(Region(..r, tail = []), r.tail <> [text])
}

// What a program writes goes to the tail. A line the tail no longer has
// room for is committed as it leaves, so the terminal's scrollback holds
// every line in the order it was written.
export fn wrote(r : Region, text : String) -> #(Region, String) = {
    let #(lines, rest) = split(r.writing <> text);
    aged(Region(..r, tail = r.tail <> lines, writing = rest), [])
}

// The line being typed, where the cursor is in it, and the rows shown
// under it. Report §11.2: what `Tab` and `Shift-Tab` show stands under
// the input until the next key, which says what stands there next,
// nothing for a key that is neither.
export fn typing(r : Region, text : String, at : Int, offered : List(String))
    -> #(Region, String) =
    painted(Region(..r, typed = text, at = at, offered = offered), [])

// The input is finished: it joins the transcript, a row for each of its
// lines with the prompt each was typed after, and the region stops
// drawing it and what was shown under it.
export fn entered(r : Region) -> #(Region, String) = match r {
    // nothing typed and no prompt, an input typed ahead and interrupted,
    // leaves no row
    Region(tail = tail, prompt = "", typed = "") ->
        painted(Region(..r, at = 0, offered = [], tail = []), tail)
  | Region(tail = tail) ->
        painted(Region(..r, prompt = "", typed = "", at = 0, offered = [], tail = []),
            tail <> inputRows(r))
}

// Report §11.2: the session has taken an input, so the prompt it said is
// spent. An input typed while another ran was entered with no prompt, and
// the prompt said after that other's answer is not this input's; it goes,
// so that what the session says next starts a row of its own.
export fn taken(r : Region) -> #(Region, String) = {
    if String.isEmpty(r.prompt) then #(r, "") else painted(Region(..r, prompt = ""), [])
}

// The window has changed; the tail may no longer fit.
export fn resized(r : Region, size : Terminal.Size) -> #(Region, String) =
    aged(Region(..r, size = size), [])

// Report §11.2: `:set output n` gives the tail n rows, and 0 takes the
// tail away, which interleaves what programs write with the transcript.
export fn output(r : Region, rows : Int) -> #(Region, String) =
    aged(Region(..r, output = Int.max(0, rows)), [])

// Report §11.2: `C-l` gives a clean screen. What is committed stays in
// the terminal's scrollback; the region is painted again at the top.
export fn cleared(r : Region) -> #(Region, String) = {
    let #(r2, bytes) = painted(Region(..r, resting = 0), []);
    #(r2, "\u{1b}[2J\u{1b}[H" <> bytes)
}

//
// Committing and drawing
//

// A line the tail no longer has room for is committed as it leaves, so
// that a tail made shorter, or a window made smaller, loses nothing.
fn aged(r : Region, commits : List(String)) -> #(Region, String) = {
    let Region(tail = tail) = r;
    let over = List.size(tail) - height(r);
    if over <= 0 then painted(r, commits)
    else painted(Region(..r, tail = List.drop(tail, over)),
        commits <> List.take(tail, over))
}

// Erase the region, commit what has left it, paint it again: one write,
// so that a redraw is never seen half done.
fn painted(r : Region, commits : List(String)) -> #(Region, String) = {
    let rows = rowsOf(r);
    let row = resting(r);
    #(Region(..r, resting = row), erase(r) <> written(commits) <> paint(rows, row, column(r)))
}

fn erase(r : Region) -> String = "\r" <> up(r.resting) <> "\u{1b}[0J"

fn written(lines : List(String)) -> String =
    String.join(List.map(lines, fn(line) = line <> "\n"), "")

fn paint(rows : List(String), row : Int, at : Int) -> String =
    String.join(rows, "\n") <> up(List.size(rows) - 1 - row) <> "\r" <> right(at - 1)

// The region's rows: the tail, the rows the input is typed on, and what
// is shown under them. Each is painted with its tabs already spaces,
// since a row is placed by its columns and a tab's width depends on
// where it falls.
fn rowsOf(r : Region) -> List(String) =
    List.map(tailRowsOf(r), fn(line) = clip(expand(line), r.size.columns)) <> screenInput(r)
        <> offeredRows(r)

// Report §11.2: the rows the input takes on the screen. Each of its lines
// wraps at the window's edge, so what is typed past it stays in sight; a
// line that fills the width exactly takes an empty row after it, where
// the cursor goes on.
fn screenInput(r : Region) -> List(String) =
    List.flatMap(inputRows(r), fn(line) = onScreen(expand(line), r.size.columns))

fn onScreen(line : String, w : Int) -> List(String) = {
    let rows = wrapped(line, w);
    if w > 0 && columns(line) > 0 && columns(line) % w == 0 then rows <> [""] else rows
}

// Report §11.2: what is shown under the input wraps at the window's
// edge, since a name's type or a sentence cut short says less than it
// did, and takes the rows the screen has left. A line with no room is
// counted on the last row instead.
fn offeredRows(r : Region) -> List(String) = {
    let room = r.size.rows - List.size(tailRowsOf(r)) - List.size(screenInput(r));
    let lines = List.map(r.offered, fn(line) = wrapped(expand(line), r.size.columns));
    let all = List.flatMap(lines, fn(rows) = rows);
    if List.size(all) <= room then all
    else if room < 1 then []
    else {
        let shown = fitting(lines, room - 1);
        let left = List.size(lines) - List.size(shown);
        List.flatMap(shown, fn(rows) = rows) <> ["and " <> Int.toString(left) <> " more"]
    }
}

// The lines, each its rows, that fit in that many rows, from the first.
fn fitting(lines : List(List(String)), room : Int) -> List(List(String)) = match lines {
    [] -> []
  | rows :: rest ->
        if List.size(rows) > room then []
        else rows :: fitting(rest, room - List.size(rows))
}

// A row cut into rows of the window's width. Each continuation begins
// with every escape sequence the rows before it held, in order, so that
// it is painted as it would have been unbroken.
fn wrapped(line : String, width : Int) -> List(String) =
    if columns(line) <= width || width < 1 then [line]
    else {
        let #(sequences, rest) = past(String.toList(line), width, "");
        clip(line, width) :: wrapped(sequences <> String.fromList(rest), width)
    }

// The escape sequences among the first columns of a row, and the row
// after them.
fn past(chars : List(Char), left : Int, sequences : String) -> #(String, List(Char)) =
    match chars {
        '\u{1b}' :: '[' :: rest -> {
            let tail = afterSequence(rest);
            let sequence = String.fromList(List.take(chars, List.size(chars) - List.size(tail)));
            past(tail, left, sequences <> sequence)
        }
      | _ :: rest when left > 0 -> past(rest, left - 1, sequences)
      | _ -> #(sequences, chars)
    }

fn tailRowsOf(r : Region) -> List(String) = {
    let all = if String.isEmpty(r.writing) then r.tail else r.tail <> [r.writing];
    List.drop(all, Int.max(0, List.size(all) - height(r)))
}

// Report §11.2: an input may span lines, the first typed after the
// prompt and the rest after `... `. `String.lines` is not this split: a
// text that ends in a line feed is being typed on a new empty row, and
// that row is shown.
fn inputRows(r : Region) -> List(String) = match String.split(r.typed, "\n") {
    [] -> [r.prompt]
  | first :: rest -> (r.prompt <> first) :: List.map(rest, fn(line) = continuation <> line)
}

// The tail's height: what `:set output` asks for, and never more than
// the screen has room for, the input having the last word.
fn height(r : Region) -> Int = Int.min(r.output, Int.max(0, r.size.rows / 2 - 1))

// The row of the region the cursor rests on: the tail's rows, the screen
// rows of the input's lines before the cursor's, and the rows the cursor's
// own line wraps onto before it.
fn resting(r : Region) -> Int = {
    let line = List.size(String.split(String.slice(r.typed, 0, r.at), "\n")) - 1;
    let earlier = List.flatMap(List.take(inputRows(r), line), fn(row) =
        onScreen(expand(row), r.size.columns));
    List.size(tailRowsOf(r)) + List.size(earlier) + offset(r) / Int.max(1, r.size.columns)
}

// The column the cursor rests in, on the row its line wraps onto: what the
// line holds before the cursor, tabs and all, is as many columns as it
// paints.
fn column(r : Region) -> Int = offset(r) % Int.max(1, r.size.columns) + 1

// The columns before the cursor on its line, the prompt or `... ` among
// them.
fn offset(r : Region) -> Int = {
    let before = String.slice(r.typed, 0, r.at);
    let head = match String.lastIndexOf(before, "\n") {
        None -> r.prompt <> before
      | Some(i) -> continuation <> String.slice(before, i + 1, String.size(before) - i - 1)
    };
    columns(expand(head))
}

// Report §11.2: a tab is painted as the spaces to the next stop. The
// region places its rows and its cursor by column, so it writes what it
// has measured rather than leaving the tab to the terminal's own stops.
// One character is one column here, which a wide glyph is not; that is
// the design note's open question, and this is the function it changes.
fn expand(row : String) -> String = expanding(String.toList(row), "")

fn expanding(chars : List(Char), done : String) -> String = match chars {
    [] -> done
  | c :: rest ->
        if c == '\t' then
            expanding(rest, done <> String.repeat(" ", tabStop - columns(done) % tabStop))
        else expanding(rest, done <> Char.toString(c))
}

// Report §11.2: an escape sequence, `ESC [` and what follows up to its
// final character, sets how the terminal paints what comes after it and
// takes no column. A row the shell colours is measured without them.
fn columns(row : String) -> Int = counting(String.toList(row), 0)

fn counting(chars : List(Char), n : Int) -> Int = match chars {
    [] -> n
  | '\u{1b}' :: '[' :: rest -> counting(afterSequence(rest), n)
  | _ :: rest -> counting(rest, n + 1)
}

fn afterSequence(chars : List(Char)) -> List(Char) = match chars {
    [] -> []
  | c :: rest -> if final(c) then rest else afterSequence(rest)
}

// The character that ends a sequence, `m` among them.
fn final(c : Char) -> Bool = Char.toInt(c) >= 0x40 && Char.toInt(c) <= 0x7E

// A row cut to the window's width keeps its escape sequences whole, and
// one cut short after a sequence ends with the reset, so the colour of
// what was cut off does not run on into the next row.
fn clip(line : String, width : Int) -> String =
    if columns(line) <= width then line else clipping(String.toList(line), width, "", false)

fn clipping(chars : List(Char), left : Int, done : String, styled : Bool) -> String =
    match chars {
        '\u{1b}' :: '[' :: rest -> {
            let tail = afterSequence(rest);
            let sequence = String.fromList(List.take(chars, List.size(chars) - List.size(tail)));
            clipping(tail, left, done <> sequence, true)
        }
      | c :: rest when left > 0 -> clipping(rest, left - 1, done <> Char.toString(c), styled)
      | _ -> if styled then done <> "\u{1b}[0m" else done
    }

fn up(n : Int) -> String = if n <= 0 then "" else "\u{1b}[" <> Int.toString(n) <> "A"

fn right(n : Int) -> String = if n <= 0 then "" else "\u{1b}[" <> Int.toString(n) <> "C"

// The text up to each line feed, and what is left without one.
fn split(text : String) -> #(List(String), String) = match String.split(text, "\n") {
    [] -> #([], "")
  | parts -> #(List.dropLast(parts), Optional.withDefault(List.last(parts), ""))
}

//
// The tests (report §9.3), run by `ern test`, which `make test` does.
// The region is pure, so a test reads the bytes it would have written.
//

let spansRows = Test(name = "an input takes a row for each of its lines", run = fn() =
    rowsAre(inputRows(typed("a\nb", 3)), ["> a", "... b"]))

let showsTheEmptyRow = Test(name = "a text that ends in a line feed shows its empty row",
    run = fn() =
        rowsAre(inputRows(typed("a\n", 2)), ["> a", "... "]))

let restsWhereTyped = Test(name = "the cursor rests on the row and column it is typed at",
    run = fn() = at(typed("a\nbc", 4), 1, 7))

let restsOnTheFirstRow = Test(name = "a one-line input rests after its prompt", run = fn() =
    at(typed("abc", 2), 0, 5))

let escapesTakeNoColumn = Test(name = "an escape sequence takes no column", run = fn() =
    if columns("a\u{1b}[36mbc\u{1b}[0md") == 4 then Passed
    else Failed(Int.toString(columns("a\u{1b}[36mbc\u{1b}[0md"))))

let clipKeepsSequences = Test(name = "a row cut short keeps its sequences and resets", run = fn() =
    same(clip("ab\u{1b}[36mcdef\u{1b}[0m", 4), "ab\u{1b}[36mcd\u{1b}[0m"))

let tabsAfterSequences = Test(name = "a tab stop is counted without escape sequences",
    run = fn() = same(expand("\u{1b}[36ma\u{1b}[0m\tb"), "\u{1b}[36ma\u{1b}[0m       b"))

let takenPrompt = Test(name = "a prompt spent on no input goes before the next answer",
    run = fn() = {
        let r0 = new(Terminal.Size(rows = 24, columns = 80));
        let #(r1, _) = said(r0, "1 : Int\n> ");
        let #(r2, _) = taken(r1);
        let #(_, bytes) = said(r2, "4 : Int\n> ");
        if String.indexOf(bytes, "> 4 : Int") == None && String.indexOf(bytes, "4 : Int") != None
        then Passed else Failed(String.replace(bytes, "\u{1b}", "ESC"))
    })

let expandsTabs = Test(name = "a tab is painted to the next stop", run = fn() =
    rowsAre([expand("> a\tb"), expand("\t.")], ["> a     b", "        ."]))

let restsAfterATab = Test(name = "the cursor rests where the tab left it", run = fn() =
    at(typed("a\tb", 2), 0, 9))

let paintsTheLine = Test(name = "typing erases the region and paints it again", run = fn() = {
    let #(_, bytes) = typing(prompted(), "hi", 2, []);
    // the region is one row, so nothing is climbed; the cursor is put
    // after the prompt and what is typed
    same(bytes, "\r\u{1b}[0J> hi\r\u{1b}[4C")
})

let commitsWhatIsEntered = Test(name = "an input entered joins the transcript, a row a line",
    run = fn() = {
        let #(typed, _) = typing(prompted(), "a\nb", 3, []);
        let #(_, bytes) = entered(typed);
        same(bytes, "\r\u{1b}[1A\u{1b}[0J> a\n... b\n\r")
    })

let offersUnderTheInput = Test(name = "what Tab shows stands under the input, the cursor in it",
    run = fn() = {
        let #(r, bytes) = typing(prompted(), "Li", 2, ["List.map : a", "List.size : b"]);
        // three rows painted, and the cursor climbs the two under it
        if rowsOf(r) == ["> Li", "List.map : a", "List.size : b"] && resting(r) == 0
        then same(bytes, "\r\u{1b}[0J> Li\nList.map : a\nList.size : b\u{1b}[2A\r\u{1b}[4C")
        else Failed(String.join(rowsOf(r), " | "))
    })

let nextKeyTakesItAway = Test(name = "the next key takes away what Tab showed", run = fn() = {
    let #(r1, _) = typing(prompted(), "Li", 2, ["List.map : a"]);
    let #(r2, _) = typing(r1, "Lis", 3, []);
    rowsAre(rowsOf(r2), ["> Lis"])
})

let enteredTakesItAway = Test(name = "an input entered takes away what Tab showed",
    run = fn() = {
        let #(r1, _) = typing(prompted(), "Li", 2, ["List.map : a"]);
        let #(r2, bytes) = entered(r1);
        if rowsOf(r2) == [""] && String.indexOf(bytes, "List.map") == None then Passed
        else Failed(String.join(rowsOf(r2), " | "))
    })

let offerWraps = Test(name = "a row shown under the input wraps at the edge", run = fn() = {
    let #(r1, _) = said(new(Terminal.Size(rows = 24, columns = 6)), "> ");
    let #(r, _) = typing(r1, "", 0, ["abcdefgh"]);
    rowsAre(rowsOf(r), ["> ", "abcdef", "gh"])
})

let wrapKeepsColour = Test(name = "a wrapped row is coloured on as it was", run = fn() =
    rowsAre(wrapped("\u{1b}[1mabcdefgh\u{1b}[0m", 6),
        ["\u{1b}[1mabcdef\u{1b}[0m", "\u{1b}[1mgh\u{1b}[0m"]))

let offerCounted = Test(name = "what the screen has no room for is counted", run = fn() = {
    // six rows: one for the input, four for lines, one for the count
    let r0 = new(Terminal.Size(rows = 6, columns = 80));
    let #(r1, _) = said(r0, "> ");
    let #(r, _) = typing(r1, "", 0, ["a", "b", "c", "d", "e", "f", "g"]);
    rowsAre(rowsOf(r), ["> ", "a", "b", "c", "d", "and 3 more"])
})

let enteredEmpty = Test(name = "nothing typed after no prompt leaves no row", run = fn() = {
    let #(_, bytes) = entered(typed("", 0));
    let #(r, _) = said(new(Terminal.Size(rows = 24, columns = 80)), "");
    let #(_, none) = entered(r);
    // a row committed would end in a line feed
    if String.contains(bytes, "> \n") && !String.contains(none, "\n") then Passed
    else Failed(String.replace(none, "\u{1b}", "ESC"))
})

let wrapsTheInput = Test(name = "a line wider than the screen wraps, the cursor after it",
    run = fn() = {
        let #(r0, _) = said(new(Terminal.Size(rows = 24, columns = 10)), "> ");
        let #(r, _) = typing(r0, "abcdefghijkl", 12, []);
        // `> ` and twelve characters are fourteen columns: two rows
        if rowsOf(r) == ["> abcdefgh", "ijkl"] && resting(r) == 1 && column(r) == 5 then Passed
        else Failed(String.join(rowsOf(r), " | ") <> " at " <> Int.toString(resting(r))
            <> "," <> Int.toString(column(r)))
    })

let fillsTheWidth = Test(name = "a line that fills the width puts the cursor on the next row",
    run = fn() = {
        let #(r0, _) = said(new(Terminal.Size(rows = 24, columns = 10)), "> ");
        let #(r, _) = typing(r0, "abcdefgh", 8, []);
        if rowsOf(r) == ["> abcdefgh", ""] && resting(r) == 1 && column(r) == 1 then Passed
        else Failed(String.join(rowsOf(r), " | "))
    })

// A region with a prompt written, which is where an input is typed.
fn prompted() -> Region = {
    let #(r, _) = said(new(Terminal.Size(rows = 24, columns = 80)), "> ");
    r
}

// A region with an input being typed in it, without the bytes that drew
// it: the geometry is what these tests read.
fn typed(text : String, at : Int) -> Region = {
    let #(r, _) = typing(prompted(), text, at, []);
    r
}

fn rowsAre(rows : List(String), expected : List(String)) -> TestResult =
    if rows == expected then Passed else Failed(String.join(rows, " | "))

fn at(r : Region, row : Int, wanted : Int) -> TestResult =
    if resting(r) == row && column(r) == wanted then Passed
    else Failed("row " <> Int.toString(resting(r)) <> ", column " <> Int.toString(column(r)))

fn same(bytes : String, expected : String) -> TestResult =
    if bytes == expected then Passed else Failed(String.replace(bytes, "\u{1b}", "ESC"))
