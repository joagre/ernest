/// The shell's history (report §11.2): the inputs of the sessions before
/// this one, kept in `$HOME/.ernest/history`, one input a line with a
/// newline written `\n` and a backslash `\\`.
///
/// It is ordinary Ernest over `Os`, `Fs`, `String` and `List`: the home
/// directory from the environment, and the reading, the appending, the
/// escaping and the trimming, which is where the line between Ernest and
/// `foreign` runs (docs/decisions.md).

/// Report §11.2: how many inputs the history keeps, in the session and in
/// the file.
export let kept = 1000

// How long to wait for the file system, which is a local file.
let wait = 5000

/// The file in the person's home directory, and none where the environment
/// names no home or one that is no absolute path, which would put the
/// history under whatever directory the shell starts in (report §11.2).
export let file : Optional(Path) =
    Optional.andThen(Os.environment("HOME"), fn(home) = match Path(home) {
        at when Path.isAbsolute(at) -> Some(at <> Path(".ernest/history"))
      | _ -> None
    })

/// The inputs of the sessions before this one, newest first. A file that
/// holds more than the last thousand is trimmed to them as it is read.
export fn read() : Either(Io.Error, List(String)) with m =
    match file {
        None -> Right([])
      | Some(path) -> {
            let _ <- made(path);
            match Fs.read(path, wait) {
                // no file yet: a first session has no history
                Left(Io.NotFound) -> Right([])
              | Left(why) -> Left(why)
              | Right(bytes) -> {
                    let read <- inputs(bytes);
                    trimmed(path, read)
                }
            }
        }
    }

// Newest first is the order the editor walks; the file is oldest first,
// as a person reading it expects.
fn trimmed(path : Path, inputs : List(String)) : Either(Io.Error, List(String)) with m = {
    let extra = List.size(inputs) - kept;
    if extra <= 0 then
        Right(List.reverse(inputs))
    else {
        let last = List.drop(inputs, extra);
        let _ <- replaced(path, String.toUtf8(text(last)), 1);
        Right(List.reverse(last))
    }
}

// Report §11: the trimmed file is written beside the history and renamed
// over it, so that it is written whole or not at all, under a name no other
// session writes at once: the first of `history.new1`, `history.new2` and
// on that `makeFile` makes, since it refuses one that exists.
fn replaced(path : Path, bytes : Bytes, n : Int) : Either(Io.Error, Unit) with m = {
    let beside = Path.withExtension(path, "new" <> Int.toString(n));
    match Fs.makeFile(beside, bytes, wait) {
        Left(Io.Exists) -> replaced(path, bytes, n + 1)
      | Left(why) -> Left(why)
      | Right(_) -> match Fs.rename(beside, path, wait) {
            Left(why) -> {
                let _ = Fs.remove(beside, wait);
                Left(why)
            }
          | Right(_) -> Right(Unit)
        }
    }
}

// A history that is not UTF-8 is not one the shell wrote, and is not read.
fn inputs(bytes : Bytes) : Either(Io.Error, List(String)) =
    match String.fromUtf8(bytes) {
        Some(text) ->
            Right(List.map(List.filter(String.lines(text), fn(line) = !String.isEmpty(line)),
                           decode))
      | None -> Left(Io.NotUtf8(bytes))
    }

fn text(inputs : List(String)) : String =
    String.join(List.map(inputs, fn(input) = encode(input) <> "\n"), "")

/// One input, appended as the shell takes it, to the file `read` has made
/// the directory of.
export fn add(input : String) : Either(Io.Error, Unit) with m =
    match file {
        None -> Right(Unit)
      | Some(path) -> Fs.append(path, String.toUtf8(encode(input) <> "\n"), wait)
    }

// Report §11.2: the directory made where it is not there, as before a
// first session, and its owner's alone to read, write and enter, so that no
// one else reads what was typed, before the file is read, written or
// trimmed.
fn made(path : Path) : Either(Io.Error, Unit) with m =
    match Path.parent(path) {
        None -> Right(Unit)
      | Some(dir) -> {
            let _ <- Fs.makeDir(dir, wait);
            Fs.setMode(dir, 0o700, wait)
        }
    }

//
// Report §11.2: an input is one line whatever it holds, so a newline in
// it is written `\n` and a backslash `\\`.
//

fn encode(input : String) : String =
    String.replace(String.replace(input, "\\", "\\\\"), "\n", "\\n")

// Left to right, since `\\n` is a backslash and an `n` and not a
// newline; two passes of `String.replace` would read it as one. One pass
// over the characters, since a line may be a large paste. A regression:
// slicing the rest at each character made the decoding quadratic
// (findings.md's S11).
fn decode(line : String) : String =
    String.fromList(List.reverse(undo(String.toList(line), [])))

fn undo(rest : List(Char), done : List(Char)) : List(Char) =
    match rest {
        '\\' :: 'n' :: more -> undo(more, '\n' :: done)
      | '\\' :: '\\' :: more -> undo(more, '\\' :: done)
      | c :: more -> undo(more, c :: done)
      | [] -> done
    }

//
// The tests (report §9.3), run by `ern test`, which `make test` does.
// The file itself is tested through the shell, in `test/`.
//

let plain =
    Test.Case(name = "an input without a newline is written as it is", run = fn() = same("1 + 2"))

let newlines =
    Test.Case(name = "a newline is written as an escape and read back",
              run = fn() = if encode("a\nb") == "a\\nb" then
                  same("a\nb")
              else
                  Test.Failed(encode("a\nb")))

let backslash =
    Test.Case(name = "a backslash is doubled, so `\\n` is not a newline",
              run = fn() = if encode("a\\nb") == "a\\\\nb" then
                  same("a\\nb")
              else
                  Test.Failed(encode("a\\nb")))

let both =
    Test.Case(name = "a backslash before a newline reads back whole",
              run = fn() = same("let s = \"\\\\\";\nlet t = 2"))

let empty = Test.Case(name = "an empty input reads back empty", run = fn() = same(""))

fn same(input : String) : Test.Result =
    if decode(encode(input)) == input then
        Test.Passed
    else
        Test.Failed("\"" <> encode(input) <> "\" read back as \"" <> decode(encode(input)) <> "\"")
