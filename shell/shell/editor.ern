//
// The shell's line editor (report §11.2), designed in
// docs/shell_design.md: a pure function from what is being edited and an
// event to what the reader must do next. GNU Readline's Emacs bindings;
// `Escape` and the key after it are `Meta` and that key (§8.2).
//
// Pure, and tested on its own: the tests at the foot of this file are
// what `ern test` runs (§9.3). The reader holds a `State` and reads it
// through the functions here, since its constructor is this module's.
//

// What is being edited: the line and the cursor, what was last killed,
// what the keys before this one have begun, the inputs before this one
// with how far back through them the person has walked, the line they
// were typing when they began to walk, and the search when one is
// running. Abstract (report §4.4): the editor alone keeps the cursor
// inside the line and a search's place inside the history.
export abstract type State = State(text : String, at : Int, kill : String, pending : Pending,
    history : List(String), back : Int, saved : String,
    search : Optional(Search))

// Report §8.2: a sequence the terminal sends that §9.3 does not name
// arrives as `Escape` and the characters after it, so the editor reads
// one: `Escape` begins a Meta key, and `Escape [` begins the rest of a
// sequence, of which `Escape [ Z` is `Shift-Tab`.
type Pending = Plain | Meta | Bracket

// An incremental search: what has been typed to search for, where in the
// history the match is, where the walk stood and what was being typed
// when the search began, and its direction.
type Search = Search(query : String, back : Int, from : Int, before : String,
    forward : Bool)

export type Edit =
    Typing(State) | Submit(State) | Cancel | Clear(State) | Completing(State) | Documenting(State)
  | Leave

// Nothing typed yet and nothing behind it.
let fresh = State(text = "", at = 0, kill = "", pending = Plain, history = [],
    back = 0, saved = "", search = None)

// A session's first line, after the inputs of the sessions before it,
// newest first.
export fn start(history : List(String)) -> State = State(..fresh, history = history)

// The state to type the next line in: the line just taken joins the
// history, and what was killed outlives the line it was killed from, as
// Readline's does.
export fn next(state : State) -> State =
    State(..fresh, kill = state.kill,
        history = if keeps(state) then state.text :: state.history else state.history)

// Report §11.2: a blank input and one equal to the input before it are
// not kept, in the history or in the file.
export fn keeps(state : State) -> Bool =
    !String.isEmpty(String.trim(state.text)) && List.get(state.history, 0) != Some(state.text)

// Report §11.2: another line of the same input, which `M-Enter` asks
// for and `Enter` does where the parser cannot finish what is typed.
export fn newline(state : State) -> State = insert(state, "\n")

// The line and the cursor a completion left, which the reader puts
// back; the editor knows no names and does no completing of its own.
export fn typed(state : State, text : String, at : Int) -> State =
    State(..state, text = text, at = at)

// The line being edited and the cursor in it, a search aside.
export fn text(state : State) -> String = state.text

export fn at(state : State) -> Int = state.at

// Whether the keys so far have begun a sequence the next key ends
// (report §8.2).
export fn midSequence(state : State) -> Bool = match state {
    State(pending = Plain) -> false
  | _ -> true
}

// What the reader shows on the line and where the cursor stands in it:
// the line itself, or, while a search runs, Readline's search prompt
// with the match after it.
export fn shown(state : State) -> String = match state {
    State(search = None, text = text) -> text
  | State(search = Some(s), text = text) -> asked(s, text) <> text
}

export fn cursor(state : State) -> Int = match state {
    State(search = None, at = at) -> at
  | State(search = Some(s), text = text, at = at) -> String.size(asked(s, text)) + at
}

fn asked(s : Search, text : String) -> String =
    "(" <> missing(s.query, text) <> direction(s.forward) <> ")`" <> s.query <> "': "

fn missing(query : String, text : String) -> String =
    if String.isEmpty(query) || String.indexOf(text, query) != None then "" else "failed "

fn direction(forward : Bool) -> String = if forward then "i-search" else "reverse-i-search"

export fn edit(state : State, event : Terminal.Event) -> Edit = match state {
    State(search = Some(s)) -> searching(State(..state, pending = Plain), s, event)
  | State(pending = Meta) -> meta(State(..state, pending = Plain), event)
  | State(pending = Bracket) -> bracket(State(..state, pending = Plain), event)
  | State(pending = Plain) -> plain(state, event)
}

// Report §11.2: `Shift-Tab`, which the terminal sends as `Escape [ Z`,
// shows what the name at the cursor is. Any other sequence is the
// `Escape` key and the characters after it, as §8.2 delivers it.
fn bracket(state : State, event : Terminal.Event) -> Edit = match event {
    Terminal.Key('Z') -> Documenting(state)
  | other -> plain(state, other)
}

fn plain(state : State, event : Terminal.Event) -> Edit = match event {
    Terminal.Enter -> Submit(state)
  | Terminal.Interrupt -> Cancel
  | Terminal.Escape -> Typing(State(..state, pending = Meta))
  | Terminal.ArrowLeft -> Typing(State(..state, at = Int.max(0, state.at - 1)))
  | Terminal.ArrowRight ->
        Typing(State(..state, at = Int.min(String.size(state.text), state.at + 1)))
  | Terminal.ArrowUp -> Typing(walk(state, 1))
  | Terminal.ArrowDown -> Typing(walk(state, -1))
  | Terminal.Resized(_) -> Typing(state)
  // report §11.2: a paste goes in at the cursor, line feeds and all
  | Terminal.Pasted(text) -> Typing(insert(state, text))
  | Terminal.Key(c) -> character(state, c)
}

// A character typed, which is Readline's control key where it is one.
fn character(state : State, c : Char) -> Edit = {
    let State(text = text, at = at, kill = kill) = state;
    match c {
        '\u{1}' -> Typing(State(..state, at = 0)) // C-a
      | '\u{5}' -> Typing(State(..state, at = String.size(text))) // C-e
      | '\u{2}' -> Typing(State(..state, at = Int.max(0, at - 1))) // C-b
      | '\u{6}' -> Typing(State(..state, at = Int.min(String.size(text), at + 1))) // C-f
      | '\u{4}' -> // C-d, and on an empty line it leaves
            if String.isEmpty(text) then Leave else Typing(deleteAt(state, at))
      | '\u{8}' or '\u{7f}' -> Typing(back(state)) // Backspace and C-h
      | '\u{b}' -> Typing(killFrom(state, String.size(text))) // C-k
      | '\u{15}' -> Typing(killTo(state, 0)) // C-u
      | '\u{17}' -> Typing(killTo(state, wordLeft(text, at, unspaced))) // C-w
      | '\u{19}' -> Typing(insert(state, kill)) // C-y
      | '\u{c}' -> Clear(state) // C-l
      | '\t' -> Completing(state) // the reader has the names to complete against
      | '\u{10}' -> Typing(walk(state, 1)) // C-p
      | '\u{e}' -> Typing(walk(state, -1)) // C-n
      | '\u{12}' -> Typing(search(state, false)) // C-r
      | '\u{13}' -> Typing(search(state, true)) // C-s
      // every other control character is not bound and does nothing
      | _ -> if c < ' ' then Typing(state) else Typing(insert(state, Char.toString(c)))
    }
}

// `Escape` and then the key: Readline's Meta bindings.
fn meta(state : State, event : Terminal.Event) -> Edit = {
    let State(text = text, at = at) = state;
    match event {
        // report §11.2: another line, though the parser could run what
        // is typed
        Terminal.Enter -> Typing(newline(state))
      // report §8.2: `Escape [` begins a sequence §9.3 does not name,
      // of which `Escape [ Z` is `Shift-Tab`
      | Terminal.Key('[') -> Typing(State(..state, pending = Bracket))
      | Terminal.Key('<') -> Typing(walkTo(state, List.size(state.history)))
      | Terminal.Key('>') -> Typing(walkTo(state, 0))
      | Terminal.Key('b') -> Typing(State(..state, at = wordLeft(text, at, alphanumeric)))
      | Terminal.Key('f') -> Typing(State(..state, at = wordRight(text, at, alphanumeric)))
      | Terminal.Key('d') -> Typing(killFrom(state, wordRight(text, at, alphanumeric)))
      | Terminal.Key('\u{8}') or Terminal.Key('\u{7f}') ->
            Typing(killTo(state, wordLeft(text, at, alphanumeric)))
      | Terminal.Key(_) -> Typing(state) // an unbound Meta key does nothing
      // every other key does what it does, `Escape` before it or not
      | other -> plain(state, other)
    }
}

//
// Walking the history: the inputs before this one, newest first, with
// `back` how far through them the walk stands, 0 being the line being
// typed, which is kept while the walk is away from it.
//

fn walk(state : State, step : Int) -> State = walkTo(state, state.back + step)

fn walkTo(state : State, to : Int) -> State = {
    if to < 0 || to > List.size(state.history) then state
    else {
        let typed = if state.back == 0 then state.text else state.saved;
        let recalled = if to == 0 then typed else entry(state.history, to);
        State(..state, text = recalled, at = String.size(recalled), saved = typed, back = to)
    }
}

// The nth input back, 1 being the one before this line.
fn entry(history : List(String), n : Int) -> String =
    Optional.withDefault(List.get(history, n - 1), "")

//
// Searching the history: `C-r` back and `C-s` forward, each character
// typed narrowing the search, `C-g` putting back what the search began
// from, and every other key ending the search and then doing what it
// does. A search that matches nothing keeps the line it last matched and
// says so in its prompt.
//

fn search(state : State, forward : Bool) -> State =
    State(..state, search = Some(Search(query = "", back = state.back, from = state.back,
        before = state.text, forward = forward)))

fn searching(state : State, s : Search, event : Terminal.Event) -> Edit = match event {
    Terminal.Enter -> Submit(stop(state))
  | Terminal.Interrupt -> Cancel
  | Terminal.Resized(_) -> Typing(state)
  | Terminal.Key('\u{12}') -> Typing(seek(state, Search(..s, forward = false), 1)) // C-r
  | Terminal.Key('\u{13}') -> Typing(seek(state, Search(..s, forward = true), -1)) // C-s
  | Terminal.Key('\u{7}') -> Typing(abandon(state, s)) // C-g
  | Terminal.Key('\u{8}') or Terminal.Key('\u{7f}') -> Typing(shorten(state, s)) // Backspace
  | Terminal.Key(c) -> if c < ' ' then edit(stop(state), event) else Typing(narrow(state, s, c))
  | _ -> edit(stop(state), event)
}

// The next match in the direction, the search standing where it was when
// there is none.
fn seek(state : State, s : Search, step : Int) -> State =
    match find(state.history, s.query, s.back + step, step) {
        Some(n) -> matched(state, s, n)
      | None -> State(..state, search = Some(s))
    }

// A character typed: the search narrows and looks again from where it
// stands, since the match it has may match the longer query too.
fn narrow(state : State, s : Search, c : Char) -> State = {
    let Search(query = query, back = back) = s;
    let narrower = Search(..s, query = query <> Char.toString(c));
    let from = if back == 0 then back + step(s) else back;
    match find(state.history, query <> Char.toString(c), from, step(s)) {
        Some(n) -> matched(state, narrower, n)
      | None -> State(..state, search = Some(narrower))
    }
}

// Backspace: the query loses its last character and the search begins
// again from where it started, so that a shorter query may match a
// nearer input.
fn shorten(state : State, s : Search) -> State = {
    let Search(query = query, from = from, before = before) = s;
    let shorter = String.slice(query, 0, Int.max(0, String.size(query) - 1));
    let narrower = Search(..s, query = shorter, back = from);
    if String.isEmpty(shorter) then
        State(..state, text = before, at = String.size(before), back = from,
            search = Some(narrower))
    else match find(state.history, shorter, from + step(s), step(s)) {
        Some(n) -> matched(state, narrower, n)
      | None -> State(..state, search = Some(narrower))
    }
}

// `C-g`: the line the search began from comes back.
fn abandon(state : State, s : Search) -> State =
    State(..state, text = s.before, at = String.size(s.before), back = s.from, search = None)

// The search ends and the input it found stays.
fn stop(state : State) -> State = State(..state, search = None)

fn matched(state : State, s : Search, n : Int) -> State = {
    let text = entry(state.history, n);
    State(..state, text = text, at = matchAt(text, s.query), back = n,
        search = Some(Search(..s, back = n)))
}

fn matchAt(text : String, query : String) -> Int =
    Optional.withDefault(String.indexOf(text, query), String.size(text))

fn find(history : List(String), query : String, from : Int, step : Int) -> Optional(Int) =
    if from < 1 || from > List.size(history) then None
    else if String.indexOf(entry(history, from), query) != None then Some(from)
    else find(history, query, from + step, step)

fn step(s : Search) -> Int = if s.forward then -1 else 1

//
// Editing a line: each is a pure function of the text and the cursor,
// which is what makes the editor testable on its own.
//

// Text put in at the cursor, which is left after it.
export fn insert(state : State, what : String) -> State = {
    let State(text = text, at = at) = state;
    State(..state, text = String.slice(text, 0, at) <> what <> from(text, at),
        at = at + String.size(what))
}

fn back(state : State) -> State = match state {
    State(at = 0) -> state
  | State(text = text, at = at) ->
        State(..state, text = String.slice(text, 0, at - 1) <> from(text, at), at = at - 1)
}

fn deleteAt(state : State, at : Int) -> State = {
    let State(text = text) = state;
    if at >= String.size(text) then state
    else State(..state, text = String.slice(text, 0, at) <> from(text, at + 1))
}

// Kill back to `to`, keeping what was killed for `C-y`.
fn killTo(state : State, to : Int) -> State = {
    let State(text = text, at = at) = state;
    State(..state, text = String.slice(text, 0, to) <> from(text, at), at = to,
        kill = String.slice(text, to, at - to))
}

// Kill forward to `to`.
fn killFrom(state : State, to : Int) -> State = {
    let State(text = text, at = at) = state;
    State(..state, text = String.slice(text, 0, at) <> from(text, to),
        kill = String.slice(text, at, to - at))
}

fn from(text : String, at : Int) -> String = String.slice(text, at, String.size(text) - at)

// report §11.2: the start of the word before the cursor, over what is not
// in a word and then over the word itself; `inWord` says what a word is,
// a run of letters and digits for the Meta keys and anything but a space
// for C-w, as in Readline.
fn wordLeft(text : String, at : Int, inWord : (String, Int) -> Bool) -> Int =
    over(text, over(text, at, -1, fn(t, i) = !inWord(t, i)), -1, inWord)

// The end of the word after the cursor.
fn wordRight(text : String, at : Int, inWord : (String, Int) -> Bool) -> Int =
    over(text, over(text, at, 1, fn(t, i) = !inWord(t, i)), 1, inWord)

// From `at`, a step at a time, while the character stepped over satisfies `p`.
fn over(text : String, at : Int, step : Int, p : (String, Int) -> Bool) -> Int =
    if beyond(text, at, step) then at
    else if p(text, at + Int.min(step, 0)) then over(text, at + step, step, p)
    else at

// The character a step away is off the line, so the walk over the word
// stops there.
fn beyond(text : String, at : Int, step : Int) -> Bool =
    at + Int.min(step, 0) < 0 || at + Int.max(step, 0) > String.size(text)

fn unspaced(text : String, i : Int) -> Bool = String.slice(text, i, 1) != " "

// A grapheme is judged by its first code point, which is what Char's
// predicates see.
fn alphanumeric(text : String, i : Int) -> Bool = match String.toList(String.slice(text, i, 1)) {
    c :: _ -> Char.isAlpha(c) || Char.isDigit(c)
  | [] -> false
}

//
// The tests (report §9.3), run by `ern test build/shell/shell/editor.erc`,
// which `make test` does. Each plays a list of events onto a fresh line
// and reads off the text and the cursor.
//

let typing = Test(name = "typing inserts at the cursor", run = fn() =
    reads(play(keys("abc") <> [Terminal.ArrowLeft] <> keys("X")), "abXc", 3))

let ends = Test(name = "C-a and C-e go to the ends of the line", run = fn() =
    reads(play(keys("abc") <> [ctrl('a')] <> keys("X") <> [ctrl('e')] <> keys("Y")),
        "XabcY", 5))

let backspace = Test(name = "backspace deletes what is before the cursor", run = fn() =
    reads(play(keys("abc") <> [Terminal.Key('\u{7f}')]), "ab", 2))

let forwardDelete = Test(name = "C-d deletes what is under the cursor", run = fn() =
    reads(play(keys("abc") <> [ctrl('a'), ctrl('d')]), "bc", 0))

let killAndYank = Test(name = "C-k kills to the end and C-y puts it back", run = fn() =
    reads(play(keys("abcdef")
        <> [Terminal.ArrowLeft, Terminal.ArrowLeft, ctrl('k'), ctrl('a'), ctrl('y')]),
        "efabcd", 2))

let killLine = Test(name = "C-u kills back to the start of the line", run = fn() =
    reads(play(keys("one two") <> [ctrl('u')]), "", 0))

let killWord = Test(name = "C-w kills the word before the cursor", run = fn() =
    reads(play(keys("one two") <> [ctrl('w')]), "one ", 4))

let wordsBack = Test(name = "M-b goes to the start of the word before", run = fn() =
    reads(play(keys("one two") <> [Terminal.Escape] <> keys("b")), "one two", 4))

let wordsForward = Test(name = "M-f goes to the end of the word after", run = fn() =
    reads(play(keys("one two") <> [ctrl('a'), Terminal.Escape] <> keys("f")), "one two", 3))

let killWordForward = Test(name = "M-d kills the word after the cursor", run = fn() =
    reads(play(keys("one two") <> [ctrl('a'), Terminal.Escape] <> keys("d")), " two", 0))

// report §11.2: the Meta keys' word is a run of letters and digits, and
// C-w's runs back to a space. Regression tests: the ones above use "one
// two", where the two agree, and passed while every key stopped at spaces
// only. Not covered: a grapheme of several code points inside a word.
let wordsBackInCode = Test(name = "M-b stops at a letter after punctuation", run = fn() =
    reads(play(keys("List.map(xs") <> [Terminal.Escape] <> keys("b")), "List.map(xs", 9))

let wordsForwardInCode = Test(name = "M-f stops at the end of letters", run = fn() =
    reads(play(keys("List.map(xs") <> [ctrl('a'), Terminal.Escape] <> keys("f")), "List.map(xs", 4))

let killWordForwardInCode = Test(name = "M-d kills letters and digits only", run = fn() =
    reads(play(keys("List.map(xs") <> [ctrl('a'), Terminal.Escape] <> keys("d")), ".map(xs", 0))

let killWordBackInCode = Test(name = "M-Backspace kills letters and digits only", run = fn() =
    reads(play(keys("List.map(xs") <> [Terminal.Escape, Terminal.Key('\u{7f}')]), "List.map(", 9))

let killToSpaceInCode = Test(name = "C-w kills back to a space", run = fn() =
    reads(play(keys("f List.map(xs") <> [ctrl('w')]), "f ", 2))

let submits = Test(name = "Enter submits what was typed", run = fn() =
    match play(keys("hi") <> [Terminal.Enter]) {
        Submit(State(text = "hi")) -> Passed
      | other -> Failed(said(other))
    })

let cancels = Test(name = "C-c abandons the line", run = fn() =
    match play(keys("hi") <> [Terminal.Interrupt]) {
        Cancel -> Passed
      | other -> Failed(said(other))
    })

let leaves = Test(name = "C-d on an empty line leaves the shell", run = fn() =
    match play([ctrl('d')]) {
        Leave -> Passed
      | other -> Failed(said(other))
    })

let clears = Test(name = "C-l clears the screen and keeps the line", run = fn() =
    match play(keys("hi") <> [ctrl('l')]) {
        Clear(State(text = "hi", at = 2)) -> Passed
      | other -> Failed(said(other))
    })

let addsLine = Test(name = "M-Enter adds a line at the cursor", run = fn() =
    reads(play(keys("ab") <> [Terminal.Escape, Terminal.Enter] <> keys("c")), "ab\nc", 4))

let pastes = Test(name = "a paste goes in at the cursor, line feeds and all", run = fn() =
    reads(play(keys("ab") <> [Terminal.ArrowLeft, Terminal.Pasted("x\ny")]), "ax\nyb", 4))

let asksToComplete = Test(name = "Tab asks the reader to complete", run = fn() =
    match play(keys("Li") <> [Terminal.Key('\t')]) {
        Completing(State(text = "Li")) -> Passed
      | other -> Failed(said(other))
    })

let asksToDocument = Test(name = "Shift-Tab asks the reader for documentation",
    run = fn() =
        match play(keys("List.map") <> [Terminal.Escape] <> keys("[Z")) {
            Documenting(State(text = "List.map")) -> Passed
          | other -> Failed(said(other))
        })

let escapeThenBracket = Test(name = "Escape and a bracket that is no sequence types on",
    run = fn() =
        reads(play(keys("a") <> [Terminal.Escape] <> keys("[b")), "ab", 2))

let walks = Test(name = "the arrows walk back through the inputs", run = fn() =
    reads(plays(start(["two", "one"]), [Terminal.ArrowUp, Terminal.ArrowUp, Terminal.ArrowUp]),
        "one", 3))

let walksBack = Test(name = "walking back and returning brings back what was typed", run = fn() =
    reads(plays(start(["old"]), keys("new") <> [Terminal.ArrowUp, Terminal.ArrowDown]), "new", 3))

let walksByKey = Test(name = "C-p and C-n walk as the arrows do", run = fn() =
    reads(plays(start(["two", "one"]), [ctrl('p'), ctrl('p'), ctrl('n')]), "two", 3))

let walksToEnds = Test(name = "M-< goes to the oldest input and M-> back to the line",
    run = fn() =
        reads(plays(start(["two", "one"]),
            [Terminal.Escape] <> keys("<") <> [Terminal.Escape] <> keys(">")), "", 0))

let searches = Test(name = "C-r finds the newest input holding what is typed", run = fn() =
    reads(plays(start(["print two", "let x = 1"]), [ctrl('r')] <> keys("two")),
        "print two", 6))

let searchesOn = Test(name = "C-r again finds the one before it", run = fn() =
    reads(plays(start(["print two", "print one"]), [ctrl('r')] <> keys("print") <> [ctrl('r')]),
        "print one", 0))

let searchShows = Test(name = "a search shows its prompt and what it found", run = fn() =
    if shows(plays(start(["print two"]), [ctrl('r')] <> keys("two")))
        == "(reverse-i-search)`two\': print two" then Passed
    else Failed(shows(plays(start(["print two"]), [ctrl('r')] <> keys("two")))))

let searchFails = Test(name = "a search that matches nothing says so and keeps the line",
    run = fn() =
        if String.startsWith(shows(plays(start(["print two"]), [ctrl('r')] <> keys("zz"))),
            "(failed reverse-i-search)") then Passed
        else Failed(shows(plays(start(["print two"]), [ctrl('r')] <> keys("zz")))))

let searchAbandoned = Test(name = "C-g puts back the line the search began from", run = fn() =
    reads(plays(start(["print two"]), keys("abc") <> [ctrl('r')] <> keys("two") <> [ctrl('g')]),
        "abc", 3))

let searchAccepted = Test(name = "Enter takes the input the search found", run = fn() =
    match plays(start(["print two"]), [ctrl('r')] <> keys("two") <> [Terminal.Enter]) {
        Submit(State(text = "print two", search = None)) -> Passed
      | other -> Failed(said(other))
    })

let searchLeft = Test(name = "a key the search does not use ends it and then does its work",
    run = fn() =
        reads(plays(start(["print two"]), [ctrl('r')] <> keys("two") <> [ctrl('a')]),
            "print two", 0))

let kept = Test(name = "the line just taken joins the history", run = fn() =
    match next(State(..start(["one"]), text = "two")) {
        State(history = ["two", "one"]) -> Passed
      | State(history = history) -> Failed(String.join(history, ", "))
    })

let notKept = Test(name = "a blank input and one repeated are not kept", run = fn() =
    if !keeps(typed(start(["one"]), "  ", 0)) && !keeps(typed(start(["one"]), "one", 0))
        && keeps(typed(start(["one"]), "two", 0)) then Passed
    else Failed("the history kept what it should not"))

// Every event of a text typed a character at a time.
fn keys(text : String) -> List(Terminal.Event) =
    List.map(String.toList(text), fn(c) = Terminal.Key(c))

// A control key as the terminal sends it: `C-a` is 1 (§8.2).
fn ctrl(c : Char) -> Terminal.Event = match Char.fromInt(Char.toInt(c) - 96) {
    Some(k) -> Terminal.Key(k)
  | None -> Terminal.Key(c)
}

// The events in order, from a fresh line; an event after the line ended
// changes nothing, so the first ending is what a test reads.
fn play(events : List(Terminal.Event)) -> Edit = plays(fresh, events)

fn plays(from : State, events : List(Terminal.Event)) -> Edit =
    List.foldLeft(events, Typing(from), fn(edited, event) = match edited {
        Typing(state) -> edit(state, event)
      | ended -> ended
    })

fn reads(edited : Edit, text : String, at : Int) -> TestResult = match edited {
    Typing(State(text = typed, at = cursor)) ->
        if typed == text && cursor == at then Passed
        else Failed("\"" <> typed <> "\" at " <> Int.toString(cursor))
  | other -> Failed(said(other))
}

// What the reader would show, which is the line or the search's prompt
// and what it found.
fn shows(edited : Edit) -> String = match edited {
    Typing(state) -> shown(state)
  | other -> said(other)
}

fn said(edited : Edit) -> String = match edited {
    Typing(State(text = text)) -> "typing \"" <> text <> "\""
  | Completing(_) -> "completing"
  | Documenting(_) -> "documenting"
  | Submit(State(text = text)) -> "submitted \"" <> text <> "\""
  | Cancel -> "cancelled"
  | Clear(_) -> "cleared"
  | Leave -> "left"
}
