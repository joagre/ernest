/// Completion (report §11.2), designed in docs/shell_design.md: what
/// `Tab` puts in the line, and what a second `Tab` lists.
///
/// The matching and the ranking are pure functions from what is typed and
/// the names in scope, which is where the rule in CLAUDE.md puts them.
/// `completion` gathers the names: from the compiled interfaces and the
/// session, which only the front end can read, and from the source root,
/// through `Fs`.

/// What a name is: a value, a type, a constructor, or a module.
export type Kind = Value | Type | Constructor | Module

/// Report §11.2: what may stand where the cursor is, which the parser
/// answers by saying what it wanted where it stopped. Each admits its
/// own kinds of name, which is what a completion is filtered by.
/// `Anything` is the shell's, for a command's argument, whose names the
/// command has chosen already.
export type Slot = Expression | TypeName | Pattern | Declaration | Fields(List(Name)) | Anything

/// A name the shell can complete to: as it is typed, what it is, and the
/// line a listing shows, which carries its type.
export type Name = Name(text : String, kind : Kind, shown : String)

/// What a `Tab` does: the word that stands in place of the one before
/// the cursor, and the names it could still be, which a second `Tab`
/// lists, a lone one too. The word replaces rather than extends, since an
/// abbreviation is no prefix of what it reaches: `L.fm` becomes
/// `List.filterMap`. A completion whose word is empty changes nothing.
export type Completion = Completion(word : String, candidates : List(Name))

/// The completion that changes nothing.
export let nothing = Completion(word = "", candidates = [])

/// Report §11.2: what `Tab` completes the word before the cursor to, and
/// that word. A command is the shell's own word, not the language's, so
/// the parser is not asked about it; after a command, what completes is
/// what the command takes; anywhere else, what `slot` says may stand
/// at the cursor, the parser being given the text before the word: with
/// the word there it has been read already, and what may stand at the
/// cursor is what may stand in its place.
export fn completion(line : String, cursor : Int) : #(Completion, String) with m = {
    let typed = word(String.slice(line, 0, cursor));
    if String.startsWith(line, ":") && cursor <= Shell.Command.wordEnd(line) then {
        let command = String.slice(line, 0, Shell.Command.wordEnd(line));
        #(commandWord(command, line), command)
    } else if String.startsWith(line, ":") then
        #(argument(line, cursor, typed), typed)
    else {
        let before = String.slice(line, 0, cursor - String.size(typed));
        #(complete(typed, offered(typed), slot(before)), typed)
    }
}

// Report §11.2: the names a word completes against, every one once
// something is typed, with the fields a value before a `.` selects; with
// nothing typed, the starting points: what the
// session declares, the modules in scope, and the prelude's names that no
// module qualifies, its constructors aside, which are mostly the messages
// of system processes and complete from a letter.
fn offered(typed : String) : List(Name) with m = {
    let all = withNamespaces(names());
    if !String.isEmpty(typed) then
        all <> fields(typed)
    else {
        // nothing typed reaches the names of one segment, so what is left
        // to leave out is the prelude's constructors
        let own = sessionTexts();
        List.filter(all, fn(name) = match name {
            Name(text = text, kind = Constructor) -> List.contains(own, text)
          | _ -> true
        })
    }
}

fn commandWord(typed : String, line : String) : Completion = {
    let completion = complete(typed, commandNames(), Anything);
    withSpace(completion,
              Shell.Command.wordEnd(line) == String.size(line)
                  && Shell.Command.completes(completion.word) != None)
}

fn commandNames() : List(Name) =
    List.map(Shell.Command.commands,
             fn(command) =
                 Name(text = ":" <> command.name,
                      kind = Value,
                      shown = Shell.Command.line(command)))

// Report §11.2: a lone candidate is completed as far as it goes, so one
// that takes a value after it, a command with an argument or a setting,
// is followed by a space, where the line has none after it already.
fn withSpace(completion : Completion, takes : Bool) : Completion =
    match completion {
        Completion(word = completed, candidates = [_]) -> if takes then
            Completion(..completion, word = completed <> " ")
        else
            completion
      | _ -> completion
    }

// Report §11.2: after a command, what completes is what the command
// takes, and after another command nothing. An expression's names are
// the parser's to choose, as at the start of a line; anything else is
// one word, the argument's first.
fn argument(line : String, cursor : Int, typed : String) : Completion with m = {
    let end = Shell.Command.wordEnd(line);
    let wordIndex = cursor - String.size(typed);
    let before = String.slice(line, end, wordIndex - end);
    match Shell.Command.completes(String.slice(line, 0, end)) {
        Some(Shell.Command.Expressions) -> complete(typed, offered(typed), slot(before))
      // every setting takes a value after it, and `timing`'s is a word
      | Some(Shell.Command.SettingWords) -> match String.trim(before) {
            "" -> {
                let names = argumentNames(Shell.Command.SettingWords, typed);
                withSpace(complete(typed, names, Anything), cursor == String.size(line))
            }
          | "timing" -> {
                let timingWords =
                    List.map(["on", "off"],
                             fn(value) = Name(text = value, kind = Value, shown = value));
                complete(typed, timingWords, Anything)
            }
          | _ -> nothing
        }
      | Some(kind) -> if String.isEmpty(String.trim(before)) then
            complete(typed, argumentNames(kind, typed), Anything)
        else
            nothing
      | None -> nothing
    }
}

fn argumentNames(kind : Shell.Command.Completes, typed : String) : List(Name) with m =
    match kind {
        // a module completes as it is written, without the dot a name inside
        // it would need, and is listed by its name alone, since every
        // candidate here is a module; the namespaces they are in, `Http` for
        // `Http.Parser`, complete with their dots
        Shell.Command.Modules -> withNamespaces(List.filterMap(names(), fn(name) = match name {
            Name(text = text, kind = Module) -> Some(Name(text = text, kind = Value, shown = text))
          | _ -> None
        }))
      | Shell.Command.SourceModules -> sourceModules(typed)
      | Shell.Command.Expressions -> offered(typed)
      | Shell.Command.Names -> offered(typed)
      | Shell.Command.SessionNames -> sessionNames()
      | Shell.Command.SettingWords ->
            List.map(Shell.Command.settings,
                     fn(#(setting, value)) =
                         Name(text = setting, kind = Value, shown = setting <> " " <> value))
      | Shell.Command.Paths -> []
    }

// Report §11.2: the modules `:load` may compile, read from the source
// root a directory at a time: the one the typed word's finished segments
// name, so that a large root is never walked whole. A directory is a
// namespace and a `.ern` file a module, each named by §11.1's path shape.
fn sourceModules(typed : String) : List(Name) with m = {
    let finished = List.dropLast(String.split(typed, "."), 1);
    let directory =
        List.foldLeft(finished,
                      Path(sourceRoot()),
                      fn(path, part) = path <> Path(String.toLower(part)));
    let prefix = String.join(List.map(finished, fn(part) = part <> "."), "");
    match Fs.list(directory, listMs) {
        Left(_) -> []
      | Right(entries) -> List.filterMap(entries, fn(entry) = sourceModule(prefix, entry))
    }
}

fn sourceModule(prefix : String, entry : Fs.Entry) : Optional(Name) =
    match entry {
        Fs.Entry(path = path, kind = Fs.Directory) ->
            Optional.map(Optional.andThen(Path.name(path), segment), fn(namespace) = {
                let text = prefix <> namespace;
                Name(text = text, kind = Module, shown = text <> ".")
            })
      | Fs.Entry(path = path) -> if Path.extension(path) != Some("ern") then
            None
        else {
            let named = Optional.andThen(Path.name(Path.withoutExtension(path)), segment);
            Optional.map(named, fn(module) = {
                let text = prefix <> module;
                Name(text = text, kind = Value, shown = text)
            })
        }
    }

// How long `:load`'s listing of a directory of the source root may take.
let listMs = 5000

// Report §11.2: every name completion may reach, as the session stands.
// Reading the compiled interfaces is the host's; the matching is
// `Shell.Complete`'s.
foreign fn names() : List(Name) with m =
    "ern_shell:names/0"

// Report §11.2: the names the session declares, which `:forget` takes,
// and the source root `:load` compiles from; the session is the front
// end's to hold.
foreign fn sessionNames() : List(Name) with m =
    "ern_shell:session_names/0"

foreign fn sourceRoot() : String with m =
    "ern_shell:source_root/0"

// Report §11.2: every name the session declares, as it is written.
foreign fn sessionTexts() : List(String) with m =
    "ern_shell:session_texts/0"

// Report §11.2: what may stand at the cursor, which the parser knows,
// since it says what it wanted where it stopped.
foreign fn slot(before : String) : Slot with m =
    "ern_shell:slot/1"

// Report §11.2, §3.5: the fields the value before the last `.` selects,
// named as typed and listed with their types.
foreign fn fields(typed : String) : List(Name) with m =
    "ern_shell:fields/1"

// Report §11.1, §4.2: the namespace segment a path component names, asked
// of the compiler, which owns the rule.
foreign fn segment(name : String) : Optional(String) =
    "ern_shell:segment/1"

/// `true` when the completion has one candidate.
export fn lone(completion : Completion) : Bool =
    match completion {
        Completion(candidates = [_]) -> true
      | _ -> false
    }

/// Report §11.2: the word before the cursor completes against the names
/// in scope, segment by segment, so `Li` gives `List.` and `List.ma`
/// gives `List.map`. Nothing typed reaches every name admitted there,
/// which is what a `Tab` after a command lists. The word is the caller's
/// to give, since only it knows what a word is where the cursor stands:
/// the shell's own commands begin with a `:`, which is no part of a name.
export fn complete(typed : String, names : List(Name), slot : Slot) : Completion =
    match matches(typed, admitted(names, slot)) {
        #([], []) -> nothing
      | #([only], []) -> Completion(word = whole(only), candidates = [only])
      | #([], [only]) -> Completion(word = whole(only), candidates = [only])
      | #([], loose) -> Completion(word = namespaced(loose, typed), candidates = loose)
      | #(exact, loose) -> {
            // report §11.2: what the names reached by prefix share, never
            // less than was typed, which a `Tab` does not take away
            let shared = common(List.map(exact, fn(name) = whole(name)));
            let completed = if String.size(shared) >= String.size(typed) then shared else "";
            Completion(word = completed, candidates = exact <> loose)
        }
    }

// Report §11.2: what a slot admits. An expression takes values,
// constructors and the modules they are in; a type takes types and
// modules; a pattern takes constructors and modules; a field position
// takes the fields of its constructor and nothing else. A declaration
// is where an input may also be an expression, so it admits both.
fn admitted(names : List(Name), slot : Slot) : List(Name) =
    match slot {
        Fields(fields) -> fields
      | Anything -> names
      | TypeName -> held(names, fn(name) = isKind(name, Type))
      | Pattern -> held(names, fn(name) = isKind(name, Constructor))
      | _ -> held(names, fn(name) = !isKind(name, Type))
    }

// Report §11.2: the names that may stand there, and the namespaces that
// hold one, at any depth: after `:`, `Net` holds no type and is not
// offered, where `Shell` holds `Shell.Region.Region`.
fn held(names : List(Name), keep : (Name) -> Bool) : List(Name) =
    List.filter(names, fn(name) = match name {
        Name(text = namespace, kind = Module) ->
            List.any(names,
                     fn(inner) =
                         inner.kind != Module
                             && String.startsWith(inner.text, namespace <> ".")
                             && keep(inner))
      | _ -> keep(name)
    })

fn isKind(name : Name, kind : Kind) : Bool =
    name.kind == kind

// A module completes to its name and a dot, since the next `Tab`
// completes inside it; everything else to its name.
fn whole(name : Name) : String =
    match name {
        Name(text = text, kind = Module) -> text <> "."
      | Name(text = text) -> text
    }

/// Report §11.2: every namespace the names are in, offered as a module is,
/// completing with its dot: a type with members, `Address` for
/// `Address.call` (§4.8), and a directory of modules, `Net` for
/// `Net.Http`, are namespaces though they are no modules, and a listing
/// says so, as it says `module List`.
export fn withNamespaces(names : List(Name)) : List(Name) = {
    let texts = List.map(names, fn(name) = name.text);
    let prefixes = List.flatMap(texts, fn(text) = {
        let segments = String.split(text, ".");
        List.map(List.range(1, List.size(segments) - 1),
                 fn(count) = String.join(List.take(segments, count), "."))
    });
    let known = List.filterMap(names, fn(name) = match name {
        Name(text = text, kind = Module) -> Some(text)
      | _ -> None
    });
    let fresh = List.filter(List.unique(prefixes), fn(prefix) = !List.contains(known, prefix));
    names
        <> List.map(fresh,
                    fn(prefix) = Name(text = prefix, kind = Module, shown = "namespace " <> prefix))
}

/// Report §11.2: the whole name the cursor stands in, what is before it
/// and what goes on after it, for `Shift-Tab`.
export fn wordAt(line : String, cursor : Int) : String = {
    let following = String.toList(String.slice(line, cursor, String.size(line) - cursor));
    let #(rest, _) = List.span(following, fn(char) = inName(Char.toString(char)));
    word(String.slice(line, 0, cursor)) <> String.fromList(rest)
}

fn inName(grapheme : String) : Bool =
    match String.toList(grapheme) {
        ['.'] or ['_'] -> true
      | [char] -> Char.isAlpha(char) || Char.isDigit(char)
      | _ -> false
    }

/// The word being completed: the qualified name the cursor stands at the
/// end of. A name is letters, digits, `_`, and the `.` between segments.
export fn word(before : String) : String = {
    let size = String.size(before);
    let first = wordStart(before, size);
    String.slice(before, first, size - first)
}

// Where the name that ends at `index` begins.
fn wordStart(before : String, index : Int) : Int =
    if index <= 0 then
        0
    else if inName(String.slice(before, index - 1, 1)) then
        wordStart(before, index - 1)
    else
        index

/// The line a completion leaves, and where the cursor lands in it: the
/// word before the cursor is replaced, since an abbreviation is no
/// prefix of what it reaches.
export fn applied(text : String,
                  cursor : Int,
                  typed : String,
                  completion : Completion) : #(String, Int) =
    match completion {
        Completion(word = "") -> #(text, cursor)
      | Completion(word = new) -> {
            let wordIndex = cursor - String.size(typed);
            #(String.slice(text, 0, wordIndex)
                  <> new
                  <> String.slice(text, cursor, String.size(text) - cursor),
              wordIndex + String.size(new))
        }
    }

//
// Matching: what is typed reaches a name by prefix or by abbreviation,
// segment by segment. `List.fm` and `L.fM` both reach `List.filterMap`;
// a prefix is the better match and is listed first.
//

// The names reached by prefix, and those reached by abbreviation alone,
// each alphabetical.
fn matches(typed : String, names : List(Name)) : #(List(Name), List(Name)) = {
    let parts = String.split(typed, ".");
    let exact = List.filter(names, fn(name) = reaches(parts, name, true));
    let loose =
        List.filter(names, fn(name) = reaches(parts, name, false) && !reaches(parts, name, true));
    #(alphabetical(exact), alphabetical(loose))
}

// Report §11.2: candidates are listed alphabetically, by the text a person
// types.
fn alphabetical(names : List(Name)) : List(Name) =
    List.sort(names,
              fn(left, right) =
                  // two names alike, a module and its directory, by the line shown
                  if left.text == right.text then
                      String.compare(left.shown, right.shown)
                  else
                      String.compare(left.text, right.text))

// Report §11.2: a name is reached a segment at a time, so what is typed
// reaches the names of as many segments as it has; a namespace's members
// come after its dot.
fn reaches(parts : List(String), name : Name, exact : Bool) : Bool = {
    let segments = String.split(name.text, ".");
    List.size(parts) == List.size(segments) && every(parts, segments, exact)
}

// Each segment of what is typed against the segment of the name in the
// same place; the last may be unfinished, the ones before it are whole.
fn every(parts : List(String), segments : List(String), exact : Bool) : Bool =
    match #(parts, segments) {
        #([], _) -> true
      | #([last], segment :: _) -> segment == last || begins(segment, last, exact)
      | #(part :: rest, segment :: more) ->
            (segment == part || begins(segment, part, exact)) && every(rest, more, exact)
      | #(_, []) -> false
    }

// Report §11.2: a segment's first letter is matched as typed, since its
// case says what a name is (§2.3); the rest by prefix or by word starts.
fn begins(segment : String, part : String, exact : Bool) : Bool =
    if exact then
        String.startsWith(segment, part)
    else
        String.slice(part, 0, 1) == String.slice(segment, 0, 1)
            && abbreviates(String.toList(part), String.toList(segment), true)

// An abbreviation matches the starts of the words inside a name:
// `fM` and `fm` both reach `filterMap`, `m` alone does not.
fn abbreviates(part : List(Char), segment : List(Char), atStart : Bool) : Bool =
    match #(part, segment) {
        #([], _) -> true
      | #(_, []) -> false
      | #(typed :: moreTyped, char :: rest) ->
            if (atStart || Char.isUpper(char)) && Char.toLower(typed) == Char.toLower(char) then
                abbreviates(moreTyped, rest, false)
            else
                abbreviates(part, rest, false)
    }

// Report §11.2: names reached by abbreviation alone share no text that
// keeps what was typed, `fM` reaching `filterMap` and `flatMap`, so the
// namespace they are all in is completed and the last segment is kept as
// typed: `L.fM` gives `List.fM`. With no namespace, or several, nothing is.
fn namespaced(loose : List(Name), typed : String) : String = {
    let namespaces = List.unique(List.map(loose, fn(name) = namespaceOf(name.text)));
    match #(namespaces, List.last(String.split(typed, "."))) {
        #([namespace], Some(last)) -> if String.isEmpty(namespace) then
            ""
        else
            namespace <> "." <> last
      | _ -> ""
    }
}

// The namespace a qualified name is in, and nothing for a name of one
// segment.
fn namespaceOf(text : String) : String =
    String.join(List.dropLast(String.split(text, "."), 1), ".")

// The longest text every candidate begins with, which a first `Tab`
// puts in even where the name is still ambiguous.
fn common(texts : List(String)) : String =
    match texts {
        [] -> ""
      | first :: rest ->
            List.foldLeft(rest, first, fn(shared, text) = sharedPrefix(shared, text, 0))
    }

fn sharedPrefix(left : String, right : String, count : Int) : String =
    if count >= String.size(left) || count >= String.size(right) then
        String.slice(left, 0, count)
    else if String.slice(left, count, 1) == String.slice(right, count, 1) then
        sharedPrefix(left, right, count + 1)
    else
        String.slice(left, 0, count)

//
// The tests (report §9.3), run by `ern test`, which `make test` does.
//

let only =
    Test.Case(name = "one candidate completes to the whole of itself",
              run = fn() = becomes(complete(word("List.ma"), library(), Expression), "List.map"))

let module =
    Test.Case(name = "a module completes to its name and a dot",
              run = fn() = becomes(complete(word("Li"), library(), Expression), "List."))

let sharing =
    Test.Case(name = "several candidates give what they share",
              run = fn() = becomes(complete(word("List.f"), library(), Expression), "List.filter"))

let abbreviation =
    Test.Case(name = "an abbreviation reaches a name by its word starts",
              run = fn() =
                  becomes(complete(word("List.fM"), library(), Expression), "List.filterMap"))

let shortModule =
    Test.Case(name = "a segment is abbreviated too",
              run = fn() = becomes(complete(word("L.fm"), library(), Expression), "List.filterMap"))

let prefixFirst =
    Test.Case(name = "a prefix is listed before an abbreviation",
              run = fn() = match complete(word("List.f"), library(), Expression) {
                  Completion(candidates = Name(text = first) :: _) -> if first == "List.filter" then
                      Test.Passed
                  else
                      Test.Failed(first)
                | _ -> Test.Failed("no candidates")
              })

let noneAtAll =
    Test.Case(name = "a word that reaches nothing completes to nothing",
              run = fn() = becomes(complete(word("Zz"), library(), Expression), ""))

let words = Test.Case(name = "a word ends where a name cannot go on", run = fn() = {
    let seen = word("1 + List.ma");
    if seen == "List.ma" then Test.Passed else Test.Failed(seen)
})

let applying =
    Test.Case(name = "a completion replaces the word and moves the cursor", run = fn() = {
        let #(text, cursor) =
            applied("1 + L.fm(xs)", 8, "L.fm", complete("L.fm", library(), Expression));
        if text == "1 + List.filterMap(xs)" && cursor == 18 then
            Test.Passed
        else
            Test.Failed("\"" <> text <> "\" at " <> Int.toString(cursor))
    })

let ordered = Test.Case(name = "candidates are alphabetical", run = fn() = {
    let candidates = complete(word("List."), library(), Expression).candidates;
    let texts = List.map(candidates, fn(name) = name.text);
    if texts == ["List.filter", "List.filterMap", "List.map"] then
        Test.Passed
    else
        Test.Failed(String.join(texts, ", "))
})

let nothingTyped = Test.Case(name = "nothing typed reaches the names of one segment", run = fn() = {
    let candidates = complete("", library(), Expression).candidates;
    if List.size(candidates) == 2 then
        Test.Passed
    else
        Test.Failed(Int.toString(List.size(candidates)))
})

let oneSegment =
    Test.Case(name = "a segment reaches no name deeper than it",
              run = fn() = match complete(word("L"), library(), Expression) {
                  Completion(word = completed, candidates = [_]) -> if completed == "List." then
                      Test.Passed
                  else
                      Test.Failed(completed)
                | Completion(candidates = candidates) ->
                      Test.Failed(Int.toString(List.size(candidates)))
              })

let caseKept =
    Test.Case(name = "a lower-case letter reaches no constructor",
              run = fn() =
                  becomes(complete(word("a"),
                                   [Name(text = "Accept", kind = Constructor, shown = "Accept"),
                                    Name(text = "answer", kind = Value, shown = "answer : ...")],
                                   Expression),
                          "answer"))

let fieldsComplete =
    Test.Case(name = "a field completes after the value it is selected from", run = fn() = {
        let fields =
            [Name(text = "q.p.name", kind = Value, shown = "q.p.name : String"),
             Name(text = "q.p.count", kind = Value, shown = "q.p.count : Int")];
        becomes(complete("q.p.na", fields, Expression), "q.p.name")
    })

let neverShorter = Test.Case(name = "a Tab never takes away what was typed", run = fn() = {
    let names =
        [Name(text = "Address", kind = Module, shown = "Address."),
         Name(text = "Address.call", kind = Value, shown = "Address.call"),
         Name(text = "ArrowDown", kind = Constructor, shown = "ArrowDown")];
    let aside =
        [Name(text = "filterMap", kind = Value, shown = "filterMap"),
         Name(text = "flatMap", kind = Value, shown = "flatMap")];
    let prefixed = complete("Ad", names, Expression).word;
    let abbreviated = complete("fm", aside, Expression).word;
    if prefixed == "Address." && abbreviated == "" then
        Test.Passed
    else
        Test.Failed(prefixed <> " | " <> abbreviated)
})

let keepsTheLast =
    Test.Case(name = "an abbreviation keeps its last segment as typed",
              run = fn() =
                  becomes(complete("L.fM",
                                   library()
                                       <> [Name(text = "List.flatMap",
                                                kind = Value,
                                                shown = "List.flatMap : ...")],
                                   Expression),
                          "List.fM"))

let heldOnly =
    Test.Case(name = "a namespace is offered only where it holds what may stand there",
              run = fn() = {
                  let names =
                      withNamespaces([Name(text = "Net.get", kind = Value, shown = "Net.get"),
                                      Name(text = "Shell.Region.Region",
                                           kind = Type,
                                           shown = "type Shell.Region.Region")]);
                  let completed = complete("S", names, TypeName).word;
                  if completed == "Shell." then Test.Passed else Test.Failed(completed)
              })

let wholeWord =
    Test.Case(name = "the whole name the cursor stands in",
              run = fn() =
                  if wordAt("x + List.m(1)", 8) == "List.m"
                      && wordAt("List.map xs", 6) == "List.map" then
                      Test.Passed
                  else
                      Test.Failed(wordAt("List.map xs", 6)))

let namespaces =
    Test.Case(name = "a type with members is a namespace, completing with its dot",
              run = fn() =
                  becomes(complete(word("Ad"),
                                   withNamespaces([Name(text = "Address.call",
                                                        kind = Value,
                                                        shown = "Address.call")]),
                                   Expression),
                          "Address."))

let anything =
    Test.Case(name = "a command's own names are all admitted, types among them",
              run = fn() = becomes(complete(word("In"), library(), Anything), "Int"))

let inAType =
    Test.Case(name = "a type position takes types and modules only",
              run = fn() = becomes(complete(word("In"), library(), TypeName), "Int"))

let inAPattern =
    Test.Case(name = "a pattern position takes constructors",
              run = fn() = becomes(complete(word("So"), library(), Pattern), "Some"))

let inFields =
    Test.Case(name = "a field position takes the fields of its constructor",
              run = fn() =
                  becomes(complete("na",
                                   library(),
                                   Fields([Name(text = "name",
                                                kind = Value,
                                                shown = "name : String"),
                                           Name(text = "level",
                                                kind = Value,
                                                shown = "level : Int")])),
                          "name"))

fn library() : List(Name) =
    [Name(text = "List", kind = Module, shown = "module List"),
     Name(text = "List.map", kind = Value, shown = "List.map : ..."),
     Name(text = "List.filter", kind = Value, shown = "List.filter : ..."),
     Name(text = "List.filterMap", kind = Value, shown = "List.filterMap : ..."),
     Name(text = "Int", kind = Type, shown = "type Int"),
     Name(text = "Some", kind = Constructor, shown = "Some : (a) -> Optional(a)")]

fn becomes(completion : Completion, text : String) : Test.Result =
    if completion.word == text then
        Test.Passed
    else
        Test.Failed("\"" <> completion.word <> "\" instead of \"" <> text <> "\"")
