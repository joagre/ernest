/// Version 3: the state's shape changes (row C2), `State2` counting the puts
/// beside the items and the listener; `State` stays, the previous version's,
/// so that `migrate` can be written. The running store cannot take `State2`
/// in place, so `handover` starts a successor from the migrated state and
/// ends the old loop: the items cross as a value, the listener is reopened,
/// and the address is new. The node that stops is this on another node.
export type Msg =
    Put(key : String, value : Int)
  | Get(key : String, reply : Reply(Optional(Int)))
  | Size(reply : Reply(Int))
  | Port(reply : Reply(Int))

export type State = State(items : Map(String, Int), listener : Address(Tcp.ListenerMsg))

export type State2 =
    State2(items : Map(String, Int), listener : Address(Tcp.ListenerMsg), puts : Int)

export let store : Service.Handle(Msg, State2) = Service.start(fn() = opened(Map.empty), step)

/// The previous state's items under a listener of this process's own.
export fn migrate(old : State) : State2 with Service.Envelope(Msg, State2) =
    opened(old.items)

fn opened(items : Map(String, Int)) : State2 with Service.Envelope(Msg, State2) =
    match Tcp.listen("127.0.0.1", 0) {
        Right(listener) -> {
            let me = via(self(), Service.Message);
            let _ = spawn(fn() = accepting(listener, me));
            State2(items = items, listener = listener, puts = 0)
        }
      | Left(_) -> fault("cannot listen")
    }

/// The node that stops, on one node: the running store hands its state to a
/// successor started from `migrate` of it, and ends, its listener with it.
export fn handover(old : Service.Handle(Msg, State)) : Unit with n =
    match old {
        Service.Handle(loop = loop) -> send(loop, Service.Upgrade(next = fn(state) = {
            let successor = Service.start(fn() = migrate(state), step);
            Io.println("the successor listens on "
                           <> Int.toString(port(successor))
                           <> " with "
                           <> Int.toString(size(successor))
                           <> " keys")
        }))
    }

export fn step(state : State2, message : Msg) : State2 with Service.Envelope(Msg, State2) =
    match message {
        Put(key = key, value = value) ->
            State2(items = Map.put(state.items, key, value),
                   listener = state.listener,
                   puts = state.puts + 1)
      | Get(key = key, reply = reply) -> {
            answer(reply, Map.get(state.items, key));
            state
        }
      | Size(reply = reply) -> {
            answer(reply, Map.size(state.items));
            state
        }
      | Port(reply = reply) -> {
            answer(reply, portOf(state.listener));
            state
        }
    }

export fn portOf(listener : Address(Tcp.ListenerMsg)) : Int with n =
    match Tcp.port(listener) {
        Right(found) -> found
      | Left(_) -> 0
    }

/// Answers each connection the store's size and closes it; ends when the
/// listener does, which is when its owner does.
export fn accepting(listener : Address(Tcp.ListenerMsg), store : Address(Msg)) : Unit with m =
    match Tcp.accept(listener, 60000) {
        Right(socket) -> {
            let size = Address.callForever(store, fn(reply) = Size(reply = reply));
            let _ = Tcp.write(socket, String.toUtf8("keys: " <> Int.toString(size)), 1000);
            Tcp.close(socket);
            accepting(listener, store)
        }
      | Left(Io.Timeout) -> accepting(listener, store)
      | Left(_) -> Unit
    }

export fn put(key : String, value : Int) : Unit with n =
    send(Service.address(store), Put(key = key, value = value))

export fn get(key : String) : Optional(Int) with n =
    Address.callForever(Service.address(store), fn(reply) = Get(key = key, reply = reply))

export fn size(handle : Service.Handle(Msg, State2)) : Int with n =
    Address.callForever(Service.address(handle), fn(reply) = Size(reply = reply))

export fn port(handle : Service.Handle(Msg, State2)) : Int with n =
    Address.callForever(Service.address(handle), fn(reply) = Port(reply = reply))
