/// The catalog of version 2, beside version 1's, whose protocol carries
/// `Goods2.Item`; `forward` serves version 1's clients.
export type Msg = Add(Goods2.Item) | Find(name : String, reply : Reply(Optional(Goods2.Item)))

export let catalog : Service.Handle(Msg, Map(String, Goods2.Item)) = Service.start(fn() = Map.empty,
                                                                                   step)

export fn step(items : Map(String, Goods2.Item),
               message : Msg) : Map(String,
                                    Goods2.Item) with Service.Envelope(Msg,
                                                                       Map(String, Goods2.Item)) =
    match message {
        Add(item) -> Map.put(items, item.name, item)
      | Find(name = name, reply = reply) -> {
            answer(reply, Map.get(items, name));
            items
        }
    }

export fn migrate(items : Map(String, Goods.Item)) : Map(String, Goods2.Item) =
    Map.map(items, fn(_, item) = Goods2.fromV1(item))

/// A message of version 1 to the catalog of version 2; a find is asked of
/// the new catalog and its answer given back as version 1's item.
export fn forward(message : Catalog.Msg,
                  to : Address(Msg)) : Unit with Service.Envelope(Catalog.Msg,
                                                                  Map(String, Goods.Item)) =
    match message {
        Catalog.Add(item) -> send(to, Add(Goods2.fromV1(item)))
      | Catalog.Find(name = name, reply = reply) -> {
            let found = Address.callForever(to, fn(asked) = Find(name = name, reply = asked));
            answer(reply, Optional.map(found, Goods2.toV1))
        }
    }
