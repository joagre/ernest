// gather.ern: section 4's first program, `gathered` as a library.
// Written as the design would have it; nothing of it compiles today. It takes
// the open question's answer that wraps go: spawnMonitored delivers the Down to
// an address, so it can reach the conversation. With wraps kept it cannot be written.
export type Piece(a) = Piece(n : Int, value : a)

type GatherMsg(a) = Computed(Piece(a)) | Ended(Down)

// No `receiving`: it receives only on a conversation it holds, so it works
// in any process. `home` crosses into the helpers; `results` never leaves.
export fn gathered(numbers : List(Int), f : (Int) -> a) : List(Piece(a)) = {
    let results = Conversation.open();
    let home = address(results);
    List.forEach(numbers, fn(n) = {
        let _ = spawnMonitored(fn() = send(home, Computed(Piece(n = n, value = f(n)))),
                               adapted(home, Ended));
        Unit
    });
    let pieces = gather(results, List.size(numbers), 0, []);
    Conversation.close(results);
    pieces
}

// A helper that returned has sent its piece, and its Down keeps no order with
// that message; owed counts the helpers that returned whose piece has not come.
fn gather(results : Conversation(GatherMsg(a)),
          running : Int,
          owed : Int,
          pieces : List(Piece(a))) : List(Piece(a)) =
    if running == 0 && owed == 0 then
        pieces
    else receive {
        results: Computed(piece) -> gather(results, running, owed - 1, piece :: pieces)
      | results: Ended(Down(reason = Returned)) -> gather(results, running - 1, owed + 1, pieces)
      | results: Ended(_) -> gather(results, running - 1, owed, pieces)
    }
