//
// The report's pages: each of its three files whole,
// a page each, as docs/design/site.md's *The root* says, under
// the report's name with the file's version line; its chapters and sections
// anchored by their numbers or their appendices' letters, a sidebar two
// levels deep, previous and next in the order language, toolchain,
// library, and under each section the guide cites the guide's sections
// that cite it (site.md *Links*); and the report's contents page, each
// file with its chapters a line each. A report's code block gets Copy
// alone.
//

// A file of the report: its path and its page's address; the report's
// name and the file's title, `Ernest Report` and `The Language` of `Ernest
// Report: The Language`; its version line; and its blocks after them.
type File =
    File(source : String,
         address : String,
         name : String,
         title : List(Markdown.Inline),
         version : List(Markdown.Inline),
         blocks : List(Markdown.Block))

/// The report's three pages and its contents page, each section the guide
/// cites with its margin line.
export fn written(run : Run.Run, taught : Book.Taught) : Either(String, Unit) = {
    let files <-
        List.tryMap(["report/language.md", "report/toolchain.md", "report/library.md"],
                    fn(source) = fileRead(run, source));
    let _ <-
        List.tryMap(Run.neighbored(files), fn(neighbors) = fileWritten(run, taught, neighbors));
    contentsWritten(run, files)
}

// A file of the report read: its title split at its `: `, and its
// version line, the paragraph after the title, which each file has.
fn fileRead(run : Run.Run, source : String) : Either(String, File) = {
    let document <- Run.documentOf(run.root, source);
    let #(heading, rest) <- Run.titleOf(source, document);
    let #(name, title) <-
        Either.fromOptional(String.splitOnce(Html.plain(heading), ": "),
                            source <> ": the report's title is its name, `: ` and the file's");
    let address <- Either.fromOptional(Links.address(source), source <> " has no page of the site");
    match rest {
        Markdown.Paragraph(version) :: blocks when isVersion(version) ->
            Right(File(=source,
                       =address,
                       =name,
                       title = [Markdown.Text(title)],
                       =version,
                       blocks = Run.withoutContents(blocks)))
      | _ ->
            Left(source <> ": the line after the title is its version line, `For Ernest x.y.z.`")
    }
}

fn isVersion(inlines : List(Markdown.Inline)) : Bool =
    match inlines {
        Markdown.Text(first) :: _ -> String.startsWith(first, "For Ernest ")
      | _ -> false
    }

// A file's page: the sidebar of its chapters with their sections, the
// report's name above its title, its version line, its text with each margin
// line, and the files before and after it.
fn fileWritten(run : Run.Run,
               taught : Book.Taught,
               neighbors : #(Optional(File), File, Optional(File))) : Either(String, Unit) = {
    let #(earlier, file, later) = neighbors;
    let copied = Links.anchored(file.source, CodeBlock.copied(file.blocks));
    let page <- Run.linkPage(run, file.source, file.address, copied);
    let placed <- Run.linkedAll(run, copied, page);
    let lines <- List.tryMap(placed, fn(each) = blockLines(run, taught, each));
    let sidebar <-
        Run.sidebar(run, "fragments/contents.html", "On this page", entries(file.blocks));
    let titled <-
        Run.filled(run,
                   "fragments/book.html",
                   [#("href", Template.Plain("/report/")), #("book", Template.Plain(file.name))]);
    let version <-
        Run.filled(run, "fragments/version.html", [#("version_html", Run.inlined(file.version))]);
    let navigation <-
        Run.pageNavigation(run,
                           "Report",
                           Optional.map(earlier, neighbor),
                           Optional.map(later, neighbor));
    let main <-
        Run.filled(run,
                   "page.html",
                   [#("layout", Run.layout(sidebar)),
                    #("contents_html", Template.Markup(sidebar)),
                    #("book_html", Template.Markup(titled)),
                    #("heading_html", Run.headingHtml(file.title, None)),
                    #("body_html",
                      Template.Markup(version <> List.flatMap(lines, fn(each) = each))),
                    #("page_nav_html", Template.Markup(navigation))]);
    let description <- Run.described(file.source, file.blocks);
    Run.pageWritten(run,
                    Run.Output(address = file.address,
                               title = Html.plain(file.title) <> " · " <> file.name,
                               =description,
                               room = Some("Report"),
                               =main,
                               source = Some(file.source)))
}

fn neighbor(file : File) : Run.Neighbor =
    Run.Neighbor(address = file.address, text = file.title)

// A block's lines, a numbered heading's with its margin line after it where
// the guide cites its section.
fn blockLines(run : Run.Run,
              taught : Book.Taught,
              each : CodeBlock.Placed) : Either(String, List(Template.Line)) = {
    let margin <- match each.headed {
        Some(CodeBlock.Headed(anchor = Some(found))) -> marginLine(run, taught, found.id)
      | _ -> Right([])
    };
    Right(Html.body([each], 0) <> margin)
}

// The guide's sections that cite the report's section, each once,
// "Taught in guide §2.5, §3.6"; none where none cites it.
fn marginLine(run : Run.Run,
              taught : Book.Taught,
              anchor : String) : Either(String, List(Template.Line)) =
    match Map.get(taught.sections, anchor) {
        Some(sections) -> {
            let links =
                List.map(sections,
                         fn(section) =
                             Markdown.Link(text = [Markdown.Text("§" <> section)],
                                           url = "/guide/"
                                               <> Links.chapter(section)
                                               <> ".html#"
                                               <> section));
            let joined =
                List.flatMap(List.indexed(links),
                             fn(#(index, link)) =
                                 if index == 0 then [link] else [Markdown.Text(", "), link]);
            Run.filled(run, "fragments/margin-line.html", [#("links_html", Run.inlined(joined))])
        }
      | None ->
            Right([])
    }

// The file's numbered chapters and their sections, as the sidebar lists
// them.
fn entries(blocks : List(Markdown.Block)) : List(Run.Entry) =
    List.filterMap(blocks, fn(block) = match block {
        Markdown.Heading(=level, =text) when level == 2 || level == 3 ->
            Optional.map(Links.number(Html.plain(text)),
                         fn(found) = Run.Entry(anchor = found, =level, =text))
      | _ ->
            None
    })

// The report's contents page: its README's opening, the paragraphs before
// its table of the files, which the list of the files takes the place of,
// each file with its chapters a line each.
fn contentsWritten(run : Run.Run, files : List(File)) : Either(String, Unit) = {
    let source = "report/README.md";
    let document <- Run.documentOf(run.root, source);
    let #(_, rest) <- Run.titleOf(source, document);
    let #(opening, _) = List.span(rest, fn(block) = match block {
        Markdown.Table() -> false
      | _ -> true
    });
    let copied = CodeBlock.copied(opening);
    let page <- Run.linkPage(run, source, "/report/", copied);
    let linked <- Run.linkedAll(run, copied, page);
    let rows <- List.tryMap(files, fn(file) = fileEntry(run, file));
    let chapters <-
        Run.filled(run, "fragments/chapters.html", [#("entries_html", Run.markup(rows))]);
    let name = match files {
        file :: _ -> file.name
      | [] -> "Ernest Report"
    };
    let toc <-
        Run.filled(run,
                   "toc.html",
                   [#("heading_html", Run.inlined([Markdown.Text(name)])),
                    #("opening_html", Template.Markup(Html.body(linked, 0))),
                    #("entries_html", Template.Markup(chapters))]);
    let description <- Run.described(source, opening);
    Run.pageWritten(run,
                    Run.Output(address = "/report/",
                               title = Run.titled(name),
                               =description,
                               room = Some("Report"),
                               main = toc,
                               source = None))
}

fn fileEntry(run : Run.Run, file : File) : Either(String, List(Template.Line)) = {
    let lines <-
        List.tryMap(List.filter(entries(file.blocks), fn(entry) = entry.level == 2),
                    fn(entry) =
                        Run.filled(run,
                                   "fragments/section.html",
                                   [#("href", Template.Plain(file.address <> "#" <> entry.anchor)),
                                    #("label_html", Run.labeled(entry.text))]));
    let listed <-
        Run.filled(run, "fragments/sections.html", [#("entries_html", Run.markup(lines))]);
    Run.filled(run,
               "fragments/chapter.html",
               [#("href", Template.Plain(file.address)),
                #("label_html", Run.labeled(file.title)),
                #("sections_html", Template.Markup(listed))])
}
