//
// The documents of one page each, as docs/design/site.md's *The root* and
// *The other pages* say: Why, guide/why.md, at /why/; the questions,
// guide/faq.md, at /faq/; Install, the README's *Installing*, at /install/;
// Releases, CHANGES.md, at /releases/; and the deployment guide,
// guide/deployment.md, at /deployment/. A document that numbers none of its
// headings anchors each by its GitHub anchor, a second heading of the same
// anchor numbered as GitHub numbers it, and the deployment guide, which
// numbers them, by its number (site.md *Anchors*). A page has a sidebar
// where it has two headings for it or more.
//
// Projects, site/projects.md, at /projects/, is such a document whose list
// is the projects', each line through a fragment of its own: the project's
// icon, its name linked to its repository, and its purpose (site.md *The
// other pages*).
//

// A document of one page: its source, the header's room it stands in,
// where it stands in one, the heading the page shows where it is not the
// source's own, the section the page shows alone, by its heading, where it
// shows one, and what gives its blocks their buttons, the guide tests'
// grouping where they run its blocks in a bare shell, and Copy alone
// otherwise.
type Document =
    Document(source : String,
             room : Optional(String),
             heading : Optional(String),
             section : Optional(String),
             placing : (List(Markdown.Block)) -> List(CodeBlock.Placed))

/// The pages of Why, the questions, Install, Releases and the deployment
/// guide. Install and Releases are headed by their rooms' names, as the
/// header and the footer name them.
export fn written(run : Run.Run) : Either(String, Unit) = {
    let documents =
        [Document(source = "guide/why.md",
                  room = Some("Why"),
                  heading = None,
                  section = None,
                  placing = CodeBlock.placed),
         Document(source = "guide/faq.md",
                  room = None,
                  heading = None,
                  section = None,
                  placing = CodeBlock.placed),
         Document(source = "README.md",
                  room = Some("Install"),
                  heading = Some("Install"),
                  section = Some("Installing"),
                  placing = CodeBlock.copied),
         Document(source = "CHANGES.md",
                  room = None,
                  heading = Some("Releases"),
                  section = None,
                  placing = CodeBlock.copied),
         Document(source = "guide/deployment.md",
                  room = None,
                  heading = None,
                  section = None,
                  placing = CodeBlock.copied)];
    List.tryForEach(documents, fn(document) = documentWritten(run, document))
}

fn documentWritten(run : Run.Run, document : Document) : Either(String, Unit) = {
    let source = document.source;
    let address <- Either.fromOptional(Links.address(source), source <> " has no page of the site");
    let blocks <- Run.documentOf(run.root, source);
    let placing = document.placing;
    let placed = Links.anchored(source, placing(blocks));
    let #(heading, level, own) <- sectionOf(source, document.section, placed);
    let page <- Run.linkPage(run, source, address, own);
    let linked <- Run.linkedAll(run, own, page);
    let found = entries(level, own);
    let sidebar <- if List.size(found) < 2 then
        Right([])
    else
        Run.sidebar(run, "fragments/contents.html", "On this page", found);
    let shownHeading = match document.heading {
        Some(name) -> [Markdown.Text(name)]
      | None -> heading
    };
    let main <-
        Run.filled(run,
                   "page.html",
                   [#("layout", Run.layout(sidebar)),
                    #("contents_html", Template.Markup(sidebar)),
                    #("book_html", Template.Markup([])),
                    #("heading_html", Run.headingHtml(shownHeading, None)),
                    #("body_html", Template.Markup(Html.body(linked, level - 1))),
                    #("page_nav_html", Template.Markup([]))]);
    let description <- Run.described(source, List.map(own, fn(each) = each.block));
    Run.pageWritten(run,
                    Run.Output(=address,
                               title = Run.titled(Html.plain(shownHeading)),
                               =description,
                               room = document.room,
                               =main,
                               source = Some(source)))
}

// The heading the page shows, its level, and the blocks under it: the
// document's title and all after it, or the section whose heading's text
// is the one given, up to the next heading of its level or above.
fn sectionOf(source : String,
             section : Optional(String),
             placed : List(CodeBlock.Placed)) : Either(String,
                                                       #(List(Markdown.Inline),
                                                         Int,
                                                         List(CodeBlock.Placed))) = {
    let #(_, from) = List.span(placed, fn(each) = match each.block {
        Markdown.Heading(=text, =level) -> !isShownHeading(section, text, level)
      | _ -> true
    });
    match from {
        CodeBlock.Placed(block = Markdown.Heading(=text, =level)) :: rest -> {
            let #(own, _) = List.span(rest, fn(each) = match each.block {
                Markdown.Heading(level = inner) -> inner > level
              | _ -> true
            });
            Right(#(text, level, if section == None then rest else own))
        }
      | _ ->
            Left(source
                     <> " has no heading "
                     <> Optional.withDefault(section, "of the first level"))
    }
}

fn isShownHeading(section : Optional(String), text : List(Markdown.Inline), level : Int) : Bool =
    match section {
        Some(name) -> Html.plain(text) == name
      | None -> level == 1
    }

// The page's anchored headings of the two levels below its own, as the
// sidebar lists them.
fn entries(level : Int, own : List(CodeBlock.Placed)) : List(Run.Entry) =
    List.filterMap(own, fn(each) = match #(each.block, each.headed) {
        #(Markdown.Heading(level = inner, =text),
          Some(CodeBlock.Headed(anchor = Some(anchor)))) when inner == level + 1
            || inner == level + 2 -> Some(Run.Entry(anchor = anchor.id, level = inner, =text))
      | _ -> None
    })

//
// Projects
//

// A project's line of site/projects.md: its name, which names its icon
// under site/root/assets/img/projects/ too, its repository, and its
// purpose, one sentence.
type Project = Project(name : String, repository : String, purpose : List(Markdown.Inline))

/// The page of the projects, site/projects.md: its title, its opening, and
/// its list, a project a line.
export fn projectsWritten(run : Run.Run) : Either(String, Unit) = {
    let source = "site/projects.md";
    let address <- Either.fromOptional(Links.address(source), source <> " has no page of the site");
    let document <- Run.documentOf(run.root, source);
    let #(heading, rest) <- Run.titleOf(source, document);
    let #(opening, listed) = List.span(rest, fn(block) = match block {
        Markdown.Items() -> false
      | _ -> true
    });
    let items <- match listed {
        [Markdown.Items(=items)] -> Right(items)
      | _ -> Left(source <> " ends with its list of projects, and holds no other")
    };
    let found <- List.tryMap(items, fn(item) = projectOf(source, item));
    let page <- Run.linkPage(run, source, address, CodeBlock.copied(rest));
    let linked <- Run.linkedAll(run, CodeBlock.copied(opening), page);
    let lines <- List.tryMap(found, fn(project) = {
        let purpose <- Links.inlinesLinked(project.purpose, page);
        Run.filled(run,
                   "fragments/project.html",
                   [#("icon", Template.Plain("/assets/img/projects/" <> project.name <> ".png")),
                    #("href", Template.Plain(project.repository)),
                    #("name", Template.Plain(project.name)),
                    #("purpose_html", Run.inlined(purpose))])
    });
    let list <- Run.filled(run, "fragments/project-list.html", [#("rows_html", Run.markup(lines))]);
    let main <-
        Run.filled(run,
                   "page.html",
                   [#("layout", Run.layout([])),
                    #("contents_html", Template.Markup([])),
                    #("book_html", Template.Markup([])),
                    #("heading_html", Run.headingHtml(heading, None)),
                    #("body_html", Template.Markup(Html.body(linked, 0) <> list)),
                    #("page_nav_html", Template.Markup([]))]);
    let description <- Run.described(source, opening);
    Run.pageWritten(run,
                    Run.Output(=address,
                               title = Run.titled(Html.plain(heading)),
                               =description,
                               room = None,
                               =main,
                               source = Some(source)))
}

// A project's line, its name linked to its repository, `: `, and its
// purpose.
fn projectOf(source : String, item : List(Markdown.Block)) : Either(String, Project) = {
    let found = match item {
        [Markdown.Paragraph(Markdown.Link(=text, =url) :: Markdown.Text(following) :: rest)] ->
            match String.stripPrefix(following, ": ") {
                Some(first) ->
                    Some(Project(name = Html.plain(text),
                                 repository = url,
                                 purpose = Markdown.Text(first) :: rest))
              | _ ->
                    None
            }
      | _ ->
            None
    };
    Either.fromOptional(found,
                        source
                            <> ": a project's line is its name linked to its repository, `: `"
                            <> " and its purpose")
}
