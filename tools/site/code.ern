//
// A code block's HTML: Ernest colored as the toolchain's own lexer reads it,
// each qualified name of the library in it a link to its declaration, a
// console as written, a transcript with each input marked, and the buttons
// each block of a document gets beside Copy, decided by the guide tests' own
// grouping of its blocks (test/ern_guide_tests.erl), so that a block offered
// to the shell is one those tests run in a bare shell.
//

/// The buttons a code block gets beside Copy, which every block but a
/// signature has: Paste, for a module that runs alone in a bare shell, for
/// a transcript whose session a bare shell holds, an input at a time, or
/// for a module's example; Load, for such a module that exports `main`;
/// none; or, for a declaration's signature, which is no example, not even
/// Copy.
export type Buttons = CopyAlone | Paste | Load | Signature

/// A document's top-level block, with the buttons it gets, and the
/// declarations its code links, by their qualified names, each with the
/// address it leads to from the block's page, which `Site.Run.linkedAll`
/// gives it, none before.
export type Placed = Placed(block : Markdown.Block, given : Buttons, links : Map(String, String))

// A lexeme, as the generator's helper gives the lexer's token: its kind,
// where it begins, and the place after its last character.
type Lexeme = Lexeme(kind : Kind, at : Position, end : Position)

// A lexeme as the code writes it: the text between it and the one before,
// its kind, and its text.
type Token = Token(before : String, kind : Kind, text : String)

type Position = Position(line : Int, column : Int)

// A token's kind, the lexer's category (report §2): a reserved word, an
// operator or a delimiter, a name, a type's or a constructor's name, a
// literal of each type, a comment, and a doc block.
type Kind =
    Reserved
  | Symbol
  | Name
  | TypeName
  | IntLiteral
  | FloatLiteral
  | CharLiteral
  | StringLiteral
  | BoolLiteral
  | Comment
  | DocBlock

// What a top-level block is to the guide tests: a module of its own, with
// the buttons that gives it; a console of a session, the session named by
// the place of its first console; or anything else.
type Role = Alone(Buttons) | Part(Int) | Other

// A session at the shell: whether it began bare, `$ ern shell` with
// nothing after it, and its inputs, across every console that continues it.
type Session = Session(bare : Bool, inputs : List(String))

// The walk over a document's blocks: the count of the headings so far, the
// nearest console, and the sessions, each by the place of its first
// console.
type Walk = Walk(heading : Int, nearest : Optional(Console), sessions : Map(Int, Session))

// A console: the heading it stands under, by its count, and the session it
// holds, where it holds a `$ ern shell` command, which a console that
// begins with an input continues.
type Console = Console(heading : Int, session : Optional(Int))

//
// The buttons
//

/// A document's top-level blocks, each with its buttons, none for a block
/// that is no code. A module the guide tests take as one of its own,
/// an `ernest` block whose first line names no file, gets Paste, or Load
/// where it exports `main`; a session begun bare whose inputs load no module
/// by `:load` gets Paste on each of its consoles; every other block gets
/// none: a block joined with the others that name its file, a session begun
/// with a module, a node's or an attached one, and an `ernest-rejected`,
/// `ernest-fragment` or `ernest-prelude` block or another language's.
export fn placed(blocks : List(Markdown.Block)) : List(Placed) = {
    let start = Walk(heading = 0, nearest = None, sessions = Map.empty);
    let #(walk, roles) = List.mapFold(List.indexed(blocks), start, role);
    List.map(List.zip(blocks, roles), fn(#(block, found)) = match found {
        Alone(given) -> unlinked(block, given)
      | Part(first) -> unlinked(block, sessionButtons(Map.get(walk.sessions, first)))
      | Other -> unlinked(block, CopyAlone)
    })
}

// A block's role, as the guide tests group the blocks (ern_guide_tests's
// continued/2 and group/2).
fn role(walk : Walk, indexed : #(Int, Markdown.Block)) : #(Walk, Role) = {
    let #(index, block) = indexed;
    match block {
        Markdown.Heading() ->
            #(Walk(..walk, heading = walk.heading + 1), Other)
      | Markdown.Code(=info, =lines) when language(info) == "ernest" ->
            #(walk, Alone(moduleButtons(lines)))
      | Markdown.Code(=info, =lines) when language(info) == "console" ->
            consoleRole(walk, index, lines)
      | _ ->
            #(walk, Other)
    }
}

// A console that begins with an input continues the session of the nearest
// console before it under its heading, where that one holds a session; one
// that holds a `$ ern shell` command begins a session; any other is none.
fn consoleRole(walk : Walk, index : Int, lines : List(String)) : #(Walk, Role) =
    match continued(walk, lines) {
        Some(begun) -> {
            let sessions = Map.update(walk.sessions, begun, fn(found) = continuedBy(found, lines));
            #(Walk(..walk, =sessions), Part(begun))
        }
      | None when List.any(lines, isShellCommand) -> {
            let begun =
                Session(bare = List.take(lines, 1) == ["$ ern shell"], inputs = inputs(lines));
            let nearest = Console(heading = walk.heading, session = Some(index));
            #(Walk(..walk,
                   nearest = Some(nearest),
                   sessions = Map.put(walk.sessions, index, begun)),
              Part(index))
        }
      | None ->
            #(Walk(..walk, nearest = Some(Console(heading = walk.heading, session = None))), Other)
    }

// The session a console continues, by its first console's place.
fn continued(walk : Walk, lines : List(String)) : Optional(Int) =
    match walk.nearest {
        Some(Console(=heading, session = Some(begun))) when heading == walk.heading
            && beginsWithInput(lines) -> Some(begun)
      | _ -> None
    }

// The session with a console's inputs added; one the walk has not found,
// which no console continues, offers nothing.
fn continuedBy(found : Optional(Session), lines : List(String)) : Session =
    match found {
        Some(session) -> Session(..session, inputs = session.inputs <> inputs(lines))
      | None -> Session(bare = false, inputs = inputs(lines))
    }

// A module of its own, which names no file on its first line, as
// `// net/http.ern` does, runs alone where the shell takes it as one
// input; one that exports `main` is loaded.
fn moduleButtons(lines : List(String)) : Buttons =
    match lines {
        first :: _ when namesFile(first) -> CopyAlone
      | _ when !isOneInput(lines) -> CopyAlone
      | _ when List.any(lines, fn(line) = String.startsWith(line, "export fn main(")) -> Load
      | _ -> Paste
    }

// A paragraph of a block, its lines between blank lines, as report §11.3
// reads an example's: a declaration where its first token is `type`,
// `abstract`, `foreign` or `export`, or `fn` followed by a name; a `let`
// followed by a name, `export let` among them, which is a declaration too;
// or the body, any other.
type Paragraph = Declaration | LetDeclaration | Body

// Whether the shell takes the block as one input (report §11.2): a `let`
// at the prompt stands alone in its input, so a top-level `let` beside
// another declaration is more than one, and so are declarations followed
// by an expression.
fn isOneInput(lines : List(String)) : Bool = {
    let kinds = List.map(paragraphs(lines), paragraphKind);
    let declarations = List.size(List.filter(kinds, fn(kind) = kind != Body));
    let lets = List.size(List.filter(kinds, fn(kind) = kind == LetDeclaration));
    let #(_, afterFirst) = List.span(kinds, fn(kind) = kind == Body);
    (lets == 0 || declarations == 1) && !List.contains(afterFirst, Body)
}

// The block's paragraphs, each its lines, none empty.
fn paragraphs(lines : List(String)) : List(List(String)) = {
    let #(last, done) =
        List.foldLeft(lines,
                      #([], []),
                      fn(#(current, acc), line) =
                          if String.trim(line) == "" then
                              #([], if current == [] then acc else List.reverse(current) :: acc)
                          else
                              #(line :: current, acc));
    List.reverse(if last == [] then done else List.reverse(last) :: done)
}

// A paragraph's kind by its first two tokens, its comments aside, which no
// token of the grammar's is.
fn paragraphKind(lines : List(String)) : Paragraph = {
    let found = match tokens(String.join(lines, "\n")) {
        Some(#(all, _)) ->
            List.filter(all, fn(token) = token.kind != Comment && token.kind != DocBlock)
      | None ->
            []
    };
    match List.map(List.take(found, 2), fn(token) = #(token.kind, token.text)) {
        [#(Reserved, "export"), #(Reserved, "let")] -> LetDeclaration
      | [#(Reserved, "let"), #(Name, _)] -> LetDeclaration
      | [#(Reserved, "fn"), #(Name, _)] -> Declaration
      | [#(Reserved, "fn"), #(TypeName, _)] -> Declaration
      | #(Reserved, word) :: _ when List.contains(declaring, word) -> Declaration
      | _ -> Body
    }
}

// The words a declaration of report §11.3's begins with, beside `let` and
// `fn` followed by a name.
let declaring : List(String) = ["type", "abstract", "foreign", "export"]

// A first line that places its block in a file, `// net/http.ern`, the
// file's path lowercase words, digits and `_` between `/`s (report §11.1).
fn namesFile(line : String) : Bool =
    match Optional.andThen(String.stripPrefix(line, "// "),
                           fn(rest) = String.splitOnce(rest, ".ern")) {
        Some(#(path, _)) ->
            path != ""
                && List.all(String.toList(path),
                            fn(char) =
                                char >= 'a' && char <= 'z'
                                    || Char.isAsciiDigit(char)
                                    || char == '_'
                                    || char == '/')
      | None ->
            false
    }

fn sessionButtons(session : Optional(Session)) : Buttons =
    match session {
        Some(Session(bare = true, =inputs)) when !List.any(inputs, isLoad) -> Paste
      | _ -> CopyAlone
    }

fn isLoad(input : String) : Bool =
    String.startsWith(input, ":load")

fn isShellCommand(line : String) : Bool =
    line == "$ ern shell" || String.startsWith(line, "$ ern shell ")

fn beginsWithInput(lines : List(String)) : Bool =
    match lines {
        first :: _ -> String.startsWith(first, "> ")
      | [] -> false
    }

// A session's inputs are its `> ` lines.
fn inputs(lines : List(String)) : List(String) =
    List.filterMap(lines, fn(line) = String.stripPrefix(line, "> "))

// The block's language, the first word of its info string.
fn language(info : String) : String =
    Optional.withDefault(List.get(String.words(info), 0), "")

/// The blocks, each with Copy alone: a document none of whose blocks a test
/// runs in a bare shell, the tour's and the README's, whose programs are
/// the reader's own files, which their sessions load or run on nodes as
/// ern_tour_tests runs them, the deployment guide's, a node's, and the
/// report's and the release notes'.
export fn copied(blocks : List(Markdown.Block)) : List(Placed) =
    List.map(blocks, fn(block) = unlinked(block, CopyAlone))

/// A module's page's blocks, as `ern doc` writes it (report §11.4): the
/// `ernest` block right after a declaration's heading, one of the second
/// level, is the declaration's signature, which gets no button; every
/// other `ernest` block is an example, which the library's tests run, and
/// gets `offered`, Paste for a module of the standard library's and Copy
/// alone for a library's, which a bare shell reaches only by `:load`, or
/// Copy alone where the shell cannot take it as one input; any other block
/// gets none.
export fn documented(blocks : List(Markdown.Block), offered : Buttons) : List(Placed) = {
    let #(_, placed) =
        List.mapFold(blocks,
                     None,
                     fn(previous, block) =
                         #(Some(block),
                           unlinked(block, documentedButtons(previous, block, offered))));
    placed
}

fn documentedButtons(previous : Optional(Markdown.Block),
                     block : Markdown.Block,
                     offered : Buttons) : Buttons =
    match #(previous, block) {
        #(Some(Markdown.Heading(level = 2)), Markdown.Code(=info)) when language(info)
            == "ernest" ->
            Signature
      | #(_, Markdown.Code(=info, =lines)) when language(info) == "ernest" ->
            if isOneInput(lines) then offered else CopyAlone
      | _ ->
            CopyAlone
    }

/// The line a block offered to the shell is known by, where it is
/// offered: its first, a transcript's its first input.
export fn firstOffered(placed : Placed) : Optional(String) =
    match placed.block {
        Markdown.Code(=info, =lines) when placed.given == Paste || placed.given == Load ->
            if language(info) == "console" then List.get(inputs(lines), 0) else List.get(lines, 0)
      | _ ->
            None
    }

// A block with its buttons, before its page's links give it the
// declarations its code links.
fn unlinked(block : Markdown.Block, given : Buttons) : Placed =
    Placed(=block, =given, links = Map.empty)

//
// The types a page declares
//

/// The types the blocks' code declares, each name a `type` declares, in
/// the code the lexer reads: a program's, which may give a qualified name of
/// the library another meaning (report §4.2). A signature and an
/// `ernest-prelude` block show the library's own declarations, and declare
/// none of the page's.
export fn declared(placed : List(Placed)) : List(String) =
    List.unique(List.flatMap(placed,
                             fn(each) =
                                 if each.given == Signature then [] else blockDeclared(each.block)))

fn blockDeclared(block : Markdown.Block) : List(String) =
    match block {
        Markdown.Code(=info, =lines) when isProgram(info) ->
            match tokens(String.join(lines, "\n")) {
                Some(#(found, _)) -> typesDeclared(found)
              | None -> []
            }
      | Markdown.Quote(blocks) ->
            List.flatMap(blocks, blockDeclared)
      | Markdown.Items(=items) ->
            List.flatMap(items, fn(item) = List.flatMap(item, blockDeclared))
      | _ ->
            []
    }

// An Ernest block of a program's code, which the prelude's is not.
fn isProgram(info : String) : Bool =
    List.contains(["ernest", "ernest-fragment", "ernest-rejected"], language(info))

// The name after each `type`, which a declaration of a type writes next
// (report Appendix A).
fn typesDeclared(found : List(Token)) : List(String) =
    match found {
        Token(kind = Reserved, text = "type") :: Token(kind = TypeName, =text) :: rest ->
            text :: typesDeclared(rest)
      | _ :: rest ->
            typesDeclared(rest)
      | [] ->
            []
    }

//
// The HTML
//

/// A code block's `<pre>`, its class saying what it holds and its
/// `data-shell` the buttons it gets: an Ernest block colored, with each
/// qualified name of `links` a link, a block the compiler refuses marked
/// so, a transcript with its inputs and the shell's output each marked, and
/// a console or another language's block as written.
export fn html(info : String,
               lines : List(String),
               given : Buttons,
               links : Map(String, String)) : List(Site.Template.Line) = {
    let code = String.join(lines, "\n");
    match language(info) {
        "ernest" when given == Signature -> pre("code signature", given, colored(code, links))
      | "ernest" -> pre("code", given, colored(code, links))
      | "ernest-fragment" -> pre("code", given, colored(code, links))
      | "ernest-prelude" -> pre("code", given, colored(code, links))
      | "ernest-rejected" -> pre("code rejected", given, colored(code, links))
      | "console" when isTranscript(lines) -> pre("transcript", given, transcript(lines))
      | "console" -> pre("console", given, Site.Template.escaped(code))
      | _ -> pre("code", given, Site.Template.escaped(code))
    }
}

// The `<pre>` begins at its line's indentation and holds its body from the
// line's start (site/templates/README.md); a signature's says that the
// script gives it no tools, not even Copy.
fn pre(class : String, given : Buttons, body : String) : List(Site.Template.Line) = {
    let shell = match given {
        CopyAlone -> ""
      | Paste -> " data-shell=\"paste\""
      | Load -> " data-shell=\"load\""
      | Signature -> " data-tools=\"none\""
    };
    let open = "<pre class=\"" <> class <> "\"" <> shell <> "><code>";
    match String.split(open <> body <> "</code></pre>", "\n") {
        first :: rest -> Site.Template.Line(first) :: List.map(rest, Site.Template.Verbatim)
      | [] -> []
    }
}

// A console that shows a session at the shell: one that holds its `$ ern
// shell` command, or that continues one with its inputs.
fn isTranscript(lines : List(String)) : Bool =
    List.any(lines, isShellCommand) || beginsWithInput(lines)

// Each input, its prompt marked, and each line the shell printed; a console
// is plain monospace, its colors the live shell's alone.
fn transcript(lines : List(String)) : String =
    String.join(List.map(lines, transcriptLine), "\n")

fn transcriptLine(line : String) : String =
    match String.stripPrefix(line, "> ") {
        Some(input) ->
            "<span class=\"input\"><span class=\"prompt\">&gt; </span>"
                <> Site.Template.escaped(input)
                <> "</span>"
      | None when line == "" ->
            ""
      | None ->
            "<span class=\"tok-output\">" <> Site.Template.escaped(line) <> "</span>"
    }

// The code with each lexeme of a class in a span of it, as the lexer reads
// the code, and each qualified name `links` holds a link; code the lexer
// refuses, a fragment, is written as it is.
fn colored(code : String, links : Map(String, String)) : String =
    match tokens(code) {
        Some(#(found, rest)) -> String.join(tokensHtml(found, links), "") <> written(rest)
      | None -> written(code)
    }

// The tokens' HTML, a qualified name's in a link where `links` holds the
// name: a type's or a module's name, then a `.` and a name, as many as
// follow, nothing between them (report §4.2). A link begins after the text
// before the name.
fn tokensHtml(found : List(Token), links : Map(String, String)) : List(String) =
    match found {
        [] ->
            []
      | Token(kind = TypeName) :: _ -> {
            let #(name, later) = qualified(found);
            match #(name, Map.get(links, String.join(List.map(name, fn(each) = each.text), ""))) {
                #(first :: rest, Some(address)) -> {
                    let opened = written(first.before) <> "<a href=\"" <> written(address) <> "\">";
                    let inside = List.map(Token(..first, before = "") :: rest, tokenHtml);
                    [opened] <> inside <> ["</a>"] <> tokensHtml(later, links)
                }
              | _ ->
                    List.map(name, tokenHtml) <> tokensHtml(later, links)
            }
        }
      | token :: rest ->
            tokenHtml(token) :: tokensHtml(rest, links)
    }

// The tokens of the name that begins the tokens, its first and each `.`
// and name after it with nothing between, and the tokens after them.
fn qualified(found : List(Token)) : #(List(Token), List(Token)) =
    match found {
        first :: dot :: next :: rest when isJoined(dot, next) -> {
            let #(name, later) = qualified(next :: rest);
            #(first :: dot :: name, later)
        }
      | first :: rest ->
            #([first], rest)
      | [] ->
            #([], [])
    }

fn isJoined(dot : Token, next : Token) : Bool =
    dot.kind == Symbol
        && dot.text == "."
        && dot.before == ""
        && next.before == ""
        && (next.kind == Name || next.kind == TypeName)

// The lexer's tokens of the code, each with the text before it, and the
// text after the last; none where the lexer refuses the code.
fn tokens(code : String) : Optional(#(List(Token), String)) =
    Optional.map(lexed(code), fn(lexemes) = {
        let start = #([], String.toList(code), Position(line = 1, column = 1));
        let #(found, rest, _) = List.foldLeft(lexemes, start, fn(#(acc, chars, at), lexeme) = {
            let #(before, from, begun) = taken(chars, at, lexeme.at);
            let #(token, later, ended) = taken(from, begun, lexeme.end);
            let each =
                Token(before = String.fromList(before),
                      kind = lexeme.kind,
                      text = String.fromList(token));
            #(each :: acc, later, ended)
        });
        #(List.reverse(found), String.fromList(rest))
    })

// The characters from `at` up to `until`, the rest, and where the rest
// begins; a line feed ends a line, and a column is a character, as the
// lexer counts them (report §11.5).
fn taken(chars : List(Char),
         at : Position,
         until : Position) : #(List(Char), List(Char), Position) =
    takenInto(chars, at, until, [])

fn takenInto(chars : List(Char),
             at : Position,
             until : Position,
             acc : List(Char)) : #(List(Char), List(Char), Position) =
    match chars {
        char :: rest when isBefore(at, until) ->
            takenInto(rest, advanced(at, char), until, char :: acc)
      | _ ->
            #(List.reverse(acc), chars, at)
    }

fn isBefore(at : Position, until : Position) : Bool =
    at.line < until.line || at.line == until.line && at.column < until.column

fn advanced(at : Position, char : Char) : Position =
    if char == '\n' then
        Position(line = at.line + 1, column = 1)
    else
        Position(line = at.line, column = at.column + 1)

// A token's text after the text before it, in the span of its class, a
// line feed that ends it, a doc block's, after the span.
fn tokenHtml(token : Token) : String =
    written(token.before) <> spanned(token.kind, token.text)

fn spanned(kind : Kind, text : String) : String =
    match #(class(kind), String.stripSuffix(text, "\n")) {
        #(Some(name), Some(line)) -> span(name, line) <> "\n"
      | #(Some(name), None) -> span(name, text)
      | #(None, _) -> written(text)
    }

fn span(class : String, text : String) : String =
    "<span class=\"" <> class <> "\">" <> written(text) <> "</span>"

fn written(text : String) : String =
    Site.Template.escaped(text)

// The classes the stylesheet colors: the reserved words and `true` and
// `false`, the types' and the constructors' names, the literals of text,
// and the comments.
fn class(kind : Kind) : Optional(String) =
    match kind {
        Reserved -> Some("tok-keyword")
      | BoolLiteral -> Some("tok-keyword")
      | TypeName -> Some("tok-type")
      | StringLiteral -> Some("tok-string")
      | CharLiteral -> Some("tok-string")
      | Comment -> Some("tok-comment")
      | DocBlock -> Some("tok-comment")
      | Symbol -> None
      | Name -> None
      | IntLiteral -> None
      | FloatLiteral -> None
    }

// The lexer's tokens of the code, or none where it refuses the code: the
// lexer is the toolchain's, which the helper reaches (tools/site/ern_site.erl).
foreign fn lexed(code : String) : Optional(List(Lexeme)) =
    "ern_site:lexed/1"
