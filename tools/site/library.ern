//
// The library's pages: each module's page of docs/man/, which `make man`
// writes, at its path under /man/, the declarations every page's qualified
// names link to, and the contents pages, as docs/design/site.md's *The root*
// says: /man/ lists the standard library's modules and the libraries in two
// groups, a module a line, its name and the purpose its own page opens with,
// and ends with the toolchain's §11; /man/stdlib/ and /man/libs/ hold the
// two groups, and /man/libs/<name>/ a library's modules. A module's page
// anchors each declaration by its qualified name as its heading writes it,
// `#List.size`, lists the declarations by their short names under the
// module's, gives a signature no tools and an example Paste, and names the
// module's source in its footer, since docs/man/ is itself generated.
//

/// The library as docs/man/ holds it: /man/'s opening, its groups with
/// their modules, each module's page read, and its other lines, the
/// toolchain's.
export abstract type Library =
    Library(opening : List(Markdown.Block),
            groups : List(Group),
            lines : List(List(Markdown.Block)))

// A module of the library: its name, `List`, its page's path in docs/man/,
// its page's address, the library it is of, `libs/markdown`, where it is a
// library's, and its page's blocks after its title.
type Module =
    Module(name : String,
           path : String,
           address : String,
           library : Optional(String),
           blocks : List(Markdown.Block))

// A group of /man/: its name, the id its heading is named by, its
// contents page's address, and its modules.
type Group =
    Group(name : List(Markdown.Inline), id : String, address : String, modules : List(Module))

// A module's line in a contents page: the module, and the purpose its page
// opens with.
type Row = Row(module : Module, purpose : List(Markdown.Inline))

/// The library read from docs/man/ under the root: its README, each
/// group's, and each module's page.
export fn read(root : Path) : Either(String, Library) = {
    let source = "docs/man/README.md";
    let document <- Run.documentOf(root, source);
    let #(_, rest) <- Run.titleOf(source, document);
    let #(opening, listed) = List.span(rest, fn(block) = !isList(block));
    let items <- match listed {
        Markdown.Items(=items) :: _ -> Right(items)
      | _ -> Left(source <> " lists no group of modules")
    };
    let groups <-
        List.tryMap(List.filterMap(items, fn(item) = groupItem(source, item)),
                    fn(#(name, path)) = groupRead(root, name, path));
    let lines = List.filter(items, fn(item) = groupItem(source, item) == None);
    Right(Library(=opening, =groups, =lines))
}

/// Each declaration of the library by its qualified name, `List.sort` or
/// `Markdown.Block`, in its module's page, anchored by that name: a heading
/// of a module's page whose signature follows it, a type or a function. A
/// prelude name that no namespace qualifies, `spawn`, is a bare name, and
/// none of them (docs/design/site.md *Links*).
export fn declarations(library : Library) : Map(String, Links.Declaration) = {
    let modules = List.flatMap(library.groups, fn(group) = group.modules);
    Map.fromList(List.flatMap(modules, moduleDeclarations))
}

// A module's declarations, each by its qualified name.
fn moduleDeclarations(module : Module) : List(#(String, Links.Declaration)) = {
    let names =
        List.filterMap(Run.neighbored(CodeBlock.documented(module.blocks, CodeBlock.CopyAlone)),
                       fn(#(_, each, following)) = declarationOf(each, following));
    List.filterMap(names,
                   fn(name) =
                       Optional.map(Links.declarationAt(name, module.address),
                                    fn(found) = #(name, found)))
}

/// Every module's page, /man/ and each contents page under it.
export fn library(run : Run.Run, library : Library) : Either(String, Unit) = {
    let source = "docs/man/README.md";
    let page <-
        Run.linkPage(run,
                     source,
                     "/man/",
                     CodeBlock.copied(library.opening
                                          <> List.flatMap(library.lines, fn(each) = each)));
    let rows <-
        List.tryMap(library.groups,
                    fn(group) =
                        List.tryMap(group.modules, fn(module) = moduleWritten(run, module)));
    let grouped = List.zip(library.groups, rows);
    let _ <- List.tryMap(grouped, fn(#(group, own)) = groupWritten(run, group, own));
    let _ <- librariesWritten(run, List.flatMap(rows, fn(each) = each));
    indexWritten(run, page, library.opening, grouped, library.lines)
}

fn isList(block : Markdown.Block) : Bool =
    match block {
        Markdown.Items() -> true
      | _ -> false
    }

// An item of /man/'s list that names a group's README, the group's name and
// the README's path.
fn groupItem(source : String,
             item : List(Markdown.Block)) : Optional(#(List(Markdown.Inline), String)) =
    match item {
        [Markdown.Paragraph([Markdown.Link(=text, =url)])] ->
            match Either.toOptional(Links.resolved(source, url)) {
                Some(path) when String.endsWith(path, "/README.md") -> Some(#(text, path))
              | _ -> None
            }
      | _ ->
            None
    }

// A group read from its README: each module its list names, a module's
// library after its link where it is a library's.
fn groupRead(root : Path, name : List(Markdown.Inline), path : String) : Either(String, Group) = {
    let document <- Run.documentOf(root, path);
    let items = List.flatMap(document, fn(block) = match block {
        Markdown.Items(=items) -> items
      | _ -> []
    });
    let modules <- List.tryMap(items, fn(item) = moduleOf(root, path, item));
    let address <- Either.fromOptional(Links.address(path), path <> " has no page of the site");
    let id <-
        Either.fromOptional(List.last(List.dropLast(String.split(path, "/"), 1)),
                            path <> " stands in no directory");
    Right(Group(=name, =id, =address, =modules))
}

fn moduleOf(root : Path, index : String, item : List(Markdown.Block)) : Either(String, Module) =
    match item {
        [Markdown.Paragraph(Markdown.Link(=text, =url) :: rest)] -> {
            let path <- Links.resolved(index, url);
            let address <-
                Either.fromOptional(Links.address(path),
                                    index <> " lists " <> url <> ", which is no module's page");
            let library = List.get(List.filterMap(rest, fn(inline) = match inline {
                                       Markdown.CodeSpan(code) -> Some(code)
                                     | _ -> None
                                   }),
                                   0);
            let document <- Run.documentOf(root, path);
            let #(_, blocks) <- Run.titleOf(path, document);
            Right(Module(name = Html.plain(text), =path, =address, =library, =blocks))
        }
      | _ ->
            Left(index <> ": a module's line is a link to its page")
    }

//
// A module's page
//

// A page's `since` line, the paragraph after its title that is emphasis
// whole and begins `Since`, taken out of its text: the page shows it as its
// metadata under the heading, as a report file shows its version line, so that
// the module's purpose is the first sentence read.
fn sinceOf(blocks : List(Markdown.Block)) : #(List(Markdown.Inline), List(Markdown.Block)) =
    match blocks {
        Markdown.Paragraph([Markdown.Emphasis(inlines)]) :: rest when isSince(inlines) ->
            #(inlines, rest)
      | _ ->
            #([], blocks)
    }

fn isSince(inlines : List(Markdown.Inline)) : Bool =
    String.startsWith(Html.plain(inlines), "Since ")

// A module's page, and the purpose it opens with.
fn moduleWritten(run : Run.Run, module : Module) : Either(String, Row) = {
    let #(since, rest) = sinceOf(module.blocks);
    let #(blocks, source) = generated(module.path, rest);
    // site.md *The live shell*: a library's examples need `:load` in a
    // bare shell, which the panel's is
    let offered = if module.library == None then CodeBlock.Paste else CodeBlock.CopyAlone;
    let documented = CodeBlock.documented(blocks, offered);
    let page <- Run.linkPage(run, module.path, module.address, documented);
    let linked <- Run.linkedAll(run, documented, page);
    let placed = ownUnlinked(linked);
    let shown = declared(module.name, placed);
    let sidebar <-
        Run.sidebar(run,
                    "fragments/declarations.html",
                    module.name,
                    List.filterMap(shown, fn(#(_, entry, _)) = entry));
    let book <-
        Run.filled(run,
                   "fragments/book.html",
                   [#("href", Template.Plain("/man/")), #("book", Template.Plain("Library"))]);
    let sinceLine <- if since == [] then
        Right([])
    else
        Run.filled(run, "fragments/version.html", [#("version_html", Run.inlined(since))]);
    let body =
        sinceLine
            <> Html.body(List.map(shown, fn(#(each, _, _)) = each),
                         0,
                         List.filterMap(shown, fn(#(_, _, headed)) = headed));
    let main <-
        Run.filled(run,
                   "page.html",
                   [#("layout", Run.layout(sidebar)),
                    #("contents_html", Template.Markup(sidebar)),
                    #("book_html", Template.Markup(book)),
                    #("heading_html", Run.headingHtml([Markdown.Text(module.name)], None)),
                    #("body_html", Template.Markup(body)),
                    #("page_nav_html", Template.Markup([]))]);
    let description <- Run.described(module.path, blocks);
    let _ <-
        Run.pageWritten(run,
                        Run.Output(address = module.address,
                                   title = module.name <> " · Ernest library",
                                   =description,
                                   room = Some("Library"),
                                   =main,
                                   =source));
    let opening = Optional.withDefault(Run.firstProse(List.map(placed, fn(each) = each.block)), []);
    Right(Row(=module, purpose = Run.firstSentence(opening)))
}

// The page's blocks without its last line, which names the `ern` that
// wrote it and the module's source, `Generated by ern 0.10.0 from
// src/stdlib/list.ern.`, and the rule above it; and the source its footer
// names, that `.ern` file, or the page itself where the line names none,
// as the prelude's does.
fn generated(path : String,
             blocks : List(Markdown.Block)) : #(List(Markdown.Block), Optional(String)) =
    match List.reverse(blocks) {
        Markdown.Paragraph(last) :: Markdown.Rule :: kept when isGenerated(last) -> {
            let stem =
                Optional.andThen(String.splitOnce(Html.plain(last), " from "),
                                 fn(#(_, rest)) = String.stripSuffix(rest, ".ern."));
            let named = match stem {
                Some(name) -> name <> ".ern"
              | None -> path
            };
            #(List.reverse(kept), Some(named))
        }
      | _ ->
            #(blocks, Some(path))
    }

fn isGenerated(inlines : List(Markdown.Inline)) : Bool =
    match inlines {
        [Markdown.Text(line)] -> String.startsWith(line, "Generated by ern ")
      | _ -> false
    }

// Each block with its sidebar entry and what its heading carries, where it
// is a heading: a declaration's heading, written as code, anchored by its
// qualified name and listed by its short name, `size` of `List.size`; an
// `Examples` of the third level marked so; any other heading as it is.
fn declared(name : String,
            placed : List(CodeBlock.Placed)) : List(#(CodeBlock.Placed,
                                                      Optional(Run.Entry),
                                                      Optional(Html.Headed))) =
    List.map(Run.neighbored(placed),
             fn(#(_, each, following)) = match #(each.block, declarationOf(each, following)) {
                 #(Markdown.Heading(), Some(qualified)) -> {
                     let code = [Markdown.CodeSpan(qualified)];
                     #(CodeBlock.Placed(..each, block = Markdown.Heading(level = 2, text = code)),
                       Some(Run.Entry(anchor = qualified,
                                      level = 2,
                                      text = [Markdown.CodeSpan(shortName(name, qualified))])),
                       Some(Html.Headed(anchor = Some(Html.Anchor(id = qualified,
                                                                  label = "Link to " <> qualified)),
                                        class = Some("declaration"))))
                 }
               | #(Markdown.Heading(level = 3, text = [Markdown.Text("Examples")]), _) ->
                     #(each, None, Some(Html.Headed(anchor = None, class = Some("examples"))))
               | #(Markdown.Heading(), _) ->
                     #(each, None, Some(Html.Headed(anchor = None, class = None)))
               | _ ->
                     #(each, None, None)
             })

// Each block of a declaration's section, its signature and its examples,
// without a link to that declaration, the heading the block stands under.
fn ownUnlinked(placed : List(CodeBlock.Placed)) : List(CodeBlock.Placed) = {
    let #(_, unlinked) =
        List.mapFold(Run.neighbored(placed), None, fn(own, #(_, each, following)) = {
            let current = if Run.isHeadingOf(2, each.block) then
                declarationOf(each, following)
            else
                own;
            let links = match current {
                Some(name) -> Map.remove(each.links, name)
              | None -> each.links
            };
            #(current, CodeBlock.Placed(..each, =links))
        });
    unlinked
}

// The name a declaration's heading gives, a heading of the second level
// whose next block is its signature; none for any other block.
fn declarationOf(each : CodeBlock.Placed,
                 following : Optional(CodeBlock.Placed)) : Optional(String) =
    match #(each.block, following) {
        #(Markdown.Heading(level = 2, =text),
          Some(CodeBlock.Placed(given = CodeBlock.Signature))) -> Some(Html.plain(text))
      | _ -> None
    }

// A declaration's name without its module's, `size` of `List.size`; a
// prelude name, which no module's name heads, as it is.
fn shortName(name : String, qualified : String) : String =
    Optional.withDefault(String.stripPrefix(qualified, name <> "."), qualified)

//
// The contents pages
//

// /man/: the opening of docs/man/README.md, each group under its name, and
// the README's other lines, the toolchain's.
fn indexWritten(run : Run.Run,
                page : Links.Page,
                opening : List(Markdown.Block),
                grouped : List(#(Group, List(Row))),
                lines : List(List(Markdown.Block))) : Either(String, Unit) = {
    let linked <- Run.linkedAll(run, CodeBlock.copied(opening), page);
    let sections <- List.tryMap(grouped, fn(#(group, rows)) = {
        let list <- moduleList(run, rows);
        Run.filled(run,
                   "fragments/modules.html",
                   [#("id", Template.Plain(group.id)),
                    #("group_html", Run.inlined(group.name)),
                    #("list_html", Template.Markup(list))])
    });
    let toolchain <- List.tryMap(List.flatMap(lines, fn(item) = item), fn(block) = match block {
        Markdown.Paragraph(inlines) -> {
            let line <- Links.inlinesLinked(inlines, page);
            Run.filled(run, "fragments/toolchain.html", [#("line_html", Run.inlined(line))])
        }
      | _ ->
            Left("docs/man/README.md: a line of its list is a paragraph")
    });
    let description <- Run.described("docs/man/README.md", opening);
    contentsWritten(run,
                    "/man/",
                    [Markdown.Text("Library")],
                    description,
                    Html.body(linked, 0, []),
                    List.flatMap(sections <> toolchain, fn(each) = each))
}

// A group's contents page, its modules a line each.
fn groupWritten(run : Run.Run, group : Group, rows : List(Row)) : Either(String, Unit) = {
    let list <- moduleList(run, rows);
    contentsWritten(run, group.address, group.name, Html.plain(group.name), [], list)
}

// Each library's contents page, its modules a line each, at its directory
// under /man/libs/.
fn librariesWritten(run : Run.Run, rows : List(Row)) : Either(String, Unit) = {
    let libraries =
        List.unique(List.filterMap(rows,
                                   fn(row) =
                                       Optional.map(row.module.library,
                                                    fn(library) =
                                                        #(library,
                                                          directoryOf(row.module.address)))));
    let _ <- List.tryMap(libraries, fn(#(library, address)) = {
        let own = List.filter(rows, fn(row) = row.module.library == Some(library));
        let list <- moduleList(run, own);
        contentsWritten(run, address, [Markdown.CodeSpan(library)], library, [], list)
    });
    Right(Unit)
}

// The address of the directory a page stands in, `/man/libs/markdown/` of
// `/man/libs/markdown/markdown.html`.
fn directoryOf(address : String) : String =
    String.join(List.dropLast(String.split(address, "/"), 1), "/") <> "/"

fn moduleList(run : Run.Run, rows : List(Row)) : Either(String, List(Template.Line)) = {
    let lines <-
        List.tryMap(rows,
                    fn(row) =
                        Run.filled(run,
                                   "fragments/module.html",
                                   [#("href", Template.Plain(row.module.address)),
                                    #("name", Template.Plain(row.module.name)),
                                    #("purpose_html", Run.inlined(row.purpose))]));
    Run.filled(run, "fragments/module-list.html", [#("rows_html", Run.markup(lines))])
}

// A contents page of the library: its heading, its description, its
// opening and its lists. One with no opening is described by its heading.
fn contentsWritten(run : Run.Run,
                   address : String,
                   heading : List(Markdown.Inline),
                   description : String,
                   opening : List(Template.Line),
                   entries : List(Template.Line)) : Either(String, Unit) = {
    let toc <-
        Run.filled(run,
                   "toc.html",
                   [#("heading_html", Run.inlined(heading)),
                    #("opening_html", Template.Markup(opening)),
                    #("entries_html", Template.Markup(entries))]);
    Run.pageWritten(run,
                    Run.Output(=address,
                               title = Run.titled(Html.plain(heading)),
                               =description,
                               room = Some("Library"),
                               main = toc,
                               source = None))
}
