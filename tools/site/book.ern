//
// The site's books: the guide, guide/language.md, and the tour,
// tour/README.md, each a contents page and a page for each chapter, a
// second-level heading of its source, as docs/design/site.md's
// *The generation* says. The guide's contents list each chapter's sections;
// the tour's, each chapter with its own line, as its opening lists them. The
// guide's blocks get the buttons the guide tests' grouping gives them; the
// tour's Copy alone, since its programs are the reader's files, which its
// sessions load, or run on nodes, as ern_tour_tests runs them
// (site.md *The live shell*).
//

/// The report's sections the guide's sections cite, each by its anchor,
/// `5.4`, with the numbers of the guide's sections that cite it, each once,
/// in the guide's order: a report section's margin line.
export type Taught = Taught(sections : Map(String, List(String)))

// A book: its title, its source's path, its contents page's address, the
// header's room it stands in, its opening, the paragraphs before its first
// chapter, its chapters, and each chapter's summary, its own line, by its
// number, where its opening lists them.
type Book =
    Book(title : String,
         source : String,
         home : String,
         room : String,
         opening : List(CodeBlock.Placed),
         chapters : List(Chapter),
         summaries : Map(String, List(Markdown.Inline)))

// A book's chapter, a second-level heading of its source: its number, its
// heading's text, and its blocks after the heading.
type Chapter =
    Chapter(number : String, heading : List(Markdown.Inline), blocks : List(CodeBlock.Placed))

/// The guide's contents page and its chapters' pages, and the report's
/// sections its sections cite.
export fn guideWritten(run : Run.Run) : Either(String, Taught) = {
    let source = "guide/language.md";
    let book <- booked(run, source, "/guide/", "Guide", CodeBlock.placed);
    let _ <- written(run, book);
    Right(taught(book))
}

/// The tour's contents page and its chapters' pages.
export fn tourWritten(run : Run.Run) : Either(String, Unit) = {
    let book <- booked(run, "tour/README.md", "/tour/", "Tour", CodeBlock.copied);
    written(run, book)
}

fn written(run : Run.Run, book : Book) : Either(String, Unit) = {
    let _ <- contentsWritten(run, book);
    let _ <-
        List.tryMap(Run.neighbored(book.chapters),
                    fn(neighbors) = chapterWritten(run, book, neighbors));
    Right(Unit)
}

// The book a document is: its title, the first-level heading; its
// opening, the blocks up to its first chapter, without a list of its
// chapters, which gives each its line; and its chapters; each block with
// the buttons `placing` gives it, a heading with its anchor, and with its
// citations and its links made the site's, a chapter's on its own page.
fn booked(run : Run.Run,
          source : String,
          home : String,
          room : String,
          placing : (List(Markdown.Block)) -> List(CodeBlock.Placed)) : Either(String, Book) = {
    let document <- Run.documentOf(run.root, source);
    let #(title, blocks) <- Run.titleOf(source, Run.withoutContents(document));
    let placed <- Links.anchored(source, placing(blocks));
    let bookPage <- Run.linkPage(run, source, home, placed);
    let #(front, rest) = List.span(placed, fn(each) = !Run.isHeadingOf(2, each.block));
    let chapters <- chaptered(source, rest);
    let numbers = List.map(chapters, fn(chapter) = chapter.number);
    let #(listing, kept) =
        List.partition(front, fn(each) = Optional.isSome(chapterSummaries(numbers, each.block)));
    let page = Links.Page(..bookPage, declared = CodeBlock.declared(kept));
    let summaries <-
        List.tryMap(List.flatMap(listing,
                                 fn(each) =
                                     Optional.withDefault(chapterSummaries(numbers, each.block),
                                                          [])),
                    fn(#(found, summary)) =
                        Either.map(Links.inlinesLinked(summary, page),
                                   fn(linked) = #(found, linked)));
    let opening <- Run.linkedAll(run, kept, page);
    let linked <- List.tryMap(chapters, fn(chapter) = chapterLinked(run, home, bookPage, chapter));
    Right(Book(title = Html.plain(title),
               =source,
               =home,
               =room,
               =opening,
               chapters = linked,
               summaries = Map.fromList(summaries)))
}

// A chapter with its heading's and its blocks' citations and links made
// the site's, as its own page has them, the types its own code declares
// among them.
fn chapterLinked(run : Run.Run,
                 home : String,
                 bookPage : Links.Page,
                 chapter : Chapter) : Either(String, Chapter) = {
    let page =
        Links.Page(..bookPage,
                   address = home <> chapter.number <> ".html",
                   declared = CodeBlock.declared(chapter.blocks));
    let heading <- Links.headingLinked(chapter.heading, page);
    let blocks <- Run.linkedAll(run, chapter.blocks, page);
    Right(Chapter(..chapter, =heading, =blocks))
}

// The summaries a list of the book's chapters gives, each item a link to
// its chapter's heading and the chapter's own line after it, `[1. The
// counter](#1-the-counter): a process with a typed mailbox`; none for any
// other block.
fn chapterSummaries(numbers : List(String),
                    block : Markdown.Block) : Optional(List(#(String, List(Markdown.Inline)))) =
    match block {
        Markdown.Items(=items) when items != [] -> {
            let found = List.filterMap(items, fn(item) = chapterSummary(numbers, item));
            if List.size(found) == List.size(items) then Some(found) else None
        }
      | _ ->
            None
    }

fn chapterSummary(numbers : List(String),
                  item : List(Markdown.Block)) : Optional(#(String, List(Markdown.Inline))) =
    match item {
        [Markdown.Paragraph(Markdown.Link(=text, =url) :: Markdown.Text(following) :: rest)] ->
            match #(Links.number(Html.plain(text)), String.stripPrefix(following, ": ")) {
                #(Some(found), Some(summary)) when String.startsWith(url, "#")
                    && List.contains(numbers, found) ->
                    Some(#(found, Markdown.Text(summary) :: rest))
              | _ ->
                    None
            }
      | _ ->
            None
    }

// The chapters, each a second-level heading and the blocks up to the next.
fn chaptered(source : String, placed : List(CodeBlock.Placed)) : Either(String, List(Chapter)) =
    match placed {
        [] ->
            Right([])
      | CodeBlock.Placed(block = Markdown.Heading(=text)) :: rest -> {
            let #(own, later) = List.span(rest, fn(each) = !Run.isHeadingOf(2, each.block));
            let found <-
                Either.fromOptional(Links.number(Html.plain(text)),
                                    source
                                        <> ": the chapter \""
                                        <> Html.plain(text)
                                        <> "\" has no number");
            let others <- chaptered(source, later);
            Right(Chapter(number = found, heading = text, blocks = own) :: others)
        }
      | _ ->
            Left(source <> ": a chapter begins at its heading")
    }

// The contents page: the book's opening, then each chapter, with its
// sections a line each, or with its own line where the opening lists one.
fn contentsWritten(run : Run.Run, book : Book) : Either(String, Unit) = {
    let entries <- List.tryMap(book.chapters, fn(chapter) = chapterEntry(run, book, chapter));
    let chapters <-
        Run.filled(run, "fragments/chapters.html", [#("entries_html", Run.markup(entries))]);
    let toc <-
        Run.filled(run,
                   "toc.html",
                   [#("heading_html", Run.inlined([Markdown.Text(book.title)])),
                    #("opening_html", Template.Markup(Html.body(book.opening, 1))),
                    #("entries_html", Template.Markup(chapters))]);
    let description <- Run.described(book.source, List.map(book.opening, fn(each) = each.block));
    Run.pageWritten(run,
                    Run.Output(address = book.home,
                               title = Run.titled(book.title),
                               =description,
                               room = Some(book.room),
                               main = toc,
                               source = None))
}

fn chapterEntry(run : Run.Run,
                book : Book,
                chapter : Chapter) : Either(String, List(Template.Line)) = {
    let address = book.home <> chapter.number <> ".html";
    match Map.get(book.summaries, chapter.number) {
        Some(summary) ->
            Run.filled(run,
                       "fragments/chapter-line.html",
                       [#("href", Template.Plain(address)),
                        #("label_html", Run.labeled(chapter.heading)),
                        #("line_html", Run.labeled(summary))])
      | None -> {
            let lines <-
                List.tryMap(List.filter(sections(chapter), fn(section) = section.level == 3),
                            fn(section) =
                                Run.filled(run,
                                           "fragments/section.html",
                                           [#("href",
                                              Template.Plain(address <> "#" <> section.anchor)),
                                            #("label_html", Run.labeled(section.text))]));
            let listed <- if lines == [] then
                Right([])
            else
                Run.filled(run, "fragments/sections.html", [#("entries_html", Run.markup(lines))]);
            Run.filled(run,
                       "fragments/chapter.html",
                       [#("href", Template.Plain(address)),
                        #("label_html", Run.labeled(chapter.heading)),
                        #("sections_html", Template.Markup(listed))])
        }
    }
}

// A chapter's page: the sidebar of its sections, the book's title above
// its heading, its text, and the chapters before and after it. Its
// description is its own line where the book's opening gives one, and its
// first sentence otherwise.
fn chapterWritten(run : Run.Run,
                  book : Book,
                  neighbors : #(Optional(Chapter),
                                Chapter,
                                Optional(Chapter))) : Either(String, Unit) = {
    let #(earlier, chapter, later) = neighbors;
    let address = book.home <> chapter.number <> ".html";
    let sidebar <- Run.sidebar(run, "fragments/contents.html", "On this page", sections(chapter));
    let titled <-
        Run.filled(run,
                   "fragments/book.html",
                   [#("href", Template.Plain(book.home)), #("book", Template.Plain(book.title))]);
    let navigation <-
        Run.pageNavigation(run,
                           "Chapters",
                           Optional.map(earlier, fn(each) = neighbor(book, each)),
                           Optional.map(later, fn(each) = neighbor(book, each)));
    let anchor = Links.numberAnchor(Html.plain(chapter.heading));
    let main <-
        Run.filled(run,
                   "page.html",
                   [#("layout", Run.layout(sidebar)),
                    #("contents_html", Template.Markup(sidebar)),
                    #("book_html", Template.Markup(titled)),
                    #("heading_html", Run.headingHtml(chapter.heading, anchor)),
                    #("body_html", Template.Markup(Html.body(chapter.blocks, 1))),
                    #("page_nav_html", Template.Markup(navigation))]);
    let description <- match Map.get(book.summaries, chapter.number) {
        Some(summary) -> Right(Html.plain(summary))
      | None -> Run.described(book.source, List.map(chapter.blocks, fn(each) = each.block))
    };
    Run.pageWritten(run,
                    Run.Output(=address,
                               title = Html.plain(chapter.heading) <> " · " <> book.title,
                               =description,
                               room = Some(book.room),
                               =main,
                               source = Some(book.source)))
}

fn neighbor(book : Book, chapter : Chapter) : Run.Neighbor =
    Run.Neighbor(address = book.home <> chapter.number <> ".html", text = chapter.heading)

// Each numbered heading under the chapter's, a section's or one under it,
// as the sidebar and the contents list them.
fn sections(chapter : Chapter) : List(Run.Entry) =
    List.filterMap(chapter.blocks, fn(each) = match each.block {
        Markdown.Heading(=level, =text) when level == 3 || level == 4 ->
            Optional.map(Links.number(Html.plain(text)),
                         fn(found) = Run.Entry(anchor = found, =level, =text))
      | _ ->
            None
    })

// The report's sections each of the guide's sections cites, the chapter's
// own text before its first section counting as the chapter's.
fn taught(book : Book) : Taught = {
    let cited = List.flatMap(book.chapters, fn(chapter) = {
        let #(_, pairs) = List.mapFold(chapter.blocks, chapter.number, fn(section, each) = {
            let current = match each.block {
                Markdown.Heading(=text) ->
                    Optional.withDefault(Links.number(Html.plain(text)), section)
              | _ ->
                    section
            };
            #(current, List.map(Links.reportCited([each.block]), fn(anchor) = #(anchor, current)))
        });
        List.flatMap(pairs, fn(each) = each)
    });
    let table =
        List.foldLeft(cited,
                      Map.empty,
                      fn(acc, #(anchor, section)) =
                          Map.update(acc, anchor, fn(found) = match found {
                              Some(listed) when List.contains(listed, section) -> listed
                            | Some(listed) -> listed <> [section]
                            | None -> [section]
                          }));
    Taught(sections = table)
}
