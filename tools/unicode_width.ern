//
// Report Appendix E.16: writes the table `Terminal.width` reads into
// src/stdlib/terminal.ern, between its two marker lines, from Unicode's data
// of the version the host's grapheme segmentation follows, and refuses data
// of another. `make unicode UC_SPEC=dir` runs it, as `ern run
// unicode_width.erc dir`, dir holding EastAsianWidth.txt, emoji-data.txt
// and UnicodeData.txt, as OTP's lib/stdlib/uc_spec does.
//
// A code point is Zero when it is a combining mark (Mn, Me), a format
// character (Cf) or a control (Cc); else Wide when it is East Asian Wide or
// Fullwidth or of emoji presentation; else Pictographic when it is extended
// pictographic; and any other counts one and is not listed. The table is
// laid out as `ern format` lays it out (report §11.6): an entry a line, each
// under the first.
//

// The columns a code point the table lists counts, as `Terminal.width` names
// them.
type Width = Zero | Wide | Pictographic

// Adjacent code points of one width.
type Run = Run(low : Int, high : Int, width : Width)

let terminal : String = "src/stdlib/terminal.ern"

let beginMarker : String = "// Generated by tools/unicode_width.ern"

let endMarker : String = "// End of the generated table."

let usage : String = "usage: unicode_width uc_spec_dir"

// The last code point Unicode has.
let lastCode : Int = 0x10FFFF

// A file's time, as the other tools give theirs.
let fileMs : Int = 10000

// The version of Unicode the host's segmentation follows, its major and its
// minor number.
foreign fn specVersion() : #(Int, Int) =
    "unicode_util:spec_version/0"

export fn main() : Unit =
    match Os.arguments {
        [directory] ->
            match written(directory) {
                Right(line) -> Io.println(line)
              | Left(message) -> quit(message)
            }
      | _ ->
            quit(usage)
    }

// The table written from the directory's data, and the line that says so.
fn written(directory : String) : Either(String, String) = {
    let #(major, minor) = specVersion();
    let version = Int.toString(major) <> "." <> Int.toString(minor);
    let widths <- contents(directory, "EastAsianWidth.txt");
    let _ <- if isOfVersion(widths, version) then
        Right(Unit)
    else
        Left("the data in " <> directory <> " is not Unicode " <> version <> ", the host's");
    let data <- contents(directory, "UnicodeData.txt");
    let emoji <- contents(directory, "emoji-data.txt");
    let table <- tableOf(data, widths, emoji);
    let source <- contents(".", terminal);
    let lines =
        [beginMarker <> " from Unicode " <> version <> "'s data, under the Unicode",
         "// License v3 (THIRD_PARTY_LICENSES); not edited by hand."]
            <> rows(List.map(table, entry))
            <> [endMarker];
    let #(before, rest) <-
        Either.fromOptional(String.splitOnce(source, beginMarker),
                            "no line " <> beginMarker <> " in " <> terminal);
    let #(_, following) <-
        Either.fromOptional(String.splitOnce(rest, endMarker),
                            "no line " <> endMarker <> " in " <> terminal);
    let text = before <> String.join(lines, "\n") <> following;
    let _ <-
        Either.mapLeft(Fs.write(Path(terminal), String.toUtf8(text), fileMs),
                       fn(error) = "cannot write " <> terminal <> ": " <> Io.show(error));
    Right(Int.toString(List.size(table)) <> " ranges from Unicode " <> version)
}

// Whether EastAsianWidth.txt's text is of the version, as its first line
// names it.
fn isOfVersion(widths : String, version : String) : Bool =
    String.contains(widths, "EastAsianWidth-" <> version <> ".")

fn contents(directory : String, name : String) : Either(String, String) = {
    let path = Path(directory) <> Path(name);
    let bytes <-
        Either.mapLeft(Fs.read(path, fileMs),
                       fn(error) = "cannot read " <> Path.toString(path) <> ": " <> Io.show(error));
    Either.fromOptional(String.fromUtf8(bytes), Path.toString(path) <> " is not UTF-8")
}

// The table from the three files' text: each code point given the width of
// the last class that holds it, Pictographic, then Wide, then Zero, so that
// Zero wins over Wide and Wide over Pictographic.
fn tableOf(data : String, widths : String, emoji : String) : Either(String, List(Run)) = {
    let zero <- categories(data, ["Mn", "Me", "Cf", "Cc"]);
    let eastAsian <- properties(widths, ["W", "F"]);
    let presented <- properties(emoji, ["Emoji_Presentation"]);
    let pictographic <- properties(emoji, ["Extended_Pictographic"]);
    let classes = [#(Pictographic, pictographic), #(Wide, eastAsian <> presented), #(Zero, zero)];
    let marked =
        List.foldLeft(classes,
                      Map.empty,
                      fn(acc, #(width, ranges)) =
                          List.foldLeft(ranges,
                                        acc,
                                        fn(map, #(low, high)) = withWidth(map, low, high, width)));
    match runsFrom(lastCode, marked, []) {
        [] -> Left("the data gives no code point a width")
      | table -> Right(table)
    }
}

// The code points from low to high given the width.
fn withWidth(map : Map(Int, Width), low : Int, high : Int, width : Width) : Map(Int, Width) =
    if low > high then map else withWidth(Map.put(map, low, width), low + 1, high, width)

// The runs of the code points up to the code, before those already found.
fn runsFrom(code : Int, marked : Map(Int, Width), acc : List(Run)) : List(Run) =
    if code < 0 then
        acc
    else match Map.get(marked, code) {
        None -> runsFrom(code - 1, marked, acc)
      | Some(width) -> runsFrom(code - 1, marked, joined(code, width, acc))
    }

// The runs with the code point of the width before them, the first run
// taking it where it begins right after it and is of its width.
fn joined(code : Int, width : Width, runs : List(Run)) : List(Run) =
    match runs {
        Run(=low, =high, width = next) :: rest when low == code + 1 && next == width ->
            Run(low = code, =high, =width) :: rest
      | _ ->
            Run(low = code, high = code, =width) :: runs
    }

// The code points of the general categories, from UnicodeData.txt's lines
// `code;name;category;...`, whose large ranges are a line whose name ends
// `, First>` and the line after it.
fn categories(text : String, wanted : List(String)) : Either(String, List(#(Int, Int))) = {
    let named = List.filterMap(String.lines(text), fn(line) = match String.split(line, ";") {
        code :: name :: category :: _ when List.contains(wanted, category) -> Some(#(code, name))
      | _ -> None
    });
    let coded <-
        List.tryMap(named, fn(#(code, name)) = Either.map(hex(code), fn(value) = #(value, name)));
    Right(ranges(coded))
}

fn ranges(coded : List(#(Int, String))) : List(#(Int, Int)) =
    match coded {
        [] ->
            []
      | #(low, name) :: #(high, _) :: rest when String.endsWith(name, ", First>") ->
            #(low, high) :: ranges(rest)
      | #(code, _) :: rest ->
            #(code, code) :: ranges(rest)
    }

// The code points with one of the values, from a file of lines
// `code[..code] ; value # comment`.
fn properties(text : String, wanted : List(String)) : Either(String, List(#(Int, Int))) = {
    let codes = List.filterMap(String.lines(text), fn(line) = {
        let data = match String.splitOnce(line, "#") {
            Some(#(before, _)) -> before
          | None -> line
        };
        match String.splitOnce(data, ";") {
            Some(#(codes, value)) when List.contains(wanted, String.trim(value)) ->
                Some(String.trim(codes))
          | _ ->
                None
        }
    });
    List.tryMap(codes, range)
}

fn range(codes : String) : Either(String, #(Int, Int)) =
    match String.splitOnce(codes, "..") {
        Some(#(low, high)) -> {
            let low <- hex(low);
            let high <- hex(high);
            Right(#(low, high))
        }
      | None ->
            Either.map(hex(codes), fn(code) = #(code, code))
    }

fn hex(text : String) : Either(String, Int) =
    Either.fromOptional(String.toIntBase(String.trim(text), 16), "not a code point: " <> text)

fn entry(run : Run) : String =
    "#(0x" <> code(run.low) <> ", 0x" <> code(run.high) <> ", " <> widthName(run.width) <> ")"

// A code point in hexadecimal, at least four digits, as Unicode writes it.
// Base 16 is one `Int.toStringBase` writes in, so `None` does not come.
fn code(point : Int) : String =
    match Int.toStringBase(point, 16) {
        Some(digits) -> String.padStart(digits, 4, "0")
      | None -> fault("Int.toStringBase writes no digits in base 16")
    }

fn widthName(width : Width) : String =
    match width {
        Zero -> "Zero"
      | Wide -> "Wide"
      | Pictographic -> "Pictographic"
    }

// The binding and its entries, the first after the bracket and each other
// under it, the last closing it.
fn rows(entries : List(String)) : List(String) = {
    let last = List.size(entries) - 1;
    "let widthTable ="
        :: List.map(List.indexed(entries), fn(#(index, entry)) = {
            let indent = if index == 0 then "    [" else "     ";
            indent <> entry <> (if index == last then "]" else ",")
        })
}

fn quit(message : String) : Unit = {
    Io.printlnError(message);
    Os.exit(1)
}

//
// Tests
//

// Lines of the three files, made by hand: U+0010 and U+0011 are controls,
// U+0011 to U+0013 East Asian Wide, U+0013 to U+0015 and U+0020 extended
// pictographic, and U+0016 of emoji presentation, so that U+0011 is Zero
// and U+0013 Wide.
let handData : String = "0010;<control>;Cc;0;BN;;;;;N;;;;;\n0011;<control>;Cc;0;BN;;;;;N;;;;;\n"

let handWidths : String = "# EastAsianWidth-17.0.0.txt\n0011..0013     ; W  # Lo     [3] x\n"

let handEmoji : String =
    "0013..0015    ; Extended_Pictographic# E0.0   [3] x\n"
        <> "0016          ; Emoji_Presentation   # E0.6   [1] x\n"
        <> "0020          ; Extended_Pictographic# E0.0   [1] x\n"

/// Report Appendix E.16: Zero wins over Wide and Wide over Pictographic,
/// adjacent code points of one width are one run, and a code point of no
/// class is not listed.
let ordersTheClasses =
    Test.Case(name = "gives a code point its last class",
              run = fn() =
                  Test.equal(Either.map(tableOf(handData, handWidths, handEmoji),
                                        fn(table) = List.map(table, entry)),
                             Right(["#(0x0010, 0x0011, Zero)",
                                    "#(0x0012, 0x0013, Wide)",
                                    "#(0x0014, 0x0015, Pictographic)",
                                    "#(0x0016, 0x0016, Wide)",
                                    "#(0x0020, 0x0020, Pictographic)"])))

/// A range of UnicodeData.txt is a line whose name ends `, First>` and the
/// line after it, wherever it stands among the lines kept.
let readsFirstAndLast = Test.Case(name = "reads a First and Last range", run = fn() = {
    let text =
        "0041;LATIN CAPITAL LETTER A;Lo;0;L;;;;;N;;;;;\n"
            <> "0042;LATIN CAPITAL LETTER B;Lu;0;L;;;;;N;;;;;\n"
            <> "3400;<CJK Ideograph Extension A, First>;Lo;0;L;;;;;N;;;;;\n"
            <> "4DBF;<CJK Ideograph Extension A, Last>;Lo;0;L;;;;;N;;;;;\n"
            <> "4DC0;HEXAGRAM FOR THE CREATIVE HEAVEN;So;0;ON;;;;;N;;;;;\n";
    Test.equal(categories(text, ["Lo"]), Right([#(0x0041, 0x0041), #(0x3400, 0x4DBF)]))
})

/// Data of another version than the host's is refused.
let readsTheVersion =
    Test.Case(name = "reads the data's version",
              run = fn() =
                  Test.equal(#(isOfVersion(handWidths, "17.0"), isOfVersion(handWidths, "16.0")),
                             #(true, false)))

/// The table is laid out as `ern format` lays a long list out.
let laysOutTheTable =
    Test.Case(name = "lays the table out",
              run = fn() =
                  Test.equal(rows(["a", "b", "c"]),
                             ["let widthTable =", "    [a,", "     b,", "     c]"]))
