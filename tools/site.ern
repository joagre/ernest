//
// The website's generator (plan, MVP 4.2 item 2): it reads the
// repository's documents and the site's own files, site/templates/ and
// site/root/, fills the templates, writes the site as static files, checks
// every link of it, and ends, as docs/proposals/site/decisions.md's *The
// generation* says. It writes the root's assets, the icons gathered into
// one file, and the three logos the site shows; each kind of page through
// the module that knows it, the guide and the tour (Site.Book), the report
// (Site.Report), the library (Site.Library) and the documents of a page
// each (Site.Document); and the site's own pages, the homepage, the shell's
// and the 404 page. Every page's qualified names link to the library's
// declarations, and its citations of the log to the log's entries, so the
// two are read first; and the site's links are checked last
// (Site.Check), so that a site with one that leads nowhere is refused.
//
// `ern run site.erc root out version tag config`: `root` holds the
// repository's files, a checkout or a tag's export; `out`, which must not
// be there yet, is where the site is written, so that a page whose source
// is gone goes; `version` is the release the site shows, and `tag` the
// revision its links to GitHub name and its pages' dates are read at; and
// `config` the server's configuration file, whose `shell` gives the shell
// page its numbers (decisions *The templates*). A page's date is its
// source's last commit at the tag, which git gives in the working
// directory, a checkout, since an export has no history.
//

// The claims of Why the homepage shows, its first, the ones a newcomer
// reads at once (decisions *The homepage*).
let claimsShown : Int = 4

// The descriptions of the pages whose text a template holds, each its
// text's first sentence: the homepage's heading, and the shell page's
// opening (decisions *Links*).
let homeDescription : String = "Start a process on another node, and its code goes with it."

let shellDescription : String =
    "An Ernest shell of your own, in this page, with a second node, foo, beside it."

// The 404 page's fixed body (decisions *The generation*).
let notFoundText : String =
    "No page of the site has this address. The [homepage](/) leads to every part of it."

// The attributes of an icon's `svg` element its symbol keeps, and those it
// leaves: the namespace to the icons' file, the size to the page, and the
// line to the stylesheet's `.icon`.
let symbolKept : List(String) = ["viewBox", "fill"]

let symbolLeft : List(String) =
    ["xmlns", "width", "height", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin"]

export fn main() : Unit =
    match Os.arguments {
        [root, out, version, tag, config] ->
            match generated(Path(root), Path(out), version, tag, Path(config)) {
                Right(_) -> Unit
              | Left(message) -> quit(message)
            }
      | _ ->
            quit("usage: site root out version tag config")
    }

fn generated(root : Path,
             out : Path,
             version : String,
             tag : String,
             config : Path) : Either(String, Unit) = {
    let _ <- absent(out);
    let limits <- limitsRead(config);
    let templates <- templatesRead(root <> Path("site/templates"));
    let library <- Site.Library.read(root);
    let logText <- Site.Run.textOf(root <> Path("docs/log.md"));
    let log <- Site.Links.logEntries(logText);
    let assets <- rootCopied(root <> Path("site/root"), out);
    let _ <- logosCopied(root, out);
    let run =
        Site.Run.Run(=root,
                     =out,
                     =version,
                     =tag,
                     =templates,
                     =assets,
                     declarations = Site.Library.declarations(library),
                     =log);
    // The library's pages are written first, so that the pages it read go
    // then, which every later collection of the run would otherwise copy.
    let _ <- Site.Library.library(run, library);
    let taught <- Site.Book.guide(run);
    let _ <- Site.Book.tour(run);
    let _ <- Site.Report.report(run, taught);
    let _ <- Site.Document.documents(run);
    let _ <- homeWritten(run);
    let _ <- shellWritten(run, limits);
    let _ <- notFoundWritten(run);
    Site.Check.checked(out)
}

//
// The homepage
//

// The homepage, home.html: Why's first claims, each by its name and its
// first sentence, linking to its heading in Why, and the example, the
// counter typed into the shell and sent to the container's second node,
// from site/example.md, which ern_tour_tests runs (decisions *The
// homepage*). Its footer names home.html, its text the site's own.
fn homeWritten(run : Site.Run.Run) : Either(String, Unit) = {
    let source = "guide/why.md";
    let blocks <- Site.Run.documentOf(run.root, source);
    let anchors <- Site.Links.headingAnchors(source, blocks);
    let headings = List.filterMap(blocks, fn(block) = match block {
        Markdown.Heading(=text) -> Some(Site.Html.plain(text))
      | _ -> None
    });
    let anchored =
        Map.fromList(List.filterMap(List.zip(headings, anchors),
                                    fn(#(text, anchor)) =
                                        Optional.map(anchor, fn(found) = #(text, found.id))));
    let claims <- claimsOf(source, blocks);
    let lines <- List.tryMap(List.take(claims, claimsShown), fn(#(name, sentence)) = {
        let anchor <-
            Either.fromOptional(Map.get(anchored, name),
                                source <> ": the claim " <> name <> " has no heading of its own");
        Site.Run.filled(run,
                        "fragments/claim.html",
                        [#("anchor", Site.Template.Plain(anchor)),
                         #("name", Site.Template.Plain(name)),
                         #("sentence_html", Site.Run.labeled(sentence))])
    });
    let example <- Site.Run.documentOf(run.root, "site/example.md");
    let code = List.filterMap(Site.Code.copied(example), fn(each) = match each.block {
        Markdown.Code() -> Some(Site.Code.Placed(..each, given = Site.Code.Paste))
      | _ -> None
    });
    let page <- Site.Run.linkPage(run, "site/example.md", "/", code);
    let shown <- Site.Run.linkedAll(code, page);
    let main <-
        Site.Run.filled(run,
                        "home.html",
                        [#("claims_html", Site.Run.markup(lines)),
                         #("example_html", Site.Template.Markup(Site.Html.body(shown, 0, []))),
                         #("icons", Site.Template.Plain(run.assets.icons))]);
    Site.Run.pageWritten(run,
                         Site.Run.Output(address = "/",
                                         title = "Ernest",
                                         description = homeDescription,
                                         room = None,
                                         =main,
                                         source = Some("site/templates/home.html")))
}

// Why's claims, the list after its line "What Ernest adds is where the
// parts meet", each its bold name, without its period, and the first
// sentence after it.
fn claimsOf(source : String,
            blocks : List(Markdown.Block)) : Either(String,
                                                    List(#(String, List(Markdown.Inline)))) = {
    let #(_, from) = List.span(blocks, fn(block) = !isClaimsLead(block));
    match from {
        _ :: Markdown.Items(=items) :: _ ->
            List.tryMap(items, fn(item) = match item {
                [Markdown.Paragraph(Markdown.Strong(name) :: Markdown.Text(following) :: rest)] -> {
                    let named = Site.Html.plain(name);
                    let sentence = Markdown.Text(String.trimStart(following)) :: rest;
                    Right(#(if String.endsWith(named, ".") then
                                String.slice(named, 0, String.size(named) - 1)
                            else
                                named,
                            Site.Run.firstSentence(sentence)))
                }
              | _ ->
                    Left(source <> ": a claim is its bold name and its sentences")
            })
      | _ ->
            Left(source <> " lists no claims after \"What Ernest adds is where the parts meet\"")
    }
}

fn isClaimsLead(block : Markdown.Block) : Bool =
    match block {
        Markdown.Paragraph(inlines) ->
            String.startsWith(Site.Html.plain(inlines), "What Ernest adds is where the parts meet")
      | _ ->
            false
    }

//
// The shell's page
//

// The session's limits as the server enforces them, from its
// configuration's `shell` (ernest-httpd's design, *The configuration*):
// the lifetime without a key and the warning before its end, the most
// sessions at once, the starts an address may make within a window, all
// in milliseconds but the counts, and the memory a container is given, in
// megabytes, which the shell's command gives by `--memory`.
type Limits =
    Limits(lifetime : Int, warning : Int, atOnce : Int, starts : Int, within : Int, memory : Int)

// The shell's page, shell.html, its numbers the configuration's, so that
// it says what the server enforces (decisions *The templates*).
fn shellWritten(run : Site.Run.Run, limits : Limits) : Either(String, Unit) = {
    let main <-
        Site.Run.filled(run,
                        "shell.html",
                        [#("lifetime", Site.Template.Plain(spoken(limits.lifetime))),
                         #("warning", Site.Template.Plain(spoken(limits.warning))),
                         #("memory", Site.Template.Plain(Int.toString(limits.memory))),
                         #("at_once", Site.Template.Plain(Int.toString(limits.atOnce))),
                         #("starts", Site.Template.Plain(Int.toString(limits.starts))),
                         #("within", Site.Template.Plain(spoken(limits.within)))]);
    Site.Run.pageWritten(run,
                         Site.Run.Output(address = "/shell/",
                                         title = Site.Run.titled("Shell"),
                                         description = shellDescription,
                                         room = Some("Shell"),
                                         =main,
                                         source = Some("site/templates/shell.html")))
}

// A time in milliseconds as the shell's page says it, in the largest unit
// it is a whole number of: `5 minutes`, `a minute`, `an hour`.
fn spoken(ms : Int) : String = {
    let units =
        [#(3600000, "an hour", "hours"),
         #(60000, "a minute", "minutes"),
         #(1000, "a second", "seconds"),
         #(1, "a millisecond", "milliseconds")];
    match List.find(units, fn(#(size, _, _)) = ms % size == 0) {
        Some(#(size, one, many)) ->
            if ms == size then one else Int.toString(ms / size) <> " " <> many
      | None ->
            Int.toString(ms) <> " milliseconds"
    }
}

// The configuration's `shell` read, or why the shell's page cannot be
// written: a file that is no JSON, or one with no `shell`, a server that
// serves no shell.
fn limitsRead(config : Path) : Either(String, Limits) = {
    let named = Path.toString(config);
    let text <- Site.Run.textOf(config);
    let value <-
        Either.mapLeft(Json.parse(text), fn(error) = named <> " is not JSON: " <> Io.show(error));
    let shell <-
        Either.fromOptional(member(value, "shell"),
                            named
                                <> " has no shell, whose limits the shell's page states; the site"
                                <> " is built with the configuration of a server that serves one");
    let lifetime <- integer(named, shell, "lifetime");
    let warning <- integer(named, shell, "warning");
    let atOnce <- integer(named, shell, "most-at-once");
    let starts <- Either.fromOptional(member(shell, "starts"), named <> " has no shell.starts");
    let count <- integer(named, starts, "count");
    let within <- integer(named, starts, "within");
    let command <- match member(shell, "command") {
        Some(Json.Array(words)) ->
            List.tryMap(words, fn(word) = match word {
                Json.Text(text) -> Right(text)
              | _ -> Left(named <> ": shell.command is an array of strings")
            })
      | _ ->
            Left(named <> " has no shell.command")
    };
    let memory <- memoryOf(named, command);
    Right(Limits(=lifetime, =warning, =atOnce, starts = count, =within, =memory))
}

fn member(value : Json.Value, name : String) : Optional(Json.Value) =
    match value {
        Json.Object(members) -> Map.get(members, name)
      | _ -> None
    }

fn integer(named : String, object : Json.Value, name : String) : Either(String, Int) =
    match member(object, name) {
        Some(Json.Integer(found)) -> Right(found)
      | _ -> Left(named <> ": the shell's " <> name <> " is an integer")
    }

// The memory the shell's command gives a container, in megabytes, from its
// `--memory`, `--memory 128m` or `--memory=128m`, in `m` or `g` as podman
// writes them.
fn memoryOf(named : String, command : List(String)) : Either(String, Int) = {
    let given = match List.span(command, fn(word) = word != "--memory") {
        #(_, _ :: value :: _) ->
            Some(value)
      | _ ->
            List.get(List.filterMap(command, fn(word) = match String.splitOnce(word, "--memory=") {
                         Some(#("", value)) -> Some(value)
                       | _ -> None
                     }),
                     0)
    };
    match Optional.andThen(given, megabytes) {
        Some(found) ->
            Right(found)
      | None ->
            Left(named
                     <> ": shell.command gives no --memory in whole megabytes or gigabytes,"
                     <> " which the shell's page states")
    }
}

fn megabytes(value : String) : Optional(Int) = {
    let #(digits, unit) = List.span(String.toList(value), Char.isAsciiDigit);
    match #(String.toInt(String.fromList(digits)), unit) {
        #(Some(count), ['m']) -> Some(count)
      | #(Some(count), ['M']) -> Some(count)
      | #(Some(count), ['g']) -> Some(count * 1024)
      | #(Some(count), ['G']) -> Some(count * 1024)
      | _ -> None
    }
}

//
// The 404 page
//

// The page served for any unmatched path, page.html with its fixed body
// and a footer that names no source (decisions *The generation*).
fn notFoundWritten(run : Site.Run.Run) : Either(String, Unit) = {
    let blocks = Markdown.parse(notFoundText);
    let main <-
        Site.Run.filled(run,
                        "page.html",
                        [#("layout", Site.Template.Plain("error-page")),
                         #("contents_html", Site.Template.Markup([])),
                         #("book_html", Site.Template.Markup([])),
                         #("heading_html",
                           Site.Run.headingHtml([Markdown.Text("Not found")], None)),
                         #("body_html",
                           Site.Template.Markup(Site.Html.body(Site.Code.copied(blocks), 0, []))),
                         #("page_nav_html", Site.Template.Markup([]))]);
    let description <- Site.Run.described("the 404 page", blocks);
    Site.Run.pageWritten(run,
                         Site.Run.Output(address = "/404.html",
                                         title = Site.Run.titled("Not found"),
                                         =description,
                                         room = None,
                                         =main,
                                         source = None))
}

//
// The files
//

// The site is written whole into a directory of its own.
fn absent(out : Path) : Either(String, Unit) =
    match Fs.stat(out, 10000) {
        Left(Io.NotFound) ->
            Right(Unit)
      | Right(_) ->
            Left(Path.toString(out)
                     <> " is there already; the site is written into a new directory")
      | Left(error) ->
            Left("cannot read " <> Path.toString(out) <> ": " <> Io.show(error))
    }

// Every template and fragment under site/templates/, by its path there.
fn templatesRead(directory : Path) : Either(String, Map(String, Site.Template.Template)) = {
    let pages <- htmlFiles(directory, "");
    let fragments <- htmlFiles(directory <> Path("fragments"), "fragments/");
    let read <- List.tryMap(pages <> fragments, fn(#(name, path)) = {
        let text <- Site.Run.textOf(path);
        Either.map(Site.Template.parse("site/templates/" <> name, text),
                   fn(template) = #(name, template))
    });
    Right(Map.fromList(read))
}

fn htmlFiles(directory : Path, prefix : String) : Either(String, List(#(String, Path))) = {
    let entries <- Site.Run.listed(directory);
    Right(List.filterMap(entries,
                         fn(entry) =
                             match #(entry.kind,
                                     Path.name(entry.path),
                                     Path.extension(entry.path)) {
                                 #(Fs.File, Some(name), Some("html")) ->
                                     Some(#(prefix <> name, entry.path))
                               | _ ->
                                     None
                             }))
}

// The root copied, laid out as served, but the files whose names hold a
// digest of their content, written under those names: the stylesheet, the
// script, and the icons' file, which the icons are gathered into. The
// vendored files keep their names.
fn rootCopied(from : Path, out : Path) : Either(String, Site.Run.Assets) = {
    let digested = ["assets/css/site.css", "assets/js/site.js"];
    let _ <- treeCopied(from, out, [], digested);
    let stylesheet <- digestCopied(from, out, "assets/css/site.css");
    let script <- digestCopied(from, out, "assets/js/site.js");
    let gathered <- iconsGathered(from <> Path("assets/img/icons"));
    let icons <- digestWritten(out, "assets/img/icons.svg", String.toUtf8(gathered));
    Right(Site.Run.Assets(=stylesheet, =script, =icons))
}

fn treeCopied(from : Path,
              to : Path,
              under : List(String),
              left : List(String)) : Either(String, Unit) = {
    let entries <- Site.Run.listed(from);
    let _ <- Site.Run.made(to);
    let _ <- List.tryMap(entries, fn(entry) = {
        let name = Optional.withDefault(Path.name(entry.path), "");
        let relative = under <> [name];
        match entry.kind {
            Fs.Directory -> treeCopied(entry.path, to <> Path(name), relative, left)
          | Fs.File when List.contains(left, String.join(relative, "/")) -> Right(Unit)
          | Fs.File -> Site.Run.copied(entry.path, to <> Path(name))
          | _ -> Left(Path.toString(entry.path) <> " is neither a file nor a directory")
        }
    });
    Right(Unit)
}

// A file written under a name that holds the first eight hexadecimal
// digits of its SHA-1 digest, `site.3f9a2c1e.js`, and the address a page
// names it by.
fn digestCopied(from : Path, out : Path, relative : String) : Either(String, String) = {
    let bytes <- Site.Run.bytesOf(from <> Path(relative));
    digestWritten(out, relative, bytes)
}

fn digestWritten(out : Path, relative : String, bytes : Bytes) : Either(String, String) = {
    let digest = String.slice(String.toLower(Bytes.toHex(Crypto.sha1(bytes))), 0, 8);
    let named =
        Path.toString(Path.withoutExtension(Path(relative)))
            <> "."
            <> digest
            <> "."
            <> Optional.withDefault(Path.extension(Path(relative)), "");
    let _ <- Site.Run.fileWritten(out <> Path(named), bytes);
    Right("/" <> named)
}

// The icons' file, one symbol for each icon of the directory, by its
// file's name, `<symbol id="copy">` of copy.svg, in the order of their
// names, so that a page names an icon by one line, a `<use>` of its symbol
// (decisions *The templates*). A symbol keeps its icon's `viewBox` and
// `fill`, and its children as they are; its line is the stylesheet's
// `.icon`, which its `stroke` attributes leave to, and its size the page's.
fn iconsGathered(directory : Path) : Either(String, String) = {
    let entries <- Site.Run.listed(directory);
    let icons =
        List.sortBy(List.filter(entries,
                                fn(entry) =
                                    entry.kind == Fs.File
                                        && Path.extension(entry.path) == Some("svg")),
                    fn(entry) = Path.toString(entry.path));
    let symbols <- List.tryMap(icons, fn(entry) = {
        let text <- Site.Run.textOf(entry.path);
        let id = Optional.withDefault(Path.name(Path.withoutExtension(entry.path)), "");
        symbolOf(Path.toString(entry.path), id, text)
    });
    Right(String.join(["<svg xmlns=\"http://www.w3.org/2000/svg\">",
                       "  <!-- Lucide icons, ISC License: icons/LICENSE. Gathered from icons/, one"
                           <> " symbol each; their line is the stylesheet's .icon. -->"]
                          <> List.flatMap(symbols, fn(lines) = lines)
                          <> ["</svg>", ""],
                      "\n"))
}

// An icon's symbol, from its file as Lucide writes it: the `<svg` line, its
// attributes a line each up to the line `>`, then its children, a line
// each, and the `</svg>` line.
fn symbolOf(named : String, id : String, text : String) : Either(String, List(String)) = {
    let #(head, body) = List.span(String.lines(text), fn(line) = line != ">");
    let attributes <- match head {
        "<svg" :: rest -> List.tryMap(rest, fn(line) = attributeOf(named, line))
      | _ -> Left(named <> " does not begin with the line <svg, as Lucide writes an icon")
    };
    let children <- match List.reverse(body) {
        "</svg>" :: inner -> Right(List.drop(List.reverse(inner), 1))
      | _ -> Left(named <> " does not end with the line </svg> after its children")
    };
    let kept = List.filter(attributes, fn(#(name, _)) = List.contains(symbolKept, name));
    let written = List.map(kept, fn(#(name, value)) = " " <> name <> "=\"" <> value <> "\"");
    Right(["  <symbol id=\"" <> id <> "\"" <> String.join(written, "") <> ">"]
              <> List.map(children, fn(child) = "  " <> child)
              <> ["  </symbol>"])
}

// An attribute of an icon's `svg` element, its name and its value; one its
// symbol neither keeps nor leaves to another is refused.
fn attributeOf(named : String, line : String) : Either(String, #(String, String)) = {
    let found = match String.splitOnce(String.trim(line), "=\"") {
        Some(#(name, rest)) when String.endsWith(rest, "\"") ->
            Some(#(name, String.slice(rest, 0, String.size(rest) - 1)))
      | _ ->
            None
    };
    match found {
        Some(#(name, value)) when List.contains(symbolKept <> symbolLeft, name) ->
            Right(#(name, value))
      | Some(#(name, _)) ->
            Left(named
                     <> " gives its svg element "
                     <> name
                     <> ", which its symbol has no place for")
      | None ->
            Left(named
                     <> ": an attribute of its svg element is name=\"value\" on a line of its own")
    }
}

// The logos the site shows, at their paths in the repository's assets/:
// the stoat in the header, the favicon, and the image a shared link shows
// (docs/proposals/site/decisions.md *The look*).
fn logosCopied(root : Path, out : Path) : Either(String, Unit) = {
    let _ <- Site.Run.made(out <> Path("assets"));
    let _ <-
        List.tryMap(["ernest-mark.svg", "ernest-avatar-64.png", "ernest-social-light.png"],
                    fn(name) =
                        Site.Run.copied(root <> Path("assets") <> Path(name),
                                        out <> Path("assets") <> Path(name)));
    Right(Unit)
}

fn quit(message : String) : Unit = {
    Io.printlnError("site: " <> message);
    Os.exit(1)
}
