//
// The documents' listings, for the full review's readers of the report, the
// guide and the tour to start from (docs/reviews/full.md; the log's *The
// Documents Before the Launch*). Each reads the report's three files, the
// guide's documents under guide/ and the tour, tour/README.md, and fails
// nothing: a listing, not a limit.
//
// `ern run documents.erc job` writes the job's listing on standard output, a
// line a fact and its counts last. A section is a heading of the first to
// the third level outside a fenced block, with its lines up to the next one.
//
// - `lengths`: each section of the guide and the tour with its words, every
//   word of its lines but a fence's own, as `make coverage` counts the
//   report's, and a heading of the first or second level with the words of
//   the sections under it too.
// - `citations`: each section of the report, `§3.9` or `Appendix E.17`, with
//   the lines of the guide and the tour whose prose cites it, a `§` read as
//   the documents' test reads it; then each section none cites.
// - `terms`: each term of Appendix F with its count in the report, the
//   glossary aside, in the guide and in the tour (*The terms*).
// - `unchecked`: each fenced block no test's record names, by its mark and
//   its place, and each test that records the blocks it checks, with the
//   count its record names or why it is read as naming none (*The
//   blocks*).
// - `edits`: each section of the three by the commits that changed a line of
//   it, most first (*The edits*).
//

// The listing the command line asks for.
type Job = Lengths | Citations | Terms | Unchecked | Edits

// Where a line of a document stands: in prose, as a fence's own line, or
// inside a fenced block.
type Place = Prose | Fence | Fenced

// A line of a document: its number, counted from 1, its text and its place.
type Line = Line(number : Int, text : String, place : Place)

// A section: its heading's line, its level and its text after the marks, and
// the lines after the heading up to the next.
type Section = Section(heading : Line, level : Int, title : String, lines : List(Line))

let usage : String = "usage: documents lengths|citations|terms|unchecked|edits"

// The report's three files (report §0).
let reportFiles : List(String) = ["report/language.md", "report/toolchain.md", "report/library.md"]

let tourFile : String = "tour/README.md"

export fn main() : Unit =
    match Os.arguments {
        [name] ->
            match jobNamed(name) {
                Some(job) -> List.forEach(listed(job), Io.println)
              | None -> Repository.quit("documents", usage)
            }
      | _ ->
            Repository.quit("documents", usage)
    }

fn jobNamed(name : String) : Optional(Job) =
    match name {
        "lengths" -> Some(Lengths)
      | "citations" -> Some(Citations)
      | "terms" -> Some(Terms)
      | "unchecked" -> Some(Unchecked)
      | "edits" -> Some(Edits)
      | _ -> None
    }

fn listed(job : Job) : List(String) =
    match job {
        Lengths -> lengths()
      | Citations -> citations()
      | Terms -> terms()
      | Unchecked -> unchecked()
      | Edits -> edits()
    }

//
// The repository
//

// The guide's documents, as git tracks them.
fn guideFiles() : List(String) =
    String.lines(Repository.git("documents", ["ls-files", "--", "guide/*.md"]))

//
// The reading
//

// A document's lines, each with its place: a line that begins with three
// backticks opens a fenced block or closes the one open, as the guide's
// and the documents' tests read a fence.
fn linesOf(text : String) : List(Line) = {
    let #(_, lines) = List.mapFold(List.indexed(String.lines(text)), false, fn(fenced, each) = {
        let #(index, line) = each;
        if String.startsWith(line, "```") then
            #(!fenced, Line(number = index + 1, text = line, place = Fence))
        else
            #(fenced,
              Line(number = index + 1, text = line, place = if fenced then Fenced else Prose))
    });
    lines
}

// The sections of a document's lines; a line before the first heading is
// in none.
fn sectionsOf(lines : List(Line)) : List(Section) = {
    let gathered = List.foldLeft(lines, [], fn(acc, line) = match #(levelOf(line), acc) {
        #(Some(level), _) ->
            Section(heading = line, =level, title = titleOf(line.text), lines = []) :: acc
      | #(None, current :: rest) ->
            Section(..current, lines = line :: current.lines) :: rest
      | #(None, []) ->
            []
    });
    List.reverse(List.map(gathered,
                          fn(section) = Section(..section, lines = List.reverse(section.lines))))
}

// A heading's level, `## 3. Types` 2, from one to three; none for any other
// line.
fn levelOf(line : Line) : Optional(Int) =
    if line.place != Prose then
        None
    else {
        let #(marks, rest) = List.splitWhile(String.toList(line.text), fn(char) = char == '#');
        let level = List.size(marks);
        match rest {
            ' ' :: _ when level >= 1 && level <= 3 -> Some(level)
          | _ -> None
        }
    }

fn titleOf(heading : String) : String = {
    let #(_, rest) = List.splitWhile(String.toList(heading), fn(char) = char == '#');
    String.trimStart(String.fromList(rest))
}

fn sectionsIn(path : String) : List(Section) =
    sectionsOf(linesOf(Repository.contents("documents", path)))

// A section's place, `guide/language.md:120`.
fn placeOf(path : String, section : Section) : String =
    path <> ":" <> Int.toString(section.heading.number)

// A section's heading as the document writes it.
fn headingOf(section : Section) : String =
    section.heading.text

fn column(text : String, width : Int) : String =
    String.padStart(text, width, " ")

//
// The lengths
//

fn lengths() : List(String) = {
    let files = guideFiles() <> [tourFile];
    let counted =
        List.map(files,
                 fn(path) =
                     #(path, List.map(sectionsIn(path), fn(section) = #(section, words(section)))));
    let rows = List.flatMap(counted, fn(#(path, sections)) = lengthRows(path, sections));
    let sections = List.foldLeft(counted, 0, fn(acc, #(_, found)) = acc + List.size(found));
    let all =
        List.foldLeft(counted,
                      0,
                      fn(acc, #(_, found)) =
                          List.foldLeft(found, acc, fn(sum, #(_, count)) = sum + count));
    [column("words", 7) <> column("whole", 7) <> "  section"]
        <> rows
        <> ["",
            Int.toString(sections)
                <> " sections in "
                <> Int.toString(List.size(files))
                <> " documents, "
                <> Int.toString(all)
                <> " words."]
}

// The words of a section's lines, a fence's own line aside, as `make
// coverage` counts a section of the report's.
fn words(section : Section) : Int =
    List.foldLeft(section.lines, 0, fn(acc, line) = match line.place {
        Fence -> acc
      | _ -> acc + List.size(String.words(line.text))
    })

// A section's line each: its words, and for a heading of the first or
// second level the words of the sections under it with its own.
fn lengthRows(path : String, sections : List(#(Section, Int))) : List(String) =
    match sections {
        [] ->
            []
      | #(section, own) :: rest -> {
            let #(under, _) = List.splitWhile(rest, fn(#(next, _)) = next.level > section.level);
            let whole = List.foldLeft(under, own, fn(acc, #(_, count)) = acc + count);
            let shownWhole = if section.level < 3 then Int.toString(whole) else "";
            (column(Int.toString(own), 7)
                 <> column(shownWhole, 7)
                 <> "  "
                 <> placeOf(path, section)
                 <> "  "
                 <> headingOf(section))
                :: lengthRows(path, rest)
        }
    }

//
// The citations
//

fn citations() : List(String) = {
    let sections = List.flatMap(reportFiles, fn(path) = List.filterMap(sectionsIn(path), cited));
    let citing = List.flatMap(guideFiles() <> [tourFile], citingPlaces);
    let places =
        List.foldLeft(citing,
                      Map.empty,
                      fn(acc, #(key, place)) =
                          Map.update(acc,
                                     key,
                                     fn(found) = place :: Optional.withDefault(found, [])));
    let rows =
        List.map(sections,
                 fn(key) = #(key, List.reverse(Optional.withDefault(Map.get(places, key), []))));
    let none = List.filter(rows, fn(#(_, found)) = List.isEmpty(found));
    List.map(rows, citationRow)
        <> ["",
            Int.toString(List.size(rows))
                <> " sections of the report, "
                <> Int.toString(List.size(rows) - List.size(none))
                <> " cited by the guide or the tour, "
                <> Int.toString(List.size(none))
                <> " by none:",
            String.join(List.map(none, fn(#(key, _)) = shownKey(key)), ", ")]
}

// A report section's key as a citation names it, `3.9`, `3`, `Appendix E`
// or `E.17`, as the documents' test keys a heading; none for a heading
// that numbers nothing or whose number is unused.
fn cited(section : Section) : Optional(String) =
    if section.level < 2 || String.endsWith(section.title, " Unused") then
        None
    else
        numberOf(section.title)

fn numberOf(title : String) : Optional(String) =
    match String.stripPrefix(title, "Appendix ") {
        Some(rest) ->
            match String.toList(rest) {
                letter :: '.' :: tail when Char.isUpper(letter) ->
                    match leadingDigits(tail) {
                        #([], _) ->
                            Some("Appendix " <> Char.toString(letter))
                      | #(digits, _) ->
                            Some(Char.toString(letter) <> "." <> String.fromList(digits))
                    }
              | _ ->
                    None
            }
      | None ->
            Optional.map(Citations.numberAt(String.toList(title)), fn(#(number, _)) = number)
    }

// The citation a key is shown as, `§3.9`, `Appendix E` or `Appendix E.17`.
fn shownKey(key : String) : String =
    match String.toList(key) {
        letter :: '.' :: _ when Char.isUpper(letter) -> "Appendix " <> key
      | _ when String.startsWith(key, "Appendix ") -> key
      | _ -> "§" <> key
    }

fn citationRow(row : #(String, List(String))) : String = {
    let #(key, places) = row;
    let count = if List.isEmpty(places) then "-" else Int.toString(List.size(places));
    String.padEnd(shownKey(key), 15, " ") <> column(count, 4) <> "  " <> grouped(places)
}

// The places by file, `guide/language.md:12,40  tour/README.md:3`, each
// file in the order it is first met.
fn grouped(places : List(String)) : String = {
    let pairs = List.filterMap(places, fn(place) = String.splitOnce(place, ":"));
    let files = List.unique(List.map(pairs, fn(#(file, _)) = file));
    String.join(List.map(files,
                         fn(file) =
                             file
                                 <> ":"
                                 <> String.join(List.filterMap(pairs,
                                                               fn(#(other, line)) =
                                                                   if other == file then
                                                                       Some(line)
                                                                   else
                                                                       None),
                                                ",")),
                "  ")
}

// Each citation of the report in a document's prose, its key with its
// place, a line's each once.
fn citingPlaces(path : String) : List(#(String, String)) =
    List.flatMap(linesOf(Repository.contents("documents", path)), fn(line) = match line.place {
        Prose ->
            List.map(citedOn(path, line.text),
                     fn(key) = #(key, path <> ":" <> Int.toString(line.number)))
      | _ ->
            []
    })

// The report's sections a line cites, as `Citations` reads them: a `§`
// the report's by the words before it or the list it stands in, or bare
// outside the language guide; an appendix, `Appendix E`, or one of its
// sections, `Appendix E.17`; and `E.17`.
fn citedOn(path : String, line : String) : List(String) =
    List.unique(List.filterMap(Citations.pieces(line, Citations.bareOf(path)),
                               fn(piece) = match piece {
                                   Citations.Citation(document = Citations.Report, =section) ->
                                       Some(reportKey(section))
                                 | _ ->
                                       None
                               }))

// A report section's key as a citation of it gives it, `Appendix E` of an
// appendix's letter alone.
fn reportKey(section : String) : String =
    match String.toList(section) {
        [letter] when Char.isUpper(letter) -> "Appendix " <> section
      | _ -> section
    }

fn leadingDigits(chars : List(Char)) : #(List(Char), List(Char)) =
    List.splitWhile(chars, Char.isAsciiDigit)

fn isWordChar(char : Char) : Bool =
    Char.isAlpha(char) || Char.isAsciiDigit(char) || char == '_'

//
// The terms
//
// A term is a glossary entry's bold words. One in backticks, `spawn`, is
// code, counted in code spans and fenced blocks, its tokens as written; any
// other is prose, counted outside them, its tokens in any case and its last
// with an `s` or an `es` after it too, `adapted addresses`. A token is a
// run of letters, digits and `_`, so `request-reply` is two, and a term is
// met where its tokens stand together on one line.
//

// A glossary entry: its words, whether they are code, and its tokens.
type Term = Term(name : String, code : Bool, tokens : List(String))

// A document's tokens counted: how often each run of tokens that begins a
// term stands in its prose, and in its code.
type Counted = Counted(prose : Map(String, Int), code : Map(String, Int))

fn terms() : List(String) = {
    let report =
        List.flatMap(reportFiles,
                     fn(path) =
                         List.flatMap(sectionsIn(path),
                                      fn(section) =
                                          if String.startsWith(section.title, "Appendix F.") then
                                              []
                                          else
                                              section.heading :: section.lines));
    let glossary = glossaryTerms();
    let guide =
        List.flatMap(guideFiles(), fn(path) = linesOf(Repository.contents("documents", path)));
    let tour = linesOf(Repository.contents("documents", tourFile));
    let counted = List.map([report, guide, tour], fn(lines) = countedIn(glossary, lines));
    let rows =
        List.map(glossary, fn(term) = #(term, List.map(counted, fn(each) = countOf(each, term))));
    let unused =
        fn(index) =
            List.size(List.filter(rows, fn(#(_, counts)) = List.get(counts, index) == Some(0)));
    [column("report", 7) <> column("guide", 7) <> column("tour", 7) <> "  term"]
        <> List.map(rows,
                    fn(#(term, counts)) =
                        String.join(List.map(counts, fn(count) = column(Int.toString(count), 7)),
                                    "")
                            <> "  "
                            <> term.name)
        <> ["",
            Int.toString(List.size(rows))
                <> " terms: "
                <> Int.toString(unused(0))
                <> " the report names nowhere else, "
                <> Int.toString(unused(1))
                <> " the guide names none of, "
                <> Int.toString(unused(2))
                <> " the tour none of."]
}

// Appendix F's terms, in its order: each item's bold words.
fn glossaryTerms() : List(Term) = {
    let sections = sectionsIn("report/language.md");
    let glossary =
        List.filter(sections, fn(section) = String.startsWith(section.title, "Appendix F."));
    List.filterMap(List.flatMap(glossary, fn(section) = section.lines),
                   fn(line) =
                       Optional.andThen(String.stripPrefix(line.text, "- **"),
                                        fn(rest) =
                                            Optional.map(String.splitOnce(rest, "**"),
                                                         fn(#(name, _)) = termOf(name))))
}

fn termOf(name : String) : Term =
    match Optional.andThen(String.stripPrefix(name, "`"),
                           fn(rest) = String.stripSuffix(rest, "`")) {
        Some(code) -> Term(=name, code = true, tokens = tokensOf(code))
      | None -> Term(=name, code = false, tokens = List.map(tokensOf(name), String.toLower))
    }

// The tokens of a text: its runs of letters, digits and `_`.
fn tokensOf(text : String) : List(String) = {
    let #(last, found) =
        List.foldLeft(String.toList(text),
                      #([], []),
                      fn(#(current, acc), char) =
                          if isWordChar(char) then
                              #(char :: current, acc)
                          else if current == [] then
                              #([], acc)
                          else
                              #([], String.fromList(List.reverse(current)) :: acc));
    List.reverse(if last == [] then found else String.fromList(List.reverse(last)) :: found)
}

// A line's prose and its code: a fenced block's line is code, and a prose
// line's code spans, between backticks, are code beside its prose.
fn segmentsOf(line : Line) : #(List(String), List(String)) =
    match line.place {
        Fence ->
            #([], [])
      | Fenced ->
            #([], [line.text])
      | Prose -> {
            let parts = List.indexed(String.split(line.text, "`"));
            #(List.filterMap(parts,
                             fn(#(index, part)) = if index % 2 == 0 then Some(part) else None),
              List.filterMap(parts,
                             fn(#(index, part)) = if index % 2 == 1 then Some(part) else None))
        }
    }

// The runs of tokens that may be a term's, counted in a document's lines: a
// run that begins with a term's first token, as long as the term's longest.
fn countedIn(glossary : List(Term), lines : List(Line)) : Counted = {
    let #(code, prose) = List.partition(glossary, fn(term) = term.code);
    let proseFirsts = Set.fromList(List.flatMap(prose, fn(term) = match term.tokens {
        [only] -> [only, only <> "s", only <> "es"]
      | first :: _ -> [first]
      | [] -> []
    }));
    let codeFirsts = Set.fromList(List.filterMap(code, fn(term) = List.get(term.tokens, 0)));
    List.foldLeft(lines, Counted(prose = Map.empty, code = Map.empty), fn(acc, line) = {
        let #(proseParts, codeParts) = segmentsOf(line);
        let proseRuns =
            List.foldLeft(proseParts,
                          acc.prose,
                          fn(map, part) =
                              runsCounted(map,
                                          List.map(tokensOf(part), String.toLower),
                                          proseFirsts,
                                          longestOf(prose)));
        let codeRuns =
            List.foldLeft(codeParts,
                          acc.code,
                          fn(map, part) =
                              runsCounted(map, tokensOf(part), codeFirsts, longestOf(code)));
        Counted(prose = proseRuns, code = codeRuns)
    })
}

// The most tokens a term has.
fn longestOf(terms : List(Term)) : Int =
    List.foldLeft(terms, 0, fn(acc, term) = Int.max(acc, List.size(term.tokens)))

// Each run of up to `longest` tokens that begins with one of `firsts`,
// counted.
fn runsCounted(map : Map(String, Int),
               tokens : List(String),
               firsts : Set(String),
               longest : Int) : Map(String, Int) =
    match tokens {
        [] ->
            map
      | first :: rest when Set.contains(firsts, first) -> {
            let counted =
                List.foldLeft(List.range(1, longest),
                              map,
                              fn(acc, size) =
                                  if size > List.size(tokens) then
                                      acc
                                  else
                                      Map.update(acc,
                                                 String.join(List.take(tokens, size), " "),
                                                 fn(found) = Optional.withDefault(found, 0) + 1));
            runsCounted(counted, rest, firsts, longest)
        }
      | _ :: rest ->
            runsCounted(map, rest, firsts, longest)
    }

fn countOf(counted : Counted, term : Term) : Int = {
    let count = fn(map, tokens) = Optional.withDefault(Map.get(map, String.join(tokens, " ")), 0);
    if term.code then
        count(counted.code, term.tokens)
    else {
        let stem = List.dropLast(term.tokens, 1);
        List.foldLeft(List.takeLast(term.tokens, 1),
                      0,
                      fn(acc, last) =
                          acc
                              + count(counted.prose, stem <> [last])
                              + count(counted.prose, stem <> [last <> "s"])
                              + count(counted.prose, stem <> [last <> "es"]))
    }
}

//
// The blocks
//
// A test that checks a document's fenced blocks records each as it reads
// it, its document's path and its fence's line, under build/checked/ in a
// record named for the test (ern_helpers:record_checked/3), and a block is
// checked where a record read names it. The tests are the test files git
// tracks that call the recorder, each named by its file. A record's first
// line names the moment its run's host started, and the record is read
// where neither its test's source nor a document it covers has changed
// since; any other, or none, is read as naming nothing, and the listing
// says so by the test's name.
//

// A fenced block: its document, its fence's line, its mark, the word after
// the fence, and its lines.
type Block = Block(file : String, line : Int, mark : String, code : List(String))

// A test's record: the moment its run's host started, in milliseconds
// since the epoch, the documents it covers, and the places of the blocks
// it checked, each its document's path and its fence's line,
// `guide/language.md:12`.
type Record = Record(started : Int, covers : List(String), places : Set(String))

// A test's record as the listing reads it: the places it names, or why it
// names none.
type Reading = Read(places : Set(String)) | Unread(why : String)

// Where the tests write their records.
let recordsDir : String = "build/checked/"

// What a test's file calls to record a block.
let recorder : String = "ern_helpers:record_checked("

// The bytes of a block's first line shown, its last character whole.
let shownBytes : Int = 60

fn unchecked() : List(String) = {
    let files = reportFiles <> guideFiles() <> [tourFile];
    let blocks =
        List.flatMap(files,
                     fn(path) = blocksOf(path, linesOf(Repository.contents("documents", path))));
    let readings =
        List.map(recordingTests(), fn(#(test, source)) = #(test, readingOf(test, source)));
    uncheckedRows(blocks, readings)
}

// The listing's rows: each block no record read names, by its mark and its
// place; the counts by mark; each test's count of the blocks its record
// names, or why it names none; and the total.
fn uncheckedRows(blocks : List(Block), readings : List(#(String, Reading))) : List(String) = {
    let checked =
        List.foldLeft(readings,
                      Set.empty,
                      fn(all, #(_, reading)) = Set.fold(placesOf(reading), all, Set.put));
    let open = List.filter(blocks, fn(block) = !Set.contains(checked, blockPlace(block)));
    let marks = List.unique(List.sortBy(List.map(blocks, markOf), fn(mark) = mark));
    let sorted = List.sortBy(open, markOf);
    List.map(sorted,
             fn(block) =
                 String.padEnd(markOf(block), 16, " ")
                     <> String.padEnd(blockPlace(block), 26, " ")
                     <> " "
                     <> firstOf(block))
        <> [""]
        <> List.map(marks, fn(mark) = {
            let ofMark =
                fn(found) = List.size(List.filter(found, fn(block) = markOf(block) == mark));
            String.padEnd(mark, 16, " ")
                <> column(Int.toString(ofMark(sorted)), 4)
                <> " of "
                <> Int.toString(ofMark(blocks))
                <> " unchecked"
        })
        <> [""]
        <> List.map(readings, fn(#(test, reading)) = testRow(blocks, test, reading))
        <> ["",
            Int.toString(List.size(open))
                <> " of "
                <> Int.toString(List.size(blocks))
                <> " blocks no test checks."]
}

// The places a record read names, none for one unread.
fn placesOf(reading : Reading) : Set(String) =
    match reading {
        Read(=places) -> places
      | Unread(why = _) -> Set.empty
    }

// A test's row: the count of the blocks its record names, or why it names
// none.
fn testRow(blocks : List(Block), test : String, reading : Reading) : String = {
    let said = match reading {
        Read(=places) -> {
            let named = List.filter(blocks, fn(block) = Set.contains(places, blockPlace(block)));
            column(Int.toString(List.size(named)), 4) <> " checked"
        }
      | Unread(=why) ->
            why
    };
    String.padEnd(test, 22, " ") <> said
}

fn markOf(block : Block) : String =
    if block.mark == "" then "none" else block.mark

// A block's place, its document's path and its fence's line, as a record
// writes it.
fn blockPlace(block : Block) : String =
    block.file <> ":" <> Int.toString(block.line)

// A block's first line as the listing shows it, a character its bytes cut
// short left out.
fn firstOf(block : Block) : String = {
    let first = Optional.withDefault(List.get(block.code, 0), "");
    let #(shown, _) = String.fromUtf8Piece(Bytes.slice(String.toUtf8(first), 0, shownBytes));
    shown
}

// A document's fenced blocks, in order.
fn blocksOf(path : String, lines : List(Line)) : List(Block) = {
    let #(_, found) =
        List.foldLeft(lines, #(None, []), fn(#(open, found), line) = match #(line.place, open) {
            #(Fence, None) ->
                #(Some(Block(file = path,
                             line = line.number,
                             mark = String.trim(String.drop(line.text, 3)),
                             code = [])),
                  found)
          | #(Fence, Some(block)) ->
                #(None, Block(..block, code = List.reverse(block.code)) :: found)
          | #(Fenced, Some(block)) ->
                #(Some(Block(..block, code = line.text :: block.code)), found)
          | _ ->
                #(open, found)
        });
    List.reverse(found)
}

// Each test that records the blocks it checks, its name and its source:
// each test file git tracks that calls the recorder, by its name.
fn recordingTests() : List(#(String, String)) =
    String.lines(Repository.git("documents", ["grep", "-l", "-F", recorder, "--", "*_tests.erl"]))
        |> List.map(fn(source) = #(testOf(source), source))
        |> List.sortBy(fn(#(test, _)) = test)

// The test a source holds, `ern_docs_tests` of test/ern_docs_tests.erl.
fn testOf(source : String) : String = {
    let file = Optional.withDefault(List.last(String.split(source, "/")), source);
    Optional.withDefault(String.stripSuffix(file, ".erl"), file)
}

// A test's record as the listing reads it, the test's source beside it.
fn readingOf(test : String, source : String) : Reading = {
    let path = recordsDir <> test <> ".txt";
    match Fs.read(Path(path), Repository.fileMs) {
        Right(bytes) ->
            match recordOf(Repository.text("documents", path, bytes)) {
                Some(record) -> judged(record, source, modifiedOf)
              | None -> Unread(why = "record unread, not one the tests write: run it again")
            }
      | Left(Io.NotFound) ->
            Unread(why = "no record: run it first")
      | Left(error) ->
            Repository.quit("documents", "cannot read " <> path <> ": " <> Io.show(error))
    }
}

// A record read where neither its test's source nor a document it covers
// has changed since its run's host started, a file's time being read to
// the second, and read as naming nothing otherwise.
fn judged(record : Record, source : String, modified : (String) -> Optional(Int)) : Reading = {
    let since = record.started - record.started % 1000;
    let stale = List.filterMap(source :: record.covers, fn(path) = match modified(path) {
        Some(ms) when ms < since -> None
      | Some(_) -> Some("record older than " <> path <> ": run it again")
      | None -> Some("record of " <> path <> ", which is gone: run it again")
    });
    match stale {
        why :: _ -> Unread(=why)
      | [] -> Read(places = record.places)
    }
}

// The moment a file last changed, or none where it is gone.
fn modifiedOf(path : String) : Optional(Int) =
    match Fs.stat(Path(path), Repository.fileMs) {
        Right(entry) ->
            Some(entry.modified)
      | Left(Io.NotFound) ->
            None
      | Left(error) ->
            Repository.quit("documents", "cannot read " <> path <> ": " <> Io.show(error))
    }

// A record's text read, as the tests write it: its first line the run's,
// `run 4102544 1795668628479`, the host's number and the moment it started,
// and after it a line a fact, `covers guide/language.md` or `checked
// guide/language.md:12`.
fn recordOf(text : String) : Optional(Record) =
    match String.lines(text) {
        first :: facts -> {
            let started <- match String.split(first, " ") {
                ["run", _, moment] -> String.toInt(moment)
              | _ -> None
            };
            let begun = Some(Record(=started, covers = [], places = Set.empty));
            List.foldLeft(facts, begun, fn(read, fact) = {
                let record <- read;
                match String.splitOnce(fact, " ") {
                    Some(#("covers", path)) ->
                        Some(Record(..record, covers = path :: record.covers))
                  | Some(#("checked", place)) ->
                        Some(Record(..record, places = Set.put(record.places, place)))
                  | _ ->
                        None
                }
            })
        }
      | [] ->
            None
    }

//
// The edits
//
// A commit touches a section where its diff adds a line that stands in the
// section now, or takes lines out from between two of its lines. Each line
// of an earlier version is given to the line it became at HEAD, a line taken
// out to the section it stood inside, or to none where it stood between two,
// so that each change counts for one section. One `git log --follow -p -U0`
// a document gives its history, walked newest first, where `git log -L`
// walks it once a section: the two agree but where a hunk crosses a
// section's edge, whose lines `-L` takes into the ranges on both sides. The
// history goes back past a rename, and not past the commit that copied the
// document from another, which touches every section it holds.
//

// A hunk of a diff with no context: the old lines' first and count, and the
// new lines'.
type Hunk = Hunk(oldStart : Int, oldCount : Int, newStart : Int, newCount : Int)

// A commit's diff of the document: its hunks, and whether it copied the
// document from another.
type Diff = Diff(hunks : List(Hunk), copied : Bool)

// Where the walk of a commit's hunks stands: the later version's lines not
// yet passed, each by its line at HEAD, 0 for one in no section; how many
// have been passed; the last of them; the earlier version's lines so far,
// last first; and the sections touched.
type Walk =
    Walk(rest : List(Int), passed : Int, last : Int, earlier : List(Int), touched : List(Int))

let commitLine : Bytes = String.toUtf8("commit ")

let hunkLine : Bytes = String.toUtf8("@@ -")

let copyLine : Bytes = String.toUtf8("copy from ")

fn edits() : List(String) = {
    let files = reportFiles <> guideFiles() <> [tourFile];
    let counted = List.map(files, editsOf);
    let rows = List.flatMap(counted, fn(#(_, rows)) = rows);
    let commits = List.foldLeft(counted, 0, fn(acc, #(count, _)) = acc + count);
    let sorted = List.sortBy(rows, fn(#(count, _)) = -count);
    [column("commits", 7) <> "  section"]
        <> List.map(sorted, fn(#(count, row)) = column(Int.toString(count), 7) <> "  " <> row)
        <> ["",
            Int.toString(List.size(rows))
                <> " sections in "
                <> Int.toString(List.size(files))
                <> " documents, by "
                <> Int.toString(commits)
                <> " commits of their histories."]
}

// A document's commits, and each of its sections at HEAD by the commits
// that touched it.
fn editsOf(path : String) : #(Int, List(#(Int, String))) = {
    let shown = ["show", "HEAD:" <> path];
    let lines =
        linesOf(Repository.text("documents", "git show", Repository.gitBytes("documents", shown)));
    let sections = sectionsOf(lines);
    let table =
        Map.fromList(List.flatMap(List.indexed(sections),
                                  fn(#(index, section)) =
                                      List.map(section.heading :: section.lines,
                                               fn(line) = #(line.number, index))));
    let sectionAt = fn(line) = Optional.withDefault(Map.get(table, line), -1);
    let history =
        diffsOf(Repository.gitBytes("documents",
                                    ["log",
                                     "--follow",
                                     "--format=commit %H",
                                     "-p",
                                     "-U0",
                                     "--no-color",
                                     "--no-ext-diff",
                                     "--",
                                     path]));
    let #(_, counts) =
        List.foldLeft(history,
                      #(List.range(1, List.size(lines)), Map.empty),
                      fn(#(later, counts), diff) = {
                          let #(earlier, touched) = if diff.copied then
                              #([], List.filter(List.map(later, sectionAt), fn(index) = index >= 0))
                          else
                              before(later, diff.hunks, sectionAt);
                          #(earlier,
                            List.foldLeft(List.unique(touched),
                                          counts,
                                          fn(acc, index) =
                                              Map.update(acc,
                                                         index,
                                                         fn(found) =
                                                             Optional.withDefault(found, 0) + 1)))
                      });
    #(List.size(history),
      List.map(List.indexed(sections),
               fn(#(index, section)) =
                   #(Optional.withDefault(Map.get(counts, index), 0),
                     placeOf(path, section) <> "  " <> headingOf(section))))
}

// Each commit's diff, newest first, from `git log -p -U0`'s lines, up to
// the one that copied the document: a commit's own line, a copy's line and
// a hunk's header; a line of a diff's begins with `+`, `-` or `\`, and is
// passed by.
fn diffsOf(bytes : Bytes) : List(Diff) = {
    let found = List.foldLeft(Bytes.split(bytes, <<10>>), [], fn(acc, line) = match acc {
        _ when Bytes.startsWith(line, commitLine) ->
            Diff(hunks = [], copied = false) :: acc
      | diff :: rest when Bytes.startsWith(line, copyLine) ->
            Diff(..diff, copied = true) :: rest
      | diff :: rest when Bytes.startsWith(line, hunkLine) ->
            match hunkOf(Repository.text("documents", "git log", line)) {
                Some(hunk) -> Diff(..diff, hunks = hunk :: diff.hunks) :: rest
              | None -> acc
            }
      | _ ->
            acc
    });
    let diffs =
        List.reverse(List.map(found, fn(diff) = Diff(..diff, hunks = List.reverse(diff.hunks))));
    let #(later, copying) = List.splitWhile(diffs, fn(diff) = !diff.copied);
    later <> List.take(copying, 1)
}

// A hunk's header, `@@ -12,3 +12,0 @@`, a count left out being 1.
fn hunkOf(line : String) : Optional(Hunk) =
    match String.split(line, " ") {
        "@@" :: old :: new :: _ -> {
            let #(oldStart, oldCount) <- rangeOf(old, "-");
            let #(newStart, newCount) <- rangeOf(new, "+");
            Some(Hunk(=oldStart, =oldCount, =newStart, =newCount))
        }
      | _ ->
            None
    }

fn rangeOf(field : String, sign : String) : Optional(#(Int, Int)) = {
    let range <- String.stripPrefix(field, sign);
    match String.split(range, ",") {
        [start] ->
            Optional.map(String.toInt(start), fn(first) = #(first, 1))
      | [start, count] -> {
            let first <- String.toInt(start);
            let size <- String.toInt(count);
            Some(#(first, size))
        }
      | _ ->
            None
    }
}

// The lines of the version before a commit, each by its line at HEAD, from
// those of the version after it, and the sections the commit touched.
fn before(later : List(Int),
          hunks : List(Hunk),
          sectionAt : (Int) -> Int) : #(List(Int), List(Int)) = {
    let begun = Walk(rest = later, passed = 0, last = 0, earlier = [], touched = []);
    let walked = List.foldLeft(hunks, begun, fn(walk, hunk) = hunkWalked(walk, hunk, sectionAt));
    #(List.reverse(walked.earlier) <> walked.rest, walked.touched)
}

// The walk past a hunk: the lines before it kept, its new lines touched,
// and its old lines each given to its first new line where it adds some,
// and where it only takes some out, to the line before them where that
// and the line after stand in one section, and to none otherwise.
fn hunkWalked(walk : Walk, hunk : Hunk, sectionAt : (Int) -> Int) : Walk = {
    let kept = (if hunk.newCount > 0 then hunk.newStart - 1 else hunk.newStart) - walk.passed;
    let passing = List.take(walk.rest, kept);
    let last = Optional.withDefault(List.last(passing), walk.last);
    let added = List.take(List.drop(walk.rest, kept), hunk.newCount);
    let rest = List.drop(walk.rest, kept + hunk.newCount);
    let next = Optional.withDefault(List.get(rest, 0), 0);
    let removedAt = if hunk.newCount > 0 then
        Optional.withDefault(List.get(added, 0), 0)
    else if last != 0 && next != 0 && sectionAt(last) == sectionAt(next) then
        last
    else
        0;
    let touchedLines =
        List.filter(if hunk.newCount == 0 then [removedAt] else added, fn(line) = line != 0);
    Walk(=rest,
         passed = walk.passed + kept + hunk.newCount,
         last = Optional.withDefault(List.last(added), last),
         earlier = List.repeat(removedAt, hunk.oldCount) <> List.reverse(passing) <> walk.earlier,
         touched = List.filter(List.map(touchedLines, sectionAt), fn(index) = index >= 0)
             <> walk.touched)
}

//
// Tests
//

/// A heading inside a fenced block is none, and a section's words leave
/// its fences' own lines out; a heading of the first or second level counts
/// the sections under it too.
let countsSectionWords = Test.Case(name = "counts a section's words", run = fn() = {
    let text = "# T\nintro words here\n## 1. A\none two\n```\n# inside\n```\n### 1.1 B\nthree\n";
    let sections = List.map(sectionsOf(linesOf(text)), fn(section) = #(section, words(section)));
    Test.equal(lengthRows("f.md", sections),
               ["      3      8  f.md:1  # T",
                "      4      5  f.md:3  ## 1. A",
                "      1         f.md:8  ### 1.1 B"])
})

/// A report section's heading gives its citation's key, and a heading that
/// numbers nothing gives none.
let keysSections =
    Test.Case(name = "keys a report section by its number",
              run = fn() =
                  Test.equal(List.map(["3.9 Type schemes",
                                       "3. Types",
                                       "Appendix E. Standard Library",
                                       "Appendix E.17. `fs.ern`",
                                       "Ernest Report"],
                                      numberOf),
                             [Some("3.9"), Some("3"), Some("Appendix E"), Some("E.17"), None]))

/// A `§` is the report's after the report's name, the guide's after the
/// guide's, each of a list after a name that name's, and bare the report's
/// but in the language guide; an appendix and `E.n` are the report's.
let readsCitations = Test.Case(name = "reads a line's citations of the report", run = fn() = {
    let line =
        "see report §3.9, §4.2 and §5.1, the guide's §2.1, deployment guide §1.1, §1.2, "
            <> "a bare §6.4, Appendix E, Appendix E.17 and E.12.";
    Test.equal(#(citedOn("guide/why.md", line), citedOn("guide/language.md", line)),
               #(["3.9", "4.2", "5.1", "6.4", "Appendix E", "E.17", "E.12"],
                 ["3.9", "4.2", "5.1", "Appendix E", "E.17", "E.12"]))
})

/// A prose term is counted outside code, in any case and with its plural; a
/// code term in code spans and fenced blocks alone.
let countsTerms = Test.Case(name = "counts a term in prose and in code", run = fn() = {
    let glossary = [termOf("adapted address"), termOf("`as`")];
    let lines =
        linesOf("An Adapted address, two adapted addresses.\n`p as x` as prose\n"
                    <> "```\nlet y = p as q\n```\n");
    let counted = countedIn(glossary, lines);
    Test.equal(List.map(glossary, fn(term) = countOf(counted, term)), [2, 2])
})

/// A block a record read names is checked by its test and counted under
/// it; a record older than a document it covers is read as naming none, by
/// its test's name.
let readsRecords = Test.Case(name = "reads the tests' records", run = fn() = {
    let blocks = blocksOf("g.md", linesOf("```ernest\nx\n```\n```console\n$ ern shell\n```\n"));
    let reading = fn(changed) = match recordOf("run 7 5000\nchecked g.md:1\ncovers g.md\n") {
        Some(record) ->
            judged(record, "t.erl", fn(path) = Some(if path == "g.md" then changed else 0))
      | None ->
            Unread(why = "unread")
    };
    Test.equal(uncheckedRows(blocks,
                             [#("fresh_tests", reading(4999)), #("stale_tests", reading(5000))]),
               ["console         g.md:4                     $ ern shell",
                "",
                "console            1 of 1 unchecked",
                "ernest             0 of 1 unchecked",
                "",
                "fresh_tests              1 checked",
                "stale_tests           record older than g.md: run it again",
                "",
                "1 of 2 blocks no test checks."])
})

/// A hunk's header is read with a count left out as 1.
let readsHunks =
    Test.Case(name = "reads a hunk's header",
              run = fn() =
                  Test.equal(#(hunkOf("@@ -12,3 +12,0 @@ fn"), hunkOf("@@ -4 +5 @@")),
                             #(Some(Hunk(oldStart = 12, oldCount = 3, newStart = 12, newCount = 0)),
                               Some(Hunk(oldStart = 4, oldCount = 1, newStart = 5, newCount = 1)))))

/// A line taken out between two lines of one section is that section's, and
/// one between two sections is none's.
let mapsRemovals = Test.Case(name = "maps the lines a commit took out", run = fn() = {
    let hunks =
        [Hunk(oldStart = 2, oldCount = 1, newStart = 1, newCount = 0),
         Hunk(oldStart = 5, oldCount = 1, newStart = 3, newCount = 0)];
    Test.equal(before(List.range(1, 6), hunks, fn(line) = if line <= 3 then 0 else 1),
               #([1, 1, 2, 3, 0, 4, 5, 6], [0]))
})

/// Lines replaced are their first new line's, and lines added touch their
/// sections.
let mapsReplacements = Test.Case(name = "maps the lines a commit replaced", run = fn() = {
    let hunks =
        [Hunk(oldStart = 1, oldCount = 2, newStart = 1, newCount = 1),
         Hunk(oldStart = 5, oldCount = 0, newStart = 5, newCount = 1)];
    Test.equal(before(List.range(1, 7), hunks, fn(line) = if line <= 3 then 0 else 1),
               #([1, 1, 2, 3, 4, 6, 7], [1, 0]))
})

/// A document's history ends with the commit that copied it.
let endsAtTheCopy = Test.Case(name = "ends a history at its copy", run = fn() = {
    let log =
        "commit a\n@@ -1 +1 @@\n-x\n+y\ncommit b\ncopy from README.md\n"
            <> "@@ -3,0 +4,2 @@\ncommit c\n@@ -1 +1 @@\n";
    Test.equal(diffsOf(String.toUtf8(log)),
               [Diff(hunks = [Hunk(oldStart = 1, oldCount = 1, newStart = 1, newCount = 1)],
                     copied = false),
                Diff(hunks = [Hunk(oldStart = 3, oldCount = 0, newStart = 4, newCount = 2)],
                     copied = true)])
})
