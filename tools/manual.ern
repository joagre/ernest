//
// ern(1), the toolchain's manual page (report §11): §11 of the report,
// rendered by libs/markdown as `ern doc --man` renders a module's page
// (report §11.4). Its SYNOPSIS is each job's usage line, its DESCRIPTION
// §11 with §11.1 to §11.6 and every section after §11.8, its OPTIONS and
// EXIT STATUS §11.7 and §11.8, and its SEE ALSO names the manual pages in
// a directory, the ones `ern doc --man` wrote for the standard library.
// `make manual` runs it with the report, the version, and that directory,
// and it writes the page to standard output.
//

export fn main() : Unit =
    match Os.arguments {
        [report, version, pages] ->
            match manual(report, version, pages) {
                Right(lines) -> Io.print(String.join(lines, "\n") <> "\n")
              | Left(message) -> quit(message)
            }
      | _ ->
            quit("usage: manual report.md version pages-dir")
    }

// The page's lines, or why there are none.
fn manual(report : String, version : String, pages : String) : Either(String, List(String)) = {
    let bytes <-
        Either.mapLeft(Fs.read(Path(report), 10000),
                       fn(error) = "cannot read " <> report <> ": " <> Io.show(error));
    let text <- Either.fromOptional(String.fromUtf8(bytes), report <> " is not UTF-8");
    let entries <-
        Either.mapLeft(Fs.list(Path(pages), 10000),
                       fn(error) = "cannot list " <> pages <> ": " <> Io.show(error));
    let section <-
        Either.fromOptional(toolchain(Markdown.parse(text)),
                            "no section 11. Toolchain in " <> report);
    let #(description, rest) = List.span(section, fn(block) = !titled(block, "11.7 Options"));
    let #(options, rest) = List.span(rest, fn(block) = !titled(block, "11.8 Exit status"));
    let #(exitStatus, later) = subsection(rest);
    let _ <- if List.isEmpty(options) || List.isEmpty(exitStatus) then
        Left("no sections 11.7 Options and 11.8 Exit status in " <> report)
    else
        Right(Unit);
    let synopsis = usages(section);
    let _ <- if List.isEmpty(synopsis) then
        Left("no jobs named in the first paragraph of 11. Toolchain in " <> report)
    else
        Right(Unit);
    let files = List.filterMap(entries, fn(entry) = Path.name(entry.path));
    let blocks =
        [heading("SYNOPSIS")]
            <> List.map(synopsis, usage)
            <> [heading("DESCRIPTION")]
            <> List.map(description <> later, raised)
            <> [heading("OPTIONS")]
            <> List.drop(options, 1)
            <> [heading("EXIT STATUS")]
            <> List.drop(exitStatus, 1)
            <> seeAlso(files);
    Right((".\\\" Generated by tools/manual.ern from " <> report <> ".")
              :: Markdown.roff(blocks, page(version)))
}

fn page(version : String) : Markdown.Manual =
    Markdown.Manual(name = "ern",
                    section = "1",
                    summary = [Markdown.Text("the Ernest toolchain")],
                    source = "Ernest " <> version,
                    title = "Ernest Manual")

// The blocks of §11 after its heading, up to the next chapter's.
fn toolchain(blocks : List(Markdown.Block)) : Optional(List(Markdown.Block)) = {
    let chapter = Markdown.Heading(level = 2, text = [Markdown.Text("11. Toolchain")]);
    match List.span(blocks, fn(block) = block != chapter) {
        #(_, _ :: rest) -> {
            let #(section, _) = List.span(rest, fn(block) = !beginsChapter(block));
            Some(section)
        }
      | _ ->
            None
    }
}

// The subsection the blocks begin with, up to the next subsection's
// heading, and the blocks from that heading on.
fn subsection(blocks : List(Markdown.Block)) : #(List(Markdown.Block), List(Markdown.Block)) =
    match blocks {
        first :: rest -> {
            let #(body, later) = List.span(rest, fn(block) = !beginsSubsection(block));
            #(first :: body, later)
        }
      | [] ->
            #([], [])
    }

// Whether a block is the subsection heading of that title.
fn titled(block : Markdown.Block, title : String) : Bool =
    block == Markdown.Heading(level = 3, text = [Markdown.Text(title)])

fn heading(title : String) : Markdown.Block =
    Markdown.Heading(level = 1, text = [Markdown.Text(title)])

// Each job's usage line, then `ern --help`'s and `ern --version`'s, in
// the order §11's first paragraph names them, `ern` and one word each:
// the longest code span of §11 that is the job's or begins with it and a
// space. A usage names every option its job takes, and a use's example
// only some, so the usage is the longest; a test holds it to the job's
// `--help`.
fn usages(blocks : List(Markdown.Block)) : List(String) = {
    let spans = List.flatMap(blocks, codeSpans);
    let jobs = match blocks {
        first :: _ -> List.filter(codeSpans(first), isCommand)
      | [] -> []
    };
    List.filterMap(jobs, fn(job) = List.maximumBy(commandLines(spans, job), String.size))
}

// The spans that are a job's command lines: the job alone, or the job and
// what follows a space.
fn commandLines(spans : List(String), job : String) : List(String) =
    List.filter(spans, fn(span) = span == job || String.startsWith(span, job <> " "))

fn codeSpans(block : Markdown.Block) : List(String) =
    match block {
        Markdown.Paragraph(inlines) ->
            List.filterMap(inlines, fn(inline) = match inline {
                Markdown.CodeSpan(code) -> Some(code)
              | _ -> None
            })
      | _ ->
            []
    }

// Whether a span is `ern` and one word, a job or an option.
fn isCommand(span : String) : Bool =
    match String.words(span) {
        ["ern", _] -> true
      | _ -> false
    }

fn usage(line : String) : Markdown.Block =
    Markdown.Paragraph([Markdown.CodeSpan(line)])

fn beginsChapter(block : Markdown.Block) : Bool =
    match block {
        Markdown.Heading(=level) -> level <= 2
      | _ -> false
    }

fn beginsSubsection(block : Markdown.Block) : Bool =
    match block {
        Markdown.Heading(=level) -> level <= 3
      | _ -> false
    }

// §11's sections are the page's subsections, a level above their own.
fn raised(block : Markdown.Block) : Markdown.Block =
    match block {
        Markdown.Heading(=level, =text) -> Markdown.Heading(level = level - 1, =text)
      | other -> other
    }

// The pages the directory holds, the prelude's first, then the pages
// `apropos` finds and the report the page's section numbers cite.
fn seeAlso(files : List(String)) : List(Markdown.Block) = {
    let names =
        List.filterMap(files,
                       fn(file) =
                           if Path.extension(Path(file)) == Some("3ern") then
                               Path.name(Path.withoutExtension(Path(file)))
                           else
                               None);
    let #(prelude, modules) = List.partition(List.sort(names), fn(name) = name == "Ernest.Prelude");
    let rest =
        [Markdown.Text("; every Ernest page installed, which "),
         Markdown.CodeSpan("apropos Ernest."),
         Markdown.Text(" lists; and the Ernest report, installed with Ernest in "),
         Markdown.CodeSpan("share/doc/ernest/report"),
         Markdown.Text(", whose "),
         Markdown.CodeSpan("toolchain.md"),
         Markdown.Text(" holds the sections this page cites.")];
    [Markdown.Heading(level = 1, text = [Markdown.Text("SEE ALSO")]),
     Markdown.Paragraph(references(prelude <> modules) <> rest)]
}

// The pages by name, a comma between two, as man(7) writes a reference.
fn references(names : List(String)) : List(Markdown.Inline) =
    match names {
        [] -> []
      | [name] -> reference(name)
      | name :: rest -> reference(name) <> [Markdown.Text(", ")] <> references(rest)
    }

fn reference(name : String) : List(Markdown.Inline) =
    [Markdown.Strong([Markdown.Text(name)]), Markdown.Text("(3ern)")]

fn quit(message : String) : Unit = {
    Io.printlnError("manual: " <> message);
    Os.exit(1)
}
