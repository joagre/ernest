//
// ern(1), the toolchain's manual page (report §11): §11 of the report,
// rendered by libs/markdown as `ern doc --man` renders a module's page
// (report §11.4), its SEE ALSO naming the manual pages in a directory, the
// ones `ern doc --man` wrote for the standard library. `make man` runs it
// with the report, the version, and that directory, and it writes the page
// to standard output.
//

export fn main() : Unit with Never =
    match Os.arguments {
        [report, version, pages] -> match manual(report, version, pages) {
            Right(lines) -> Io.print(String.join(lines, "\n") <> "\n")
          | Left(message) -> quit(message)
        }
      | _ -> quit("usage: manual report.md version pages-dir")
    }

// The page's lines, or why there are none.
fn manual(report : String,
          version : String,
          pages : String) : Either(String, List(String)) with m = {
    let bytes <-
        Either.mapLeft(Fs.read(Path(report), 10000),
                       fn(e) = "cannot read " <> report <> ": " <> Io.show(e));
    let text <- Either.fromOptional(String.fromUtf8(bytes), report <> " is not UTF-8");
    let entries <-
        Either.mapLeft(Fs.list(Path(pages), 10000),
                       fn(e) = "cannot list " <> pages <> ": " <> Io.show(e));
    let section <-
        Either.fromOptional(toolchain(Markdown.parse(text)),
                            "no section 11. Toolchain in " <> report);
    let names = List.map(entries, fn(e) = Path.name(e.path));
    Right((".\\\" Generated by tools/manual.ern from " <> report <> ".")
              :: Markdown.roff(page(version), List.map(section, raised) <> seeAlso(names)))
}

fn page(version : String) : Markdown.Manual =
    Markdown.Manual(name = "ern",
                    section = "1",
                    summary = [Markdown.Text("the Ernest toolchain")],
                    source = "Ernest " <> version,
                    title = "Ernest Manual")

// The blocks of §11 after its heading, up to the next chapter's.
fn toolchain(blocks : List(Markdown.Block)) : Optional(List(Markdown.Block)) =
    match List.span(blocks,
                    fn(b) =
                        b != Markdown.Heading(level = 2, text = [Markdown.Text("11. Toolchain")])) {
        #(_, _ :: rest) -> {
            let #(section, _) = List.span(rest, fn(b) = !beginsChapter(b));
            Some(section)
        }
      | _ -> None
    }

fn beginsChapter(b : Markdown.Block) : Bool =
    match b {
        Markdown.Heading(level = level) -> level <= 2
      | _ -> false
    }

// §11's sections are the page's subsections, a level above their own.
fn raised(b : Markdown.Block) : Markdown.Block =
    match b {
        Markdown.Heading(level = level, text = text) ->
            Markdown.Heading(level = level - 1, text = text)
      | other -> other
    }

// The pages the directory holds, the prelude's first, then the pages
// `apropos` finds and the report the page's section numbers cite.
fn seeAlso(files : List(String)) : List(Markdown.Block) = {
    let names =
        List.filterMap(files,
                       fn(f) = if String.endsWith(f, ".3ern") then
                           Some(String.slice(f, 0, String.size(f) - 5))
                       else
                           None);
    let #(prelude, modules) =
        List.partition(List.sort(names, String.compare), fn(n) = n == "Ernest.Prelude");
    let pages = List.map(prelude <> modules, fn(n) = "**" <> n <> "**(3ern)");
    let rest =
        "; every Ernest page installed, which `apropos Ernest.` lists; "
            <> "and the Ernest language report, `ernest_report.md`, installed with Ernest "
            <> "in `share/doc/ernest`, whose sections this page cites.";
    Markdown.parse("# SEE ALSO\n\n" <> String.join(pages, ", ") <> rest)
}

fn quit(message : String) : Unit with m = {
    Io.printlnError("manual: " <> message);
    Os.exit(1)
}
