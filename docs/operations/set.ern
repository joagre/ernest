/// Operations on `Set(a=)`, a finite set of elements (report §9.2). The
/// element type needs equality, which the type itself requires (report
/// §3.10). A set has no `get`: membership is `contains`. The order of
/// `toList`, `foldLeft`, `foreach`, and `find` is unspecified, and so is
/// the order in which `map`, `filter`, `filterMap`, `any`, and `all` meet
/// the elements. The primitives are `empty`, `size`, `contains`, `put`,
/// `remove`, and `toList`, the runtime's; the rest is written over them
/// (report Appendix E.0 rule 1). Code written once over several
/// representations of a set takes `Operations(s, a)`, the record of a
/// representation's operations, and `operations` is this set's.
///
/// ## Examples
///
/// ```ernest
/// Set.contains(Set.put(Set.empty, "a"), "a")
/// // => true
/// ```
///
/// ```ernest
/// List.sort(Set.toList(Set.difference(Set.fromList([1, 2, 3]), Set.fromList([2]))), Int.compare)
/// // => [1, 3]
/// ```
///
/// ## See also
///
/// `Map` for elements with values, `List.unique` for order kept,
/// `OrderedSet` for elements in order.
///
/// since 0.1.0

/// The operations of one representation of a set, `s`, over elements `a`,
/// each field the function of its name. Code written once over several
/// representations takes a value of this type and calls its fields; the
/// caller passes the representation's record, `Set.operations` or
/// `OrderedSet.operations(compare)`.
///
/// since 0.3.0
export type Operations(s, a) =
    Operations(empty : s,
               size : (s) -> Int,
               isEmpty : (s) -> Bool,
               contains : (s, a) -> Bool,
               put : (s, a) -> s,
               remove : (s, a) -> s,
               fromList : (List(a)) -> s,
               toList : (s) -> List(a),
               union : (s, s) -> s,
               intersection : (s, s) -> s,
               difference : (s, s) -> s,
               isSubset : (s, s) -> Bool)

/// This set's operations, for code written once over several
/// representations.
///
/// ### Examples
///
/// ```ernest
/// Set.operations.contains(Set.operations.fromList([1, 2]), 2)
/// // => true
/// ```
///
/// since 0.3.0
export let operations : Operations(Set(a), a) =
    Operations(empty = empty,
               size = size,
               isEmpty = isEmpty,
               contains = contains,
               put = put,
               remove = remove,
               fromList = fromList,
               toList = toList,
               union = union,
               intersection = intersection,
               difference = difference,
               isSubset = isSubset)

/// The set with no elements.
export let empty : Set(a) = emptySet()

foreign fn emptySet() : Set(a) =
    "ern_set:empty/0"

/// The number of elements.
///
/// ### Examples
///
/// ```ernest
/// #(Set.size(Set.fromList([1, 1, 2])), Set.isEmpty(Set.empty))
/// // => #(2, true)
/// ```
export foreign fn size(set : Set(a)) : Int =
    "ern_set:size/1"

/// `true` for the set with no elements.
export fn isEmpty(set : Set(a)) : Bool =
    size(set) == 0

/// `true` when the element is in the set.
export foreign fn contains(set : Set(a), x : a) : Bool =
    "ern_set:contains/2"

/// The set with that element, which may already be there.
export foreign fn put(set : Set(a), x : a) : Set(a) =
    "ern_set:put/2"

/// The set without that element, which need not be there.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.remove(Set.fromList([1, 2]), 2))
/// // => [1]
/// ```
export foreign fn remove(set : Set(a), x : a) : Set(a) =
    "ern_set:remove/2"

/// The function applied to each element; two elements it maps together
/// become one, so the result may be smaller.
///
/// ### Examples
///
/// ```ernest
/// List.sort(Set.toList(Set.map(Set.fromList([1, 2]), fn(n) = n * 10)), Int.compare)
/// // => [10, 20]
/// ```
export fn map(set : Set(a), f : (a) -> b with e) : Set(b) with e =
    fromList(List.map(toList(set), f))

/// The elements the predicate holds for.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.filter(Set.fromList([1, 2, 3]), fn(n) = n > 2))
/// // => [3]
/// ```
export fn filter(set : Set(a), keep : (a) -> Bool with e) : Set(a) with e =
    List.foldLeft(toList(set), set, fn(acc, x) = if keep(x) then acc else remove(acc, x))

/// The values of the `Some` results.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.filterMap(Set.fromList(["1", "x"]), String.toInt))
/// // => [1]
/// ```
export fn filterMap(set : Set(a), f : (a) -> Optional(b) with e) : Set(b) with e =
    fromList(List.filterMap(toList(set), f))

/// The accumulator after the function has seen each element, the
/// accumulator first.
///
/// ### Examples
///
/// ```ernest
/// Set.foldLeft(Set.fromList([1, 2]), 0, Int.+)
/// // => 3
/// ```
export fn foldLeft(set : Set(a), acc : b, step : (b, a) -> b with e) : b with e =
    List.foldLeft(toList(set), acc, step)

/// The function applied to each element for its effect.
///
/// ### Examples
///
/// ```ernest
/// Set.foreach(Set.fromList(["a"]), Io.println)
/// // => Unit
/// ```
export fn foreach(set : Set(a), f : (a) -> Unit with e) : Unit with e =
    List.foreach(toList(set), f)

/// `true` when the predicate holds for some element.
///
/// ### Examples
///
/// ```ernest
/// #(Set.any(Set.fromList([1]), fn(n) = n > 0), Set.all(Set.fromList([1]), fn(n) = n > 1))
/// // => #(true, false)
/// ```
export fn any(set : Set(a), keep : (a) -> Bool with e) : Bool with e =
    List.any(toList(set), keep)

/// `true` when the predicate holds for every element, and for the set with
/// no elements.
export fn all(set : Set(a), keep : (a) -> Bool with e) : Bool with e =
    List.all(toList(set), keep)

/// Some element the predicate holds for.
///
/// ### Examples
///
/// ```ernest
/// Set.find(Set.fromList([1, 2]), fn(n) = n > 1)
/// // => Some(2)
/// ```
export fn find(set : Set(a), keep : (a) -> Bool with e) : Optional(a) with e =
    List.find(toList(set), keep)

/// The set of those elements, each once.
export fn fromList(list : List(a)) : Set(a) =
    List.foldLeft(list, empty, put)

/// The elements, in unspecified order.
export foreign fn toList(set : Set(a)) : List(a) =
    "ern_set:to_list/1"

/// The elements of both.
///
/// ### Examples
///
/// ```ernest
/// List.sort(Set.toList(Set.union(Set.fromList([1]), Set.fromList([2]))), Int.compare)
/// // => [1, 2]
/// ```
export fn union(set : Set(a), other : Set(a)) : Set(a) =
    List.foldLeft(toList(other), set, put)

/// The elements in both.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.intersection(Set.fromList([1, 2]), Set.fromList([2, 3])))
/// // => [2]
/// ```
export fn intersection(set : Set(a), other : Set(a)) : Set(a) =
    filter(set, fn(x) = contains(other, x))

/// The elements of the first that are not in the second.
export fn difference(set : Set(a), other : Set(a)) : Set(a) =
    filter(set, fn(x) = !contains(other, x))

/// `true` when every element of the first is in the second.
///
/// ### Examples
///
/// ```ernest
/// Set.isSubset(Set.fromList([1]), Set.fromList([1, 2]))
/// // => true
/// ```
export fn isSubset(set : Set(a), other : Set(a)) : Bool =
    List.all(toList(set), fn(x) = contains(other, x))
