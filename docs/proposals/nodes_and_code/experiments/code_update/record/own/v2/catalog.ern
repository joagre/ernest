/// Version 2, in place: the catalog's own item gains its stock. Only the
/// catalog's protocol changes.
export type Item = Item(name : String, price : Int, stock : Int)

export type Msg = Add(Item) | Find(name : String, reply : Reply(Optional(Item)))

export let catalog : Service.Handle(Msg, Map(String, Item)) = Service.start(fn() = Map.empty, step)

export fn step(items : Map(String, Item),
               message : Msg) : Map(String, Item) with Service.Envelope(Msg, Map(String, Item)) =
    match message {
        Add(item) -> Map.put(items, item.name, item)
      | Find(name = name, reply = reply) -> {
            answer(reply, Map.get(items, name));
            items
        }
    }
