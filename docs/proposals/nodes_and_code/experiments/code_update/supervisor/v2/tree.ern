/// Version 2: the counter logs each `Inc` (row C1), and the tree gains a
/// third child, a clock, with the limit raised to five restarts (row C6). A child joins a running group at any time, so the clock can be
/// added under the old group from the shell; the limit lives in the
/// supervisor's own loop, behind an abstract `Msg`, so it changes only with
/// a new group, whose children begin afresh.
export type CountMsg = Inc | Count(reply : Reply(Int)) | Crash

export type EchoMsg = Echo(text : String, reply : Reply(String))

export let group : Address(Supervisor.Msg) =
    spawn(Supervisor.group(Supervisor.OneForOne, RestartLimit(restarts = 5, within = 5000)))

export let counter : Address(CountMsg) = spawn(Supervisor.child(group, fn() = counting(0)))

export let echo : Address(EchoMsg) = spawn(Supervisor.child(group, echoing))

export type ClockMsg = Now(reply : Reply(Int))

export let clock : Address(ClockMsg) = spawn(Supervisor.child(group, ticking))

/// The clock's loop, for the shell to spawn under the old group too.
export fn ticking() : Unit with ClockMsg =
    receive {
        Now(reply = reply) -> {
            answer(reply, Clock.now());
            ticking()
        }
    }

/// A service under the group: the library's loop as the child's function,
/// so that its step can be upgraded in place.
export type TallyMsg = Tally | Tallied(reply : Reply(Int)) | Break

export let tally : Service.Handle(TallyMsg, Int) = {
    let loop = spawn(Supervisor.child(group, fn() = Service.run(tallyStep, 0)));
    Service.Handle(loop = loop, clients = via(loop, Service.Message))
}

export fn tallyStep(count : Int, message : TallyMsg) : Int with Service.Envelope(TallyMsg, Int) =
    match message {
        Tally -> {
            Io.println("tally, version 2");
            count + 1
        }
      | Tallied(reply = reply) -> {
            answer(reply, count);
            count
        }
      | Break -> fault("the tally was broken")
    }

/// An upgrade in place that the child's restart follows: the new loop states
/// its own place under the group, so that a fault restarts it into this
/// step from the state at the switch (code.md, part two, 7.2).
export fn upgradeTally(group : Address(Supervisor.Msg),
                       handle : Service.Handle(TallyMsg, Int)) : Unit with n =
    match handle {
        Service.Handle(loop = loop) ->
            send(loop,
                 Service.Upgrade(next = fn(state) =
                                     Supervisor.child(group,
                                                      fn() = Service.run(tallyStep, state))()))
    }

export fn tallied(handle : Service.Handle(TallyMsg, Int)) : Int with n =
    Address.callForever(Service.address(handle), fn(reply) = Tallied(reply = reply))

fn counting(count : Int) : Unit with CountMsg =
    receive {
        Inc -> {
            Io.println("inc, version 2");
            counting(count + 1)
        }
      | Count(reply = reply) -> {
            answer(reply, count);
            counting(count)
        }
      | Crash -> fault("the counter was crashed")
    }

fn echoing() : Unit with EchoMsg =
    receive {
        Echo(text = text, reply = reply) -> {
            answer(reply, text);
            echoing()
        }
    }

export fn inc(address : Address(CountMsg)) : Unit with n =
    send(address, Inc)

export fn count(address : Address(CountMsg)) : Int with n =
    Address.callForever(address, fn(reply) = Count(reply = reply))
