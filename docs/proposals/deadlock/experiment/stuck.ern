//
// Program 3: two servers in a cycle of calls without a limit, beside main,
// which ticks five times, writing each one's status, and then waits for a
// message none can send.
//

type FirstMsg = Meet(Address(SecondMsg)) | AskFirst(Reply(Int))

type SecondMsg = AskSecond(Reply(Int))

type MainMsg = Ticked

export fn main() : Unit receiving MainMsg = {
    let first = spawn(fn() = meet());
    let second = spawn(fn() = secondLoop(first));
    send(first, Meet(second));
    let caller = spawn(fn() = Io.println(Int.toString(Address.callForever(first, AskFirst))));
    tick(5, [Process.fromAddress(first), Process.fromAddress(second), Process.fromAddress(caller)]);
    Io.println("the ticks are over, and main waits");
    receive {
        Ticked -> Io.println("unreachable")
    }
}

fn tick(count : Int, processes : List(Process)) : Unit receiving MainMsg =
    if count == 0 then
        Unit
    else {
        let _ = Clock.alarm(1000, fn(_) = Ticked);
        receive {
            Ticked -> {
                Io.println(String.join(List.map(processes, shown), ", "));
                tick(count - 1, processes)
            }
        }
    }

fn shown(process : Process) : String =
    match Process.status(process) {
        Some(status) -> status.site <> " " <> Io.show(status.activity)
      | None -> "ended"
    }

fn meet() : Unit receiving FirstMsg =
    receive {
        Meet(second) -> firstLoop(second)
    }

fn firstLoop(second : Address(SecondMsg)) : Unit receiving FirstMsg =
    receive {
        AskFirst(reply) -> {
            answer(reply, Address.callForever(second, AskSecond));
            firstLoop(second)
        }
    }

fn secondLoop(first : Address(FirstMsg)) : Unit receiving SecondMsg =
    receive {
        AskSecond(reply) -> {
            answer(reply, Address.callForever(first, AskFirst) + 1);
            secondLoop(first)
        }
    }
