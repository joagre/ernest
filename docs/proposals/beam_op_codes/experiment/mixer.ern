// The mixer: a loop carrying five values across four calls an iteration,
// timed eleven times at ten million iterations; every value a small
// non-negative integer, kept below 2^24 by `%`, with no bitwise operation.

fn lcg(x : Int) : Int =
    (x * 1103515245 + 12345) % 16777216

fn mix(x : Int, y : Int) : Int =
    (x + y * 8) % 16777216

fn rot(x : Int, i : Int) : Int = {
    let s = i % 8;
    (x * (s + 1) + (24 - s)) % 16777216
}

fn mix3(x : Int, y : Int, z : Int) : Int = {
    let m = mix(x, y);
    (mix(m, z) + z * 7) % 16777216
}

fn loop(i : Int, a : Int, b : Int, c : Int, acc : Int) : Int =
    if i == 0 then
        acc
    else {
        let a1 = lcg(a);
        let b1 = mix(b, a1);
        let c1 = rot(c, i);
        let d = mix3(a1, b1, c1);
        loop(i - 1, a1, b1, c1, (acc + d) % 16777216)
    }

fn timed(left : Int) : Unit =
    if left > 0 then {
        let start = Clock.monotonicMicros();
        let value = loop(10000000, 1, 2, 3, 0);
        let took = Clock.monotonicMicros() - start;
        Io.println(Int.toString(value) <> " " <> Int.toString(took / 1000));
        timed(left - 1)
    } else
        Unit

export fn main() : Unit =
    timed(11)
