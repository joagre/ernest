// Ackermann, timed eleven times at A(3, 11), each run's milliseconds.

fn ack(m : Int, n : Int) : Int =
    if m == 0 then n + 1 else if n == 0 then ack(m - 1, 1) else ack(m - 1, ack(m, n - 1))

fn timed(left : Int) : Unit =
    if left > 0 then {
        let start = Clock.monotonicMicros();
        let value = ack(3, 11);
        let took = Clock.monotonicMicros() - start;
        Io.println(Int.toString(value) <> " " <> Int.toString(took / 1000) <> " ms");
        timed(left - 1)
    } else
        Unit

export fn main() : Unit =
    timed(11)
