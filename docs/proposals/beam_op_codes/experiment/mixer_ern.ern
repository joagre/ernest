// The mixer: a loop carrying five values across four calls an iteration,
// timed eleven times at ten million iterations.

fn lcg(x : Int) : Int = Int.bitAnd(x * 1103515245 + 12345, 16777215)

fn mix(x : Int, y : Int) : Int = Int.bitAnd(Int.bitXor(x, Int.shiftLeft(y, 3)), 16777215)

fn rot(x : Int, i : Int) : Int = {
    let s = Int.bitAnd(i, 7);
    Int.bitAnd(Int.bitOr(Int.shiftLeft(x, s), Int.shiftRight(x, 24 - s)), 16777215)
}

fn mix3(x : Int, y : Int, z : Int) : Int = {
    let m = mix(x, y);
    Int.bitAnd(mix(m, z) + z * 7, 16777215)
}

fn loop(i : Int, a : Int, b : Int, c : Int, acc : Int) : Int =
    if i == 0 then
        acc
    else {
        let a1 = lcg(a);
        let b1 = mix(b, a1);
        let c1 = rot(c, i);
        let d = mix3(a1, b1, c1);
        loop(i - 1, a1, b1, c1, Int.bitAnd(acc + d, 16777215))
    }

fn timed(left : Int) : Unit =
    if left > 0 then {
        let start = Clock.monotonicMicros();
        let value = loop(10000000, 1, 2, 3, 0);
        let took = Clock.monotonicMicros() - start;
        Io.println(Int.toString(value) <> " " <> Int.toString(took / 1000));
        timed(left - 1)
    } else
        Unit

export fn main() : Unit = timed(11)
