// Report §8.7: the store's services, as the store offers them and the desk
// finds them, in one build.

export type Msg = Add(Int) | Get(reply : Reply(Int))

export let service : Peer.Service(Msg) = Peer.service("counter")

export let adder : Peer.Service(Int) = Peer.service("adder")

export let victim : Peer.Service(Int) = Peer.service("victim")

export let counterSlot : Peer.Service(Slot.Msg(Address(Msg))) = Peer.service("counter-slot")

export let echoSlot : Peer.Service(Slot.Msg(Address(Int))) = Peer.service("echo-slot")

export let fragile : Peer.Service(Int) = Peer.service("fragile")

export let strict : Peer.Service(Int) = Peer.service("strict")

// An echo on the store, which answers each address it is given with a 1,
// reached straight and through an adapted address made on the store.
export type EchoMsg = Ping(Address(Int))

export let echo : Peer.Service(EchoMsg) = Peer.service("echo")

export let echoAdapted : Peer.Service(Address(Int)) = Peer.service("echo-adapted")

// An adapter on the store, which answers each address it is given with an
// adapted address of it made there, which doubles what is sent through it.
export type AdapterMsg = Adapt(target : Address(Int), reply : Reply(Address(Int)))

export let adapter : Peer.Service(AdapterMsg) = Peer.service("adapter")
