// Report §8.7, Appendix G.4: the loads the host's services give on a node,
// which its measures run, and the wait for a peer's telling; a module with
// no binding, so that its spawns run on any peer that has the build.

// Whether each of the host's services, cpu, memory and disk, answers a load
// on the peer, which writes it to its standard output.
export fn loadsOn(name : String) : Either(Io.Error, Address(Never)) with m =
    Peer.spawn(name, fn() : Unit with Never = Io.println("loads there: " <> loads()), 5000)

export fn loads() : String with m =
    Io.show(#(answers(Load.cpu()), answers(Load.memory()), answers(Load.disk())))

fn answers(load : Optional(Float)) : Bool =
    match load {
        Some(fraction) -> fraction >= 0.0 && fraction <= 1.0
      | None -> false
    }

// Report §8.7: until the node holds a utilisation of the peer named, the
// utilisations read again every interval, the time between the peer's
// tellings, at which alone the table changes; a wait no message can show,
// since a telling is the runtime's frame and no program's.
export fn heard(name : String, interval : Int) : Unit with m =
    if List.any(Peer.utilisations(), fn(#(peer, _, _)) = peer == name) then
        Unit
    else receive {
        after interval -> heard(name, interval)
    }
