// Report §8.7: the desk, which finds the store's services and spawns on it,
// printing what each answers; the test ends the store where it says so.

type Msg = Died(Down)

let early : Either(Peer.Failure, Address(Counter.Msg)) = Peer.find(Counter.key, 100)

export fn main() : Unit with Msg =
    match Os.arguments {
        ["find"] -> finds()
      | ["spawn"] -> spawns()
      | ["across"] -> across()
      | ["calls"] -> calls()
      | ["ending"] -> ending()
      | ["reload"] -> reloaded()
      | ["balance"] -> balanced()
      | ["silence"] -> silenced()
      | ["dial"] -> dialled()
      | ["costs"] -> costs()
      | _ -> Unit
    }

fn finds() : Unit with Msg = {
    Io.println("early: " <> Io.show(early));
    Io.println("peers: " <> Io.show(Peer.peers()));
    let counter = Shared.found(Counter.key);
    Io.println("info: " <> Io.show(Process.info(Process.fromAddress(counter))));
    let unlisted : Peer.Key(Int) = Peer.key("unlisted");
    Io.println("unlisted: " <> Io.show(Peer.find(unlisted, 1000)));
    let otherType : Peer.Key(Int) = Peer.key("counter");
    Io.println("other type: " <> Io.show(Peer.find(otherType, 1000)));
    let nothing : Peer.Key(Int) = Peer.key("nothing");
    Io.println("not offered: " <> Io.show(Peer.find(nothing, 1000)));
    let lost : Peer.Key(Int) = Peer.key("lost");
    Io.println("unreachable: " <> Io.show(Peer.find(lost, 1000)));
    Io.println("timeout: " <> Io.show(Peer.find(Counter.key, 0)));
    // a time past the longest wait the host takes at once
    Io.println("no upper bound: " <> started(Peer.find(Counter.key, 5000000000)));
    let adder = Shared.found(Counter.adder);
    send(adder, 3);
    send(adder, 4);
    Io.println("through the via: " <> Int.toString(total(counter, 7)));
    let victim = Shared.found(Counter.victim);
    monitor(Process.fromAddress(victim), Died);
    kill(victim);
    receive {
        Died(down) -> Io.println("killed: " <> Io.show(down.reason) <> " " <> Io.show(down.site))
    };
    faulted("another node's", fn() : Unit with Never = Peer.offer(Counter.key, counter));
    faulted("twice", fn() : Unit with Int = {
        let key : Peer.Key(Int) = Peer.key("twice");
        Peer.offer(key, self());
        Peer.offer(key, self())
    });
    monitor(Process.fromAddress(counter), Died);
    Io.println("now end the store");
    receive {
        Died(down) -> Io.println("lost: " <> Io.show(down.reason) <> " " <> Io.show(down.site))
    };
    Io.println("after the loss: " <> Io.show(Peer.find(Counter.key, 1000)));
    faulted("call forever", fn() : Unit with Never = {
        let _ = Address.callForever(counter, fn(reply) = Counter.Get(reply = reply));
        Unit
    })
}

fn spawns() : Unit with Msg = {
    Io.println("spawn: " <> started(Work.squareOn("store", 7, 5000)));
    Io.println("not listed: " <> started(Work.squareOn("nobody", 7, 5000)));
    Io.println("not loaded: " <> started(Peer.spawn("store", Lonely.speak, 5000)));
    Io.println("by module: " <> started(Peer.spawn("store", fn() : Unit with Never = Unit, 5000)));
    Io.println("bindings: " <> started(Shared.tellPeers("store")));
    match Work.watchedOn("store", Died, 5000) {
        Right(_) -> receive {
            Died(down) -> Io.println("monitored: " <> Io.show(down.reason))
        }
      | Left(failure) -> Io.println("monitored: " <> Io.show(failure))
    };
    Io.println("late: " <> started(Work.squareOn("store", 9, 0)));
    // a time past the longest wait the host takes at once
    Io.println("no upper bound: " <> started(Work.squareOn("store", 8, 5000000000)))
}

// The counter's total once it is at least the one given: a message to the
// adapted address takes a step more, on the store, and a call can pass it.
fn total(counter : Address(Counter.Msg), least : Int) : Int with n =
    match Address.call(counter, fn(reply) = Counter.Get(reply = reply), 1000) {
        Some(total) when total >= least -> total
      | Some(_) -> total(counter, least)
      | None -> fault("no answer")
    }

// How a process that runs f ended, which a fault in it says; monitored from
// its start, since it may end before a monitor made after the spawn.
fn faulted(what : String, f : () -> Unit with m) : Unit with Msg = {
    let _ = spawnMonitored(f, Died);
    receive {
        Died(down) -> Io.println(what <> ": " <> Io.show(down.reason))
    }
}

fn started(answer : Either(Peer.Failure, Address(m))) : String =
    match answer {
        Right(_) -> "Right"
      | Left(failure) -> Io.show(failure)
    }

// Report §8.7: what crosses, an address on a third node, an address of a
// node not listed, a fault in an adapted address's function, a loss, and
// the store's new start, which the test makes when the desk says so and
// tells the desk of on its standard input.
fn across() : Unit with Msg = {
    let counter = Shared.found(Counter.key);
    let census = Shared.found(Census.key);
    let atomsBefore = Address.callForever(census, fn(reply) = Census.Count(reply = reply));
    List.foreach(List.range(1, 200), fn(n) = send(census, Census.Value(shape(n))));
    send(census, Census.Value(Census.Raw(Bytes.repeat(String.toUtf8("x"), 8000000))));
    let atomsAfter = Address.callForever(census, fn(reply) = Census.Count(reply = reply));
    Io.println("new atoms: " <> Int.toString(atomsAfter - atomsBefore));
    send(Shared.found(Counter.counterSlot), Slot.Put(counter));
    Io.println("through the third node: " <> Int.toString(total(counter, 10)));
    let echo = Slot.take(Shared.found(Counter.echoSlot));
    send(echo, 1);
    watched("not listed", Process.fromAddress(echo));
    let fragile = Shared.found(Counter.fragile);
    monitor(Process.fromAddress(fragile), Died);
    send(Shared.found(Counter.strict), -1);
    ended("adapted");
    monitor(Process.fromAddress(counter), Died);
    sever(Process.fromAddress(counter));
    ended("severed");
    send(counter, Counter.Add(5));
    Io.println("after the loss: " <> Int.toString(total(counter, 15)));
    restarted(counter)
}

// The store ended by the test and started again: a monitor of a process of
// a node out of reach, a send that returns at once, and an address of the
// node's earlier start, which a call, a send and a monitor find dead, and
// an adapted address its earlier start made, which drops what is sent
// through it: the process here it adapts takes first what the same is
// sent through one the new start made, after it.
fn restarted(counter : Address(Counter.Msg)) : Unit with Msg = {
    let first = spawnMonitored(firstTaken, Died);
    let doubled = adapted(first);
    monitor(Process.fromAddress(counter), Died);
    Io.println("now kill the store");
    ended("killed");
    let sent = Clock.monotonic();
    send(counter, Counter.Add(1));
    Io.println("send at once: " <> Io.show(Clock.monotonic() - sent < 1000));
    watched("out of reach", Process.fromAddress(counter));
    Io.println("now restart the store");
    let _ = Io.readLine();
    let called = Clock.monotonic();
    let answer = Address.call(counter, fn(reply) = Counter.Get(reply = reply), 5000);
    Io.println("old call: "
                   <> Io.show(answer)
                   <> " "
                   <> Io.show(Clock.monotonic() - called < 1000));
    send(counter, Counter.Add(1));
    watched("old monitor", Process.fromAddress(counter));
    let fresh = Shared.found(Counter.key);
    Io.println("same process: "
                   <> Io.show(Process.fromAddress(fresh) == Process.fromAddress(counter)));
    Io.println("fresh total: " <> Int.toString(total(fresh, 0)));
    send(doubled, 21);
    send(adapted(first), 1);
    receive {
        Died(_) -> Unit
    }
}

// The first message this process takes, printed.
fn firstTaken() : Unit with Int =
    receive {
        n -> Io.println("old adapted: " <> Int.toString(n))
    }

// An adapted address of the target, made on the store, which doubles.
fn adapted(target : Address(Int)) : Address(Int) with n =
    Address.callForever(Shared.found(Counter.adapter),
                        fn(reply) = Counter.Adapt(target = target, reply = reply))

// A monitor of the process, and how its Down says it ended.
fn watched(what : String, process : Process) : Unit with Msg = {
    monitor(process, Died);
    ended(what)
}

fn ended(what : String) : Unit with Msg =
    receive {
        Died(down) -> Io.println(what <> ": " <> Io.show(down.reason) <> " " <> Io.show(down.site))
    }

fn shape(n : Int) : Census.Shape =
    match n % 5 {
        0 -> Census.Point(x = Int.toFloat(n), y = 0.5)
      | 1 -> Census.Named(name = "n" <> Int.toString(n), tags = ["a", "b"])
      | 2 -> Census.Nested(Some(if n % 2 == 0 then Left("left") else Right(n)))
      | 3 -> Census.Raw(String.toUtf8(Int.toString(n)))
      | _ -> Census.Pair(#('x', n % 2 == 0))
    }

foreign fn sever(process : Process) : Unit with m =
    "ern_peers_host:sever/1"

// Report §8.7: each way a call to a process of another node ends, and the
// note the store keeps of it until it is over, which the store's census
// counts.
fn calls() : Unit with Msg = {
    let brittle = Shared.found(Calls.brittle);
    let sleeper = Shared.found(Calls.sleeper);
    let doomed = Shared.found(Calls.doomed);
    let census = Shared.found(Census.key);
    let started = Clock.monotonic();
    let crashed = Address.call(brittle, fn(reply) = Calls.Crash(reply = reply), 10000);
    Io.println("restarted: "
                   <> Io.show(crashed)
                   <> " "
                   <> Io.show(Clock.monotonic() - started < 5000));
    faulted("restarted forever", fn() : Unit with Never = {
        let _ = Address.callForever(brittle, fn(reply) = Calls.Crash(reply = reply));
        Unit
    });
    Io.println("echo: "
                   <> Io.show(Address.call(brittle,
                                           fn(reply) = Calls.Echo(n = 7, reply = reply),
                                           5000)));
    let _ = spawnMonitored(fn() : Unit with Never = {
                               let _ =
                                   Address.call(doomed,
                                                fn(reply) = Calls.Slow(ms = 60000, reply = reply),
                                                60000);
                               Unit
                           },
                           Died);
    Io.println("while it waits: " <> Int.toString(notes(census, doomed, 1)));
    kill(doomed);
    ended("its callee killed");
    Io.println("after the callee's end: " <> Int.toString(notes(census, doomed, 0)));
    let late = Address.call(sleeper, fn(reply) = Calls.Slow(ms = 60000, reply = reply), 50);
    Io.println("timed out: " <> Io.show(late) <> " " <> Int.toString(notes(census, sleeper, 0)));
    let answerer = spawn(fn() : Unit with Reply(Int) = receive {
        reply -> answer(reply, 42)
    });
    let forwarded =
        Address.call(brittle, fn(reply) = Calls.Forward(answerer = answerer, reply = reply), 5000);
    Io.println("answered here: "
                   <> Io.show(forwarded)
                   <> " "
                   <> Int.toString(notes(census, brittle, 0)));
    let _ = spawnMonitored(fn() : Unit with Never = {
                               let _ =
                                   Address.call(sleeper,
                                                fn(reply) = Calls.Slow(ms = 60000, reply = reply),
                                                60000);
                               Unit
                           },
                           Died);
    Io.println("waits again: " <> Int.toString(notes(census, sleeper, 1)));
    sever(Process.fromAddress(census));
    ended("its connection lost");
    Io.println("after the loss: " <> Int.toString(notes(census, sleeper, 0)))
}

// The notes the store keeps on the callee, once they are the count wanted:
// the second note and the store's gateway come after the call they follow
// has ended here.
fn notes(census : Address(Census.Msg), callee : Address(Calls.Msg), wanted : Int) : Int with n = {
    let process = Process.fromAddress(callee);
    match Address.callForever(census, fn(reply) = Census.Notes(callee = process, reply = reply)) {
        kept when kept == wanted -> kept
      | _ -> notes(census, callee, wanted)
    }
}

// Report §8.7: the store ended by `ern stop`, which a monitor made before
// sees as ProgramEnd, and one made once the store has stopped, which the
// test tells the desk of on its standard input, as Unreachable.
fn ending() : Unit with Msg = {
    let counter = Shared.found(Counter.key);
    monitor(Process.fromAddress(counter), Died);
    Io.println("watching");
    ended("ended");
    let _ = Io.readLine();
    watched("after", Process.fromAddress(counter))
}

// Report §8.7: the store's reloads, which the test makes when the desk says
// so and tells the desk of on its standard input: the desk removed, listed
// again under another name, renamed, and a file refused.
fn reloaded() : Unit with Msg = {
    let counter = Shared.found(Counter.key);
    monitor(Process.fromAddress(counter), Died);
    Io.println("watching");
    ended("removed");
    Io.println("unlisted: " <> Io.show(Peer.find(Counter.key, 2000)));
    Io.println("now list the desk again");
    let _ = Io.readLine();
    let again = Shared.found(Counter.key);
    Io.println("listed again: "
                   <> Io.show(Process.fromAddress(again) == Process.fromAddress(counter)));
    Io.println("now rename the desk");
    let _ = Io.readLine();
    Io.println("renamed: "
                   <> Io.show(Address.call(again, fn(reply) = Counter.Get(reply = reply), 2000)));
    Io.println("now refuse a reload");
    let _ = Io.readLine();
    Io.println("refused: "
                   <> Io.show(Address.call(again, fn(reply) = Counter.Get(reply = reply), 2000)))
}

// Appendix G: a balancer over this node and the store, in turn, then by
// the measures installed on each, the work spawned where it picks; and the
// loads of the host's services, which the store runs and the desk does not.
fn balanced() : Unit with Msg = {
    let balancer = Balancer.start([Balancer.Here, Balancer.On("store")]);
    Io.println("in turn: "
                   <> Io.show(#(Balancer.pick(balancer, 1000), Balancer.pick(balancer, 1000))));
    let _ = Placing.highHere(balancer);
    Io.println("measured: " <> started(Placing.lowOn(balancer, "store")));
    registered(balancer, 0);
    Io.println("picked: the store three times in a row");
    match Balancer.pick(balancer, 1000) {
        Some(Balancer.On(name)) -> Io.println("work: " <> started(Work.squareOn(name, 6, 5000)))
      | _ -> Io.println("work: not on the store")
    };
    Io.println("loads here: " <> Placing.loads());
    Io.println("loads: " <> started(Placing.loadsOn("store")))
}

// Until three picks in a row take the store, which they do once its
// measure, the lower, has registered beside this node's: in turn, two
// places alternate.
fn registered(balancer : Address(Balancer.Msg), inARow : Int) : Unit with n =
    if inARow == 3 then
        Unit
    else match Balancer.pick(balancer, 1000) {
        Some(Balancer.On(_)) -> registered(balancer, inARow + 1)
      | _ -> registered(balancer, 0)
    }

// Report §8.7, the proposal's section 4: what a silence ends and what it
// leaves. Before it, ten thousand messages arrive, none lost and none twice.
// The test stops the store when the desk says so and tells the desk on its
// standard input; the desk then waits, with a monitor on the store's
// counter, a call and a callForever waiting on the store's sleeper, and a
// process of its own, until the detector gives the store up, and says how
// long that took. Once the test has let the store run again, the counter's
// address reaches it again.
fn silenced() : Unit with Msg = {
    let counter = Shared.found(Counter.key);
    let sleeper = Shared.found(Calls.sleeper);
    List.foreach(List.range(1, 10000), fn(_) = send(counter, Counter.Add(1)));
    Io.println("counted: "
                   <> Io.show(Address.call(counter, fn(reply) = Counter.Get(reply = reply), 5000)));
    let local = spawn(fn() : Unit with Counter.Msg = counted(0));
    monitor(Process.fromAddress(counter), Died);
    let caller = spawnMonitored(fn() : Unit with Never = {
                                    let answer =
                                        Address.call(sleeper,
                                                     fn(reply) =
                                                         Calls.Slow(ms = 600000, reply = reply),
                                                     600000);
                                    Io.println("the call: " <> Io.show(answer))
                                },
                                Died);
    let forever = spawnMonitored(fn() : Unit with Never = {
                                     let _ =
                                         Address.callForever(sleeper,
                                                             fn(reply) =
                                                                 Calls.Slow(ms = 600000,
                                                                            reply = reply));
                                     Unit
                                 },
                                 Died);
    Io.println("now stop the store");
    let _ = Io.readLine();
    let stopped = Clock.monotonic();
    let downs = [received(), received(), received()];
    Io.println("given up after: " <> Int.toString((Clock.monotonic() - stopped) / 1000));
    shown("silent", downs, Process.fromAddress(counter));
    shown("its caller", downs, Process.fromAddress(caller));
    shown("its forever caller", downs, Process.fromAddress(forever));
    Io.println("own process: "
                   <> Io.show(Address.call(local, fn(reply) = Counter.Get(reply = reply), 1000)));
    Io.println("now let the store run");
    let _ = Io.readLine();
    Io.println("again: "
                   <> Io.show(Address.call(counter, fn(reply) = Counter.Get(reply = reply), 5000)))
}

fn received() : Down with Msg =
    receive {
        Died(down) -> down
    }

// How the process ended, by the one of the Downs that names it.
fn shown(what : String, downs : List(Down), process : Process) : Unit with n =
    match List.find(downs, fn(down) = down.process == process) {
        Some(down) -> Io.println(what <> ": " <> Io.show(down.reason) <> " " <> Io.show(down.site))
      | None -> Io.println(what <> ": no Down")
    }

// A counter of the desk's own, which a loss of the store leaves alone.
fn counted(total : Int) : Unit with Counter.Msg =
    receive {
        Counter.Add(amount) -> counted(total + amount)
      | Counter.Get(reply = reply) -> {
            answer(reply, total);
            counted(total)
        }
    }

// Report §8.7, the proposal's section 7: a find whose dial nothing answers,
// the store's address a proxy that takes the connection and passes nothing,
// is given up by the host after 7 seconds, and the find answers Unreachable
// and not Timeout.
fn dialled() : Unit with Msg = {
    let started = Clock.monotonic();
    let found = Peer.find(Counter.key, 30000);
    Io.println("dialled: "
                   <> Io.show(found)
                   <> " after "
                   <> Int.toString((Clock.monotonic() - started) / 1000))
}

// The proposal's section 9, `make bench`: the microseconds of the host's
// round trip to the store, of a call to a process there and to one here,
// and of a message to the store's counter, sent straight and through the
// adapted address made on the store, each over many, a line each.
fn costs() : Unit with Msg = {
    let counter = Shared.found(Counter.key);
    let brittle = Shared.found(Calls.brittle);
    let echo = Shared.found(Counter.echo);
    let echoAdapted = Shared.found(Counter.echoAdapted);
    let local = spawn(fn() : Unit with Counter.Msg = counted(0));
    let rounds = 5000;
    Io.println("ping " <> Io.show(pings(Process.fromAddress(counter), rounds)));
    Io.println("remote-call "
                   <> Io.show(timed(rounds, fn() = {
                       let _ =
                           Address.call(brittle,
                                        fn(reply) = Calls.Echo(n = 1, reply = reply),
                                        5000);
                       Unit
                   })));
    Io.println("local-call "
                   <> Io.show(timed(rounds, fn() = {
                       let _ = Address.call(local, fn(reply) = Counter.Get(reply = reply), 5000);
                       Unit
                   })));
    Io.println("straight " <> Io.show(echoed(rounds, fn(back) = send(echo, Counter.Ping(back)))));
    Io.println("adapted " <> Io.show(echoed(rounds, fn(back) = send(echoAdapted, back))))
}

// The microseconds of one run of the function, over as many runs.
fn timed(rounds : Int, f : () -> Unit with Msg) : Float with Msg = {
    let started = Clock.monotonic();
    List.foreach(List.range(1, rounds), fn(_) = f());
    Int.toFloat(Clock.monotonic() - started) * 1000.0 / Int.toFloat(rounds)
}

// The microseconds of a round trip to the store's echo, each a message
// there, sent as the function sends it, and its answer back, over as many,
// by a process of its own, whose end the desk waits for.
fn echoed(rounds : Int, ping : (Address(Int)) -> Unit with Int) : Float with Msg = {
    let started = Clock.monotonic();
    let _ = spawnMonitored(fn() : Unit with Int = pinged(rounds, ping), Died);
    let _ = received();
    Int.toFloat(Clock.monotonic() - started) * 1000.0 / Int.toFloat(rounds)
}

fn pinged(left : Int, ping : (Address(Int)) -> Unit with Int) : Unit with Int =
    if left == 0 then
        Unit
    else {
        ping(self());
        receive {
            _ -> pinged(left - 1, ping)
        }
    }

foreign fn pings(process : Process, count : Int) : Float with m =
    "ern_peers_host:pings/2"
