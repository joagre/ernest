//
// A load for Fs (plan, MVP 2.7): each round the same files are written,
// read, listed, copied, renamed and removed, then a mark
// (test/ern_load.erl).
//

foreign fn mark(round : Int) -> Unit with m =
    "ern_load:mark/1"

let rounds = 14

let batch = 100

let dir = Path("build/load/files")

export fn main() -> Unit with Never = {
    let _ = Fs.makeDir(dir, 1000);
    round(1)
}

fn round(n : Int) -> Unit with Never =
    if n > rounds then
        Unit
    else {
        work(batch);
        mark(n);
        round(n + 1)
    }

fn work(left : Int) -> Unit with Never =
    if left == 0 then
        Unit
    else {
        once();
        work(left - 1)
    }

fn once() -> Unit with Never = {
    let a = Path.join(dir, Path("a"));
    let b = Path.join(dir, Path("b"));
    let _ = Fs.write(a, String.toUtf8("hello"), 1000);
    let _ = Fs.append(a, String.toUtf8(", world"), 1000);
    let _ = Fs.read(a, 1000);
    let _ = Fs.stat(a, 1000);
    let _ = Fs.copy(a, b, 1000);
    let _ = Fs.list(dir, 1000);
    let _ = Fs.remove(b, 1000);
    let _ = Fs.rename(a, b, 1000);
    let _ = Fs.remove(b, 1000);
    let _ = Fs.read(a, 1000);
    Unit
}
