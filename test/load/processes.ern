//
// A load for the runtime's processes (plan, MVP 2.7): each round the same
// spawns, calls answered, late and never answered, monitors, kills, faults,
// and subscriptions to faults, then a mark (test/ern_load.erl).
//

type WorkMsg = Ask(reply : Reply(Int)) | Stop

type Msg = Ended(Down)

foreign fn mark(round : Int) : Unit with m =
    "ern_load:mark/1"

let rounds = 14

// A service that lives as long as the program, which short-lived
// processes watch.
let keeper : Address(WorkMsg) = spawn(worker)

let batch = 300

export fn main() : Unit with Msg =
    round(1)

fn round(number : Int) : Unit with Msg =
    if number > rounds then
        Unit
    else {
        work(batch);
        mark(number);
        round(number + 1)
    }

fn work(left : Int) : Unit with Msg =
    if left == 0 then
        Unit
    else {
        once();
        work(left - 1)
    }

fn once() : Unit with Msg = {
    // a call answered, then the callee monitored and killed
    let answerer = spawn(worker);
    let _ = Address.call(answerer, fn(reply) = Ask(reply = reply), 1000);
    monitor(answerer, Ended);
    kill(answerer);
    receive {
        Ended(_) -> Unit
    };
    // a call whose answer comes after its time, and one never answered
    let laggard = spawn(slow);
    let _ = Address.call(laggard, fn(reply) = Ask(reply = reply), 1);
    send(laggard, Stop);
    let mute = spawn(silent);
    let _ = Address.call(mute, fn(reply) = Ask(reply = reply), 0);
    kill(mute);
    // a process that faults, watched from its start
    let _ = spawnMonitored(fn() : Unit with Never = fault("on purpose"), Ended);
    receive {
        Ended(_) -> Unit
    };
    // a watch on the service by a process that ends before it
    let _ = spawnMonitored(fn() : Unit with Msg = monitor(keeper, Ended), Ended);
    receive {
        Ended(_) -> Unit
    };
    // a subscription to faults that ends with its process
    let _ = spawnMonitored(fn() : Unit with Process.FaultReport = Process.faults(fn(reply) = reply),
                           Ended);
    receive {
        Ended(_) -> Unit
    }
}

fn worker() : Unit with WorkMsg =
    receive {
        Ask(reply = reply) -> {
            answer(reply, 1);
            worker()
        }
      | Stop -> Unit
    }

fn slow() : Unit with WorkMsg =
    receive {
        Ask(reply = reply) -> {
            receive {
                after 5 -> Unit
            };
            answer(reply, 1);
            slow()
        }
      | Stop -> Unit
    }

fn silent() : Unit with WorkMsg =
    receive {
        Stop -> Unit
    }
