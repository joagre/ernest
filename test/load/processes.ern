//
// A load for the runtime's processes (plan, MVP 2.7): each round the same
// spawns, calls answered, late and never answered, monitors, kills, faults,
// and subscriptions to faults, then a mark (test/ern_load.erl).
//

type WorkMsg = Ask(reply : Reply(Int)) | Stop

type Msg = Ended(Down)

foreign fn mark(round : Int) -> Unit with m = "ern_load:mark/1"

let rounds = 14

// A service that lives as long as the program, which short-lived
// processes watch.
let keeper : Address(WorkMsg) = spawn(Local, worker)

let batch = 300

export fn main() -> Unit with Msg = round(1)

fn round(n : Int) -> Unit with Msg =
    if n > rounds then Unit
    else {
        work(batch);
        mark(n);
        round(n + 1)
    }

fn work(left : Int) -> Unit with Msg =
    if left == 0 then Unit
    else {
        once();
        work(left - 1)
    }

fn once() -> Unit with Msg = {
    // a call answered, then the callee monitored and killed
    let w = spawn(Local, worker);
    let _ = Address.call(w, fn(r) = Ask(reply = r), 1000);
    monitor(w, Ended);
    kill(w);
    receive { Ended(_) -> Unit };
    // a call whose answer comes after its time, and one never answered
    let s = spawn(Local, slow);
    let _ = Address.call(s, fn(r) = Ask(reply = r), 1);
    send(s, Stop);
    let q = spawn(Local, silent);
    let _ = Address.call(q, fn(r) = Ask(reply = r), 0);
    kill(q);
    // a process that faults, watched from its start
    let _ = spawnMonitored(Local, fn() -> Unit with Never = fault("on purpose"), Ended);
    receive { Ended(_) -> Unit };
    // a watch on the service by a process that ends before it
    let _ = spawnMonitored(Local, fn() -> Unit with Msg = monitor(keeper, Ended), Ended);
    receive { Ended(_) -> Unit };
    // a subscription to faults that ends with its process
    let _ = spawnMonitored(Local, fn() -> Unit with Process.FaultReport = Process.faults(fn(r) = r),
        Ended);
    receive { Ended(_) -> Unit }
}

fn worker() -> Unit with WorkMsg = receive {
    Ask(reply = r) -> {
        answer(r, 1);
        worker()
    }
  | Stop -> Unit
}

fn slow() -> Unit with WorkMsg = receive {
    Ask(reply = r) -> {
        receive { after 5 -> Unit };
        answer(r, 1);
        slow()
    }
  | Stop -> Unit
}

fn silent() -> Unit with WorkMsg = receive { Stop -> Unit }
