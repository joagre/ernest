//
// The benchmark of `make bench` (test/ern_bench.erl): each operation run in
// a loop of its own three times, and the fastest run printed as the
// operation's key, the loop's count and the milliseconds it took.
// ern_bench runs the same operations as Erlang writes them and prints the
// two side by side.
//

type Msg = Ping(Int) | Answered(Optional(Int))

type ServerMsg = Get(reply : Reply(Int))

type Point = Point(x : Int, y : Int)

fn Point.+(left : Point, right : Point) : Point =
    Point(x = left.x + right.x, y = left.y + right.y)

export fn main() : Unit with Msg = {
    let point = Point(x = 1, y = 2);
    let map = Map.fromList([#(1, 2), #(3, 4)]);
    let list = List.range(1, 100);
    let first = "ab";
    let second = "cd";
    let bytes = String.toUtf8("abcd");
    let server = spawn(serve);
    measure("loop", 10000000, fn(index) = index);
    measure("operator", 10000000, fn(index) = (Point(x = index, y = 1) + point).x);
    measure("equal", 10000000, fn(index) = if Point(x = index, y = 2) == point then 1 else 0);
    measure("map_get", 10000000, fn(index) = Optional.withDefault(Map.get(map, index % 4), 0));
    measure("map_put", 5000000, fn(index) = Map.size(Map.put(map, index % 8, index)));
    measure("list_map", 200000, fn(index) = match List.map(list, fn(element) = element + index) {
        head :: _ -> head
      | [] -> 0
    });
    measure("list_size", 1000000, fn(index) = List.size(list) + index);
    measure("string_size", 5000000, fn(index) = String.size(first) + index);
    measure("string_append", 5000000, fn(index) = String.size(first <> second) + index);
    measure("bytes_size", 10000000, fn(index) = Bytes.size(bytes) + index);
    measure("send", 5000000, fn(index) = {
        send(self(), Ping(index));
        receive {
            Ping(value) -> value
        }
    });
    measure("call",
            1000000,
            fn(index) = Address.callForever(server, fn(reply) = Get(reply = reply)) + index);
    measure("ask", 1000000, fn(index) = {
        Address.ask(server, fn(reply) = Get(reply = reply), Answered, 1000);
        receive {
            Answered(Some(value)) -> value + index
          | Answered(None) -> index
          | Ping(_) -> index
        }
    });
    measure("spawn", 200000, fn(index) = {
        let _ = spawn(fn() : Unit with Never = Unit);
        index
    })
}

// The fastest of three timings of `count` iterations, printed as `key count ms`.
fn measure(key : String, count : Int, operation : (Int) -> Int with m) : Unit with m = {
    let took =
        Int.min(timed(count, operation), Int.min(timed(count, operation), timed(count, operation)));
    Io.println(key <> " " <> Int.toString(count) <> " " <> Int.toString(took))
}

fn timed(count : Int, operation : (Int) -> Int with m) : Int with m = {
    let started = Clock.monotonic();
    let _ = loop(count, operation, 0);
    Clock.monotonic() - started
}

fn loop(count : Int, operation : (Int) -> Int with m, acc : Int) : Int with m =
    if count == 0 then acc else loop(count - 1, operation, acc + operation(count))

fn serve() : Unit with ServerMsg =
    receive {
        Get(reply = reply) -> {
            answer(reply, 1);
            serve()
        }
    }
