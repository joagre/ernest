//
// Patterns
//
// The pattern forms of the report as a program: negative literal
// patterns, `as` bindings, wildcards, list and constructor patterns (§5.10),
// clause alternatives (§5.9), and prefix negation (§5.1). Expected output:
// "minus one", "zero", "other", "a 2", "nothing", "-3", "3", "4".
//
// Needs MVP 2, for clause alternatives with `or`.
//

type Snapshot = Snapshot(directory : String, seen : Int)

type Shape = Circle(Int) | Square(Int) | Dot

export fn main() : Unit with Never = {
    Io.println(sign(-1));
    Io.println(sign(0));
    Io.println(sign(7));
    Io.println(describe(Some(Snapshot(directory = "a", seen = 2))));
    Io.println(describe(None));
    Io.println(Int.toString(negate(3)));
    Io.println(Int.toString(List.size(whole([1, 2, 3]))));
    Io.println(Int.toString(side(Square(4))))
}

fn sign(number : Int) : String =
    match number {
        -1 -> "minus one"
      | 0 -> "zero"
      | _ -> "other"
    }

fn describe(found : Optional(Snapshot)) : String =
    match found {
        Some(Snapshot(directory = directory) as snapshot) ->
            directory <> " " <> Int.toString(seen(snapshot))
      | None -> "nothing"
    }

fn seen(Snapshot(seen = count) : Snapshot) : Int =
    count

fn negate(number : Int) : Int =
    -number

// A clause with alternatives binds the same variables in each.
fn side(shape : Shape) : Int =
    match shape {
        Circle(size) or Square(size) -> size
      | Dot -> 0
    }

// `as` binds loosest: `first :: rest as all` names the whole list.
fn whole(list : List(Int)) : List(Int) =
    match list {
        first :: rest as all -> all
      | [] -> []
    }
