//
// A write to a terminal that is gone, for the terminal tests (report §12.1,
// §11.8): the program says that it is ready, waits until `cat` has read the
// named pipe its first argument names to its end, which the test brings
// about once it has hung the terminal up, and then writes to its standard
// output, the terminal that has gone. Its second argument is the
// milliseconds the wait may take, the test's time for one step.
//

export fn main() : Unit =
    match Os.arguments {
        [pipe, ms] -> {
            Io.println("ready");
            let reader =
                Os.Command(program = "cat",
                           arguments = [pipe],
                           input = <<>>,
                           environment = [],
                           workingDirectory = Os.workingDirectory);
            let _ = Os.run(reader, Optional.withDefault(String.toInt(ms), 0));
            Io.println("written")
        }
      | _ ->
            Unit
    }
