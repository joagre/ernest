//
// A warning of the host's at a terminal that is gone, for the terminal
// tests (report §11, §12.1, §11.8): the program says on standard error
// that it is ready, waits until `cat` has read the named pipe its first
// argument names to its end, which the test brings about once it has hung
// the terminal up, and then has the host log a warning, which the job
// writes on standard error, the terminal that has gone. It then waits for
// a message none sends, so that only the warning's write ends it by the
// hangup's signal. Its second argument is the milliseconds each of its two
// waits may take, the test's time for one step: the test runs it in a
// session of its own, outside what the harness ends at its bound, so the
// program ends itself where the write did not.
//

type Msg = Unsent

foreign fn warn(text : String) : Unit =
    "logger:warning/1"

export fn main() : Unit receiving Msg =
    match Os.arguments {
        [pipe, ms] -> {
            Io.printlnError("ready");
            let reader =
                Os.Command(program = "cat",
                           arguments = [pipe],
                           input = <<>>,
                           environment = [],
                           workingDirectory = Os.workingDirectory);
            let step = Optional.withDefault(String.toInt(ms), 0);
            let _ = Os.run(reader, step);
            warn("a warning once the terminal has gone, é ☃");
            receive {
                Unsent -> Unit
              | after step -> Unit
            }
        }
      | _ ->
            Unit
    }
