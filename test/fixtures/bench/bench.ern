//
// The benchmark of `make bench` (test/ern_bench.erl): each operation run in
// a loop of its own three times, and the fastest run printed as the
// operation's key, the loop's count and the milliseconds it took; a raise,
// at each backtrace depth, in seven loops, and their median and range
// printed in microseconds. ern_bench runs the same operations as Erlang
// writes them and prints the two side by side.
//

type Msg = Ping(Int)

type ServerMsg = Get(reply : Reply(Int))

type Point = Point(x : Int, y : Int)

foreign fn systemFlag(flag : Foreign.Term, value : Int) : Int =
    "erlang:system_flag/2"

foreign fn parsed(text : String) : Int =
    "erlang:binary_to_integer/1"

let backtraceDepth : Foreign.Term = Foreign.atom("backtrace_depth")

fn Point.+(left : Point, right : Point) : Point =
    Point(x = left.x + right.x, y = left.y + right.y)

export fn main() : Unit receiving Msg = {
    let point = Point(x = 1, y = 2);
    let map = Map.fromList([#(1, 2), #(3, 4)]);
    let list = List.range(1, 100);
    let first = "ab";
    let second = "cd";
    let bytes = String.toUtf8("abcd");
    let server = spawn(serve);
    let tail = List.range(1, 10);
    let path = Path("srv/site");
    let ended = endedProcess();
    let endedProcessOf = Process.fromAddress(ended);
    measure("loop", 10000000, fn(index) = index);
    measure("operator", 10000000, fn(index) = (Point(x = index, y = 1) + point).x);
    measure("equal", 10000000, fn(index) = if Point(x = index, y = 2) == point then 1 else 0);
    measure("map_get", 10000000, fn(index) = Optional.withDefault(Map.get(map, index % 4), 0));
    measure("map_put", 5000000, fn(index) = Map.size(Map.put(map, index % 8, index)));
    measure("list_map", 200000, fn(index) = match List.map(list, fn(element) = element + index) {
        head :: _ -> head
      | [] -> 0
    });
    measure("list_size", 1000000, fn(index) = List.size(list) + index);
    measure("string_size", 5000000, fn(index) = String.size(first) + index);
    measure("string_append", 5000000, fn(index) = String.size(first <> second) + index);
    measure("bytes_size", 10000000, fn(index) = Bytes.size(bytes) + index);
    measure("send", 5000000, fn(index) = {
        send(self(), Ping(index));
        receive {
            Ping(value) -> value
        }
    });
    measure("call",
            1000000,
            fn(index) = Address.callForever(server, fn(reply) = Get(reply = reply)) + index);
    measure("spawn", 200000, fn(index) = {
        let _ = spawn(fn() = Unit);
        index
    });
    // Report §9.4 to §9.6, MVP 2.99d's item 2: the rest of the prelude.
    measure("self", 10000000, fn(index) = {
        let _ = self();
        index
    });
    measure("spawn_monitored", 200000, fn(index) = {
        let _ = spawnMonitored(fn() = Unit, fn(_) = Ping(index));
        receive {
            Ping(value) -> value
        }
    });
    measure("show", 2000000, fn(index) = if Io.show(index) == "" then 0 else index);
    measure("adapted", 2000000, fn(index) = {
        send(adapted(self(), Ping), index);
        receive {
            Ping(value) -> value
        }
    });
    measure("call_within",
            1000000,
            fn(index) =
                Optional.withDefault(Address.call(server, fn(reply) = Get(reply = reply), 1000), 0)
                    + index);
    measure("monitor", 1000000, fn(index) = {
        monitor(endedProcessOf, fn(_) = Ping(index));
        receive {
            Ping(value) -> value
        }
    });
    measure("kill", 5000000, fn(index) = {
        kill(ended);
        index
    });
    measure("list_append", 2000000, fn(index) = List.size(tail <> tail) + index);
    measure("bytes_append", 5000000, fn(index) = Bytes.size(bytes <> bytes) + index);
    measure("path_join",
            1000000,
            fn(index) = if path <> Path("index.html") == path then 0 else index);
    measure("int_compare", 10000000, fn(index) = match Int.compare(index, 5000000) {
        Less -> 1
      | _ -> 0
    });
    measure("string_compare", 10000000, fn(index) = match String.compare(first, second) {
        Less -> index
      | _ -> 0
    });
    measure("float_times", 10000000, fn(index) = Float.truncate(Int.toFloat(index) * 1.5));
    measure("int_divide", 10000000, fn(index) = index / 3 + index % 7);
    measure("restarting", 1000000, fn(index) = {
        restarting(Unlimited, fn() = Unit)();
        index
    });
    raises([8, 12, 64]);
    let _ = systemFlag(backtraceDepth, 64);
    Unit
}

// Appendix E.21, E.28, report §10: a raise in the host saves as many frames
// of the stack as the host's backtrace depth names, which the runtime sets
// to 64 at its start; at each depth, a failing String.toInt, whose shim
// takes the host's raise, and a foreign function that raises, which faults
// its process, each on a shallow stack and beneath forty frames. The depth
// is set here, by the measuring program, and set back to the runtime's
// after; a fault is reported on standard error, which make bench writes to
// a file.
fn raises(depths : List(Int)) : Unit receiving Msg =
    List.forEach(depths, fn(depth) = {
        let _ = systemFlag(backtraceDepth, depth);
        let suffix = Int.toString(depth);
        measureRuns("raise_" <> suffix, 1000000, failedToInt);
        let _ = deepened(40, fn() = {
            measureRuns("raise_deep_" <> suffix, 1000000, failedToInt);
            0
        });
        measureRuns("fault_" <> suffix, 300, fn(index) = faulted(index, 0));
        measureRuns("fault_deep_" <> suffix, 300, fn(index) = faulted(index, 40))
    })

fn failedToInt(index : Int) : Int =
    Optional.withDefault(String.toInt("x"), index)

// A process that faults beneath `depth` frames, its Down received.
fn faulted(index : Int, depth : Int) : Int receiving Msg = {
    let raising = fn() = {
        let _ = deepened(depth, fn() = parsed("x"));
        Unit
    };
    let _ = spawnMonitored(raising, fn(_) = Ping(index));
    receive {
        Ping(value) -> value
    }
}

// f run beneath `count` frames of this function's own, none a tail call.
fn deepened(count : Int, f : () -> Int receiving m) : Int receiving m =
    if count == 0 then f() else deepened(count - 1, f) + 0

// The median of seven timings of `count` iterations, and their range,
// printed as `key count median lowest highest`, in microseconds.
fn measureRuns(key : String,
               count : Int,
               operation : (Int) -> Int receiving m) : Unit receiving m = {
    let timings =
        List.sort(List.map(List.range(1, 7), fn(_) = timedMicros(count, operation)), compare);
    let at = fn(index) = Int.toString(Optional.withDefault(List.get(timings, index), 0));
    Io.println(String.join([key, Int.toString(count), at(3), at(0), at(6)], " "))
}

fn timedMicros(count : Int, operation : (Int) -> Int receiving m) : Int receiving m = {
    let started = Clock.monotonicMicros();
    let _ = loop(count, operation, 0);
    Clock.monotonicMicros() - started
}

// A process that has ended, which `monitor` reports at once and `kill`
// leaves as it is.
fn endedProcess() : Address(Never) receiving Msg = {
    let address = spawnMonitored(fn() = Unit, fn(_) = Ping(0));
    receive {
        Ping(_) -> address
    }
}

// The fastest of three timings of `count` iterations, printed as `key count ms`.
fn measure(key : String, count : Int, operation : (Int) -> Int receiving m) : Unit receiving m = {
    let took =
        Int.min(timed(count, operation), Int.min(timed(count, operation), timed(count, operation)));
    Io.println(key <> " " <> Int.toString(count) <> " " <> Int.toString(took))
}

fn timed(count : Int, operation : (Int) -> Int receiving m) : Int receiving m = {
    let started = Clock.monotonic();
    let _ = loop(count, operation, 0);
    Clock.monotonic() - started
}

fn loop(count : Int, operation : (Int) -> Int receiving m, acc : Int) : Int receiving m =
    if count == 0 then acc else loop(count - 1, operation, acc + operation(count))

fn serve() : Unit receiving ServerMsg =
    receive {
        Get(reply = reply) -> {
            answer(reply, 1);
            serve()
        }
    }
