//
// A load for Fs (plan, MVP 2.7): each round the same files are written,
// read, listed, copied, renamed and removed, then a mark
// (test/ern_load.erl).
//

foreign fn mark(round : Int) : Unit with m =
    "ern_load:mark/1"

let rounds = 14

let batch = 100

let directory = Path("build/load/files")

export fn main() : Unit with Never = {
    let _ = Fs.makeDir(directory, 1000);
    round(1)
}

fn round(number : Int) : Unit with Never =
    if number > rounds then
        Unit
    else {
        work(batch);
        mark(number);
        round(number + 1)
    }

fn work(left : Int) : Unit with Never =
    if left == 0 then
        Unit
    else {
        once();
        work(left - 1)
    }

fn once() : Unit with Never = {
    let fileA = directory <> Path("a");
    let fileB = directory <> Path("b");
    let _ = Fs.write(fileA, String.toUtf8("hello"), 1000);
    let _ = Fs.append(fileA, String.toUtf8(", world"), 1000);
    let _ = Fs.read(fileA, 1000);
    let _ = Fs.stat(fileA, 1000);
    let _ = Fs.copy(fileA, fileB, 1000);
    let _ = Fs.list(directory, 1000);
    let _ = Fs.remove(fileB, 1000);
    let _ = Fs.rename(fileA, fileB, 1000);
    let _ = Fs.remove(fileB, 1000);
    let _ = Fs.read(fileA, 1000);
    Unit
}
