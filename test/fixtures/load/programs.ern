//
// A load for Os (plan, MVP 2.7): each round the same host programs run to
// their end, are killed, and run past their time, then a mark
// (test/ern_load.erl).
//

foreign fn mark(round : Int) : Unit =
    "ern_load:mark/1"

let rounds = 14

let batch = 20

export fn main() : Unit =
    round(1)

fn round(number : Int) : Unit =
    if number > rounds then
        Unit
    else {
        work(batch);
        mark(number);
        round(number + 1)
    }

fn work(left : Int) : Unit =
    if left == 0 then
        Unit
    else {
        once();
        work(left - 1)
    }

fn once() : Unit = {
    let _ = Os.run(Os.Command(..Os.command("cat", []), input = String.toUtf8("hi")), 5000);
    let _ = Os.run(Os.command("no-such-program-ern", []), 5000);
    match Os.start(Os.command("sleep", ["10"])) {
        Right(process) -> kill(Process.fromAddress(process))
      | Left(_) -> Unit
    };
    let _ = Os.run(Os.command("sleep", ["10"]), 1);
    Unit
}
