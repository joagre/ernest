//
// A load for Os (plan, MVP 2.7): each round the same host programs run to
// their end, are killed, and run past their time, then a mark
// (test/ern_load.erl).
//

foreign fn mark(round : Int) : Unit with m =
    "ern_load:mark/1"

let rounds = 14

let batch = 20

export fn main() : Unit with Never =
    round(1)

fn round(number : Int) : Unit with Never =
    if number > rounds then
        Unit
    else {
        work(batch);
        mark(number);
        round(number + 1)
    }

fn work(left : Int) : Unit with Never =
    if left == 0 then
        Unit
    else {
        once();
        work(left - 1)
    }

fn once() : Unit with Never = {
    let _ = Os.run(Os.Command(program = "cat", arguments = [], input = String.toUtf8("hi")), 5000);
    let _ = Os.run(Os.Command(program = "no-such-program-ern", arguments = [], input = <<>>), 5000);
    match Os.start(Os.Command(program = "sleep", arguments = ["10"], input = <<>>)) {
        Right(process) -> kill(process)
      | Left(_) -> Unit
    };
    let _ = Os.run(Os.Command(program = "sleep", arguments = ["10"], input = <<>>), 1);
    Unit
}
