//
// A load for Clock and timed waits (plan, MVP 2.7): each round the same
// alarms fire and are taken, and the same waits time out, then a mark
// (test/ern_load.erl).
//

type Msg = Ticked(Int)

foreign fn mark(round : Int) : Unit =
    "ern_load:mark/1"

let rounds = 14

let batch = 500

export fn main() : Unit receiving Msg =
    round(1)

fn round(number : Int) : Unit receiving Msg =
    if number > rounds then
        Unit
    else {
        work(batch);
        mark(number);
        round(number + 1)
    }

fn work(left : Int) : Unit receiving Msg =
    if left == 0 then
        Unit
    else {
        once();
        work(left - 1)
    }

fn once() : Unit receiving Msg = {
    Clock.alarm(1, Ticked);
    receive {
        Ticked(_) -> Unit
    };
    Clock.alarmAt(Clock.now(), Ticked);
    receive {
        Ticked(_) -> Unit
    };
    receive {
        after 0 -> Unit
    }
}
