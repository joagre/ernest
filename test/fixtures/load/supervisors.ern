//
// A load for the standard library's Supervisor (plan, MVP 2.7): each round
// the same children fault and restart in place, under one strategy and
// another, and children join and return, then a mark (test/ern_load.erl).
//

type WorkMsg = Ask(reply : Reply(Int)) | Crash

foreign fn mark(round : Int) : Unit with m =
    "ern_load:mark/1"

let rounds = 14

let batch = 100

// The window of the groups' restart limit, in milliseconds.
let window = 1000

let limit = RestartLimit(restarts = 1000000, within = window)

let single : Address(Supervisor.Msg) = spawn(Supervisor.group(Supervisor.OneForOne, limit))

let alone : Address(WorkMsg) = spawn(Supervisor.child(single, working))

let all : Address(Supervisor.Msg) = spawn(Supervisor.group(Supervisor.OneForAll, limit))

let first : Address(WorkMsg) = spawn(Supervisor.child(all, working))

let second : Address(WorkMsg) = spawn(Supervisor.child(all, working))

fn working() : Unit with WorkMsg =
    receive {
        Ask(reply = reply) -> {
            answer(reply, 1);
            working()
        }
      | Crash -> fault("on purpose")
    }

export fn main() : Unit with Never =
    round(1)

fn round(number : Int) : Unit with Never =
    if number > rounds then
        Unit
    else {
        work(batch);
        rest();
        mark(number);
        round(number + 1)
    }

// Each fault of a round sets an alarm the limit's window later, which the
// group counts its faults by (Appendix E.22), so the round rests that long
// before it is marked: a sample counts the node at rest, and an alarm on
// its way, delivered by a process of its own, is not at rest.
fn rest() : Unit with Never =
    receive {
        after window + 100 -> Unit
    }

fn work(left : Int) : Unit with Never =
    if left == 0 then
        Unit
    else {
        once();
        work(left - 1)
    }

fn once() : Unit with Never = {
    crash(alone);
    crash(second);
    let _ = spawn(Supervisor.child(single, fn() : Unit with Never = Unit));
    Unit
}

// A crash, and a call that waits until the child answers again.
fn crash(child : Address(WorkMsg)) : Unit with Never = {
    send(child, Crash);
    answered(child)
}

fn answered(child : Address(WorkMsg)) : Unit with Never =
    match Address.call(child, fn(reply) = Ask(reply = reply), 1000) {
        Some(_) -> Unit
      | None -> answered(child)
    }
