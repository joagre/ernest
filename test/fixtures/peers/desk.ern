// Report §8.7: the desk, which finds the store's services, spawns and
// computes on it, asks how busy it is and computes on the peer it picks,
// printing what each answers; the test ends the store where it says so.
// Each wait is given the test's time for one step (Harness.waitMs), but
// where a line says otherwise.

type Msg = Died(Down) | Reported(Process.FaultReport) | Started(String)

let early : Either(Io.Error, Address(Counter.Msg)) = Peer.find(Counter.service, Harness.waitMs())

export fn main() : Unit receiving Msg =
    match Os.arguments {
        ["find"] -> finds()
      | ["spawn"] -> spawns()
      | ["across"] -> across()
      | ["calls"] -> calls()
      | ["reconnect"] -> reconnected()
      | ["ending"] -> ending()
      | ["reload"] -> reloaded()
      | ["place", interval] -> placed(Optional.withDefault(String.toInt(interval), 0))
      | ["silence"] -> silenced()
      | ["dial"] -> dialed()
      | ["costs"] -> costs()
      | ["compute"] -> computes()
      | ["utilization"] -> utilizations()
      | ["gated"] -> faulted("gated", gatedPasses)
      | _ -> Unit
    }

fn finds() : Unit receiving Msg = {
    Io.println("early: " <> Io.show(early));
    Io.println("peers: " <> Io.show(Peer.peers()));
    let counter = Shared.found(Counter.service);
    Io.println("status: " <> Io.show(Process.status(Process.fromAddress(counter))));
    let unlisted : Peer.Service(Int) = Peer.service("unlisted");
    Io.println("unlisted: " <> Io.show(Peer.find(unlisted, Harness.waitMs())));
    let otherType : Peer.Service(Int) = Peer.service("counter");
    Io.println("other type: " <> Io.show(Peer.find(otherType, Harness.waitMs())));
    let nothing : Peer.Service(Int) = Peer.service("nothing");
    Io.println("not offered: " <> Io.show(Peer.find(nothing, Harness.waitMs())));
    let lost : Peer.Service(Int) = Peer.service("lost");
    Io.println("unreachable: " <> Io.show(Peer.find(lost, Harness.waitMs())));
    Io.println("timeout: " <> Io.show(Peer.find(Counter.service, 0)));
    // a time past the longest wait the host takes at once
    Io.println("no upper bound: " <> started(Peer.find(Counter.service, 5000000000)));
    let adder = Shared.found(Counter.adder);
    send(adder, 3);
    send(adder, 4);
    Io.println("through the adapted address: " <> Int.toString(total(counter, 7)));
    let victim = Shared.found(Counter.victim);
    monitor(Process.fromAddress(victim), Died);
    kill(victim);
    receive {
        Died(down) -> Io.println("killed: " <> Io.show(down.reason) <> " " <> Io.show(down.site))
    };
    faulted("another node's", fn() = {
        let _ = Peer.offer(Counter.service, counter);
        Unit
    });
    faulted("twice", fn() : Unit receiving Int = {
        let service : Peer.Service(Int) = Peer.service("twice");
        let me = Process.fromAddress(self());
        Io.println("twice, first: " <> Io.show(Peer.offer(service, self())));
        Io.println("twice, again held by itself: "
                       <> Io.show(Peer.offer(service, self()) == Left(me)))
    });
    monitor(Process.fromAddress(counter), Died);
    Io.println("now end the store");
    receive {
        Died(down) -> Io.println("lost: " <> Io.show(down.reason) <> " " <> Io.show(down.site))
    };
    Io.println("after the loss: " <> Io.show(Peer.find(Counter.service, Harness.waitMs())));
    faulted("call forever", fn() = {
        let _ = Address.callForever(counter, fn(reply) = Counter.Get(reply = reply));
        Unit
    })
}

fn spawns() : Unit receiving Msg = {
    Io.println("spawn: " <> started(Work.squareOn("store", 7, Harness.waitMs())));
    Io.println("not listed: " <> started(Work.squareOn("nobody", 7, Harness.waitMs())));
    Io.println("not loaded: " <> started(Peer.spawn("store", Lonely.speak, Harness.waitMs())));
    // a function that names no binding, of a module whose binding, early,
    // the store never ran
    Io.println("names no binding: " <> started(Peer.spawn("store", fn() = Unit, Harness.waitMs())));
    Io.println("bindings: " <> started(Shared.tellPeers("store")));
    match Work.watchedOn("store", Died, Harness.waitMs()) {
        Right(_) ->
            receive {
                Died(down) -> Io.println("monitored: " <> Io.show(down.reason))
            }
      | Left(failure) ->
            Io.println("monitored: " <> Io.show(failure))
    };
    Io.println("late: " <> started(Work.squareOn("store", 9, 0)));
    // a time past the longest wait the host takes at once
    Io.println("no upper bound: " <> started(Work.squareOn("store", 8, 5000000000)))
}

// The counter's total once it is at least the one given: a message to the
// adapted address takes a step more, on the store, and a call can pass it.
fn total(counter : Address(Counter.Msg), least : Int) : Int =
    match Address.call(counter, fn(reply) = Counter.Get(reply = reply), Harness.waitMs()) {
        Some(total) when total >= least -> total
      | Some(_) -> total(counter, least)
      | None -> fault("no answer")
    }

// How a process that runs f ended, which a fault in it says; monitored from
// its start, since it may end before a monitor made after the spawn.
fn faulted(what : String, f : () -> Unit receiving m) : Unit receiving Msg = {
    let _ = spawnMonitored(f, Died);
    receive {
        Died(down) -> Io.println(what <> ": " <> Io.show(down.reason))
    }
}

fn started(answer : Either(Io.Error, Address(m))) : String =
    match answer {
        Right(_) -> "Right"
      | Left(failure) -> Io.show(failure)
    }

// Report §8.7: what crosses, an address on a third node, an address of a
// node not listed, a fault in an adapted address's function, a loss, and
// the store's new start, which the test makes when the desk says so and
// tells the desk of on its standard input.
fn across() : Unit receiving Msg = {
    let counter = Shared.found(Counter.service);
    let census = Shared.found(Census.service);
    let atomsBefore = Address.callForever(census, fn(reply) = Census.Count(reply = reply));
    List.forEach(List.range(1, 200), fn(n) = send(census, Census.Value(shape(n))));
    send(census, Census.Value(Census.Raw(Bytes.repeat(String.toUtf8("x"), 8000000))));
    let atomsAfter = Address.callForever(census, fn(reply) = Census.Count(reply = reply));
    Io.println("new atoms: " <> Int.toString(atomsAfter - atomsBefore));
    send(Shared.found(Counter.counterSlot), Slot.Put(counter));
    Io.println("through the third node: " <> Int.toString(total(counter, 10)));
    let echo = Slot.take(Shared.found(Counter.echoSlot));
    send(echo, 1);
    watched("not listed", Process.fromAddress(echo));
    let fragile = Shared.found(Counter.fragile);
    monitor(Process.fromAddress(fragile), Died);
    send(Shared.found(Counter.strict), -1);
    ended("adapted");
    monitor(Process.fromAddress(counter), Died);
    sever(Process.fromAddress(counter));
    ended("severed");
    send(counter, Counter.Add(5));
    Io.println("after the loss: " <> Int.toString(total(counter, 15)));
    restarted(counter)
}

// The store ended by the test and started again: a monitor of a process of
// a node out of reach, a send that returns at once while the dial it asks
// for waits on a port that answers nothing, which the test holds when the
// desk says so, and an address of the node's earlier start, which a call,
// a send and a monitor find dead, and an adapted address its earlier start
// made, which drops what is sent through it: the process here it adapts
// takes first what the same is sent through one the new start made, after
// it. A call through the dead address ends before its time runs out.
fn restarted(counter : Address(Counter.Msg)) : Unit receiving Msg = {
    let first = spawnMonitored(firstTaken, Died);
    let doubled = adapted(first);
    monitor(Process.fromAddress(counter), Died);
    Io.println("now kill the store");
    ended("killed");
    Io.println("now silence the store's port");
    let _ = Io.readLine();
    // Report §8.7: the milliseconds after which the host gives up a dial that
    // nothing answers, which a send that waited behind the dial would wait
    let dialGivenUp = 7000;
    let sent = Clock.monotonic();
    send(counter, Counter.Add(1));
    Io.println("send at once: " <> Io.show(Clock.monotonic() - sent < dialGivenUp));
    watched("out of reach", Process.fromAddress(counter));
    Io.println("now restart the store");
    let _ = Io.readLine();
    let limit = Harness.waitMs();
    let called = Clock.monotonic();
    let answer = Address.call(counter, fn(reply) = Counter.Get(reply = reply), limit);
    Io.println("old call: "
                   <> Io.show(answer)
                   <> " "
                   <> Io.show(Clock.monotonic() - called < limit));
    send(counter, Counter.Add(1));
    watched("old monitor", Process.fromAddress(counter));
    let fresh = Shared.found(Counter.service);
    Io.println("same process: "
                   <> Io.show(Process.fromAddress(fresh) == Process.fromAddress(counter)));
    Io.println("fresh total: " <> Int.toString(total(fresh, 0)));
    send(doubled, 21);
    send(adapted(first), 1);
    receive {
        Died(_) -> Unit
    }
}

// The first message this process takes, printed.
fn firstTaken() : Unit receiving Int =
    receive {
        n -> Io.println("old adapted: " <> Int.toString(n))
    }

// An adapted address of the target, made on the store, which doubles.
fn adapted(target : Address(Int)) : Address(Int) =
    Address.callForever(Shared.found(Counter.adapter),
                        fn(reply) = Counter.Adapt(target = target, reply = reply))

// A monitor of the process, and how its Down says it ended.
fn watched(what : String, process : Process) : Unit receiving Msg = {
    monitor(process, Died);
    ended(what)
}

fn ended(what : String) : Unit receiving Msg =
    receive {
        Died(down) -> Io.println(what <> ": " <> Io.show(down.reason) <> " " <> Io.show(down.site))
    }

fn shape(n : Int) : Census.Shape =
    match n % 5 {
        0 -> Census.Point(x = Int.toFloat(n), y = 0.5)
      | 1 -> Census.Named(name = "n" <> Int.toString(n), tags = ["a", "b"])
      | 2 -> Census.Nested(Some(if n % 2 == 0 then Left("left") else Right(n)))
      | 3 -> Census.Raw(String.toUtf8(Int.toString(n)))
      | _ -> Census.Pair(#('x', n % 2 == 0))
    }

foreign fn sever(process : Process) : Unit =
    "ern_peers_host:sever/1"

// Report §8.7: each way a call to a process of another node ends, and the
// note the store keeps of it until it is over, which the store's census
// counts. A call whose request faults its callee ends before its time runs
// out.
fn calls() : Unit receiving Msg = {
    let brittle = Shared.found(Calls.brittle);
    let sleeper = Shared.found(Calls.sleeper);
    let doomed = Shared.found(Calls.doomed);
    let census = Shared.found(Census.service);
    let limit = Harness.waitMs();
    let started = Clock.monotonic();
    let crashed = Address.call(brittle, fn(reply) = Calls.Crash(reply = reply), limit);
    Io.println("restarted: "
                   <> Io.show(crashed)
                   <> " "
                   <> Io.show(Clock.monotonic() - started < limit));
    faulted("restarted forever", fn() = {
        let _ = Address.callForever(brittle, fn(reply) = Calls.Crash(reply = reply));
        Unit
    });
    Io.println("echo: "
                   <> Io.show(Address.call(brittle,
                                           fn(reply) = Calls.Echo(n = 7, reply = reply),
                                           limit)));
    let _ = spawnMonitored(fn() = {
                               let _ =
                                   Address.call(doomed,
                                                fn(reply) = Calls.Slow(ms = limit, reply = reply),
                                                limit);
                               Unit
                           },
                           Died);
    Io.println("while it waits: " <> Int.toString(notes(census, doomed, 1)));
    kill(doomed);
    ended("its callee killed");
    Io.println("after the callee's end: " <> Int.toString(notes(census, doomed, 0)));
    // a time the sleeper's sleep outlasts, the scenario's
    let late = Address.call(sleeper, fn(reply) = Calls.Slow(ms = limit, reply = reply), 50);
    Io.println("timed out: " <> Io.show(late) <> " " <> Int.toString(notes(census, sleeper, 0)));
    let answerer = spawn(fn() : Unit receiving Reply(Int) = receive {
        reply -> answer(reply, 42)
    });
    let forwarded =
        Address.call(brittle, fn(reply) = Calls.Forward(answerer = answerer, reply = reply), limit);
    Io.println("answered here: "
                   <> Io.show(forwarded)
                   <> " "
                   <> Int.toString(notes(census, brittle, 0)));
    let _ = spawnMonitored(fn() = {
                               let _ =
                                   Address.call(sleeper,
                                                fn(reply) = Calls.Slow(ms = limit, reply = reply),
                                                limit);
                               Unit
                           },
                           Died);
    Io.println("waits again: " <> Int.toString(notes(census, sleeper, 1)));
    sever(Process.fromAddress(census));
    ended("its connection lost");
    Io.println("after the loss: " <> Int.toString(notes(census, sleeper, 0)))
}

// The notes the store keeps on the callee, once they are the count wanted:
// the second note and the store's gateway come after the call they follow
// has ended here.
fn notes(census : Address(Census.Msg), callee : Address(Calls.Msg), wanted : Int) : Int = {
    let process = Process.fromAddress(callee);
    match Address.callForever(census, fn(reply) = Census.Notes(callee = process, reply = reply)) {
        kept when kept == wanted -> kept
      | _ -> notes(census, callee, wanted)
    }
}

// Report §8.7: a loss ends each wait on the store that began before the
// desk ran it: a call waiting on the store's sleeper and a compute whose
// process waits there each end before its time, once the desk has ended
// the connection itself, by a frame the store's gateway cannot read. Told
// on its standard input that both nodes have run the loss, the desk opens
// the connection again by its next call, and the waits that begin then
// are answered: the counter's address reaches the same process, its total
// kept, and a compute, a spawn, a find and a utilization answer.
fn reconnected() : Unit receiving Msg = {
    let counter = Shared.found(Counter.service);
    let sleeper = Shared.found(Calls.sleeper);
    let census = Shared.found(Census.service);
    let limit = Harness.waitMs();
    let me = self();
    send(counter, Counter.Add(3));
    let calling = spawnMonitored(fn() = callSleeper(sleeper, limit), Died);
    let computing = spawnMonitored(fn() = computeWaiting(me, limit), Died);
    receive {
        Started(label) when label == "computing" -> Unit
    };
    let _ = notes(census, sleeper, 1);
    sever(Process.fromAddress(counter));
    let downs = [received(), received()];
    shown("its caller", downs, Process.fromAddress(calling));
    shown("its computer", downs, Process.fromAddress(computing));
    Io.println("now open the connection again");
    let _ = Io.readLine();
    let total = Address.call(counter, fn(reply) = Counter.Get(reply = reply), limit);
    Io.println("the same process: " <> Io.show(total));
    Io.println("computed after: " <> Io.show(Peer.computeAt("store", fn() = 6 * 7, limit)));
    Io.println("spawned after: " <> started(Work.squareOn("store", 6, limit)));
    Io.println("found after: " <> started(Peer.find(Counter.service, limit)));
    let measured = Either.isRight(Peer.utilization("store", limit));
    Io.println("measured after: " <> Io.show(measured))
}

// A call to the store's sleeper, which sleeps past the call's time, and how
// it ended, with whether that was before its time.
fn callSleeper(sleeper : Address(Calls.Msg), limit : Int) : Unit = {
    let called = Clock.monotonic();
    let answer = Address.call(sleeper, fn(reply) = Calls.Slow(ms = limit, reply = reply), limit);
    Io.println("the call: "
                   <> Io.show(answer)
                   <> " "
                   <> Io.show(Clock.monotonic() - called < limit))
}

// A compute on the store whose process tells the desk it runs and then
// waits for a number no one sends, and what the compute answered.
fn computeWaiting(desk : Address(Msg), limit : Int) : Unit = {
    let computed =
        Peer.computeAt("store",
                       fn() : Int receiving Int = {
                           send(desk, Started("computing"));
                           receive {
                               n -> n
                           }
                       },
                       limit);
    Io.println("the compute: " <> Io.show(computed))
}

// Report §8.7: the store ended by `ern stop`, which a monitor made before
// sees as ProgramEnd, and one made once the store has stopped, which the
// test tells the desk of on its standard input, as Unreachable.
fn ending() : Unit receiving Msg = {
    let counter = Shared.found(Counter.service);
    monitor(Process.fromAddress(counter), Died);
    Io.println("watching");
    ended("ended");
    let _ = Io.readLine();
    watched("after", Process.fromAddress(counter))
}

// Report §8.7: the store's reloads, which the test makes when the desk says
// so and tells the desk of on its standard input: the desk removed, listed
// again under another name, renamed, and a file refused.
fn reloaded() : Unit receiving Msg = {
    let counter = Shared.found(Counter.service);
    monitor(Process.fromAddress(counter), Died);
    Io.println("watching");
    ended("removed");
    Io.println("unlisted: " <> Io.show(Peer.find(Counter.service, Harness.waitMs())));
    Io.println("now list the desk again");
    let _ = Io.readLine();
    let again = Shared.found(Counter.service);
    Io.println("listed again: "
                   <> Io.show(Process.fromAddress(again) == Process.fromAddress(counter)));
    Io.println("now rename the desk");
    let _ = Io.readLine();
    Io.println("renamed: "
                   <> Io.show(Address.call(again,
                                           fn(reply) = Counter.Get(reply = reply),
                                           Harness.waitMs())));
    Io.println("now refuse a reload");
    let _ = Io.readLine();
    Io.println("refused: "
                   <> Io.show(Address.call(again,
                                           fn(reply) = Counter.Get(reply = reply),
                                           Harness.waitMs())))
}

// Report §8.7, Appendix E.27, G.4: a compute on a peer the desk picks, of
// its peers the store alone telling it its utilization, the peer gone never
// reached: Unreachable before any has told one, no connection yet open;
// once the store has told its utilization, which it does as the spawn of
// the readings' check connects them, on the store, its value the peers of
// the node it ran on, the store the one peer the desk holds a utilization
// of; and the readings of the host's services, which the store runs and the
// desk does not.
fn placed(interval : Int) : Unit receiving Msg = {
    Io.println("before a telling: "
                   <> Io.show(Peer.compute(fn() = Peer.peers(), Harness.waitMs())));
    Io.println("readings: " <> started(Placing.readingsOn("store")));
    Placing.heard("store", interval);
    Io.println("computed: " <> Io.show(Peer.compute(fn() = Peer.peers(), Harness.waitMs())));
    Io.println("held: " <> Io.show(List.map(Peer.utilizations(), fn(#(name, _, _)) = name)));
    Io.println("readings here: " <> Placing.readings())
}

// Report §8.7, the proposal's section 4: what a silence ends and what it
// leaves. Before it, ten thousand messages arrive, none lost and none twice.
// The test stops the store when the desk says so and tells the desk on its
// standard input; the desk then waits, with a monitor on the store's
// counter, a call and a callForever waiting on the store's sleeper, and a
// process of its own, until the detector gives the store up, and says how
// long that took. Once the test has let the store run again, the counter's
// address reaches it again.
fn silenced() : Unit receiving Msg = {
    let counter = Shared.found(Counter.service);
    let sleeper = Shared.found(Calls.sleeper);
    // Report §8.7: a silence is found at most 75 seconds after the last
    // traffic; the sleeper's sleep and its callers' time outlast that and
    // the test's two steps around it, the desk's word to stop the store and
    // its word after the loss, so that only the loss ends the calls
    let outlasting = 75000 + 2 * Harness.waitMs();
    List.forEach(List.range(1, 10000), fn(_) = send(counter, Counter.Add(1)));
    Io.println("counted: "
                   <> Io.show(Address.call(counter,
                                           fn(reply) = Counter.Get(reply = reply),
                                           Harness.waitMs())));
    let local = spawn(fn() : Unit receiving Counter.Msg = counted(0));
    monitor(Process.fromAddress(counter), Died);
    let caller = spawnMonitored(fn() = {
                                    let answer =
                                        Address.call(sleeper,
                                                     fn(reply) =
                                                         Calls.Slow(ms = outlasting, reply = reply),
                                                     outlasting);
                                    Io.println("the call: " <> Io.show(answer))
                                },
                                Died);
    let forever = spawnMonitored(fn() = {
                                     let _ =
                                         Address.callForever(sleeper,
                                                             fn(reply) =
                                                                 Calls.Slow(ms = outlasting,
                                                                            reply = reply));
                                     Unit
                                 },
                                 Died);
    Io.println("now stop the store");
    let _ = Io.readLine();
    let stopped = Clock.monotonic();
    let downs = [received(), received(), received()];
    Io.println("given up after: " <> Int.toString((Clock.monotonic() - stopped) / 1000));
    shown("silent", downs, Process.fromAddress(counter));
    shown("its caller", downs, Process.fromAddress(caller));
    shown("its forever caller", downs, Process.fromAddress(forever));
    Io.println("own process: "
                   <> Io.show(Address.call(local,
                                           fn(reply) = Counter.Get(reply = reply),
                                           Harness.waitMs())));
    Io.println("now let the store run");
    let _ = Io.readLine();
    Io.println("again: "
                   <> Io.show(Address.call(counter,
                                           fn(reply) = Counter.Get(reply = reply),
                                           Harness.waitMs())))
}

fn received() : Down receiving Msg =
    receive {
        Died(down) -> down
    }

// How the process ended, by the one of the Downs that names it.
fn shown(what : String, downs : List(Down), process : Process) : Unit =
    match List.find(downs, fn(down) = down.process == process) {
        Some(down) -> Io.println(what <> ": " <> Io.show(down.reason) <> " " <> Io.show(down.site))
      | None -> Io.println(what <> ": no Down")
    }

// A counter of the desk's own, which a loss of the store leaves alone.
fn counted(total : Int) : Unit receiving Counter.Msg =
    receive {
        Counter.Add(amount) ->
            counted(total + amount)
      | Counter.Get(reply = reply) -> {
            answer(reply, total);
            counted(total)
        }
    }

// Report §8.7, the proposal's section 7: a find whose dial nothing answers,
// the store's address a proxy that takes the connection and passes nothing,
// is given up by the host after 7 seconds, and the find answers Unreachable
// and not Timeout.
fn dialed() : Unit = {
    // Report §8.7: the milliseconds after which the host gives up a dial
    // that nothing answers; the find's time is longer by the test's time
    // for one step, so that the dial is given up before the time runs out
    let dialGivenUp = 7000;
    let started = Clock.monotonic();
    let found = Peer.find(Counter.service, dialGivenUp + Harness.waitMs());
    Io.println("dialed: "
                   <> Io.show(found)
                   <> " after "
                   <> Int.toString((Clock.monotonic() - started) / 1000))
}

// The proposal's section 9, `make bench`: the microseconds of the host's
// round trip to the store, of a call to a process there and to one here,
// of a message to the store's counter, sent straight and through the
// adapted address made on the store, of a find of the counter, of a spawn
// there of a process that ends at once, of a compute there of a function
// that answers at once, and of a utilization of the store, each over many,
// a line each.
fn costs() : Unit receiving Msg = {
    let counter = Shared.found(Counter.service);
    let brittle = Shared.found(Calls.brittle);
    let echo = Shared.found(Counter.echo);
    let echoAdapted = Shared.found(Counter.echoAdapted);
    let local = spawn(fn() : Unit receiving Counter.Msg = counted(0));
    let rounds = 5000;
    Io.println("ping " <> Io.show(pings(Process.fromAddress(counter), rounds)));
    Io.println("remote-call "
                   <> Io.show(timed(rounds, fn() = {
                       let _ =
                           Address.call(brittle,
                                        fn(reply) = Calls.Echo(n = 1, reply = reply),
                                        Harness.waitMs());
                       Unit
                   })));
    Io.println("local-call "
                   <> Io.show(timed(rounds, fn() = {
                       let _ =
                           Address.call(local,
                                        fn(reply) = Counter.Get(reply = reply),
                                        Harness.waitMs());
                       Unit
                   })));
    Io.println("straight " <> Io.show(echoed(rounds, fn(back) = send(echo, Counter.Ping(back)))));
    Io.println("adapted " <> Io.show(echoed(rounds, fn(back) = send(echoAdapted, back))));
    Io.println("find "
                   <> Io.show(timed(rounds, fn() = {
                       let _ = Peer.find(Counter.service, Harness.waitMs());
                       Unit
                   })));
    Io.println("spawn "
                   <> Io.show(timed(rounds, fn() = {
                       let _ = Work.idleOn("store", Harness.waitMs());
                       Unit
                   })));
    Io.println("compute "
                   <> Io.show(timed(rounds, fn() = {
                       let _ = Peer.computeAt("store", fn() = 1, Harness.waitMs());
                       Unit
                   })));
    Io.println("utilization "
                   <> Io.show(timed(rounds, fn() = {
                       let _ = Peer.utilization("store", Harness.waitMs());
                       Unit
                   })))
}

// The microseconds of one run of the function, over as many runs.
fn timed(rounds : Int, f : () -> Unit receiving Msg) : Float receiving Msg = {
    let started = Clock.monotonic();
    List.forEach(List.range(1, rounds), fn(_) = f());
    Int.toFloat(Clock.monotonic() - started) * 1000.0 / Int.toFloat(rounds)
}

// The microseconds of a round trip to the store's echo, each a message
// there, sent as the function sends it, and its answer back, over as many,
// by a process of its own, whose end the desk waits for.
fn echoed(rounds : Int, ping : (Address(Int)) -> Unit receiving Int) : Float receiving Msg = {
    let started = Clock.monotonic();
    let _ = spawnMonitored(fn() : Unit receiving Int = pinged(rounds, ping), Died);
    let _ = received();
    Int.toFloat(Clock.monotonic() - started) * 1000.0 / Int.toFloat(rounds)
}

fn pinged(left : Int, ping : (Address(Int)) -> Unit receiving Int) : Unit receiving Int =
    if left == 0 then
        Unit
    else {
        ping(self());
        receive {
            _ -> pinged(left - 1, ping)
        }
    }

foreign fn pings(process : Process, count : Int) : Float =
    "ern_peers_host:pings/2"

// Report §8.7: computes on the store: the value back; a name that is no
// peer's; a function whose binding has no value there; a fault in the
// function, the caller's, which this node reports once, the stack that
// crossed with it beneath, and the store not at all; a process killed
// before it answers; one whose caller ends while it waits, and one whose
// time runs out, each killed on the store, whose watcher says so; and,
// last, one that ends with the store's program, once the test has stopped
// the store.
fn computes() : Unit receiving Msg = {
    Process.faults(Reported);
    Io.println("value: " <> Io.show(Peer.computeAt("store", fn() = 6 * 7, Harness.waitMs())));
    Io.println("not listed: " <> Io.show(Peer.computeAt("nobody", fn() = 6 * 7, Harness.waitMs())));
    Io.println("not loaded: " <> Io.show(Peer.computeAt("store", Lonely.speak, Harness.waitMs())));
    faulted("divided", fn() = {
        let _ = Peer.computeAt("store", fn() = 1 / List.size([]), Harness.waitMs());
        Unit
    });
    reported();
    faulted("raised", fn() = {
        let _ = Peer.computeAt("store", fn() = toInteger("x"), Harness.waitMs());
        Unit
    });
    reported();
    let killed =
        Peer.computeAt("store",
                       fn() : Int receiving Int = {
                           kill(self());
                           receive {
                               n -> n
                           }
                       },
                       Harness.waitMs());
    Io.println("killed: " <> Io.show(killed));
    let watcher = Shared.found(Counter.watcher);
    let me = self();
    let abandoned = spawn(fn() = {
        let _ =
            Peer.computeAt("store",
                           fn() : Int receiving Int = {
                               watchedBy(watcher, "the abandoned compute's process");
                               send(me, Started("abandoned"));
                               receive {
                                   n -> n
                               }
                           },
                           Harness.waitMs());
        Unit
    });
    receive {
        Started(label) when label == "abandoned" -> kill(abandoned)
    };
    timedOut(watcher, 1);
    // the store's stop ends the last compute, which the test makes after
    // this desk's word: its time outlasts the test's steps that remain once
    // it began, at most four, the store's two lines, this desk's word and
    // the store's stop
    let outlasting = 4 * Harness.waitMs();
    let _ = spawnMonitored(fn() = {
                               let ended =
                                   Peer.computeAt("store",
                                                  fn() : Int receiving Int = {
                                                      send(me, Started("ending"));
                                                      receive {
                                                          n -> n
                                                      }
                                                  },
                                                  outlasting);
                               Io.println("with the store's end: " <> Io.show(ended))
                           },
                           Died);
    receive {
        Started(label) when label == "ending" -> Io.println("now stop the store")
    };
    ended("ending")
}

// The fault this node's subscriber was told of, its site, its cause and
// whether a trace came with it.
fn reported() : Unit receiving Msg =
    receive {
        Reported(report) ->
            Io.println("reported here: "
                           <> report.site
                           <> " "
                           <> report.cause
                           <> " "
                           <> Io.show(report.trace != ""))
    }

// The process running the function on the store watched there under the
// label once it says so.
fn watchedBy(watcher : Address(Counter.WatcherMsg), label : String) : Unit receiving m = {
    let process = Process.fromAddress(self());
    Address.callForever(watcher,
                        fn(reply) = Counter.Watch(process = process, label = label, reply = reply))
}

// A compute whose time runs out, given twice the time at each try until its
// process has started on the store before the time ran out, as its word here
// says: the start is what the time waits for, and no time is chosen. Each
// process that started is killed there, and the store's watcher says so.
fn timedOut(watcher : Address(Counter.WatcherMsg), ms : Int) : Unit receiving Msg = {
    let me = self();
    let late =
        Peer.computeAt("store",
                       fn() : Int receiving Int = {
                           watchedBy(watcher, "the timed-out compute's process");
                           send(me, Started("timed out"));
                           receive {
                               n -> n
                           }
                       },
                       ms);
    receive {
        Started(label) when label == "timed out" -> Io.println("timed out: " <> Io.show(late))
      | after 0 -> timedOut(watcher, ms * 2)
    }
}

foreign fn toInteger(text : String) : Int =
    "erlang:binary_to_integer/1"

// Report §8.7: how busy the store is, as its configuration measures it:
// the schedulers' time at its start, from 0.0 to 1.0, which the host keeps
// there; then the run queue, from the next ask after the reload that names
// it, 0.0 or more, the host keeping the schedulers' time no longer; and,
// after a reload refused, the run queue still.
fn utilizations() : Unit = {
    Io.println("not listed: " <> Io.show(Peer.utilization("nobody", Harness.waitMs())));
    Io.println("schedulers: "
                   <> Io.show(#(fraction(Peer.utilization("store", Harness.waitMs())),
                                fraction(Peer.utilization("store", Harness.waitMs())))));
    keeps("at the start");
    Io.println("now measure the run queue");
    let _ = Io.readLine();
    Io.println("run queue: " <> Io.show(waiting(Peer.utilization("store", Harness.waitMs()))));
    keeps("after the reload");
    Io.println("now refuse a reload");
    let _ = Io.readLine();
    Io.println("after the refusal: "
                   <> Io.show(waiting(Peer.utilization("store", Harness.waitMs()))))
}

// Whether the answer is a fraction from 0.0 to 1.0.
fn fraction(answer : Either(Io.Error, Float)) : Bool =
    match answer {
        Right(utilization) -> utilization >= 0.0 && utilization <= 1.0
      | Left(_) -> false
    }

// Whether the answer is 0.0 or more.
fn waiting(answer : Either(Io.Error, Float)) : Bool =
    match answer {
        Right(utilization) -> utilization >= 0.0
      | Left(_) -> false
    }

// Whether the host keeps the schedulers' time on the store, which the store
// says, a spawn there asking.
fn keeps(moment : String) : Unit = {
    let _ =
        Peer.spawn("store",
                   fn() =
                       Io.println("the store keeps the schedulers' time "
                                      <> moment
                                      <> ": "
                                      <> Io.show(statistic(Foreign.atom("scheduler_wall_time"))
                                                     != Foreign.atom("undefined"))),
                   Harness.waitMs());
    Unit
}

foreign fn statistic(item : Foreign.Term) : Foreign.Term =
    "erlang:statistics/1"

// Report §6.5, §8.7: an adapted address made on the store whose function
// calls a gate there, which answers once a message through a second
// adapted address made there opens it: each function runs on the store in
// a process of its own, so the second message and a find pass the first,
// and what the gate answers comes here through the first.
fn gatedPasses() : Unit receiving Int = {
    let opener = Shared.found(Counter.opener);
    let through = gated(self());
    send(through, 5);
    Io.println("found meanwhile: " <> started(Peer.find(Counter.opener, Harness.waitMs())));
    send(opener, Unit);
    receive {
        n -> Io.println("through the gate: " <> Int.toString(n))
    }
}

// An adapted address of the target, made on the store, whose function
// calls the store's gate.
fn gated(target : Address(Int)) : Address(Int) =
    Address.callForever(Shared.found(Counter.gated),
                        fn(reply) = Counter.Adapt(target = target, reply = reply))
