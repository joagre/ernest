// Report §8.6, §8.7: finds the counter while its node's end waits, adds to
// it and asks it.

export fn main() : Unit =
    match Peer.find(Counter.service, Harness.waitMs()) {
        Right(counter) -> {
            send(counter, Counter.Add(3));
            let total = Address.call(counter, Counter.Get, Harness.waitMs());
            Io.println("asked: " <> Io.show(total))
        }
      | Left(failure) ->
            Io.println("asked: " <> Io.show(failure))
    }
