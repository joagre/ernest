// Report §8.7, Appendix G.4: the readings the host's services give on a
// node, which its measures run, and the wait for a peer's telling; a module
// with no binding, so that its spawns run on any peer that has the build.

// Whether each of the host's services, cpu, memory and disk, answers a
// reading on the peer, which writes it to its standard output.
export fn readingsOn(name : String) : Either(Io.Error, Address(Never)) with m =
    Peer.spawn(name, fn() : Unit with Never = Io.println("readings there: " <> readings()), 5000)

export fn readings() : String with m =
    Io.show(#(answers(Utilization.cpu()),
              answers(Utilization.memory()),
              answers(Utilization.disk())))

fn answers(reading : Optional(Float)) : Bool =
    match reading {
        Some(fraction) -> fraction >= 0.0 && fraction <= 1.0
      | None -> false
    }

// Report §8.7: until the node holds a utilization of the peer named, the
// utilizations read again every interval, the time between the peer's
// tellings, at which alone the table changes; a wait no message can show,
// since a telling is the runtime's frame and no program's.
export fn heard(name : String, interval : Int) : Unit with m =
    if List.any(Peer.utilizations(), fn(#(peer, _, _)) = peer == name) then
        Unit
    else receive {
        after interval -> heard(name, interval)
    }
