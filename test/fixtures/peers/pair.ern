// Report §8.7, §11.2, Appendix E.23, G.6, G.7: a program's own test of two
// nodes, and of two builds. `ern test --config-dir a` runs its tests as the
// node `a`, in the directory the harness made: `a` and `b`, each made by
// `ern config`, `a` listing `b` under the service `pair`; the build, and a
// second build of this module whose `Msg` has another constructor; and
// `pair.json`, which names the port `b` listens on, the load path `a` was
// started with and each build's file. Each test writes `b`'s
// `ernest.conf`, listing `a`, starts `b` with `Os`, on the same build or on
// the second, waits for it to offer its service, finds it through
// `Peer.find`, or through a proxy, and calls it where the find
// answers it, and ends it with `ern stop`.

export type Msg = Double(n : Int, reply : Reply(Int))

export let service : Peer.Service(Msg) = Peer.service("pair")

// The second node's program: its entry process offers itself as the
// service, says so on its standard output, and serves.
export fn main() : Unit with Msg = {
    let _ = Peer.offer(service, self());
    Io.println("offered");
    serve()
}

fn serve() : Unit with Msg =
    receive {
        Double(n = n, reply = reply) -> {
            answer(reply, 2 * n);
            serve()
        }
    }

//
// The tests (report §9.3), run on the first node.
//

// What a monitor of a process says of its end.
type Ended = Ended(Down)

let twoNodes =
    Test.Case(name = "a second node made, started with Os, found, called and stopped",
              run = fn() = Test.equal(withSecondNode("build"), Right(#("Some(42)", 143))))

// Report §8.7: a service names its type by its hash, so a node of the
// second build, whose Msg has another constructor, offers the service at
// another type.
let twoBuilds =
    Test.Case(name = "a second node of another build, started with Os, offers at another type",
              run = fn() = Test.equal(withSecondNode("second-build"), Right(#("OtherType", 143))))

// Appendix G.7: a proxy for the service, where the second node
// offers it at another type, faults at the first message, which finds the
// service: the call that sent it answers None, the process's monitor reads the
// fault, and a call after it answers None at once, the address dead. The
// proxy is started, and its process monitored, before the second node
// runs, so that the monitor is made before the fault.
let proxyAtAnotherType =
    Test.Case(name = "a proxy for a service offered at another type faults, and is dead",
              run = fn() = {
                  let ended = Io.show(Fault("the service pair is offered at another type"));
                  Test.equal(proxyAgainst("second-build"), Right(#("None", ended, "None", 143)))
              })

// What the second node answered, a call's answer where the find gave its
// address and the find's failure otherwise, and the status it ended with;
// its program the file `pair.json` names under Build.
fn withSecondNode(build : String) : Either(String, #(String, Int)) with m = {
    let program <- started(build);
    let answered = match Peer.find(service, 10000) {
        Right(address) ->
            Io.show(Address.call(address, fn(reply) = Double(n = 21, reply = reply), 10000))
      | Left(failure) -> Io.show(failure)
    };
    let status <- stopped(program);
    Right(#(answered, status))
}

// What a call through a proxy for the service answered once the second
// node ran, how the proxy's process ended, what a call answered
// after that, and the status the second node ended with; each wait's time
// bounds a failure, and no success waits on it.
fn proxyAgainst(build : String) : Either(String, #(String, String, String, Int)) with Ended = {
    let proxy = Proxy.start(service, 10000);
    monitor(Process.fromAddress(proxy), Ended);
    let program <- started(build);
    let first = Address.call(proxy, fn(reply) = Double(n = 21, reply = reply), 10000);
    let ended = receive {
        Ended(down) -> Io.show(down.reason)
      | after 30000 -> "no end"
    };
    let second = Address.call(proxy, fn(reply) = Double(n = 21, reply = reply), 10000);
    let status <- stopped(program);
    Right(#(Io.show(first), ended, Io.show(second), status))
}

// The second node started on the build the file `pair.json` names under
// Build, listing the first, once it has offered its service.
fn started(build : String) : Either(String, Address(Os.ProgramMsg)) with m = {
    let settings <- readJson(["pair.json"]);
    let port <- Either.andThen(member(settings, "port"), integer);
    let loadPath <- Either.andThen(member(settings, "load-path"), texts);
    let file <- Either.andThen(member(settings, build), text);
    let first <- readJson(["a", "ernest.conf"]);
    let firstKey <- member(first, "public-key");
    let firstAddress <- member(first, "listen");
    let second <- readJson(["b", "ernest.conf"]);
    let secondKey <- member(second, "public-key");
    let peer =
        Json.Object(Map.fromList([#("name", Json.Text("a")),
                                  #("network-address", firstAddress),
                                  #("public-key", firstKey)]));
    let conf =
        Json.Object(Map.fromList([#("listen", Json.Text("127.0.0.1:" <> Int.toString(port))),
                                  #("public-key", secondKey),
                                  #("peers", Json.Array([peer]))]));
    let _ <- written(["b", "ernest.conf"], Json.format(conf));
    let arguments = List.flatMap(loadPath, fn(directory) = ["--load-path", directory]);
    let program <-
        shown(Os.start(Os.Command(program = "ern",
                                  arguments = ["run", "--config-dir", "b"] <> arguments <> [file],
                                  input = <<>>)));
    let _ <- said(program, String.toUtf8("offered"), <<>>);
    Right(program)
}

// The status the second node ended with, stopped by `ern stop`.
fn stopped(program : Address(Os.ProgramMsg)) : Either(String, Int) with m = {
    let stop = Os.Command(program = "ern", arguments = ["stop", "--config-dir", "b"], input = <<>>);
    let _ <- shown(Os.run(stop, 10000));
    ended(program)
}

// The JSON a file of the working directory holds.
fn readJson(path : List(String)) : Either(String, Json.Value) with m = {
    let bytes <- shown(Fs.read(Path.join(path), 10000));
    let text <-
        Either.fromOptional(String.fromUtf8(bytes),
                            Path.toString(Path.join(path)) <> " is not UTF-8");
    shown(Json.parse(text))
}

fn written(path : List(String), text : String) : Either(String, Unit) with m =
    shown(Fs.write(Path.join(path), String.toUtf8(text), 10000))

fn member(value : Json.Value, name : String) : Either(String, Json.Value) =
    match value {
        Json.Object(members) -> Either.fromOptional(Map.get(members, name), "no " <> name)
      | other -> Left("not an object: " <> Io.show(other))
    }

fn integer(value : Json.Value) : Either(String, Int) =
    match value {
        Json.Integer(int) -> Right(int)
      | other -> Left("not an integer: " <> Io.show(other))
    }

fn text(value : Json.Value) : Either(String, String) =
    match value {
        Json.Text(found) -> Right(found)
      | other -> Left("not a string: " <> Io.show(other))
    }

fn texts(value : Json.Value) : Either(String, List(String)) =
    match value {
        Json.Array(values) -> List.tryMap(values, fn(element) = match element {
            Json.Text(text) -> Right(text)
          | other -> Left("not a string: " <> Io.show(other))
        })
      | other -> Left("not an array: " <> Io.show(other))
    }

fn shown(either : Either(e, a)) : Either(String, a) needs e.show =
    Either.mapLeft(either, fn(error) = Io.show(error))

// Until the program has written the bytes on its standard output; each
// read's time bounds a failure, and no success waits on it.
fn said(program : Address(Os.ProgramMsg),
        bytes : Bytes,
        seen : Bytes) : Either(String, Unit) with m =
    if Bytes.contains(seen, bytes) then
        Right(Unit)
    else match Os.read(program, 30000) {
        Right(Os.Stdout(more)) -> said(program, bytes, seen <> more)
      | Right(Os.Stderr(_)) -> said(program, bytes, seen)
      | Right(Os.Exited(status)) -> Left("the second node ended with " <> Int.toString(status))
      | Left(error) -> Left(Io.show(error))
    }

// The status the program ended with, once its output has ended.
fn ended(program : Address(Os.ProgramMsg)) : Either(String, Int) with m =
    match Os.read(program, 30000) {
        Right(Os.Exited(status)) -> Right(status)
      | Right(_) -> ended(program)
      | Left(error) -> Left(Io.show(error))
    }
