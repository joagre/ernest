// Report §8.7: the store, which offers a counter, an adapted address of it,
// a process to be killed, a census of its atoms, two slots, a fragile
// process behind an adapted address whose function faults, an adapter
// that makes adapted addresses here, and one whose addresses' function
// calls a gate here, with an adapted address that opens it, the services
// the desk calls, a herald whose restarts the desk watches, with the slot
// it finds its watcher in, and a watcher of the processes the desk's
// computes start here; says each fault its subscriber of faults is told
// of; and waits.

// Restarting, its window the scenario's: no test faults the counter.
let counter : Address(Counter.Msg) =
    spawn(restarting(RestartLimit(restarts = 3, within = 5000), fn() = count(0)))

fn count(total : Int) : Unit receiving Counter.Msg =
    receive {
        Counter.Add(amount) ->
            count(total + amount)
      | Counter.Get(reply = reply) -> {
            answer(reply, total);
            count(total)
        }
    }

export fn main() : Unit receiving Unit = {
    Io.println("the store's peers: " <> Io.show(Shared.listed()));
    let me = self();
    let _ = spawn(fn() : Unit receiving Process.FaultReport = {
        Process.faults(fn(report) = report);
        send(me, Unit);
        reports()
    });
    receive {
        _ -> Unit
    };
    let _ = Peer.offer(Counter.service, counter);
    let _ = Peer.offer(Counter.adder, adapted(counter, fn(n) = Counter.Add(n)));
    let _ = Peer.offer(Counter.victim, spawn(fn() : Unit receiving Int = receive {
        _ -> Unit
    }));
    let _ = Peer.offer(Census.service, spawn(fn() = Census.serve()));
    let _ = Peer.offer(Counter.counterSlot, spawn(fn() = Slot.serve(None)));
    let _ = Peer.offer(Counter.echoSlot, spawn(fn() = Slot.serve(None)));
    let fragile = spawn(fn() : Unit receiving Int = receive {
        _ -> Unit
    });
    let _ = Peer.offer(Counter.fragile, fragile);
    let _ =
        Peer.offer(Counter.strict,
                   adapted(fragile, fn(n) = if n < 0 then fault("negative") else n));
    // the scenario's restarts, more than the requests that fault it, which
    // come within the window
    let _ =
        Peer.offer(Calls.brittle,
                   spawn(restarting(RestartLimit(restarts = 10, within = 60000),
                                    fn() = Calls.serve())));
    // the herald's restarts, more than the scenario's two faults, which
    // come within the window
    let heraldSlot = spawn(fn() = Slot.serve(None));
    let _ = Peer.offer(Herald.watcherSlot, heraldSlot);
    let _ =
        Peer.offer(Herald.service,
                   spawn(restarting(RestartLimit(restarts = 3, within = 60000),
                                    fn() = Herald.run(heraldSlot))));
    let _ = Peer.offer(Calls.sleeper, spawn(fn() = Calls.serve()));
    let _ = Peer.offer(Calls.doomed, spawn(fn() = Calls.serve()));
    let echoer = spawn(fn() : Unit receiving Counter.EchoMsg = echoes());
    let _ = Peer.offer(Counter.echo, echoer);
    let _ = Peer.offer(Counter.echoAdapted, adapted(echoer, fn(back) = Counter.Ping(back)));
    let _ = Peer.offer(Counter.adapter, spawn(fn() = adapts()));
    let gate = spawn(fn() = closed());
    let _ = Peer.offer(Counter.gated, spawn(fn() = gates(gate)));
    let _ = Peer.offer(Counter.opener, adapted(gate, fn(_) = Counter.Open));
    let _ = Peer.offer(Counter.watcher, spawn(fn() = watching()));
    Io.println("offered");
    wait()
}

// Each fault of the store's processes, as its subscriber is told of it.
fn reports() : Unit receiving Process.FaultReport =
    receive {
        report -> {
            Io.println("the store's subscriber: " <> report.cause);
            reports()
        }
    }

// The processes the desk's computes start here, each monitored once it
// says so, before it is answered, and how each ended.
fn watching() : Unit receiving Counter.WatcherMsg =
    receive {
        Counter.Watch(process = process, label = label, reply = reply) -> {
            monitor(process, fn(down) = Counter.Ended(label = label, down = down));
            answer(reply, Unit);
            watching()
        }
      | Counter.Ended(label = label, down = down) -> {
            Io.println(label <> " ended: " <> Io.show(down.reason));
            watching()
        }
    }

// Until the node is stopped: a node waiting for ever is no deadlock.
fn wait() : Unit receiving Unit =
    receive {
        _ -> wait()
    }

fn adapts() : Unit receiving Counter.AdapterMsg =
    receive {
        Counter.Adapt(target = target, reply = reply) -> {
            answer(reply, adapted(target, fn(n) = n * 2));
            adapts()
        }
    }

// Each address the desk gives answered with an adapted address of it made
// here, whose function calls the gate and passes on what the gate answers.
fn gates(gate : Address(Counter.GateMsg)) : Unit receiving Counter.AdapterMsg =
    receive {
        Counter.Adapt(target = target, reply = reply) -> {
            answer(reply, adapted(target, fn(n) = passed(gate, n)));
            gates(gate)
        }
    }

fn passed(gate : Address(Counter.GateMsg), n : Int) : Int =
    Address.callForever(gate, fn(reply) = Counter.Pass(n = n, reply = reply))

// The gate, which answers no call until it is opened, and then each with
// ten times what it carries.
fn closed() : Unit receiving Counter.GateMsg =
    receive {
        Counter.Open -> opened()
    }

fn opened() : Unit receiving Counter.GateMsg =
    receive {
        Counter.Pass(n = n, reply = reply) -> {
            answer(reply, n * 10);
            opened()
        }
      | Counter.Open ->
            opened()
    }

fn echoes() : Unit receiving Counter.EchoMsg =
    receive {
        Counter.Ping(back) -> {
            send(back, 1);
            echoes()
        }
    }
