// Report §8.7: functions a peer spawns, of a module with no binding, which
// no program of the store depends on.

fn square(n : Int) : Unit =
    Io.println("the store squares " <> Int.toString(n * n))

export fn squareOn(name : String, n : Int, ms : Int) : Either(Io.Error, Address(Never)) =
    Peer.spawn(name, fn() = square(n), ms)

export fn watchedOn(name : String,
                    wrap : (Down) -> m,
                    ms : Int) : Either(Io.Error, Address(Never)) receiving m =
    Peer.spawnMonitored(name, fn() = Unit, wrap, ms)

// A process that ends at once, whose spawn `make bench` times.
export fn idleOn(name : String, ms : Int) : Either(Io.Error, Address(Never)) =
    Peer.spawn(name, fn() = Unit, ms)
