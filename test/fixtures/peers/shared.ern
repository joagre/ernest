// Report §8.7: a binding both nodes' programs depend on, whose value is each
// node's own.

let peers : List(String) = Peer.peers()

export fn listed() : List(String) =
    peers

export fn tellPeers(name : String) : Either(Io.Error, Address(Never)) =
    Peer.spawn(name, fn() = Io.println("the peers here: " <> Io.show(peers)), Harness.waitMs())

export fn found(service : Peer.Service(m)) : Address(m) =
    match Peer.find(service, Harness.waitMs()) {
        Right(address) -> address
      | Left(failure) -> fault(Io.show(failure))
    }
