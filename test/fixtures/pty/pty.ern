//
// The pseudo-terminal harness of the shell's and the terminal's tests
//
// Runs a command under a terminal of its own, sends it bytes once the
// screen shows that it is ready for them, and hands back what it wrote,
// for test/ern_pty.erl, which runs it (report §12.1, Appendix E.23):
//
//     ern run build/pty/pty.erc --timeout MS [--size ROWSxCOLUMNS] [--screen]
//         [--step STEP]... -- COMMAND
//
// COMMAND runs as `/bin/sh -c COMMAND`, under `Os.startTerminal` of the
// size, 24x80 where none is given. Each STEP is one argument, the steps
// run in the order given:
//
//     expect:TEXT   wait until TEXT shows, after what the previous expect
//                   matched; a color sequence, ESC [ ... m, is no part of
//                   the text, as a reader does not see it
//     send:HEX      write those bytes to the terminal
//     resize:RxC    give the terminal a new size, as a window manager does
//     put:PATH      open the named pipe PATH for writing and close it,
//                   once the program has opened it for reading, which ends
//                   the read of it that the program waits in
//     hangup        hang the terminal up, as closing its window does: the
//                   program's read of it ends, and it is sent the hangup,
//                   nothing it writes after arriving
//
// Each wait is bounded by MS milliseconds of its own, the caller's time for
// one wait, so that a wait that fails is told by its own bound: an expect met
// begins the next wait, and a send, a resize, a put, a hangup and the
// program's end share the wait in progress. A program that has not exited within it is
// killed, and with it the processes still in its process group.
//
// Two lines are printed: `status` and the program's exit status, 128 and
// the signal's number for one a signal ended, or `timeout`; and `data` and
// what the program wrote, in base 64, or with --screen the screen as a
// reader sees it, the writes played onto a grid of the size. The steps not
// met are named on standard error, `unmet` and their kinds.
//
// One process reads the program and forwards each piece to the harness's
// mailbox as it comes, so that the program's output is taken whatever the
// harness waits on, a write, a put or the time; the harness waits in a
// `receive` whose `after` is what is left of the wait in progress. A put
// runs `sh` in a process of its own, whose open of the pipe waits until the
// program has opened it, and which says how the open went.
//

type Step = Expect(Bytes) | Send(Bytes) | Resize(Terminal.Size) | Put(String) | Hangup

type Options =
    Options(size : Terminal.Size, screen : Bool, steps : List(Step), command : List(String))

// What the harness is told: by the reader, a piece the program wrote, its
// exit status, or a read the runtime refused; by a put, whether it opened
// the pipe.
type HarnessMsg = Wrote(Bytes) | Ended(Int) | Unread(Io.Error) | Opened | Unopened

// What the terminal has shown: every byte, `seen`; the text a reader sees,
// `plain`, without the sequences that only color it, a sequence a piece
// cut short held in `partial` for the next; and how far the expects have
// read the text, `cursor`.
type Screen = Screen(seen : Bytes, plain : Bytes, partial : Bytes, cursor : Int)

// A run of the command: its program, the milliseconds of one wait, the
// moment the wait in progress ends, as Clock.monotonic counts it, the
// screen, and the exit status once the program has exited.
type Run =
    Run(program : Address(Os.ProgramMsg),
        ms : Int,
        deadline : Int,
        screen : Screen,
        status : Optional(Int))

// A step taken, met or not, with the run as the step left it.
type Stepped = Met(Run) | Unmet(Run)

// A control sequence's parameters as its bytes begin with them, the digits
// and `;`s: the first two read as numbers, each None where it is not
// written, and the bytes after them all.
type Parameters = Parameters(first : Optional(Int), second : Optional(Int), rest : Bytes)

// A screen as the writes leave it: its size; the characters written, each
// line's by its column, the lines by their number from the first the
// screen showed, its top row showing the line `top`; and the cursor's row
// and column on the screen.
type Grid =
    Grid(size : Terminal.Size, cells : Map(Int, Map(Int, Char)), top : Int, row : Int, column : Int)

export fn main() : Unit receiving HarnessMsg =
    match parsed(Os.arguments, None, defaults) {
        Some(#(ms, options)) -> drive(options, ms)
      | None -> fail(usage)
    }

let defaults =
    Options(size = Terminal.Size(rows = 24, columns = 80), screen = false, steps = [], command = [])

let usage =
    "usage: ern run pty.erc --timeout MS [--size ROWSxCOLUMNS] [--screen] [--step STEP]..."
        <> " -- COMMAND, a STEP expect:TEXT, send:HEX, resize:RxC, put:PATH or hangup"

// The milliseconds of one wait, which `--timeout` gives, and the options
// the rest of the command line gives, the steps in the order given and the
// words after `--` the command; None for a command line that is no
// harness's, one without `--timeout` among them. The caller gives each wait
// its time, which the harness does not choose.
fn parsed(arguments : List(String),
          timeout : Optional(Int),
          options : Options) : Optional(#(Int, Options)) =
    match arguments {
        "--timeout" :: text :: rest -> {
            let ms <- String.toInt(text);
            parsed(rest, Some(ms), options)
        }
      | "--size" :: text :: rest -> {
            let size <- sizeOf(text);
            parsed(rest, timeout, Options(..options, =size))
        }
      | "--screen" :: rest ->
            parsed(rest, timeout, Options(..options, screen = true))
      | "--step" :: text :: rest -> {
            let step <- stepOf(text);
            parsed(rest, timeout, Options(..options, steps = options.steps <> [step]))
        }
      | "--" :: command -> {
            let ms <- timeout;
            Some(#(ms, Options(..options, =command)))
        }
      | _ ->
            None
    }

// A size written as its rows, `x` and its columns, `24x80`.
fn sizeOf(text : String) : Optional(Terminal.Size) = {
    let #(rowsText, columnsText) <- String.splitOnce(text, "x");
    let rows <- String.toInt(rowsText);
    let columns <- String.toInt(columnsText);
    Some(Terminal.Size(=rows, =columns))
}

// The step an argument names, its kind, `:` and what it takes.
fn stepOf(argument : String) : Optional(Step) =
    match String.splitOnce(argument, ":") {
        Some(#("expect", text)) -> Some(Expect(String.toUtf8(text)))
      | Some(#("send", hex)) -> Optional.map(Bytes.fromHex(hex), Send)
      | Some(#("resize", size)) -> Optional.map(sizeOf(size), Resize)
      | Some(#("put", path)) -> Some(Put(path))
      | None when argument == "hangup" -> Some(Hangup)
      | _ -> None
    }

// A line on standard error, and the harness's end with the status 2, as
// for a command line it cannot read.
fn fail(text : String) : a = {
    Io.printlnError("pty: " <> text);
    Os.exit(2)
}

//
// The run
//

// Report Appendix E.23: the command run under a terminal of the size, its
// steps taken, its end waited for, and the lines printed. A program that
// has not exited within the wait is killed, and with it the processes
// still in its process group, the reader first, whose read would fault on
// the killed program.
fn drive(options : Options, ms : Int) : Unit receiving HarnessMsg = {
    let command = Os.command("/bin/sh", ["-c", String.join(options.command, " ")]);
    match Os.startTerminal(command, options.size) {
        Left(error) ->
            fail("/bin/sh cannot start: " <> Io.show(error))
      | Right(program) -> {
            let harness = self();
            let reader = spawn(fn() = forward(program, harness, ms));
            let screen = Screen(seen = <<>>, plain = <<>>, partial = <<>>, cursor = 0);
            let run = Run(=program, =ms, deadline = Clock.monotonic() + ms, =screen, status = None);
            let #(run, unmet) = takeSteps(run, options.steps);
            let run = awaitEnd(run);
            let status = match run.status {
                Some(status) ->
                    Int.toString(status)
              | None -> {
                    kill(Process.fromAddress(reader));
                    kill(Process.fromAddress(program));
                    "timeout"
                }
            };
            report(run.screen.seen, unmet, status, options)
        }
    }
}

// Report Appendix E.23: each piece the program writes forwarded to the
// harness, and last its exit status. The host takes a program's output
// only while a read waits, so a read always waits; one whose time passes
// is asked again, since the harness bounds its own waits.
fn forward(program : Address(Os.ProgramMsg), harness : Address(HarnessMsg), ms : Int) : Unit =
    match Os.read(program, ms) {
        Right(Os.Stdout(bytes)) or Right(Os.Stderr(bytes)) -> {
            send(harness, Wrote(bytes));
            forward(program, harness, ms)
        }
      | Right(Os.Exited(status)) ->
            send(harness, Ended(status))
      | Left(Io.Timeout) ->
            forward(program, harness, ms)
      | Left(error) ->
            send(harness, Unread(error))
    }

// The steps taken in order until one is not met, the program has ended,
// or the wait in progress has; the run as they left it, and the steps
// left.
fn takeSteps(run : Run, steps : List(Step)) : #(Run, List(Step)) receiving HarnessMsg =
    match steps {
        step :: rest when Optional.isNone(run.status) && remaining(run) > 0 ->
            match take(run, step) {
                Met(run) -> takeSteps(run, rest)
              | Unmet(run) -> #(run, steps)
            }
      | _ ->
            #(run, steps)
    }

fn take(run : Run, step : Step) : Stepped receiving HarnessMsg =
    match step {
        Expect(text) ->
            awaitText(run, text)
      | Send(bytes) ->
            match Os.write(run.program, bytes, remaining(run)) {
                Right(_) -> Met(run)
              | Left(_) -> Unmet(run)
            }
      | Resize(size) ->
            match Os.resize(run.program, size) {
                Right(_) -> Met(run)
              | Left(_) -> Unmet(run)
            }
      | Put(path) -> {
            let harness = self();
            let ms = remaining(run);
            awaitPut(run, spawn(fn() = openPipe(path, harness, ms)))
        }
      | Hangup -> {
            Os.closeInput(run.program);
            Met(run)
        }
    }

// An expect: the text found after the cursor, which moves past it, and the
// next wait begun; until then each piece the program writes is taken,
// until the program has ended or the wait has.
fn awaitText(run : Run, text : Bytes) : Stepped receiving HarnessMsg =
    match found(run.screen, text) {
        Some(screen) ->
            Met(Run(..run, =screen, deadline = Clock.monotonic() + run.ms))
      | None ->
            receive {
                Wrote(bytes) -> awaitText(Run(..run, screen = shown(run.screen, bytes)), text)
              | Ended(status) -> Unmet(Run(..run, status = Some(status)))
              | Unread(error) -> failRead(error)
              | after remaining(run) -> Unmet(run)
            }
    }

// A put: the answer of its process, each piece the program writes taken
// meanwhile; the process is killed, and its `sh` with it, where the
// program ends or the wait does first.
fn awaitPut(run : Run, putter : Address(Never)) : Stepped receiving HarnessMsg =
    receive {
        Opened ->
            Met(run)
      | Unopened ->
            Unmet(run)
      | Wrote(bytes) ->
            awaitPut(Run(..run, screen = shown(run.screen, bytes)), putter)
      | Ended(status) -> {
            kill(Process.fromAddress(putter));
            Unmet(Run(..run, status = Some(status)))
        }
      | Unread(error) ->
            failRead(error)
      | after remaining(run) -> {
            kill(Process.fromAddress(putter));
            Unmet(run)
        }
    }

// Report Appendix E.23: the named pipe opened for writing and closed by
// `sh`, whose open waits until the program has opened the pipe for
// reading; a path that names no named pipe is not opened.
fn openPipe(path : String, harness : Address(HarnessMsg), ms : Int) : Unit = {
    let opener = Os.command("/bin/sh", ["-c", "test -p \"$1\" && : > \"$1\"", "sh", path]);
    match Os.run(opener, ms) {
        Right(Os.Finished(status = 0)) -> send(harness, Opened)
      | _ -> send(harness, Unopened)
    }
}

// The program's end: each piece it writes taken until it has exited, or
// the wait in progress has ended.
fn awaitEnd(run : Run) : Run receiving HarnessMsg =
    match run.status {
        Some(_) ->
            run
      | None ->
            receive {
                Wrote(bytes) -> awaitEnd(Run(..run, screen = shown(run.screen, bytes)))
              | Ended(status) -> Run(..run, status = Some(status))
              | Unread(error) -> failRead(error)
              | after remaining(run) -> run
            }
    }

// The milliseconds left of the wait in progress, below 0 once it has
// passed, which a wait takes as none (report §7.4).
fn remaining(run : Run) : Int =
    run.deadline - Clock.monotonic()

fn failRead(error : Io.Error) : a =
    fail("the program cannot be read: " <> Io.show(error))

// The two lines on standard output, what the program wrote as it is or as
// a screen, and the steps not met on standard error.
fn report(seen : Bytes, unmet : List(Step), status : String, options : Options) : Unit = {
    if List.isEmpty(unmet) then
        Unit
    else
        Io.printlnError("unmet " <> String.join(List.map(unmet, kindOf), " "));
    let data = if options.screen then String.toUtf8(rendered(seen, options.size)) else seen;
    Io.println("status " <> status);
    Io.println("data " <> Base64.encode(data))
}

fn kindOf(step : Step) : String =
    match step {
        Expect(_) -> "expect"
      | Send(_) -> "send"
      | Resize(_) -> "resize"
      | Put(_) -> "put"
      | Hangup -> "hangup"
    }

//
// The text a reader sees
//

let escape = <<'\u{1B}':utf8>>

// The screen with the bytes shown: every byte seen, and the text a reader
// sees, a sequence the bytes end inside held until the next piece.
fn shown(screen : Screen, bytes : Bytes) : Screen = {
    let chunk = screen.partial <> bytes;
    let cut = cutAt(chunk);
    Screen(..screen,
           seen = screen.seen <> bytes,
           plain = screen.plain <> uncolored(Bytes.slice(chunk, 0, cut)),
           partial = Bytes.drop(chunk, cut))
}

// Where a sequence the chunk ends inside begins, its last escape, alone or
// with `[` and parameters after it; else the chunk's end.
fn cutAt(chunk : Bytes) : Int =
    match Bytes.lastIndexOf(chunk, escape) {
        Some(index) when isCut(Bytes.drop(chunk, index + 1)) -> index
      | _ -> Bytes.size(chunk)
    }

fn isCut(sequence : Bytes) : Bool =
    match sequence {
        <<'[':utf8, control:bytes>> -> Bytes.isEmpty(parametersOf(control).rest)
      | _ -> Bytes.isEmpty(sequence)
    }

// The text without the sequences that only color it, an escape, `[`,
// parameters and `m`.
fn uncolored(text : Bytes) : Bytes =
    match Bytes.split(text, escape) {
        first :: parts -> Bytes.join(first :: List.map(parts, colorless), <<>>)
      | [] -> text
    }

// A part that followed an escape, with the escape before it, or without
// both where the part begins the rest of a color sequence.
fn colorless(part : Bytes) : Bytes =
    match part {
        <<'[':utf8, control:bytes>> ->
            match parametersOf(control).rest {
                <<'m':utf8, text:bytes>> -> text
              | _ -> escape <> part
            }
      | _ ->
            escape <> part
    }

// The parameters a control sequence's bytes begin with, the one reader of
// both the text a reader sees and the screen.
fn parametersOf(bytes : Bytes) : Parameters = {
    let size = parametersSize(bytes);
    let numbers = Bytes.split(Bytes.slice(bytes, 0, size), <<';':utf8>>) |> List.map(numberOf);
    let #(first, second) = match numbers {
        first :: second :: _ -> #(first, second)
      | [first] -> #(first, None)
      | [] -> #(None, None)
    };
    Parameters(=first, =second, rest = Bytes.drop(bytes, size))
}

// How many bytes the parameters take, digits and `;`s.
fn parametersSize(bytes : Bytes) : Int =
    match bytes {
        <<char:utf8, rest:bytes>> when Char.isAsciiDigit(char) || char == ';' ->
            1 + parametersSize(rest)
      | _ ->
            0
    }

// A parameter's digits as a number, None where none is written.
fn numberOf(digits : Bytes) : Optional(Int) =
    Optional.andThen(String.fromUtf8(digits), String.toInt)

// The screen with its cursor past the text's first occurrence after the
// cursor; None where the text has not shown there yet.
fn found(screen : Screen, text : Bytes) : Optional(Screen) = {
    let rest = Bytes.drop(screen.plain, screen.cursor);
    Optional.map(Bytes.indexOf(rest, text),
                 fn(index) = Screen(..screen, cursor = screen.cursor + index + Bytes.size(text)))
}

//
// The screen as a reader sees it
//

// What the writes leave on a screen of the size, its rows joined by line
// feeds, each without the spaces it ends with: the text, the cursor's
// moves and the erasures that the shell writes, which is enough to assert
// on a pane. A byte that begins no UTF-8 character shows as U+FFFD.
fn rendered(bytes : Bytes, size : Terminal.Size) : String = {
    let blank = Grid(=size, cells = Map.empty, top = 0, row = 0, column = 0);
    let grid = painted(blank, String.toUtf8(String.fromUtf8Lossy(bytes)));
    List.range(0, size.rows - 1) |> List.map(fn(row) = rowText(grid, row)) |> String.join("\n")
}

// The text's characters played onto the screen: a carriage return moves
// the cursor to the row's first column, a line feed a row down, an escape
// begins a sequence, and any other character is written.
fn painted(grid : Grid, text : Bytes) : Grid =
    match text {
        <<'\u{1B}':utf8, sequence:bytes>> -> {
            let #(grid, rest) = escaped(grid, sequence);
            painted(grid, rest)
        }
      | <<'\r':utf8, rest:bytes>> ->
            painted(Grid(..grid, column = 0), rest)
      | <<'\n':utf8, rest:bytes>> ->
            painted(lineFed(grid), rest)
      | <<char:utf8, rest:bytes>> ->
            painted(written(grid, char), rest)
      | _ ->
            grid
    }

// What the sequence after an escape does to the screen, and the text
// after it: a private mode, `[?`, parameters and `h` or `l`, shows
// nothing; a control sequence, `[`, parameters and a letter, moves the
// cursor or erases; and any other escape is dropped alone.
fn escaped(grid : Grid, sequence : Bytes) : #(Grid, Bytes) =
    match sequence {
        <<'[':utf8, '?':utf8, mode:bytes>> ->
            match parametersOf(mode).rest {
                <<'h':utf8, rest:bytes>> or <<'l':utf8, rest:bytes>> -> #(grid, rest)
              | _ -> #(grid, sequence)
            }
      | <<'[':utf8, control:bytes>> ->
            controlled(grid, parametersOf(control), sequence)
      | _ ->
            #(grid, sequence)
    }

fn controlled(grid : Grid, parameters : Parameters, sequence : Bytes) : #(Grid, Bytes) =
    match parameters.rest {
        <<final:utf8, rest:bytes>> when isLetter(final) -> #(moved(grid, parameters, final), rest)
      | _ -> #(grid, sequence)
    }

fn isLetter(char : Char) : Bool =
    char >= 'A' && char <= 'Z' || char >= 'a' && char <= 'z'

// ECMA-48's sequences as the shell writes them: `H` places the cursor at a
// row and a column counted from 1, `A`, `B`, `C` and `D` move it up, down,
// right and left within the screen, `K` erases the row from the cursor,
// and `J` the screen from the cursor, or with a number other than 0 the
// whole screen, the cursor going home. A number not written is 1, and 0
// for `J`.
fn moved(grid : Grid, parameters : Parameters, final : Char) : Grid = {
    let count = Optional.withDefault(parameters.first, 1);
    let column = Optional.withDefault(parameters.second, 1);
    match final {
        'H' -> Grid(..grid, row = count - 1, column = column - 1)
      | 'A' -> Grid(..grid, row = Int.max(0, grid.row - count))
      | 'B' -> Grid(..grid, row = Int.min(grid.size.rows - 1, grid.row + count))
      | 'C' -> Grid(..grid, column = Int.min(grid.size.columns - 1, grid.column + count))
      | 'D' -> Grid(..grid, column = Int.max(0, grid.column - count))
      | 'K' -> rowErased(grid)
      | 'J' when Optional.withDefault(parameters.first, 0) == 0 -> belowErased(rowErased(grid))
      | 'J' -> Grid(..grid, cells = Map.empty, row = 0, column = 0)
      | _ -> grid
    }
}

// The cursor's row erased from the cursor to its end.
fn rowErased(grid : Grid) : Grid =
    withCursorLine(grid, Map.filter(lineOf(grid, grid.row), fn(column, _) = column < grid.column))

// The rows below the cursor's erased.
fn belowErased(grid : Grid) : Grid =
    Grid(..grid, cells = Map.filter(grid.cells, fn(number, _) = number <= grid.top + grid.row))

// A line feed: the cursor a row down, or at the bottom row the screen
// scrolled up a row, its top line gone.
fn lineFed(grid : Grid) : Grid =
    if grid.row + 1 < grid.size.rows then
        Grid(..grid, row = grid.row + 1)
    else
        Grid(..grid,
             cells = Map.remove(grid.cells, grid.top),
             top = grid.top + 1,
             row = grid.size.rows - 1)

// A character written at the cursor, which moves a column right; one
// outside the screen is not written, and the cursor stays.
fn written(grid : Grid, char : Char) : Grid =
    if isOnScreen(grid) then
        Grid(..withCursorLine(grid, Map.put(lineOf(grid, grid.row), grid.column, char)),
             column = grid.column + 1)
    else
        grid

fn isOnScreen(grid : Grid) : Bool =
    grid.row >= 0
        && grid.row < grid.size.rows
        && grid.column >= 0
        && grid.column < grid.size.columns

// The characters on the screen's row, by their column.
fn lineOf(grid : Grid, row : Int) : Map(Int, Char) =
    Optional.withDefault(Map.get(grid.cells, grid.top + row), Map.empty)

// The screen with the line on the cursor's row.
fn withCursorLine(grid : Grid, line : Map(Int, Char)) : Grid =
    Grid(..grid, cells = Map.put(grid.cells, grid.top + grid.row, line))

// The text of the screen's row, without the spaces it ends with.
fn rowText(grid : Grid, row : Int) : String = {
    let line = lineOf(grid, row);
    List.range(0, grid.size.columns - 1)
        |> List.map(fn(column) = Optional.withDefault(Map.get(line, column), ' '))
        |> String.fromList
        |> String.trimEnd
}
