//
// What a terminal delivers, for the terminal tests (report §8.2, §9.3).
// Each key is printed as it arrives; Escape ends the program.
//

type Msg = E(Event)

// `ready` is printed after the subscription, not before: it is what the
// harness waits for, and until the subscription the terminal still echoes.
export fn main() -> Unit with Msg = {
    Terminal.subscribe(E);
    Io.println("ready " <> sizeText());
    loop()
}

fn sizeText() -> String with m = match Terminal.size() {
    None -> "no size"
  | Some(Size(rows = rows, columns = columns)) ->
        Int.toString(rows) <> "x" <> Int.toString(columns)
}

fn loop() -> Unit with Msg = receive {
    E(Escape) -> Io.println("escape")
  | E(ArrowUp) -> { Io.println("up"); loop() }
  | E(ArrowDown) -> { Io.println("down"); loop() }
  | E(ArrowLeft) -> { Io.println("left"); loop() }
  | E(ArrowRight) -> { Io.println("right"); loop() }
  | E(Enter) -> { Io.println("enter"); loop() }
  | E(Interrupt) -> { Io.println("interrupt"); loop() }
  | E(Key(c)) -> { Io.println("char " <> Char.toString(c)); loop() }
  | E(Pasted(text)) -> {
        Io.println("pasted " <> String.replace(text, "\n", "|"));
        loop()
    }
  | E(Resized(Size(rows = rows, columns = columns))) -> {
        Io.println("resized " <> Int.toString(rows) <> "x" <> Int.toString(columns));
        loop()
    }
  | after 10000 -> Io.println("nothing came")
}
