//
// What a terminal delivers, for the terminal tests (report §8.2, Appendix E.16).
// Each key is printed as it arrives; Escape ends the program.
//

type Msg = Key(Terminal.Event)

// `ready` is printed after the subscription, not before: it is what the
// harness waits for, and until the subscription the terminal still echoes.
export fn main() : Unit with Msg =
    match Terminal.subscribe(Key) {
        Right(_) -> {
            Io.println("ready " <> sizeText());
            loop()
        }
      | Left(_) -> Io.println("no terminal, " <> sizeText())
    }

fn sizeText() : String with m =
    match Terminal.size() {
        Left(Io.NotATerminal) -> "no size"
      | Left(_) -> "a size refused otherwise"
      | Right(Terminal.Size(rows = rows, columns = columns)) ->
            Int.toString(rows) <> "x" <> Int.toString(columns)
    }

fn loop() : Unit with Msg =
    receive {
        Key(Terminal.Escape) -> Io.println("escape")
      | Key(Terminal.ArrowUp) -> {
            Io.println("up");
            loop()
        }
      | Key(Terminal.ArrowDown) -> {
            Io.println("down");
            loop()
        }
      | Key(Terminal.ArrowLeft) -> {
            Io.println("left");
            loop()
        }
      | Key(Terminal.ArrowRight) -> {
            Io.println("right");
            loop()
        }
      | Key(Terminal.Interrupt) -> {
            Io.println("interrupt");
            loop()
        }
      | Key(Terminal.Key(char)) -> {
            Io.println("char " <> Char.toString(char));
            loop()
        }
      | Key(Terminal.Pasted(text)) -> {
            Io.println("pasted " <> String.replace(text, "\n", "|"));
            loop()
        }
      | Key(Terminal.Resized(Terminal.Size(rows = rows, columns = columns))) -> {
            Io.println("resized " <> Int.toString(rows) <> "x" <> Int.toString(columns));
            loop()
        }
      | after 10000 -> Io.println("nothing came")
    }
