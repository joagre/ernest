//
// What a terminal delivers, for the terminal tests (report §8.2, §9.3).
// Each key is printed as it arrives; Escape ends the program.
//

type Msg = E(Terminal.Event)

// `ready` is printed after the subscription, not before: it is what the
// harness waits for, and until the subscription the terminal still echoes.
export fn main() -> Unit with Msg = match Terminal.subscribe(E) {
    Right(_) -> {
        Io.println("ready " <> sizeText());
        loop()
    }
  | Left(_) -> Io.println("no terminal")
}

fn sizeText() -> String with m = match Terminal.size() {
    None -> "no size"
  | Some(Terminal.Size(rows = rows, columns = columns)) ->
        Int.toString(rows) <> "x" <> Int.toString(columns)
}

fn loop() -> Unit with Msg = receive {
    E(Terminal.Escape) -> Io.println("escape")
  | E(Terminal.ArrowUp) -> { Io.println("up"); loop() }
  | E(Terminal.ArrowDown) -> { Io.println("down"); loop() }
  | E(Terminal.ArrowLeft) -> { Io.println("left"); loop() }
  | E(Terminal.ArrowRight) -> { Io.println("right"); loop() }
  | E(Terminal.Enter) -> { Io.println("enter"); loop() }
  | E(Terminal.Interrupt) -> { Io.println("interrupt"); loop() }
  | E(Terminal.Key(c)) -> { Io.println("char " <> Char.toString(c)); loop() }
  | E(Terminal.Pasted(text)) -> {
        Io.println("pasted " <> String.replace(text, "\n", "|"));
        loop()
    }
  | E(Terminal.Resized(Terminal.Size(rows = rows, columns = columns))) -> {
        Io.println("resized " <> Int.toString(rows) <> "x" <> Int.toString(columns));
        loop()
    }
  | after 10000 -> Io.println("nothing came")
}
