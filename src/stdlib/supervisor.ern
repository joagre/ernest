/// A group of processes, restarted together when one of them faults.
///
/// Use it where processes depend on one another, so that a fault in one must
/// restart others too, or where independent processes should share one restart
/// limit and stop together, one child per connection among them. A single
/// process that restarts alone is `restarting`'s work. Spawn `group(strategy,
/// limit)` as the supervisor, then spawn `child(supervisor, f)` for each child,
/// `f` the work it does. The caller spawns each, as it spawns what `restarting`
/// answers, so a fault line names the binding that holds the process (report
/// §6.9), and a service binding can reach it (report §6.5).
///
/// **What restarts.** A child that faults runs `f` again in place, keeping its
/// address, as under `restarting`. The `Strategy` says which of its siblings
/// restart with it. The child that faulted runs again once each of those
/// siblings has restarted or ended, so a call to it after its fault is answered
/// by the group restarted whole.
///
/// **When a sibling restarts.** A sibling restarts at its next wait, a
/// `receive` or a call waiting for its answer, and runs on until then; a
/// sibling that never waits never restarts. It keeps its address, and its
/// mailbox is emptied, as every restart empties it (report §6.9).
///
/// **The limit.** A group whose children fault more often than `limit` allows
/// faults itself. A supervisor that is itself a child of another group then
/// restarts in place, and asks each of its own children to restart but one
/// that waits to run again, the child it gave up at among them, which runs
/// again once each of the others has restarted or ended.
///
/// **Stopping a group.** `kill(Process.fromAddress(supervisor))` stops the group: when a supervisor
/// dies, its children are killed after it, the last spawned first, each once
/// the one before has ended. A child that must finish its work first is sent a
/// message of its own protocol before, since a killed process runs nothing
/// more.
///
/// ## Examples
///
/// A group of one, a child that answers, and the group stopped. The child's
/// mailbox takes a bare `Reply(Int)`, so the call makes its message with
/// `fn(reply) = reply`:
///
/// ```ernest
/// {
///     let supervisor =
///         spawn(Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     let echo = spawn(Supervisor.child(supervisor, fn() : Unit receiving Reply(Int) = receive {
///         reply -> answer(reply, 42)
///     }));
///     let answered = Address.callForever(echo, fn(reply) = reply);
///     kill(Process.fromAddress(supervisor));
///     answered
/// }
/// // => 42
/// ```
///
/// ## See also
///
/// `restarting`, which restarts one process in place; `kill`; `monitor`.
///
/// since 0.1.0

/// What else a child's fault restarts: nothing, under `OneForOne`; every other
/// child, under `OneForAll`; or the children spawned after it, under
/// `RestForOne`. The order is the one the runtime spawned them in, whatever
/// order they joined in.
///
/// ### Examples
///
/// A group whose later children use the earlier ones, restarted from the child
/// that faulted onwards:
///
/// ```ernest
/// spawn(Supervisor.group(Supervisor.RestForOne, RestartLimit(restarts = 3, within = 5000)))
/// ```
export type Strategy = OneForOne | OneForAll | RestForOne

// A child joins its supervisor, and after every restart asks through the
// watcher whether it may run. The watcher, which a restart in place does
// not end, holds who waits, and the supervisor decides when each goes. It
// does not subscribe to every fault of the runtime with
// `Process.subscribeFaults`.

/// What a supervisor takes. Its constructors are hidden; only this module makes
/// them.
///
/// ### Examples
///
/// ```ernest
/// {
///     let supervisor : Address(Supervisor.GroupMsg) =
///         spawn(Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     kill(Process.fromAddress(supervisor))
/// }
/// // => Unit
/// ```
///
/// since 0.5.0
export abstract type GroupMsg =
    Join(process : Process,
         stop : () -> Unit receiving WatcherMsg,
         reply : Reply(Address(WatcherMsg)))
  | Paused(process : Process, cause : Start, question : Int)
  | Expired
  | Settled(Process)

// What the watcher takes: a child to watch, the children in spawn order, a
// run of the supervisor, answered where this process runs the group, a
// child's question and its answer, and a child's end and the supervisor's.
type WatcherMsg =
    Add(Member)
  | Children(Reply(List(Process)))
  | Run(supervisor : Address(GroupMsg), reply : Reply(Optional(Begun)))
  | Wait(process : Process, cause : Start, reply : Reply(Unit))
  | Go(Int)
  | Gone(Process)
  | SupervisorDied

// A child as the watcher holds it: its process, where it stands in the
// order of spawns, and how to kill it, which needs its address.
type Member = Member(process : Process, spawned : Int, stop : () -> Unit receiving WatcherMsg)

// A run of the supervisor as the watcher begins it: the children that wait
// to run again, and the last question taken before it.
type Begun = Begun(waiting : List(Waiter), last : Int)

// Why a child's function began: the first time, after a fault, or because
// its supervisor asked.
type Start = First | AfterFault | Asked

// A group as its supervisor's run holds it, with its Begun's `last`.
type Group =
    Group(strategy : Strategy, limit : RestartLimit, watcher : Address(WatcherMsg), last : Int)

// A child that waits to run again: its latest question, and the children
// it waits for to restart or end.
type Waiter = Waiter(process : Process, question : Int, asked : List(Process))

// How long a call to the watcher or the supervisor waits before it is made
// again. A callee that ends or restarts answers `None` at once (report
// §6.6), so the limit bounds only one that lives and has not answered,
// which both do at once; its value changes nothing but how soon such a
// call is made again.
let retryMs = 1000

/// The function a supervisor runs, for the caller to spawn:
/// `spawn(Supervisor.group(strategy, limit))`. The children's faults are
/// counted against `limit` as `restarting` counts a process's (report §6.9).
///
/// Spawn the function `group` answers once. A second process that runs the same
/// function faults, even after the first has ended; a second group is a second
/// call of `group`. The call also spawns a process that keeps the group's
/// children and kills them when the supervisor dies. A restart of the
/// supervisor does not end it, and `Process.live` lists it. Where no process
/// ever runs the function, that process waits until the program ends.
///
/// A supervisor that is itself a child restarts in place, and asks each of its
/// children to restart; they keep their order. A child that waits to run
/// again, the one at whose fault the group gave up among them, is not asked,
/// and runs again once each child asked has restarted or ended.
///
/// ### Errors
///
/// Faults where the children's faults pass `limit`, with the cause `supervisor
/// restart limit reached`, and in a second process that runs it, with the cause
/// `a group runs in one process`.
///
/// ### Examples
///
/// ```ernest
/// spawn(Supervisor.group(Supervisor.OneForAll, RestartLimit(restarts = 5, within = 10000)))
/// ```
export fn group(strategy : Strategy, limit : RestartLimit) : (() -> Unit receiving GroupMsg) = {
    // the watcher outlives a restart in place, which empties the
    // supervisor's mailbox, so each run finds it here (report §6.9)
    let watcher = spawn(watch);
    fn() = {
        let begun = match begunAt(watcher, self()) {
            Some(answered) -> answered
          | None -> fault("a group runs in one process")
        };
        // Appendix E.22: a run begun by a restart, whatever its cause, asks
        // each child that does not wait to run again, and lets each that
        // waits go once those have restarted or ended; the first finds none
        let asked = askedOf(children(watcher), begun.waiting);
        let waiting =
            letGo(watcher, List.map(begun.waiting, fn(waiter) = Waiter(..waiter, =asked)));
        supervise(Group(=strategy, =limit, =watcher, last = begun.last), 0, waiting)
    }
}

// The run's beginning, None where another process runs the group. The
// watcher answers at once, so a call it has not answered is made again
// while it lives; one that has ended ended with the group's first run.
fn begunAt(watcher : Address(WatcherMsg), supervisor : Address(GroupMsg)) : Optional(Begun) =
    match Address.call(watcher, fn(reply) = Run(=supervisor, =reply), retryMs) {
        Some(answered) ->
            answered
      | None ->
            match Process.status(Process.fromAddress(watcher)) {
                None -> None
              | Some(_) -> begunAt(watcher, supervisor)
            }
    }

// The supervisor's loop. `recent` counts the faults within the limit's
// window, each expired by an alarm, which a restart in place cancels
// (report §6.9); `Unlimited` counts none. A question from before the run
// may reach it, a restart emptying the mailbox before what comes during it
// (§6.9); the run read it as it began.
fn supervise(group : Group, recent : Int, waiting : List(Waiter)) : Unit receiving GroupMsg =
    receive {
        Join(=process, =stop, =reply) -> {
            send(group.watcher, Add(Member(=process, spawned = spawnOrder(process), =stop)));
            answer(reply, group.watcher);
            supervise(group, recent, waiting)
        }
      | Paused(process = _, cause = _, =question) when question <= group.last ->
            supervise(group, recent, waiting)
      // a child that faults has restarted as those that wait for it wait
      // for it to; at the limit it waits for the group's end or its restart
      | Paused(=process, cause = AfterFault, =question) -> {
            let left = settled(group.watcher, waiting, process);
            let counted = withFault(group.limit, recent);
            let asked = askedOf(siblings(group.strategy, process, group.watcher), left);
            let waiter = Waiter(=process, =question, =asked);
            supervise(group, counted, letGo(group.watcher, waiter :: left))
        }
      // a child asked has restarted, and goes, unless it waits for its own
      // fault's siblings, which it waits for now under its latest question
      | Paused(=process, cause = _, =question) -> {
            let left = settled(group.watcher, waiting, process);
            match List.find(left, fn(waiter) = waiter.process == process) {
                Some(own) ->
                    supervise(group, recent, Waiter(..own, =question) :: without(left, process))
              | None -> {
                    send(group.watcher, Go(question));
                    supervise(group, recent, left)
                }
            }
        }
      | Expired ->
            supervise(group, recent - 1, waiting)
      | Settled(child) ->
            supervise(group, recent, settled(group.watcher, without(waiting, child), child))
    }

// The count with one fault more, which an alarm expires after the window;
// at the limit the supervisor faults.
fn withFault(limit : RestartLimit, recent : Int) : Int receiving GroupMsg =
    match limit {
        Unlimited ->
            recent
      | RestartLimit(=restarts, =within) ->
            if recent < restarts then {
                let _ = Clock.alarm(Int.max(within, 1), fn(_) = Expired);
                recent + 1
            } else
                fault("supervisor restart limit reached")
    }

// Appendix E.22: the children a child waits for, of those a restart names:
// each that does not wait to run again, asked unless it already was, so
// that the group is whole when the child runs. One that has not yet begun
// its first run is not asked, and not waited for.
fn askedOf(named : List(Process), waiting : List(Waiter)) : List(Process) =
    List.filter(named,
                fn(child) =
                    !isWaiting(waiting, child) && (isAsked(waiting, child) || askRestart(child)))

fn siblings(strategy : Strategy, faulted : Process, watcher : Address(WatcherMsg)) : List(Process) =
    match strategy {
        OneForOne -> []
      | OneForAll -> List.filter(children(watcher), fn(child) = child != faulted)
      | RestForOne -> spawnedAfter(children(watcher), faulted)
    }

// The children that wait with `child` no longer among those they wait for;
// one that waits for none now goes.
fn settled(watcher : Address(WatcherMsg), waiting : List(Waiter), child : Process) : List(Waiter) =
    letGo(watcher,
          List.map(waiting,
                   fn(waiter) =
                       Waiter(..waiter,
                              asked = List.filter(waiter.asked, fn(sibling) = sibling != child))))

// The children that wait, less those that wait for none, which go.
fn letGo(watcher : Address(WatcherMsg), waiting : List(Waiter)) : List(Waiter) = {
    let #(going, left) = List.partition(waiting, fn(waiter) = List.isEmpty(waiter.asked));
    List.forEach(going, fn(waiter) = send(watcher, Go(waiter.question)));
    left
}

fn isWaiting(waiting : List(Waiter), child : Process) : Bool =
    List.any(waiting, fn(waiter) = waiter.process == child)

fn isAsked(waiting : List(Waiter), child : Process) : Bool =
    List.any(waiting, fn(waiter) = List.contains(waiter.asked, child))

fn without(waiting : List(Waiter), child : Process) : List(Waiter) =
    List.filter(waiting, fn(waiter) = waiter.process != child)

// The children spawned after `child`, which the watcher holds in that order.
fn spawnedAfter(children : List(Process), child : Process) : List(Process) =
    match children {
        [] -> []
      | head :: rest -> if head == child then rest else spawnedAfter(rest, child)
    }

fn children(watcher : Address(WatcherMsg)) : List(Process) =
    Address.callForever(watcher, Children)

// Report §6.9: the child restarts at its next wait, and the answer says
// whether it was asked; one that has ended, or has not yet begun to run
// what restarts, is not.
foreign fn askRestart(child : Process) : Bool =
    "ern_rt:ask_restart/1"

// Report §8.7: whether a process runs on the caller's node; a supervisor
// and its children run on one.
foreign fn isOnThisNode(process : Process) : Bool =
    "ern_rt:on_this_node/1"

// Where a process stands in the order the runtime spawned its processes,
// which `RestForOne` reads and the watcher keeps its children in.
foreign fn spawnOrder(process : Process) : Int =
    "ern_rt:spawn_order/1"

// The watcher: it holds the children in spawn order and their questions,
// which it passes on, forgets one that ends and tells the supervisor, and
// when the supervisor dies kills them, the last first.
fn watch() : Unit receiving WatcherMsg =
    receive {
        Run(=supervisor, =reply) -> {
            monitor(Process.fromAddress(supervisor), fn(_) = SupervisorDied);
            answer(reply, Some(Begun(waiting = [], last = 0)));
            watching(supervisor, [], [], 0)
        }
    }

// The watcher's loop: the members, each waiting child's latest question,
// numbered as it came, with the reply that lets the child go, kept until
// the supervisor does or the child ends, and the last question's number.
fn watching(supervisor : Address(GroupMsg),
            members : List(Member),
            questions : List(#(Waiter, Reply(Unit))),
            last : Int) : Unit receiving WatcherMsg =
    receive {
        Add(member) ->
            if List.any(members, fn(known) = known.process == member.process) then
                watching(supervisor, members, questions, last)
            else {
                monitor(member.process, fn(_) = Gone(member.process));
                watching(supervisor, inOrder(members, member), questions, last)
            }
      | Children(reply) -> {
            answer(reply, List.map(members, fn(member) = member.process));
            watching(supervisor, members, questions, last)
        }
      | Run(supervisor = other, =reply) -> {
            let runsGroup = Process.fromAddress(other) == Process.fromAddress(supervisor);
            let waiting = List.map(questions, fn(#(waiter, _)) = waiter);
            answer(reply, if runsGroup then Some(Begun(=waiting, =last)) else None);
            watching(supervisor, members, questions, last)
        }
      // a question takes the place of the child's earlier one, which a
      // restart taken at its wait has ended
      | Wait(=process, =cause, =reply) -> {
            let number = last + 1;
            send(supervisor, Paused(=process, =cause, question = number));
            let waiter = Waiter(=process, question = number, asked = []);
            watching(supervisor, members, #(waiter, reply) :: unasked(questions, process), number)
        }
      // a question a later one has taken the place of lets nothing go
      | Go(number) -> {
            let #(answered, held) =
                List.partition(questions, fn(#(waiter, _)) = waiter.question == number);
            List.forEach(answered, fn(#(_, reply)) = answer(reply, Unit));
            watching(supervisor, members, held, last)
        }
      | Gone(process) -> {
            send(supervisor, Settled(process));
            let left = List.filter(members, fn(member) = member.process != process);
            watching(supervisor, left, unasked(questions, process), last)
        }
      | SupervisorDied ->
            stopAll(List.reverse(members))
    }

// The questions but `child`'s.
fn unasked(questions : List(#(Waiter, Reply(Unit))),
           child : Process) : List(#(Waiter, Reply(Unit))) =
    List.filter(questions, fn(#(waiter, _)) = waiter.process != child)

// The members with a new one among them, in the order they were spawned.
fn inOrder(members : List(Member), member : Member) : List(Member) =
    match members {
        [] ->
            [member]
      | head :: rest ->
            if member.spawned < head.spawned then
                member :: members
            else
                head :: inOrder(rest, member)
    }

fn stopAll(members : List(Member)) : Unit receiving WatcherMsg =
    match members {
        [] ->
            Unit
      | Member(=process, spawned = _, =stop) :: rest -> {
            stop();
            receive {
                Gone(gone) when gone == process -> Unit
            };
            stopAll(rest)
        }
    }

/// The function a child runs, for the caller to spawn:
/// `spawn(Supervisor.child(supervisor, f))`. It joins `supervisor`'s group,
/// waiting until the supervisor has it, then runs `f`. After a fault it runs
/// `f` again in place, until the group gives up. A child that returns or is
/// killed leaves the group.
///
/// ### Errors
///
/// Faults where `supervisor` has ended before the child joins, with the cause
/// `the supervisor has ended`, and where `supervisor` runs on another node,
/// with the cause `a child runs on its supervisor's node`, before it joins.
/// Faults where it runs inside a restarting function, another child's among
/// them, with the cause `a child's function runs in no restarting function`:
/// a child restarts by its group, and reads why it began from its own
/// restart alone (report §6.9).
///
/// ### Examples
///
/// ```ernest
/// {
///     let supervisor =
///         spawn(Supervisor.group(Supervisor.OneForOne,
///                                RestartLimit(restarts = 3, within = 5000)));
///     spawn(Supervisor.child(supervisor, fn() : Unit receiving Int = receive {
///         _ -> Unit
///     }))
/// }
/// ```
export fn child(supervisor : Address(GroupMsg),
                f : () -> Unit receiving m) : () -> Unit receiving m =
    fn() = {
        if isRestarting() then fault("a child's function runs in no restarting function") else Unit;
        if isOnThisNode(Process.fromAddress(supervisor)) then
            Unit
        else
            fault("a child runs on its supervisor's node");
        let address = self();
        let process = Process.fromAddress(address);
        let watcher = join(supervisor, process, fn() = kill(Process.fromAddress(address)));
        // the group's limit decides when a child stops, so its own is none
        restarting(Unlimited, fn() = match startCause() {
            First -> f()
          | cause -> runAgain(supervisor, watcher, process, cause, f)
        })()
    }

// Appendix E.22: after a restart, the child runs again once its supervisor
// lets it go. The call sends its question before the wait at which an asked
// restart is taken, so the supervisor has its fault before any later
// question, and counts it before `f` runs again. A child whose supervisor
// has ended is killed as the others are.
fn runAgain(supervisor : Address(GroupMsg),
            watcher : Address(WatcherMsg),
            process : Process,
            cause : Start,
            f : () -> Unit receiving m) : Unit receiving m =
    match Process.status(Process.fromAddress(supervisor)) {
        None ->
            kill(Process.current())
      | Some(_) -> {
            Address.callForever(watcher, fn(reply) = Wait(=process, =cause, =reply));
            f()
        }
    }

// The child joins, and waits until the supervisor has it, which answers
// with the group's watcher. A call that ends unanswered was made as the
// supervisor restarted, and is made again; one made twice is joined once,
// since the watcher keeps a child once.
fn join(supervisor : Address(GroupMsg),
        process : Process,
        stop : () -> Unit receiving WatcherMsg) : Address(WatcherMsg) = {
    let request = fn(reply) = Join(=process, =stop, =reply);
    match Address.call(supervisor, request, retryMs) {
        Some(watcher) ->
            watcher
      | None ->
            match Process.status(Process.fromAddress(supervisor)) {
                None -> fault("the supervisor has ended")
              | Some(_) -> join(supervisor, process, stop)
            }
    }
}

// Why the restarting function the caller runs in began.
foreign fn startCause() : Start =
    "ern_rt:start_cause/0"

// Appendix E.22: whether a restarting function already runs in the calling
// process, whose start cause a child's function would read in place of its
// own.
foreign fn isRestarting() : Bool =
    "ern_rt:is_restarting/0"
