/// Tests, which `ern test` runs.
///
/// A test is a top-level `let` of type `Case`, exported or not, in any module:
/// `let adds = Test.Case(name = "adds", run = fn() = Test.equal(1 + 1, 2))`.
/// Build the module, then run `ern test` on its `.erc`, or on a directory to
/// run the tests of every module under it (report §11.2).
///
/// **What it prints.** `ern test` prints a line for each test as the test ends:
/// `adds: passed`, `divides: failed: expected 4, got 3`, or `crashes: faulted:
/// division by zero`. After the tests it runs the module's doc examples, a line
/// each named by the declaration the example documents: `Math.add example 1:
/// passed`, or `Math.add example 2: failed: expected 4, got 3`. It exits with
/// status 1 unless every test passed.
///
/// **One test at a time.** The tests run in the order the module declares them,
/// each in a process of its own, so a test may spawn, send and receive. A test
/// that faults or deadlocks is reported as `faulted` with the cause, counts as
/// not passed, and the run goes on with the next (report Appendix E.24).
///
/// Most tests compare a value with the one expected, which `equal` does, and
/// `faults` tests that a call faults with the cause expected. A test that wants
/// another text answers `Failed` with its own.
///
/// ## Examples
///
/// A test run by hand, as `ern test` runs it:
///
/// ```ernest
/// {
///     let adds = Test.Case(name = "adds", run = fn() = Test.equal(1 + 1, 2));
///     adds.run()
/// }
/// // => Passed
/// ```
///
/// since 0.2.0

/// A test: its name, which `ern test` prints, and the function it runs, in a
/// process whose mailbox type is `m`. A test that receives nothing leaves `m`
/// open, and runs with `Never`.
///
/// ### Examples
///
/// ```ernest
/// Test.Case(name = "the empty list is empty",
///           run = fn() = if List.isEmpty([]) then Test.Passed else Test.Failed("not empty"))
/// // => Case(name = "the empty list is empty", run = <function>)
/// ```
export type Case(m) = Case(name : String, run : () -> Result receiving m)

/// A test's answer: `Passed`, or `Failed` with what went wrong.
///
/// ### Examples
///
/// ```ernest
/// if 1 + 1 == 2 then Test.Passed else Test.Failed("1 + 1 is not 2")
/// // => Passed
/// ```
export type Result = Passed | Failed(String)

// What the process that judges a call of `faults` takes: the request for its
// verdict, and the end of the process the call ran in. The judge is a process
// of its own, since `faults` receives nothing in its caller's process.
type JudgeMsg = Judge(Reply(Result)) | Ended(Down)

/// `Passed` where `actual` equals `expected`, and otherwise `Failed` naming
/// both as `Io.show` writes them, the expected first: `expected 3, got 2`. It
/// needs `a.show`, which a call at a known type supplies without writing it
/// (report §4.9, §9.4).
///
/// ### Examples
///
/// ```ernest
/// #(Test.equal(List.size([1, 2]), 2), Test.equal(1 + 1, 3))
/// // => #(Passed, Failed("expected 3, got 2"))
/// ```
///
/// since 0.3.0
export fn equal(actual : a, expected : a) : Result needs a.show =
    if actual == expected then
        Passed
    else
        Failed("expected " <> Io.show(expected) <> ", got " <> Io.show(actual))

/// `Passed` where `run` faults with `cause`, and otherwise `Failed` naming the
/// cause expected and what came instead: another cause, a return, or the
/// reason the process ended with as `Io.show` writes it, `expected the fault
/// division by zero, got Killed`.
///
/// `run` runs in a process of its own, monitored, whose end gives the answer
/// (report §6.9); a process it spawns lives on after it. No job reports a fault
/// of a process `faults` started, since the test's answer carries it (report
/// §11.2).
///
/// ### Examples
///
/// ```ernest
/// Test.faults(fn() = 1 / 0, "division by zero")
/// // => Passed
/// ```
///
/// ```ernest
/// Test.faults(fn() = 1 + 1, "division by zero")
/// // => Failed("expected the fault division by zero, got a return")
/// ```
///
/// ```ernest
/// Test.faults(fn() = 1.0 / 0.0, "division by zero")
/// // => Failed("expected the fault division by zero, got the fault float arithmetic error")
/// ```
///
/// since 0.5.0
export fn faults(run : () -> a receiving n, cause : String) : Result = {
    let call = fn() = {
        let _ = run();
        Unit
    };
    let judge = spawn(fn() = receive {
        Judge(reply) -> {
            let _ = spawnMonitored(call, Ended);
            receive {
                Ended(down) -> answer(reply, verdict(down.reason, cause))
            }
        }
    });
    Address.callForever(judge, Judge)
}

// The verdict on a process that was to fault with `cause` and ended with
// `reason`.
fn verdict(reason : Reason, cause : String) : Result = {
    let expected = "expected the fault " <> cause <> ", got ";
    match reason {
        Fault(faulted) ->
            if faulted == cause then Passed else Failed(expected <> "the fault " <> faulted)
      | Returned ->
            Failed(expected <> "a return")
      | _ ->
            Failed(expected <> Io.show(reason))
    }
}
