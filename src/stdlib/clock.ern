/// The time, alarms, and the wait for a time.
///
/// `now` is the time of day, in milliseconds since the epoch, 1970-01-01 UTC.
/// `monotonic` is the clock to measure a duration by, since `now` moves when
/// the host's clock is set, and `monotonicMicros` is the same clock in
/// microseconds. `alarm` and `alarmAt` put a message in the caller's mailbox
/// later, and `sleep` waits a time and takes no message.
///
/// **Alarms.** An alarm fires once, and `alarm` and `alarmAt` answer it as an
/// `Alarm`, which `cancel` ends until it fires. A fired alarm's message is in
/// the mailbox or on its way, and no cancel takes it back. A periodic tick is
/// set again each time the one before is handled. A restart of the process
/// that set an alarm cancels it (report §6.9).
///
/// **Alarms arrive in the mailbox.** An alarm is delivered into the caller's
/// mailbox, so `alarm` and `alarmAt` carry `receiving m`, the caller's mailbox
/// type; reading the time names no mailbox (report §6.1).
///
/// ## Examples
///
/// The time now, in milliseconds since the epoch:
///
/// ```ernest
/// Clock.now() > 0
/// // => true
/// ```
///
/// ## See also
///
/// `Random.seed` for a sequence that differs between runs.
///
/// since 0.1.0

// What the clock takes: times in milliseconds, the time an alarm fires
// sent to its `address`. An alarm is answered once the clock holds it, so that
// the caller goes on only when it is counted as pending (report §8.6), with
// the clock's reference for it, which a cancel names.
type Msg =
    AlarmAfter(ms : Int, address : Address(Int), reply : Reply(Foreign.Term))
  | AlarmAt(time : Int, address : Address(Int), reply : Reply(Foreign.Term))
  | Cancel(alarm : Foreign.Term, reply : Reply(Bool))

/// An alarm that `alarm` or `alarmAt` set, held until it fires, is canceled
/// or its process ends. It is bound to its node, and `==` is the runtime's on
/// it: an alarm equals itself alone (report §3.10, §3.11).
///
/// ### Examples
///
/// ```ernest
/// {
///     let alarm = Clock.alarm(60000, fn(_) = Unit);
///     alarm == alarm
/// }
/// // => true
/// ```
///
/// since 0.8.0
export abstract type Alarm = Alarm(Foreign.Term)

// Report §8.2: the system reference, the runtime's address of the clock,
// bound at each start.
let reference : Address(Msg) = system(Foreign.atom("clock"))

foreign fn system(name : Foreign.Term) : Address(Msg) =
    "ern_rt:system_process/1"

/// The time now, in milliseconds since the epoch, 1970-01-01 UTC. It moves when
/// the host's clock is set; `monotonic` measures a duration.
export foreign fn now() : Int =
    "ern_rt:now/0"

/// Milliseconds since a moment the runtime chose, which never go back, so the
/// difference of two readings is the time the host ran between them. Its value
/// alone says nothing, and `now` is the time of day. Where the host's monotonic
/// clock stops while the machine is suspended, that time is left out.
///
/// ### Examples
///
/// ```ernest
/// {
///     let start = Clock.monotonic();
///     Clock.monotonic() - start >= 0
/// }
/// // => true
/// ```
export foreign fn monotonic() : Int =
    "ern_rt:monotonic/0"

/// Microseconds by the clock `monotonic` reads, which never go back, for a
/// program that measures what takes less than a millisecond.
///
/// ### Examples
///
/// ```ernest
/// {
///     let start = Clock.monotonicMicros();
///     Clock.monotonicMicros() - start >= 0
/// }
/// // => true
/// ```
///
/// since 0.4.0
export foreign fn monotonicMicros() : Int =
    "ern_rt:monotonic_micros/0"

/// Waits `ms` milliseconds, counted as `monotonic` counts them, and takes no
/// message: the mailbox is as it was. A restart asked for, or a fault met on a
/// message's way, reaches the wait as it reaches a `receive` (report §6.5,
/// §6.9). A time below 0 is 0, and a time has no upper bound (report §7.4).
///
/// ### Examples
///
/// ```ernest
/// {
///     let start = Clock.monotonic();
///     Clock.sleep(1);
///     Clock.monotonic() - start >= 1
/// }
/// // => true
/// ```
///
/// since 0.8.0
export foreign fn sleep(ms : Int) : Unit =
    "ern_rt:sleep/1"

/// Puts `wrap(time)` in the caller's mailbox after `ms` milliseconds, `time`
/// the time it fired, and answers the alarm, which `cancel` ends until then.
/// A constructor of one argument passes as `wrap` as it is:
/// `Clock.alarm(100, Tick)` for `Tick(Int)`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let _ = Clock.alarm(10, fn(_) = "rang");
///     receive {
///         message -> message
///     }
/// }
/// // => "rang"
/// ```
export fn alarm(ms : Int, wrap : (Int) -> m) : Alarm receiving m = {
    let address = adapted(self(), wrap);
    let request = fn(reply) = AlarmAfter(=ms, =address, =reply);
    Alarm(Address.callForever(reference, request))
}

/// Puts `wrap(time)` in the caller's mailbox at `time`, in milliseconds since
/// the epoch, `time` then the time it fired, and answers the alarm, which
/// `cancel` ends until then. A time already past fires at once.
///
/// ### Examples
///
/// ```ernest
/// {
///     let time = Clock.now() + 10;
///     let _ = Clock.alarmAt(time, fn(fired) = fired);
///     receive {
///         fired -> fired >= time
///     }
/// }
/// // => true
/// ```
export fn alarmAt(time : Int, wrap : (Int) -> m) : Alarm receiving m = {
    let address = adapted(self(), wrap);
    let request = fn(reply) = AlarmAt(=time, =address, =reply);
    Alarm(Address.callForever(reference, request))
}

/// Ends `alarm` where it has neither fired nor ended, and answers `true`: its
/// message never comes. It answers `false` for any other alarm, one that
/// fired, one canceled already, and one whose process restarted or ended, and
/// leaves it as it is; a fired alarm's message is delivered as any alarm's is.
/// Any process of the node may cancel an alarm it holds.
///
/// ### Examples
///
/// ```ernest
/// {
///     let alarm = Clock.alarm(60000, fn(_) = Unit);
///     Clock.cancel(alarm)
/// }
/// // => true
/// ```
///
/// since 0.8.0
export fn cancel(alarm : Alarm) : Bool = {
    let Alarm(held) = alarm;
    let request = fn(reply) = Cancel(alarm = held, =reply);
    Address.callForever(reference, request)
}

/// The time, in milliseconds since the epoch, as RFC 3339 writes it, in UTC to
/// the millisecond: `2026-10-24T09:21:03.512Z`, as `ern run` writes a time on
/// its lines (report §11.2). A time before the year 0 is written as the host
/// writes it, with its year's sign: `-0001-12-31T23:59:59.999Z`. A time
/// outside the years -9999 to 9999 faults.
///
/// ### Errors
///
/// Faults where `time` is past the year 9999, with the cause `the time is past
/// the year 9999`, and where it is before the year -9999, with the cause `the
/// time is before the year -9999`.
///
/// ### Examples
///
/// ```ernest
/// Clock.toString(0)
/// // => "1970-01-01T00:00:00.000Z"
/// ```
///
/// since 0.5.0
export fn toString(time : Int) : String =
    if time >= year10000 then
        fault("the time is past the year 9999")
    else if time < yearMinus9999 then
        fault("the time is before the year -9999")
    else
        rfc3339(time, rfc3339Options)

// Report Appendix E.15: the first millisecond of the year 10000 and of the
// year -9999, in milliseconds since the epoch, the bounds of the years RFC
// 3339 writes in four digits, which the host refuses outside.
let year10000 = 253402300800000

let yearMinus9999 = -377705116800000

// The host's options: the time in milliseconds, UTC written `Z`, and the
// text a binary, as a String is.
let rfc3339Options : List(#(Foreign.Term, Foreign.Term)) =
    [#(Foreign.atom("unit"), Foreign.atom("millisecond")),
     #(Foreign.atom("offset"), Foreign.term(['Z'])),
     #(Foreign.atom("return"), Foreign.atom("binary"))]

foreign fn rfc3339(time : Int, options : List(#(Foreign.Term, Foreign.Term))) : String =
    "calendar:system_time_to_rfc3339/2"
