/// Finite sets: each element once, in no order.
///
/// Use a set to ask whether a value is among others, and to keep each value
/// once. For values in an order use a `List`, for elements in their own order
/// an `OrderedSet`, and for values looked up by a key a `Map`. A set is a
/// value: `put` and `remove` answer a new set and leave the one given as it
/// was.
///
/// The element type needs equality, which the `=` in `Set(a=)` says: a set of
/// functions or addresses is a type error.
///
/// A set has no order. `toList`, `fold`, `forEach` and `find` give the
/// elements in an order that is not specified, and `map`, `filter`,
/// `filterMap`, `any` and `all` call their function for the elements in such an
/// order.
///
/// ## Examples
///
/// An element put in a set is in it:
///
/// ```ernest
/// Set.contains(Set.put(Set.empty, "a"), "a")
/// // => true
/// ```
///
/// The elements of one set that are not in another; a set has no order, so the
/// list is sorted to compare it:
///
/// ```ernest
/// List.sort(Set.toList(Set.difference(Set.fromList([1, 2, 3]), Set.fromList([2]))))
/// // => [1, 3]
/// ```
///
/// ## See also
///
/// `Map` for elements with values, `List.unique` for order kept.
///
/// since 0.1.0

/// The set with no elements.
export let empty : Set(a) = emptySet()

foreign fn emptySet() : Set(a) =
    "sets:new/0"

/// The number of elements.
///
/// ### Examples
///
/// ```ernest
/// #(Set.size(Set.fromList([1, 1, 2])), Set.isEmpty(Set.empty))
/// // => #(2, true)
/// ```
export foreign fn size(set : Set(a)) : Int =
    "sets:size/1"

/// `true` for the set with no elements.
export fn isEmpty(set : Set(a)) : Bool =
    size(set) == 0

/// `true` when `element` is in the set.
export fn contains(set : Set(a), element : a) : Bool =
    isElement(element, set)

foreign fn isElement(element : a, set : Set(a)) : Bool =
    "sets:is_element/2"

/// The set with `element` in it. A set that already holds it is answered as it
/// is.
export fn put(set : Set(a), element : a) : Set(a) =
    withElement(element, set)

foreign fn withElement(element : a, set : Set(a)) : Set(a) =
    "sets:add_element/2"

/// The set without `element`. A set that does not hold it is answered as it is.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.remove(Set.fromList([1, 2]), 2))
/// // => [1]
/// ```
export fn remove(set : Set(a), element : a) : Set(a) =
    withoutElement(element, set)

foreign fn withoutElement(element : a, set : Set(a)) : Set(a) =
    "sets:del_element/2"

/// The set of `f(x)` for each element `x`. Two elements `f` maps to equal
/// values become one, so the result may be smaller.
///
/// ### Examples
///
/// ```ernest
/// List.sort(Set.toList(Set.map(Set.fromList([1, 2]), fn(n) = n * 10)))
/// // => [10, 20]
/// ```
export fn map(set : Set(a), f : (a) -> b receiving e) : Set(b) receiving e =
    mapped(f, set)

foreign fn mapped(f : (a) -> b receiving e, set : Set(a)) : Set(b) receiving e =
    "sets:map/2"

/// The set of the elements `keep` answers `true` for.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.filter(Set.fromList([1, 2, 3]), fn(n) = n > 2))
/// // => [3]
/// ```
export fn filter(set : Set(a), keep : (a) -> Bool receiving e) : Set(a) receiving e =
    filtered(keep, set)

foreign fn filtered(keep : (a) -> Bool receiving e, set : Set(a)) : Set(a) receiving e =
    "sets:filter/2"

/// The set of the values `f` answers `Some` for; an element `f` answers `None`
/// for is left out.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.filterMap(Set.fromList(["1", "x"]), String.toInt))
/// // => [1]
/// ```
export fn filterMap(set : Set(a), f : (a) -> Optional(b) receiving e) : Set(b) receiving e =
    fromList(List.filterMap(toList(set), f))

/// The elements folded into one value. `step(acc, x)` is called with the given
/// `acc` for the first element met, and with what `step` answered before for
/// the rest. The order is unspecified, so `step` should give the same result in
/// any order.
///
/// ### Examples
///
/// ```ernest
/// Set.fold(Set.fromList([1, 2]), 0, fn(sum, n) = sum + n)
/// // => 3
/// ```
///
/// since 0.4.0
export fn fold(set : Set(a), acc : b, step : (b, a) -> b receiving e) : b receiving e =
    List.foldLeft(toList(set), acc, step)

/// Calls `f` for each element, for its effect, in unspecified order.
///
/// ### Examples
///
/// ```ernest
/// Set.forEach(Set.fromList(["a"]), Io.println)
/// // => Unit
/// ```
///
/// since 0.4.0
export fn forEach(set : Set(a), f : (a) -> Unit receiving e) : Unit receiving e =
    List.forEach(toList(set), f)

/// `true` when `test` holds for at least one element, and `false` for the empty
/// set.
///
/// ### Examples
///
/// ```ernest
/// #(Set.any(Set.fromList([1]), fn(n) = n > 0), Set.all(Set.fromList([1]), fn(n) = n > 1))
/// // => #(true, false)
/// ```
export fn any(set : Set(a), test : (a) -> Bool receiving e) : Bool receiving e =
    List.any(toList(set), test)

/// `true` when `test` holds for every element, and for the empty set.
export fn all(set : Set(a), test : (a) -> Bool receiving e) : Bool receiving e =
    List.all(toList(set), test)

/// An element `test` holds for, or `None` where there is none. Where it holds
/// for several, which one is answered is unspecified.
///
/// ### Examples
///
/// ```ernest
/// Set.find(Set.fromList([1, 2]), fn(n) = n > 1)
/// // => Some(2)
/// ```
export fn find(set : Set(a), test : (a) -> Bool receiving e) : Optional(a) receiving e =
    List.find(toList(set), test)

/// The set of the list's elements, each once.
export foreign fn fromList(list : List(a)) : Set(a) =
    "sets:from_list/1"

/// The elements, in unspecified order.
export foreign fn toList(set : Set(a)) : List(a) =
    "sets:to_list/1"

/// The set of the elements in either set.
///
/// ### Examples
///
/// ```ernest
/// List.sort(Set.toList(Set.union(Set.fromList([1]), Set.fromList([2]))))
/// // => [1, 2]
/// ```
export foreign fn union(set : Set(a), other : Set(a)) : Set(a) =
    "sets:union/2"

/// The set of the elements in both sets.
///
/// ### Examples
///
/// ```ernest
/// Set.toList(Set.intersection(Set.fromList([1, 2]), Set.fromList([2, 3])))
/// // => [2]
/// ```
export foreign fn intersection(set : Set(a), other : Set(a)) : Set(a) =
    "sets:intersection/2"

/// The elements of `set` that are not in `other`.
export foreign fn difference(set : Set(a), other : Set(a)) : Set(a) =
    "sets:subtract/2"

/// `true` when every element of `set` is in `other`. The empty set is a subset
/// of every set.
///
/// ### Examples
///
/// ```ernest
/// Set.isSubset(Set.fromList([1]), Set.fromList([1, 2]))
/// // => true
/// ```
export foreign fn isSubset(set : Set(a), other : Set(a)) : Bool =
    "sets:is_subset/2"
