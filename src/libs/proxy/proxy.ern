/// A proxy for a service a peer offers: one address for the service across
/// its end and its return.
///
/// The library stands on every job's load path, so a program names it with
/// no option (report Appendix G).
///
/// **What it does.** `start` spawns the proxy's process, which finds the
/// service and forwards to it each message it is sent, and answers the
/// proxy's address, which the program sends to. When the find fails, the
/// service ends or its node is lost, the process finds the service again
/// when the next message comes; a message that comes while a find is under
/// way waits for it and shares its outcome, so that one find is under way at
/// a time.
///
/// A message that comes while the service is away, and whose find fails,
/// goes to the last address held, where it is lost as a message to an ended
/// process is, or reaches the service where its node is back, and is lost
/// where none is held; a call through the proxy's address then answers `None`
/// at its own time, which says nothing of whether the request ran. A service
/// the configuration does not list is never found. A find that answers
/// `OtherType` is no absence but a protocol the two builds disagree on: the
/// process faults, naming the service, and the address is dead from then on.
///
/// At a shell prompt the caller is the input's process, which ends with the
/// input, so a proxy used from the prompt is started in a process that lives
/// on. The process ends with the process that called `start`.
///
/// **What it is not.** It is an ordinary process on the message's way: a
/// message through it may pass one sent to the service directly, and it
/// keeps nothing of a message it could not deliver. A program that is to
/// monitor the service itself holds the address `Peer.find` gives (report
/// §8.7, Appendix E.27).
///
/// ## Examples
///
/// A client of the counter, whose calls go to the counter wherever it is
/// back:
///
/// ```ernest
/// {
///     let service : Peer.Service(Int) = Peer.service("counter");
///     Proxy.start(service, 5000)
/// }
/// ```
///
/// since 0.4.0

// What the proxy's process takes: a message for the service, and the end
// of the service it holds or of the process that started it.
type ProxyMsg(m) = Message(m) | Went(Down)

// Where the next message goes (report Appendix G.7): to the service, found
// and monitored; to the address where it was last, which may have ended;
// or nowhere, where no find has given an address.
type Target(m) = Found(Address(m)) | Away(Address(m)) | Nowhere

/// Spawns the process of a proxy for `service`, and answers the proxy's
/// address. The process finds the service within `ms` milliseconds, and again
/// within `ms` at the first message after the find failed, the service ended
/// or its node was lost, a message that comes during a find sharing its
/// outcome, and forwards each message to the service. A message that comes
/// while the service is away and whose find fails goes to the last address
/// held, lost where that process has ended (report §6.2) and where none is
/// held; a call through the address then answers `None` at its own time. A find that answers
/// `OtherType` faults the process with a cause that names the service by its
/// name, `the service counter is offered at another type`. The process ends
/// with the process that called `start`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let service : Peer.Service(Int) = Peer.service("counter");
///     send(Proxy.start(service, 5000), 1)
/// }
/// // => Unit
/// ```
export fn start(service : Peer.Service(m), ms : Int) : Address(m) = {
    let caller = Process.current();
    let proxy = spawn(fn() : Unit receiving ProxyMsg(m) = {
        monitor(caller, Went);
        held(service, ms, caller, shared(found(service, ms, Nowhere)))
    });
    endsWithCaller(Process.fromAddress(proxy));
    adapted(proxy, Message)
}

// Report Appendix G.7, E.21: the proxy's process, told to the runtime as
// one the caller started to end with it, which `Process.owned` of the
// caller answers.
foreign fn endsWithCaller(process : Process) : Unit =
    "ern_rt:ends_with_caller/1"

// Where the next message goes: to the service where a find gives it,
// monitored from then on, and else where `away` says. A service offered at
// another type is no absence, and no later find mends it: the process
// faults.
fn found(service : Peer.Service(m), ms : Int, away : Target(m)) : Target(m) receiving ProxyMsg(m) =
    match Peer.find(service, ms) {
        Right(address) -> {
            monitor(Process.fromAddress(address), Went);
            Found(address)
        }
      | Left(Io.OtherType) ->
            fault("the service " <> Peer.name(service) <> " is offered at another type")
      | Left(_) ->
            away
    }

// The message sent where the target says, and lost where it says nowhere,
// as a message to an ended process is (report §6.2).
fn sent(target : Target(m), message : m) : Unit =
    match target {
        Found(address) or Away(address) -> send(address, message)
      | Nowhere -> Unit
    }

// The target a find gave, each message that came while the find was under
// way sent where it says first, so that one find is under way at a time:
// the messages the mailbox holds now, none waited for.
fn shared(target : Target(m)) : Target(m) receiving ProxyMsg(m) =
    receive {
        Message(message) -> {
            sent(target, message);
            shared(target)
        }
      | after 0 ->
            target
    }

// Each message forwarded, the service found again first where it is away
// or was never found, until the process that started this one ends.
fn held(service : Peer.Service(m),
        ms : Int,
        caller : Process,
        target : Target(m)) : Unit receiving ProxyMsg(m) =
    receive {
        Message(message) ->
            match target {
                Found(address) -> {
                    send(address, message);
                    held(service, ms, caller, target)
                }
              | _ -> {
                    let next = found(service, ms, target);
                    sent(next, message);
                    held(service, ms, caller, shared(next))
                }
            }
      | Went(down) ->
            if down.process == caller then
                Unit
            else
                held(service, ms, caller, without(target, down.process))
    }

// The target, away where the process that ended is the service.
fn without(target : Target(m), ended : Process) : Target(m) =
    match target {
        Found(address) when Process.fromAddress(address) == ended -> Away(address)
      | _ -> target
    }

//
// The tests (report §9.3), run by `ern test` as every library's are, in a
// program that is no node, where a find answers `NotListed` (report
// Appendix E.27): what a proxy does while its service is away. Its finding
// the service, and finding it again after the service's node restarts, are
// the real nodes' (test/ern_nodes_tests.erl). Regression tests, written
// after the code.
//

// A service's protocol, which carries a reply.
type Probe = Ask(Reply(Int))

// What the test of the process's end takes.
type Seen = Started(Process) | Ended(Down)

let away =
    Test.Case(name = "a call through a proxy whose service is away answers None", run = fn() = {
        let service : Peer.Service(Probe) = Peer.service("probe");
        let proxy = start(service, 100);
        let first = Address.call(proxy, Ask, 100);
        let second = Address.call(proxy, Ask, 100);
        Test.equal(#(first, second), #(None, None))
    })

let endsWithItsCaller =
    Test.Case(name = "a proxy's process ends with the process that started it", run = fn() = {
        let me = self();
        let starter = spawn(fn() : Unit receiving Unit = {
            let service : Peer.Service(Probe) = Peer.service("probe");
            send(me, Started(Process.fromAddress(start(service, 100))));
            receive {
                _ -> Unit
            }
        });
        receive {
            Started(proxy) -> {
                monitor(proxy, Ended);
                send(starter, Unit);
                receive {
                    Ended(down) -> Test.equal(down.reason, Returned)
                  | Started(_) -> Test.Failed("a second start")
                }
            }
          | Ended(_) ->
                Test.Failed("an end before the start")
        }
    })
