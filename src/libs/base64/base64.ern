/// Bytes written as text in the base 64 encoding of RFC 4648, and the text
/// read back as the bytes.
///
/// Use it where a protocol or a format carries bytes as text, as an HTTP
/// header's credentials or a WebSocket handshake's key are carried. For
/// bytes a person reads, `Bytes.toHex` writes two hexadecimal digits a
/// byte.
///
/// The library stands on every job's load path, so a program names it with
/// no option (report Appendix G).
///
/// **The alphabet.** `encode` writes the standard alphabet, `A` to `Z`, `a`
/// to `z`, `0` to `9`, `+` and `/`, each character six bits of the bytes,
/// and pads the text with `=` to a multiple of four characters. The
/// alphabet of URLs and file names, with `-` and `_` for `+` and `/`, is
/// neither written nor read, and neither is a text without its padding.
///
/// **Reading.** `decode` reads the texts `encode` writes and no other. It
/// answers `None` for a character outside the alphabet, white space and
/// line breaks among them; for a count of characters that is no multiple of
/// four; for a `=` anywhere but as the last one or two characters; and for
/// a last character before a `=` that sets a bit the bytes do not use, as
/// `Zh==` does, where `encode` writes `Zg==`. `decode(encode(bytes))` is
/// `Some(bytes)`.
///
/// ## Examples
///
/// Text written in base 64:
///
/// ```ernest
/// Base64.encode(String.toUtf8("Ernest"))
/// // => "RXJuZXN0"
/// ```
///
/// The text read back:
///
/// ```ernest
/// Optional.andThen(Base64.decode("RXJuZXN0"), String.fromUtf8)
/// // => Some("Ernest")
/// ```
///
/// ## See also
///
/// `Bytes` (Appendix E.20) for the bytes in hexadecimal.
///
/// since 0.9.0

/// `bytes` in base 64, four characters for each three bytes, and for the
/// one or two bytes left at the end four characters that end in two `=` or
/// one.
///
/// The empty bytes are the empty text.
///
/// ### Examples
///
/// ```ernest
/// #(Base64.encode(<<102>>), Base64.encode(<<102, 111>>), Base64.encode(<<251, 255, 191>>))
/// // => #("Zg==", "Zm8=", "+/+/")
/// ```
export foreign fn encode(bytes : Bytes) : String =
    "base64:encode/1"

/// The bytes that `text` writes in base 64, or `None` where `text` is not
/// what `encode` writes of any bytes.
///
/// The empty text is the empty bytes.
///
/// ### Examples
///
/// ```ernest
/// #(Base64.decode("Zm8="), Base64.decode("Zm8"), Base64.decode("Zm-v"))
/// // => #(Some(<<102, 111>>), None, None)
/// ```
export fn decode(text : String) : Optional(Bytes) =
    if isWritten(String.toUtf8(text)) then Some(decoded(text)) else None

// Report Appendix G.8: the host's reading of a text `encode` writes, on
// which it raises nothing. The host skips white space and drops the bits a
// `=` leaves unused, which `isWritten` has refused.
foreign fn decoded(text : String) : Bytes =
    "base64:decode/1"

// Report Appendix G.8: whether the bytes are a text `encode` writes, four
// characters at a time, the last four being how `encode` ends a text.
fn isWritten(bytes : Bytes) : Bool = {
    let size = Bytes.size(bytes);
    match bytes {
        <<before:size(size - 4)-bytes, a, b, c, d>> ->
            size % 4 == 0 && isEnd(a, b, c, d) && isCharacters(before)
      | <<>> ->
            true
      | _ ->
            false // fewer than four characters
    }
}

// Whether every byte is a character of the alphabet.
fn isCharacters(bytes : Bytes) : Bool =
    match bytes {
        <<byte, rest:bytes>> -> isCharacter(byte) && isCharacters(rest)
      | _ -> true
    }

// Whether four characters end a text as `encode` ends one: four of the
// alphabet; three and a `=`, the third's last two bits clear; or two and
// two `=`, the second's last four bits clear. Clear bits are RFC 4648's
// canonical encoding (section 3.5).
fn isEnd(a : Int, b : Int, c : Int, d : Int) : Bool =
    if d != 0x3D then
        isCharacter(a) && isCharacter(b) && isCharacter(c) && isCharacter(d)
    else if c != 0x3D then
        isCharacter(a) && isCharacter(b) && isClear(c, 4)
    else
        isCharacter(a) && isClear(b, 16)

// Whether the byte is a character of the standard alphabet (RFC 4648,
// section 4).
fn isCharacter(byte : Int) : Bool =
    byte >= 0x41 && byte <= 0x5A
        || byte >= 0x61 && byte <= 0x7A
        || byte >= 0x30 && byte <= 0x39
        || byte == 0x2B
        || byte == 0x2F

// Whether the byte is a character whose place in the alphabet is a multiple
// of `multiple`, the bits below it clear.
fn isClear(byte : Int, multiple : Int) : Bool =
    match place(byte) {
        Some(bits) -> bits % multiple == 0
      | None -> false
    }

// A character's place in the standard alphabet, its six bits, or `None`
// for a byte that is no character of it.
fn place(byte : Int) : Optional(Int) =
    if byte >= 0x41 && byte <= 0x5A then
        Some(byte - 0x41)
    else if byte >= 0x61 && byte <= 0x7A then
        Some(byte - 0x61 + 26)
    else if byte >= 0x30 && byte <= 0x39 then
        Some(byte - 0x30 + 52)
    else if byte == 0x2B then
        Some(62)
    else if byte == 0x2F then
        Some(63)
    else
        None

//
// The tests (report §9.3), run by `ern test` as every library's are. They
// are regression tests, written with the code, from RFC 4648 and from what
// probing the host showed of the texts its decoder reads that `encode`
// does not write.
//

// RFC 4648's test vectors (§10), the plain texts and their encodings.
let plainTexts = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]

let encodedTexts = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]

// report Appendix G.8
let vectorsEncoded =
    Test.Case(name = "encode writes RFC 4648's test vectors",
              run = fn() =
                  Test.equal(List.map(plainTexts, fn(text) = encode(String.toUtf8(text))),
                             encodedTexts))

// report Appendix G.8
let vectorsDecoded =
    Test.Case(name = "decode reads RFC 4648's test vectors",
              run = fn() =
                  Test.equal(List.map(encodedTexts, decode),
                             List.map(plainTexts, fn(text) = Some(String.toUtf8(text)))))

// report Appendix G.8
let lastCharacters =
    Test.Case(name = "the standard alphabet's last two characters are + and /",
              run = fn() =
                  Test.equal(#(encode(<<251, 255, 191>>), decode("+/+/")),
                             #("+/+/", Some(<<251, 255, 191>>))))

// report Appendix G.8: each of the four characters the host's decoder
// skips, in a text whose count is a multiple of four.
let whiteSpace =
    Test.Case(name = "a text with white space is refused",
              run = fn() =
                  Test.equal(read(["Zm9v    ", "Zm\t\t\t\t9v", "Zg==\r\n\r\n", "Z  g=  ="]), []))

// report Appendix G.8: the URL alphabet's two characters, a letter outside
// ASCII and a control character.
let outsideAlphabet =
    Test.Case(name = "a character outside the standard alphabet is refused",
              run = fn() =
                  Test.equal(read(["Zm-v", "Zm_v", "Zm9\u{e9}", "Zm9v\u{b}\u{b}\u{b}\u{b}"]), []))

// report Appendix G.8
let count =
    Test.Case(name = "a count of characters that is no multiple of four is refused",
              run = fn() = Test.equal(read(["Z", "Zg", "Zg=", "Zm9vY"]), []))

// report Appendix G.8
let padding =
    Test.Case(name = "a = anywhere but as the last one or two characters is refused",
              run = fn() =
                  Test.equal(read(["Zg===", "Z===", "====", "Zm=v", "=Zm9", "Zg==Zg=="]), []))

// report Appendix G.8: a text encode does not write, which the host's
// decoder reads as encode's Zg== and Zm8=.
let unusedBits =
    Test.Case(name = "a bit the bytes do not use, set before a =, is refused",
              run = fn() = Test.equal(read(["Zh==", "Zm9="]), []))

// The standard alphabet, RFC 4648's (section 4).
let alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// report Appendix G.8: of every text of four characters that begins with
// `Q`, its other three each a character of the alphabet, `=` or a space,
// those `encode` writes are read, 64^3 of three bytes, 64 * 16 of two and 4
// of one, and every other is refused.
let exactlyWritten =
    Test.Case(name = "of the texts of four characters after Q, those encode writes are read",
              run = fn() = {
                  let characters =
                      List.map(String.toList(alphabet <> "= "), fn(char) = String.fromList([char]));
                  let texts =
                      extended(extended(extended(["Q"], characters), characters), characters);
                  let read =
                      List.filterMap(texts,
                                     fn(text) =
                                         Optional.map(decode(text), fn(bytes) = #(text, bytes)));
                  Test.equal(#(List.size(read),
                               List.filter(read, fn(#(text, bytes)) = encode(bytes) != text)),
                             #(64 * 64 * 64 + 64 * 16 + 4, []))
              })

// report Appendix G.8: every count of bytes from 0 to 256, so that each
// byte's value and each count left over from three are written.
let readBack =
    Test.Case(name = "decode reads what encode writes as the bytes it was written from",
              run = fn() = {
                  let all = Optional.withDefault(Bytes.fromList(List.range(0, 255)), <<>>);
                  let parts = List.map(List.range(0, 256), fn(end) = Bytes.slice(all, 0, end));
                  Test.equal(List.map(parts, fn(bytes) = decode(encode(bytes))),
                             List.map(parts, Some))
              })

// Each of the prefixes with each of the characters after it.
fn extended(prefixes : List(String), characters : List(String)) : List(String) =
    List.flatMap(prefixes, fn(prefix) = List.map(characters, fn(character) = prefix <> character))

// The texts of `texts` that `decode` reads, which a case of refused texts
// expects to be none.
fn read(texts : List(String)) : List(String) =
    List.filter(texts, fn(text) = Optional.isSome(decode(text)))
