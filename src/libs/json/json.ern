/// JSON text, read into a value and written from one, as RFC 8259 defines
/// it, by the host's `json` module.
///
/// Use it where a program reads or writes JSON, a file of settings or what
/// a web service sends: `parse` reads a text into a `Value`, `format` writes
/// a `Value` as text laid out over lines, and `encode` writes it on one line.
///
/// The library stands on every job's load path, so a program names it with
/// no option (report Appendix G).
///
/// **Numbers.** A number written with neither a fraction nor an exponent is
/// an `Integer`, of any size the host can hold, and one written with either
/// is a `Real`: `1` is `Integer(1)`, and `1.0` and `1e0` are `Real(1.0)`. A
/// `Real` nearer to zero than a `Float` can hold is `0.0`, and so is `-0.0`,
/// since a `Float` has no negative zero (report §3.1). An integer longer than
/// the host can hold, and a real larger than a `Float` can hold, are not
/// read.
///
/// **Objects.** An object is a `Map` from its members' names to their
/// values. Where a text names a member twice, the last is kept, as
/// `Map.fromList` keeps a later pair. `format` and `encode` write the
/// members in the order of their names' code points, an order of this
/// library's, which the host's `json` module leaves to its caller.
///
/// **Errors.** A text that holds no value is an `Error`: the text ends
/// inside its value, a byte stands where none may, or a sequence writes no
/// character or a number the host cannot hold. A byte and a sequence carry
/// their `Position`, the line and the column they begin at, counted as a
/// diagnostic counts them (report §11.5).
///
/// **Reading back.** `parse` reads what `format` and `encode` write as the
/// value it was written from.
///
/// ## Examples
///
/// A member of an object read:
///
/// ```ernest
/// match Json.parse("{\"name\": \"desk\", \"port\": 4001}") {
///     Right(Json.Object(members)) -> Map.get(members, "port")
///   | _ -> None
/// }
/// // => Some(Json.Integer(4001))
/// ```
///
/// An object written:
///
/// ```ernest
/// Json.format(Json.Object(Map.fromList([#("port", Json.Integer(4001)),
///                                       #("name", Json.Text("desk"))])))
/// // => "{\n  \"name\": \"desk\",\n  \"port\": 4001\n}\n"
/// ```
///
/// ## See also
///
/// `Map` for an object's members, `String` for the text a value is read from
/// and written to.
///
/// since 0.4.0

/// A JSON value: `null`, `true` or `false`, a number, a string, an array or
/// an object.
///
/// ### Examples
///
/// ```ernest
/// Json.parse("[null, true, 2]")
/// // => Right(Json.Array([Json.Null, Json.Boolean(true), Json.Integer(2)]))
/// ```
///
/// ```ernest
/// Json.parse("[2.5, \"x\", []]")
/// // => Right(Json.Array([Json.Real(2.5), Json.Text("x"), Json.Array([])]))
/// ```
export type Value =
    Null
  | Boolean(Bool)
  | Integer(Int)
  | Real(Float)
  | Text(String)
  | Array(List(Value))
  | Object(Map(String, Value))

/// Where an error begins: its line and its column, counted as a diagnostic
/// counts them (report §11.5), from 1, a line ending at a line feed and a
/// column a code point.
///
/// ### Examples
///
/// ```ernest
/// Json.parse("{\n  \"é\": x\n}")
/// // => Left(Json.UnexpectedByte(byte = 120, at = Json.Position(line = 2, column = 8)))
/// ```
///
/// since 0.9.0
export type Position = Position(line : Int, column : Int)

/// Why a text holds no JSON value, as the host's `json` finds it, and where.
/// `UnexpectedEnd` is a text that ends inside its value or holds none.
/// `UnexpectedByte` is a byte that cannot stand where it is, the first of
/// its character's, a second value, a comma before a closing bracket, a
/// character no value begins with, or the first that differs from the
/// `true`, `false` or `null` it breaks off, and its position.
///
/// `UnexpectedSequence` is an escape that writes no character, a
/// surrogate's escape without its pair's and one broken off before its four
/// digits among them, or a number the host cannot hold, an integer too long
/// or a real larger than a `Float` can hold, and its position.
///
/// The sequence is the host's spelling of it: an escape as the text writes
/// it, up to the byte that breaks it where one does, `\u12` of `"\u12"`;
/// an integer as the text writes it, and a real with a fraction too; but a
/// real with an exponent and no fraction with `.0` before the exponent and
/// its `e` in lower case, `1.0e400` for `1E400`.
///
/// ### Examples
///
/// ```ernest
/// Json.parse("[1, 2,]")
/// // => Left(Json.UnexpectedByte(byte = 93, at = Json.Position(line = 1, column = 7)))
/// ```
///
/// A real larger than a `Float` can hold, in the host's spelling:
///
/// ```ernest
/// Json.parse("[1E400]")
/// // => Left(Json.UnexpectedSequence(text = "1.0e400", at = Json.Position(line = 1, column = 2)))
/// ```
export type Error =
    UnexpectedEnd
  | UnexpectedByte(byte : Int, at : Position)
  | UnexpectedSequence(text : String, at : Position)

/// The value `text` writes, or why it writes none. White space may stand
/// before the value and after it, and nothing else may.
///
/// ### Examples
///
/// ```ernest
/// Json.parse(" 4001 ")
/// // => Right(Json.Integer(4001))
/// ```
///
/// ```ernest
/// Json.parse("4001 4002")
/// // => Left(Json.UnexpectedByte(byte = 52, at = Json.Position(line = 1, column = 6)))
/// ```
export fn parse(text : String) : Either(Error, Value) = {
    let bytes = String.toUtf8(text);
    match decoded(text) {
        Decoded(=value, =rest) ->
            match afterWhiteSpace(rest) {
                <<byte, _:bytes>> as trailing ->
                    Left(UnexpectedByte(=byte, at = position(bytes, indexOfRest(bytes, trailing))))
              | _ ->
                    Right(value)
            }
      | IntegerTooLong(=digits) -> {
            let index = numberIndex(bytes, bytes, String.toUtf8(digits));
            Left(UnexpectedSequence(text = digits, at = position(bytes, index)))
        }
      | EndMet ->
            Left(match loneEscape(bytes, bytes) {
                Some(#(escape, end)) ->
                    lone(bytes, escape, end)
              | None ->
                    match firstBroken(bytes, bytes) {
                        Some(broken) -> broken.error
                      | None -> UnexpectedEnd
                    }
            })
      | InvalidByte(=byte, =index) ->
            Left(match loneEscape(bytes, bytes) {
                Some(#(escape, end)) when end == index ->
                    lone(bytes, escape, end)
              | _ ->
                    match firstBroken(bytes, bytes) {
                        Some(broken) when broken.kind == Literal && broken.index + 1 == index ->
                            broken.error
                      | _ ->
                            UnexpectedByte(=byte, at = position(bytes, index))
                    }
            })
      | InvalidSequence(text = sequence, =index) ->
            Left(match firstBroken(bytes, bytes) {
                Some(broken) when broken.kind == Escape
                    && broken.index >= index
                    && broken.index < index + String.size(sequence) -> broken.error
              | _ -> UnexpectedSequence(text = sequence, at = position(bytes, index))
            })
    }
}

// The host's reading of a text: the value and the text after it, white
// space among it; or what the host raised, and the index of the byte or
// the sequence it raised at. An integer longer than the host holds is
// raised with no index.
type Decoded =
    Decoded(value : Value, rest : Bytes)
  | EndMet
  | InvalidByte(byte : Int, index : Int)
  | InvalidSequence(text : String, index : Int)
  | IntegerTooLong(digits : String)

// Report Appendix G.6: the host's `json:decode`, which raises on a text it
// cannot read and builds terms no Ernest type describes.
foreign fn decoded(text : String) : Decoded =
    "ern_json:decode/1"

// The index at which `rest`, the text from some byte on, begins.
fn indexOfRest(text : Bytes, rest : Bytes) : Int =
    Bytes.size(text) - Bytes.size(rest)

// The bytes after their JSON white space (RFC 8259, section 2).
fn afterWhiteSpace(bytes : Bytes) : Bytes =
    match bytes {
        <<byte, rest:bytes>> when byte == 0x20 || byte == 0x09 || byte == 0x0A || byte == 0x0D ->
            afterWhiteSpace(rest)
      | _ ->
            bytes
    }

// Report Appendix G.6: the line and the column the byte at `index`
// begins, counted as a diagnostic's are (report §11.5): from 1, a line
// ending at a line feed and a column a code point.
fn position(text : Bytes, index : Int) : Position = {
    let lines = Bytes.split(Bytes.slice(text, 0, index), <<'\n':utf8>>);
    let last = Optional.withDefault(List.last(lines), <<>>); // a split answers one part at least
    Position(line = List.size(lines), column = 1 + codePoints(last, 0))
}

// The code points of UTF-8 bytes, a byte from 0x80 to 0xBF continuing
// the one before it.
fn codePoints(bytes : Bytes, count : Int) : Int =
    match bytes {
        <<byte, rest:bytes>> when byte >= 0x80 && byte < 0xC0 -> codePoints(rest, count)
      | <<_, rest:bytes>> -> codePoints(rest, count + 1)
      | _ -> count
    }

// Report Appendix G.6: the index of the integer `digits` writes, which the
// host could not hold: the first number outside a string that begins with
// the digits and goes on with no digit, point or exponent, since an earlier
// integer of the digits would have been raised on first, and a real that
// holds them is no integer. A number is compared only where it begins, and
// passed whole where it is not the one, so the text is read once.
fn numberIndex(text : Bytes, here : Bytes, digits : Bytes) : Int =
    match here {
        <<'"':utf8, rest:bytes>> ->
            numberIndex(text, afterString(rest), digits)
      | <<byte, _:bytes>> when isNumberByte(byte) ->
            if isWritten(here, digits) then
                indexOfRest(text, here)
            else
                numberIndex(text, afterNumber(here), digits)
      | <<_, rest:bytes>> ->
            numberIndex(text, rest, digits)
      | _ ->
            fault("the integer the host could not hold is not in the text")
    }

// Whether a byte may stand in a number, which a number outside a string is
// a run of.
fn isNumberByte(byte : Int) : Bool =
    isDigit(byte) || byte == 0x2E || byte == 0x65 || byte == 0x45 || byte == 0x2B || byte == 0x2D

fn isDigit(byte : Int) : Bool =
    byte >= 0x30 && byte <= 0x39

// Whether the number `here` begins with is the integer `digits` writes.
fn isWritten(here : Bytes, digits : Bytes) : Bool = {
    let size = Bytes.size(digits);
    match here {
        <<written:size(size)-bytes, byte, _:bytes>> when written == digits ->
            !isDigit(byte) && byte != 0x2E && byte != 0x65 && byte != 0x45
      | <<written:size(size)-bytes>> ->
            written == digits
      | _ ->
            false
    }
}

fn afterNumber(bytes : Bytes) : Bytes =
    match bytes {
        <<byte, rest:bytes>> when isNumberByte(byte) -> afterNumber(rest)
      | _ -> bytes
    }

// The text after a string, from the byte after its opening quote: a
// backslash escapes the byte after it, a quote among them.
fn afterString(bytes : Bytes) : Bytes =
    match bytes {
        <<'\\':utf8, _, rest:bytes>> -> afterString(rest)
      | <<'"':utf8, rest:bytes>> -> rest
      | <<_, rest:bytes>> -> afterString(rest)
      | _ -> <<>>
    }

// Report Appendix G.6: a high surrogate's escape that no low one's follows,
// as `UnexpectedSequence` of its six bytes, as the host answers a lone low
// surrogate. The host answers it as the text's end where fewer than an
// escape's bytes follow it, and as the byte after it where more do.
fn lone(text : Bytes, escape : Bytes, end : Int) : Error =
    UnexpectedSequence(text = String.fromUtf8Lossy(escape),
                       at = position(text, end - Bytes.size(escape)))

// The first escape of a high surrogate inside a string that no low one's
// follows, and its end, the index of the byte after it, or `None`: the
// strings are read in turn and an escape by its bytes. Where the text ends
// inside an escape a low one's could be, there is none.
fn loneEscape(text : Bytes, here : Bytes) : Optional(#(Bytes, Int)) =
    match here {
        <<'"':utf8, rest:bytes>> -> loneInString(text, rest)
      | <<_, rest:bytes>> -> loneEscape(text, rest)
      | _ -> None
    }

fn loneInString(text : Bytes, here : Bytes) : Optional(#(Bytes, Int)) =
    match here {
        <<'"':utf8, rest:bytes>> ->
            loneEscape(text, rest)
      | <<'\\':utf8, 'u':utf8, hex:size(4)-bytes, rest:bytes>> ->
            match #(surrogate(hex), rest) {
                #(High, <<'\\':utf8, 'u':utf8, next:size(4)-bytes, beyond:bytes>>) ->
                    if surrogate(next) == Low then
                        loneInString(text, beyond)
                    else
                        loneInString(text, rest)
              | #(High, _) ->
                    if isEscapeBegun(rest) then
                        None
                    else
                        Some(#(<<'\\':utf8, 'u':utf8, hex:bytes>>, indexOfRest(text, rest)))
              | _ ->
                    loneInString(text, rest)
            }
      | <<'\\':utf8, _, rest:bytes>> ->
            loneInString(text, rest)
      | <<_, rest:bytes>> ->
            loneInString(text, rest)
      | _ ->
            None
    }

// Whether the bytes end inside an escape a low surrogate's could be.
fn isEscapeBegun(bytes : Bytes) : Bool =
    match bytes {
        <<>> -> true
      | <<'\\':utf8>> -> true
      | <<'\\':utf8, 'u':utf8, part:bytes>> -> Bytes.size(part) < 4
      | _ -> false
    }

// A UTF-16 code unit's kind: a high surrogate, a low one, or neither.
type Surrogate = High | Low | Neither

// The kind of the code unit four bytes write in hexadecimal.
fn surrogate(hex : Bytes) : Surrogate =
    match Optional.andThen(String.fromUtf8(hex), fn(digits) = String.toIntBase(digits, 16)) {
        Some(unit) when unit >= 0xD800 && unit <= 0xDBFF -> High
      | Some(unit) when unit >= 0xDC00 && unit <= 0xDFFF -> Low
      | _ -> Neither
    }

// A literal, `true`, `false` or `null`, or an escape `\u`.
type Kind = Literal | Escape

// A literal or an escape a byte breaks off, the index it begins at and
// the error it is.
type Broken = Broken(kind : Kind, index : Int, error : Error)

// Report Appendix G.6: the first literal outside a string that a byte of
// the text differs from, or the first escape `\u` inside one that a byte
// breaks before its four hexadecimal digits, or `None`. A literal broken
// off is the first byte that differs from it, and an escape the escape as
// the text writes it up to the byte that breaks it. Outside a string a
// `t`, an `f` or an `n` begins a literal and nothing else, and a literal
// or an escape the text ends inside is broken by no byte.
//
// The host answers a literal by the count of bytes after its first, the
// text's end where no more follow than the rest of the literal's and the
// byte after its first where more do; and an escape by the count after its
// `u`, the text's end where fewer than four follow and the six bytes from
// its backslash, past the string's end among them, where more do. So the
// host's answer stands where none is broken, or where the one broken is
// not the one the host stopped at.
fn firstBroken(text : Bytes, here : Bytes) : Optional(Broken) =
    match here {
        <<'"':utf8, rest:bytes>> -> brokenInString(text, rest)
      | <<'t':utf8, _:bytes>> -> fromLiteral(text, here, String.toUtf8("true"))
      | <<'f':utf8, _:bytes>> -> fromLiteral(text, here, String.toUtf8("false"))
      | <<'n':utf8, _:bytes>> -> fromLiteral(text, here, String.toUtf8("null"))
      | <<_, rest:bytes>> -> firstBroken(text, rest)
      | _ -> None
    }

// How bytes begin against a literal: with it whole, ended inside it, or
// with a byte that differs from it, at its index.
type Against = Whole | EndedInside | Differs(index : Int, byte : Int)

// The first literal or escape a byte breaks, from the bytes on, which begin
// with a literal's first byte.
fn fromLiteral(text : Bytes, here : Bytes, literal : Bytes) : Optional(Broken) =
    match against(here, literal, 0) {
        Whole ->
            firstBroken(text, Bytes.drop(here, Bytes.size(literal)))
      | EndedInside ->
            None
      | Differs(=index, =byte) -> {
            let literalIndex = indexOfRest(text, here);
            Some(Broken(kind = Literal,
                        index = literalIndex,
                        error = UnexpectedByte(=byte, at = position(text, literalIndex + index))))
        }
    }

fn against(here : Bytes, literal : Bytes, index : Int) : Against =
    match literal {
        <<expected, more:bytes>> ->
            match here {
                <<byte, rest:bytes>> ->
                    if byte == expected then
                        against(rest, more, index + 1)
                    else
                        Differs(=index, =byte)
              | _ ->
                    EndedInside
            }
      | _ ->
            Whole
    }

fn brokenInString(text : Bytes, here : Bytes) : Optional(Broken) =
    match here {
        <<'"':utf8, rest:bytes>> ->
            firstBroken(text, rest)
      | <<'\\':utf8, 'u':utf8, rest:bytes>> -> {
            let count = hexDigits(rest, 0);
            if count == 4 then
                brokenInString(text, Bytes.drop(rest, 4))
            else if count == Bytes.size(rest) then
                None
            else {
                let index = indexOfRest(text, here);
                let escape = String.fromUtf8Lossy(Bytes.slice(here, 0, 2 + count));
                Some(Broken(kind = Escape,
                            =index,
                            error = UnexpectedSequence(text = escape, at = position(text, index))))
            }
        }
      | <<'\\':utf8, _, rest:bytes>> ->
            brokenInString(text, rest)
      | <<_, rest:bytes>> ->
            brokenInString(text, rest)
      | _ ->
            None
    }

// How many of an escape's four digits the bytes begin with.
fn hexDigits(bytes : Bytes, count : Int) : Int =
    match bytes {
        <<byte, rest:bytes>> when count < 4 && isHexDigit(byte) -> hexDigits(rest, count + 1)
      | _ -> count
    }

fn isHexDigit(byte : Int) : Bool =
    isDigit(byte) || byte >= 0x61 && byte <= 0x66 || byte >= 0x41 && byte <= 0x46

/// `value` as JSON text, laid out over lines as the host's `json:format`
/// lays it out, two spaces to a level, an object's members in the order of
/// their names' code points, and ending in a line feed. In a text it writes
/// `"` and `\` as `\"` and `\\`; a line feed, a carriage return, a tab, a
/// backspace and a form feed as `\n`, `\r`, `\t`, `\b` and `\f`; every
/// other character below U+0020 as `\u` and four uppercase hexadecimal
/// digits; and every other character as itself, U+007F and `/` among them.
///
/// ### Examples
///
/// ```ernest
/// Json.format(Json.Array([Json.Integer(1), Json.Null]))
/// // => "[1,null]\n"
/// ```
///
/// A text's characters, U+0000 escaped and U+007F not:
///
/// ```ernest
/// Json.format(Json.Text("a\u{0}\u{7f}\t/"))
/// // => "\"a\\u0000\u{7F}\\t/\"\n"
/// ```
export foreign fn format(value : Value) : String =
    "ern_json:format/1"

/// `value` as JSON text on one line, as the host's `json:encode` writes it,
/// with no white space between its parts and no line feed after it. An
/// object's members come in the order of their names' code points, and a
/// text is written as `format` writes it.
///
/// ### Examples
///
/// ```ernest
/// Json.encode(Json.Object(Map.fromList([#("tags", Json.Array([Json.Text("a"), Json.Null])),
///                                       #("port", Json.Integer(4001))])))
/// // => "{\"port\":4001,\"tags\":[\"a\",null]}"
/// ```
///
/// since 0.10.0
export foreign fn encode(value : Value) : String =
    "ern_json:encode/1"

//
// The tests (report §9.3), run by `ern test` as every library's are. They
// were written after the code, from the host's page and from what probing
// the host showed of the edges it does not state.
//

// report Appendix G.6: a regression test: the first was kept, where every
// `fromList` keeps the last; the three members show that the last wins
// wherever the others stand.
let duplicateName =
    Test.Case(name = "a member named twice keeps the last, as Map.fromList does",
              run = fn() =
                  Test.equal(parse("{\"a\": 1, \"b\": 0, \"a\": 2}"),
                             Right(Object(Map.fromList([#("a", Integer(2)), #("b", Integer(0))])))))

// report Appendix G.6
let numbers =
    Test.Case(name = "an integer of any size, and a real nearer zero than a Float is 0.0",
              run = fn() =
                  Test.equal(parse("[123456789012345678901234567890, -0, -0.0, 1e-400]"),
                             Right(Array([Integer(123456789012345678901234567890),
                                          Integer(0),
                                          Real(0.0),
                                          Real(0.0)]))))

// report Appendix G.6: a real of no fraction in the host's spelling, and
// one of a fraction in the text's.
let tooLarge =
    Test.Case(name = "a real larger than a Float can hold is not read",
              run = fn() =
                  Test.equal([parse("1e400"), parse("[1E+400]"), parse("[1.5E400]")],
                             [Left(UnexpectedSequence(text = "1.0e400",
                                                      at = Position(line = 1, column = 1))),
                              Left(UnexpectedSequence(text = "1.0e+400",
                                                      at = Position(line = 1, column = 2))),
                              Left(UnexpectedSequence(text = "1.5E400",
                                                      at = Position(line = 1, column = 2)))]))

// report Appendix G.6
let escapes =
    Test.Case(name = "an escaped pair of surrogates is one character, and one alone is no text",
              run = fn() =
                  Test.equal(#(parse("\"\\ud83d\\ude00 \\u00e9\""), parse("\"\\udc00\"")),
                             #(Right(Text("\u{1f600} é")),
                               Left(UnexpectedSequence(text = "\\udc00",
                                                       at = Position(line = 1, column = 2))))))

// report Appendix G.6
let loneSurrogate =
    Test.Case(name = "a high surrogate's escape without a low one's after it writes no character",
              run = fn() = {
                  let lone =
                      fn(column) =
                          Left(UnexpectedSequence(text = "\\ud800",
                                                  at = Position(line = 1, =column)));
                  Test.equal([parse("\"\\ud800\""),
                              parse("[\"\\ud800 and more\", 1]"),
                              parse("[x, \"\\ud800 and more\"]"),
                              parse("\"\\ud800\\n\""),
                              parse("\"\\ud800"),
                              parse("\"\\\\ud800\"")],
                             [lone(2),
                              lone(3),
                              Left(UnexpectedByte(byte = 120, at = Position(line = 1, column = 2))),
                              lone(2),
                              Left(UnexpectedEnd),
                              Right(Text("\\ud800"))])
              })

// report Appendix G.6
let tooLong =
    Test.Case(name = "a too-long integer is not read, and is found past a string holding it",
              run = fn() = {
                  let digits = String.repeat("9", 1300000);
                  let sequence =
                      fn(column) =
                          Left(UnexpectedSequence(text = digits, at = Position(line = 1, =column)));
                  Test.equal(#(parse(digits), parse("[\"" <> digits <> "\", " <> digits <> "]")),
                             #(sequence(1), sequence(1300006)))
              })

// report Appendix G.6: a regression test: the digits were looked for at
// every byte outside a string, and found inside the real, at its fraction
// or after its first digit.
let tooLongAfterReal =
    Test.Case(name = "a too-long integer is found past a real holding its digits", run = fn() = {
        let digits = String.repeat("9", 1300000);
        let sequence =
            fn(column) = Left(UnexpectedSequence(text = digits, at = Position(line = 1, =column)));
        Test.equal(#(parse("[0." <> digits <> ", " <> digits <> "]"),
                     parse("[1" <> digits <> "e-1300000, " <> digits <> "]")),
                   #(sequence(1300006), sequence(1300014)))
    })

// report Appendix G.6: a regression test, written after the code: a real
// that begins with the digits and goes on with a fraction or an exponent
// is no integer of them, though the host can hold it.
let tooLongAfterItsDigits =
    Test.Case(name = "a too-long integer is found past a real that begins with its digits",
              run = fn() = {
                  let digits = String.repeat("9", 1300000);
                  let sequence =
                      fn(column) =
                          Left(UnexpectedSequence(text = digits, at = Position(line = 1, =column)));
                  Test.equal(#(parse("[" <> digits <> "e-1300000, " <> digits <> "]"),
                               parse("[" <> digits <> ".5e-1300000, " <> digits <> "]")),
                             #(sequence(1300013), sequence(1300015)))
              })

// report Appendix G.6: a regression test: the digits were compared at every
// byte of the real, each comparison running to the real's end, and the
// parse took 31 seconds; read once, the text takes a tenth of a second,
// most of it the column counted.
let tooLongReadOnce =
    Test.Case(name = "a too-long integer after a real one digit shorter is found reading once",
              run = fn() = {
                  let digits = String.repeat("9", 1300000);
                  Test.equal(parse("[0." <> String.repeat("9", 1299999) <> ", " <> digits <> "]"),
                             Left(UnexpectedSequence(text = digits,
                                                     at = Position(line = 1, column = 1300005))))
              })

// report Appendix G.6: a regression test: the host answered the end of
// the text where few bytes followed the literal's first, and the byte after
// its first where more did.
let brokenLiteral =
    Test.Case(name = "a literal broken off is the first byte that differs from it", run = fn() = {
        let byte =
            fn(code, line, column) =
                Left(UnexpectedByte(byte = code, at = Position(=line, =column)));
        Test.equal([parse("[t]"),
                    parse("[tru, 1]"),
                    parse("[nul]"),
                    parse("[\n\n nul]"),
                    parse("[falsy]"),
                    parse("[true, false, nulL]"),
                    parse("[\"tru\", tru]"),
                    parse("[tru"),
                    parse("fals")],
                   [byte(93, 1, 3),
                    byte(44, 1, 5),
                    byte(93, 1, 5),
                    byte(93, 3, 5),
                    byte(121, 1, 6),
                    byte(76, 1, 18),
                    byte(93, 1, 12),
                    Left(UnexpectedEnd),
                    Left(UnexpectedEnd)])
    })

// report Appendix G.6: a regression test: the host answered the end of
// the text where fewer than four bytes followed the escape's `u`, and its
// six bytes from the backslash, past the string's end, where more did.
let brokenEscape =
    Test.Case(name = "an escape broken off is written up to the byte that breaks it", run = fn() = {
        let sequence =
            fn(text, column) = Left(UnexpectedSequence(=text, at = Position(line = 1, =column)));
        Test.equal([parse("\"\\u12\""),
                    parse("[\"\\u12\", 1]"),
                    parse("\"\\uZZZZ\""),
                    parse("{\"\\u1x\": 1}"),
                    parse("\"\\ud800\\u12\""),
                    parse("\"\\u12")],
                   [sequence("\\u12", 2),
                    sequence("\\u12", 3),
                    sequence("\\u", 2),
                    sequence("\\u1", 3),
                    sequence("\\u12", 8),
                    Left(UnexpectedEnd)])
    })

// report Appendix G.6
let positions =
    Test.Case(name = "a position is the line and the column in code points, past white space",
              run = fn() =
                  Test.equal([parse("{}\n}"), parse("[\"é\", x]"), parse("[1,\n 2,\n ß]")],
                             [Left(UnexpectedByte(byte = 125, at = Position(line = 2, column = 1))),
                              Left(UnexpectedByte(byte = 120, at = Position(line = 1, column = 7))),
                              Left(UnexpectedByte(byte = 195,
                                                  at = Position(line = 3, column = 2)))]))

// report Appendix G.6
let empty =
    Test.Case(name = "a text of white space holds no value",
              run = fn() =
                  Test.equal(#(parse(""), parse(" \n ")),
                             #(Left(UnexpectedEnd), Left(UnexpectedEnd))))

// report Appendix G.6
let order =
    Test.Case(name = "an object's members are written in the order of their names",
              run = fn() =
                  Test.equal(String.lines(format(Object(Map.fromList([#("é", Null),
                                                                      #("b", Null),
                                                                      #("a", Null),
                                                                      #("B", Null)])))),
                             ["{",
                              "  \"B\": null,",
                              "  \"a\": null,",
                              "  \"b\": null,",
                              "  \"é\": null",
                              "}"]))

// report Appendix G.6
let encodeOrder =
    Test.Case(name = "encode writes one line, an object's members in the order of their names",
              run = fn() = {
                  let inner = Object(Map.fromList([#("z", Null), #("y", Text("a\nb"))]));
                  Test.equal(encode(Object(Map.fromList([#("é", Array([Real(0.1), Boolean(true)])),
                                                         #("b", inner),
                                                         #("B", Null)]))),
                             "{\"B\":null,\"b\":{\"y\":\"a\\nb\",\"z\":null},\"é\":[0.1,true]}")
              })

// report Appendix G.6
let readBack =
    Test.Case(name = "parse reads what format and encode write as the value they were written from",
              run = fn() = {
                  let peer =
                      Object(Map.fromList([#("name", Text("desk \"one\"\n")),
                                           #("port", Integer(4001))]));
                  let weights = Array([Real(0.1), Real(0.0), Real(1.0e300)]);
                  let value =
                      Object(Map.fromList([#("peers", Array([peer])),
                                           #("weights", weights),
                                           #("on", Boolean(false)),
                                           #("none", Null),
                                           #("empty", Object(Map.empty))]));
                  Test.equal(#(parse(format(value)), parse(encode(value))),
                             #(Right(value), Right(value)))
              })
