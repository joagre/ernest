/// JSON text, read into a value and written from one, as RFC 8259 defines
/// it, by the host's `json` module.
///
/// Use it where a program reads or writes JSON, a file of settings or what
/// a web service sends: `parse` reads a text into a `Value`, `format` writes
/// a `Value` as text laid out over lines, and `encode` writes it on one line.
///
/// The library stands on every job's load path, so a program names it with
/// no option (report Appendix G).
///
/// **Numbers.** A number written with neither a fraction nor an exponent is
/// an `Integer`, of any size the host can hold, and one written with either
/// is a `Real`: `1` is `Integer(1)`, and `1.0` and `1e0` are `Real(1.0)`. A
/// `Real` nearer to zero than a `Float` can hold is `0.0`, and so is `-0.0`,
/// since a `Float` has no negative zero (report §3.1). An integer longer than
/// the host can hold, and a real larger than a `Float` can hold, are not
/// read.
///
/// **Objects.** An object is a `Map` from its members' names to their
/// values. Where a text names a member twice, the last is kept, as
/// `Map.fromList` keeps a later pair. `format` and `encode` write the
/// members in the order of their names' code points, an order of this
/// library's, which the host's `json` module leaves to its caller.
///
/// **Errors.** A text that holds no value is an `Error`: the text ends
/// inside its value, a byte stands where none may, or a sequence writes no
/// character or a number the host cannot hold. A byte and a sequence carry
/// their `Position`, the line and the column they begin at, counted as a
/// diagnostic counts them (report §11.5).
///
/// **Reading back.** `parse` reads what `format` and `encode` write as the
/// value it was written from.
///
/// ## Examples
///
/// A member of an object read:
///
/// ```ernest
/// match Json.parse("{\"name\": \"desk\", \"port\": 4001}") {
///     Right(Json.Object(members)) -> Map.get(members, "port")
///   | _ -> None
/// }
/// // => Some(Json.Integer(4001))
/// ```
///
/// An object written:
///
/// ```ernest
/// Json.format(Json.Object(Map.fromList([#("port", Json.Integer(4001)),
///                                       #("name", Json.Text("desk"))])))
/// // => "{\n  \"name\": \"desk\",\n  \"port\": 4001\n}\n"
/// ```
///
/// ## See also
///
/// `Map` for an object's members, `String` for the text a value is read from
/// and written to.
///
/// since 0.4.0

/// A JSON value: `null`, `true` or `false`, a number, a string, an array or
/// an object.
///
/// ### Examples
///
/// ```ernest
/// Json.parse("[null, true, 2]")
/// // => Right(Json.Array([Json.Null, Json.Boolean(true), Json.Integer(2)]))
/// ```
///
/// ```ernest
/// Json.parse("[2.5, \"x\", []]")
/// // => Right(Json.Array([Json.Real(2.5), Json.Text("x"), Json.Array([])]))
/// ```
export type Value =
    Null
  | Boolean(Bool)
  | Integer(Int)
  | Real(Float)
  | Text(String)
  | Array(List(Value))
  | Object(Map(String, Value))

/// Where an error begins: its line and its column, counted as a diagnostic
/// counts them (report §11.5), from 1, a line ending at a line feed and a
/// column a code point.
///
/// ### Examples
///
/// ```ernest
/// Json.parse("{\n  \"é\": x\n}")
/// // => Left(Json.UnexpectedByte(byte = 120, at = Json.Position(line = 2, column = 8)))
/// ```
///
/// since 0.9.0
export type Position = Position(line : Int, column : Int)

/// Why a text holds no JSON value, as the host's `json` finds it, and where.
/// `UnexpectedEnd` is a text that ends inside its value or holds none.
/// `UnexpectedByte` is a byte that cannot stand where it is, the first of
/// its character's, a second value, a comma before a closing bracket, a
/// character no value begins with, or the first that differs from the
/// `true`, `false` or `null` it breaks off, and its position.
///
/// `UnexpectedSequence` is an escape that writes no character, a
/// surrogate's escape without its pair's and one broken off before its four
/// digits among them, or a number the host cannot hold, an integer too long
/// or a real larger than a `Float` can hold, and its position.
///
/// The sequence is the host's spelling of it: an escape as the text writes
/// it, up to the byte that breaks it where one does, `\u12` of `"\u12"`;
/// an integer as the text writes it, and a real with a fraction too; but a
/// real with an exponent and no fraction with `.0` before the exponent and
/// its `e` in lower case, `1.0e400` for `1E400`.
///
/// ### Examples
///
/// ```ernest
/// Json.parse("[1, 2,]")
/// // => Left(Json.UnexpectedByte(byte = 93, at = Json.Position(line = 1, column = 7)))
/// ```
///
/// A real larger than a `Float` can hold, in the host's spelling:
///
/// ```ernest
/// Json.parse("[1E400]")
/// // => Left(Json.UnexpectedSequence(text = "1.0e400", at = Json.Position(line = 1, column = 2)))
/// ```
export type Error =
    UnexpectedEnd
  | UnexpectedByte(byte : Int, at : Position)
  | UnexpectedSequence(text : String, at : Position)

/// The value `text` writes, or why it writes none. White space may stand
/// before the value and after it, and nothing else may.
///
/// ### Examples
///
/// ```ernest
/// Json.parse(" 4001 ")
/// // => Right(Json.Integer(4001))
/// ```
///
/// ```ernest
/// Json.parse("4001 4002")
/// // => Left(Json.UnexpectedByte(byte = 52, at = Json.Position(line = 1, column = 6)))
/// ```
export foreign fn parse(text : String) : Either(Error, Value) =
    "ern_json:parse/1"

/// `value` as JSON text, laid out over lines as the host's `json:format`
/// lays it out, two spaces to a level, an object's members in the order of
/// their names' code points, and ending in a line feed. In a text it writes
/// `"` and `\` as `\"` and `\\`; a line feed, a carriage return, a tab, a
/// backspace and a form feed as `\n`, `\r`, `\t`, `\b` and `\f`; every
/// other character below U+0020 as `\u` and four uppercase hexadecimal
/// digits; and every other character as itself, U+007F and `/` among them.
///
/// ### Examples
///
/// ```ernest
/// Json.format(Json.Array([Json.Integer(1), Json.Null]))
/// // => "[1,null]\n"
/// ```
///
/// A text's characters, U+0000 escaped and U+007F not:
///
/// ```ernest
/// Json.format(Json.Text("a\u{0}\u{7f}\t/"))
/// // => "\"a\\u0000\u{7F}\\t/\"\n"
/// ```
export foreign fn format(value : Value) : String =
    "ern_json:format/1"

/// `value` as JSON text on one line, as the host's `json:encode` writes it,
/// with no white space between its parts and no line feed after it. An
/// object's members come in the order of their names' code points, and a
/// text is written as `format` writes it.
///
/// ### Examples
///
/// ```ernest
/// Json.encode(Json.Object(Map.fromList([#("tags", Json.Array([Json.Text("a"), Json.Null])),
///                                       #("port", Json.Integer(4001))])))
/// // => "{\"port\":4001,\"tags\":[\"a\",null]}"
/// ```
///
/// since 0.10.0
export foreign fn encode(value : Value) : String =
    "ern_json:encode/1"

//
// The tests (report §9.3), run by `ern test` as every library's are. They
// were written after the code, from the host's page and from what probing
// the host showed of the edges it does not state.
//

// report Appendix G.6: a regression test: the first was kept, where every
// `fromList` keeps the last; the three members show that the last wins
// wherever the others stand.
let duplicateName =
    Test.Case(name = "a member named twice keeps the last, as Map.fromList does",
              run = fn() =
                  Test.equal(parse("{\"a\": 1, \"b\": 0, \"a\": 2}"),
                             Right(Object(Map.fromList([#("a", Integer(2)), #("b", Integer(0))])))))

// report Appendix G.6
let numbers =
    Test.Case(name = "an integer of any size, and a real nearer zero than a Float is 0.0",
              run = fn() =
                  Test.equal(parse("[123456789012345678901234567890, -0, -0.0, 1e-400]"),
                             Right(Array([Integer(123456789012345678901234567890),
                                          Integer(0),
                                          Real(0.0),
                                          Real(0.0)]))))

// report Appendix G.6: a real of no fraction in the host's spelling, and
// one of a fraction in the text's.
let tooLarge =
    Test.Case(name = "a real larger than a Float can hold is not read",
              run = fn() =
                  Test.equal([parse("1e400"), parse("[1E+400]"), parse("[1.5E400]")],
                             [Left(UnexpectedSequence(text = "1.0e400",
                                                      at = Position(line = 1, column = 1))),
                              Left(UnexpectedSequence(text = "1.0e+400",
                                                      at = Position(line = 1, column = 2))),
                              Left(UnexpectedSequence(text = "1.5E400",
                                                      at = Position(line = 1, column = 2)))]))

// report Appendix G.6
let escapes =
    Test.Case(name = "an escaped pair of surrogates is one character, and one alone is no text",
              run = fn() =
                  Test.equal(#(parse("\"\\ud83d\\ude00 \\u00e9\""), parse("\"\\udc00\"")),
                             #(Right(Text("\u{1f600} é")),
                               Left(UnexpectedSequence(text = "\\udc00",
                                                       at = Position(line = 1, column = 2))))))

// report Appendix G.6
let loneSurrogate =
    Test.Case(name = "a high surrogate's escape without a low one's after it writes no character",
              run = fn() = {
                  let lone =
                      fn(column) =
                          Left(UnexpectedSequence(text = "\\ud800",
                                                  at = Position(line = 1, =column)));
                  Test.equal([parse("\"\\ud800\""),
                              parse("[\"\\ud800 and more\", 1]"),
                              parse("\"\\ud800\\n\""),
                              parse("\"\\ud800"),
                              parse("\"\\\\ud800\"")],
                             [lone(2),
                              lone(3),
                              lone(2),
                              Left(UnexpectedEnd),
                              Right(Text("\\ud800"))])
              })

// report Appendix G.6
let tooLong =
    Test.Case(name = "a too-long integer is not read, and is found past a string holding it",
              run = fn() = {
                  let digits = String.repeat("9", 1300000);
                  let sequence =
                      fn(column) =
                          Left(UnexpectedSequence(text = digits, at = Position(line = 1, =column)));
                  Test.equal(#(parse(digits), parse("[\"" <> digits <> "\", " <> digits <> "]")),
                             #(sequence(1), sequence(1300006)))
              })

// report Appendix G.6: a regression test: the digits were looked for at
// every byte outside a string, and found inside the real, at its fraction
// or after its first digit.
let tooLongAfterReal =
    Test.Case(name = "a too-long integer is found past a real holding its digits", run = fn() = {
        let digits = String.repeat("9", 1300000);
        let sequence =
            fn(column) = Left(UnexpectedSequence(text = digits, at = Position(line = 1, =column)));
        Test.equal(#(parse("[0." <> digits <> ", " <> digits <> "]"),
                     parse("[1" <> digits <> "e-1300000, " <> digits <> "]")),
                   #(sequence(1300006), sequence(1300014)))
    })

// report Appendix G.6: a regression test: the digits were compared at every
// byte of the real, each comparison running to the real's end, and the
// parse took 31 seconds; read once, the text takes a tenth of a second,
// most of it the column counted.
let tooLongReadOnce =
    Test.Case(name = "a too-long integer after a real one digit shorter is found reading once",
              run = fn() = {
                  let digits = String.repeat("9", 1300000);
                  Test.equal(parse("[0." <> String.repeat("9", 1299999) <> ", " <> digits <> "]"),
                             Left(UnexpectedSequence(text = digits,
                                                     at = Position(line = 1, column = 1300005))))
              })

// report Appendix G.6: a regression test: the host answered the end of
// the text where few bytes followed the literal's first, and the byte after
// its first where more did.
let brokenLiteral =
    Test.Case(name = "a literal broken off is the first byte that differs from it", run = fn() = {
        let byte =
            fn(code, line, column) =
                Left(UnexpectedByte(byte = code, at = Position(=line, =column)));
        Test.equal([parse("[t]"),
                    parse("[tru, 1]"),
                    parse("[nul]"),
                    parse("[\n\n nul]"),
                    parse("[falsy]"),
                    parse("[true, false, nulL]"),
                    parse("[\"tru\", tru]"),
                    parse("[tru"),
                    parse("fals")],
                   [byte(93, 1, 3),
                    byte(44, 1, 5),
                    byte(93, 1, 5),
                    byte(93, 3, 5),
                    byte(121, 1, 6),
                    byte(76, 1, 18),
                    byte(93, 1, 12),
                    Left(UnexpectedEnd),
                    Left(UnexpectedEnd)])
    })

// report Appendix G.6: a regression test: the host answered the end of
// the text where fewer than four bytes followed the escape's `u`, and its
// six bytes from the backslash, past the string's end, where more did.
let brokenEscape =
    Test.Case(name = "an escape broken off is written up to the byte that breaks it", run = fn() = {
        let sequence =
            fn(text, column) = Left(UnexpectedSequence(=text, at = Position(line = 1, =column)));
        Test.equal([parse("\"\\u12\""),
                    parse("[\"\\u12\", 1]"),
                    parse("\"\\uZZZZ\""),
                    parse("{\"\\u1x\": 1}"),
                    parse("\"\\ud800\\u12\""),
                    parse("\"\\u12")],
                   [sequence("\\u12", 2),
                    sequence("\\u12", 3),
                    sequence("\\u", 2),
                    sequence("\\u1", 3),
                    sequence("\\u12", 8),
                    Left(UnexpectedEnd)])
    })

// report Appendix G.6
let positions =
    Test.Case(name = "a position is the line and the column in code points, past white space",
              run = fn() =
                  Test.equal([parse("{}\n}"), parse("[\"é\", x]"), parse("[1,\n 2,\n ß]")],
                             [Left(UnexpectedByte(byte = 125, at = Position(line = 2, column = 1))),
                              Left(UnexpectedByte(byte = 120, at = Position(line = 1, column = 7))),
                              Left(UnexpectedByte(byte = 195,
                                                  at = Position(line = 3, column = 2)))]))

// report Appendix G.6
let empty =
    Test.Case(name = "a text of white space holds no value",
              run = fn() =
                  Test.equal(#(parse(""), parse(" \n ")),
                             #(Left(UnexpectedEnd), Left(UnexpectedEnd))))

// report Appendix G.6
let order =
    Test.Case(name = "an object's members are written in the order of their names",
              run = fn() =
                  Test.equal(String.lines(format(Object(Map.fromList([#("é", Null),
                                                                      #("b", Null),
                                                                      #("a", Null),
                                                                      #("B", Null)])))),
                             ["{",
                              "  \"B\": null,",
                              "  \"a\": null,",
                              "  \"b\": null,",
                              "  \"é\": null",
                              "}"]))

// report Appendix G.6
let encodeOrder =
    Test.Case(name = "encode writes one line, an object's members in the order of their names",
              run = fn() = {
                  let inner = Object(Map.fromList([#("z", Null), #("y", Text("a\nb"))]));
                  Test.equal(encode(Object(Map.fromList([#("é", Array([Real(0.1), Boolean(true)])),
                                                         #("b", inner),
                                                         #("B", Null)]))),
                             "{\"B\":null,\"b\":{\"y\":\"a\\nb\",\"z\":null},\"é\":[0.1,true]}")
              })

// report Appendix G.6
let readBack =
    Test.Case(name = "parse reads what format and encode write as the value they were written from",
              run = fn() = {
                  let peer =
                      Object(Map.fromList([#("name", Text("desk \"one\"\n")),
                                           #("port", Integer(4001))]));
                  let weights = Array([Real(0.1), Real(0.0), Real(1.0e300)]);
                  let value =
                      Object(Map.fromList([#("peers", Array([peer])),
                                           #("weights", weights),
                                           #("on", Boolean(false)),
                                           #("none", Null),
                                           #("empty", Object(Map.empty))]));
                  Test.equal(#(parse(format(value)), parse(encode(value))),
                             #(Right(value), Right(value)))
              })
