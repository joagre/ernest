// report Appendix G.11
let twoDigitYears =
    Test.Case(name = "RFC 850's year is the nearest one of its digits, at most 50 years ahead",
              run = fn() = {
                  let current = Time.toCivil(Clock.now()).year;
                  let january =
                      fn(year) =
                          Optional.withDefault(Time.fromCivil(Time.Civil(=year,
                                                                         month = 1,
                                                                         day = 1,
                                                                         hour = 0,
                                                                         minute = 0,
                                                                         second = 0)),
                                               0);
                  Test.equal(#(parseDate(rfc850(january(current + 50))),
                               parseDate(rfc850(january(current - 49)))),
                             #(Some(january(current + 50)), Some(january(current - 49))))
              })

// report Appendix G.11: a regression test: the year was decided by the year
// alone, so on the test's day `31-Dec-76`, 50 years and two months ahead,
// was read as 2076.
let fiftyYearsAhead =
    Test.Case(name = "RFC 850's year is in the past where its moment is more than 50 years ahead",
              run = fn() = {
                  let now =
                      Time.Civil(year = 2026,
                                 month = 11,
                                 day = 2,
                                 hour = 12,
                                 minute = 0,
                                 second = 0);
                  let read = fn(civil) = withCentury(civil, now).year;
                  Test.equal(List.map([Time.Civil(..now, year = 76),
                                       Time.Civil(..now, year = 76, second = 1),
                                       Time.Civil(..now, year = 76, month = 12, day = 31),
                                       Time.Civil(..now, year = 77, month = 1, day = 1),
                                       Time.Civil(..now, year = 26),
                                       Time.Civil(..now, year = 0),
                                       Time.Civil(..now, year = 99)],
                                      read),
                             [2076, 1976, 1976, 1977, 2026, 2000, 1999])
              })

// report Appendix G.11
let readBackDate =
    Test.Case(name = "parseDate reads what date writes, to the second",
              run = fn() =
                  Test.equal(List.map([0, 784111777999, 1793524863512, -62135596800000],
                                      fn(time) = parseDate(date(time))),
                             [Some(0),
                              Some(784111777000),
                              Some(1793524863000),
                              Some(-62135596800000)]))

//
// The tests over a connection on the loopback
//

// A connection over the loopback: the server's socket and the client's.
fn connection() : Either(Io.Error, #(Address(Tcp.SocketMsg), Address(Tcp.SocketMsg))) = {
    let listener <- Tcp.listen("127.0.0.1", 0);
    let port <- Tcp.port(listener);
    let client <- Tcp.connect("127.0.0.1", port, 1000);
    let server <- Tcp.accept(listener, 1000);
    Tcp.closeListener(listener);
    Right(#(server, client))
}

// Whether the client closes the connection once it has written.
type Ending = Closes | StaysOpen

// What `read` answers on the server's socket, once the client has written
// the texts and, where it `Closes`, closed the connection.
fn served(texts : List(String),
          ending : Ending,
          read : (Address(Tcp.SocketMsg)) -> a) : Either(Io.Error, a) = {
    let #(server, client) <- connection();
    let _ <- List.tryMap(texts, fn(text) = Tcp.write(client, String.toUtf8(text), 1000));
    if ending == Closes then Tcp.close(client) else Unit;
    let answer = read(server);
    Tcp.close(client);
    Tcp.close(server);
    Right(answer)
}

// report Appendix G.11
let oneRequest =
    Test.Case(name = "a request read from a socket, in two writes",
              run = fn() =
                  Test.equal(served(["GET /hello.txt HTTP/1.1\r\nUser-Agent: curl/7.64.1\r\n",
                                     "Host: www.example.com\r\nAccept-Language: en, mi\r\n\r\n"],
                                    StaysOpen,
                                    fn(socket) = readRequest(socket, <<>>, defaultLimits, 1000)),
                             Right(Right(#(hello, <<>>)))))

// report Appendix G.11: written with the code, which reads a head on from
// the line under way: a head split at each of its bytes between the bytes
// carried and the socket is read as the head sent whole.
let everySplit =
    Test.Case(name = "a head split anywhere between the carried bytes and the socket is read whole",
              run = fn() = {
                  let bytes = String.toUtf8(helloText <> "GET");
                  let read =
                      fn(count) =
                          served([String.fromUtf8Lossy(Bytes.drop(bytes, count))],
                                 StaysOpen,
                                 fn(socket) =
                                     readRequest(socket,
                                                 Bytes.slice(bytes, 0, count),
                                                 defaultLimits,
                                                 1000));
                  Test.equal(List.filter(List.range(0, Bytes.size(bytes) - 4),
                                         fn(count) =
                                             read(count)
                                                 != Right(Right(#(hello, String.toUtf8("GET"))))),
                             [])
              })

// report Appendix G.11
let twoRequests =
    Test.Case(name = "two requests sent at once are read one after the other",
              run = fn() =
                  Test.equal(served(["GET /a HTTP/1.1\r\n\r\nGET /b HTTP/1.1\r\n\r\n"],
                                    StaysOpen,
                                    fn(socket) = {
                                        let #(first, carried) <-
                                            readRequest(socket, <<>>, defaultLimits, 1000);
                                        let #(second, rest) <-
                                            readRequest(socket, carried, defaultLimits, 1000);
                                        Right(#(first.target, second.target, rest))
                                    }),
                             Right(Right(#("/a", "/b", <<>>)))))

// report Appendix G.11
let fromCarried =
    Test.Case(name = "a request the carried bytes hold whole is read without the socket",
              run = fn() =
                  Test.equal(served([],
                                    StaysOpen,
                                    fn(socket) =
                                        readRequest(socket,
                                                    String.toUtf8(helloText <> "GET"),
                                                    defaultLimits,
                                                    0)),
                             Right(Right(#(hello, String.toUtf8("GET"))))))

// report Appendix G.11
let noTime =
    Test.Case(name = "a reader given no milliseconds reads nothing from the socket",
              run = fn() =
                  Test.equal(served(["GET / HTTP/1.1\r\n\r\n"],
                                    StaysOpen,
                                    fn(socket) =
                                        readRequest(socket,
                                                    String.toUtf8("GET"),
                                                    defaultLimits,
                                                    0)),
                             Right(Left(Socket(Io.Timeout)))))

// report Appendix G.11
let halfHead =
    Test.Case(name = "a client that sends half a head and no more meets the milliseconds",
              run = fn() =
                  Test.equal(served(["GET / HTTP/1.1\r\nHost: exa"],
                                    StaysOpen,
                                    fn(socket) = readRequest(socket, <<>>, defaultLimits, 100)),
                             Right(Left(Socket(Io.Timeout)))))

// report Appendix G.11
let closedHead =
    Test.Case(name = "a client that closes before its head ends meets the close",
              run = fn() =
                  Test.equal(served(["GET / HTTP/1.1\r\nHost: exa"],
                                    Closes,
                                    fn(socket) = readRequest(socket, <<>>, defaultLimits, 1000)),
                             Right(Left(Socket(Io.Closed)))))

// report Appendix G.11
let refusedHead =
    Test.Case(name = "a head refused on a socket is the parse's error",
              run = fn() =
                  Test.equal(served(["GET / HTTP/1.1\r\nX: a\r\n b\r\n\r\n"],
                                    StaysOpen,
                                    fn(socket) = readResponse(socket, <<>>, defaultLimits, 1000)),
                             Right(Left(Protocol(Malformed)))))

type TrickleMsg = Stop

type Watched = Ended(Down)

// A client that writes one byte at a time until it is told to stop.
fn trickle(client : Address(Tcp.SocketMsg)) : Unit receiving TrickleMsg =
    receive {
        Stop ->
            Tcp.close(client)
      | after 0 -> {
            let _ = Tcp.write(client, <<97>>, 1000);
            trickle(client)
        }
    }

// report Appendix G.11
let endlessHead =
    Test.Case(name = "a head that never ends meets the milliseconds, though bytes keep coming",
              run = fn() : Test.Result receiving Watched = match connection() {
                  Right(#(server, client)) -> {
                      let _ = Tcp.write(client, String.toUtf8("GET / HTTP/1.1\r\nX: "), 1000);
                      let writer = spawnMonitored(fn() = trickle(client), Ended);
                      Tcp.give(client, Process.fromAddress(writer));
                      let large = Limits(line = 100000000, headers = 100000000);
                      let read = readRequest(server, <<>>, large, 200);
                      send(writer, Stop);
                      receive {
                          Ended(_) -> Unit
                      };
                      Tcp.close(server);
                      Test.equal(read, Left(Socket(Io.Timeout)))
                  }
                | Left(error) ->
                      Test.Failed(Io.show(error))
              })

// report Appendix G.11: written with the code, which reads the line under
// way again only where the new bytes hold a line feed or pass a limit:
// each limit is found at the bytes that pass it with no line feed after
// them, a folded header's from its first line, and a line under way that
// passes none is read on.
let limitsWithoutFeed =
    Test.Case(name = "a limit passed inside a line is found though no line feed comes",
              run = fn() = {
                  let read =
                      fn(carried, sent, limits, ms) =
                          served([sent],
                                 StaysOpen,
                                 fn(socket) =
                                     Either.map(readResponse(socket,
                                                             String.toUtf8(carried),
                                                             limits,
                                                             ms),
                                                fn(#(response, _)) = response.status));
                  let folded = "HTTP/1.1 200 OK\r\nX: aaaaaaaaaa\r\n";
                  Test.equal([read("HTTP/1.1 2",
                                   String.repeat("0", 200),
                                   Limits(line = 100, headers = 1000),
                                   1000),
                              read("HTTP/1.1 200 OK\r\nX: a\r\n",
                                   "YYYYYY",
                                   Limits(line = 100, headers = 10),
                                   1000),
                              read(folded, " bbbbb", Limits(line = 20, headers = 1000), 1000),
                              read(folded, "Ybbbb", Limits(line = 20, headers = 1000), 100)],
                             [Right(Left(Protocol(LineTooLong))),
                              Right(Left(Protocol(HeadersTooLarge))),
                              Right(Left(Protocol(HeadersTooLarge))),
                              Right(Left(Socket(Io.Timeout)))])
              })

// The body of RFC 9110's example response (section 3.9), of 51 bytes.
let helloBody = "Hello World! My content includes a trailing CRLF.\r\n"

// The headers of a body of a size.
fn sized(size : String) : List(Header) =
    [Header(name = "Content-Length", value = size)]

// The heads the tests read bodies after: a request's, and a response's of
// status 200, carrying the headers.
fn asked(headers : List(Header)) : Request =
    Request(method = "POST", target = "/", version = http11, =headers)

fn answered(headers : List(Header)) : Response =
    Response(version = http11, status = 200, =headers)

// report Appendix G.11
let sizedBody =
    Test.Case(name = "a body of a size, from the carried bytes and the socket",
              run = fn() =
                  Test.equal(served([String.slice(helloBody, 20, 51)],
                                    StaysOpen,
                                    fn(socket) =
                                        readResponseBody(socket,
                                                         String.toUtf8(String.slice(helloBody,
                                                                                    0,
                                                                                    20)),
                                                         answered(sized("51")),
                                                         51,
                                                         1000)),
                             Right(Right(#(String.toUtf8(helloBody), <<>>)))))

// report Appendix G.11
let afterSizedBody =
    Test.Case(name = "the bytes after a body of a size are answered, a pipelined request's",
              run = fn() =
                  Test.equal(served([],
                                    StaysOpen,
                                    fn(socket) =
                                        readRequestBody(socket,
                                                        String.toUtf8(helloBody <> helloText),
                                                        asked(sized("51")),
                                                        51,
                                                        0)),
                             Right(Right(#(String.toUtf8(helloBody), String.toUtf8(helloText))))))

// report Appendix G.11
let chunkedBody =
    Test.Case(name = "a chunked body is decoded, its extensions and its trailers dropped",
              run = fn() = {
                  let chunked = [Header(name = "Transfer-Encoding", value = "gzip, Chunked")];
                  let first = "4;name=value\r\nWiki\r\n6 ; a=\"b\"\r\npedia \r\n";
                  let second =
                      "E\r\nin \r\n\r\nchunks.\r\n0;last\r\nExpires: never\r\nX: y\r\n\r\nGET";
                  Test.equal(served([first, second],
                                    StaysOpen,
                                    fn(socket) =
                                        readRequestBody(socket, <<>>, asked(chunked), 1000, 1000)),
                             Right(Right(#(String.toUtf8("Wikipedia in \r\n\r\nchunks."),
                                           String.toUtf8("GET")))))
              })

// report Appendix G.11, RFC 9112, section 7.1
let chunkWritten =
    Test.Case(name = "a chunk is its size in hexadecimal, its bytes, and the last is 0",
              run = fn() =
                  Test.equal(List.map([String.repeat("a", 26), "Wiki", ""],
                                      fn(text) = String.fromUtf8(chunk(String.toUtf8(text)))),
                             [Some("1A\r\n" <> String.repeat("a", 26) <> "\r\n"),
                              Some("4\r\nWiki\r\n"),
                              Some("0\r\n\r\n")]))

// report Appendix G.11
let chunksReadBack =
    Test.Case(name = "the chunks chunk writes are read back as the body they write", run = fn() = {
        let chunked = [Header(name = "Transfer-Encoding", value = "chunked")];
        let parts = [String.repeat("x", 300), "Wiki", "pedia"];
        let written =
            Bytes.join(List.map(parts, fn(part) = chunk(String.toUtf8(part))) <> [chunk(<<>>)],
                       <<>>);
        Test.equal(served([],
                          StaysOpen,
                          fn(socket) = readRequestBody(socket, written, asked(chunked), 1000, 0)),
                   Right(Right(#(String.toUtf8(String.join(parts, "")), <<>>))))
    })

// report Appendix G.11
let chunkedLineFeeds =
    Test.Case(name = "a chunked body's lines may end in a line feed alone", run = fn() = {
        let chunked = answered([Header(name = "transfer-encoding", value = "chunked")]);
        Test.equal(served([],
                          StaysOpen,
                          fn(socket) =
                              readResponseBody(socket,
                                               String.toUtf8("3\nabc\n0\n\nrest"),
                                               chunked,
                                               100,
                                               0)),
                   Right(Right(#(String.toUtf8("abc"), String.toUtf8("rest")))))
    })

// report Appendix G.11
let requestUnframed =
    Test.Case(name = "a request whose headers frame no body has none, and its bytes are kept",
              run = fn() =
                  Test.equal(served(["more"],
                                    StaysOpen,
                                    fn(socket) =
                                        readRequestBody(socket,
                                                        String.toUtf8(helloText),
                                                        asked([Header(name = "Host", value = "a")]),
                                                        100,
                                                        0)),
                             Right(Right(#(<<>>, String.toUtf8(helloText))))))

// report Appendix G.11
let responseToClose =
    Test.Case(name = "a response's body that no header frames runs to the connection's close",
              run = fn() =
                  Test.equal(served(["all ", "of it"],
                                    Closes,
                                    fn(socket) =
                                        readResponseBody(socket,
                                                         String.toUtf8("<"),
                                                         answered([]),
                                                         100,
                                                         1000)),
                             Right(Right(#(String.toUtf8("<all of it"), <<>>)))))

// report Appendix G.11
let bodilessStatuses =
    Test.Case(name = "a response of 1xx, 204 or 304 has no body, whatever its headers",
              run = fn() = {
                  // a body of 5 bytes, 3 of them carried, would wait for the other 2
                  let read = fn(socket, status) = {
                      let response = Response(..answered(sized("5")), =status);
                      readResponseBody(socket, String.toUtf8("abc"), response, 100, 1000)
                  };
                  Test.equal(served([],
                                    StaysOpen,
                                    fn(socket) =
                                        List.map([204, 304, 101, 100],
                                                 fn(status) = read(socket, status))),
                             Right(List.repeat(Right(#(<<>>, String.toUtf8("abc"))), 4)))
              })

// report Appendix G.11
let bodyTooLarge =
    Test.Case(name = "a body past the limit is too large, at the bytes that pass it", run = fn() = {
        let chunked = [Header(name = "Transfer-Encoding", value = "chunked")];
        Test.equal(served(["5\r\nhello\r\n5\r\nworld\r\n"],
                          StaysOpen,
                          fn(socket) =
                              [readRequestBody(socket, <<>>, asked(sized("101")), 100, 1000),
                               readRequestBody(socket,
                                               String.toUtf8("1\r\na\r\n0\r\n"),
                                               asked(chunked),
                                               8,
                                               0),
                               readRequestBody(socket,
                                               String.toUtf8("1\r\na\r\n0\r\nX: yyyy"),
                                               asked(chunked),
                                               14,
                                               0),
                               readRequestBody(socket,
                                               String.toUtf8("ffffffffffffffffff\r\n"),
                                               asked(chunked),
                                               100,
                                               0),
                               readRequestBody(socket, <<>>, asked(chunked), 12, 1000),
                               readResponseBody(socket,
                                                String.toUtf8("0123456789x"),
                                                answered([]),
                                                10,
                                                0)]),
                   Right(List.repeat(Left(Protocol(BodyTooLarge)), 6)))
    })

// report Appendix G.11
let malformedBody =
    Test.Case(name = "a body whose framing cannot be read is malformed", run = fn() = {
        let chunked = [Header(name = "Transfer-Encoding", value = "chunked")];
        let cases =
            [#(sized("abc"), ""),
             #(sized("-1"), ""),
             #(sized("+1"), ""),
             #(sized("1, 1"), ""),
             #(sized("1") <> sized("2"), ""),
             #([Header(name = "Transfer-Encoding", value = "gzip")] <> sized("1"), ""),
             #([Header(name = "Transfer-Encoding", value = "chunked, gzip")], ""),
             #(chunked, "xyz\r\n"),
             #(chunked, "\r\n"),
             #(chunked, "1\r\nab\r\n")];
        Test.equal(served([],
                          StaysOpen,
                          fn(socket) =
                              List.map(cases,
                                       fn(#(headers, carried)) =
                                           readRequestBody(socket,
                                                           String.toUtf8(carried),
                                                           asked(headers),
                                                           100,
                                                           0))),
                   Right(List.repeat(Left(Protocol(Malformed)), 10)))
    })

// report Appendix G.11, RFC 9112, section 6.1: a regression test: the
// chunked coding was read and the bytes after it answered as the next
// request's, so a client and a server that read the length could disagree
// on where the next request begins.
let framedTwice =
    Test.Case(name = "Transfer-Encoding beside Content-Length, or chunked twice, is malformed",
              run = fn() = {
                  let chunked = Header(name = "Transfer-Encoding", value = "chunked");
                  let twice = Header(..chunked, value = "chunked, Chunked");
                  let carried = String.toUtf8("5\r\nhello\r\n0\r\n\r\nGET");
                  let requests =
                      [asked([chunked] <> sized("3")), asked([twice]), asked([chunked, chunked])];
                  let responses = [answered(sized("3") <> [chunked]), answered([chunked, chunked])];
                  let read =
                      fn(socket) =
                          List.map(requests,
                                   fn(request) = readRequestBody(socket, carried, request, 100, 0))
                              <> List.map(responses,
                                          fn(response) =
                                              readResponseBody(socket, carried, response, 100, 0));
                  Test.equal(served([], StaysOpen, read),
                             Right(List.repeat(Left(Protocol(Malformed)), 5)))
              })

// report Appendix G.11, RFC 9112, section 6.3: written with the code.
let unchunkedResponse =
    Test.Case(name = "a response whose last coding is not chunked runs to the close", run = fn() = {
        let response = answered([Header(name = "Transfer-Encoding", value = "chunked, gzip")]);
        Test.equal(served(["def"],
                          Closes,
                          fn(socket) =
                              readResponseBody(socket, String.toUtf8("abc"), response, 100, 1000)),
                   Right(Right(#(String.toUtf8("abcdef"), <<>>))))
    })

// report Appendix G.11
let sameLengthTwice =
    Test.Case(name = "a Content-Length named twice with one number is that number",
              run = fn() =
                  Test.equal(served([],
                                    StaysOpen,
                                    fn(socket) =
                                        readRequestBody(socket,
                                                        String.toUtf8("abc"),
                                                        asked(sized("2") <> sized("02")),
                                                        100,
                                                        0)),
                             Right(Right(#(String.toUtf8("ab"), String.toUtf8("c"))))))

// report Appendix G.11
let bodyCut =
    Test.Case(name = "a body that the close or the milliseconds cut short is the socket's error",
              run = fn() = {
                  let chunked = [Header(name = "Transfer-Encoding", value = "chunked")];
                  Test.equal(#(served(["abc"],
                                      Closes,
                                      fn(socket) =
                                          readRequestBody(socket,
                                                          <<>>,
                                                          asked(sized("10")),
                                                          100,
                                                          1000)),
                               served(["5\r\nab"],
                                      Closes,
                                      fn(socket) =
                                          readResponseBody(socket,
                                                           <<>>,
                                                           answered(chunked),
                                                           100,
                                                           1000)),
                               served(["abc"],
                                      StaysOpen,
                                      fn(socket) =
                                          readRequestBody(socket,
                                                          <<>>,
                                                          asked(sized("10")),
                                                          100,
                                                          100))),
                             #(Right(Left(Socket(Io.Closed))),
                               Right(Left(Socket(Io.Closed))),
                               Right(Left(Socket(Io.Timeout)))))
              })

// What `write` answers on one end of a connection, and what `read` answers
// on the other after it.
fn exchanged(write : (Address(Tcp.SocketMsg)) -> b,
             read : (Address(Tcp.SocketMsg)) -> a) : Either(Io.Error, #(b, a)) = {
    let #(server, client) <- connection();
    let written = write(client);
    let answer = read(server);
    Tcp.close(client);
    Tcp.close(server);
    Right(#(written, answer))
}

// report Appendix G.11: written with the code.
let requestWritten =
    Test.Case(name = "a request written to a socket is read back whole, its body after it",
              run = fn() = {
                  let request =
                      Request(method = "POST",
                              target = "/items",
                              version = http11,
                              headers = [Header(name = "Host", value = "example.com")]);
                  let read = fn(socket) = {
                      let #(head, carried) <- readRequest(socket, <<>>, defaultLimits, 1000);
                      let #(body, rest) <- readRequestBody(socket, carried, head, 100, 1000);
                      Right(#(head, body, rest))
                  };
                  Test.equal(exchanged(fn(socket) =
                                           writeRequest(socket, request, String.toUtf8("{}"), 1000),
                                       read),
                             Right(#(Right(Unit),
                                     Right(#(Request(..request,
                                                     headers = request.headers <> sized("2")),
                                             String.toUtf8("{}"),
                                             <<>>)))))
              })

// report Appendix G.11: written with the code.
let responseWritten =
    Test.Case(name = "a response written to a socket is read back whole, its body after it",
              run = fn() = {
                  let response = answered([Header(name = "Content-Type", value = "text/plain")]);
                  let read = fn(socket) = {
                      let #(head, carried) <- readResponse(socket, <<>>, defaultLimits, 1000);
                      let #(body, rest) <- readResponseBody(socket, carried, head, 100, 1000);
                      Right(#(head, body, rest))
                  };
                  Test.equal(exchanged(fn(socket) =
                                           writeResponse(socket,
                                                         response,
                                                         String.toUtf8(helloBody),
                                                         1000),
                                       read),
                             Right(#(Right(Unit),
                                     Right(#(Response(..response,
                                                      headers = response.headers <> sized("51")),
                                             String.toUtf8(helloBody),
                                             <<>>)))))
              })

// report Appendix G.11: written with the code.
let chunksWritten =
    Test.Case(name = "a chunked response written head and chunks is read back as their bytes",
              run = fn() = {
                  let response = answered([Header(name = "Transfer-Encoding", value = "chunked")]);
                  let write = fn(socket) = {
                      let _ <- writeResponse(socket, response, <<>>, 1000);
                      let _ <- writeChunk(socket, String.toUtf8("Wiki"), 1000);
                      let _ <- writeChunk(socket, String.toUtf8("pedia"), 1000);
                      writeChunk(socket, <<>>, 1000)
                  };
                  let read = fn(socket) = {
                      let #(head, carried) <- readResponse(socket, <<>>, defaultLimits, 1000);
                      readResponseBody(socket, carried, head, 100, 1000)
                  };
                  Test.equal(exchanged(write, read),
                             Right(#(Right(Unit), Right(#(String.toUtf8("Wikipedia"), <<>>)))))
              })

// report Appendix G.11: written with the code.
let writtenAfterClose =
    Test.Case(name = "a write to a connection the far end has closed is the socket's Closed",
              run = fn() = match connection() {
                  Right(#(server, client)) -> {
                      Tcp.close(client);
                      // the read answers once the close has reached the server's socket
                      let read = readRequest(server, <<>>, defaultLimits, 1000);
                      let written =
                          [writeRequest(server, asked([]), <<>>, 1000),
                           writeResponse(server, answered([]), <<>>, 1000),
                           writeChunk(server, String.toUtf8("a"), 1000)];
                      Tcp.close(server);
                      Test.equal(#(read, written),
                                 #(Left(Socket(Io.Closed)),
                                   List.repeat(Left(Socket(Io.Closed)), 3)))
                  }
                | Left(error) ->
                      Test.Failed(Io.show(error))
              })

// report Appendix G.11: written with the code.
let writeFaults =
    Test.Case(name = "a write the rendering refuses faults its writer and writes nothing",
              run = fn() = match connection() {
                  Right(#(server, client)) -> {
                      let faults =
                          [Test.faults(fn() =
                                           writeResponse(server,
                                                         Response(..answered([]), status = 99),
                                                         <<>>,
                                                         1000),
                                       "the status 99 is not three digits"),
                           Test.faults(fn() =
                                           writeRequest(server,
                                                        Request(..asked([]), method = ""),
                                                        <<>>,
                                                        1000),
                                       "the method \"\" is no token")];
                      // the first bytes the client reads are the next write's
                      let response = Response(..answered([]), status = 204);
                      let read =
                          Either.andThen(writeResponse(server, response, <<>>, 1000),
                                         fn(_) = readResponse(client, <<>>, defaultLimits, 1000));
                      Tcp.close(client);
                      Tcp.close(server);
                      Test.equal(#(faults, read),
                                 #(List.repeat(Test.Passed, 2), Right(#(response, <<>>))))
                  }
                | Left(error) ->
                      Test.Failed(Io.show(error))
              })

// report Appendix G.11: written with the code.
let writtenInNoTime =
    Test.Case(name = "a write given no milliseconds is the socket's Timeout, and writes nothing",
              run = fn() = match connection() {
                  Right(#(server, client)) -> {
                      let written =
                          [writeRequest(server, asked([]), <<>>, 0),
                           writeResponse(server, answered([]), <<>>, 0),
                           writeChunk(server, String.toUtf8("a"), 0)];
                      // the first bytes the client reads are the next write's
                      let response = Response(..answered([]), status = 204);
                      let read =
                          Either.andThen(writeResponse(server, response, <<>>, 1000),
                                         fn(_) = readResponse(client, <<>>, defaultLimits, 1000));
                      Tcp.close(client);
                      Tcp.close(server);
                      Test.equal(#(written, read),
                                 #(List.repeat(Left(Socket(Io.Timeout)), 3),
                                   Right(#(response, <<>>))))
                  }
                | Left(error) ->
                      Test.Failed(Io.show(error))
              })
