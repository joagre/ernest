/// HTTP/1.1's messages as RFC 9112 writes them: a request's or a response's
/// head read from bytes or from a socket, the body after it, and a head and a
/// body written, with a request's target and cookies and RFC 9110's dates and
/// status phrases.
///
/// Use it to serve HTTP over `Tcp`, or to speak it to a server. A server
/// reads a request's head with `readRequest` and its body with
/// `readRequestBody`, its target with `target` and a cookie with `cookie`,
/// and writes its response with `writeResponse`, a body in chunks with
/// `writeChunk`; a client writes its request with `writeRequest` and reads
/// the response with `readResponse` and `readResponseBody`. `parseRequest`
/// and `parseResponse` read a head from bytes a program already holds, and
/// `renderRequest`, `renderResponse` and `chunk` write one to bytes.
///
/// A program opens its connection with `Tcp`, and meets `Io.Error` there
/// alone: every function here over a socket answers a `SocketError`.
///
/// The library stands on every job's load path, so a program names it with
/// no option (report Appendix G).
///
/// **A head.** A line ends in a line feed, with or without a carriage return
/// before it. A request's method and target and a header's name are kept as
/// written, and a header's value without the white space around it. A head
/// that passes its `Limits` is refused at the bytes that pass them, so that
/// a reader holds no more of a head than the limits allow.
///
/// **The bytes after a head or a body.** A socket answers what has arrived,
/// which may run past the head, into its body, or past the body, into a
/// second request a client sent before the first's answer. A reader answers
/// those bytes, and the next reader is given them as `carried`, which it
/// reads before the socket.
///
/// **Waiting.** The milliseconds a reader is given bound the whole head, or
/// the whole body, and not each read from the socket, so that a client that
/// sends a byte a second meets them.
///
/// **A body.** The head's headers frame it: the chunked coding, else
/// `Content-Length`. Where they carry neither, a request has no body, and a
/// response's runs to the connection's close, as it does where its last
/// transfer coding is not chunked. A response of status 1xx, 204 or 304 has
/// no body, whatever its headers. Nor has one to a `HEAD` request, which
/// its reader cannot know: a client that sent `HEAD` reads no body.
///
/// ## Examples
///
/// A request's head read from bytes:
///
/// ```ernest
/// {
///     let bytes = String.toUtf8("GET /hello.txt HTTP/1.1\r\nHost: www.example.com\r\n\r\n");
///     match Http.parseRequest(bytes, Http.defaultLimits) {
///         Right(Http.Parsed(head = request)) ->
///             #(request.method, request.target, Http.header(request.headers, "host"))
///       | _ ->
///             #("", "", None)
///     }
/// }
/// // => #("GET", "/hello.txt", Some("www.example.com"))
/// ```
///
/// A response written, its `Content-Length` added:
///
/// ```ernest
/// {
///     let response =
///         Http.Response(version = Http.http11,
///                       status = 200,
///                       headers = [Http.Header(name = "Content-Type", value = "text/plain")]);
///     String.fromUtf8(Http.renderResponse(response, String.toUtf8("Hello")))
/// }
/// // => Some("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nHello")
/// ```
///
/// ## See also
///
/// `Tcp` for the sockets the readers read, `Bytes` for what they answer,
/// `Uri` for a target's components.
///
/// since 0.9.0

/// A version of HTTP, `HTTP/1.0` being `Version(major = 1, minor = 0)`;
/// `http11` is HTTP/1.1.
///
/// ### Examples
///
/// ```ernest
/// Http.Version(major = 1, minor = 0)
/// // => Http.Version(major = 1, minor = 0)
/// ```
export type Version = Version(
    /// The number before the point.
    major : Int,
    /// The number after the point.
    minor : Int)

/// HTTP/1.1, the version of the messages RFC 9112 writes.
///
/// A server answers an HTTP/1.0 request in HTTP/1.1 too, the highest
/// version it speaks whose major number is not above the request's (RFC
/// 9110, section 2.5).
///
/// ### Examples
///
/// ```ernest
/// Http.http11
/// // => Http.Version(major = 1, minor = 1)
/// ```
///
/// since 0.10.0
export let http11 : Version = Version(major = 1, minor = 1)

/// A header: its name, which a reader keeps as written, and its value.
///
/// ### Examples
///
/// ```ernest
/// Http.Header(name = "Content-Type", value = "text/html")
/// // => Http.Header(name = "Content-Type", value = "text/html")
/// ```
export type Header = Header(
    /// The name, which `header` and `headers` compare in any case.
    name : String,
    /// The value, without the white space before and after it.
    value : String)

/// A request's head: its method, its target, its version and its headers,
/// in their order.
///
/// ### Examples
///
/// ```ernest
/// {
///     let request =
///         Http.Request(method = "GET",
///                      target = "/",
///                      version = Http.http11,
///                      headers = [Http.Header(name = "Host", value = "example.com")]);
///     #(request.method, request.target, request.headers)
/// }
/// // => #("GET", "/", [Http.Header(name = "Host", value = "example.com")])
/// ```
export type Request = Request(
    /// The method, `GET`, `POST` or another, as the client wrote it.
    method : String,
    /// The target as the client wrote it: a path with its query, an
    /// absolute URI, a host and a port, or `*`.
    target : String,
    /// The version of HTTP the request is written in.
    version : Version,
    /// The headers, in their order.
    headers : List(Header))

/// A response's head: its version, its status and its headers, in their
/// order. The status line's phrase is the status's, which `reason` gives.
///
/// ### Examples
///
/// ```ernest
/// Http.Response(version = Http.http11, status = 404, headers = [])
/// // => Http.Response(version = Http.Version(major = 1, minor = 1), status = 404, headers = [])
/// ```
export type Response = Response(
    /// The version of HTTP the response is written in.
    version : Version,
    /// The status, 200 for success.
    status : Int,
    /// The headers, in their order.
    headers : List(Header))

/// The most bytes a head may take: of any of its lines, the line ending
/// among them, and of its header lines together, theirs among them.
/// A program with no reason to choose its own passes `defaultLimits`.
///
/// ### Examples
///
/// ```ernest
/// Http.Limits(line = 4096, headers = 16384)
/// // => Http.Limits(line = 4096, headers = 16384)
/// ```
export type Limits = Limits(
    /// The most bytes of any line; a limit below 1 lets no line in.
    line : Int,
    /// The most bytes of the header lines together.
    headers : Int)

/// The limits a head is read within where a program has no reason to
/// choose its own: a line of 8192 bytes, past the 8000 that RFC 9112,
/// section 3, recommends a recipient read in a request line, and header
/// lines of 65536 bytes together.
///
/// ### Examples
///
/// ```ernest
/// Http.defaultLimits
/// // => Http.Limits(line = 8192, headers = 65536)
/// ```
///
/// since 0.10.0
export let defaultLimits : Limits = Limits(line = 8192, headers = 65536)

/// Why a head or a body is refused.
///
/// ### Examples
///
/// ```ernest
/// Http.parseRequest(String.toUtf8("GET /\r\n\r\n"), Http.defaultLimits)
/// // => Left(Http.Malformed)
/// ```
export type Error =
    /// A first line that is no request line or no status line, a request
    /// line with no version and a status line whose status is not three
    /// digits among them; a header line with no name or no `:`; a header
    /// value holding a carriage return, a line feed or a NUL, a request's
    /// header folded over two lines among them, or bytes that are not UTF-8;
    /// or a body whose framing cannot be read.
    Malformed
  /// A first line past the limit of a line.
  | LineTooLong
  /// A header line past the limit of a line, or header lines past the
  /// limit of the headers together.
  | HeadersTooLarge
  /// A body past the limit its reader is given.
  | BodyTooLarge

/// What reading a head from bytes found: `Incomplete` where the bytes end
/// before the head does, else the head and the bytes after it.
///
/// ### Examples
///
/// ```ernest
/// Http.parseRequest(String.toUtf8("GET / HTTP/1.1\r\n"), Http.defaultLimits)
/// // => Right(Http.Incomplete)
/// ```
export type Parsed(a) =
    /// The bytes end before the head's empty line.
    Incomplete
  /// The head, and the bytes after its empty line.
  | Parsed(head : a, rest : Bytes)

/// The error of every function over a socket: `Protocol` for what was read
/// and refused, `Socket` for the socket's own error.
///
/// A write's `Left` is `Socket` alone.
///
/// ### Examples
///
/// ```ernest
/// Http.Socket(Io.Timeout)
/// // => Http.Socket(Io.Timeout)
/// ```
///
/// since 0.10.0
export type SocketError =
    /// The head or the body read is refused.
    Protocol(Error)
  /// The socket answered an error: `Timeout` where the milliseconds passed,
  /// `Closed` where the connection closed before the read or the write was
  /// done.
  | Socket(Io.Error)

/// The request whose head `bytes` begin with, and the bytes after the head,
/// or `Incomplete` where they end before the head's empty line.
///
/// The request line is three words parted at runs of spaces and tabs: the
/// method, the target and the version, `HTTP/`, a digit, `.` and a digit,
/// which is read as written, `HTTP/2.0` as `Version(major = 2, minor = 0)`.
/// A line without a version, as HTTP/0.9 wrote it, or whose third word is
/// no version, `HTTP/1.10` among them, is `Malformed`, and so is a status
/// line. One empty line before the request line is skipped, as RFC 9112,
/// section 2.2 has a server skip it, and a second is `Malformed`.
///
/// A first line past `limits.line` bytes is `LineTooLong`. A header line past
/// it, and header lines past `limits.headers` bytes together, are
/// `HeadersTooLarge`. Each is found at the bytes that pass the limit, before
/// the line's end has come.
///
/// ### Examples
///
/// Two requests a client sent at once, the second in the bytes after the
/// first's head:
///
/// ```ernest
/// {
///     let bytes = String.toUtf8("GET /a HTTP/1.1\r\n\r\nGET /b HTTP/1.1\r\n\r\n");
///     match Http.parseRequest(bytes, Http.defaultLimits) {
///         Right(Http.Parsed(head = first, =rest)) -> #(first.target, String.fromUtf8(rest))
///       | _ -> #("", None)
///     }
/// }
/// // => #("/a", Some("GET /b HTTP/1.1\r\n\r\n"))
/// ```
export fn parseRequest(bytes : Bytes, limits : Limits) : Either(Error, Parsed(Request)) =
    parsed(requestHeading(bytes, limits, 1), limits)

/// The response whose head `bytes` begin with, and the bytes after the head,
/// or `Incomplete` where they end before the head's empty line, read as
/// `parseRequest` reads a request's.
///
/// The status is three digits, and a status line whose status is not is
/// `Malformed`, as a request line is; the line's phrase is dropped. A
/// header folded over two lines is read with each fold, a line break and
/// the white space around it, replaced by one space (RFC 9112, section
/// 5.2), where `parseRequest` refuses it.
///
/// ### Examples
///
/// ```ernest
/// {
///     let bytes = String.toUtf8("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n");
///     match Http.parseResponse(bytes, Http.defaultLimits) {
///         Right(Http.Parsed(head = response)) -> #(response.status, response.headers)
///       | _ -> #(0, [])
///     }
/// }
/// // => #(404, [Http.Header(name = "Content-Length", value = "0")])
/// ```
export fn parseResponse(bytes : Bytes, limits : Limits) : Either(Error, Parsed(Response)) =
    parsed(responseHeading(bytes, limits), limits)

// A head whose first line is read: what makes the head of its headers, who
// sent it, the headers read, the last first, the bytes their lines took,
// and the bytes from the line under way on.
type Heading(a) =
    Heading(make : (List(Header)) -> a,
            sender : Sender,
            headers : List(Header),
            taken : Int,
            rest : Bytes)

// Who sent a message a reader reads: a client, a request's, or a server, a
// response's. A server's folded header is read unfolded, and its body's
// framing differs where the headers frame none, and where the last
// transfer coding is not chunked (RFC 9112, sections 5.2 and 6.3).
type Sender = Client | Server

// How far a head's header lines are read: to the head's end, the head and
// the bytes after it, or partway, to a line the bytes end inside, which the
// heading's rest begins with.
type Step(a) = Done(head : a, rest : Bytes) | Partway(Heading(a))

// The host's reading of one line of a head (report Appendix G.11): the
// bytes end inside it, `More`; it passes the size it is given before its
// line feed, `TooLong`; a request line or a status line, with its version,
// a status line's status, and the bytes after the line; a header line, by
// its name and its value; the empty line, the head's end; or a line the
// host cannot read.
type Line =
    More
  | TooLong
  | RequestLine(major : Int, minor : Int, rest : Bytes)
  | StatusLine(major : Int, minor : Int, status : Int, rest : Bytes)
  | Field(name : String, value : Bytes, rest : Bytes)
  | HeadEnd(rest : Bytes)
  | Unreadable(line : Bytes, rest : Bytes)

// The host's `erlang:decode_packet` over the first line, given the most
// bytes the line may take, 0 being no limit. The host contributes the
// line's end within the limit, the method as a token, which the primitive
// closes for U+007F, and the version's numbers; the Ernest reads the
// line's words, the target and the status's three digits, closing what the
// host reads otherwise (E.0 rule 1).
foreign fn readFirst(bytes : Bytes, size : Int) : Line =
    "ern_http:read_first/2"

// The host's `erlang:decode_packet` over a header line, as `readFirst`.
foreign fn readField(bytes : Bytes, size : Int) : Line =
    "ern_http:read_field/2"

// Report Appendix G.11: the head a first line's reading leads to, or
// `Incomplete`.
fn parsed(first : Either(Error, Optional(Heading(a))), limits : Limits) : Either(Error, Parsed(a)) =
    match first {
        Right(Some(heading)) ->
            match headerLines(heading, limits) {
                Right(Done(=head, =rest)) -> Right(Parsed(=head, =rest))
              | Right(Partway(_)) -> Right(Incomplete)
              | Left(error) -> Left(error)
            }
      | Right(None) ->
            Right(Incomplete)
      | Left(error) ->
            Left(error)
    }

// Report Appendix G.11: the request line the bytes begin with, as the
// request's heading, or `None` where the bytes end inside it. `skips` is
// how many empty lines may still be skipped before it, as RFC 9112,
// section 2.2 has a server skip one.
//
// The host reads a request line without a version as HTTP/0.9's, `GET
// HTTP/1.1` among them, whose target it takes for `HTTP/1.1`, and reads a
// version past its form, `HTTP/1.1x` as 1.1. So the line is read again
// here as its three words, the method, the target as the client wrote it,
// and the version as RFC 9112, section 2.3 writes one. The host reads
// bytes that are exactly an empty line whatever its size, so a line it
// cannot read is held to the line's limit here.
fn requestHeading(bytes : Bytes,
                  limits : Limits,
                  skips : Int) : Either(Error, Optional(Heading(Request))) =
    if Bytes.isEmpty(bytes) then
        Right(None)
    else if limits.line < 1 then
        Left(LineTooLong)
    else match readFirst(bytes, packetSize(limits.line, bytes)) {
        More ->
            Right(None)
      | TooLong ->
            Left(LineTooLong)
      | Unreadable(=line, =rest) ->
            if Bytes.size(line) > limits.line then
                Left(LineTooLong)
            else if skips > 0 && isEmptyLine(line) then
                requestHeading(rest, limits, skips - 1)
            else
                Left(Malformed)
      | RequestLine(=major, =minor, =rest) ->
            match words(lineOf(bytes, rest), 0, []) {
                [method, target, version] when isTarget(target) && isVersion(version) ->
                    match #(String.fromUtf8(method), String.fromUtf8(target)) {
                        #(Some(methodText), Some(targetText)) -> {
                            let make =
                                fn(headers) =
                                    Request(method = methodText,
                                            target = targetText,
                                            version = Version(=major, =minor),
                                            =headers);
                            Right(Some(Heading(=make,
                                               sender = Client,
                                               headers = [],
                                               taken = 0,
                                               =rest)))
                        }
                      | _ ->
                            Left(Malformed)
                    }
              | _ ->
                    Left(Malformed)
            }
      | _ ->
            Left(Malformed)
    }

// Report Appendix G.11: the status line the bytes begin with, as the
// response's heading, or `None` where the bytes end inside it. The host
// reads a status of any count of digits, `0200` as 200, so the line's
// second word is read again as the three digits RFC 9112, section 4
// writes, and its phrase is dropped: the status's is `reason`'s. A line the
// host cannot read is held to the line's limit, as a request's is.
fn responseHeading(bytes : Bytes, limits : Limits) : Either(Error, Optional(Heading(Response))) =
    if Bytes.isEmpty(bytes) then
        Right(None)
    else if limits.line < 1 then
        Left(LineTooLong)
    else match readFirst(bytes, packetSize(limits.line, bytes)) {
        More ->
            Right(None)
      | TooLong ->
            Left(LineTooLong)
      | Unreadable(=line) when Bytes.size(line) > limits.line ->
            Left(LineTooLong)
      | StatusLine(=major, =minor, =status, =rest) ->
            match words(lineOf(bytes, rest), 0, []) {
                _ :: word :: _ ->
                    if isStatus(word) then {
                        let make =
                            fn(headers) =
                                Response(version = Version(=major, =minor), =status, =headers);
                        Right(Some(Heading(=make, sender = Server, headers = [], taken = 0, =rest)))
                    } else
                        Left(Malformed)
              | _ ->
                    Left(Malformed)
            }
      | _ ->
            Left(Malformed)
    }

// Report Appendix G.11: the header lines from the heading's rest on, to the
// empty line that ends the head, each line within the line's limit and all
// of them, their line endings counted, within the headers'. The host
// answers a header line once the byte after it shows that the next line is
// no continuation of it.
//
// A header line may take the headers' limit less what the lines before it
// took, or the line's limit where that is less, so that the host refuses it
// at the bytes that pass either; the empty line that ends the head is no
// header line, and may take the line's limit.
fn headerLines(heading : Heading(a), limits : Limits) : Either(Error, Step(a)) = {
    let bytes = heading.rest;
    let room = if isHeadEnd(bytes) then
        limits.line
    else
        Int.min(limits.line, limits.headers - heading.taken);
    let size = packetSize(room, bytes);
    if Bytes.isEmpty(bytes) then
        Right(Partway(heading))
    else if room < 1 then
        Left(HeadersTooLarge)
    else match readField(bytes, size) {
        More ->
            if isRefusedAhead(bytes, size, heading.sender) then
                Left(Malformed)
            else
                Right(Partway(heading))
      | TooLong ->
            Left(HeadersTooLarge)
      | HeadEnd(=rest) ->
            Right(Done(head = heading.make(List.reverse(heading.headers)), =rest))
      | Field(=name, =value, =rest) ->
            match headerOf(name, value, heading.sender) {
                Some(header) ->
                    headerLines(Heading(..heading,
                                        headers = header :: heading.headers,
                                        taken = heading.taken + lineSize(bytes, rest),
                                        =rest),
                                limits)
              | None ->
                    Left(Malformed)
            }
      | _ ->
            Left(Malformed)
    }
}

// Report Appendix G.11: whether the header line the bytes end with is
// refused whatever follows it. The host holds its verdict on a line, a
// refusal too, until the byte after it shows that no fold follows; so a
// line whose line feed has come is read once more with a byte after it
// that begins no fold, and is refused at once, not at the deadline, where
// the host cannot read it or `headerOf` refuses it. A fold after it would
// not save it: it keeps the name, and the value's bytes before it, which
// hold what `headerOf` refused.
fn isRefusedAhead(bytes : Bytes, size : Int, sender : Sender) : Bool =
    Bytes.contains(bytes, <<'\n':utf8>>)
        && match readField(bytes <> <<'X':utf8>>, size) {
            Unreadable(line = _) -> true
          | Field(=name, =value) -> Optional.isNone(headerOf(name, value, sender))
          | _ -> false
        }

// Report Appendix G.11: a header by its name as written and its value
// without the spaces and tabs around it, which RFC 9112, section 5.1 leaves
// out of the value and the host keeps after it. A header the host reads
// with no name is refused, as is a value holding a carriage return or a
// line feed, which a request's header folded over two lines holds, or a
// NUL, which RFC 9110, section 5.5 has a recipient refuse, or one that is
// not UTF-8, which no `String` holds. A server's value is unfolded first.
fn headerOf(name : String, value : Bytes, sender : Sender) : Optional(Header) =
    if name == "" then
        None
    else {
        let read = match sender {
            Client -> value
          | Server -> unfolded(value)
        };
        let trimmedValue = trimmed(read);
        if isPlain(trimmedValue) then match String.fromUtf8(trimmedValue) {
            Some(text) -> Some(Header(=name, value = text))
          | None -> None
        } else
            None
    }

// RFC 9112, section 5.2: a response's value with each fold, a line break
// and the white space around it, replaced by one space, as a user agent
// replaces it; the host answers a folded value with its line breaks.
fn unfolded(value : Bytes) : Bytes =
    if Bytes.contains(value, <<'\n':utf8>>) then
        Bytes.join(List.map(foldedLines(Bytes.split(value, <<'\n':utf8>>)), trimmed), <<' ':utf8>>)
    else
        value

// The lines of a folded value, each but the last without the carriage
// return before its line feed.
fn foldedLines(lines : List(Bytes)) : List(Bytes) =
    match lines {
        line :: next :: rest -> withoutReturn(line) :: foldedLines(next :: rest)
      | _ -> lines
    }

// Whether the bytes hold no carriage return, line feed or NUL.
fn isPlain(bytes : Bytes) : Bool =
    match bytes {
        <<byte, rest:bytes>> when byte != 0x0D && byte != 0x0A && byte != 0 -> isPlain(rest)
      | <<>> -> true
      | _ -> false
    }

// The bytes without the spaces and tabs before and after them.
fn trimmed(bytes : Bytes) : Bytes =
    trimmedEnd(trimmedStart(bytes))

fn trimmedStart(bytes : Bytes) : Bytes =
    match bytes {
        <<byte, rest:bytes>> when isBlank(byte) -> trimmedStart(rest)
      | _ -> bytes
    }

fn trimmedEnd(bytes : Bytes) : Bytes = {
    let size = Bytes.size(bytes);
    match bytes {
        <<before:size(size - 1)-bytes, byte>> when isBlank(byte) -> trimmedEnd(before)
      | _ -> bytes
    }
}

// Whether a byte is a space or a tab, which part a request line's words
// and stand around a header's value.
fn isBlank(byte : Int) : Bool =
    byte == 0x20 || byte == 0x09

// Whether the bytes begin with the empty line, or with the carriage return
// it may begin with, its line feed still to come.
fn isHeadEnd(bytes : Bytes) : Bool =
    match bytes {
        <<'\n':utf8, _:bytes>> -> true
      | <<'\r':utf8, '\n':utf8, _:bytes>> -> true
      | <<'\r':utf8>> -> true
      | _ -> false
    }

// Whether a line the host could not read is an empty one.
fn isEmptyLine(line : Bytes) : Bool =
    line == <<'\r':utf8, '\n':utf8>> || line == <<'\n':utf8>>

// The host's `packet_size` for a line that may take `limit` bytes, its line
// ending among them: the limit, or none, 0, where the bytes are shorter,
// since no line in them can pass it and the host takes no size past 2^32 -
// 1. The host refuses a line once it passes the size, before its line feed
// comes.
fn packetSize(limit : Int, bytes : Bytes) : Int =
    if limit > Bytes.size(bytes) then 0 else limit

// The line the bytes begin with, which `rest` follows, without its line
// feed and a carriage return before it.
fn lineOf(bytes : Bytes, rest : Bytes) : Bytes =
    withoutReturn(Bytes.slice(bytes, 0, lineSize(bytes, rest) - 1))

// The size of the line the bytes begin with, which `rest` follows, its
// line ending among it.
fn lineSize(bytes : Bytes, rest : Bytes) : Int =
    Bytes.size(bytes) - Bytes.size(rest)

// The line without the carriage return before its line feed.
fn withoutReturn(content : Bytes) : Bytes =
    if Bytes.endsWith(content, <<'\r':utf8>>) then
        Bytes.slice(content, 0, Bytes.size(content) - 1)
    else
        content

// The words of a line without its ending, at most four, `count` of them
// read: the runs of bytes between spaces and tabs, at which RFC 9112,
// section 3 parts a request line. The section lets a recipient part one at
// a bare carriage return, a vertical tab and a form feed too, which the
// host refuses between words; so a bare carriage return stays in its word,
// where a target holds none.
fn words(line : Bytes, count : Int, acc : List(Bytes)) : List(Bytes) =
    match line {
        <<byte, rest:bytes>> when count < 4 ->
            if isBlank(byte) then
                words(rest, count, acc)
            else {
                let size = wordSize(line, 0);
                words(Bytes.drop(line, size), count + 1, Bytes.slice(line, 0, size) :: acc)
            }
      | _ ->
            List.reverse(acc)
    }

fn wordSize(bytes : Bytes, size : Int) : Int =
    match bytes {
        <<byte, rest:bytes>> when !isBlank(byte) -> wordSize(rest, size + 1)
      | _ -> size
    }

// Whether a word is a version, `HTTP/`, a digit, `.` and a digit.
fn isVersion(word : Bytes) : Bool =
    match word {
        <<'H':utf8, 'T':utf8, 'T':utf8, 'P':utf8, '/':utf8, major, '.':utf8, minor>> ->
            isDigit(major) && isDigit(minor)
      | _ ->
            false
    }

// Whether a word is a status, three digits.
fn isStatus(word : Bytes) : Bool =
    match word {
        <<hundreds, tens, ones>> -> isDigit(hundreds) && isDigit(tens) && isDigit(ones)
      | _ -> false
    }

fn isDigit(byte : Int) : Bool =
    byte >= 0x30 && byte <= 0x39

// Report Appendix G.11: whether a target is written in the visible ASCII
// characters, RFC 3986's, so that a raw UTF-8 byte is refused.
fn isTarget(bytes : Bytes) : Bool =
    match bytes {
        <<byte, rest:bytes>> when byte >= 0x21 && byte <= 0x7E -> isTarget(rest)
      | <<>> -> true
      | _ -> false
    }

/// The request whose head `socket` sends after the bytes `carried`, read
/// within `ms` milliseconds, and the bytes read after its head.
///
/// `carried` is what an earlier read took past its head, and is read first;
/// the socket is read only where it holds no whole head. The milliseconds
/// bound the whole head and not each read. `Socket(Timeout)` is the
/// milliseconds passed before the head ended, `Socket(Closed)` the
/// connection closed before it, and `Protocol(error)` the head refused, as
/// `parseRequest` refuses it, at the bytes that pass the limits, though no
/// line feed comes after them.
///
/// ### Examples
///
/// A server's handler, given the socket of a connection, that reads one
/// request and answers its target:
///
/// ```ernest
/// fn serve(socket : Address(Tcp.SocketMsg)) : Either(Http.SocketError, Unit) = {
///     let #(request, _) <- Http.readRequest(socket, <<>>, Http.defaultLimits, 10000);
///     let response = Http.Response(version = Http.http11, status = 200, headers = []);
///     Http.writeResponse(socket, response, String.toUtf8(request.target), 5000)
/// }
///
/// serve
/// ```
export fn readRequest(socket : Address(Tcp.SocketMsg),
                      carried : Bytes,
                      limits : Limits,
                      ms : Int) : Either(SocketError, #(Request, Bytes)) = {
    let deadline = Clock.monotonic() + ms;
    readHead(HeadReading(=socket,
                         =deadline,
                         =limits,
                         first = fn(bytes) = requestHeading(bytes, limits, 1)),
             carried)
}

/// The response whose head `socket` sends after the bytes `carried`, read
/// within `ms` milliseconds, and the bytes read after its head, as
/// `readRequest` reads a request's.
///
/// A response of status 1xx is an interim one, which a server may send
/// before its final response: a client that reads one reads again, given
/// the bytes this read answers as `carried`, for the response after it.
///
/// ### Examples
///
/// A client that asks for a page and reads the response and its body, which
/// may run to the connection's close:
///
/// ```ernest
/// {
///     let socket <- Either.mapLeft(Tcp.connect("example.com", 80, 5000), Http.Socket);
///     let request =
///         Http.Request(method = "GET",
///                      target = "/",
///                      version = Http.http11,
///                      headers = [Http.Header(name = "Host", value = "example.com")]);
///     let _ <- Http.writeRequest(socket, request, <<>>, 5000);
///     let #(response, carried) <- Http.readResponse(socket, <<>>, Http.defaultLimits, 10000);
///     let #(body, _) <- Http.readResponseBody(socket, carried, response, 1000000, 10000);
///     Tcp.close(socket);
///     Right(body)
/// }
/// ```
export fn readResponse(socket : Address(Tcp.SocketMsg),
                       carried : Bytes,
                       limits : Limits,
                       ms : Int) : Either(SocketError, #(Response, Bytes)) = {
    let deadline = Clock.monotonic() + ms;
    readHead(HeadReading(=socket,
                         =deadline,
                         =limits,
                         first = fn(bytes) = responseHeading(bytes, limits)),
             carried)
}

// What reads a head: its socket, the deadline on the monotonic clock, the
// limits, and the reading of a request's first line or a response's.
type HeadReading(a) =
    HeadReading(socket : Address(Tcp.SocketMsg),
                deadline : Int,
                limits : Limits,
                first : (Bytes) -> Either(Error, Optional(Heading(a))))

// Report Appendix G.11: the head the bytes begin with, read on from the
// socket while it is incomplete, each read given what is left until the
// deadline.
//
// A line is read again only where its reading can answer otherwise than
// the last: where the new bytes hold a line feed, which may end it, or
// where they reach the size at which a limit passes inside it, where the
// host refuses it. A header line is read again from its own start, and the
// lines before it are not, so that each line is read at most three times
// however the bytes come: where the host waited for the byte after it,
// which shows that the line is no fold, once more with a byte that begins
// none, `isRefusedAhead`'s, and again once that byte comes.
fn readHead(reading : HeadReading(a), bytes : Bytes) : Either(SocketError, #(a, Bytes)) =
    match reading.first(bytes) {
        Right(Some(heading)) ->
            readHeaderLines(reading, headerLines(heading, reading.limits))
      | Right(None) -> {
            let more <- readOn(reading, bytes, firstPassing(bytes, reading.limits));
            readHead(reading, more)
        }
      | Left(error) ->
            Left(Protocol(error))
    }

// The head the header lines lead to, read on from the socket while they
// stop partway.
fn readHeaderLines(reading : HeadReading(a),
                   step : Either(Error, Step(a))) : Either(SocketError, #(a, Bytes)) =
    match step {
        Right(Done(=head, =rest)) ->
            Right(#(head, rest))
      | Right(Partway(heading)) -> {
            let room = Int.min(reading.limits.line, reading.limits.headers - heading.taken);
            let more <- readOn(reading, heading.rest, room);
            readHeaderLines(reading, headerLines(Heading(..heading, rest = more), reading.limits))
        }
      | Left(error) ->
            Left(Protocol(error))
    }

// The bytes with what the socket answers after them, read on until the new
// bytes hold a line feed or the bytes reach `passing`.
fn readOn(reading : HeadReading(a), bytes : Bytes, passing : Int) : Either(SocketError, Bytes) = {
    let more <- received(reading.socket, bytes, reading.deadline);
    let read = Bytes.drop(more, Bytes.size(bytes));
    if Bytes.contains(read, <<'\n':utf8>>) || Bytes.size(more) >= passing then
        Right(more)
    else
        readOn(reading, more, passing)
}

// The size the bytes may reach with no line feed more before the first
// line passes the line's limit, after the one empty line a request may
// begin with.
fn firstPassing(bytes : Bytes, limits : Limits) : Int =
    if Bytes.startsWith(bytes, <<'\r':utf8, '\n':utf8>>) then
        2 + limits.line
    else if Bytes.startsWith(bytes, <<'\n':utf8>>) then
        1 + limits.line
    else
        limits.line

// The bytes with what the socket answers next after them, waiting until the
// deadline at most. A deadline passed is a timeout, as a wait given no time
// is (report Appendix E.0, shape rule 8), though the socket holds bytes
// that have arrived, which a read given no time answers: so a client that
// keeps sending meets the deadline too.
fn received(socket : Address(Tcp.SocketMsg),
            bytes : Bytes,
            deadline : Int) : Either(SocketError, Bytes) = {
    let ms = deadline - Clock.monotonic();
    if ms <= 0 then
        Left(Socket(Io.Timeout))
    else match Tcp.read(socket, ms) {
        Right(read) -> Right(bytes <> read)
      | Left(error) -> Left(Socket(error))
    }
}

/// The body of `request`, which `socket` sends after the bytes `carried`,
/// read within `ms` milliseconds, and the bytes read after it; at most
/// `limit` bytes.
///
/// Where `Transfer-Encoding` names `chunked` last, the chunks are decoded,
/// each chunk's extensions and the trailers after the last chunk dropped;
/// where it names another coding last, names `chunked` twice or stands
/// beside a `Content-Length`, the body is `Protocol(Malformed)` (RFC 9112,
/// sections 6.1 and 6.3). Otherwise `Content-Length` gives the body's size:
/// one that is no decimal number, or two that name different numbers, are
/// `Protocol(Malformed)`. Where the headers carry neither, the request has
/// no body: the answer is an empty body and `carried` as it was, and the
/// socket is not read.
///
/// A client whose request carries `Expect: 100-continue` may hold its body
/// back until the server answers with status 100 (RFC 9110, section
/// 10.1.1): a server that reads such a body writes a response of status 100
/// first, or the read waits on the client.
///
/// `carried` is what the head's reader took past the head, and is read
/// first. The milliseconds bound the whole body and not each read.
/// `Socket(Timeout)` is the milliseconds passed before the body ended, and
/// `Socket(Closed)` the connection closed before it.
///
/// `limit` counts the body's bytes as they come, the chunks' sizes, their
/// extensions and the trailers among them. A body past it is
/// `Protocol(BodyTooLarge)`, found at the bytes that pass it, or at once
/// where `Content-Length` or a chunk's size passes it.
///
/// ### Examples
///
/// A server's handler, given the socket of a connection, that reads one
/// request and its body, and answers the body's size:
///
/// ```ernest
/// fn serve(socket : Address(Tcp.SocketMsg)) : Either(Http.SocketError, Unit) = {
///     let #(request, carried) <- Http.readRequest(socket, <<>>, Http.defaultLimits, 10000);
///     let #(body, _) <- Http.readRequestBody(socket, carried, request, 1000000, 10000);
///     let response = Http.Response(version = Http.http11, status = 200, headers = []);
///     Http.writeResponse(socket, response, String.toUtf8(Int.toString(Bytes.size(body))), 5000)
/// }
///
/// serve
/// ```
export fn readRequestBody(socket : Address(Tcp.SocketMsg),
                          carried : Bytes,
                          request : Request,
                          limit : Int,
                          ms : Int) : Either(SocketError, #(Bytes, Bytes)) =
    readBody(socket, carried, request.headers, limit, ms, Client)

/// The body of `response`, which `socket` sends after the bytes `carried`,
/// read within `ms` milliseconds, and the bytes read after it; at most
/// `limit` bytes, read as `readRequestBody` reads a request's.
///
/// A response of status 1xx, 204 or 304 has no body, whatever its headers:
/// the answer is an empty body and `carried` as it was, and the socket is
/// not read. Nor has a response to a `HEAD` request, which the reader
/// cannot know: a client that sent `HEAD` reads no body.
///
/// Where the headers carry neither `Transfer-Encoding` nor `Content-Length`,
/// or `Transfer-Encoding` names a coding other than `chunked` last, the body
/// runs to the connection's close, and no bytes come after it (RFC 9112,
/// section 6.3).
export fn readResponseBody(socket : Address(Tcp.SocketMsg),
                           carried : Bytes,
                           response : Response,
                           limit : Int,
                           ms : Int) : Either(SocketError, #(Bytes, Bytes)) =
    if isBodiless(response.status) then
        Right(#(<<>>, carried))
    else
        readBody(socket, carried, response.headers, limit, ms, Server)

// Report Appendix G.11: the body the headers frame as its sender's, and the
// bytes after it.
fn readBody(socket : Address(Tcp.SocketMsg),
            carried : Bytes,
            headers : List(Header),
            limit : Int,
            ms : Int,
            sender : Sender) : Either(SocketError, #(Bytes, Bytes)) = {
    let reading = Reading(=socket, =limit, deadline = Clock.monotonic() + ms);
    match framing(headers, sender) {
        Right(Chunked) ->
            chunks(reading, carried, 0, <<>>)
      | Right(Length(size)) ->
            if size > limit then
                Left(Protocol(BodyTooLarge))
            else
                firstBytes(reading, carried, size)
      | Right(ToClose) ->
            toClose(reading, carried)
      | Left(error) ->
            Left(Protocol(error))
    }
}

// What reads a body: its socket, the most bytes the body may come to, and
// the deadline on the monotonic clock.
type Reading = Reading(socket : Address(Tcp.SocketMsg), limit : Int, deadline : Int)

// What frames a body (RFC 9112, section 6.3).
type Framing = Chunked | Length(Int) | ToClose

// Report Appendix G.11, RFC 9112, sections 6.1 and 6.3: a transfer coding
// frames the body, its last coding deciding how, and the field's values are
// one list however many lines carry them; a `Content-Length` beside it, or
// `chunked` named twice, frames none that can be read. Every
// `Content-Length` names one decimal number, the same. Where neither field
// frames the body, a request has none, and a response's runs to the close.
fn framing(fields : List(Header), sender : Sender) : Either(Error, Framing) =
    match #(headers(fields, "Transfer-Encoding"), headers(fields, "Content-Length")) {
        #([], lengths) ->
            match #(List.unique(List.map(lengths, decimal)), sender) {
                #([], Client) -> Right(Length(0))
              | #([], Server) -> Right(ToClose)
              | #([Some(size)], _) -> Right(Length(size))
              | _ -> Left(Malformed)
            }
      | #(values, []) -> {
            let codings =
                List.filter(List.map(List.flatMap(values, fn(value) = String.split(value, ",")),
                                     fn(coding) = String.toLower(String.trim(coding))),
                            fn(coding) = coding != "");
            coded(codings, sender)
        }
      | _ ->
            Left(Malformed)
    }

// RFC 9112, sections 6.1 and 6.3: the framing of the transfer codings, in
// lower case. `chunked` last is the chunked coding, named once; another
// coding last leaves a request's body unframed, which is refused, and a
// response's running to the close.
fn coded(codings : List(String), sender : Sender) : Either(Error, Framing) =
    if List.size(List.filter(codings, fn(coding) = coding == "chunked")) > 1 then
        Left(Malformed)
    else match #(List.last(codings) == Some("chunked"), sender) {
        #(true, _) -> Right(Chunked)
      | #(false, Client) -> Left(Malformed)
      | #(false, Server) -> Right(ToClose)
    }

// The number the digits 0 to 9 write, of which there is at least one.
fn decimal(text : String) : Optional(Int) =
    if text != "" && List.all(String.toList(text), Char.isAsciiDigit) then
        String.toInt(text)
    else
        None

// RFC 9112, section 7.1: the chunks from the bytes on, each its size in
// hexadecimal, its extensions after a `;` dropped, its data and an empty
// line, to the last chunk, of size 0, and the trailers after it, and the
// bytes after them. `consumed` counts the bytes of the body read so far, and
// `body` holds the chunks' data.
fn chunks(reading : Reading,
          bytes : Bytes,
          consumed : Int,
          body : Bytes) : Either(SocketError, #(Bytes, Bytes)) = {
    let #(sizeLine, afterSize, consumed) <- line(reading, bytes, consumed);
    let size <- Either.fromOptional(chunkSize(sizeLine), Protocol(Malformed));
    if size == 0 then
        Either.map(trailers(reading, afterSize, consumed), fn(rest) = #(body, rest))
    else if consumed + size > reading.limit then
        Left(Protocol(BodyTooLarge))
    else {
        let #(data, afterData) <- firstBytes(reading, afterSize, size);
        let #(end, rest, consumed) <- line(reading, afterData, consumed + size);
        if Bytes.isEmpty(end) then
            chunks(reading, rest, consumed, body <> data)
        else
            Left(Protocol(Malformed))
    }
}

// A chunk's size, the hexadecimal digits before any `;` and the white space
// before it.
fn chunkSize(sizeLine : Bytes) : Optional(Int) = {
    let digits = match Bytes.indexOf(sizeLine, <<';':utf8>>) {
        Some(index) -> Bytes.slice(sizeLine, 0, index)
      | None -> sizeLine
    };
    let text <- Optional.map(String.fromUtf8(digits), String.trimEnd);
    if text != ""
        && List.all(String.toList(text), fn(char) = Optional.isSome(Char.digitValue(char, 16))) then
        String.toIntBase(text, 16)
    else
        None
}

// RFC 9112, section 7.1.2: the trailer lines after the last chunk, dropped,
// to the empty line that ends the body, and the bytes after it.
fn trailers(reading : Reading, bytes : Bytes, consumed : Int) : Either(SocketError, Bytes) = {
    let #(trailer, rest, consumed) <- line(reading, bytes, consumed);
    if Bytes.isEmpty(trailer) then Right(rest) else trailers(reading, rest, consumed)
}

// The line the bytes begin with, without its line feed and a carriage
// return before it, the bytes after it, and the body's bytes consumed with
// it, read on from the socket until its line feed comes, within the limit.
fn line(reading : Reading,
        bytes : Bytes,
        consumed : Int) : Either(SocketError, #(Bytes, Bytes, Int)) =
    match Bytes.indexOf(bytes, <<'\n':utf8>>) {
        Some(index) ->
            if consumed + index + 1 > reading.limit then
                Left(Protocol(BodyTooLarge))
            else {
                let rest = Bytes.drop(bytes, index + 1);
                Right(#(withoutReturn(Bytes.slice(bytes, 0, index)), rest, consumed + index + 1))
            }
      | None ->
            if consumed + Bytes.size(bytes) > reading.limit then
                Left(Protocol(BodyTooLarge))
            else {
                let more <- received(reading.socket, bytes, reading.deadline);
                line(reading, more, consumed)
            }
    }

// The first `count` bytes and the bytes after them, read on from the socket
// until there are as many.
fn firstBytes(reading : Reading,
              bytes : Bytes,
              count : Int) : Either(SocketError, #(Bytes, Bytes)) =
    if Bytes.size(bytes) >= count then
        Right(#(Bytes.slice(bytes, 0, count), Bytes.drop(bytes, count)))
    else {
        let more <- received(reading.socket, bytes, reading.deadline);
        firstBytes(reading, more, count)
    }

// RFC 9112, section 6.3: a response's body the connection's close ends,
// within the limit, with no bytes after it.
fn toClose(reading : Reading, bytes : Bytes) : Either(SocketError, #(Bytes, Bytes)) =
    if Bytes.size(bytes) > reading.limit then
        Left(Protocol(BodyTooLarge))
    else match received(reading.socket, bytes, reading.deadline) {
        Right(more) -> toClose(reading, more)
      | Left(Socket(Io.Closed)) -> Right(#(bytes, <<>>))
      | Left(error) -> Left(error)
    }

/// The first value under `name` in `headers`, the names compared in any
/// case; `None` where no header has the name.
///
/// ### Examples
///
/// ```ernest
/// Http.header([Http.Header(name = "Content-Type", value = "text/html")], "content-type")
/// // => Some("text/html")
/// ```
export fn header(headers : List(Header), name : String) : Optional(String) = {
    let wanted = String.toLower(name);
    Optional.map(List.find(headers, fn(header) = isNamed(header, wanted)),
                 fn(header) = header.value)
}

/// Every value under `name` in `headers`, in their order, the names compared
/// in any case.
///
/// ### Examples
///
/// ```ernest
/// Http.headers([Http.Header(name = "Set-Cookie", value = "a=1"),
///               Http.Header(name = "Host", value = "example.com"),
///               Http.Header(name = "set-cookie", value = "b=2")],
///              "Set-Cookie")
/// // => ["a=1", "b=2"]
/// ```
export fn headers(headers : List(Header), name : String) : List(String) = {
    let wanted = String.toLower(name);
    List.filterMap(headers,
                   fn(header) = if isNamed(header, wanted) then Some(header.value) else None)
}

// Whether the header's name, in lower case, is the name.
fn isNamed(header : Header, lowered : String) : Bool =
    String.toLower(header.name) == lowered

/// The pairs of every `Cookie` header in `headers`, RFC 6265's, in order:
/// each value parted at `;`, each part parted at its first `=`, the cookie's
/// name before it and its value after, each trimmed of the white space
/// around it.
///
/// A part with no `=` or with an empty name is dropped. A value is
/// otherwise kept as written, its quotes among them.
///
/// ### Examples
///
/// ```ernest
/// Http.cookies([Http.Header(name = "Cookie", value = "theme=dark; sid=\"a=b\""),
///               Http.Header(name = "cookie", value = "lang=sv")])
/// // => [#("theme", "dark"), #("sid", "\"a=b\""), #("lang", "sv")]
/// ```
///
/// since 0.10.0
export fn cookies(fields : List(Header)) : List(#(String, String)) =
    List.flatMap(headers(fields, "Cookie"),
                 fn(value) = List.filterMap(String.split(value, ";"), cookiePair))

// Report Appendix G.11: a part of a `Cookie` value as the cookie's name and
// its value, each trimmed; `None` where the part has no `=` or no name.
fn cookiePair(part : String) : Optional(#(String, String)) =
    Optional.andThen(String.splitOnce(part, "="), fn(#(name, value)) = {
        let name = String.trim(name);
        if name == "" then None else Some(#(name, String.trim(value)))
    })

/// The value of the first cookie named `name` in the `Cookie` headers of
/// `headers`, as `cookies` reads them, the names compared exactly; `None`
/// where no cookie has the name.
///
/// ### Examples
///
/// ```ernest
/// Http.cookie([Http.Header(name = "Cookie", value = "sid=31d4d96e; theme=dark")], "sid")
/// // => Some("31d4d96e")
/// ```
///
/// since 0.10.0
export fn cookie(headers : List(Header), name : String) : Optional(String) =
    Optional.map(List.find(cookies(headers), fn(#(found, _)) = found == name),
                 fn(#(_, value)) = value)

/// The request's target read as a URI reference, in the form RFC 9112 has
/// a server read it by the method; `None` for a target of no form.
///
/// A `CONNECT` request's target is an authority alone, read as a reference
/// with that authority and an empty path. An `OPTIONS` request's `*` is the
/// path `*`. A target that begins with `/` is origin form, a path and a
/// query with no scheme and no authority, and one that begins with `//` is
/// such a path too. Any other target is absolute form, which has a scheme.
/// A target with a fragment is of no form.
///
/// Whether the scheme and the `Host` header name the server is the
/// server's to decide.
///
/// ### Examples
///
/// ```ernest
/// {
///     let request =
///         Http.Request(method = "GET",
///                      target = "/search?q=ernest",
///                      version = Http.http11,
///                      headers = []);
///     Optional.map(Http.target(request), fn(reference) = #(reference.path, reference.query))
/// }
/// // => Some(#("/search", Some("q=ernest")))
/// ```
///
/// ```ernest
/// {
///     let request =
///         Http.Request(method = "CONNECT",
///                      target = "example.com:443",
///                      version = Http.http11,
///                      headers = []);
///     Optional.andThen(Http.target(request), fn(reference) = reference.authority)
/// }
/// // => Some(Uri.Authority(userinfo = None, host = "example.com", port = Some(443)))
/// ```
///
/// since 0.10.0
export fn target(request : Request) : Optional(Uri.Reference) = {
    let text = request.target;
    if request.method == "CONNECT" then
        Optional.map(Uri.parseAuthority(text),
                     fn(authority) =
                         Uri.Reference(scheme = None,
                                       authority = Some(authority),
                                       path = "",
                                       query = None,
                                       fragment = None))
    else if request.method == "OPTIONS" && text == "*" then
        Uri.parse(text)
    else if String.startsWith(text, "/") then
        originForm(text)
    else
        absoluteForm(text)
}

// RFC 9112, section 3.2.1: a path and its query. The target is read after
// an empty authority, since a path that begins with `//` would be read as
// an authority's start.
fn originForm(text : String) : Optional(Uri.Reference) =
    match Uri.parse("//" <> text) {
        Some(Uri.Reference(=path, =query, fragment = None)) ->
            Some(Uri.Reference(scheme = None, authority = None, =path, =query, fragment = None))
      | _ ->
            None
    }

// RFC 9112, section 3.2.2: an absolute URI, which has a scheme and no
// fragment.
fn absoluteForm(text : String) : Optional(Uri.Reference) =
    match Uri.parse(text) {
        Some(Uri.Reference(scheme = Some(_), fragment = None) as reference) -> Some(reference)
      | _ -> None
    }

/// The response's head and `body` after it, as bytes to write: the status
/// line, each header as `name: value`, an empty line and the body, each line
/// ending in a carriage return and a line feed.
///
/// The status line is the response's version, its status and `reason`'s
/// phrase for it. Where the headers carry neither `Content-Length` nor
/// `Transfer-Encoding`, and the status is no 1xx, 204 or 304, a
/// `Content-Length` of the body's size is written after them (RFC 9110,
/// section 8.6). A header's value is written as given.
///
/// ### Errors
///
/// A header's name that is no token, one or more of the ASCII letters and
/// digits and of ``!#$%&'*+-.^_`|~`` (RFC 9110, section 5.6.2), a header's
/// value holding a carriage return, a line feed or U+0000, a status that is
/// not three digits, from 100 to 999 (RFC 9112, section 4), and a body that
/// is not empty given with a status of 1xx, 204 or 304 are each a program's
/// own error, and fault the caller, the cause naming the header or the
/// status.
///
/// ### Examples
///
/// A response of no content, which carries no `Content-Length`:
///
/// ```ernest
/// {
///     let response = Http.Response(version = Http.http11, status = 204, headers = []);
///     String.fromUtf8(Http.renderResponse(response, <<>>))
/// }
/// // => Some("HTTP/1.1 204 No Content\r\n\r\n")
/// ```
export fn renderResponse(response : Response, body : Bytes) : Bytes = {
    let Response(=version, =status, =headers) = response;
    checkStatus(status);
    checkBodiless(status, body);
    let statusLine = versionText(version) <> " " <> Int.toString(status) <> " " <> reason(status);
    written(statusLine, if isBodiless(status) then headers else withLength(headers, body), body)
}

// RFC 9110, section 15: whether a response of the status has no body, a 1xx,
// a 204 or a 304.
fn isBodiless(status : Int) : Bool =
    (status >= 100 && status < 200) || status == 204 || status == 304

/// The request's head and `body` after it, as bytes to write, as
/// `renderResponse` writes a response's: the request line, its method, its
/// target and its version, then the headers, an empty line and the body.
///
/// Where the body is not empty and the headers carry neither
/// `Content-Length` nor `Transfer-Encoding`, a `Content-Length` of the
/// body's size is written after them; a body is written whatever the
/// method.
///
/// ### Errors
///
/// A header faults the caller as `renderResponse` says, and so do a
/// method and a target `parseRequest` would refuse, its cause naming the
/// word: a method that is no token, an empty one among them, and a target
/// that is empty or holds a character outside U+0021 to U+007E, the
/// visible ASCII characters RFC 3986 writes a target in, `/café` among
/// them, whose `é` a client writes `%C3%A9`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let request =
///         Http.Request(method = "POST",
///                      target = "/items",
///                      version = Http.http11,
///                      headers = [Http.Header(name = "Host", value = "example.com")]);
///     String.fromUtf8(Http.renderRequest(request, String.toUtf8("{}")))
/// }
/// // => Some("POST /items HTTP/1.1\r\nHost: example.com\r\nContent-Length: 2\r\n\r\n{}")
/// ```
export fn renderRequest(request : Request, body : Bytes) : Bytes = {
    let Request(=method, =target, =version, =headers) = request;
    checkMethod(method);
    checkTarget(target);
    let requestLine = method <> " " <> target <> " " <> versionText(version);
    written(requestLine, if Bytes.isEmpty(body) then headers else withLength(headers, body), body)
}

// `HTTP/1.1`.
fn versionText(version : Version) : String =
    "HTTP/" <> Int.toString(version.major) <> "." <> Int.toString(version.minor)

// The headers, and a `Content-Length` of the body's size after them where
// they carry neither it nor `Transfer-Encoding` (RFC 9112, section 6.2).
fn withLength(headers : List(Header), body : Bytes) : List(Header) =
    match #(header(headers, "Content-Length"), header(headers, "Transfer-Encoding")) {
        #(None, None) ->
            headers <> [Header(name = "Content-Length", value = Int.toString(Bytes.size(body)))]
      | _ ->
            headers
    }

// RFC 9112, section 2.1: the first line and the headers, each ending in a
// carriage return and a line feed, an empty line, and the body.
fn written(first : String, headers : List(Header), body : Bytes) : Bytes = {
    List.forEach(headers, checkHeader);
    let lines = List.map(headers, fn(header) = header.name <> ": " <> header.value);
    String.toUtf8(String.join(first :: lines <> ["", ""], "\r\n")) <> body
}

// Report Appendix G.11: faults the writer, as a program's own error, where
// the status would not read back, as `parseResponse` reads it: one that is
// not three digits, from 100 to 999.
fn checkStatus(status : Int) : Unit =
    if status < 100 || status > 999 then
        fault("the status " <> Int.toString(status) <> " is not three digits")
    else
        Unit

// Report Appendix G.11: faults the writer, as a program's own error, where
// a body is given with a status that has none, 1xx, 204 or 304.
fn checkBodiless(status : Int, body : Bytes) : Unit =
    if isBodiless(status) && !Bytes.isEmpty(body) then
        fault("a response of status "
                  <> Int.toString(status)
                  <> " has no body, and one of "
                  <> Int.toString(Bytes.size(body))
                  <> " bytes was given")
    else
        Unit

// Report Appendix G.11: faults the writer, as a program's own error, where
// the method would not read back, as `parseRequest` reads it: one that is
// no token, an empty one among them.
fn checkMethod(method : String) : Unit =
    if isToken(String.toUtf8(method)) then
        Unit
    else
        fault("the method " <> Io.show(method) <> " is no token")

// Report Appendix G.11: faults the writer, as a program's own error, where
// the target would not read back, as `parseRequest` reads it: one that is
// empty, or holds a character outside U+0021 to U+007E, the visible ASCII
// characters RFC 3986 writes a target in.
fn checkTarget(target : String) : Unit =
    if target == "" then
        fault("the target is empty")
    else if List.any(String.toList(target),
                     fn(char) = Char.toCodePoint(char) < 33 || Char.toCodePoint(char) > 126) then
        fault("the target " <> Io.show(target) <> " holds a character outside U+0021 to U+007E")
    else
        Unit

// Report Appendix G.11: faults the writer, as a program's own error, where
// the header would break the head: a name that is no token (RFC 9110,
// section 5.6.2), or a value holding a carriage return, a line feed or
// U+0000.
fn checkHeader(header : Header) : Unit =
    if !isToken(String.toUtf8(header.name)) then
        fault("the header name " <> Io.show(header.name) <> " is no token")
    else if List.any(String.toList(header.value),
                     fn(char) = char == '\r' || char == '\n' || char == '\u{0}') then
        fault("the value of the header "
                  <> header.name
                  <> ", "
                  <> Io.show(header.value)
                  <> ", holds a carriage return, a line feed or U+0000")
    else
        Unit

// RFC 9110, section 5.6.2: whether the bytes are a token, one or more of
// the ASCII letters and digits and of ``!#$%&'*+-.^_`|~``.
fn isToken(bytes : Bytes) : Bool =
    !Bytes.isEmpty(bytes) && isTokenBytes(bytes)

fn isTokenBytes(bytes : Bytes) : Bool =
    match bytes {
        <<byte, rest:bytes>> when isTokenByte(byte) -> isTokenBytes(rest)
      | <<>> -> true
      | _ -> false
    }

fn isTokenByte(byte : Int) : Bool =
    isDigit(byte)
        || (byte >= 0x41 && byte <= 0x5A)
        || (byte >= 0x61 && byte <= 0x7A)
        || Bytes.contains(String.toUtf8("!#$%&'*+-.^_`|~"), <<byte>>)

/// One chunk of the chunked transfer coding, RFC 9112, section 7.1: the
/// size of `bytes` in hexadecimal, a carriage return and a line feed, the
/// bytes, and a carriage return and a line feed.
///
/// Empty bytes write the last chunk and an empty trailer section,
/// `0\r\n\r\n`, since no other chunk is empty. A head that names
/// `Transfer-Encoding: chunked` is rendered with an empty body, and the
/// chunks are written after it.
///
/// ### Examples
///
/// ```ernest
/// #(String.fromUtf8(Http.chunk(String.toUtf8("Hello, world"))), String.fromUtf8(Http.chunk(<<>>)))
/// // => #(Some("C\r\nHello, world\r\n"), Some("0\r\n\r\n"))
/// ```
///
/// since 0.10.0
export fn chunk(bytes : Bytes) : Bytes =
    // Base 16 is one `Int.toStringBase` writes in, so `None` does not come,
    // and would be a defect of the library's.
    match Int.toStringBase(Bytes.size(bytes), 16) {
        Some(size) -> String.toUtf8(size <> "\r\n") <> bytes <> String.toUtf8("\r\n")
      | None -> fault("Int.toStringBase writes no digits in base 16")
    }

/// Writes the request's head and `body` to `socket`, as `renderRequest`
/// renders them, within `ms` milliseconds.
///
/// A `Left` is `Socket(error)`, as `Tcp.write` answers the error:
/// `Socket(Timeout)` where the milliseconds pass first, and `Socket(Closed)`
/// once the connection has closed.
///
/// ### Errors
///
/// Faults where `renderRequest` faults, at a header, the method or the
/// target, with its cause, and nothing is written.
///
/// ### Examples
///
/// A client's request with a body, its `Content-Length` added:
///
/// ```ernest
/// fn post(socket : Address(Tcp.SocketMsg), body : Bytes) : Either(Http.SocketError, Unit) = {
///     let request =
///         Http.Request(method = "POST",
///                      target = "/items",
///                      version = Http.http11,
///                      headers = [Http.Header(name = "Host", value = "example.com")]);
///     Http.writeRequest(socket, request, body, 5000)
/// }
///
/// post
/// ```
///
/// since 0.10.0
export fn writeRequest(socket : Address(Tcp.SocketMsg),
                       request : Request,
                       body : Bytes,
                       ms : Int) : Either(SocketError, Unit) =
    sent(socket, renderRequest(request, body), ms)

/// Writes the response's head and `body` to `socket`, as `renderResponse`
/// renders them, within `ms` milliseconds.
///
/// A `Left` is `Socket(error)`, as `writeRequest` answers it.
///
/// ### Errors
///
/// Faults where `renderResponse` faults, at a header, the status, or a body
/// given with a status of 1xx, 204 or 304, with its cause, and nothing is
/// written.
///
/// ### Examples
///
/// A server's handler that answers status 404, its phrase the body, and
/// closes the connection after it:
///
/// ```ernest
/// fn notFound(socket : Address(Tcp.SocketMsg)) : Either(Http.SocketError, Unit) = {
///     let response =
///         Http.Response(version = Http.http11,
///                       status = 404,
///                       headers = [Http.Header(name = "Connection", value = "close")]);
///     Http.writeResponse(socket, response, String.toUtf8(Http.reason(404)), 5000)
/// }
///
/// notFound
/// ```
///
/// since 0.10.0
export fn writeResponse(socket : Address(Tcp.SocketMsg),
                        response : Response,
                        body : Bytes,
                        ms : Int) : Either(SocketError, Unit) =
    sent(socket, renderResponse(response, body), ms)

/// Writes one chunk of the chunked transfer coding to `socket`, as `chunk`
/// renders it, within `ms` milliseconds; empty bytes write the last chunk.
///
/// A `Left` is `Socket(error)`, as `writeRequest` answers it. The chunks
/// follow a head that names `Transfer-Encoding: chunked`, written with an
/// empty body.
///
/// ### Examples
///
/// A server's handler that answers with a body in chunks, one for each part:
///
/// ```ernest
/// fn stream(socket : Address(Tcp.SocketMsg),
///           parts : List(String)) : Either(Http.SocketError, Unit) = {
///     let chunked = [Http.Header(name = "Transfer-Encoding", value = "chunked")];
///     let response = Http.Response(version = Http.http11, status = 200, headers = chunked);
///     let _ <- Http.writeResponse(socket, response, <<>>, 5000);
///     let _ <- List.tryMap(parts, fn(part) = Http.writeChunk(socket, String.toUtf8(part), 5000));
///     Http.writeChunk(socket, <<>>, 5000)
/// }
///
/// stream
/// ```
///
/// since 0.10.0
export fn writeChunk(socket : Address(Tcp.SocketMsg),
                     bytes : Bytes,
                     ms : Int) : Either(SocketError, Unit) =
    sent(socket, chunk(bytes), ms)

// Report Appendix G.11: the bytes written to the socket within the
// milliseconds, its error the socket's.
fn sent(socket : Address(Tcp.SocketMsg), bytes : Bytes, ms : Int) : Either(SocketError, Unit) =
    Either.mapLeft(Tcp.write(socket, bytes, ms), Socket)

/// RFC 9110's phrase for `status`, `Not Found` for 404, from its section 15;
/// `""` for a status it does not name.
///
/// 306 and 418, which the RFC keeps as unused, have none.
///
/// ### Examples
///
/// ```ernest
/// #(Http.reason(404), Http.reason(299))
/// // => #("Not Found", "")
/// ```
export fn reason(status : Int) : String =
    match status {
        100 -> "Continue"
      | 101 -> "Switching Protocols"
      | 200 -> "OK"
      | 201 -> "Created"
      | 202 -> "Accepted"
      | 203 -> "Non-Authoritative Information"
      | 204 -> "No Content"
      | 205 -> "Reset Content"
      | 206 -> "Partial Content"
      | 300 -> "Multiple Choices"
      | 301 -> "Moved Permanently"
      | 302 -> "Found"
      | 303 -> "See Other"
      | 304 -> "Not Modified"
      | 305 -> "Use Proxy"
      | 307 -> "Temporary Redirect"
      | 308 -> "Permanent Redirect"
      | 400 -> "Bad Request"
      | 401 -> "Unauthorized"
      | 402 -> "Payment Required"
      | 403 -> "Forbidden"
      | 404 -> "Not Found"
      | 405 -> "Method Not Allowed"
      | 406 -> "Not Acceptable"
      | 407 -> "Proxy Authentication Required"
      | 408 -> "Request Timeout"
      | 409 -> "Conflict"
      | 410 -> "Gone"
      | 411 -> "Length Required"
      | 412 -> "Precondition Failed"
      | 413 -> "Content Too Large"
      | 414 -> "URI Too Long"
      | 415 -> "Unsupported Media Type"
      | 416 -> "Range Not Satisfiable"
      | 417 -> "Expectation Failed"
      | 421 -> "Misdirected Request"
      | 422 -> "Unprocessable Content"
      | 426 -> "Upgrade Required"
      | 500 -> "Internal Server Error"
      | 501 -> "Not Implemented"
      | 502 -> "Bad Gateway"
      | 503 -> "Service Unavailable"
      | 504 -> "Gateway Timeout"
      | 505 -> "HTTP Version Not Supported"
      | _ -> ""
    }

/// `time`, in milliseconds since the epoch, as RFC 9110's IMF-fixdate writes
/// it, in UTC: `Sun, 06 Nov 1994 08:49:37 GMT`.
///
/// The milliseconds within the second are dropped. A year is four digits,
/// and one outside 0 to 9999, which the form cannot write, is written with
/// as many as it has, a year before 0 with its sign before them.
///
/// ### Examples
///
/// ```ernest
/// Http.date(784111777000)
/// // => "Sun, 06 Nov 1994 08:49:37 GMT"
/// ```
export fn date(time : Int) : String = {
    let civil = Time.toCivil(time);
    String.join([String.slice(dayName(civil), 0, 3) <> ",",
                 twoDigits(civil.day),
                 monthName(civil.month),
                 yearText(civil.year),
                 timeOfDay(civil),
                 "GMT"],
                " ")
}

/// The time, in milliseconds since the epoch, that `text` writes as an
/// HTTP date; `None` for a text of no such form.
///
/// The three forms RFC 9110 has a recipient read are read: IMF-fixdate,
/// `Sun, 06 Nov 1994 08:49:37 GMT`, RFC 850's, `Sunday, 06-Nov-94 08:49:37
/// GMT`, and asctime's, `Sun Nov  6 08:49:37 1994`. A text is read in its
/// form's case and spacing alone, and its day of the week must be its
/// date's. A date or a time of day the calendar has not, a 60th second
/// among them, is `None`.
///
/// RFC 850's year of two digits is the latest year with those digits in
/// which the text's date and time of day are not more than 50 years after
/// `Clock.now` (RFC 9110, section 5.6.7).
///
/// ### Examples
///
/// The three forms of one time, and a day of the week that is not its date's:
///
/// ```ernest
/// #(Http.parseDate("Sun, 06 Nov 1994 08:49:37 GMT"),
///   Http.parseDate("Sunday, 06-Nov-94 08:49:37 GMT"),
///   Http.parseDate("Sun Nov  6 08:49:37 1994"),
///   Http.parseDate("Mon, 06 Nov 1994 08:49:37 GMT"))
/// // => #(Some(784111777000), Some(784111777000), Some(784111777000), None)
/// ```
export fn parseDate(text : String) : Optional(Int) =
    match String.split(text, " ") {
        [_, day, month, year, clock, "GMT"] ->
            readDate(text, civilOf(fourDigits(year), month, day, clock), date)
      | [_, dayMonthYear, clock, "GMT"] ->
            match String.split(dayMonthYear, "-") {
                [day, month, year] -> {
                    let now = Time.toCivil(Clock.now());
                    let civil =
                        Optional.map(civilOf(String.toInt(year), month, day, clock),
                                     fn(civil) = withCentury(civil, now));
                    readDate(text, civil, rfc850)
                }
              | _ ->
                    None
            }
      | [_, month, "", day, clock, year] or [_, month, day, clock, year] ->
            readDate(text, civilOf(fourDigits(year), month, day, clock), asctime)
      | _ ->
            None
    }

// Report Appendix G.11: the time of the date and the time of day, where
// `write` writes it as `text` is written, which holds the text to its form
// whole, its digits, its spacing and its day of the week.
fn readDate(text : String,
            civil : Optional(Time.Civil),
            write : (Int) -> String) : Optional(Int) = {
    let civil <- civil;
    let time <- Time.fromCivil(civil);
    if write(time) == text then Some(time) else None
}

// The date and the time of day the parts of a date name, in the year.
fn civilOf(year : Optional(Int),
           monthPart : String,
           dayPart : String,
           clockPart : String) : Optional(Time.Civil) = {
    let year <- year;
    let month <-
        Optional.map(List.find(List.indexed(months), fn(#(_, name)) = name == monthPart),
                     fn(#(index, _)) = index + 1);
    let day <- String.toInt(dayPart);
    let #(hour, minute, second) <- match List.map(String.split(clockPart, ":"), String.toInt) {
        [Some(hour), Some(minute), Some(second)] -> Some(#(hour, minute, second))
      | _ -> None
    };
    Some(Time.Civil(=year, =month, =day, =hour, =minute, =second))
}

// A year of four digits, as IMF-fixdate and asctime write it.
fn fourDigits(year : String) : Optional(Int) =
    if String.size(year) == 4 then String.toInt(year) else None

// RFC 9110, section 5.6.7: the date and the time of day whose year is RFC
// 850's two digits, in the latest year with those digits in which they are
// not more than 50 years after `now`.
fn withCentury(civil : Time.Civil, now : Time.Civil) : Time.Civil = {
    let latest = Time.Civil(..now, year = now.year + 50);
    let candidate = Time.Civil(..civil, year = latest.year - latest.year % 100 + civil.year);
    if moment(candidate) > moment(latest) then
        Time.Civil(..candidate, year = candidate.year - 100)
    else
        candidate
}

// A date and a time of day as a tuple, which compares as the moments do.
fn moment(civil : Time.Civil) : #(Int, Int, Int, Int, Int, Int) =
    #(civil.year, civil.month, civil.day, civil.hour, civil.minute, civil.second)

// RFC 850's form, `Sunday, 06-Nov-94 08:49:37 GMT`, its year of two digits.
fn rfc850(time : Int) : String = {
    let civil = Time.toCivil(time);
    let dayMonthYear = [twoDigits(civil.day), monthName(civil.month), twoDigits(civil.year % 100)];
    String.join([dayName(civil) <> ",", String.join(dayMonthYear, "-"), timeOfDay(civil), "GMT"],
                " ")
}

// asctime's form, `Sun Nov  6 08:49:37 1994`, its day padded with a space.
fn asctime(time : Int) : String = {
    let civil = Time.toCivil(time);
    String.join([String.slice(dayName(civil), 0, 3),
                 monthName(civil.month),
                 String.padStart(Int.toString(civil.day), 2, " "),
                 timeOfDay(civil),
                 yearText(civil.year)],
                " ")
}

// The time of day, `08:49:37`.
fn timeOfDay(civil : Time.Civil) : String =
    String.join([twoDigits(civil.hour), twoDigits(civil.minute), twoDigits(civil.second)], ":")

fn twoDigits(number : Int) : String =
    String.padStart(Int.toString(number), 2, "0")

// A year in four digits, or as many as it has, a year before 0 with its
// sign before them, as `Clock.toString` writes one (report Appendix E.15).
fn yearText(year : Int) : String =
    if year < 0 then
        "-" <> String.padStart(Int.toString(-year), 4, "0")
    else
        String.padStart(Int.toString(year), 4, "0")

// The day of the week of the date, in full. Every caller's date is one
// `Time.toCivil` answers, which the calendar has, so `None` does not come,
// and would be a defect of the library's.
fn dayName(civil : Time.Civil) : String =
    match Time.weekday(civil) {
        Some(Time.Monday) -> "Monday"
      | Some(Time.Tuesday) -> "Tuesday"
      | Some(Time.Wednesday) -> "Wednesday"
      | Some(Time.Thursday) -> "Thursday"
      | Some(Time.Friday) -> "Friday"
      | Some(Time.Saturday) -> "Saturday"
      | Some(Time.Sunday) -> "Sunday"
      | None -> fault("the calendar has no day of the week for " <> Io.show(civil))
    }

// The name of the month, 1 to 12, as every caller's `Time.Civil` holds
// it; another would be a defect of the library's.
fn monthName(month : Int) : String =
    match List.get(months, month - 1) {
        Some(name) -> name
      | None -> fault("the month " <> Int.toString(month) <> " is not 1 to 12")
    }

// The names of the months, January first (RFC 9110, section 5.6.7).
let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

//
// The tests (report §9.3), run by `ern test` as every library's are,
// written with the code but where a case says it is a regression test.
//

// The head a parse found, or none.
fn headOf(parsed : Either(Error, Parsed(a))) : Optional(a) =
    match parsed {
        Right(Parsed(=head)) -> Some(head)
      | _ -> None
    }

// The request whose head the text holds, within the default limits, or none.
fn requestOf(text : String) : Optional(Request) =
    headOf(parseRequest(String.toUtf8(text), defaultLimits))

// The request of RFC 9110's example exchange (section 3.9), and its head
// read.
let helloText =
    String.join(["GET /hello.txt HTTP/1.1",
                 "User-Agent: curl/7.64.1",
                 "Host: www.example.com",
                 "Accept-Language: en, mi",
                 "",
                 ""],
                "\r\n")

let hello =
    Request(method = "GET",
            target = "/hello.txt",
            version = http11,
            headers = [Header(name = "User-Agent", value = "curl/7.64.1"),
                       Header(name = "Host", value = "www.example.com"),
                       Header(name = "Accept-Language", value = "en, mi")])

// report Appendix G.11
let rfcRequest =
    Test.Case(name = "RFC 9110's example request is read, its headers in their order",
              run = fn() =
                  Test.equal(parseRequest(String.toUtf8(helloText), defaultLimits),
                             Right(Parsed(head = hello, rest = <<>>))))

// report Appendix G.11
let rfcResponse =
    Test.Case(name = "RFC 9110's example response is read, its phrase dropped", run = fn() = {
        let text =
            String.join(["HTTP/1.1 200 OK",
                         "Date: Mon, 27 Jul 2009 12:28:53 GMT",
                         "Server: Apache",
                         "Content-Length: 51",
                         "",
                         "Hello"],
                        "\r\n");
        let headers =
            [Header(name = "Date", value = "Mon, 27 Jul 2009 12:28:53 GMT"),
             Header(name = "Server", value = "Apache"),
             Header(name = "Content-Length", value = "51")];
        Test.equal(parseResponse(String.toUtf8(text), defaultLimits),
                   Right(Parsed(head = Response(version = http11, status = 200, =headers),
                                rest = String.toUtf8("Hello"))))
    })

// report Appendix G.11: written with the code.
let namedValues =
    Test.Case(name = "http11 writes HTTP/1.1, and defaultLimits lets in a line of 8192 bytes",
              run = fn() = {
                  let lineOfSize =
                      fn(count) =
                          String.toUtf8("GET /"
                                            <> String.repeat("a", count - 16)
                                            <> " HTTP/1.1\r\n\r\n");
                  let response = Response(version = http11, status = 204, headers = []);
                  Test.equal(#(String.fromUtf8(renderResponse(response, <<>>)),
                               Optional.isSome(headOf(parseRequest(lineOfSize(8192),
                                                                   defaultLimits))),
                               parseRequest(lineOfSize(8193), defaultLimits)),
                             #(Some("HTTP/1.1 204 No Content\r\n\r\n"), true, Left(LineTooLong)))
              })

// report Appendix G.11
let targetForms =
    Test.Case(name = "RFC 9112's four forms of a target are kept as written", run = fn() = {
        let lines =
            ["GET /where?q=now HTTP/1.1",
             "GET http://www.example.org/pub/WWW/TheProject.html HTTP/1.1",
             "CONNECT www.example.com:80 HTTP/1.1",
             "OPTIONS * HTTP/1.1",
             "get /a%20b HTTP/1.1"];
        let read =
            fn(line) =
                Optional.map(requestOf(line <> "\r\n\r\n"),
                             fn(request) = #(request.method, request.target));
        Test.equal(List.map(lines, read),
                   [Some(#("GET", "/where?q=now")),
                    Some(#("GET", "http://www.example.org/pub/WWW/TheProject.html")),
                    Some(#("CONNECT", "www.example.com:80")),
                    Some(#("OPTIONS", "*")),
                    Some(#("get", "/a%20b"))])
    })

// The target `target` reads in a request of the method.
fn targetOf(method : String, text : String) : Optional(Uri.Reference) =
    target(Request(=method, target = text, version = http11, headers = []))

// A reference with none of its components but the path and the query.
fn pathAndQuery(path : String, query : Optional(String)) : Uri.Reference =
    Uri.Reference(scheme = None, authority = None, =path, =query, fragment = None)

// report Appendix G.11: RFC 9112's examples of the four forms, section 3.2.
let targetRead = Test.Case(name = "a target is read in its form by the method", run = fn() = {
    let absolute = "http://www.example.org/pub/WWW/TheProject.html";
    Test.equal([targetOf("GET", "/where?q=now"),
                targetOf("GET", absolute),
                targetOf("CONNECT", "www.example.com:80"),
                targetOf("OPTIONS", "*"),
                targetOf("OPTIONS", "/")],
               [Some(pathAndQuery("/where", Some("q=now"))),
                Some(Uri.Reference(scheme = Some("http"),
                                   authority = Some(Uri.Authority(userinfo = None,
                                                                  host = "www.example.org",
                                                                  port = None)),
                                   path = "/pub/WWW/TheProject.html",
                                   query = None,
                                   fragment = None)),
                Some(Uri.Reference(scheme = None,
                                   authority = Some(Uri.Authority(userinfo = None,
                                                                  host = "www.example.com",
                                                                  port = Some(80))),
                                   path = "",
                                   query = None,
                                   fragment = None)),
                Some(pathAndQuery("*", None)),
                Some(pathAndQuery("/", None))])
})

// report Appendix G.11: written with the code.
let originSlashes =
    Test.Case(name = "an origin-form target that begins with // is a path",
              run = fn() =
                  Test.equal(List.map(["//a/b?c", "//", "/a//b"], fn(text) = targetOf("GET", text)),
                             [Some(pathAndQuery("//a/b", Some("c"))),
                              Some(pathAndQuery("//", None)),
                              Some(pathAndQuery("/a//b", None))]))

// report Appendix G.11
let noForm =
    Test.Case(name = "a target of no form, one with a fragment among them, is None",
              run = fn() =
                  Test.equal(List.filter([#("GET", "/p#f"),
                                          #("GET", "http://h/p#f"),
                                          #("GET", "*"),
                                          #("GET", "www.example.com"),
                                          #("GET", "/a b"),
                                          #("GET", "/100%"),
                                          #("CONNECT", "/"),
                                          #("CONNECT", "www.example.com:80/"),
                                          #("CONNECT", "http://www.example.com/"),
                                          #("OPTIONS", "**")],
                                         fn(#(method, text)) =
                                             Optional.isSome(targetOf(method, text))),
                             []))

// report Appendix G.11
let lineFeeds =
    Test.Case(name = "a line may end in a line feed alone",
              run = fn() =
                  Test.equal(parseRequest(String.toUtf8(String.replace(helloText, "\r\n", "\n")),
                                          defaultLimits),
                             Right(Parsed(head = hello, rest = <<>>))))

// report Appendix G.11
let versions =
    Test.Case(name = "a version is read as written",
              run = fn() =
                  Test.equal(List.map(["GET / HTTP/2.0\r\n\r\n",
                                       "GET / HTTP/1.0\r\n\r\n",
                                       "GET / HTTP/0.9\r\n\r\n"],
                                      fn(text) =
                                          Optional.map(requestOf(text),
                                                       fn(request) = request.version)),
                             [Some(Version(major = 2, minor = 0)),
                              Some(Version(major = 1, minor = 0)),
                              Some(Version(major = 0, minor = 9))]))

// report Appendix G.11
let pipelined =
    Test.Case(name = "two requests sent at once: the second is the bytes after the first's head",
              run = fn() = {
                  let bytes = String.toUtf8("GET /a HTTP/1.1\r\n\r\n" <> helloText);
                  match parseRequest(bytes, defaultLimits) {
                      Right(Parsed(head = first, =rest)) ->
                          Test.equal(#(first.target, parseRequest(rest, defaultLimits)),
                                     #("/a", Right(Parsed(head = hello, rest = <<>>))))
                    | other ->
                          Test.Failed(Io.show(other))
                  }
              })

// report Appendix G.11
let everyPrefix =
    Test.Case(name = "every part of a head short of its empty line is incomplete", run = fn() = {
        let bytes = String.toUtf8(helloText);
        Test.equal(List.filter(List.range(0, Bytes.size(bytes) - 1),
                               fn(count) =
                                   parseRequest(Bytes.slice(bytes, 0, count), defaultLimits)
                                       != Right(Incomplete)),
                   [])
    })

// report Appendix G.11
let malformed =
    Test.Case(name = "a head the host cannot read, or Ernest refuses, is malformed", run = fn() = {
        let texts =
            ["GET /\r\n\r\n",
             "GET  HTTP/1.1\r\n\r\n",
             "junk\r\n\r\n",
             "\r\n\r\nGET / HTTP/1.1\r\n\r\n",
             "GET / HTTP/1.1x\r\n\r\n",
             "GET / HTTP/1.10\r\n\r\n",
             "GET / HTTP/1.1\r\r\n\r\n",
             "GET / HTTP/1.1 more\r\n\r\n",
             "GET /a\rb HTTP/1.1\r\n\r\n",
             "HTTP/1.1 200 OK\r\n\r\n",
             "GET / HTTP/1.1\r\nX-Thing\r\n\r\n",
             "GET / HTTP/1.1\r\n: a\r\n\r\n",
             "GET / HTTP/1.1\r\nHost : a\r\n\r\n",
             "GET / HTTP/1.1\r\nX: a\r\n b\r\n\r\n",
             "GET / HTTP/1.1\r\nX: a\r\n\tb\r\n\r\n",
             "GET / HTTP/1.1\r\nX: a\rb\r\n\r\n",
             "GET / HTTP/1.1\r\nX: a\u{0}b\r\n\r\n",
             "GET / HTTP/11.1\r\n\r\n",
             "GET /a\rHTTP/1.1\r\n\r\n",
             "GET\r/\rHTTP/1.1\r\n\r\n",
             "GET /\u{e9} HTTP/1.1\r\n\r\n",
             "GET /\u{301}x HTTP/1.1\r\n\r\n",
             "GET /a\u{1}b HTTP/1.1\r\n\r\n",
             "GET /\u{7f} HTTP/1.1\r\n\r\n",
             "GET / HTTP/1.1\r\nX y: z\r\n\r\n",
             "GET / HTTP/1.1\r\n Host: x\r\n\r\n",
             "GET / HTTP/1.1\r\nX(y): z\r\n\r\n"];
        let notUtf8 =
            List.map([<<255>>, <<0xC3>>],
                     fn(byte) =
                         String.toUtf8("GET / HTTP/1.1\r\nX: a")
                             <> byte
                             <> String.toUtf8("\r\n\r\n"));
        let responses = ["GET / HTTP/1.1\r\n\r\n", "\r\nHTTP/1.1 200 OK\r\n\r\n"];
        Test.equal(#(List.map(texts, fn(text) = parseRequest(String.toUtf8(text), defaultLimits))
                         <> List.map(notUtf8, fn(bytes) = parseRequest(bytes, defaultLimits)),
                     List.map(responses,
                              fn(text) = parseResponse(String.toUtf8(text), defaultLimits))),
                   #(List.repeat(Left(Malformed), List.size(texts) + 2),
                     [Left(Malformed), Left(Malformed)]))
    })

// report Appendix G.11: a request line's words, and a status line's, are
// parted at runs of spaces and tabs, the phrase after a status dropped,
// an empty one among them, and a method, a target and a header's name are
// read as the client wrote them, where the host reads a name it knows as
// its own atom and recapitalizes one it does not.
let asWritten =
    Test.Case(name = "a line's words are parted at runs of blanks, and read as written",
              run = fn() = {
                  let request =
                      requestOf("PATCH  /a%CC%81\tHTTP/1.0 \r\nhost: a\r\n"
                                    <> "Sec-WebSocket-Key: k\r\n\r\n");
                  let statuses =
                      ["HTTP/1.1  200 OK",
                       "HTTP/1.1\t200\tOK",
                       "HTTP/1.1 099 Low",
                       "HTTP/1.1 404",
                       "HTTP/1.1 404 ",
                       "HTTP/1.0 200 Very Fine"];
                  let status =
                      fn(line) =
                          Optional.map(headOf(parseResponse(String.toUtf8(line <> "\r\n\r\n"),
                                                            defaultLimits)),
                                       fn(response) = #(response.version.minor, response.status));
                  Test.equal(#(request, List.map(statuses, status)),
                             #(Some(Request(method = "PATCH",
                                            target = "/a%CC%81",
                                            version = Version(major = 1, minor = 0),
                                            headers = [Header(name = "host", value = "a"),
                                                       Header(name = "Sec-WebSocket-Key",
                                                              value = "k")])),
                               [Some(#(1, 200)),
                                Some(#(1, 200)),
                                Some(#(1, 99)),
                                Some(#(1, 404)),
                                Some(#(1, 404)),
                                Some(#(0, 200))]))
              })

// report Appendix G.11: written with the code; an empty line alone is no
// request yet, and the line's limit is the request line's.
let emptyLineSkipped =
    Test.Case(name = "one empty line before a request line is skipped, on a socket too",
              run = fn() =
                  Test.equal(#(List.map(["\r\nGET /a HTTP/1.1\r\n\r\n", "\nGET /a HTTP/1.1\n\n"],
                                        fn(text) =
                                            Optional.map(requestOf(text),
                                                         fn(request) = request.target)),
                               List.map(["\r\n", "\r", "\n\r"],
                                        fn(text) =
                                            parseRequest(String.toUtf8(text), defaultLimits)),
                               parseRequest(String.toUtf8("\r\nGET / HTTP/1.1\r\n\r\n"),
                                            Limits(line = 1, headers = 0)),
                               served(["GET /b HTTP/1.1\r\n\r\n"],
                                      StaysOpen,
                                      fn(socket) =
                                          Either.map(readRequest(socket,
                                                                 String.toUtf8("\n"),
                                                                 defaultLimits,
                                                                 1000),
                                                     fn(#(request, _)) = request.target))),
                             #([Some("/a"), Some("/a")],
                               [Right(Incomplete), Right(Incomplete), Right(Incomplete)],
                               Left(LineTooLong),
                               Right(Right("/b")))))

// report Appendix G.11: a regression test; the host read these as 20, 2000
// and 200.
let threeDigits = Test.Case(name = "a status line's status is three digits", run = fn() = {
    let read = fn(text) = parseResponse(String.toUtf8(text), defaultLimits);
    Test.equal(List.map(["HTTP/1.1 20 OK\r\n\r\n",
                         "HTTP/1.1 2000 OK\r\n\r\n",
                         "HTTP/1.1 0200 OK\r\n\r\n",
                         "HTTP/1.1 2 00 OK\r\n\r\n",
                         "HTTP/1.1 20\r\n\r\n",
                         "HTTP/1.1 200 OK\r\n\r\n"],
                        read),
               [Left(Malformed),
                Left(Malformed),
                Left(Malformed),
                Left(Malformed),
                Left(Malformed),
                Right(Parsed(head = Response(version = http11, status = 200, headers = []),
                             rest = <<>>))])
})

// report Appendix G.11: written with the code.
let responseFolds =
    Test.Case(name = "a response's header folded over lines is read with each fold one space",
              run = fn() = {
                  let text = "HTTP/1.1 200 OK\r\nX: a \r\n\t b\r\n c\r\nY: d\r\n\r\n";
                  let bareReturn = "HTTP/1.1 200 OK\r\nX: a\r\r\n b\r\n\r\n";
                  let headers =
                      fn(text) =
                          Optional.map(headOf(parseResponse(String.toUtf8("HTTP/1.1 200 OK\r\n"
                                                                              <> text),
                                                            defaultLimits)),
                                       fn(response) = response.headers);
                  Test.equal(#(Optional.map(headOf(parseResponse(String.toUtf8(text),
                                                                 defaultLimits)),
                                            fn(response) = response.headers),
                               List.map(["X:\r\n b\r\n\r\n",
                                         "X: a\n b\n\n",
                                         "X: a\r\n \r\n b\r\n\r\n"],
                                        headers),
                               parseResponse(String.toUtf8(bareReturn), defaultLimits),
                               parseRequest(String.toUtf8("GET / HTTP/1.1\r\nX: a\r\n b\r\n\r\n"),
                                            defaultLimits)),
                             #(Some([Header(name = "X", value = "a b c"),
                                     Header(name = "Y", value = "d")]),
                               [Some([Header(name = "X", value = "b")]),
                                Some([Header(name = "X", value = "a b")]),
                                Some([Header(name = "X", value = "a  b")])],
                               Left(Malformed),
                               Left(Malformed)))
              })

// report Appendix G.11
let lineTooLong =
    Test.Case(name = "a first line past the limit, its line ending among its bytes, is too long",
              run = fn() = {
                  // 24 bytes
                  let line = "GET /abcdefgh HTTP/1.1\r\n";
                  Test.equal(#(headOf(parseRequest(String.toUtf8(line <> "\r\n"),
                                                   Limits(line = 24, headers = 0))),
                               parseRequest(String.toUtf8(line), Limits(line = 23, headers = 0)),
                               parseRequest(String.toUtf8("GET /abcdefghijklmnopqrstuvwxyz"),
                                            Limits(line = 23, headers = 0)),
                               // 21 bytes, which may still end in time
                               List.map([21, 22],
                                        fn(limit) =
                                            parseRequest(String.toUtf8("GET /abcdefghijklmnop"),
                                                         Limits(line = limit, headers = 0))),
                               parseRequest(String.toUtf8(line), Limits(line = 0, headers = 0)),
                               parseRequest(String.toUtf8(line), Limits(line = -1, headers = 0)),
                               parseRequest(<<>>, Limits(line = 0, headers = 0))),
                             #(Some(Request(method = "GET",
                                            target = "/abcdefgh",
                                            version = http11,
                                            headers = [])),
                               Left(LineTooLong),
                               Left(LineTooLong),
                               [Left(LineTooLong), Right(Incomplete)],
                               Left(LineTooLong),
                               Left(LineTooLong),
                               Right(Incomplete)))
              })

// report Appendix G.11
let headersTooLarge =
    Test.Case(name = "a header line past the line's limit, and headers past theirs, are too large",
              run = fn() = {
                  // header lines of 6 bytes each, and one of 21
                  let text = "GET / HTTP/1.1\r\nX: a\r\nY: b\r\n\r\n";
                  let long = "GET / HTTP/1.1\r\nX: abcdefghijklmn\r\n\r\n";
                  Test.equal(#(headOf(parseRequest(String.toUtf8(text),
                                                   Limits(line = 16, headers = 12))),
                               parseRequest(String.toUtf8(text), Limits(line = 16, headers = 11)),
                               parseRequest(String.toUtf8(long), Limits(line = 16, headers = 1000)),
                               parseRequest(String.toUtf8("GET / HTTP/1.1\r\nX: a\r\nY"),
                                            Limits(line = 16, headers = 5)),
                               parseRequest(String.toUtf8("GET / HTTP/1.1\r\nX: a\r\nYYYY"),
                                            Limits(line = 100, headers = 10))),
                             #(Some(Request(method = "GET",
                                            target = "/",
                                            version = http11,
                                            headers = [Header(name = "X", value = "a"),
                                                       Header(name = "Y", value = "b")])),
                               Left(HeadersTooLarge),
                               Left(HeadersTooLarge),
                               Left(HeadersTooLarge),
                               Left(HeadersTooLarge)))
              })

// report Appendix G.11: a header line may take what the headers' limit
// leaves, or the line's where that is less, and is refused at the bytes
// that pass it, before its line feed comes; the empty line that ends the
// head is no header line, and may take the line's limit. A regression
// test: the limit was found only after the line's end (the log's *The
// Libraries' Shims Read Against E.0 Rule 1*).
let headersInLine =
    Test.Case(name = "a header line is refused at the bytes that pass what the limits leave",
              run = fn() = {
                  let head = "GET / HTTP/1.1\r\nX: a\r\n";
                  let read =
                      fn(text, line, headers) =
                          Either.map(parseRequest(String.toUtf8(text), Limits(=line, =headers)),
                                     fn(parsed) = Optional.isSome(headOf(Right(parsed))));
                  Test.equal([read("GET / HTTP/1.1\r\nX: abcdefghijklm", 16, 100),
                              read("GET / HTTP/1.1\r\nX: abcdefghijkl", 16, 100),
                              read(head <> "YYY", 100, 10),
                              read(head <> "YYYY", 100, 10),
                              read(head <> String.repeat("Y", 90), 100, 10),
                              read("GET / HTTP/1.1\r\nX", 100, 0),
                              read(head <> "\r\nrest", 100, 6),
                              read("GET / HTTP/1.1\r\n\r\n", 100, 0),
                              read(head <> "\r\n", 100, -1),
                              // 2^40, past the most the host's size takes
                              read(head <> "\r\n", 1099511627776, 1099511627776)],
                             [Left(HeadersTooLarge),
                              Right(false),
                              Right(false),
                              Left(HeadersTooLarge),
                              Left(HeadersTooLarge),
                              Left(HeadersTooLarge),
                              Right(true),
                              Right(true),
                              Left(HeadersTooLarge),
                              Right(true)])
              })

// report Appendix G.11: a regression test, written after the code: the
// empty line split between the carried bytes and the socket, its carriage
// return carried and its line feed read, once the header lines have spent
// the headers' limit, takes the line's limit. It does not cover a split at
// another byte with the limit spent; `everySplit` reads every split within
// the default limits.
let headEndSplit =
    Test.Case(name = "an empty line split across the carried bytes and the socket ends a full head",
              run = fn() =
                  Test.equal(served(["\n"],
                                    StaysOpen,
                                    fn(socket) =
                                        Either.map(readRequest(socket,
                                                               String.toUtf8("GET / HTTP/1.1\r\n"
                                                                                 <> "X: a\r\n\r"),
                                                               Limits(line = 100, headers = 6),
                                                               1000),
                                                   fn(#(request, rest)) =
                                                       #(request.headers, rest))),
                             Right(Right(#([Header(name = "X", value = "a")], <<>>)))))

// report Appendix G.11: a regression test, written after the code: a header
// line refused whatever follows it, one the host cannot read or whose name
// or value `parseRequest` refuses, was refused only once the byte after it
// came, so a head that ended with it was incomplete, and on a socket met
// the deadline. It does not cover a line refused only once a fold after it
// is read.
let refusedLast =
    Test.Case(name = "a head whose last line is refused is malformed before another byte comes",
              run = fn() = {
                  let requests =
                      ["GET / HTTP/1.1\r\njunk\r\n",
                       "GET / HTTP/1.1\r\n\r\r\n",
                       "GET / HTTP/1.1\r\nX: a\r\nX y: z\n",
                       "GET / HTTP/1.1\r\nX: a\u{0}b\r\n",
                       "GET / HTTP/1.1\r\n: a\r\n"];
                  let responses =
                      ["HTTP/1.1 200 OK\r\njunk\r\n", "HTTP/1.1 200 OK\r\nX: a\u{0}\r\n"];
                  Test.equal(#(List.map(requests,
                                        fn(text) =
                                            parseRequest(String.toUtf8(text), defaultLimits)),
                               List.map(responses,
                                        fn(text) =
                                            parseResponse(String.toUtf8(text), defaultLimits)),
                               parseRequest(String.toUtf8("GET / HTTP/1.1\r\nX: a\r\n"),
                                            defaultLimits),
                               served(["GET / HTTP/1.1\r\njunk\r\n"],
                                      StaysOpen,
                                      fn(socket) = readRequest(socket, <<>>, defaultLimits, 1000))),
                             #(List.repeat(Left(Malformed), List.size(requests)),
                               List.repeat(Left(Malformed), List.size(responses)),
                               Right(Incomplete),
                               Right(Left(Protocol(Malformed)))))
              })

// report Appendix G.11: a regression test, written after the code: a
// header's name holding U+007F, which the host reads as a token's, was
// read, in a request and in a response, and a head that ended with its
// line was incomplete. It does not cover another character the host's
// table reads otherwise than RFC 9110's token, of which there is none.
let nameToken = Test.Case(name = "a header whose name holds U+007F is malformed", run = fn() = {
    let field = "X\u{7f}Y: a\r\n";
    Test.equal(#(parseRequest(String.toUtf8("GET / HTTP/1.1\r\n" <> field <> "\r\n"),
                              defaultLimits),
                 parseResponse(String.toUtf8("HTTP/1.1 200 OK\r\n" <> field <> "\r\n"),
                               defaultLimits),
                 parseRequest(String.toUtf8("GET / HTTP/1.1\r\n" <> field), defaultLimits)),
               #(Left(Malformed), Left(Malformed), Left(Malformed)))
})

// report Appendix G.11: a regression test, written after the code: a
// method holding U+007F, which the host read as a token's, was read, and
// bytes that are exactly an empty line passed a line's limit of 1, which
// the host does not check for them. With them, a line that begins with a
// blank and a version past its form are malformed, and a status line's
// version is read as written. It does not cover a line the cases of
// `malformed`, `asWritten`, `threeDigits` and `lineTooLong` do not name.
let firstLines =
    Test.Case(name = "a first line is read by its words, a request's method a token", run = fn() = {
        let requests =
            [" GET / HTTP/1.1\r\n\r\n",
             "\tGET / HTTP/1.1\r\n\r\n",
             "G\u{7f}T / HTTP/1.1\r\n\r\n",
             "G(T / HTTP/1.1\r\n\r\n",
             "GET / HTTP/1.1.1\r\n\r\n"];
        let responses =
            [" HTTP/1.1 200 OK\r\n\r\n",
             "HTTP/1.1x 200 OK\r\n\r\n",
             "HTTP/1. 200 OK\r\n\r\n",
             "http/1.1 200 OK\r\n\r\n",
             "HTTP/1.1.1 200 OK\r\n\r\n"];
        let version =
            fn(text) =
                Optional.map(headOf(parseResponse(String.toUtf8(text), defaultLimits)),
                             fn(response) = response.version);
        Test.equal(#(List.map(requests,
                              fn(text) = parseRequest(String.toUtf8(text), defaultLimits)),
                     List.map(responses,
                              fn(text) = parseResponse(String.toUtf8(text), defaultLimits)),
                     parseRequest(String.toUtf8("\r\n"), Limits(line = 1, headers = 0)),
                     List.map(["HTTP/1.10 200 OK\r\n\r\n", "HTTP/12.3 200 OK\r\n\r\n"], version)),
                   #(List.repeat(Left(Malformed), List.size(requests)),
                     List.repeat(Left(Malformed), List.size(responses)),
                     Left(LineTooLong),
                     [Some(Version(major = 1, minor = 10)), Some(Version(major = 12, minor = 3))]))
    })

// report Appendix G.11
let values =
    Test.Case(name = "a value is read without the white space around it, a name as written",
              run = fn() = {
                  let text = "GET / HTTP/1.1\r\nx-CUSTOM: \t a b \t \r\nEmpty:\r\n\r\n";
                  Test.equal(Optional.map(requestOf(text), fn(request) = request.headers),
                             Some([Header(name = "x-CUSTOM", value = "a b"),
                                   Header(name = "Empty", value = "")]))
              })

// report Appendix G.11
let anyCase =
    Test.Case(name = "a header is found by its name in any case, every value in order",
              run = fn() = {
                  let fields =
                      [Header(name = "Set-Cookie", value = "a=1"),
                       Header(name = "content-TYPE", value = "text/plain"),
                       Header(name = "SET-COOKIE", value = "b=2")];
                  Test.equal(#(header(fields, "Content-Type"),
                               header(fields, "set-cookie"),
                               header(fields, "Host"),
                               headers(fields, "Set-Cookie"),
                               headers(fields, "Host")),
                             #(Some("text/plain"), Some("a=1"), None, ["a=1", "b=2"], []))
              })

// report Appendix G.11, RFC 6265, section 4.2
let cookiesRead =
    Test.Case(name = "the pairs of every Cookie header are read in order",
              run = fn() =
                  Test.equal(cookies([Header(name = "Cookie",
                                             value = "SID=31d4d96e407aad42; lang=en-US"),
                                      Header(name = "Host", value = "example.com"),
                                      Header(name = "cookie", value = "theme=dark")]),
                             [#("SID", "31d4d96e407aad42"),
                              #("lang", "en-US"),
                              #("theme", "dark")]))

// report Appendix G.11
let cookieParts =
    Test.Case(name = "a cookie's part is parted at its first =, its name and its value trimmed, "
                  <> "one with no = or no name dropped, its quotes kept",
              run = fn() =
                  Test.equal(cookies([Header(name = "Cookie",
                                             value = " a = 1 ;b=x=y;  ; flag ;=2; = 3;e= x y ;"
                                                 <> "c=\"q;\";d= ")]),
                             [#("a", "1"),
                              #("b", "x=y"),
                              #("e", "x y"),
                              #("c", "\"q"),
                              #("d", "")]))

// report Appendix G.11
let cookieFound =
    Test.Case(name = "a cookie is the first value under its name, compared exactly", run = fn() = {
        let fields =
            [Header(name = "Cookie", value = "sid=1; Theme=dark"),
             Header(name = "Cookie", value = "sid=2; theme=light")];
        Test.equal(#(cookie(fields, "sid"),
                     cookie(fields, "theme"),
                     cookie(fields, "SID"),
                     cookie([], "sid")),
                   #(Some("1"), Some("light"), None, None))
    })

// report Appendix G.11
let rendered =
    Test.Case(name = "a head is written with Content-Length where the headers carry none",
              run = fn() = {
                  let response = Response(version = http11, status = 404, headers = []);
                  let request =
                      Request(method = "GET", target = "/", version = http11, headers = []);
                  Test.equal(List.map([renderResponse(response, String.toUtf8("gone")),
                                       renderResponse(Response(..response, status = 299), <<>>),
                                       renderRequest(request, <<>>),
                                       renderRequest(Request(..request, method = "PUT"),
                                                     String.toUtf8("x"))],
                                      String.fromUtf8),
                             [Some("HTTP/1.1 404 Not Found\r\nContent-Length: 4\r\n\r\ngone"),
                              Some("HTTP/1.1 299 \r\nContent-Length: 0\r\n\r\n"),
                              Some("GET / HTTP/1.1\r\n\r\n"),
                              Some("PUT / HTTP/1.1\r\nContent-Length: 1\r\n\r\nx")])
              })

// report Appendix G.11: written with the code.
let renderFaults =
    Test.Case(name = "a head that would not read back as written faults its writer", run = fn() = {
        let request = Request(method = "GET", target = "/", version = http11, headers = []);
        let response = Response(version = http11, status = 200, headers = []);
        let withHeader =
            fn(name, value) =
                renderResponse(Response(..response, headers = [Header(=name, =value)]), <<>>);
        let faults =
            [#(fn() = withHeader("X Y", "a"), "the header name \"X Y\" is no token"),
             #(fn() = withHeader("", "a"), "the header name \"\" is no token"),
             #(fn() = withHeader("X", "a\r\nSet-Cookie: evil"),
               "the value of the header X, \"a\\r\\nSet-Cookie: evil\", holds a carriage return,"
                   <> " a line feed or U+0000"),
             #(fn() = withHeader("X", "a\u{0}b"),
               "the value of the header X, \"a\\u{0}b\", holds a carriage return, a line feed or"
                   <> " U+0000"),
             #(fn() = renderRequest(Request(..request, method = "GE T"), <<>>),
               "the method \"GE T\" is no token"),
             #(fn() = renderRequest(Request(..request, method = "GET("), <<>>),
               "the method \"GET(\" is no token"),
             #(fn() = renderRequest(Request(..request, method = ""), <<>>),
               "the method \"\" is no token"),
             #(fn() = renderRequest(Request(..request, target = "/a\r\nb"), <<>>),
               "the target \"/a\\r\\nb\" holds a character outside U+0021 to U+007E"),
             #(fn() = renderRequest(Request(..request, target = "/café"), <<>>),
               "the target \"/café\" holds a character outside U+0021 to U+007E"),
             #(fn() = renderRequest(Request(..request, target = ""), <<>>), "the target is empty"),
             #(fn() = renderResponse(Response(..response, status = 204), String.toUtf8("oops")),
               "a response of status 204 has no body, and one of 4 bytes was given"),
             #(fn() = renderResponse(Response(..response, status = 1000), <<>>),
               "the status 1000 is not three digits"),
             #(fn() = renderResponse(Response(..response, status = 99), <<>>),
               "the status 99 is not three digits"),
             #(fn() = renderResponse(Response(..response, status = -1), <<>>),
               "the status -1 is not three digits")];
        Test.equal(List.map(faults, fn(#(write, cause)) = Test.faults(write, cause)),
                   List.repeat(Test.Passed, List.size(faults)))
    })

// report Appendix G.11
let bodyWhateverMethod =
    Test.Case(name = "a request's body is written whatever its method", run = fn() = {
        let request = Request(method = "GET", target = "/", version = http11, headers = []);
        Test.equal(String.fromUtf8(renderRequest(request, String.toUtf8("x"))),
                   Some("GET / HTTP/1.1\r\nContent-Length: 1\r\n\r\nx"))
    })

// report Appendix G.11
let renderedWithout =
    Test.Case(name = "no Content-Length for a 1xx, a 204 or a 304, or beside Transfer-Encoding",
              run = fn() = {
                  let response = Response(version = http11, status = 204, headers = []);
                  let chunked = [Header(name = "Transfer-Encoding", value = "chunked")];
                  let request =
                      Request(method = "POST", target = "/", version = http11, headers = chunked);
                  let upgrade = [Header(name = "Upgrade", value = "websocket")];
                  // the headers and the body of a chunked message, its last chunk alone
                  let chunkedRest = "Transfer-Encoding: chunked\r\n\r\n0\r\n\r\n";
                  Test.equal(List.map([renderResponse(response, <<>>),
                                       renderResponse(Response(..response,
                                                               status = 101,
                                                               headers = upgrade),
                                                      <<>>),
                                       renderResponse(Response(..response, status = 304), <<>>),
                                       renderResponse(Response(..response,
                                                               status = 200,
                                                               headers = chunked),
                                                      String.toUtf8("0\r\n\r\n")),
                                       renderRequest(request, String.toUtf8("0\r\n\r\n"))],
                                      String.fromUtf8),
                             [Some("HTTP/1.1 204 No Content\r\n\r\n"),
                              Some("HTTP/1.1 101 Switching Protocols\r\n"
                                       <> "Upgrade: websocket\r\n\r\n"),
                              Some("HTTP/1.1 304 Not Modified\r\n\r\n"),
                              Some("HTTP/1.1 200 OK\r\n" <> chunkedRest),
                              Some("POST / HTTP/1.1\r\n" <> chunkedRest)])
              })

// report Appendix G.11
let readBack =
