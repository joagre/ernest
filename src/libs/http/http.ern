//
// The tests over a connection on the loopback
//

// A connection over the loopback: the server's socket and the client's.
fn connection() : Either(Io.Error, #(Address(Tcp.SocketMsg), Address(Tcp.SocketMsg))) = {
    let listener <- Tcp.listen("127.0.0.1", 0);
    let port <- Tcp.port(listener);
    let client <- Tcp.connect("127.0.0.1", port, 1000);
    let server <- Tcp.accept(listener, 1000);
    Tcp.closeListener(listener);
    Right(#(server, client))
}

// Whether the client closes the connection once it has written.
type Ending = Closes | StaysOpen

// What `read` answers on the server's socket, once the client has written
// the texts and, where it `Closes`, closed the connection.
fn served(texts : List(String),
          ending : Ending,
          read : (Address(Tcp.SocketMsg)) -> a) : Either(Io.Error, a) = {
    let #(server, client) <- connection();
    let _ <- List.tryMap(texts, fn(text) = Tcp.write(client, String.toUtf8(text), 1000));
    if ending == Closes then Tcp.close(client) else Unit;
    let answer = read(server);
    Tcp.close(client);
    Tcp.close(server);
    Right(answer)
}

