// report Appendix G.11: written with the code on the decision of the
// release review's E4-8 and K19 (2026-11-03).
let renderFaults =
    Test.Case(name = "a head that would not read back as written faults its writer", run = fn() = {
        let request = Request(method = "GET", target = "/", version = testVersion, headers = []);
        let response = Response(version = testVersion, status = 200, headers = []);
        let withHeader =
            fn(name, value) =
                renderResponse(Response(..response, headers = [Header(=name, =value)]), <<>>);
        let faults =
            [#(fn() = withHeader("X Y", "a"), "the header name \"X Y\" is no token"),
             #(fn() = withHeader("", "a"), "the header name \"\" is no token"),
             #(fn() = withHeader("X", "a\r\nSet-Cookie: evil"),
               "the value of the header X, \"a\\r\\nSet-Cookie: evil\", holds a carriage return,"
                   <> " a line feed or U+0000"),
             #(fn() = withHeader("X", "a\u{0}b"),
               "the value of the header X, \"a\\u{0}b\", holds a carriage return, a line feed or"
                   <> " U+0000"),
             #(fn() = renderRequest(Request(..request, method = "GE T"), <<>>),
               "the method \"GE T\" is no token"),
             #(fn() = renderRequest(Request(..request, method = "GET("), <<>>),
               "the method \"GET(\" is no token"),
             #(fn() = renderRequest(Request(..request, method = ""), <<>>),
               "the method \"\" is no token"),
             #(fn() = renderRequest(Request(..request, target = "/a\r\nb"), <<>>),
               "the target \"/a\\r\\nb\" holds a character outside U+0021 to U+007E"),
             #(fn() = renderRequest(Request(..request, target = "/café"), <<>>),
               "the target \"/café\" holds a character outside U+0021 to U+007E"),
             #(fn() = renderRequest(Request(..request, target = ""), <<>>), "the target is empty"),
             #(fn() = renderResponse(Response(..response, status = 204), String.toUtf8("oops")),
               "a response of status 204 has no body, and one of 4 bytes was given")];
        Test.equal(List.map(faults, fn(#(write, cause)) = Test.faults(write, cause)),
                   List.repeat(Test.Passed, List.size(faults)))
    })

