/// HTTP/1.1's messages as RFC 9112 writes them: a request's or a response's
/// head read from bytes or from a socket, the body after it, and a head and a
/// body written, with RFC 9110's dates and status phrases.
///
/// Use it to serve HTTP over `Tcp`, or to speak it to a server. A server
/// reads a request's head with `readRequest` and its body with
/// `readRequestBody`, and writes its response with `renderResponse`; a
/// client writes its request with `renderRequest` and reads the response
/// with `readResponse` and `readResponseBody`. `parseRequest` and
/// `parseResponse` read a head from bytes a program already holds.
///
/// The library stands on every job's load path, so a program names it with
/// no option (report Appendix G).
///
/// **A head.** A line ends in a line feed, with or without a carriage return
/// before it. A request's method and target and a header's name are kept as
/// written, and a header's value without the white space around it. A head
/// that passes its `Limits` is refused at the bytes that pass them, so that
/// a reader holds no more of a head than the limits allow.
///
/// **The bytes after a head or a body.** A socket answers what has arrived,
/// which may run past the head, into its body, or past the body, into a
/// second request a client sent before the first's answer. A reader answers
/// those bytes, and the next reader is given them as `carried`, which it
/// reads before the socket.
///
/// **Waiting.** The milliseconds a reader is given bound the whole head, or
/// the whole body, and not each read from the socket, so that a client that
/// sends a byte a second meets them.
///
/// **A body.** The head's headers frame it: the chunked coding, else
/// `Content-Length`. Where they carry neither, a request has no body, and a
/// response's runs to the connection's close, as it does where its last
/// transfer coding is not chunked. A response of status 1xx, 204 or 304 has
/// no body, whatever its headers. Nor has one to a `HEAD` request, which
/// its reader cannot know: a client that sent `HEAD` reads no body.
///
/// ## Examples
///
/// A request's head read from bytes:
///
/// ```ernest
/// {
///     let bytes = String.toUtf8("GET /hello.txt HTTP/1.1\r\nHost: www.example.com\r\n\r\n");
///     match Http.parseRequest(bytes, Http.Limits(line = 8192, headers = 65536)) {
///         Right(Http.Parsed(head = request)) ->
///             #(request.method, request.target, Http.header(request.headers, "host"))
///       | _ ->
///             #("", "", None)
///     }
/// }
/// // => #("GET", "/hello.txt", Some("www.example.com"))
/// ```
///
/// A response written, its `Content-Length` added:
///
/// ```ernest
/// {
///     let response =
///         Http.Response(version = Http.Version(major = 1, minor = 1),
///                       status = 200,
///                       headers = [Http.Header(name = "Content-Type", value = "text/plain")]);
///     String.fromUtf8(Http.renderResponse(response, String.toUtf8("Hello")))
/// }
/// // => Some("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\n\r\nHello")
/// ```
///
/// ## See also
///
/// `Tcp` for the sockets the readers read, `Bytes` for what they answer.
///
/// since 0.9.0

/// A version of HTTP, `HTTP/1.1` being `Version(major = 1, minor = 1)`.
///
/// ### Examples
///
/// ```ernest
/// Http.Version(major = 1, minor = 1)
/// // => Http.Version(major = 1, minor = 1)
/// ```
export type Version = Version(
    /// The number before the point.
    major : Int,
    /// The number after the point.
    minor : Int)

/// A header: its name, which a reader keeps as written, and its value.
///
/// ### Examples
///
/// ```ernest
/// Http.Header(name = "Content-Type", value = "text/html")
/// // => Http.Header(name = "Content-Type", value = "text/html")
/// ```
export type Header = Header(
    /// The name, which `header` and `headers` compare in any case.
    name : String,
    /// The value, without the white space before and after it.
    value : String)

/// A request's head: its method, its target, its version and its headers,
/// in their order.
///
/// ### Examples
///
/// ```ernest
/// {
///     let request =
///         Http.Request(method = "GET",
///                      target = "/",
///                      version = Http.Version(major = 1, minor = 1),
///                      headers = [Http.Header(name = "Host", value = "example.com")]);
///     #(request.method, request.target, request.headers)
/// }
/// // => #("GET", "/", [Http.Header(name = "Host", value = "example.com")])
/// ```
export type Request = Request(
    /// The method, `GET`, `POST` or another, as the client wrote it.
    method : String,
    /// The target as the client wrote it: a path with its query, an
    /// absolute URI, a host and a port, or `*`.
    target : String,
    /// The version of HTTP the request is written in.
    version : Version,
    /// The headers, in their order.
    headers : List(Header))

/// A response's head: its version, its status and its headers, in their
/// order. The status line's phrase is the status's, which `reason` gives.
///
/// ### Examples
///
/// ```ernest
/// Http.Response(version = Http.Version(major = 1, minor = 1), status = 404, headers = [])
/// // => Http.Response(version = Http.Version(major = 1, minor = 1), status = 404, headers = [])
/// ```
export type Response = Response(
    /// The version of HTTP the response is written in.
    version : Version,
    /// The status, 200 for success.
    status : Int,
    /// The headers, in their order.
    headers : List(Header))

/// The most bytes a head may take: of any of its lines, the line ending
/// among them, and of its header lines together, theirs among them.
///
/// ### Examples
///
/// ```ernest
/// Http.Limits(line = 8192, headers = 65536)
/// // => Http.Limits(line = 8192, headers = 65536)
/// ```
export type Limits = Limits(
    /// The most bytes of any line; a limit below 1 lets no line in.
    line : Int,
    /// The most bytes of the header lines together.
    headers : Int)

/// Why a head or a body is refused.
///
/// ### Examples
///
/// ```ernest
/// Http.parseRequest(String.toUtf8("GET /\r\n\r\n"), Http.Limits(line = 8192, headers = 65536))
/// // => Left(Http.Malformed)
/// ```
export type Error =
    /// A first line that is no request line or no status line, a request
    /// line with no version and a status line whose status is not three
    /// digits among them; a header line with no name or no `:`; a header
    /// value holding a carriage return, a line feed or a NUL, a request's
    /// header folded over two lines among them, or bytes that are not UTF-8;
    /// or a body whose framing cannot be read.
    Malformed
  /// A first line past the limit of a line.
  | LineTooLong
  /// A header line past the limit of a line, or header lines past the
  /// limit of the headers together.
  | HeadersTooLarge
  /// A body past the limit its reader is given.
  | BodyTooLarge

/// What reading a head from bytes found: `Incomplete` where the bytes end
/// before the head does, else the head and the bytes after it.
///
/// ### Examples
///
/// ```ernest
/// Http.parseRequest(String.toUtf8("GET / HTTP/1.1\r\n"),
///                   Http.Limits(line = 8192, headers = 65536))
/// // => Right(Http.Incomplete)
/// ```
export type Parsed(a) =
    /// The bytes end before the head's empty line.
    Incomplete
  /// The head, and the bytes after its empty line.
  | Parsed(head : a, rest : Bytes)

/// Why reading from a socket found no head or no body: `Protocol` for what
/// was read, `Socket` for the socket's error.
///
/// ### Examples
///
/// ```ernest
/// Http.Socket(Io.Timeout)
/// // => Http.Socket(Io.Timeout)
/// ```
export type ReadError =
    /// The head or the body read is refused.
    Protocol(Error)
  /// The socket answered an error: `Timeout` where the milliseconds passed,
  /// `Closed` where the connection closed first.
  | Socket(Io.Error)

/// The request whose head `bytes` begin with, and the bytes after the head,
/// or `Incomplete` where they end before the head's empty line.
///
/// The request line is three words parted at runs of spaces and tabs: the
/// method, the target and the version, `HTTP/`, a digit, `.` and a digit,
/// which is read as written, `HTTP/2.0` as `Version(major = 2, minor = 0)`.
/// A line without a version, as HTTP/0.9 wrote it, or whose third word is
/// no version, `HTTP/1.10` among them, is `Malformed`, and so is a status
/// line. One empty line before the request line is skipped, as RFC 9112,
/// section 2.2 has a server skip it, and a second is `Malformed`.
///
/// A first line past `limits.line` bytes is `LineTooLong`. A header line past
/// it, and header lines past `limits.headers` bytes together, are
/// `HeadersTooLarge`. Each is found at the bytes that pass the limit, before
/// the line's end has come.
///
/// ### Examples
///
/// Two requests a client sent at once, the second in the bytes after the
/// first's head:
///
/// ```ernest
/// {
///     let limits = Http.Limits(line = 8192, headers = 65536);
///     let bytes = String.toUtf8("GET /a HTTP/1.1\r\n\r\nGET /b HTTP/1.1\r\n\r\n");
///     match Http.parseRequest(bytes, limits) {
///         Right(Http.Parsed(head = first, =rest)) -> #(first.target, String.fromUtf8(rest))
///       | _ -> #("", None)
///     }
/// }
/// // => #("/a", Some("GET /b HTTP/1.1\r\n\r\n"))
/// ```
export foreign fn parseRequest(bytes : Bytes, limits : Limits) : Either(Error, Parsed(Request)) =
    "ern_http:parse_request/2"

/// The response whose head `bytes` begin with, and the bytes after the head,
/// or `Incomplete` where they end before the head's empty line, read as
/// `parseRequest` reads a request's.
///
/// The status is three digits, and a status line whose status is not is
/// `Malformed`, as a request line is; the line's phrase is dropped. A
/// header folded over two lines is read with each fold, a line break and
/// the white space around it, replaced by one space (RFC 9112, section
/// 5.2), where `parseRequest` refuses it.
///
/// ### Examples
///
/// ```ernest
/// {
///     let bytes = String.toUtf8("HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n");
///     match Http.parseResponse(bytes, Http.Limits(line = 8192, headers = 65536)) {
///         Right(Http.Parsed(head = response)) -> #(response.status, response.headers)
///       | _ -> #(0, [])
///     }
/// }
/// // => #(404, [Http.Header(name = "Content-Length", value = "0")])
/// ```
export foreign fn parseResponse(bytes : Bytes, limits : Limits) : Either(Error, Parsed(Response)) =
    "ern_http:parse_response/2"

/// The request whose head `socket` sends after the bytes `carried`, read
/// within `ms` milliseconds, and the bytes read after its head.
///
/// `carried` is what an earlier read took past its head, and is read first;
/// the socket is read only where it holds no whole head. The milliseconds
/// bound the whole head and not each read. `Socket(Timeout)` is the
/// milliseconds passed before the head ended, `Socket(Closed)` the
/// connection closed before it, and `Protocol(error)` the head refused, as
/// `parseRequest` refuses it, at the bytes that pass the limits, though no
/// line feed comes after them.
///
/// ### Examples
///
/// A server that reads one request and answers its target:
///
/// ```ernest
/// {
///     let listener <- Either.mapLeft(Tcp.listen("0.0.0.0", 8080), Http.Socket);
///     let socket <- Either.mapLeft(Tcp.accept(listener, 60000), Http.Socket);
///     let limits = Http.Limits(line = 8192, headers = 65536);
///     let #(request, _) <- Http.readRequest(socket, <<>>, limits, 10000);
///     let response = Http.Response(version = request.version, status = 200, headers = []);
///     let body = String.toUtf8(request.target);
///     let written = Tcp.write(socket, Http.renderResponse(response, body), 5000);
///     Tcp.close(socket);
///     Either.mapLeft(written, Http.Socket)
/// }
/// ```
export fn readRequest(socket : Address(Tcp.SocketMsg),
                      carried : Bytes,
                      limits : Limits,
                      ms : Int) : Either(ReadError, #(Request, Bytes)) = {
    let deadline = Clock.monotonic() + ms;
    readHead(HeadReading(=socket,
                         =deadline,
                         =limits,
                         parse = fn(bytes) = parseRequest(bytes, limits)),
             carried)
}

/// The response whose head `socket` sends after the bytes `carried`, read
/// within `ms` milliseconds, and the bytes read after its head, as
/// `readRequest` reads a request's.
///
/// A response of status 1xx is an interim one, which a server may send
/// before its final response: a client that reads one reads again, given
/// the bytes this read answers as `carried`, for the response after it.
///
/// ### Examples
///
/// A client that asks for a page and reads the response and its body, which
/// may run to the connection's close:
///
/// ```ernest
/// {
///     let socket <- Either.mapLeft(Tcp.connect("example.com", 80, 5000), Http.Socket);
///     let request =
///         Http.Request(method = "GET",
///                      target = "/",
///                      version = Http.Version(major = 1, minor = 1),
///                      headers = [Http.Header(name = "Host", value = "example.com")]);
///     let _ <-
///         Either.mapLeft(Tcp.write(socket, Http.renderRequest(request, <<>>), 5000), Http.Socket);
///     let limits = Http.Limits(line = 8192, headers = 65536);
///     let #(response, carried) <- Http.readResponse(socket, <<>>, limits, 10000);
///     let #(body, _) <- Http.readResponseBody(socket, carried, response, 1000000, 10000);
///     Tcp.close(socket);
///     Right(body)
/// }
/// ```
export fn readResponse(socket : Address(Tcp.SocketMsg),
                       carried : Bytes,
                       limits : Limits,
                       ms : Int) : Either(ReadError, #(Response, Bytes)) = {
    let deadline = Clock.monotonic() + ms;
    readHead(HeadReading(=socket,
                         =deadline,
                         =limits,
                         parse = fn(bytes) = parseResponse(bytes, limits)),
             carried)
}

// What reads a head: its socket, the deadline on the monotonic clock, the
// limits, and the parse of a request's head or a response's.
type HeadReading(a) =
    HeadReading(socket : Address(Tcp.SocketMsg),
                deadline : Int,
                limits : Limits,
                parse : (Bytes) -> Either(Error, Parsed(a)))

// Report Appendix G.11: the head the bytes begin with, read on from the
// socket while it is incomplete, each read given what is left until the
// deadline.
//
// The bytes are parsed from the head's start again only where a parse can
// answer otherwise than the last: where the new bytes hold a line feed,
// which may end a line or the head, or where they reach the size at which
// a limit passes inside the line under way (`passingSize`), where the
// primitive refuses them. So a head is refused at the bytes that pass its
// limits though no line feed comes, and a client that paces its bytes
// costs a parse a line, not a parse a read.
//
// Each parse reads the lines before it again, so a head of many lines that
// comes a line at a time costs the square of its lines, which MVP 4.15's
// item 8 ends with the head's loop read in Ernest.
fn readHead(reading : HeadReading(a), bytes : Bytes) : Either(ReadError, #(a, Bytes)) =
    match reading.parse(bytes) {
        Right(Parsed(=head, =rest)) -> Right(#(head, rest))
      | Right(Incomplete) -> readOn(reading, bytes, passingSize(bytes, reading.limits))
      | Left(error) -> Left(Protocol(error))
    }

// The bytes with what the socket answers after them, read on until the new
// bytes hold a line feed or the bytes reach `passing`, and the head they
// then begin with.
fn readOn(reading : HeadReading(a),
          bytes : Bytes,
          passing : Int) : Either(ReadError, #(a, Bytes)) = {
    let more <- received(reading.socket, bytes, reading.deadline);
    let read = Bytes.slice(more, Bytes.size(bytes), Bytes.size(more));
    if Bytes.contains(read, <<'\n':utf8>>) || Bytes.size(more) >= passing then
        readHead(reading, more)
    else
        readOn(reading, more, passing)
}

// The size the head's bytes may reach with no line feed more before a
// limit passes inside the line under way, as the primitive counts the
// limits: the first line within the line's limit, after the one empty line
// a request may begin with; then a header line within it from its first
// byte, and the header lines together within the headers' limit from the
// first line's end.
fn passingSize(bytes : Bytes, limits : Limits) : Int = {
    let skipped = if Bytes.startsWith(bytes, <<'\r':utf8, '\n':utf8>>) then
        2
    else if Bytes.startsWith(bytes, <<'\n':utf8>>) then
        1
    else
        0;
    match Bytes.indexOf(Bytes.slice(bytes, skipped, Bytes.size(bytes)), <<'\n':utf8>>) {
        None ->
            skipped + limits.line
      | Some(index) -> {
            let firstEnd = skipped + index + 1;
            Int.min(lineStart(bytes, firstEnd) + limits.line, firstEnd + limits.headers)
        }
    }
}

// Where the header line under way begins: after the last line feed past
// the first line that a byte other than a space or a tab follows, a header
// folded over lines being one line (RFC 9112, section 5.2), or at the
// first line's end. A line feed the bytes end with may begin a fold, so
// the line it ends is taken as under way, which costs at most a parse
// more.
fn lineStart(bytes : Bytes, firstEnd : Int) : Int =
    match Bytes.lastIndexOf(Bytes.slice(bytes, firstEnd, Bytes.size(bytes)), <<'\n':utf8>>) {
        None ->
            firstEnd
      | Some(index) -> {
            let next = firstEnd + index + 1;
            if next < Bytes.size(bytes) && !isFolded(bytes, next) then
                next
            else
                lineStart(Bytes.slice(bytes, 0, next - 1), firstEnd)
        }
    }

// Whether the byte at the index is a space or a tab, which continues the
// line before it.
fn isFolded(bytes : Bytes, index : Int) : Bool = {
    let byte = Bytes.slice(bytes, index, index + 1);
    byte == <<' ':utf8>> || byte == <<'\t':utf8>>
}

// The bytes with what the socket answers next after them, waiting until the
// deadline at most. A deadline passed is a timeout, as a wait given no time
// is (report Appendix E.0, shape rule 8), though the socket holds bytes
// that have arrived, which a read given no time answers: so a client that
// keeps sending meets the deadline too.
fn received(socket : Address(Tcp.SocketMsg),
            bytes : Bytes,
            deadline : Int) : Either(ReadError, Bytes) = {
    let ms = deadline - Clock.monotonic();
    if ms <= 0 then
        Left(Socket(Io.Timeout))
    else match Tcp.read(socket, ms) {
        Right(read) -> Right(bytes <> read)
      | Left(error) -> Left(Socket(error))
    }
}

/// The body of `request`, which `socket` sends after the bytes `carried`,
/// read within `ms` milliseconds, and the bytes read after it; at most
/// `limit` bytes.
///
/// Where `Transfer-Encoding` names `chunked` last, the chunks are decoded,
/// each chunk's extensions and the trailers after the last chunk dropped;
/// where it names another coding last, names `chunked` twice or stands
/// beside a `Content-Length`, the body is `Protocol(Malformed)` (RFC 9112,
/// sections 6.1 and 6.3). Otherwise `Content-Length` gives the body's size:
/// one that is no decimal number, or two that name different numbers, are
/// `Protocol(Malformed)`. Where the headers carry neither, the request has
/// no body: the answer is an empty body and `carried` as it was, and the
/// socket is not read.
///
/// A client whose request carries `Expect: 100-continue` may hold its body
/// back until the server answers with status 100 (RFC 9110, section
/// 10.1.1): a server that reads such a body writes a response of status 100
/// first, or the read waits on the client.
///
/// `carried` is what the head's reader took past the head, and is read
/// first. The milliseconds bound the whole body and not each read.
/// `Socket(Timeout)` is the milliseconds passed before the body ended, and
/// `Socket(Closed)` the connection closed before it.
///
/// `limit` counts the body's bytes as they come, the chunks' sizes, their
/// extensions and the trailers among them. A body past it is
/// `Protocol(BodyTooLarge)`, found at the bytes that pass it, or at once
/// where `Content-Length` or a chunk's size passes it.
///
/// ### Examples
///
/// A server that reads one request and its body, and answers the body's
/// size:
///
/// ```ernest
/// {
///     let listener <- Either.mapLeft(Tcp.listen("0.0.0.0", 8080), Http.Socket);
///     let socket <- Either.mapLeft(Tcp.accept(listener, 60000), Http.Socket);
///     let limits = Http.Limits(line = 8192, headers = 65536);
///     let #(request, carried) <- Http.readRequest(socket, <<>>, limits, 10000);
///     let #(body, _) <- Http.readRequestBody(socket, carried, request, 1000000, 10000);
///     let response = Http.Response(version = request.version, status = 200, headers = []);
///     let size = String.toUtf8(Int.toString(Bytes.size(body)));
///     let written = Tcp.write(socket, Http.renderResponse(response, size), 5000);
///     Tcp.close(socket);
///     Either.mapLeft(written, Http.Socket)
/// }
/// ```
export fn readRequestBody(socket : Address(Tcp.SocketMsg),
                          carried : Bytes,
                          request : Request,
                          limit : Int,
                          ms : Int) : Either(ReadError, #(Bytes, Bytes)) =
    readBody(socket, carried, request.headers, limit, ms, Client)

/// The body of `response`, which `socket` sends after the bytes `carried`,
/// read within `ms` milliseconds, and the bytes read after it; at most
/// `limit` bytes, read as `readRequestBody` reads a request's.
///
/// A response of status 1xx, 204 or 304 has no body, whatever its headers:
/// the answer is an empty body and `carried` as it was, and the socket is
/// not read. Nor has a response to a `HEAD` request, which the reader
/// cannot know: a client that sent `HEAD` reads no body.
///
/// Where the headers carry neither `Transfer-Encoding` nor `Content-Length`,
/// or `Transfer-Encoding` names a coding other than `chunked` last, the body
/// runs to the connection's close, and no bytes come after it (RFC 9112,
/// section 6.3).
export fn readResponseBody(socket : Address(Tcp.SocketMsg),
                           carried : Bytes,
                           response : Response,
                           limit : Int,
                           ms : Int) : Either(ReadError, #(Bytes, Bytes)) =
    if isBodiless(response.status) then
        Right(#(<<>>, carried))
    else
        readBody(socket, carried, response.headers, limit, ms, Server)

// Report Appendix G.11: the body the headers frame as its sender's, and the
// bytes after it.
fn readBody(socket : Address(Tcp.SocketMsg),
            carried : Bytes,
            headers : List(Header),
            limit : Int,
            ms : Int,
            sender : Sender) : Either(ReadError, #(Bytes, Bytes)) = {
    let reading = Reading(=socket, =limit, deadline = Clock.monotonic() + ms);
    match framing(headers, sender) {
        Right(Chunked) ->
            chunks(reading, carried, 0, <<>>)
      | Right(Length(size)) ->
            if size > limit then Left(Protocol(BodyTooLarge)) else taken(reading, carried, size)
      | Right(ToClose) ->
            toClose(reading, carried)
      | Left(error) ->
            Left(Protocol(error))
    }
}

// What reads a body: its socket, the most bytes the body may come to, and
// the deadline on the monotonic clock.
type Reading = Reading(socket : Address(Tcp.SocketMsg), limit : Int, deadline : Int)

// What frames a body (RFC 9112, section 6.3).
type Framing = Chunked | Length(Int) | ToClose

// Who sent the body a reader reads: a client, a request's, or a server, a
// response's, whose framing differs where the headers frame none, and
// where the last transfer coding is not chunked (RFC 9112, section 6.3).
type Sender = Client | Server

// Report Appendix G.11, RFC 9112, sections 6.1 and 6.3: a transfer coding
// frames the body, its last coding deciding how, and the field's values are
// one list however many lines carry them; a `Content-Length` beside it, or
// `chunked` named twice, frames none that can be read. Every
// `Content-Length` names one decimal number, the same. Where neither field
// frames the body, a request has none, and a response's runs to the close.
fn framing(fields : List(Header), sender : Sender) : Either(Error, Framing) =
    match #(headers(fields, "Transfer-Encoding"), headers(fields, "Content-Length")) {
        #([], lengths) ->
            match #(List.unique(List.map(lengths, decimal)), sender) {
                #([], Client) -> Right(Length(0))
              | #([], Server) -> Right(ToClose)
              | #([Some(size)], _) -> Right(Length(size))
              | _ -> Left(Malformed)
            }
      | #(values, []) -> {
            let codings =
                List.filter(List.map(List.flatMap(values, fn(value) = String.split(value, ",")),
                                     fn(coding) = String.toLower(String.trim(coding))),
                            fn(coding) = coding != "");
            coded(codings, sender)
        }
      | _ ->
            Left(Malformed)
    }

// RFC 9112, sections 6.1 and 6.3: the framing of the transfer codings, in
// lower case. `chunked` last is the chunked coding, named once; another
// coding last leaves a request's body unframed, which is refused, and a
// response's running to the close.
fn coded(codings : List(String), sender : Sender) : Either(Error, Framing) =
    if List.size(List.filter(codings, fn(coding) = coding == "chunked")) > 1 then
        Left(Malformed)
    else match #(List.last(codings) == Some("chunked"), sender) {
        #(true, _) -> Right(Chunked)
      | #(false, Client) -> Left(Malformed)
      | #(false, Server) -> Right(ToClose)
    }

// The number the digits 0 to 9 write, of which there is at least one.
fn decimal(text : String) : Optional(Int) =
    if text != "" && List.all(String.toList(text), Char.isAsciiDigit) then
        String.toInt(text)
    else
        None

// RFC 9112, section 7.1: the chunks from the bytes on, each its size in
// hexadecimal, its extensions after a `;` dropped, its data and an empty
// line, to the last chunk, of size 0, and the trailers after it, and the
// bytes after them. `consumed` counts the bytes of the body read so far, and
// `body` holds the chunks' data.
fn chunks(reading : Reading,
          bytes : Bytes,
          consumed : Int,
          body : Bytes) : Either(ReadError, #(Bytes, Bytes)) = {
    let #(sizeLine, afterSize, consumed) <- line(reading, bytes, consumed);
    let size <- Either.fromOptional(chunkSize(sizeLine), Protocol(Malformed));
    if size == 0 then
        Either.map(trailers(reading, afterSize, consumed), fn(rest) = #(body, rest))
    else if consumed + size > reading.limit then
        Left(Protocol(BodyTooLarge))
    else {
        let #(data, afterData) <- taken(reading, afterSize, size);
        let #(end, rest, consumed) <- line(reading, afterData, consumed + size);
        if Bytes.isEmpty(end) then
            chunks(reading, rest, consumed, body <> data)
        else
            Left(Protocol(Malformed))
    }
}

// A chunk's size, the hexadecimal digits before any `;` and the white space
// before it.
fn chunkSize(sizeLine : Bytes) : Optional(Int) = {
    let digits = match Bytes.indexOf(sizeLine, <<';':utf8>>) {
        Some(index) -> Bytes.slice(sizeLine, 0, index)
      | None -> sizeLine
    };
    let text <- Optional.map(String.fromUtf8(digits), String.trimEnd);
    if text != ""
        && List.all(String.toList(text), fn(char) = Optional.isSome(Char.digitValue(char, 16))) then
        String.toIntBase(text, 16)
    else
        None
}

// RFC 9112, section 7.1.2: the trailer lines after the last chunk, dropped,
// to the empty line that ends the body, and the bytes after it.
fn trailers(reading : Reading, bytes : Bytes, consumed : Int) : Either(ReadError, Bytes) = {
    let #(trailer, rest, consumed) <- line(reading, bytes, consumed);
    if Bytes.isEmpty(trailer) then Right(rest) else trailers(reading, rest, consumed)
}

// The line the bytes begin with, without its line feed and a carriage
// return before it, the bytes after it, and the body's bytes consumed with
// it, read on from the socket until its line feed comes, within the limit.
fn line(reading : Reading,
        bytes : Bytes,
        consumed : Int) : Either(ReadError, #(Bytes, Bytes, Int)) =
    match Bytes.indexOf(bytes, <<'\n':utf8>>) {
        Some(index) ->
            if consumed + index + 1 > reading.limit then
                Left(Protocol(BodyTooLarge))
            else {
                let rest = Bytes.slice(bytes, index + 1, Bytes.size(bytes));
                Right(#(withoutReturn(Bytes.slice(bytes, 0, index)), rest, consumed + index + 1))
            }
      | None ->
            if consumed + Bytes.size(bytes) > reading.limit then
                Left(Protocol(BodyTooLarge))
            else {
                let more <- received(reading.socket, bytes, reading.deadline);
                line(reading, more, consumed)
            }
    }

// The line without the carriage return before its line feed.
fn withoutReturn(content : Bytes) : Bytes =
    if Bytes.endsWith(content, <<'\r':utf8>>) then
        Bytes.slice(content, 0, Bytes.size(content) - 1)
    else
        content

// The first `count` bytes and the bytes after them, read on from the socket
// until there are as many.
fn taken(reading : Reading, bytes : Bytes, count : Int) : Either(ReadError, #(Bytes, Bytes)) =
    if Bytes.size(bytes) >= count then
        Right(#(Bytes.slice(bytes, 0, count), Bytes.slice(bytes, count, Bytes.size(bytes))))
    else {
        let more <- received(reading.socket, bytes, reading.deadline);
        taken(reading, more, count)
    }

// RFC 9112, section 6.3: a response's body the connection's close ends,
// within the limit, with no bytes after it.
fn toClose(reading : Reading, bytes : Bytes) : Either(ReadError, #(Bytes, Bytes)) =
    if Bytes.size(bytes) > reading.limit then
        Left(Protocol(BodyTooLarge))
    else match received(reading.socket, bytes, reading.deadline) {
        Right(more) -> toClose(reading, more)
      | Left(Socket(Io.Closed)) -> Right(#(bytes, <<>>))
      | Left(error) -> Left(error)
    }

/// The first value under `name` in `headers`, the names compared in any
/// case; `None` where no header has the name.
///
/// ### Examples
///
/// ```ernest
/// Http.header([Http.Header(name = "Content-Type", value = "text/html")], "content-type")
/// // => Some("text/html")
/// ```
export fn header(headers : List(Header), name : String) : Optional(String) = {
    let wanted = String.toLower(name);
    Optional.map(List.find(headers, fn(header) = isNamed(header, wanted)),
                 fn(header) = header.value)
}

/// Every value under `name` in `headers`, in their order, the names compared
/// in any case.
///
/// ### Examples
///
/// ```ernest
/// Http.headers([Http.Header(name = "Set-Cookie", value = "a=1"),
///               Http.Header(name = "Host", value = "example.com"),
///               Http.Header(name = "set-cookie", value = "b=2")],
///              "Set-Cookie")
/// // => ["a=1", "b=2"]
/// ```
export fn headers(headers : List(Header), name : String) : List(String) = {
    let wanted = String.toLower(name);
    List.filterMap(headers,
                   fn(header) = if isNamed(header, wanted) then Some(header.value) else None)
}

// Whether the header's name, in lower case, is the name.
fn isNamed(header : Header, lowered : String) : Bool =
    String.toLower(header.name) == lowered

/// The response's head and `body` after it, as bytes to write: the status
/// line, each header as `name: value`, an empty line and the body, each line
/// ending in a carriage return and a line feed.
///
/// The status line is the response's version, its status and `reason`'s
/// phrase for it. Where the headers carry neither `Content-Length` nor
/// `Transfer-Encoding`, and the status is no 1xx, 204 or 304, a
/// `Content-Length` of the body's size is written after them (RFC 9110,
/// section 8.6). A header's value is written as given.
///
/// A head that would not read back as written is a program's own error,
/// and faults the caller, its cause naming the header or the status: a
/// header's name that is no token, one or more of the ASCII letters and
/// digits and of ``!#$%&'*+-.^_`|~`` (RFC 9110, section 5.6.2), a header's
/// value holding a carriage return, a line feed or U+0000, and a body that
/// is not empty given with a status of 1xx, 204 or 304.
///
/// ### Examples
///
/// A response of no content, which carries no `Content-Length`:
///
/// ```ernest
/// {
///     let response =
///         Http.Response(version = Http.Version(major = 1, minor = 1), status = 204, headers = []);
///     String.fromUtf8(Http.renderResponse(response, <<>>))
/// }
/// // => Some("HTTP/1.1 204 No Content\r\n\r\n")
/// ```
export fn renderResponse(response : Response, body : Bytes) : Bytes = {
    let Response(=version, =status, =headers) = response;
    if isBodiless(status) && !Bytes.isEmpty(body) then
        fault("a response of status "
                  <> Int.toString(status)
                  <> " has no body, and one of "
                  <> Int.toString(Bytes.size(body))
                  <> " bytes was given")
    else
        Unit;
    let statusLine = versionText(version) <> " " <> Int.toString(status) <> " " <> reason(status);
    written(statusLine, if isBodiless(status) then headers else withLength(headers, body), body)
}

// RFC 9110, section 15: whether a response of the status has no body, a 1xx,
// a 204 or a 304.
fn isBodiless(status : Int) : Bool =
    (status >= 100 && status < 200) || status == 204 || status == 304

/// The request's head and `body` after it, as bytes to write, as
/// `renderResponse` writes a response's: the request line, its method, its
/// target and its version, then the headers, an empty line and the body.
///
/// Where the body is not empty and the headers carry neither
/// `Content-Length` nor `Transfer-Encoding`, a `Content-Length` of the
/// body's size is written after them; a body is written whatever the
/// method.
///
/// A header faults the caller as `renderResponse` says, and so do a
/// method and a target `parseRequest` would refuse, its cause naming the
/// word: a method that is no token, an empty one among them, and a target
/// that is empty or holds a character outside U+0021 to U+007E, the
/// visible ASCII characters RFC 3986 writes a target in, `/café` among
/// them, whose `é` a client writes `%C3%A9`.
///
/// ### Examples
///
/// ```ernest
/// {
///     let request =
///         Http.Request(method = "POST",
///                      target = "/items",
///                      version = Http.Version(major = 1, minor = 1),
///                      headers = [Http.Header(name = "Host", value = "example.com")]);
///     String.fromUtf8(Http.renderRequest(request, String.toUtf8("{}")))
/// }
/// // => Some("POST /items HTTP/1.1\r\nHost: example.com\r\nContent-Length: 2\r\n\r\n{}")
/// ```
export fn renderRequest(request : Request, body : Bytes) : Bytes = {
    let Request(=method, =target, =version, =headers) = request;
    checkMethod(method);
    checkTarget(target);
    let requestLine = method <> " " <> target <> " " <> versionText(version);
    written(requestLine, if Bytes.isEmpty(body) then headers else withLength(headers, body), body)
}

// `HTTP/1.1`.
fn versionText(version : Version) : String =
    "HTTP/" <> Int.toString(version.major) <> "." <> Int.toString(version.minor)

// The headers, and a `Content-Length` of the body's size after them where
// they carry neither it nor `Transfer-Encoding` (RFC 9112, section 6.2).
fn withLength(headers : List(Header), body : Bytes) : List(Header) =
    match #(header(headers, "Content-Length"), header(headers, "Transfer-Encoding")) {
        #(None, None) ->
            headers <> [Header(name = "Content-Length", value = Int.toString(Bytes.size(body)))]
      | _ ->
            headers
    }

// RFC 9112, section 2.1: the first line and the headers, each ending in a
// carriage return and a line feed, an empty line, and the body.
fn written(first : String, headers : List(Header), body : Bytes) : Bytes = {
    List.forEach(headers, checkHeader);
    let lines = List.map(headers, fn(header) = header.name <> ": " <> header.value);
    String.toUtf8(String.join(first :: lines <> ["", ""], "\r\n")) <> body
}

// Report Appendix G.11: faults the writer, as a program's own error, where
// the method would not read back, as `parseRequest` reads it: one that is
// no token, an empty one among them.
fn checkMethod(method : String) : Unit =
    if isToken(method) then Unit else fault("the method " <> Io.show(method) <> " is no token")

// Report Appendix G.11: faults the writer, as a program's own error, where
// the target would not read back, as `parseRequest` reads it: one that is
// empty, or holds a character outside U+0021 to U+007E, the visible ASCII
// characters RFC 3986 writes a target in.
fn checkTarget(target : String) : Unit =
    if target == "" then
        fault("the target is empty")
    else if List.any(String.toList(target),
                     fn(char) = Char.toCodePoint(char) < 33 || Char.toCodePoint(char) > 126) then
        fault("the target " <> Io.show(target) <> " holds a character outside U+0021 to U+007E")
    else
        Unit

// Report Appendix G.11: faults the writer, as a program's own error, where
// the header would break the head: a name that is no token (RFC 9110,
// section 5.6.2), or a value holding a carriage return, a line feed or
// U+0000.
fn checkHeader(header : Header) : Unit =
    if !isToken(header.name) then
        fault("the header name " <> Io.show(header.name) <> " is no token")
    else if List.any(String.toList(header.value),
                     fn(char) = char == '\r' || char == '\n' || char == '\u{0}') then
        fault("the value of the header "
                  <> header.name
                  <> ", "
                  <> Io.show(header.value)
                  <> ", holds a carriage return, a line feed or U+0000")
    else
        Unit

// RFC 9110, section 5.6.2: whether the text is a token, one or more of
// the ASCII letters and digits and of ``!#$%&'*+-.^_`|~``.
fn isToken(text : String) : Bool =
    text != ""
        && List.all(String.toList(text),
                    fn(char) =
                        Char.isAsciiDigit(char)
                            || (char >= 'a' && char <= 'z')
                            || (char >= 'A' && char <= 'Z')
                            || String.contains("!#$%&'*+-.^_`|~", Char.toString(char)))

/// RFC 9110's phrase for `status`, `Not Found` for 404, from its section 15;
/// `""` for a status it does not name.
///
/// 306 and 418, which the RFC keeps as unused, have none.
///
/// ### Examples
///
/// ```ernest
/// #(Http.reason(404), Http.reason(299))
/// // => #("Not Found", "")
/// ```
export fn reason(status : Int) : String =
    match status {
        100 -> "Continue"
      | 101 -> "Switching Protocols"
      | 200 -> "OK"
      | 201 -> "Created"
      | 202 -> "Accepted"
      | 203 -> "Non-Authoritative Information"
      | 204 -> "No Content"
      | 205 -> "Reset Content"
      | 206 -> "Partial Content"
      | 300 -> "Multiple Choices"
      | 301 -> "Moved Permanently"
      | 302 -> "Found"
      | 303 -> "See Other"
      | 304 -> "Not Modified"
      | 305 -> "Use Proxy"
      | 307 -> "Temporary Redirect"
      | 308 -> "Permanent Redirect"
      | 400 -> "Bad Request"
      | 401 -> "Unauthorized"
      | 402 -> "Payment Required"
      | 403 -> "Forbidden"
      | 404 -> "Not Found"
      | 405 -> "Method Not Allowed"
      | 406 -> "Not Acceptable"
      | 407 -> "Proxy Authentication Required"
      | 408 -> "Request Timeout"
      | 409 -> "Conflict"
      | 410 -> "Gone"
      | 411 -> "Length Required"
      | 412 -> "Precondition Failed"
      | 413 -> "Content Too Large"
      | 414 -> "URI Too Long"
      | 415 -> "Unsupported Media Type"
      | 416 -> "Range Not Satisfiable"
      | 417 -> "Expectation Failed"
      | 421 -> "Misdirected Request"
      | 422 -> "Unprocessable Content"
      | 426 -> "Upgrade Required"
      | 500 -> "Internal Server Error"
      | 501 -> "Not Implemented"
      | 502 -> "Bad Gateway"
      | 503 -> "Service Unavailable"
      | 504 -> "Gateway Timeout"
      | 505 -> "HTTP Version Not Supported"
      | _ -> ""
    }

/// `time`, in milliseconds since the epoch, as RFC 9110's IMF-fixdate writes
/// it, in UTC: `Sun, 06 Nov 1994 08:49:37 GMT`.
///
/// The milliseconds within the second are dropped. A year is four digits,
/// and one outside 0 to 9999, which the form cannot write, is written with
/// as many as it has, a year before 0 with its sign before them.
///
/// ### Examples
///
/// ```ernest
/// Http.date(784111777000)
/// // => "Sun, 06 Nov 1994 08:49:37 GMT"
/// ```
export fn date(time : Int) : String = {
    let civil = Time.toCivil(time);
    String.join([String.slice(dayName(civil), 0, 3) <> ",",
                 twoDigits(civil.day),
                 monthName(civil.month),
                 yearText(civil.year),
                 timeOfDay(civil),
                 "GMT"],
                " ")
}

/// The time, in milliseconds since the epoch, that `text` writes as an
/// HTTP date; `None` for a text of no such form.
///
/// The three forms RFC 9110 has a recipient read are read: IMF-fixdate,
/// `Sun, 06 Nov 1994 08:49:37 GMT`, RFC 850's, `Sunday, 06-Nov-94 08:49:37
/// GMT`, and asctime's, `Sun Nov  6 08:49:37 1994`. A text is read in its
/// form's case and spacing alone, and its day of the week must be its
/// date's. A date or a time of day the calendar has not, a 60th second
/// among them, is `None`.
///
/// RFC 850's year of two digits is the latest year with those digits in
/// which the text's date and time of day are not more than 50 years after
/// `Clock.now` (RFC 9110, section 5.6.7).
///
/// ### Examples
///
/// The three forms of one time, and a day of the week that is not its date's:
///
/// ```ernest
/// #(Http.parseDate("Sun, 06 Nov 1994 08:49:37 GMT"),
///   Http.parseDate("Sunday, 06-Nov-94 08:49:37 GMT"),
///   Http.parseDate("Sun Nov  6 08:49:37 1994"),
///   Http.parseDate("Mon, 06 Nov 1994 08:49:37 GMT"))
/// // => #(Some(784111777000), Some(784111777000), Some(784111777000), None)
/// ```
export fn parseDate(text : String) : Optional(Int) =
    match String.split(text, " ") {
        [_, day, month, year, clock, "GMT"] ->
            readDate(text, civilOf(fourDigits(year), month, day, clock), date)
      | [_, dayMonthYear, clock, "GMT"] ->
            match String.split(dayMonthYear, "-") {
                [day, month, year] -> {
                    let now = Time.toCivil(Clock.now());
                    let civil =
                        Optional.map(civilOf(String.toInt(year), month, day, clock),
                                     fn(civil) = withCentury(civil, now));
                    readDate(text, civil, rfc850)
                }
              | _ ->
                    None
            }
      | [_, month, "", day, clock, year] or [_, month, day, clock, year] ->
            readDate(text, civilOf(fourDigits(year), month, day, clock), asctime)
      | _ ->
            None
    }

// Report Appendix G.11: the time of the date and the time of day, where
// `write` writes it as `text` is written, which holds the text to its form
// whole, its digits, its spacing and its day of the week.
fn readDate(text : String,
            civil : Optional(Time.Civil),
            write : (Int) -> String) : Optional(Int) = {
    let civil <- civil;
    let time <- Time.fromCivil(civil);
    if write(time) == text then Some(time) else None
}

// The date and the time of day the parts of a date name, in the year.
fn civilOf(year : Optional(Int),
           monthPart : String,
           dayPart : String,
           clockPart : String) : Optional(Time.Civil) = {
    let year <- year;
    let month <-
        Optional.map(List.find(List.indexed(months), fn(#(_, name)) = name == monthPart),
                     fn(#(index, _)) = index + 1);
    let day <- String.toInt(dayPart);
    let #(hour, minute, second) <- match List.map(String.split(clockPart, ":"), String.toInt) {
        [Some(hour), Some(minute), Some(second)] -> Some(#(hour, minute, second))
      | _ -> None
    };
    Some(Time.Civil(=year, =month, =day, =hour, =minute, =second))
}

// A year of four digits, as IMF-fixdate and asctime write it.
fn fourDigits(year : String) : Optional(Int) =
    if String.size(year) == 4 then String.toInt(year) else None

// RFC 9110, section 5.6.7: the date and the time of day whose year is RFC
// 850's two digits, in the latest year with those digits in which they are
// not more than 50 years after `now`.
fn withCentury(civil : Time.Civil, now : Time.Civil) : Time.Civil = {
    let latest = Time.Civil(..now, year = now.year + 50);
    let candidate = Time.Civil(..civil, year = latest.year - latest.year % 100 + civil.year);
    if moment(candidate) > moment(latest) then
        Time.Civil(..candidate, year = candidate.year - 100)
    else
        candidate
}

// A date and a time of day as a tuple, which compares as the moments do.
fn moment(civil : Time.Civil) : #(Int, Int, Int, Int, Int, Int) =
    #(civil.year, civil.month, civil.day, civil.hour, civil.minute, civil.second)

// RFC 850's form, `Sunday, 06-Nov-94 08:49:37 GMT`, its year of two digits.
fn rfc850(time : Int) : String = {
    let civil = Time.toCivil(time);
    let dayMonthYear = [twoDigits(civil.day), monthName(civil.month), twoDigits(civil.year % 100)];
    String.join([dayName(civil) <> ",", String.join(dayMonthYear, "-"), timeOfDay(civil), "GMT"],
                " ")
}

// asctime's form, `Sun Nov  6 08:49:37 1994`, its day padded with a space.
fn asctime(time : Int) : String = {
    let civil = Time.toCivil(time);
    String.join([String.slice(dayName(civil), 0, 3),
                 monthName(civil.month),
                 String.padStart(Int.toString(civil.day), 2, " "),
                 timeOfDay(civil),
                 yearText(civil.year)],
                " ")
}

// The time of day, `08:49:37`.
fn timeOfDay(civil : Time.Civil) : String =
    String.join([twoDigits(civil.hour), twoDigits(civil.minute), twoDigits(civil.second)], ":")

fn twoDigits(number : Int) : String =
    String.padStart(Int.toString(number), 2, "0")

// A year in four digits, or as many as it has, a year before 0 with its
// sign before them, as `Clock.toString` writes one (report Appendix E.15).
fn yearText(year : Int) : String =
    if year < 0 then
        "-" <> String.padStart(Int.toString(-year), 4, "0")
    else
        String.padStart(Int.toString(year), 4, "0")

// The day of the week of the date, in full. Every caller's date is one
// `Time.toCivil` answers, which the calendar has, so `None` does not come.
fn dayName(civil : Time.Civil) : String =
    match Time.weekday(civil) {
        Some(Time.Monday) -> "Monday"
      | Some(Time.Tuesday) -> "Tuesday"
      | Some(Time.Wednesday) -> "Wednesday"
      | Some(Time.Thursday) -> "Thursday"
      | Some(Time.Friday) -> "Friday"
      | Some(Time.Saturday) -> "Saturday"
      | Some(Time.Sunday) -> "Sunday"
      | None -> ""
    }

fn monthName(month : Int) : String =
    Optional.withDefault(List.get(months, month - 1), "")

// The names of the months, January first (RFC 9110, section 5.6.7).
let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

//
// The tests (report §9.3), run by `ern test` as every library's are.
// Regression tests, written with the code.
//

// The limits the tests read heads within, and the version they write.
let testLimits = Limits(line = 8192, headers = 65536)

let testVersion = Version(major = 1, minor = 1)

// The head a parse found, or none.
fn headOf(parsed : Either(Error, Parsed(a))) : Optional(a) =
    match parsed {
        Right(Parsed(=head)) -> Some(head)
      | _ -> None
    }

// The request whose head the text holds, within the tests' limits, or none.
fn requestOf(text : String) : Optional(Request) =
    headOf(parseRequest(String.toUtf8(text), testLimits))

// The request of RFC 9110's example exchange (section 3.9), and its head
// read.
let helloText =
    String.join(["GET /hello.txt HTTP/1.1",
                 "User-Agent: curl/7.64.1",
                 "Host: www.example.com",
                 "Accept-Language: en, mi",
                 "",
                 ""],
                "\r\n")

let hello =
    Request(method = "GET",
            target = "/hello.txt",
            version = testVersion,
            headers = [Header(name = "User-Agent", value = "curl/7.64.1"),
                       Header(name = "Host", value = "www.example.com"),
                       Header(name = "Accept-Language", value = "en, mi")])

// report Appendix G.11
let rfcRequest =
    Test.Case(name = "RFC 9110's example request is read, its headers in their order",
              run = fn() =
                  Test.equal(parseRequest(String.toUtf8(helloText), testLimits),
                             Right(Parsed(head = hello, rest = <<>>))))

// report Appendix G.11
let rfcResponse =
    Test.Case(name = "RFC 9110's example response is read, its phrase dropped", run = fn() = {
        let text =
            String.join(["HTTP/1.1 200 OK",
                         "Date: Mon, 27 Jul 2009 12:28:53 GMT",
                         "Server: Apache",
                         "Content-Length: 51",
                         "",
                         "Hello"],
                        "\r\n");
        let headers =
            [Header(name = "Date", value = "Mon, 27 Jul 2009 12:28:53 GMT"),
             Header(name = "Server", value = "Apache"),
             Header(name = "Content-Length", value = "51")];
        Test.equal(parseResponse(String.toUtf8(text), testLimits),
                   Right(Parsed(head = Response(version = testVersion, status = 200, =headers),
                                rest = String.toUtf8("Hello"))))
    })

// report Appendix G.11
let targetForms =
    Test.Case(name = "RFC 9112's four forms of a target are kept as written", run = fn() = {
        let lines =
            ["GET /where?q=now HTTP/1.1",
             "GET http://www.example.org/pub/WWW/TheProject.html HTTP/1.1",
             "CONNECT www.example.com:80 HTTP/1.1",
             "OPTIONS * HTTP/1.1",
             "get /a%20b HTTP/1.1"];
        let read =
            fn(line) =
                Optional.map(requestOf(line <> "\r\n\r\n"),
                             fn(request) = #(request.method, request.target));
        Test.equal(List.map(lines, read),
                   [Some(#("GET", "/where?q=now")),
                    Some(#("GET", "http://www.example.org/pub/WWW/TheProject.html")),
                    Some(#("CONNECT", "www.example.com:80")),
                    Some(#("OPTIONS", "*")),
                    Some(#("get", "/a%20b"))])
    })

// report Appendix G.11
let lineFeeds =
    Test.Case(name = "a line may end in a line feed alone",
              run = fn() =
                  Test.equal(parseRequest(String.toUtf8(String.replace(helloText, "\r\n", "\n")),
                                          testLimits),
                             Right(Parsed(head = hello, rest = <<>>))))

// report Appendix G.11
let versions =
    Test.Case(name = "a version is read as written",
              run = fn() =
                  Test.equal(List.map(["GET / HTTP/2.0\r\n\r\n",
                                       "GET / HTTP/1.0\r\n\r\n",
                                       "GET / HTTP/0.9\r\n\r\n"],
                                      fn(text) =
                                          Optional.map(requestOf(text),
                                                       fn(request) = request.version)),
                             [Some(Version(major = 2, minor = 0)),
                              Some(Version(major = 1, minor = 0)),
                              Some(Version(major = 0, minor = 9))]))

// report Appendix G.11
let pipelined =
    Test.Case(name = "two requests sent at once: the second is the bytes after the first's head",
              run = fn() = {
                  let bytes = String.toUtf8("GET /a HTTP/1.1\r\n\r\n" <> helloText);
                  match parseRequest(bytes, testLimits) {
                      Right(Parsed(head = first, =rest)) ->
                          Test.equal(#(first.target, parseRequest(rest, testLimits)),
                                     #("/a", Right(Parsed(head = hello, rest = <<>>))))
                    | other ->
                          Test.Failed(Io.show(other))
                  }
              })

// report Appendix G.11
let everyPrefix =
