/// The shell's line editor (report §11.2), designed in
/// docs/design/shell.md: a pure function from what is being edited and an
/// event to what the reader must do next. GNU Readline's Emacs bindings;
/// `Escape` and the key after it are `Meta` and that key (§12.1). The
/// table of the keys it binds, `boundKeys`, is what `:keys` lists.
///
/// Pure, and tested on its own: the tests at the foot of this file are
/// what `ern test` runs (Appendix E.24, §11.2). The reader holds an `Editing`
/// and reads it through the functions here, since its constructor is this
/// module's.

/// What is being edited: the input and the cursor, what was last killed,
/// what the key before this one did, what the keys before this one have
/// begun, the inputs before this one with how far back through them the
/// person has walked, the text each place the walk left was left with,
/// and the search when one is running. Abstract (report §4.4): the editor
/// alone keeps the cursor inside the input and a search's place inside
/// the history.
export abstract type Editing =
    Editing(text : String,
            cursor : Int,
            killed : String,
            previous : Previous,
            pending : Pending,
            history : List(String),
            back : Int,
            kept : Map(Int, String),
            search : Optional(Search))

// Report §11.2: what the key before this one did, which a kill reads to
// join the kill before it and a move between lines reads for the column
// it keeps, a `LineKey`'s column. A resize is no key, and the `Escape`
// that begins a Meta key or a sequence is part of that key, so neither
// changes it.
type Previous = OtherKey | KillKey | LineKey(Int)

// Report §12.1: a sequence the terminal sends that `Terminal.Event` does
// not name (Appendix E.16) arrives as `Escape` and the characters after
// it, so the editor reads one: `Escape` begins a Meta key, and `Escape [`
// and `Escape O` begin a sequence, whose characters after the `Escape`
// it holds until one ends it.
type Pending = Plain | Meta | Sequence(String)

// An incremental search: what has been typed to search for, where in the
// history the match is, where the walk stood when the search began and
// where the cursor stood then, and its direction.
type Search = Search(query : String, back : Int, origin : Int, cursor : Int, forward : Bool)

/// What the reader does after a key: go on with what is being edited,
/// show the bracket a closing one just typed closes, submit the line,
/// cancel it, clear the screen, complete, show documentation, or leave the
/// session.
export type Edit =
    Edited(Editing)
  | Matching(Editing)
  | Submit(Editing)
  | Cancel
  | ClearScreen(Editing)
  | Completing(Editing)
  | Documenting(Editing)
  | Quit

/// A key of the keys' table: its name as `:keys` writes it, and each run
/// of events a terminal sends for it (report §12.1).
export type Key = Key(name : String, sends : List(List(Terminal.Event)))

/// A row of the keys' table: keys that do the same, and what they do.
export type Row = Row(keys : List(Key), help : String)

// Nothing typed yet and nothing behind it. A function and no `let`,
// since `Map.empty` is no constant (report §4.6), as
// `src/shell/README.md`'s *Idioms to notice* says.
fn fresh() : Editing =
    Editing(text = "",
            cursor = 0,
            killed = "",
            previous = OtherKey,
            pending = Plain,
            history = [],
            back = 0,
            kept = Map.empty,
            search = None)

/// A session's first line, after the inputs of the sessions before it,
/// newest first.
export fn start(history : List(String)) : Editing =
    Editing(..fresh(), =history)

/// The editing to type the next input in, once one is entered or
/// abandoned: the input just taken joins the history, which keeps the
/// last inputs as the file does, the texts the walk kept go (report
/// §11.2), and what was killed outlives the input it was killed from, as
/// Readline's does.
export fn next(editing : Editing) : Editing =
    Editing(..fresh(),
            killed = editing.killed,
            history = if keeps(editing) then
                List.take(editing.text :: editing.history, History.kept)
            else
                editing.history)

/// Report §11.2: a blank input and one equal to the input before it are
/// not kept, in the history or in the file.
export fn keeps(editing : Editing) : Bool =
    !String.isEmpty(String.trim(editing.text)) && List.get(editing.history, 0) != Some(editing.text)

/// Report §11.2: another line of the same input, which `M-Enter` asks
/// for and `Enter` does where the parser cannot finish what is typed,
/// taken at the cursor: what stands after it goes to the new line.
export fn newline(editing : Editing) : Editing =
    insert(editing, "\n")

/// The input and the cursor a completion left, which the reader puts
/// back; the editor knows no names and does no completing of its own. The
/// cursor is kept inside the input, whatever it is given.
export fn withLine(editing : Editing, text : String, cursor : Int) : Editing =
    Editing(..editing, =text, cursor = Int.max(0, Int.min(String.size(text), cursor)))

/// The input being edited, a search aside.
export fn text(editing : Editing) : String =
    editing.text

/// The cursor in the input being edited, a search aside.
export fn cursor(editing : Editing) : Int =
    editing.cursor

/// Whether the keys so far have begun a sequence the next key ends
/// (report §12.1).
export fn isMidSequence(editing : Editing) : Bool =
    match editing {
        Editing(pending = Plain) -> false
      | _ -> true
    }

/// What the reader shows and where the cursor stands in it: the input
/// itself, or, while a search runs, Readline's search prompt
/// with the match after it.
export fn shown(editing : Editing) : String =
    match editing {
        Editing(search = None, =text) -> text
      | Editing(search = Some(search), =text) -> asked(search, text) <> text
    }

/// Where the cursor stands in what `shown` answers.
export fn shownCursor(editing : Editing) : Int =
    match editing {
        Editing(search = None, =cursor) -> cursor
      | Editing(search = Some(search), =text, =cursor) -> String.size(asked(search, text)) + cursor
    }

fn asked(search : Search, text : String) : String =
    "("
        <> failedMark(search.query, text)
        <> direction(search.forward)
        <> ")`"
        <> search.query
        <> "': "

fn failedMark(query : String, text : String) : String =
    if String.isEmpty(query) || String.indexOf(text, query) != None then "" else "failed "

fn direction(forward : Bool) : String =
    if forward then "i-search" else "reverse-i-search"

/// What a key does to what is being edited, and what the reader does
/// next.
export fn edit(editing : Editing, event : Terminal.Event) : Edit = {
    // report §11.2: every key forgets what the key before it did but a
    // kill and a move between lines, which read it; a resize, which is no
    // key, and an `Escape` or a sequence begun, which is part of the key it
    // begins, keep it
    let before = editing.previous;
    let keyed = Editing(..editing, previous = OtherKey);
    match editing {
        Editing(search = Some(search)) ->
            searching(Editing(..keyed, pending = Plain), search, event)
      | Editing(pending = Meta) ->
            meta(Editing(..keyed, pending = Plain), before, event)
      | Editing(pending = Sequence(begun)) ->
            sequence(Editing(..keyed, pending = Plain), before, begun, event)
      | Editing(pending = Plain) ->
            plain(keyed, before, event)
    }
}

// Report §12.1: a sequence's parameters are characters from U+0020 to
// U+003F, and one from U+0040 to U+007E ends it, as ECMA-48 writes a
// control sequence; anything else ends it unread, and does what it does.
fn sequence(editing : Editing, before : Previous, begun : String, event : Terminal.Event) : Edit =
    match event {
        Terminal.Key(char) ->
            if char >= ' ' && char <= '?' then
                Edited(Editing(..editing,
                               pending = Sequence(begun <> Char.toString(char)),
                               previous = before))
            else if char >= '@' && char <= '~' then
                keyNamed(editing, begun <> Char.toString(char))
            else
                plain(editing, before, event)
      | other ->
            plain(editing, before, other)
    }

// Report §11.2: the keys the terminal sends as sequences that the editor
// binds, by what follows the `Escape`: `Shift-Tab` shows what the name at
// the cursor is, and `Home`, `End` and `Delete` do as `C-a`, `C-e` and
// `C-d`, but `Delete` on an empty input does nothing. Every other
// sequence does nothing, `Escape [ 1 ; 5 H` and `F1` as `Escape O P`
// among them.
fn keyNamed(editing : Editing, sequence : String) : Edit = {
    let Editing(=text, =cursor) = editing;
    match sequence {
        "[Z" ->
            Documenting(editing)
      | "[H" or "OH" or "[1~" or "[7~" ->
            Edited(Editing(..editing, cursor = lineStart(text, cursor)))
      | "[F" or "OF" or "[4~" or "[8~" ->
            Edited(Editing(..editing, cursor = lineEnd(text, cursor)))
      | "[3~" ->
            Edited(deleteAt(editing, cursor))
      | _ ->
            Edited(editing)
    }
}

// A key with no `Escape` before it, `before` what the key before it did.
fn plain(editing : Editing, before : Previous, event : Terminal.Event) : Edit =
    match event {
        Terminal.Interrupt -> Cancel
      | Terminal.Escape -> Edited(Editing(..editing, pending = Meta, previous = before))
      | Terminal.ArrowLeft -> Edited(backwardChar(editing))
      | Terminal.ArrowRight -> Edited(forwardChar(editing))
      | Terminal.ArrowUp -> Edited(up(editing, before))
      | Terminal.ArrowDown -> Edited(down(editing, before))
      | Terminal.Resized(_) -> Edited(Editing(..editing, previous = before))
      // report §11.2: a paste goes in at the cursor, line feeds and all
      | Terminal.Pasted(text) -> Edited(insert(editing, text))
      | Terminal.Key(char) -> character(editing, before, char)
    }

// Report §11.2: the cursor a character back and forward, `C-b` and `C-f`,
// as the arrows move it, within the input.
fn backwardChar(editing : Editing) : Editing =
    Editing(..editing, cursor = Int.max(0, editing.cursor - 1))

fn forwardChar(editing : Editing) : Editing =
    Editing(..editing, cursor = Int.min(String.size(editing.text), editing.cursor + 1))

// A character typed, which is Readline's control key where it is one.
fn character(editing : Editing, before : Previous, char : Char) : Edit = {
    let Editing(=text, =cursor, =killed) = editing;
    match char {
        '\r' or '\n' -> Submit(editing) // Enter
      | '\u{1}' -> Edited(Editing(..editing, cursor = lineStart(text, cursor))) // C-a
      | '\u{5}' -> Edited(Editing(..editing, cursor = lineEnd(text, cursor))) // C-e
      | '\u{2}' -> Edited(backwardChar(editing)) // C-b
      | '\u{6}' -> Edited(forwardChar(editing)) // C-f
      | '\u{4}' -> if String.isEmpty(text) then Quit else Edited(deleteAt(editing, cursor)) // C-d
      | '\u{8}' or '\u{7f}' -> Edited(deleteBefore(editing)) // Backspace and C-h
      | '\u{b}' -> Edited(killForwardTo(editing, before, lineKillEnd(text, cursor))) // C-k
      | '\u{15}' -> Edited(killBackTo(editing, before, lineStart(text, cursor))) // C-u
      | '\u{17}' -> Edited(killBackTo(editing, before, wordLeft(text, cursor, unspaced))) // C-w
      | '\u{19}' -> Edited(insert(editing, killed)) // C-y
      | '\u{c}' -> ClearScreen(editing) // C-l
      | '\t' -> Completing(editing) // the reader has the names to complete against
      | '\u{10}' -> Edited(up(editing, before)) // C-p
      | '\u{e}' -> Edited(down(editing, before)) // C-n
      | '\u{12}' -> Edited(search(editing, false)) // C-r
      | '\u{13}' -> Edited(search(editing, true)) // C-s
      // report §11.2: the reader shows the bracket it closes
      | ')' or ']' or '}' -> Matching(insert(editing, Char.toString(char)))
      // every other control character is not bound and does nothing
      | _ -> if char < ' ' then Edited(editing) else Edited(insert(editing, Char.toString(char)))
    }
}

// `Escape` and then the key: Readline's Meta bindings.
fn meta(editing : Editing, before : Previous, event : Terminal.Event) : Edit = {
    let Editing(=text, =cursor) = editing;
    match event {
        // report §11.2: another line, though the parser could run what
        // is typed
        Terminal.Key('\r') or Terminal.Key('\n') ->
            Edited(newline(editing))
      // report §12.1: `Escape [` and `Escape O` begin a sequence
      // `Terminal.Event` does not name (Appendix E.16)
      | Terminal.Key('[') ->
            Edited(Editing(..editing, pending = Sequence("["), previous = before))
      | Terminal.Key('O') ->
            Edited(Editing(..editing, pending = Sequence("O"), previous = before))
      | Terminal.Key('<') ->
            Edited(walkTo(editing, List.size(editing.history)))
      | Terminal.Key('>') ->
            Edited(walkTo(editing, 0))
      | Terminal.Key('b') ->
            Edited(Editing(..editing, cursor = wordLeft(text, cursor, alphanumeric)))
      | Terminal.Key('f') ->
            Edited(Editing(..editing, cursor = wordRight(text, cursor, alphanumeric)))
      | Terminal.Key('d') ->
            Edited(killForwardTo(editing, before, wordRight(text, cursor, alphanumeric)))
      | Terminal.Key('\u{8}') or Terminal.Key('\u{7f}') ->
            Edited(killBackTo(editing, before, wordLeft(text, cursor, alphanumeric)))
      | Terminal.Key(_) ->
            Edited(editing) // an unbound Meta key does nothing
      // every other key does what it does, `Escape` before it or not
      | other ->
            plain(editing, before, other)
    }
}

//
// Moving between the input's lines: a line is what stands between line
// feeds, however many rows it wraps onto, and the up and down keys walk
// the history from the input's first line and its last.
//

// Report §11.2: the up arrow and `C-p` move the cursor to the line
// above, and from the input's first line walk the history back.
fn up(editing : Editing, before : Previous) : Editing = {
    let Editing(=text, =cursor) = editing;
    let start = lineStart(text, cursor);
    if start == 0 then
        walkTo(editing, editing.back + 1)
    else
        toLine(editing, lineStart(text, start - 1), goalColumn(before, cursor - start))
}

// Report §11.2: the down arrow and `C-n` move the cursor to the line
// below, and from the input's last line walk the history forward.
fn down(editing : Editing, before : Previous) : Editing = {
    let Editing(=text, =cursor) = editing;
    let end = lineEnd(text, cursor);
    if end == String.size(text) then
        walkTo(editing, editing.back - 1)
    else
        toLine(editing, end + 1, goalColumn(before, cursor - lineStart(text, cursor)))
}

// Report §11.2: the cursor on the line that begins at `start`, at the
// column it keeps, or at the line's end where the line is shorter; the
// column is remembered for the next such move.
fn toLine(editing : Editing, start : Int, column : Int) : Editing =
    Editing(..editing,
            cursor = Int.min(start + column, lineEnd(editing.text, start)),
            previous = LineKey(column))

// The column a move between lines keeps: the one the move before it kept,
// or else the cursor's, counted in characters from its line's start.
fn goalColumn(before : Previous, current : Int) : Int =
    match before {
        LineKey(column) -> column
      | _ -> current
    }

// The start of the cursor's line, after the line feed before it.
fn lineStart(text : String, cursor : Int) : Int =
    match String.lastIndexOf(String.slice(text, 0, cursor), "\n") {
        None -> 0
      | Some(index) -> index + 1
    }

// The end of the cursor's line, at the line feed after it or the input's
// end.
fn lineEnd(text : String, cursor : Int) : Int =
    match String.indexOf(String.drop(text, cursor), "\n") {
        None -> String.size(text)
      | Some(index) -> cursor + index
    }

// Report §11.2: where `C-k` kills to, the end of the cursor's line, and
// at a line's end past its line feed.
fn lineKillEnd(text : String, cursor : Int) : Int = {
    let end = lineEnd(text, cursor);
    if end == cursor then Int.min(String.size(text), cursor + 1) else end
}

//
// Walking the history: the inputs before this one, newest first, with
// `back` how far through them the walk stands, 0 being the input being
// typed. Each place the walk leaves keeps the text it was left with, the
// input being typed among them, until an input is entered or abandoned
// (`next`); the history itself is never changed.
//

// Report §11.2: the walk to the place `back`, an input a walk back
// recalls shown with the cursor at the end of its first line and one a
// walk forward recalls at the end of its last. A walk with nowhere to go,
// past an end of the history or to where it stands, goes nowhere.
fn walkTo(editing : Editing, back : Int) : Editing =
    if back < 0 || back > List.size(editing.history) || back == editing.back then
        editing
    else {
        let walked = standAt(editing, back);
        let Editing(=text) = walked;
        Editing(..walked,
                cursor = if back > editing.back then lineEnd(text, 0) else String.size(text))
    }

// The walk standing at `back`, the text it leaves kept under the place it
// leaves; the cursor is the caller's to place.
fn standAt(editing : Editing, back : Int) : Editing =
    if back == editing.back then
        editing
    else
        Editing(..editing,
                text = textAt(editing, back),
                kept = Map.put(editing.kept, editing.back, editing.text),
                =back)

// What the place `back` shows, to a walk and a search alike: the text
// being edited where the walk stands, the text a walk left elsewhere, or
// else the input the history holds there.
fn textAt(editing : Editing, back : Int) : String =
    if back == editing.back then
        editing.text
    else match Map.get(editing.kept, back) {
        Some(text) -> text
      | None -> entry(editing.history, back)
    }

// The input `back` places back, 1 being the one before this input.
fn entry(history : List(String), back : Int) : String =
    Optional.withDefault(List.get(history, back - 1), "")

//
// Searching the history: `C-r` back and `C-s` forward, each character
// typed narrowing the search, `C-g` putting back what the search began
// from, and every other key ending the search and then doing what it
// does. A search that matches nothing keeps the input it last matched and
// says so in its prompt. It reads each place as the walk left it, and
// keeps the text it leaves as the walk does.
//

fn search(editing : Editing, forward : Bool) : Editing =
    Editing(..editing,
            search = Some(Search(query = "",
                                 back = editing.back,
                                 origin = editing.back,
                                 cursor = editing.cursor,
                                 =forward)))

fn searching(editing : Editing, search : Search, event : Terminal.Event) : Edit =
    match event {
        Terminal.Key('\r') or Terminal.Key('\n') ->
            Submit(stop(editing))
      | Terminal.Interrupt ->
            Cancel
      | Terminal.Resized(_) ->
            Edited(editing)
      | Terminal.Key('\u{12}') ->
            Edited(seek(editing, Search(..search, forward = false), 1)) // C-r
      | Terminal.Key('\u{13}') ->
            Edited(seek(editing, Search(..search, forward = true), -1)) // C-s
      | Terminal.Key('\u{7}') ->
            Edited(abandon(editing, search)) // C-g
      // Backspace
      | Terminal.Key('\u{8}') or Terminal.Key('\u{7f}') ->
            Edited(shorten(editing, search))
      | Terminal.Key(char) ->
            if char < ' ' then edit(stop(editing), event) else Edited(narrow(editing, search, char))
      | _ ->
            edit(stop(editing), event)
    }

// The next match in the direction, the search standing where it was when
// there is none.
fn seek(editing : Editing, search : Search, stride : Int) : Editing =
    match find(editing, search.query, search.back + stride, stride) {
        Some(found) -> matched(editing, search, found)
      | None -> Editing(..editing, search = Some(search))
    }

// A character typed: the search narrows and looks again from where it
// stands, since the match it has may match the longer query too.
fn narrow(editing : Editing, search : Search, char : Char) : Editing = {
    let Search(=query, =back) = search;
    let narrower = Search(..search, query = query <> Char.toString(char));
    let first = if back == 0 then back + stride(search) else back;
    match find(editing, query <> Char.toString(char), first, stride(search)) {
        Some(found) -> matched(editing, narrower, found)
      | None -> Editing(..editing, search = Some(narrower))
    }
}

// Backspace: the query loses its last character and the search begins
// again from where it started, so that a shorter query may match a
// nearer input.
fn shorten(editing : Editing, search : Search) : Editing = {
    let Search(=query, =origin) = search;
    let shorter = String.slice(query, 0, Int.max(0, String.size(query) - 1));
    let shortened = Search(..search, query = shorter, back = origin);
    if String.isEmpty(shorter) then
        Editing(..returned(editing, origin), search = Some(shortened))
    else match find(editing, shorter, origin + stride(search), stride(search)) {
        Some(found) -> matched(editing, shortened, found)
      | None -> Editing(..editing, search = Some(shortened))
    }
}

// Report §11.2: `C-g` leaves a search for the input it began from, the
// cursor back where it stood when the search began.
fn abandon(editing : Editing, search : Search) : Editing = {
    let walked = standAt(editing, search.origin);
    Editing(..walked, cursor = Int.min(search.cursor, String.size(walked.text)), search = None)
}

// The input the search began from, as it was left, with the cursor at
// its end.
fn returned(editing : Editing, origin : Int) : Editing = {
    let walked = standAt(editing, origin);
    Editing(..walked, cursor = String.size(walked.text))
}

// The search ends and the input it found stays.
fn stop(editing : Editing) : Editing =
    Editing(..editing, search = None)

fn matched(editing : Editing, search : Search, back : Int) : Editing = {
    let walked = standAt(editing, back);
    Editing(..walked,
            cursor = matchAt(walked.text, search.query),
            search = Some(Search(..search, =back)))
}

fn matchAt(text : String, query : String) : Int =
    match String.indexOf(text, query) {
        Some(index) -> index
      | None -> fault("a search stands at an input that contains its query")
    }

fn find(editing : Editing, query : String, back : Int, stride : Int) : Optional(Int) =
    if back < 1 || back > List.size(editing.history) then
        None
    else if String.contains(textAt(editing, back), query) then
        Some(back)
    else
        find(editing, query, back + stride, stride)

fn stride(search : Search) : Int =
    if search.forward then -1 else 1

//
// Editing a line: each is a pure function of the text and the cursor,
// which is what makes the editor testable on its own.
//

/// Text put in at the cursor, which is left after it. The cursor counts
/// graphemes, as the text is indexed, and what is put in may join the
/// grapheme before it, a combining mark or a skin tone, so the cursor is
/// measured as the text before it now stands.
export fn insert(editing : Editing, text : String) : Editing = {
    let Editing(text = line, =cursor) = editing;
    let before = String.slice(line, 0, cursor) <> text;
    Editing(..editing, text = before <> String.drop(line, cursor), cursor = String.size(before))
}

fn deleteBefore(editing : Editing) : Editing =
    match editing {
        Editing(cursor = 0) ->
            editing
      | Editing(=text, =cursor) ->
            Editing(..editing,
                    text = String.slice(text, 0, cursor - 1) <> String.drop(text, cursor),
                    cursor = cursor - 1)
    }

fn deleteAt(editing : Editing, index : Int) : Editing = {
    let Editing(=text) = editing;
    if index >= String.size(text) then
        editing
    else
        Editing(..editing, text = String.slice(text, 0, index) <> String.drop(text, index + 1))
}

// Kill back to `index`, keeping what was killed for `C-y`. Report §11.2:
// kills made one after another are one kill, so where the key before was
// a kill too, what this one takes joins the front of what `C-y` holds, as
// Readline joins them.
fn killBackTo(editing : Editing, before : Previous, index : Int) : Editing = {
    let Editing(=text, =cursor) = editing;
    if index >= cursor then
        unbroken(editing, before)
    else
        Editing(..editing,
                text = String.slice(text, 0, index) <> String.drop(text, cursor),
                cursor = index,
                killed = String.slice(text, index, cursor) <> joined(editing, before),
                previous = KillKey)
}

// Kill forward to `index`, as `killBackTo` kills back, what it takes
// joining the end of what `C-y` holds.
fn killForwardTo(editing : Editing, before : Previous, index : Int) : Editing = {
    let Editing(=text, =cursor) = editing;
    if index <= cursor then
        unbroken(editing, before)
    else
        Editing(..editing,
                text = String.slice(text, 0, cursor) <> String.drop(text, index),
                killed = joined(editing, before) <> String.slice(text, cursor, index),
                previous = KillKey)
}

// What a kill joins: the last kill, where the key before was a kill too.
fn joined(editing : Editing, before : Previous) : String =
    match before {
        KillKey -> editing.killed
      | _ -> ""
    }

// A kill of nothing leaves the last kill as it was, as Readline's does,
// and leaves a run of kills unbroken, beginning none.
fn unbroken(editing : Editing, before : Previous) : Editing =
    match before {
        KillKey -> Editing(..editing, previous = KillKey)
      | _ -> editing
    }

// report §11.2: the start of the word before the cursor, over what is not
// in a word and then over the word itself; `inWord` says what a word is,
// a run of letters and digits for the Meta keys and anything but a space,
// a tab or a line feed for C-w, as in Readline.
fn wordLeft(text : String, cursor : Int, inWord : (String, Int) -> Bool) : Int =
    over(text, over(text, cursor, -1, fn(line, index) = !inWord(line, index)), -1, inWord)

// The end of the word after the cursor.
fn wordRight(text : String, cursor : Int, inWord : (String, Int) -> Bool) : Int =
    over(text, over(text, cursor, 1, fn(line, index) = !inWord(line, index)), 1, inWord)

// From `index`, `stride` at a time, while the character stepped over `holds`.
fn over(text : String, index : Int, stride : Int, holds : (String, Int) -> Bool) : Int =
    if isBeyond(text, index, stride) then
        index
    else if holds(text, index + Int.min(stride, 0)) then
        over(text, index + stride, stride, holds)
    else
        index

// The character a step away is off the line, so the walk over the word
// stops there.
fn isBeyond(text : String, index : Int, stride : Int) : Bool =
    index + Int.min(stride, 0) < 0 || index + Int.max(stride, 0) > String.size(text)

fn unspaced(text : String, index : Int) : Bool = {
    let grapheme = String.slice(text, index, index + 1);
    grapheme != " " && grapheme != "\t" && grapheme != "\n"
}

// A grapheme is judged by its first code point, which is what Char's
// predicates see.
fn alphanumeric(text : String, index : Int) : Bool =
    match String.toList(String.slice(text, index, index + 1)) {
        char :: _ -> Char.isAlpha(char) || Char.isDigit(char)
      | [] -> fault("a word's walk steps over a grapheme inside the text")
    }

//
// The keys' table, which `:keys` lists and the tests below hold to `edit`
// both ways.
//

/// Report §11.2: the keys the editor binds, a row for the keys that do the
/// same, in the order *Editing* names them, each key with every run of
/// events a terminal sends for it (§12.1): both characters of `Enter` and
/// of `Backspace`, and each sequence of `Home` and of `End`, as the editor
/// reads them. A control key that sends the character of a key here, `C-m`
/// that of `Enter`, is not listed.
export fn boundKeys() : List(Row) =
    [Row(keys = [Key(name = "Enter", sends = [[Terminal.Key('\r')], [Terminal.Key('\n')]])],
         help = "runs a finished input, and adds a line to an unfinished one"),
     Row(keys = [Key(name = "M-Enter", sends = [escaped("\r"), escaped("\n")])],
         help = "adds a line"),
     Row(keys = [Key(name = "C-c", sends = [[Terminal.Interrupt]])],
         help = "abandons the input, and ends the one that runs"),
     Row(keys = [Key(name = "C-d", sends = [[Terminal.Key('\u{4}')]])],
         help = "deletes the character at the cursor, and leaves the shell on an empty input"),
     Row(keys = [Key(name = "Tab", sends = [[Terminal.Key('\t')]])],
         help = "completes the name before the cursor, and lists the candidates"),
     Row(keys = [Key(name = "Shift-Tab", sends = [escaped("[Z")])],
         help = "shows what the name at the cursor is, and its documentation when pressed again"),
     Row(keys = [Key(name = "C-b", sends = [[Terminal.Key('\u{2}')]]),
                 Key(name = "Left", sends = [[Terminal.ArrowLeft]])],
         help = "moves back a character"),
     Row(keys = [Key(name = "C-f", sends = [[Terminal.Key('\u{6}')]]),
                 Key(name = "Right", sends = [[Terminal.ArrowRight]])],
         help = "moves forward a character"),
     Row(keys = [Key(name = "M-b", sends = [escaped("b")])], help = "moves back a word"),
     Row(keys = [Key(name = "M-f", sends = [escaped("f")])], help = "moves forward a word"),
     Row(keys = [Key(name = "C-a", sends = [[Terminal.Key('\u{1}')]]),
                 Key(name = "Home",
                     sends = [escaped("[H"), escaped("OH"), escaped("[1~"), escaped("[7~")])],
         help = "moves to the start of the line"),
     Row(keys = [Key(name = "C-e", sends = [[Terminal.Key('\u{5}')]]),
                 Key(name = "End",
                     sends = [escaped("[F"), escaped("OF"), escaped("[4~"), escaped("[8~")])],
         help = "moves to the end of the line"),
     Row(keys = [Key(name = "C-p", sends = [[Terminal.Key('\u{10}')]]),
                 Key(name = "Up", sends = [[Terminal.ArrowUp]])],
         help = "moves to the line above, and from the first line back in the history"),
     Row(keys = [Key(name = "C-n", sends = [[Terminal.Key('\u{e}')]]),
                 Key(name = "Down", sends = [[Terminal.ArrowDown]])],
         help = "moves to the line below, and from the last line forward in the history"),
     Row(keys = [Key(name = "M-<", sends = [escaped("<")])],
         help = "goes to the history's first input"),
     Row(keys = [Key(name = "M->", sends = [escaped(">")])],
         help = "goes to the input being typed"),
     Row(keys = [Key(name = "C-r", sends = [[Terminal.Key('\u{12}')]])],
         help = "searches the history backward"),
     Row(keys = [Key(name = "C-s", sends = [[Terminal.Key('\u{13}')]])],
         help = "searches the history forward"),
     Row(keys = [Key(name = "C-g", sends = [[Terminal.Key('\u{7}')]])],
         help = "leaves a search for the input it began from"),
     Row(keys = [Key(name = "Backspace",
                     sends = [[Terminal.Key('\u{7f}')], [Terminal.Key('\u{8}')]]),
                 Key(name = "C-h", sends = [[Terminal.Key('\u{8}')]])],
         help = "deletes the character before the cursor"),
     Row(keys = [Key(name = "Delete", sends = [escaped("[3~")])],
         help = "deletes the character at the cursor"),
     Row(keys = [Key(name = "C-k", sends = [[Terminal.Key('\u{b}')]])],
         help = "kills to the end of the line"),
     Row(keys = [Key(name = "C-u", sends = [[Terminal.Key('\u{15}')]])],
         help = "kills back to the start of the line"),
     Row(keys = [Key(name = "C-w", sends = [[Terminal.Key('\u{17}')]])],
         help = "kills back to a space"),
     Row(keys = [Key(name = "M-Backspace", sends = [escaped("\u{7f}"), escaped("\u{8}")])],
         help = "kills back a word"),
     Row(keys = [Key(name = "M-d", sends = [escaped("d")])], help = "kills forward a word"),
     Row(keys = [Key(name = "C-y", sends = [[Terminal.Key('\u{19}')]])],
         help = "puts back what the last kill took"),
     Row(keys = [Key(name = "C-l", sends = [[Terminal.Key('\u{c}')]])], help = "clears the screen")]

// `Escape` and the characters after it, as a terminal sends a Meta key and
// a sequence the runtime does not name (report §12.1).
fn escaped(text : String) : List(Terminal.Event) =
    Terminal.Escape :: List.map(String.toList(text), Terminal.Key)

//
// The tests (report Appendix E.24, §11.2), run by `ern test`, which `make
// test-shell` does. Each plays a list of events onto a fresh line and reads
// off the text and the cursor.
//

let typing =
    Test.Case(name = "typing inserts at the cursor",
              run = fn() = reads(play(keys("abc") <> [Terminal.ArrowLeft] <> keys("X")), "abXc", 3))

// a regression test: the cursor moved by the Chars a key put in, so a
// combining mark after a letter left it past the end
let combining =
    Test.Case(name = "a mark that joins the letter before it leaves the cursor after both",
              run = fn() =
                  reads(play(keys("e") <> [Terminal.Key('\u{301}'), Terminal.Key('\u{7f}')]),
                        "",
                        0))

let ends =
    Test.Case(name = "C-a and C-e go to the ends of the line",
              run = fn() =
                  reads(play(keys("abc") <> [ctrl('a')] <> keys("X") <> [ctrl('e')] <> keys("Y")),
                        "XabcY",
                        5))

let backspace =
    Test.Case(name = "backspace deletes what is before the cursor",
              run = fn() = reads(play(keys("abc") <> [Terminal.Key('\u{7f}')]), "ab", 2))

let forwardDelete =
    Test.Case(name = "C-d deletes what is under the cursor",
              run = fn() = reads(play(keys("abc") <> [ctrl('a'), ctrl('d')]), "bc", 0))

let killAndYank =
    Test.Case(name = "C-k kills to the end and C-y puts it back",
              run = fn() =
                  reads(play(keys("abcdef")
                                 <> [Terminal.ArrowLeft,
                                     Terminal.ArrowLeft,
                                     ctrl('k'),
                                     ctrl('a'),
                                     ctrl('y')]),
                        "efabcd",
                        2))

let killLine =
    Test.Case(name = "C-u kills back to the start of the line",
              run = fn() = reads(play(keys("one two") <> [ctrl('u')]), "", 0))

let killWord =
    Test.Case(name = "C-w kills the word before the cursor",
              run = fn() = reads(play(keys("one two") <> [ctrl('w')]), "one ", 4))

let wordsBack =
    Test.Case(name = "M-b goes to the start of the word before",
              run = fn() =
                  reads(play(keys("one two") <> [Terminal.Escape] <> keys("b")), "one two", 4))

let wordsForward =
    Test.Case(name = "M-f goes to the end of the word after",
              run = fn() =
                  reads(play(keys("one two") <> [ctrl('a'), Terminal.Escape] <> keys("f")),
                        "one two",
                        3))

let killWordForward =
    Test.Case(name = "M-d kills the word after the cursor",
              run = fn() =
                  reads(play(keys("one two") <> [ctrl('a'), Terminal.Escape] <> keys("d")),
                        " two",
                        0))

// report §11.2: the Meta keys' word is a run of letters and digits, and
// C-w's runs back to a space. Regression tests: the ones above use "one
// two", where the two agree, and passed while every key stopped at spaces
// only. Not covered: a grapheme of several code points inside a word.
let wordsBackInCode =
    Test.Case(name = "M-b stops at a letter after punctuation",
              run = fn() =
                  reads(play(keys("List.map(xs") <> [Terminal.Escape] <> keys("b")),
                        "List.map(xs",
                        9))

let wordsForwardInCode =
    Test.Case(name = "M-f stops at the end of letters",
              run = fn() =
                  reads(play(keys("List.map(xs") <> [ctrl('a'), Terminal.Escape] <> keys("f")),
                        "List.map(xs",
                        4))

let killWordForwardInCode =
    Test.Case(name = "M-d kills letters and digits only",
              run = fn() =
                  reads(play(keys("List.map(xs") <> [ctrl('a'), Terminal.Escape] <> keys("d")),
                        ".map(xs",
                        0))

let killWordBackInCode =
    Test.Case(name = "M-Backspace kills letters and digits only",
              run = fn() =
                  reads(play(keys("List.map(xs") <> [Terminal.Escape, Terminal.Key('\u{7f}')]),
                        "List.map(",
                        9))

let killToSpaceInCode =
    Test.Case(name = "C-w kills back to a space",
              run = fn() = reads(play(keys("f List.map(xs") <> [ctrl('w')]), "f ", 2))

// Regression tests: a kill of nothing emptied what C-y puts back, and
// C-w killed across a tab.
let killOfNothing =
    Test.Case(name = "a kill of nothing leaves the last kill",
              run = fn() =
                  reads(play(keys("ab") <> [ctrl('w'), ctrl('k'), ctrl('w'), ctrl('y')]), "ab", 2))

let killToTab =
    Test.Case(name = "C-w kills back to a tab",
              run = fn() = reads(play([Terminal.Pasted("one\ttwo"), ctrl('w')]), "one\t", 4))

let submits =
    Test.Case(name = "Enter submits what was typed",
              run = fn() = match play(keys("hi") <> [Terminal.Key('\r')]) {
                  Submit(Editing(text = "hi")) -> Test.Passed
                | other -> Test.Failed(said(other))
              })

let closes =
    Test.Case(name = "a closing bracket typed asks the reader to show the one it closes",
              run = fn() = match play(keys("[{f(x)}]")) {
                  Matching(Editing(text = "[{f(x)}]", cursor = 8)) -> Test.Passed
                | other -> Test.Failed(said(other))
              })

let closesInSearch =
    Test.Case(name = "a closing bracket typed into a search shows nothing",
              run = fn() = match play([ctrl('r')] <> keys(")")) {
                  Edited(_) -> Test.Passed
                | other -> Test.Failed(said(other))
              })

let closesPasted =
    Test.Case(name = "a closing bracket pasted shows nothing",
              run = fn() = reads(play([Terminal.Pasted("f(x)")]), "f(x)", 4))

let cancels =
    Test.Case(name = "C-c abandons the line",
              run = fn() = match play(keys("hi") <> [Terminal.Interrupt]) {
                  Cancel -> Test.Passed
                | other -> Test.Failed(said(other))
              })

let leaves =
    Test.Case(name = "C-d on an empty input leaves the shell",
              run = fn() = match play([ctrl('d')]) {
                  Quit -> Test.Passed
                | other -> Test.Failed(said(other))
              })

let clears =
    Test.Case(name = "C-l clears the screen and keeps the line",
              run = fn() = match play(keys("hi") <> [ctrl('l')]) {
                  ClearScreen(Editing(text = "hi", cursor = 2)) -> Test.Passed
                | other -> Test.Failed(said(other))
              })

let addsLine =
    Test.Case(name = "M-Enter adds a line at the cursor",
              run = fn() =
                  reads(play(keys("ab") <> [Terminal.Escape, Terminal.Key('\r')] <> keys("c")),
                        "ab\nc",
                        4))

let pastes =
    Test.Case(name = "a paste goes in at the cursor, line feeds and all",
              run = fn() =
                  reads(play(keys("ab") <> [Terminal.ArrowLeft, Terminal.Pasted("x\ny")]),
                        "ax\nyb",
                        4))

// report §11.2: a line is taken at the cursor, and what stands after the
// cursor on its line goes to the new one; `Enter` hands the reader the
// cursor, and the reader's `newline` takes the line there
let takesLineAtCursor =
    Test.Case(name = "Enter takes a line at the cursor",
              run = fn() =
                  match play(keys("abcd")
                                 <> [Terminal.ArrowLeft, Terminal.ArrowLeft, Terminal.Key('\r')]) {
                      Submit(editing) -> reads(Edited(newline(editing)), "ab\ncd", 3)
                    | other -> Test.Failed(said(other))
                  })

//
// Report §11.2: the input's lines, which a line feed parts.
//

// The text of three lines the column tests move through, its first and
// last of eight characters and its middle of one: 0 to 8, 9 to 10, and
// 11 to 19.
let threeLines = Terminal.Pasted("abcdefgh\nx\nabcdefgh")

let upByLine =
    Test.Case(name = "the up arrow moves to the line above, keeping the column",
              run = fn() =
                  reads(play([Terminal.Pasted("abcd\nxy"), Terminal.ArrowLeft, Terminal.ArrowUp]),
                        "abcd\nxy",
                        1))

let downByLine =
    Test.Case(name = "the down arrow moves to the line below, keeping the column",
              run = fn() =
                  reads(play([Terminal.Pasted("ab\ncd"),
                              Terminal.ArrowUp,
                              Terminal.ArrowLeft,
                              Terminal.ArrowDown]),
                        "ab\ncd",
                        4))

let linesByKey =
    Test.Case(name = "C-p and C-n move between lines as the arrows do",
              run = fn() =
                  reads(play([Terminal.Pasted("ab\ncd\nef"), ctrl('p'), ctrl('p'), ctrl('n')]),
                        "ab\ncd\nef",
                        5))

let upWalksFromFirstLine =
    Test.Case(name = "the up arrow on the input's first line walks the history back",
              run = fn() =
                  reads(plays(start(["old"]),
                              [Terminal.Pasted("ab\ncd"), Terminal.ArrowUp, Terminal.ArrowUp]),
                        "old",
                        3))

let downWalksFromLastLine =
    Test.Case(name = "the down arrow on the input's last line walks the history forward",
              run = fn() =
                  reads(plays(start(["x\nyz"]),
                              [Terminal.ArrowUp, Terminal.ArrowDown, Terminal.ArrowDown]),
                        "",
                        0))

let shorterLine =
    Test.Case(name = "the cursor stands at the end of a line shorter than its column",
              run = fn() = reads(play([Terminal.Pasted("x\nabc"), Terminal.ArrowUp]), "x\nabc", 1))

let emptyLine =
    Test.Case(name = "an empty line inside an input is a line, and the column passes it",
              run = fn() = {
                  let typed = Terminal.Pasted("abc\n\ndef");
                  Test.equal(#(cursorAfter([typed, Terminal.ArrowUp]),
                               cursorAfter([typed, Terminal.ArrowUp, Terminal.ArrowUp])),
                             #(4, 3))
              })

let columnRememberedUp =
    Test.Case(name = "the column is remembered up through a shorter line",
              run = fn() =
                  reads(play([threeLines, Terminal.ArrowUp, Terminal.ArrowUp]),
                        "abcdefgh\nx\nabcdefgh",
                        8))

let columnRememberedDown =
    Test.Case(name = "the column is remembered down through a shorter line",
              run = fn() =
                  reads(play([threeLines, ctrl('p'), ctrl('p'), ctrl('n'), ctrl('n')]),
                        "abcdefgh\nx\nabcdefgh",
                        19))

let columnForgottenByKey =
    Test.Case(name = "any other key forgets the column",
              run = fn() =
                  reads(play([threeLines, Terminal.ArrowUp, ctrl('e'), Terminal.ArrowUp]),
                        "abcdefgh\nx\nabcdefgh",
                        1))

let columnForgottenByWalk =
    Test.Case(name = "a walk forgets the column",
              run = fn() =
                  reads(plays(start(["q\nrstuvwxyz"]),
                              [Terminal.Pasted("abcdefgh\nabcdefgh"),
                               Terminal.ArrowUp,
                               Terminal.ArrowUp,
                               Terminal.ArrowDown]),
                        "q\nrstuvwxyz",
                        3))

let columnThroughResize =
    Test.Case(name = "a resize forgets no column",
              run = fn() =
                  reads(play([threeLines,
                              Terminal.ArrowUp,
                              Terminal.Resized(Terminal.Size(rows = 24, columns = 80)),
                              Terminal.ArrowUp]),
                        "abcdefgh\nx\nabcdefgh",
                        8))

// the `Escape` before a key is part of that key
let columnThroughEscape =
    Test.Case(name = "an Escape before an arrow forgets no column",
              run = fn() =
                  reads(play([threeLines, Terminal.ArrowUp, Terminal.Escape, Terminal.ArrowUp]),
                        "abcdefgh\nx\nabcdefgh",
                        8))

let lineEnds =
    Test.Case(name = "C-a and C-e go to the ends of the cursor's line",
              run = fn() =
                  reads(play([Terminal.Pasted("abc\ndef"), Terminal.ArrowUp, ctrl('a')]
                                 <> keys("X")
                                 <> [ctrl('e')]
                                 <> keys("Y")),
                        "XabcY\ndef",
                        5))

let lastLineStart =
    Test.Case(name = "C-a on the last line goes to its start",
              run = fn() =
                  reads(play([Terminal.Pasted("abc\ndef"), ctrl('a')] <> keys("X")),
                        "abc\nXdef",
                        5))

let killToLineEnd =
    Test.Case(name = "C-k kills to the end of the cursor's line",
              run = fn() =
                  reads(play([Terminal.Pasted("abc\ndef"), Terminal.ArrowUp, ctrl('a'), ctrl('k')]),
                        "\ndef",
                        0))

let killLineFeed =
    Test.Case(name = "C-k at a line's end kills its line feed",
              run = fn() =
                  reads(play([Terminal.Pasted("abc\ndef"), Terminal.ArrowUp, ctrl('k')]),
                        "abcdef",
                        3))

let killAtInputEnd =
    Test.Case(name = "C-k at the input's end kills nothing",
              run = fn() = reads(play([Terminal.Pasted("abc\ndef"), ctrl('k')]), "abc\ndef", 7))

let killToLineStart =
    Test.Case(name = "C-u kills back to the start of the cursor's line",
              run = fn() = reads(play([Terminal.Pasted("abc\ndef"), ctrl('u')]), "abc\n", 4))

let killAtLineStart =
    Test.Case(name = "C-u at a line's start kills nothing",
              run = fn() =
                  reads(play([Terminal.Pasted("abc\ndef"), ctrl('a'), ctrl('u')]), "abc\ndef", 4))

let killWordToLineFeed =
    Test.Case(name = "C-w kills back to a line feed",
              run = fn() = reads(play([Terminal.Pasted("abc\ndef"), ctrl('w')]), "abc\n", 4))

let deleteBeforeLine =
    Test.Case(name = "Backspace at a line's start deletes the line feed before it",
              run = fn() =
                  reads(play([Terminal.Pasted("ab\ncd"), ctrl('a'), Terminal.Key('\u{7f}')]),
                        "abcd",
                        2))

let wordBackPastLine =
    Test.Case(name = "M-b at a line's start goes to the word on the line before",
              run = fn() =
                  reads(play([Terminal.Pasted("ab\ncd"), ctrl('a'), Terminal.Escape] <> keys("b")),
                        "ab\ncd",
                        0))

let killWordPastLine =
    Test.Case(name = "C-w at a line's start kills the line feed and the word before it",
              run = fn() = reads(play([Terminal.Pasted("ab\ncd"), ctrl('a'), ctrl('w')]), "cd", 0))

// report §11.2: a character is a grapheme, and the column counts them
let columnInGraphemes =
    Test.Case(name = "the column counts graphemes",
              run = fn() =
                  reads(play([Terminal.Pasted("e\u{301}xyz\nab"), Terminal.ArrowUp] <> keys("!")),
                        "e\u{301}x!yz\nab",
                        3))

//
// Report §11.2: kills made one after another are one kill.
//

let killsJoinForward =
    Test.Case(name = "kills forward one after another are one kill",
              run = fn() =
                  reads(play([Terminal.Pasted("one two three"), ctrl('a'), Terminal.Escape]
                                 <> keys("d")
                                 <> [Terminal.Escape]
                                 <> keys("d")
                                 <> [ctrl('y')]),
                        "one two three",
                        7))

let killsJoinBack =
    Test.Case(name = "kills back one after another are one kill",
              run = fn() =
                  reads(play([Terminal.Pasted("one two three"), ctrl('w'), ctrl('w'), ctrl('y')]),
                        "one two three",
                        13))

let killsJoinBothWays =
    Test.Case(name = "a kill back after a kill forward joins its front",
              run = fn() =
                  reads(play([Terminal.Pasted("abc def"),
                              Terminal.ArrowLeft,
                              Terminal.ArrowLeft,
                              ctrl('k'),
                              ctrl('u'),
                              ctrl('y')]),
                        "abc def",
                        7))

let killRunEnded =
    Test.Case(name = "a key between two kills makes them two",
              run = fn() =
                  reads(play([Terminal.Pasted("one two three"),
                              ctrl('w'),
                              ctrl('e'),
                              ctrl('w'),
                              ctrl('y')]),
                        "one two ",
                        8))

// Report §11.2, as in Readline: a kill that takes nothing is a kill still,
// so the kills on either side of it are one, but it begins no run with
// the kill before another key.
let killOfNothingInRun =
    Test.Case(name = "a kill of nothing between two kills leaves them one",
              run = fn() =
                  reads(play([Terminal.Pasted("ab cd"),
                              ctrl('w'),
                              ctrl('k'),
                              ctrl('w'),
                              ctrl('y')]),
                        "ab cd",
                        5))

let killOfNothingBeginsNoRun =
    Test.Case(name = "a kill of nothing begins no run with the last kill",
              run = fn() =
                  reads(play([Terminal.Pasted("ab cd"),
                              ctrl('w'),
                              ctrl('e'),
                              ctrl('k'),
                              ctrl('w'),
                              ctrl('y')]),
                        "ab ",
                        3))

let asksToComplete =
    Test.Case(name = "Tab asks the reader to complete",
              run = fn() = match play(keys("Li") <> [Terminal.Key('\t')]) {
                  Completing(Editing(text = "Li")) -> Test.Passed
                | other -> Test.Failed(said(other))
              })

let asksToDocument =
    Test.Case(name = "Shift-Tab asks the reader for documentation",
              run = fn() = match play(keys("List.map") <> [Terminal.Escape] <> keys("[Z")) {
                  Documenting(Editing(text = "List.map")) -> Test.Passed
                | other -> Test.Failed(said(other))
              })

// report §11.2. A regression test: the rest of a sequence but `Shift-Tab`
// was typed into the line, `a3~` for `Delete`. `Escape [ 1 ; 5 H` and
// `Escape [ 5 ~` hold the characters of `Home` and of `Delete` with other
// parameters.
let unboundSequences = Test.Case(name = "a sequence that is not bound does nothing", run = fn() = {
    let sequences = ["[5~", "[1;5C", "[1;5H", "[2~", "OP", "[15~"];
    let typed = List.flatMap(sequences, fn(rest) = [Terminal.Escape] <> keys(rest));
    reads(play(keys("ab") <> [Terminal.ArrowLeft] <> typed <> keys("c")), "acb", 2)
})

// report §11.2: `Home` does as `C-a`, by each sequence a terminal sends
// for it
let homeKey = Test.Case(name = "Home goes to the start of the cursor's line", run = fn() = {
    let typed = [Terminal.Pasted("abc\ndef"), Terminal.ArrowLeft];
    Test.equal(List.map(["[H", "OH", "[1~", "[7~"],
                        fn(rest) = cursorAfter(typed <> [Terminal.Escape] <> keys(rest))),
               [4, 4, 4, 4])
})

// report §11.2: `End` does as `C-e`
let endKey = Test.Case(name = "End goes to the end of the cursor's line", run = fn() = {
    let typed = [Terminal.Pasted("abc\ndef"), Terminal.ArrowUp, ctrl('a')];
    Test.equal(List.map(["[F", "OF", "[4~", "[8~"],
                        fn(rest) = cursorAfter(typed <> [Terminal.Escape] <> keys(rest))),
               [3, 3, 3, 3])
})

// report §11.2: `Delete` does as `C-d`
let deleteKey =
    Test.Case(name = "Delete deletes the character at the cursor",
              run = fn() =
                  reads(play([Terminal.Pasted("abc"), ctrl('a'), Terminal.Escape] <> keys("[3~")),
                        "bc",
                        0))

// report §11.2: a line feed is a character
let deleteLineFeed =
    Test.Case(name = "Delete at a line's end deletes its line feed",
              run = fn() =
                  reads(play([Terminal.Pasted("ab\ncd"), Terminal.ArrowUp, Terminal.Escape]
                                 <> keys("[3~")),
                        "abcd",
                        2))

// report §11.2: `Delete` on an empty input does nothing, where `C-d`
// leaves the shell
let deleteOnEmpty =
    Test.Case(name = "Delete on an empty input does nothing",
              run = fn() = reads(play([Terminal.Escape] <> keys("[3~")), "", 0))

let sequenceEndsUnread =
    Test.Case(name = "a key that is no part of a sequence ends it and does what it does",
              run = fn() =
                  reads(play(keys("a")
                                 <> [Terminal.Escape]
                                 <> keys("[1")
                                 <> [Terminal.ArrowLeft]
                                 <> keys("b")),
                        "ba",
                        1))

let walks =
    Test.Case(name = "the arrows walk back through the inputs",
              run = fn() =
                  reads(plays(start(["two", "one"]),
                              [Terminal.ArrowUp, Terminal.ArrowUp, Terminal.ArrowUp]),
                        "one",
                        3))

let walksBack =
    Test.Case(name = "walking back and returning brings back what was typed",
              run = fn() =
                  reads(plays(start(["old"]),
                              keys("new") <> [Terminal.ArrowUp, Terminal.ArrowDown]),
                        "new",
                        3))

let walksByKey =
    Test.Case(name = "C-p and C-n walk as the arrows do",
              run = fn() =
                  reads(plays(start(["two", "one"]), [ctrl('p'), ctrl('p'), ctrl('n')]), "two", 3))

let walksToEnds =
    Test.Case(name = "M-< goes to the oldest input and M-> back to the line",
              run = fn() =
                  reads(plays(start(["two", "one"]),
                              [Terminal.Escape] <> keys("<") <> [Terminal.Escape] <> keys(">")),
                        "",
                        0))

// Report §11.2: a walk keeps each input as it was left, changed or not,
// the one being typed among them, until an input is entered or abandoned.
let keepsWhatItLeaves =
    Test.Case(name = "a walk keeps a recalled input as it was left",
              run = fn() =
                  reads(plays(start(["old"]),
                              keys("new")
                                  <> [Terminal.ArrowUp]
                                  <> keys("!")
                                  <> [Terminal.ArrowDown, Terminal.ArrowUp]),
                        "old!",
                        4))

// The reader answers `C-c` with `next` too, so this holds an input
// abandoned as well as one entered.
let keptUntilEntered =
    Test.Case(name = "the kept inputs go once an input is entered",
              run = fn() =
                  match plays(start(["old"]),
                              [Terminal.ArrowUp]
                                  <> keys("!")
                                  <> [Terminal.ArrowDown]
                                  <> keys("x")
                                  <> [Terminal.Key('\r')]) {
                      Submit(editing) -> {
                          let entered = next(editing);
                          Test.equal(#(entered.history,
                                       shows(plays(entered, [Terminal.ArrowUp, Terminal.ArrowUp]))),
                                     #(["x", "old"], "old"))
                      }
                    | other ->
                          Test.Failed(said(other))
                  })

// Report §11.2: an input a walk back recalls shows with the cursor at the
// end of its first line, and one a walk forward recalls at the end of its
// last.
let recalledBack =
    Test.Case(name = "a walk back shows the cursor at the end of the first line",
              run = fn() = reads(plays(start(["ab\ncd"]), [Terminal.ArrowUp]), "ab\ncd", 2))

let recalledForward =
    Test.Case(name = "a walk forward shows the cursor at the end of the last line",
              run = fn() =
                  reads(plays(start(["ab\ncd", "x\nyz"]),
                              [Terminal.ArrowUp,
                               Terminal.ArrowUp,
                               Terminal.ArrowDown,
                               Terminal.ArrowDown]),
                        "ab\ncd",
                        5))

// Report §11.2: `M-<` walks to the history's first input and `M->` to the
// input being typed, from any line.
let firstFromAnyLine =
    Test.Case(name = "M-< walks to the oldest input from the last line",
              run = fn() =
                  reads(plays(start(["ab\ncd", "x\nyz"]),
                              [Terminal.Pasted("p\nq"), Terminal.Escape] <> keys("<")),
                        "x\nyz",
                        1))

let typedFromAnyLine =
    Test.Case(name = "M-> walks back to the input being typed from the first line",
              run = fn() =
                  reads(plays(start(["ab\ncd", "x\nyz"]),
                              [Terminal.Pasted("p\nq"), Terminal.Escape]
                                  <> keys("<")
                                  <> [Terminal.Escape]
                                  <> keys(">")),
                        "p\nq",
                        3))

// Report §11.2: at an end of the history a walk goes nowhere, and moves
// no cursor.
let nowhereBack =
    Test.Case(name = "the up arrow at the oldest input goes nowhere",
              run = fn() =
                  reads(plays(start(["old"]),
                              [Terminal.ArrowUp, Terminal.ArrowLeft, Terminal.ArrowUp]),
                        "old",
                        2))

let nowhereForward =
    Test.Case(name = "the down arrow at the input being typed goes nowhere",
              run = fn() =
                  reads(plays(start(["old"]),
                              keys("ab") <> [Terminal.ArrowLeft, Terminal.ArrowDown]),
                        "ab",
                        1))

let alreadyFirst =
    Test.Case(name = "M-< at the oldest input goes nowhere",
              run = fn() =
                  reads(plays(start(["old"]),
                              [Terminal.ArrowUp, ctrl('a'), Terminal.Escape] <> keys("<")),
                        "old",
                        0))

let alreadyTyped =
    Test.Case(name = "M-> at the input being typed goes nowhere",
              run = fn() =
                  reads(plays(start(["old"]),
                              keys("ab") <> [ctrl('a'), Terminal.Escape] <> keys(">")),
                        "ab",
                        0))

let searches =
    Test.Case(name = "C-r finds the newest input holding what is typed",
              run = fn() =
                  reads(plays(start(["print two", "let x = 1"]), [ctrl('r')] <> keys("two")),
                        "print two",
                        6))

let searchesOn =
    Test.Case(name = "C-r again finds the one before it",
              run = fn() =
                  reads(plays(start(["print two", "print one"]),
                              [ctrl('r')] <> keys("print") <> [ctrl('r')]),
                        "print one",
                        0))

let searchShows =
    Test.Case(name = "a search shows its prompt and what it found",
              run = fn() =
                  Test.equal(shows(plays(start(["print two"]), [ctrl('r')] <> keys("two"))),
                             "(reverse-i-search)`two\': print two"))

let searchFails =
    Test.Case(name = "a search that matches nothing says so and keeps the line",
              run = fn() =
                  if String.startsWith(shows(plays(start(["print two"]),
                                                   [ctrl('r')] <> keys("zz"))),
                                       "(failed reverse-i-search)") then
                      Test.Passed
                  else
                      Test.Failed(shows(plays(start(["print two"]), [ctrl('r')] <> keys("zz")))))

let searchAbandoned =
    Test.Case(name = "C-g puts back the line the search began from",
              run = fn() =
                  reads(plays(start(["print two"]),
                              keys("abc") <> [ctrl('r')] <> keys("two") <> [ctrl('g')]),
                        "abc",
                        3))

// Report §11.2 *Editing*: `C-g` puts the cursor back where it stood when
// the search began, as Readline does. A regression test, written after the
// code: the cursor went to the input's end.
let searchAbandonedCursor =
    Test.Case(name = "C-g puts the cursor back where the search began",
              run = fn() =
                  reads(plays(start(["print two"]),
                              keys("abc")
                                  <> [Terminal.ArrowLeft, Terminal.ArrowLeft, ctrl('r')]
                                  <> keys("two")
                                  <> [ctrl('g')]),
                        "abc",
                        1))

let searchAccepted =
    Test.Case(name = "Enter takes the input the search found",
              run = fn() =
                  match plays(start(["print two"]),
                              [ctrl('r')] <> keys("two") <> [Terminal.Key('\r')]) {
                      Submit(Editing(text = "print two", search = None)) -> Test.Passed
                    | other -> Test.Failed(said(other))
                  })

let searchLeft =
    Test.Case(name = "a key the search does not use ends it and then does its work",
              run = fn() =
                  reads(plays(start(["print two"]), [ctrl('r')] <> keys("two") <> [ctrl('a')]),
                        "print two",
                        0))

// Report §11.2: a search reads the inputs as the walk left them.
let searchesKept =
    Test.Case(name = "C-r finds a recalled input as it was left",
              run = fn() =
                  reads(plays(start(["print two"]),
                              [Terminal.ArrowUp]
                                  <> keys(" more")
                                  <> [Terminal.ArrowDown, ctrl('r')]
                                  <> keys("more")),
                        "print two more",
                        10))

// Report §11.2: `C-g` leaves a search for the input it began from, as the
// walk left it.
let searchAbandonedKept =
    Test.Case(name = "C-g puts back a recalled input as it was left",
              run = fn() =
                  reads(plays(start(["print two", "print one"]),
                              [Terminal.ArrowUp]
                                  <> keys("!")
                                  <> [ctrl('r')]
                                  <> keys("one")
                                  <> [ctrl('g')]),
                        "print two!",
                        10))

let joinsHistory =
    Test.Case(name = "the line just taken joins the history",
              run = fn() =
                  Test.equal(next(Editing(..start(["one"]), text = "two")).history, ["two", "one"]))

// Report §11.2: a regression test, written after the code; the session
// kept every input it was given.
let lastThousand = Test.Case(name = "the history keeps the last thousand inputs", run = fn() = {
    let full = List.map(List.range(1, History.kept), Int.toString);
    let history = next(Editing(..start(full), text = "new")).history;
    Test.equal(#(List.size(history), List.get(history, 0)), #(History.kept, Some("new")))
})

let notKept =
    Test.Case(name = "a blank input and one repeated are not kept",
              run = fn() =
                  Test.equal(#(keeps(withLine(start(["one"]), "  ", 0)),
                               keeps(withLine(start(["one"]), "one", 0)),
                               keeps(withLine(start(["one"]), "two", 0))),
                             #(false, false, true)))

//
// Report §11.2: the keys' table and `edit` agree. A key is bound where, on
// one of the editings `editings` gives, its events do other than nothing; in a
// search, other than end it, since any key that is not the search's own
// ends it and then does what it does.
//

// Each run of events of a key of the table is bound.
let listedKeysBound = Test.Case(name = "every key of the table is bound", run = fn() = {
    let unbound = List.filter(listedKeys(), fn(key) = !List.all(key.sends, isBound));
    Test.equal(List.map(unbound, fn(key) = key.name), [])
})

// Each key the test tries that is bound is the table's.
let boundKeysListed = Test.Case(name = "every key the editor binds is in the table", run = fn() = {
    let listed = List.flatMap(listedKeys(), fn(key) = key.sends);
    Test.equal(List.filter(tried(), fn(events) = isBound(events) && !List.contains(listed, events)),
               [])
})

fn listedKeys() : List(Key) =
    List.flatMap(boundKeys(), fn(row) = row.keys)

// The keys the test tries: every control character, `Escape` and then every
// character of ASCII but `[` and `O`, which begin a sequence, the four
// arrows, the interrupt, and every sequence `Escape [` and `Escape O` begin
// that ends in one final character, or in a number up to 99 and `~` (report
// §12.1, the editor's `sequence`).
fn tried() : List(List(Terminal.Event)) = {
    let ascii = List.filterMap(List.range(0, 127), Char.fromCodePoint);
    let controls = List.filter(ascii, fn(char) = char < ' ' || char == '\u{7f}');
    let unbegun = List.filter(ascii, fn(char) = char != '[' && char != 'O');
    let finals = List.filter(ascii, fn(char) = char >= '@' && char <= '~');
    let endings =
        List.map(finals, Char.toString)
            <> List.map(List.range(0, 99), fn(number) = Int.toString(number) <> "~");
    List.map(controls, fn(char) = [Terminal.Key(char)])
        <> List.map(unbegun, fn(char) = escaped(Char.toString(char)))
        <> [[Terminal.ArrowUp],
            [Terminal.ArrowDown],
            [Terminal.ArrowLeft],
            [Terminal.ArrowRight],
            [Terminal.Interrupt]]
        <> List.flatMap(["[", "O"],
                        fn(begun) = List.map(endings, fn(ending) = escaped(begun <> ending)))
}

// Whether the events do other than nothing on one of the editings.
fn isBound(events : List(Terminal.Event)) : Bool =
    List.any(editings(), fn(editing) = changes(editing, events))

// The editings a key is tried on: an empty input, an input of several lines
// with the cursor inside it, a kill held and the history walked back, and a
// search under way. Each has inputs behind it, so that a walk and a search
// can go somewhere.
fn editings() : List(Editing) = {
    let empty = start(["one two", "three"]);
    [empty,
     withLine(empty, "ab cd\nef gh\nij kl", 9),
     editedBy(empty, keys("ab") <> [ctrl('w'), Terminal.ArrowUp]),
     editedBy(empty, [ctrl('r')] <> keys("o"))]
}

// Whether the events change what is edited, or end the input, the record of the
// key before aside, since every key forgets it; a search that only ends is
// no change.
fn changes(editing : Editing, events : List(Terminal.Event)) : Bool =
    match plays(editing, events) {
        Edited(edited) ->
            !List.contains([forgotten(editing), forgotten(stop(editing))], forgotten(edited))
      | _ ->
            true
    }

fn forgotten(editing : Editing) : Editing =
    Editing(..editing, previous = OtherKey)

// The editing the events leave, which the editings above are made by.
fn editedBy(editing : Editing, events : List(Terminal.Event)) : Editing =
    match plays(editing, events) {
        Edited(edited) -> edited
      | _ -> editing
    }

// Every event of a text typed a character at a time.
fn keys(text : String) : List(Terminal.Event) =
    List.map(String.toList(text), Terminal.Key)

// A control key as the terminal sends it: `C-a` is 1 (§12.1).
fn ctrl(letter : Char) : Terminal.Event =
    match Char.fromCodePoint(Char.toCodePoint(letter) - 96) {
        Some(control) -> Terminal.Key(control)
      | None -> fault("a lowercase letter's control character is a code point")
    }

// The events in order, from a fresh line; an event after the line ended
// changes nothing, so the first ending is what a test reads.
fn play(events : List(Terminal.Event)) : Edit =
    plays(fresh(), events)

fn plays(initial : Editing, events : List(Terminal.Event)) : Edit =
    List.foldLeft(events, Edited(initial), fn(edited, event) = match edited {
        Edited(editing) or Matching(editing) -> edit(editing, event)
      | ended -> ended
    })

// Where the cursor stands after the events, from a fresh input, or -1
// where they ended the input.
fn cursorAfter(events : List(Terminal.Event)) : Int =
    match play(events) {
        Edited(editing) -> editing.cursor
      | _ -> -1
    }

fn reads(edited : Edit, text : String, cursor : Int) : Test.Result =
    match edited {
        Edited(editing) -> Test.equal(#(editing.text, editing.cursor), #(text, cursor))
      | other -> Test.Failed(said(other))
    }

// What the reader would show, which is the line or the search's prompt
// and what it found.
fn shows(edited : Edit) : String =
    match edited {
        Edited(editing) -> shown(editing)
      | other -> said(other)
    }

fn said(edited : Edit) : String =
    match edited {
        Edited(Editing(=text)) -> "typing \"" <> text <> "\""
      | Matching(Editing(=text)) -> "closing in \"" <> text <> "\""
      | Completing(_) -> "completing"
      | Documenting(_) -> "documenting"
      | Submit(Editing(=text)) -> "submitted \"" <> text <> "\""
      | Cancel -> "canceled"
      | ClearScreen(_) -> "cleared"
      | Quit -> "left"
    }
