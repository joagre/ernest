/// The shell's colors (report §11.2): color where it carries meaning, at
/// a terminal only, and where the environment's `NO_COLOR` is unset or
/// empty. Each function takes the text and then whether the shell colors,
/// `Markdown.Styled` or `Markdown.Plain` as documentation is rendered, as
/// `Markdown.render` takes them (report Appendix E.0 shape rule 1), and
/// gives the text unchanged when it is `Plain`, so what the shell says
/// reads the same without color; the parameter a signature marks is the
/// one mark that must show, and has asterisks then.

/// A fault, or the first line of a diagnostic: what needs the eye.
export fn fault(text : String, color : Markdown.Output) : String =
    paint(color, Ansi.Foreground(Ansi.Red), text)

/// A diagnostic, its first line colored as a fault, the source under it
/// plain.
export fn diagnostic(text : String, color : Markdown.Output) : String =
    match String.split(text, "\n") {
        [] -> text
      | first :: rest -> String.join(fault(first, color) :: rest, "\n")
    }

/// The type after a printed value, dimmed so that the value stands out.
export fn quiet(text : String, color : Markdown.Output) : String =
    paint(color, Ansi.Dim, text)

/// A name in a listing or a brief, the name bold: `name : type`, a
/// function's declaration `List.map(list : List(a), ...) : List(b)`, or a
/// type's `type Down = ...`. The name is the last word before the first
/// `(`, ` : ` or ` = `, or before a type declaration's end; any other line,
/// a command's, has no name.
export fn named(text : String, color : Markdown.Output) : String = {
    let found = List.filterMap(["(", " : ", " = "], fn(mark) = String.indexOf(text, mark));
    let declared =
        List.any(["type ", "abstract type ", "foreign type "],
                 fn(keyword) = String.startsWith(text, keyword));
    let marks = if declared then String.size(text) :: found else found;
    match List.sort(marks) {
        [] ->
            text
      | end :: _ -> {
            let before = String.slice(text, 0, end);
            let name = Optional.withDefault(List.last(String.words(before)), "");
            let start = end - String.size(name);
            String.slice(text, 0, start) <> paint(color, Ansi.Bold, name) <> String.drop(text, end)
        }
    }
}

/// The parameter at the cursor in a signature, in the terminal's cyan, which
/// its theme chooses, so that it reads on a dark screen and a light one.
/// Report §11.2: without color it is between asterisks, since the mark
/// carries meaning where the other colors only help the eye.
export fn emphasis(text : String, color : Markdown.Output) : String =
    match color {
        Markdown.Plain -> if String.isEmpty(text) then text else "*" <> text <> "*"
      | Markdown.Styled -> paint(color, Ansi.Foreground(Ansi.Cyan), text)
    }

fn paint(color : Markdown.Output, style : Ansi.Style, text : String) : String =
    match color {
        Markdown.Styled -> if String.isEmpty(text) then text else Ansi.styled(text, style)
      | Markdown.Plain -> text
    }

//
// Tests
//

let off =
    Test.Case(name = "without color the text is unchanged",
              run = fn() =
                  Test.equal(#(fault("f faulted", Markdown.Plain),
                               named("a : Int", Markdown.Plain)),
                             #("f faulted", "a : Int")))

let faults =
    Test.Case(name = "a fault is red",
              run = fn() = Test.equal(fault("x", Markdown.Styled), "\u{1b}[31mx\u{1b}[39m"))

let diagnostics =
    Test.Case(name = "a diagnostic's first line is red, its source plain",
              run = fn() =
                  Test.equal(diagnostic("a:1:1: bad\n1 | a", Markdown.Styled),
                             "\u{1b}[31ma:1:1: bad\u{1b}[39m\n1 | a"))

let names =
    Test.Case(name = "a name before its type is bold",
              run = fn() =
                  Test.equal(named("List.map : (a) -> b", Markdown.Styled),
                             "\u{1b}[1mList.map\u{1b}[22m : (a) -> b"))

let marksWithout =
    Test.Case(name = "without color the marked parameter is between asterisks",
              run = fn() = Test.equal(emphasis("f : Int", Markdown.Plain), "*f : Int*"))

let empties =
    Test.Case(name = "an empty text takes no color",
              run = fn() = Test.equal(emphasis("", Markdown.Styled), ""))
