/// The Ernest shell (report §11.2), designed in docs/design/shell.md.
///
/// An input is checked against the session, compiled as a module of its own
/// and run in a process of its own; its value is printed with its type, or
/// what it declared is. The session holds the state, the reader edits the
/// keys, and the screen is the only writer, which the sinks are bound to;
/// the local half holds the terminal and the files on the shell's own node,
/// beside the session in a plain shell, and on the operator's machine in a
/// shell attached to a node, which runs the session, the reader and the
/// screen. Where standard input is not a terminal, or standard output has
/// no size, the shell reads lines instead.

// The front end's values, handles the shell never looks inside (report
// §3.8); the front end's functions are at the foot of the file.
foreign type Session

foreign type Checked

foreign type Value

foreign type Bound

// What running an input came to: what it bound, which the session joins,
// and its value, or the cause of the fault that ended it, its trace, and
// the callee's site or the peer's name where a call or a compute carried
// the cause, each with the input's serial (report §11.2, §6.6, §6.9, §7.3,
// §8.7).
type Outcome =
    Ok(bound : Bound, serial : Int, value : Value)
  | Faulted(cause : String,
            trace : String,
            callee : Optional(String),
            peer : Optional(String),
            serial : Int)

// What the session is told. In a plain shell its local half sends `Begun`
// with what it read; the reader sends `Typed` for an input entered,
// `Interrupted` for `C-c`, and `InputEnded` for `C-d` on an empty line; in
// line mode the local half sends `Line` for each line it reads, `None` at
// the end of input; the input's process sends `Done` as it ends, its
// outcome carrying the input's serial, so that the outcome of one
// `Interrupted` killed is known wherever it arrives; `Process.faults` sends
// `Reported` for every fault, and the front end `Reloaded` for a reload by
// another session of the node, the modules it compiled again and the
// session's number; and the monitors on the reader, the screen and the
// local half `ReaderDied`, `ScreenDied` and `LocalEnded` for their ends.
type ShellMsg =
    Typed(String)
  | InputEnded
  | Interrupted
  | Done(Outcome)
  | Reported(Process.FaultReport)
  | Reloaded(by : Int, modules : List(String))
  | ReaderDied(Down)
  | ScreenDied(Down)
  | Begun(Desk)
  | Line(Optional(String))
  | LocalEnded(Down)

// What the session carries between inputs: the front end's session, the
// settings `:set` changes, which are ordinary values, whether it colors
// what it says, read once at the start, the shell's own processes, whose
// faults are not news, the last hundred faults reported, newest first, the
// file and line of the startup input that runs, which its refusal and its
// fault name, how many things have been entered at the prompt, the serial
// of the last input run, its local half, the address the lines it reads in
// line mode come to, its reader at a terminal, and whether it is attached to
// its node from another (report §11.2).
type State =
    State(session : Session,
          settings : Settings,
          color : Markdown.Output,
          own : Set(Process),
          faults : List(Process.FaultReport),
          startupLine : Optional(#(String, Int)),
          entered : Int,
          serial : Int,
          local : Address(LocalMsg),
          lines : Address(Optional(String)),
          reader : Optional(Address(ReaderMsg)),
          attached : Bool)

// Where an input came from, which its diagnostics and its spawn sites name:
// the prompt, with the count of what was entered there, or a line of a
// startup file and the column the input begins in there, after a command's
// word where it is a command's argument (report §11.2).
type Origin = Prompt(Int) | Startup(file : String, line : Int, column : Int)

type Settings = Settings(depth : Int, length : Int, timing : Bool, rows : Int)

type Next = Continue(State) | Leave

// Report §11.2: the messages the screen takes. The shell's own text is
// `Said`, from the session alone, and `Noted`, from the reader while an
// input is typed and from the session for a fault said while a prompt is
// pending; a running program's is `Wrote`, its bytes as they came, which
// the front end's sinks send the screen's process, as its drain sends it
// `Flush`, so that a drain finds what a sink was given before it.
// `ShowInput` shows the line being typed with the rows under it, from the
// reader, and from the session as it ends; the reader's `Entered` finishes
// the line, and the session's `Taken` says it has taken an input, which may
// have been typed ahead.
//
// The reader sends `Resized` with the terminal's new size and `Clear`,
// `C-l`'s clean screen; the session sends `SetRows`, `:set rows n` and `0`
// at the end, `Redirect`, where `:output` sends what programs write, `None`
// the screen's own place for it, `Locate`, answered with where it goes as
// `:output` says it, `Columns`, answered with the width documentation is
// rendered to, and `Flush`, answered once everything sent before it is
// written.
type ScreenMsg =
    Said(String)
  | Noted(String)
  | Wrote(Bytes)
  | ShowInput(text : String, cursor : Int, offered : List(String))
  | Entered
  | Taken
  | Resized(Terminal.Size)
  | Clear
  | SetRows(Int)
  | Redirect(Optional(Path))
  | Locate(Reply(String))
  | Columns(Reply(Int))
  | Flush(Reply(Unit))

// What the reader is told: a key, which the local half forwards from the
// terminal, and, once, that the first prompt is drawn (report §11.2).
type ReaderMsg = Key(Terminal.Event) | Prompted

// What the reader carries between keys: the line being edited, whether
// the history file still takes what is typed, whether this session has
// said how a multi-line input is run, what the key before did, whether
// the shell colors, its local half, and the terminal's columns, which
// documentation is rendered to the width of (report §11.2).
type Reading =
    Reading(editing : Ernest.Shell.Editor.Editing,
            keeping : Bool,
            hinted : Bool,
            last : LastKey,
            color : Markdown.Output,
            local : Address(LocalMsg),
            columns : Int)

// What the key before this one did, since `Tab` twice lists and
// `Shift-Tab` twice shows the whole page (report §11.2).
type LastKey = Ordinary | Tabbed | Documented

// Report §11.2: what the local half holds and read for its session, on the
// shell's own node: its own address; the terminal's size where the shell
// reads keys, and none in line mode; whether the session colors; the inputs
// of the sessions before this one, from the history file, and whether that
// file takes what is typed; the lines to say of what it read, a startup
// file it did not run or a history it does not keep; the inputs of the
// startup files, each with its file and the line it begins on; the source
// root and the working directory, which are the operator's; and whether
// the session is attached to a node from another.
type Desk =
    Desk(local : Address(LocalMsg),
         size : Optional(Terminal.Size),
         color : Markdown.Output,
         earlier : List(String),
         keeping : Bool,
         notes : List(String),
         startup : List(#(String, Int, String)),
         sourceRoot : String,
         workingDirectory : String,
         attached : Bool)

// Report §11.2: what the local half is told, on the shell's own node. Its
// session sends `Attached` once it has its screen, a call, with the
// session's process, the address the terminal's events go to at a
// terminal, and its screen's process, which what the shell's own node
// writes goes to; the screen sends `Write` for the bytes it writes, with
// the bytes that end what it drew where they leave it, and `Drain`,
// answered once they are written.
//
// The reader sends `Remember` for an input the history appends; the
// session sends `Output` for the path `:output` names, which the local half
// tries and appends to from then on, the screen `Append` for what `:output`
// appends there, and the session in line mode `ReadLine`, answered with
// the next line at the address it gives; the front end asks `Read` and
// `Stat` of a file of the source root, or of a startup file it ran, and
// the reader's completion `ListEntries` of a directory of the source root.
// The terminal sends `Pressed` for each event, and the monitors on the session, on the
// root of an attached session's chain and on the reader of lines
// `SessionEnded`, `EntryEnded` and `LinesEnded`.
type LocalMsg =
    Attached(session : Process,
             keys : Optional(Address(Terminal.Event)),
             screen : Process,
             reply : Reply(Unit))
  | Write(text : String, ending : String)
  | Drain(Reply(Unit))
  | Remember(input : String, reply : Reply(Either(Io.Error, Unit)))
  | Output(path : Path, reply : Reply(Either(Io.Error, Unit)))
  | Append(path : Path, bytes : Bytes, reply : Reply(Either(Io.Error, Unit)))
  | ReadLine(lines : Address(Optional(String)))
  | Read(path : Path, reply : Reply(Either(Io.Error, Bytes)))
  | Stat(path : Path, reply : Reply(Either(Io.Error, Fs.Entry)))
  | ListEntries(path : Path, reply : Reply(Either(Io.Error, List(Fs.Entry))))
  | Pressed(Terminal.Event)
  | SessionEnded(Down)
  | EntryEnded(Down)
  | LinesEnded(Down)

// What the reader of lines is told: read the next line, which goes to the
// address given (report §11.2).
type LinesMsg = NextLine(lines : Address(Optional(String)))

// Where the local half starts its session: beside it, the session having
// spawned it, in a plain shell, or on the listed peer it attaches to
// (report §11.2).
type Attachment = Beside(Address(ShellMsg)) | Attaching(String)

// What the local half serves its session with: the address the terminal's
// events go to, none in line mode, the reader of lines, none at a
// terminal, the peer it attached to, none in a plain shell, and the bytes
// that end what the screen drew where its last write left it; and the
// operator's files it reads and appends for the session, and no other: the
// source root, the startup files it ran, and the path `:output` took, none
// before one does (report §11.2).
type Serving =
    Serving(keys : Optional(Address(Terminal.Event)),
            lines : Optional(Address(LinesMsg)),
            peer : Optional(String),
            ending : String,
            sourceRoot : Path,
            startup : List(Path),
            output : Optional(Path))

// Report §11.2: a value is printed to a depth and a length, and 0 is
// neither. The defaults print what a prompt is used for whole and stop a
// value that would scroll the session away.
let defaults =
    Settings(depth = 10, length = 100, timing = false, rows = Ernest.Shell.Region.defaultRows)

/// The shell: a session beside its local half on this node, at a terminal
/// or reading lines where standard input is not a terminal or standard
/// output has no size (report §11.2). The session is the entry point, and
/// starts once its local half has read what the session needs.
export fn main() : Unit receiving ShellMsg = {
    let shell = self();
    let local = spawn(fn() = localHalf(Beside(shell)));
    monitor(Process.fromAddress(local), LocalEnded);
    receive {
        Begun(desk) -> session(desk)
      | LocalEnded(down) -> faultWithLocal(down)
    }
}

/// The shell attached to a listed peer, `ern shell --config-dir dir --attach
/// name`: on the shell's own node, its local half, which spawns the session
/// on the peer and serves it until it ends (report §11.2).
export fn attach() : Unit receiving LocalMsg =
    match attachTo() {
        Some(name) -> localHalf(Attaching(name))
      | None -> Unit
    }

// What the root of an attached session's chain is told: the session's end
// (report §11.2).
type EntryMsg = SessionDown(Down)

// Report §11.2, §3.11: what an attached shell's spawn starts on the node,
// the root of the session's chain, one of the session's own, which lives
// while the session does, so that the local half's monitor of it, made
// with the spawn, sees the node's loss or its end while the session starts:
// the session, whose mailbox type, which holds the front end's handles,
// crosses to no node, chained to it. A session that leaves detaches as it
// returns; one that ends otherwise, by a fault, detaches here, where its
// end is learned, so that it leaves what an orderly leave leaves.
fn attached(desk : Desk) : Unit receiving EntryMsg = {
    markSelfOwn();
    let started = spawn(fn() = session(desk));
    monitor(Process.fromAddress(started), SessionDown);
    receive {
        SessionDown(down) ->
            match down.reason {
                Returned -> Unit
              | _ -> detach()
            }
    }
}

// Report §11.2: the session, on the node it runs on: its screen and, at a
// terminal, its reader, which its local half's events go to; the greeting
// and what the local half has to say; and then the inputs of the startup
// files, and those typed at the prompt or read as lines.
fn session(desk : Desk) : Unit receiving ShellMsg = {
    let shell = self();
    let Desk(=local, =size, =color, =attached) = desk;
    // report §11.2: the session and its local half monitor each other, and
    // the local half's end is the session's
    monitor(Process.fromAddress(local), LocalEnded);
    let screen = spawn(fn() = match size {
        Some(given) ->
            screenLoop(Ernest.Shell.Region.new(given),
                       Showing(destination = None, =local, cut = <<>>))
      | None ->
            plainLoop(Showing(destination = None, =local, cut = <<>>))
    });
    // report §11.2: a session that cannot be shown is no shell, so the
    // screen's end is the session's
    let screenProcess = Process.fromAddress(screen);
    monitor(screenProcess, ScreenDied);
    let reader = Optional.map(size, fn(given) = startReader(shell, screen, desk, given));
    // report §11.2: the session, the screen and the reader are the shell's
    // own, whose faults are not news, and which `Process.live()` leaves out
    // (Appendix E.21), and so is a plain shell's local half, beside them; an
    // attached shell's is on the shell's own node, whose processes no
    // session of this node's lists
    let readers = match reader {
        Some(given) -> [Process.fromAddress(given)]
      | None -> []
    };
    let beside = if attached then [] else [Process.fromAddress(local)];
    let ownProcesses = [Process.fromAddress(shell), screenProcess] <> beside <> readers;
    markOwn(ownProcesses);
    let state =
        State(session = start(local,
                              screenProcess,
                              desk.sourceRoot,
                              desk.workingDirectory,
                              attached,
                              shell),
              settings = defaults,
              =color,
              own = Set.fromList(ownProcesses),
              faults = [],
              startupLine = None,
              entered = 0,
              serial = 0,
              =local,
              lines = adapted(shell, Line),
              =reader,
              =attached);
    // report §11.2: the local half forwards the terminal's events to the
    // reader, and what its own node writes goes to the screen from now on
    let _ =
        Address.call(local,
                     fn(reply) =
                         Attached(session = Process.fromAddress(shell),
                                  keys = Optional.map(reader, fn(given) = adapted(given, Key)),
                                  screen = screenProcess,
                                  =reply),
                     screenMs);
    let greeting = "Ernest " <> version() <> ", session " <> Int.toString(number(state.session));
    send(screen, Said(greeting <> ". :help for help.\n"));
    // report §11.2: a process that faults is news at the prompt, whichever
    // it is, and the session hears of it as any subscriber does, from
    // before the program's entry point runs
    Process.faults(Reported);
    // report §11.2: the file's entry point is spawned beside the prompt
    if attached then Unit else spawnProgram();
    List.forEach(desk.notes, fn(note) = say(screen, note));
    match reader {
        Some(given) -> {
            // report §11.2: an editor that cannot read keys is no shell,
            // so the reader's death is said and the session ends with it
            monitor(Process.fromAddress(given), ReaderDied);
            match fromFiles(state, screen, desk.startup) {
                Continue(state) -> {
                    prompt(screen);
                    send(given, Prompted);
                    keyLoop(state, screen)
                }
              | Leave ->
                    leave(state, screen, "")
            }
        }
      | None ->
            match fromFiles(state, screen, desk.startup) {
                Continue(state) -> lineLoop(state, screen)
              | Leave -> leave(state, screen, "")
            }
    }
}

// Report §11.2: at a terminal, the reader the local half's events go to,
// which edits the line and sends the session what is entered.
fn startReader(shell : Address(ShellMsg),
               screen : Address(ScreenMsg),
               desk : Desk,
               size : Terminal.Size) : Address(ReaderMsg) =
    spawn(fn() =
              firstPrompt(shell,
                          screen,
                          Reading(editing = Ernest.Shell.Editor.start(desk.earlier),
                                  keeping = desk.keeping,
                                  hinted = false,
                                  last = Ordinary,
                                  color = desk.color,
                                  local = desk.local,
                                  columns = size.columns)))

// Report §11.2: keys and a paste that arrive before the first prompt are
// kept, and read after it as if typed there, so the reader takes none
// until the session has drawn that prompt; they wait in its mailbox in
// the order they came.
fn firstPrompt(shell : Address(ShellMsg),
               screen : Address(ScreenMsg),
               reading : Reading) : Unit receiving ReaderMsg =
    receive {
        Prompted -> readLoop(shell, screen, reading)
    }

// Report §11.2, §11.8: a plain shell's local half is part of it, and its
// end a failure of the shell's own, but for a fault its standard input
// gave it, which ends the shell as that fault (`the shell ends: its
// standard input is not UTF-8`).
fn faultWithLocal(down : Down) : a =
    match down {
        Down(reason = Fault(cause)) -> fault(cause)
      | other -> fault("the shell's local half ended: " <> downLine(other))
    }

// Report §11.2: the local half's end, which an attached session takes as
// it takes `:quit`, and which faults a plain shell (localFault).
fn endWithLocal(state : State, down : Down) : Unit =
    if state.attached then Unit else faultWithLocal(down)

// Report §11.2: the shell colors what it says at a terminal, where the
// environment's `NO_COLOR` is unset or empty, as that convention asks.
let colorAllowed = Optional.withDefault(Os.environment("NO_COLOR"), "") == ""

// Report §11.2: the inputs of the sessions before this one, whether the
// history file takes what is typed, and what to say of it: a history that
// cannot be read is said once, and not written, and so is a `HOME` that
// names no place for it, unset or relative.
fn readHistory() : #(List(String), Bool, List(String)) =
    match Ernest.Shell.History.file {
        None -> {
            let why = match Os.environment("HOME") {
                None -> "HOME is not set"
              | Some(_) -> "HOME is no absolute path"
            };
            #([], false, ["the history is not kept, since " <> why])
        }
      | Some(path) ->
            match Ernest.Shell.History.read() {
                Right(inputs) ->
                    #(inputs, true, [])
              | Left(unkept) ->
                    #([], false, ["the history is not kept, since " <> unkeptReason(unkept, path)])
            }
    }

// Report §11.2: why the history is not kept, its file named where it is
// one the shell does not read and write.
fn unkeptReason(unkept : Ernest.Shell.History.Unkept, path : Path) : String =
    match unkept {
        Ernest.Shell.History.Unreadable(error) ->
            "it could not be read: " <> trouble(error)
      | Ernest.Shell.History.Linked ->
            Path.toString(path) <> " is a link"
      | Ernest.Shell.History.NotOwn ->
            Path.toString(path) <> " is not a regular file of the user's own"
    }

// Report §11.2: where the startup files are, the person's first and then
// the configuration directory's, which runs only where `--config-dir`
// names that directory; a file both paths name runs once. Whether they are
// there, whose they are, and what they hold, is read where they are run.
fn startupFiles() : List(String) =
    match #(Optional.map(Ernest.Shell.History.startup, fromWorkingDirectory), configStartup()) {
        #(Some(own), Some(configured)) ->
            if isSameFile(own, configured) then [own] else [own, configured]
      | #(Some(own), None) ->
            [own]
      | #(None, Some(configured)) ->
            [configured]
      | #(None, None) ->
            []
    }

// Report §11.5: a file is named from the working directory where it lies
// under it, and by its absolute path where it does not.
fn fromWorkingDirectory(path : Path) : String = {
    let directory = Path.split(Os.workingDirectory);
    let segments = Path.split(path);
    if List.take(segments, List.size(directory)) == directory then
        Path.toString(Path.join(List.drop(segments, List.size(directory))))
    else
        Path.toString(path)
}

// Report §11.2: the inputs of a startup file that is the user's own to
// run, and what to say of one that is not: one another user could change
// is said and not run. A path without a directory is a file of the working
// directory.
fn readOwnInputs(file : String) : #(List(#(String, Int, String)), List(String)) = {
    let path = Path(file);
    if isUsersOwn(path) && isUsersOwn(Optional.withDefault(Path.parent(path), Path("."))) then
        readFileInputs(file)
    else
        #([], [file <> " could be changed by another user, and is not run"])
}

// Report §11.2: a startup file, and the directory that holds it, are the
// user's own or the superuser's, whose number is 0, and writable by no one
// but its owner, its group as much as the world. One that is not there has
// nothing to run, and one that cannot be read is said where it is read.
fn isUsersOwn(path : Path) : Bool =
    match Fs.stat(path, fileMs) {
        Right(entry) ->
            (entry.user == Os.user || entry.user == 0) && Int.bitAnd(entry.mode, 0o022) == 0
      | Left(_) ->
            true
    }

// A file that is not there is no error; one that cannot be read is said
// and the session goes on. Each input carries the line it is on.
fn readFileInputs(file : String) : #(List(#(String, Int, String)), List(String)) =
    match Fs.read(Path(file), fileMs) {
        Left(Io.NotFound) ->
            #([], [])
      | Left(error) ->
            #([], [file <> " could not be read: " <> trouble(error)])
      | Right(bytes) ->
            match String.fromUtf8(bytes) {
                Some(text) -> #(startupInputs(file, List.indexed(String.lines(text))), [])
              | None -> #([], [file <> " is not UTF-8, and is not run"])
            }
    }

// Report §11.2: the inputs of a startup file, each with the line it
// begins on, taken as lines typed in line mode are: an input the parser
// cannot finish takes the lines after it, up to a blank one.
fn startupInputs(file : String, lines : List(#(Int, String))) : List(#(String, Int, String)) =
    match lines {
        [] ->
            []
      | #(index, line) :: rest ->
            if String.isEmpty(String.trim(line)) then
                startupInputs(file, rest)
            else {
                let #(input, left) = gathered(line, rest);
                #(file, index + 1, input) :: startupInputs(file, left)
            }
    }

// An input and the lines left after it, the input taking each further line
// while the parser cannot finish it.
fn gathered(input : String, lines : List(#(Int, String))) : #(String, List(#(Int, String))) =
    match lines {
        #(_, line) :: rest ->
            if continues(input) && !String.isEmpty(String.trim(line)) then
                gathered(input <> "\n" <> line, rest)
            else
                #(input, lines)
      | [] ->
            #(input, [])
    }

// How long to wait for the file system, which is a local file.
let fileMs = 5000

// How long to wait for the screen to answer, which has every write sent
// before the call to make first; past it the shell goes on without.
let screenMs = 5000

// How long to wait for the local half to answer for a file: as long as it
// waits for its file system, and a dial beside it, the carrier's longest
// wait to reach the shell's own node (§8.7).
let localMs = fileMs + dialMs()

fn trouble(error : Io.Error) : String =
    match error {
        Io.NotFound -> "the file is not there"
      | Io.Denied -> "permission was denied"
      | Io.Refused -> "the file system refused"
      | Io.Closed -> "the file was closed"
      | Io.Timeout -> "the file system did not answer"
      | Io.NotATerminal -> "standard input is not a terminal"
      | Io.NotAFile -> "the path names something that is not a file"
      | Io.Exists -> "the file exists already"
      | Io.NotUtf8(_) -> "the file is not UTF-8"
      | Io.Invalid -> "the path is not one the host can take"
      | Io.NotListed -> "no peer is listed for it"
      | Io.Unreachable -> "the peer could not be reached"
      | Io.NotOffered -> "the peer offers nothing under the name"
      | Io.OtherType -> "the peer offers it at another type"
      | Io.NotLoaded -> "the peer lacks a binding's value or a module the function calls"
      | Io.Other(text) -> text
    }

// Report §11.2: where a program's output goes. A path is a terminal or a
// file of the shell's own node, which an append of nothing tries there,
// creating a file that is not there; `-` is the screen's own place for it
// again, the live region or, in line mode, standard output, and nothing
// says where it goes now, which the screen holds.
fn redirectOutput(local : Address(LocalMsg),
                  screen : Address(ScreenMsg),
                  argument : String) : Either(String, String) =
    if String.isEmpty(argument) then
        locate(screen)
    else if argument == "-" then {
        send(screen, Redirect(None));
        locate(screen)
    } else {
        let path = Path(argument);
        match tryOutput(local, path) {
            Left(error) ->
                Left(cannotWrite(path, error))
          | Right(_) -> {
                send(screen, Redirect(Some(path)));
                Right("output goes to " <> argument)
            }
        }
    }

// Where the screen says what programs write goes.
fn locate(screen : Address(ScreenMsg)) : Either(String, String) =
    match Address.call(screen, Locate, screenMs) {
        Some(place) -> Right("output goes to " <> place)
      | None -> Left("the screen did not say where output goes")
    }

// Report §11.2: the path `:output` names, tried by the local half with an
// append of nothing to a file of the shell's own node, as `Fs.append`
// answers there, the one path it appends what programs write to from then
// on, or `Timeout` where no answer comes.
fn tryOutput(local : Address(LocalMsg), path : Path) : Either(Io.Error, Unit) =
    Optional.withDefault(Address.call(local, fn(reply) = Output(=path, =reply), localMs),
                         Left(Io.Timeout))

// Report §11.2: what the local half appends to the path `:output` took, as
// `Fs.append` answers there, or `Timeout` where no answer comes.
fn appendThere(local : Address(LocalMsg), path : Path, bytes : Bytes) : Either(Io.Error, Unit) =
    Optional.withDefault(Address.call(local, fn(reply) = Append(=path, =bytes, =reply), localMs),
                         Left(Io.Timeout))

// Report §11.2: a path that names no terminal, other device or file, a
// named pipe among them, is refused, as the file system refuses it (Appendix E.17);
// a file that is not there is created, so one not found is its directory.
fn cannotWrite(path : Path, error : Io.Error) : String = {
    let why = match error {
        Io.NotAFile -> "it is neither a device nor a file"
      | Io.NotFound -> "its directory is not there"
      | _ -> trouble(error)
    };
    "cannot write to " <> Path.toString(path) <> ": " <> why
}

// Report §11.2: a startup input runs as a typed one, a command among them,
// and a `:quit` there ends the session; a diagnostic names its file and
// line.
fn fromFiles(state : State,
             screen : Address(ScreenMsg),
             inputs : List(#(String, Int, String))) : Next receiving ShellMsg =
    match inputs {
        [] ->
            Continue(state)
      | #(file, line, input) :: rest -> {
            let state = State(..state, startupLine = Some(#(file, line)));
            if String.startsWith(input, ":") then match perform(state, screen, input) {
                Continue(state) -> fromFiles(State(..state, startupLine = None), screen, rest)
              | Leave -> Leave
            } else match executeQuietly(state, screen, file, line, input) {
                Continue(state) -> fromFiles(State(..state, startupLine = None), screen, rest)
              | Leave -> Leave
            }
        }
    }

// Report §11.2: an input from a startup file is checked and run as a typed
// one, and its value is not printed; what fails is reported with the file
// it came from.
fn executeQuietly(state : State,
                  screen : Address(ScreenMsg),
                  file : String,
                  line : Int,
                  input : String) : Next receiving ShellMsg =
    execute(state, screen, Startup(=file, =line, column = 1), input, false)

fn execute(state : State,
           screen : Address(ScreenMsg),
           origin : Origin,
           input : String,
           printing : Bool) : Next receiving ShellMsg =
    match check(state.session, origin, input) {
        Left(text) -> {
            diagnose(screen, state.color, text);
            Continue(state)
        }
      | Right(#(session, checked)) -> {
            // report §11.2: the run is what timing measures, not the check
            let started = Clock.monotonic();
            let serial = state.serial + 1;
            let inputProcess = spawnInput(session, checked, serial, adapted(self(), Done));
            await(State(..state, =session, =serial),
                  screen,
                  checked,
                  inputProcess,
                  started,
                  printing)
        }
    }

// The reader stays live, so an interruption reaches the session while the
// input runs and kills it, and an input typed meanwhile waits in the
// mailbox for this one to end (report §11.2). The reader's end kills the
// input, which no key can interrupt any more, and ends the session.
fn await(state : State,
         screen : Address(ScreenMsg),
         checked : Checked,
         inputProcess : Address(Never),
         started : Int,
         printing : Bool) : Next receiving ShellMsg = {
    let current = state.serial;
    receive {
        Done(Ok(=bound, =serial, =value)) when serial == current -> {
            // report §11.2: what the input bound is bound and joins the
            // session, and what nothing reaches is let go, here, in the
            // session's process, once the input has answered, and before
            // the answer is said, so that what is said is the session's
            // as completion reads it
            let session = collect(state.session, Some(#(bound, value)));
            if printing then {
                printResult(state, screen, checked, value);
                sayTime(screen, state.settings, started)
            } else
                Unit;
            sayAndLetGo(screen);
            Continue(State(..state, =session))
        }
      | Done(Faulted(=cause, =trace, =callee, =peer, =serial)) when serial == current -> {
            sayFault(state, screen, causeLine(cause, callee, peer), trace);
            if printing then sayTime(screen, state.settings, started) else Unit;
            // report §11.2: the input's unit, which holds nothing, is let go
            let session = collect(state.session, None);
            sayAndLetGo(screen);
            Continue(State(..state, =session))
        }
      // the outcome of an input `Interrupted` killed, which came after the
      // next was taken
      | Done(_) ->
            await(state, screen, checked, inputProcess, started, printing)
      | Interrupted -> {
            kill(Process.fromAddress(inputProcess));
            say(screen, "Killed");
            Continue(state)
        }
      | ReaderDied(down) -> {
            kill(Process.fromAddress(inputProcess));
            send(screen, Said(readerEnd(state.color, down)));
            Leave
        }
      | ScreenDied(down) ->
            endWithScreen(down)
      // report §11.2: the local half's end ends the session, the input
      // that runs among what ends
      | LocalEnded(down) -> {
            kill(Process.fromAddress(inputProcess));
            endWithLocal(state, down);
            Leave
        }
      // report §11.2: an input's own fault is its answer; the input catches
      // what it raises, so a report of its process is a fault a signal
      // brought, after which no `Done` comes
      | Reported(report) ->
            if report.process == Process.fromAddress(inputProcess) then {
                sayFault(state,
                         screen,
                         causeLine(report.cause, report.callee, report.peer),
                         report.trace);
                if printing then sayTime(screen, state.settings, started) else Unit;
                Continue(state)
            } else
                await(reportFault(state, screen, report, saidLine),
                      screen,
                      checked,
                      inputProcess,
                      started,
                      printing)
        // an input typed meanwhile is left in the mailbox: it waits for
        // this one, and runs after it, as a reload by another session waits
        // to be said at the next prompt; `C-d` on an empty line ends the
        // reader, whose end above kills this input and ends the shell, as
        // `:quit` ends it (report §11.2)
    }
}

// Report §11.2: an input's own fault is its answer, `fault:` and its cause
// as `causeLine` writes it, and beneath them its trace, as `ern run` prints
// a fault's (§7.3).
fn sayFault(state : State, screen : Address(ScreenMsg), cause : String, trace : String) : Unit =
    say(screen,
        Ernest.Shell.Style.fault(placed(state, "fault: " <> cause) <> indentedTrace(trace),
                                 state.color))

// Report §11.2: what an input declared, a line each in the order it was
// written, or else its value with its type, an expression's and the `Left`
// or the `None` of a `let` with `<-`, each bound to `it`. A value of type
// `Unit` prints nothing, and `it` is left as it was when the input did not
// settle its type.
fn printResult(state : State,
               screen : Address(ScreenMsg),
               checked : Checked,
               value : Value) : Unit =
    match declared(checked, value) {
        None ->
            if isUnit(checked) then
                Unit
            else {
                let shown = show(value, state.settings.depth, state.settings.length);
                say(screen,
                    shown <> Ernest.Shell.Style.quiet(" : " <> typeText(checked), state.color));
                if leavesItUnchanged(checked) then
                    say(screen,
                        "`it` is unchanged: this input did not determine the type of its value")
                else
                    Unit
            }
      | Some(lines) ->
            printLines(screen, lines)
    }

// Report §11.2 *Inputs*: what each input's process that a collection set
// to go owned, said by its site, a line each, and then those processes let
// go: each is asked while it lives, since what it owned ends with it.
fn sayAndLetGo(screen : Address(ScreenMsg)) : Unit = {
    printLines(screen, List.flatMap(going(), fn(#(binder, names)) = endedLines(binder, names)));
    letGo()
}

// Report §11.2 *Inputs*, Appendix E.21, G.1: a line for each listener,
// socket, running program, table and process started to end with it that
// the binder owns, by its site, `Tcp.listen ended with l`, and a table by
// `Ets.new`.
fn endedLines(binder : Process, names : List(String)) : List(String) = {
    let ended = " ended with " <> String.join(names, ", ");
    List.filterMap(Process.owned(binder),
                   fn(process) =
                       Optional.map(Process.status(process), fn(status) = status.site <> ended))
        <> List.repeat("Ets.new" <> ended, Ets.owned(binder))
}

// Report §11.2: with timing on, a result is followed by the time the input
// took.
fn sayTime(screen : Address(ScreenMsg), settings : Settings, started : Int) : Unit =
    if settings.timing then
        say(screen, "(" <> Int.toString(Clock.monotonic() - started) <> " ms)")
    else
        Unit

fn keyLoop(state : State, screen : Address(ScreenMsg)) : Unit receiving ShellMsg =
    receive {
        Typed(line) -> {
            send(screen, Taken);
            taking(state, screen, line)
        }
      | InputEnded ->
            leave(state, screen, "\n")
      | Interrupted -> {
            prompt(screen);
            keyLoop(state, screen)
        }
      // report §11.2: a prompt is pending, and a fault said there stands
      // above the region, leaving the line being typed where it is, as a
      // reload by another session does
      | Reported(report) ->
            keyLoop(reportFault(state, screen, report, Noted), screen)
      | Reloaded(=by, =modules) ->
            keyLoop(sayReload(state, screen, by, modules, Noted), screen)
      | ReaderDied(down) ->
            leave(state, screen, readerEnd(state.color, down))
      | ScreenDied(down) ->
            endWithScreen(down)
      | LocalEnded(down) -> {
            endWithLocal(state, down);
            leave(state, screen, "")
        }
      // the end of a run that `Interrupted` killed, which `await` no longer
      // waits for
      | Done(_) ->
            keyLoop(state, screen)
    }

// Report §11.2: an input, which may have been typed while the one before it
// ran and so waited for it.
fn taking(state : State, screen : Address(ScreenMsg), line : String) : Unit receiving ShellMsg =
    match String.trim(line) {
        "" -> {
            prompt(screen);
            keyLoop(state, screen)
        }
      | input ->
            match submit(state, screen, input) {
                Leave ->
                    leave(state, screen, "")
              | Continue(state) -> {
                    prompt(screen);
                    keyLoop(state, screen)
                }
            }
    }

// Report §11.2: an input is a command or Ernest, and what is entered at
// the prompt is counted, either, so that a typed input is named by its
// count.
fn submit(state : State, screen : Address(ScreenMsg), input : String) : Next receiving ShellMsg = {
    let counted = State(..state, entered = state.entered + 1);
    if String.startsWith(input, ":") then
        perform(counted, screen, input)
    else
        evaluate(counted, screen, input)
}

// One input, from the reader or a line: checked, run in a process of its own, its
// value printed with its type. An expression of type Unit prints nothing.
fn evaluate(state : State, screen : Address(ScreenMsg), input : String) : Next receiving ShellMsg =
    execute(state, screen, Prompt(state.entered), input, true)

// Report §11.2: what the session says as the reader's end ends it: nothing
// where it returned, and its fault where it did not.
fn readerEnd(color : Markdown.Output, down : Down) : String =
    match down {
        Down(reason = Returned) ->
            ""
      | other -> {
            let text = "the shell stopped reading the keyboard: " <> downLine(other);
            Ernest.Shell.Style.fault(text, color) <> "\n"
        }
    }

// Report §11.2, §11.8: the screen's end leaves the session nothing to show
// itself on, so it faults, a failure of the shell's own.
fn endWithScreen(down : Down) : a =
    fault("the shell's screen ended: " <> downLine(down))

// Report §11.2: a process that faults is reported with its spawn site and
// cause, and its trace beneath them, as `ern run` reports it, and kept for
// `:faults`, unless it is one of the shell's own; one `Test.faults` started
// is told of to no one (report Appendix E.24). The report goes to the
// screen wrapped as the caller says: `Said` where the session says it,
// `Noted` where a prompt is pending.
fn reportFault(state : State,
               screen : Address(ScreenMsg),
               report : Process.FaultReport,
               wrap : (String) -> ScreenMsg) : State =
    if Set.contains(state.own, report.process) then
        state
    else {
        let text = reportLine(report) <> indentedTrace(report.trace);
        send(screen, wrap(Ernest.Shell.Style.fault(text, state.color)));
        State(..state, faults = List.take(report :: state.faults, keptFaults))
    }

// Report §11.2 *The attached shell*: a reload by another session, said at
// the prompt as a fault is, wrapped as the caller says: a line for each
// module it compiled again, `Counter compiled again by session 3`, and each
// of this session's bindings it moved to a previous version named as the
// session's own reload names it; the session takes the node's modules as
// they stand (`reloadedBy`). One that comes while an input runs waits in
// the mailbox for the prompt.
fn sayReload(state : State,
             screen : Address(ScreenMsg),
             by : Int,
             modules : List(String),
             wrap : (String) -> ScreenMsg) : State = {
    let #(session, lines) = reloadedBy(state.session, by, modules);
    send(screen, wrap(String.join(lines, "\n")));
    State(..state, =session)
}

// A line the session says, ended.
fn saidLine(line : String) : ScreenMsg =
    Said(line <> "\n")

// Report §11.2, Appendix E.21: a fault's line as `:faults` lists it, the
// time the fault was met first, as `ern run` stamps a line.
fn stampedLine(report : Process.FaultReport, color : Markdown.Output) : String =
    Ernest.Shell.Style.fault(Clock.toString(report.time) <> " " <> reportLine(report), color)

// Report §11.2: `:faults` lists the last hundred.
let keptFaults = 100

// A fault's line: the spawn site and the cause, as `ern run` writes them,
// the site written through `escaped`, a peer's site among it, the cause as
// `causeLine` writes it, and after it the peer whose spawn started the
// process, which a peer the configuration no longer lists leaves out
// (report §11.2, §8.7).
fn reportLine(report : Process.FaultReport) : String = {
    let phrase = if report.restarted then " faulted, restarted: " else " faulted: ";
    let spawner = clause(", spawned by the peer ", report.spawnedBy);
    escaped(report.site) <> phrase <> causeLine(report.cause, report.callee, report.peer) <> spawner
}

// Report §11.2, §6.6, §8.7: a fault's cause as its line writes it, through
// `escaped`, and after it the callee's site, escaped too, where a call
// carried the cause from its callee, and the peer where a compute carried
// it from the peer.
fn causeLine(cause : String, callee : Optional(String), peer : Optional(String)) : String =
    escaped(cause)
        <> clause(", the fault of the callee ", Optional.map(callee, escaped))
        <> clause(", on the peer ", peer)

// A clause of a fault's line, its words and what it names, or nothing
// where it names nothing.
fn clause(words : String, name : Optional(String)) : String =
    match name {
        Some(named) -> words <> named
      | None -> ""
    }

// Report §7.3, Appendix E.21: a fault's trace as it stands beneath the
// fault's line, a frame a line, each indented by four spaces.
fn indentedTrace(trace : String) : String =
    String.join(List.map(String.lines(trace), fn(frame) = "\n    " <> escaped(frame)), "")

// A `Down`'s line: the site and the cause of a fault, or the site that
// ended.
fn downLine(down : Down) : String =
    match down {
        Down(reason = Fault(cause), =site) -> site <> " faulted: " <> escaped(cause)
      | Down(reason = _, =site) -> site <> " ended"
    }

// Report §11.2: a cause as `ern run` writes it, each control character as
// the escape a literal writes for it, so that a fault's line, and each frame
// of its trace, is one line, and none of a program's reaches the terminal
// as itself.
fn escaped(text : String) : String =
    String.join(List.map(String.toList(text), escapedChar), "")

fn escapedChar(char : Char) : String =
    match Char.toCodePoint(char) {
        10 ->
            "\\n"
      | 9 ->
            "\\t"
      | 13 ->
            "\\r"
      | code ->
            if code < 32 || code >= 127 && code <= 159 then
                "\\u{" <> Optional.withDefault(Int.toStringBase(code, 16), "") <> "}"
            else
                Char.toString(char)
    }

// A diagnostic, its first line colored as a fault (report §11.2).
fn diagnose(screen : Address(ScreenMsg), color : Markdown.Output, text : String) : Unit =
    send(screen, Said(Ernest.Shell.Style.diagnostic(text, color) <> "\n"))

fn say(screen : Address(ScreenMsg), text : String) : Unit =
    send(screen, Said(text <> "\n"))

// Report §11.2: what the shell refuses is red, as a diagnostic's first
// line is, and what it answers is plain.
fn refuse(state : State, screen : Address(ScreenMsg), text : String) : Unit =
    say(screen, Ernest.Shell.Style.fault(placed(state, text), state.color))

// Report §11.2: where the input being run came from, which its diagnostics
// name: a line of a startup file, the input beginning in that column, or
// the prompt.
fn origin(state : State, column : Int) : Origin =
    match state.startupLine {
        Some(#(file, line)) -> Startup(=file, =line, =column)
      | None -> Prompt(state.entered)
    }

// Report §11.2: what a startup input refuses or faults with is named by its
// file and line, as its diagnostic is.
fn placed(state : State, text : String) : String =
    match state.startupLine {
        Some(#(file, line)) -> file <> ":" <> Int.toString(line) <> ": " <> text
      | None -> text
    }

// Lines the session says, in one message, and nothing for none.
fn printLines(screen : Address(ScreenMsg), lines : List(String)) : Unit =
    if List.isEmpty(lines) then Unit else send(screen, Said(String.join(lines, "\n") <> "\n"))

//
// Commands (report §11.2)
//

// A command is `:` and a name, and is not an Ernest function; the
// commands are `Ernest.Shell.Command`'s table, and the session carries out the
// action a command line selects.

// Report §11.2: a refusal names what was typed, each control character
// written as its escape, as a fault's cause is.
fn perform(state : State, screen : Address(ScreenMsg), input : String) : Next =
    match Ernest.Shell.Command.parse(input) {
        Left(text) -> refuseCommand(state, screen, escaped(text))
      | Right(#(action, argument)) -> obey(state, screen, action, argument, argumentColumn(input))
    }

// The column on its line where a command's argument begins, after the
// command's word and the spaces after it.
fn argumentColumn(input : String) : Int = {
    let end = Ernest.Shell.Command.wordEnd(input);
    let rest = String.drop(input, end);
    end + String.size(rest) - String.size(String.trimStart(rest)) + 1
}

// Report §11.2: a command carries out its action and answers, or refuses
// and leaves the session as it was.
fn obey(state : State,
        screen : Address(ScreenMsg),
        action : Ernest.Shell.Command.Action,
        argument : String,
        column : Int) : Next = {
    let State(=session, =color) = state;
    match action {
        // report §11.2: `:quit` leaves every shell, an attached one's node
        // running on
        Ernest.Shell.Command.Quit ->
            Leave
      | Ernest.Shell.Command.Help ->
            answerCommand(state, screen, Ernest.Shell.Command.help())
      | Ernest.Shell.Command.Bindings ->
            match bindings(session) {
                [] -> answerCommand(state, screen, ["the session declares nothing yet"])
              | lines -> answerCommand(state, screen, lines)
            }
      | Ernest.Shell.Command.Type ->
            match declaredType(session, argument) {
                Some(text) -> answerCommand(state, screen, [argument <> " : " <> text])
              | None -> typeOf(state, screen, argument, column)
            }
      | Ernest.Shell.Command.Forget ->
            match forget(session, argument) {
                Left(text) ->
                    refuseCommand(state, screen, text)
              | Right(session) -> {
                    sayAndLetGo(screen);
                    Continue(State(..state, =session))
                }
            }
      | Ernest.Shell.Command.Browse ->
            match browse(session, argument) {
                Left(text) -> refuseCommand(state, screen, text)
              | Right(lines) -> answerCommand(state, screen, lines)
            }
      | Ernest.Shell.Command.Doc ->
            match doc(session, argument) {
                Left(text) ->
                    refuseCommand(state, screen, text)
              | Right(text) ->
                    answerCommand(state, screen, rendered(text, columnsOf(screen), color))
            }
      | Ernest.Shell.Command.Output ->
            match redirectOutput(state.local, screen, argument) {
                Left(text) -> refuseCommand(state, screen, text)
              | Right(text) -> answerCommand(state, screen, [text])
            }
      | Ernest.Shell.Command.Settings ->
            Continue(State(..state, settings = set(state, screen, argument)))
      | Ernest.Shell.Command.Processes ->
            match sessionProcesses() {
                [] -> answerCommand(state, screen, ["no process of the session's is running"])
              | sites -> answerCommand(state, screen, sites)
            }
      // report §11.2: `:faults` lists each fault's line, its time first as
      // `ern run` stamps a line, without its trace
      | Ernest.Shell.Command.Faults ->
            match List.reverse(state.faults) {
                [] ->
                    answerCommand(state, screen, ["no process has faulted"])
              | reports ->
                    answerCommand(state,
                                  screen,
                                  List.map(reports, fn(report) = stampedLine(report, color)))
            }
      | Ernest.Shell.Command.Load ->
            match load(session, argument) {
                Left(text) -> diagnoseCommand(state, screen, placed(state, text))
              | Right(#(session, line)) -> answerCommand(State(..state, =session), screen, [line])
            }
      | Ernest.Shell.Command.Reload ->
            match reload(session) {
                Left(text) -> diagnoseCommand(state, screen, placed(state, text))
              | Right(#(session, lines)) -> answerCommand(State(..state, =session), screen, lines)
            }
    }
}

// Report §11.2: `:type` of an expression that is not one name, checked
// as an input is and not run.
fn typeOf(state : State, screen : Address(ScreenMsg), argument : String, column : Int) : Next =
    match checkType(state.session, origin(state, column), argument) {
        Left(text) ->
            diagnoseCommand(state, screen, text)
      | Right(#(session, checked)) ->
            if isExpression(checked) then
                answerCommand(State(..state, =session),
                              screen,
                              [argument <> " : " <> typeText(checked)])
            else
                // report §11.2: `:type` takes an expression
                refuseCommand(state,
                              screen,
                              ":type takes an expression, and a `let` or a declaration is not one")
    }

// What a command answers, a line each, and the session after it.
fn answerCommand(state : State, screen : Address(ScreenMsg), lines : List(String)) : Next = {
    printLines(screen, lines);
    Continue(state)
}

// Report §11.2: a command refused leaves the session as it was.
fn refuseCommand(state : State, screen : Address(ScreenMsg), text : String) : Next = {
    refuse(state, screen, text);
    Continue(state)
}

// Report §11.2: so does a command whose input or module does not compile.
fn diagnoseCommand(state : State, screen : Address(ScreenMsg), text : String) : Next = {
    diagnose(screen, state.color, text);
    Continue(state)
}

// Report §11.2: a page of documentation rendered for the terminal, at its
// width, or at 80 columns where there is no terminal.
fn rendered(text : String, width : Int, color : Markdown.Output) : List(String) =
    Markdown.render(Markdown.parse(text), width, color)

// Report §11.2: the terminal's columns, as the screen holds them, or 80
// where there is no terminal.
fn columnsOf(screen : Address(ScreenMsg)) : Int =
    Optional.withDefault(Address.call(screen, Columns, screenMs), 80)

// Report §11.2: the live processes by spawn site, each with its activity and
// memory beside its site, as `Process.status` answers them: what
// `Process.live()` lists at the prompt, which leaves every session's own out,
// those its loads evaluated bindings in among them.
fn sessionProcesses() : List(String) = {
    let statuses = List.filterMap(Process.live(), Process.status);
    let ordered =
        List.sortBy(statuses,
                    fn(status) = #(status.site, activity(status.activity), status.memory));
    List.map(ordered, processLine)
}

fn processLine(status : Process.Status) : String = {
    let memory = Int.toString(status.memory) <> " bytes";
    String.join([status.site, activity(status.activity), memory], " ")
}

fn activity(activity : Process.Activity) : String =
    match activity {
        Process.Running -> "running"
      | Process.Receiving -> "receiving"
      | Process.Calling -> "calling"
    }

// Report §11.2: the depth and the length a value is printed to, the rows
// of the live region, and whether a result is followed by the time its run
// took.
fn set(state : State, screen : Address(ScreenMsg), argument : String) : Settings = {
    let settings = state.settings;
    if String.isEmpty(argument) then {
        printLines(screen, settingLines(settings));
        settings
    } else match Ernest.Shell.Command.setting(argument) {
        Left(text) -> {
            refuse(state, screen, text);
            settings
        }
      | Right(Ernest.Shell.Command.Depth(depth)) ->
            Settings(..settings, =depth)
      | Right(Ernest.Shell.Command.Length(length)) ->
            Settings(..settings, =length)
      | Right(Ernest.Shell.Command.Rows(rows)) -> {
            send(screen, SetRows(rows));
            Settings(..settings, =rows)
        }
      | Right(Ernest.Shell.Command.Timing(timing)) ->
            Settings(..settings, =timing)
    }
}

fn settingLines(settings : Settings) : List(String) =
    ["depth " <> Int.toString(settings.depth),
     "length " <> Int.toString(settings.length),
     "rows " <> Int.toString(settings.rows),
     "timing " <> (if settings.timing then "on" else "off")]

//
// The screen: the only process that writes to the terminal
//

// Report §11.2: a line the shell has finished with is committed, written
// into the terminal and never touched again, so that the scrollback, the
// search and the selection stay the terminal's own. The last rows are
// live: the tail of what programs have written, and the line being typed
// under it. Nothing is ever written below the live region, which is what
// makes `erase` correct.
//
// The shell never addresses a row. It did not clear the screen and does
// not know where on it the region sits: it moves up from the line being
// typed to the region's first row, erases to the end of the screen, and
// paints again. With no terminal there is no region at all and the text
// is written as it arrives.

// What the screen carries between messages beside its region: where
// `:output` sent what programs write, since it is what appends there, its
// local half, which writes its bytes on the shell's own node, and the
// bytes of a character the last write of a program's cut, which wait for
// the next, one cut to a screen whichever stream wrote, and go with the
// screen (report §11.2).
type Showing = Showing(destination : Optional(Path), local : Address(LocalMsg), cut : Bytes)

// The screen process holds the region of `Ernest.Shell.Region` and writes what
// it answers; the region itself is pure and draws nothing.
fn screenLoop(region : Ernest.Shell.Region.Region, showing : Showing) : Unit receiving ScreenMsg =
    receive {
        Said(text) ->
            paint(Ernest.Shell.Region.said(region, text), showing)
      | Noted(text) ->
            paint(Ernest.Shell.Region.noted(region, text), showing)
      | Wrote(bytes) -> {
            let #(text, cut) = String.fromUtf8Piece(showing.cut <> bytes);
            let showing = Showing(..showing, =cut);
            match showing.destination {
                None ->
                    paint(Ernest.Shell.Region.wrote(region, text), showing)
              | Some(path) ->
                    match appendOutput(showing.local, path, text, "the live region") {
                        Right(_) ->
                            screenLoop(region, showing)
                      | Left(why) -> {
                            let #(region, said) = Ernest.Shell.Region.said(region, why);
                            send(showing.local,
                                 Write(text = said, ending = Ernest.Shell.Region.ending(region)));
                            paint(Ernest.Shell.Region.wrote(region, text),
                                  Showing(..showing, destination = None))
                        }
                    }
            }
        }
      | ShowInput(=text, =cursor, =offered) ->
            paint(Ernest.Shell.Region.edited(region, text, cursor, offered), showing)
      | Entered ->
            paint(Ernest.Shell.Region.entered(region), showing)
      | Taken ->
            paint(Ernest.Shell.Region.taken(region), showing)
      // the size the event carries, the terminal's on the shell's own node
      | Resized(size) ->
            paint(Ernest.Shell.Region.resized(region, size), showing)
      | Clear ->
            paint(Ernest.Shell.Region.cleared(region), showing)
      | SetRows(rows) ->
            paint(Ernest.Shell.Region.rowsSized(region, rows), showing)
      | Redirect(destination) ->
            screenLoop(region, Showing(..showing, =destination))
      | Locate(reply) -> {
            answer(reply, place(showing.destination, "the live region"));
            screenLoop(region, showing)
        }
      | Columns(reply) -> {
            answer(reply, Ernest.Shell.Region.columns(region));
            screenLoop(region, showing)
        }
      | Flush(reply) -> {
            drainLocal(showing.local);
            answer(reply, Unit);
            screenLoop(region, showing)
        }
    }

// What the region answered written, by the local half, with what ends the
// region where it stands, and the screen goes on with the region it
// became.
fn paint(drawn : #(Ernest.Shell.Region.Region, String),
         showing : Showing) : Unit receiving ScreenMsg = {
    let #(region, bytes) = drawn;
    send(showing.local, Write(text = bytes, ending = Ernest.Shell.Region.ending(region)));
    screenLoop(region, showing)
}

// Report §11.2: once the local half has written everything the screen
// sent it before, or `screenMs` has passed.
fn drainLocal(local : Address(LocalMsg)) : Unit = {
    let _ = Address.call(local, Drain, screenMs);
    Unit
}

// Report §11.2: without a terminal there is no region, and what the screen
// is sent is written as it comes, a note on a line of its own.
fn plainLoop(showing : Showing) : Unit receiving ScreenMsg = {
    let showing = receive {
        Said(text) -> {
            writeLine(showing.local, text);
            showing
        }
      | Wrote(bytes) -> {
            let #(text, cut) = String.fromUtf8Piece(showing.cut <> bytes);
            match showing.destination {
                None -> {
                    writeLine(showing.local, text);
                    Showing(..showing, =cut)
                }
              | Some(path) ->
                    match appendOutput(showing.local, path, text, "standard output") {
                        Right(_) ->
                            Showing(..showing, =cut)
                      | Left(why) -> {
                            writeLine(showing.local, why <> text);
                            Showing(..showing, destination = None, =cut)
                        }
                    }
            }
        }
      | Noted(text) -> {
            writeLine(showing.local, text <> "\n");
            showing
        }
      | Redirect(destination) ->
            Showing(..showing, =destination)
      | Locate(reply) -> {
            answer(reply, place(showing.destination, "standard output"));
            showing
        }
      // report §11.2: documentation is rendered at 80 columns where there
      // is no terminal
      | Columns(reply) -> {
            answer(reply, 80);
            showing
        }
      | Flush(reply) -> {
            drainLocal(showing.local);
            answer(reply, Unit);
            showing
        }
      | ShowInput(text = _, cursor = _, offered = _) ->
            showing
      | Entered ->
            showing
      | Taken ->
            showing
      | Resized(_) ->
            showing
      | Clear ->
            showing
      | SetRows(_) ->
            showing
    };
    plainLoop(showing)
}

// Report §11.2: text written in line mode, by the local half, with what
// ends it where it leaves the line: a line feed after a line it leaves
// unended, a prompt among them, and nothing after one it ends. Nothing is
// sent of no text, which leaves the line as it was.
fn writeLine(local : Address(LocalMsg), text : String) : Unit =
    if String.isEmpty(text) then
        Unit
    else
        send(local, Write(=text, ending = if String.endsWith(text, "\n") then "" else "\n"))

// Report §11.2: what a program wrote, appended where `:output` sent it, on
// the shell's own node; where that fails, why, and what programs write goes
// back to the screen's own place for it, `screenPlace`.
fn appendOutput(local : Address(LocalMsg),
                path : Path,
                text : String,
                screenPlace : String) : Either(String, Unit) =
    match appendThere(local, path, String.toUtf8(text)) {
        Right(_) ->
            Right(Unit)
      | Left(error) ->
            Left(cannotWrite(path, error) <> ", and output goes to " <> screenPlace <> "\n")
    }

// Report §11.2: where what programs write goes, as `:output` says it: the
// path `:output` named, or the screen's own place for it, `screenPlace`,
// the live region at a terminal and standard output in line mode.
fn place(destination : Optional(Path), screenPlace : String) : String =
    match destination {
        Some(path) -> Path.toString(path)
      | None -> screenPlace
    }

// Report §11.2: the shell ends by `:quit`, by `C-d`, at the end of its
// input, or where its reader or its local half stops, and before it ends
// it writes every fault reported to it until then, a prompt pending. In a
// plain shell a process that still runs ends with the program, which is no
// fault; an attached session leaves its node running (detachNode).
fn leave(state : State, screen : Address(ScreenMsg), text : String) : Unit receiving ShellMsg = {
    reportRemaining(state, screen, Noted);
    finish(screen, text);
    detachNode(state)
}

// Report §11.2: an attached session's end, which leaves its node running:
// the front end ends its own processes, its reader and its screen among
// them, leaves what the session started to the node, keeps for the node's
// life its units that declare a function or build a function value, and
// lets the rest go as the purge allows (`detach`). A plain shell's ends
// with its program.
fn detachNode(state : State) : Unit =
    if state.attached then detach() else Unit

// Report §11.2: every fault reported to the session until it ends: it
// waits until each report on its way to it has arrived, and says those its
// mailbox holds, wrapped as `reportFault` says.
fn reportRemaining(state : State,
                   screen : Address(ScreenMsg),
                   wrap : (String) -> ScreenMsg) : Unit receiving ShellMsg = {
    waitForDeliveries();
    let _ = reportPending(state, screen, wrap);
    Unit
}

// Report §11.2: on quitting, the region goes and the cursor is left on a
// fresh line, so the terminal is as the shell found it.
fn finish(screen : Address(ScreenMsg), text : String) : Unit = {
    send(screen, Said(text));
    send(screen, SetRows(0));
    send(screen, ShowInput(text = "", cursor = 0, offered = []));
    send(screen, Said("\n"));
    drain(screen)
}

// The prompt comes after what the input printed. A program's text reaches
// the screen from its own processes, not through the session, so the
// screen is drained first; if it does not answer within `screenMs` the
// prompt is written anyway.
fn prompt(screen : Address(ScreenMsg)) : Unit = {
    drain(screen);
    send(screen, Said("> "))
}

fn drain(screen : Address(ScreenMsg)) : Unit = {
    let _ = Address.call(screen, Flush, screenMs);
    Unit
}

//
// The reader, on a terminal: it owns the keys and the line being edited,
// and draws nothing itself. What a key does is `edit`, a pure function;
// the reader sends the screen the line and the session what was entered.
//

// Report §11.2: the reader, the shell's own process, which a fault report
// leaves out: it takes each key its local half forwards from the terminal,
// which the local half holds, the interrupt among them.
fn readLoop(shell : Address(ShellMsg),
            screen : Address(ScreenMsg),
            reading : Reading) : Unit receiving ReaderMsg =
    receive {
        Key(event) -> read(shell, screen, reading, event)
    }

// What a key does.
fn read(shell : Address(ShellMsg),
        screen : Address(ScreenMsg),
        reading : Reading,
        event : Terminal.Event) : Unit receiving ReaderMsg = {
    let Reading(=editing, =keeping) = reading;
    match event {
        // report §11.2: the size the event carries is the terminal's on
        // the shell's own node, which the screen paints at and the reader
        // renders documentation to
        Terminal.Resized(size) -> {
            send(screen, Resized(size));
            readLoop(shell, screen, Reading(..reading, columns = size.columns))
        }
      | _ ->
            match Ernest.Shell.Editor.edit(editing, event) {
                Ernest.Shell.Editor.Edited(edited) ->
                    showing(shell, screen, reading, edited)
              | Ernest.Shell.Editor.Matching(edited) ->
                    matching(shell, screen, reading, edited)
              // report §11.2: another line where the parser cannot finish the
              // input, and the input where it can
              | Ernest.Shell.Editor.Submit(edited) ->
                    if continues(Ernest.Shell.Editor.text(edited)) then
                        showing(shell, screen, reading, Ernest.Shell.Editor.newline(edited))
                    else {
                        let keeping = remember(screen, reading.local, edited, keeping);
                        send(screen, Entered);
                        send(shell, Typed(Ernest.Shell.Editor.text(edited)));
                        readLoop(shell,
                                 screen,
                                 Reading(..reading,
                                         editing = Ernest.Shell.Editor.next(edited),
                                         =keeping,
                                         last = Ordinary))
                    }
              | Ernest.Shell.Editor.Cancel -> {
                    // what was typed stays in the transcript, abandoned, and
                    // in the history to recall and mend
                    let keeping = remember(screen, reading.local, editing, keeping);
                    send(screen, Entered);
                    send(shell, Interrupted);
                    readLoop(shell,
                             screen,
                             Reading(..reading,
                                     editing = Ernest.Shell.Editor.next(editing),
                                     =keeping,
                                     last = Ordinary))
                }
              | Ernest.Shell.Editor.ClearScreen(edited) -> {
                    send(screen, Clear);
                    showing(shell, screen, reading, edited)
                }
              | Ernest.Shell.Editor.Completing(edited) ->
                    completing(shell, screen, reading, edited)
              | Ernest.Shell.Editor.Documenting(edited) ->
                    documenting(shell, screen, reading, edited)
              | Ernest.Shell.Editor.Quit ->
                    send(shell, InputEnded)
            }
    }
}

// Report §11.2: the bracket a closing one just typed closes is shown by
// the cursor, which stands on it until the next key or for half a second.
// A key that comes first puts the cursor back, and is read.
fn matching(shell : Address(ShellMsg),
            screen : Address(ScreenMsg),
            reading : Reading,
            edited : Ernest.Shell.Editor.Editing) : Unit receiving ReaderMsg = {
    let text = Ernest.Shell.Editor.text(edited);
    match opening(String.slice(text, 0, Ernest.Shell.Editor.cursor(edited))) {
        None ->
            showing(shell, screen, reading, edited)
      | Some(index) -> {
            send(screen, ShowInput(=text, cursor = index, offered = []));
            receive {
                Key(event) -> {
                    send(screen, shownInput(edited));
                    read(shell,
                         screen,
                         Reading(..reading, editing = edited, last = Ordinary),
                         event)
                }
              | after 500 ->
                    showing(shell, screen, reading, edited)
            }
        }
    }
}

// The screen is told what is being typed, and the person is told once,
// above the region, how a multi-line input is run.
fn showing(shell : Address(ShellMsg),
           screen : Address(ScreenMsg),
           reading : Reading,
           edited : Ernest.Shell.Editor.Editing) : Unit receiving ReaderMsg = {
    let hinted = hint(screen, reading, edited);
    send(screen, shownInput(edited));
    // a key that only begins a sequence, `Escape` and the `[` after
    // it, leaves the last key as it was: `Shift-Tab` twice is two
    // presses, not six keys (report §12.1)
    let last = if Ernest.Shell.Editor.isMidSequence(edited) then reading.last else Ordinary;
    readLoop(shell, screen, Reading(..reading, editing = edited, =hinted, =last))
}

// Report §11.2: the first input of a session to take a second line says
// how it is run, once, above the region rather than on the prompt, where
// it would move the column the input is typed in.
fn hint(screen : Address(ScreenMsg),
        reading : Reading,
        edited : Ernest.Shell.Editor.Editing) : Bool =
    if reading.hinted then
        true
    else if String.contains(Ernest.Shell.Editor.text(edited), "\n") then {
        send(screen, Noted("Enter runs a finished input, M-Enter adds a line."));
        true
    } else
        false

// What the reader shows is the editor's, since a search shows its own
// prompt and the input it found rather than the line (report §11.2).
fn shownInput(editing : Ernest.Shell.Editor.Editing) : ScreenMsg =
    under(editing, [])

// The line being typed with rows shown under it, which the next key
// takes away (report §11.2).
fn under(editing : Ernest.Shell.Editor.Editing, rows : List(String)) : ScreenMsg =
    ShowInput(text = Ernest.Shell.Editor.shown(editing),
              cursor = Ernest.Shell.Editor.shownCursor(editing),
              offered = rows)

// Report §11.2: `Enter` takes another line where the parser cannot
// finish the input, and runs what there is on an empty line, so that an
// input that cannot parse is shown its error rather than asked for more.
// An input with nothing in it runs, though the parser cannot finish it:
// `Enter` at an empty prompt has always given a new one. A command is one
// line, which `Enter` runs whatever its argument.
fn continues(input : String) : Bool =
    !String.isEmpty(String.trim(input))
        && !String.startsWith(String.trimStart(input), ":")
        && !lastLineBlank(input)
        && needsMore(input)

fn lastLineBlank(input : String) : Bool =
    String.contains(input, "\n")
        && String.isEmpty(String.trim(rowBefore(input, String.size(input))))

// The row the cursor is on, up to the cursor: a multi-line input's rows
// are its lines.
fn rowBefore(input : String, cursor : Int) : String = {
    let before = String.slice(input, 0, cursor);
    match String.lastIndexOf(before, "\n") {
        None -> before
      | Some(index) -> String.drop(before, index + 1)
    }
}

// Report §11.2: an input the history keeps is appended as the shell
// takes it, by the local half, which holds the history file.
fn remember(screen : Address(ScreenMsg),
            local : Address(LocalMsg),
            editing : Ernest.Shell.Editor.Editing,
            keeping : Bool) : Bool = {
    let line = Ernest.Shell.Editor.text(editing);
    if !keeping || !Ernest.Shell.Editor.keeps(editing) then
        keeping
    else match addToHistory(local, line) {
        Right(_) ->
            true
      | Left(error) -> {
            // the reader's own note, which leaves the prompt where it is
            send(screen, Noted("the history is not kept: " <> trouble(error)));
            false
        }
    }
}

// Report §11.2: the local half's append of an input to the history, as
// `Ernest.Shell.History.add` answers on the shell's own node, or `Timeout` where
// no answer comes.
fn addToHistory(local : Address(LocalMsg), input : String) : Either(Io.Error, Unit) =
    Optional.withDefault(Address.call(local, fn(reply) = Remember(=input, =reply), localMs),
                         Left(Io.Timeout))

// Report §11.2: `Tab` completes the word before the cursor; a second
// `Tab` lists what it could still be, under the line, until the next
// key.
fn completing(shell : Address(ShellMsg),
              screen : Address(ScreenMsg),
              reading : Reading,
              editing : Ernest.Shell.Editor.Editing) : Unit receiving ReaderMsg = {
    let line = Ernest.Shell.Editor.text(editing);
    let cursor = Ernest.Shell.Editor.cursor(editing);
    if !String.startsWith(line, ":") && String.isEmpty(String.trim(rowBefore(line, cursor))) then
        // report §11.2: only spaces before the cursor on its row, so `Tab`
        // indents. Four spaces and no tab: the style guide's rule, and
        // a tab in the line is invisible where spaces are what they
        // look like (§0, principle 3)
        showing(shell, screen, reading, Ernest.Shell.Editor.insert(editing, indent))
    else {
        let #(completion, typedWord) =
            Ernest.Shell.Complete.completion(line,
                                             cursor,
                                             fn(path) = listEntries(reading.local, path));
        offering(shell, screen, reading, completion, typedWord, editing)
    }
}

// Report §11.2: a directory of the source root, listed by the local half,
// which holds the operator's files, or `Timeout` where no answer comes.
fn listEntries(local : Address(LocalMsg), path : Path) : Either(Io.Error, List(Fs.Entry)) =
    Optional.withDefault(Address.call(local, fn(reply) = ListEntries(=path, =reply), localMs),
                         Left(Io.Timeout))

// Report §11.2: what `Tab` puts in where it indents.
let indent = "    "

// What a completion does to the line: the word it gives stands in
// place of the one typed, and a second `Tab` lists what is left. Report
// §11.2: so does a first `Tab` that adds nothing to the line, since a
// key that changes nothing would say nothing, and a lone candidate is
// listed whenever it is reached, since its line says what was completed.
fn offering(shell : Address(ShellMsg),
            screen : Address(ScreenMsg),
            reading : Reading,
            completion : Ernest.Shell.Complete.Completion,
            typedWord : String,
            editing : Ernest.Shell.Editor.Editing) : Unit receiving ReaderMsg = {
    let line = Ernest.Shell.Editor.text(editing);
    let #(text, cursor) =
        Ernest.Shell.Complete.applied(line,
                                      Ernest.Shell.Editor.cursor(editing),
                                      typedWord,
                                      completion);
    let completed = Ernest.Shell.Editor.withLine(editing, text, cursor);
    let hinted = hint(screen, reading, completed);
    let listed = reading.last == Tabbed || text == line || Ernest.Shell.Complete.isLone(completion);
    let rows = if listed then listing(completion, reading.color) else [];
    send(screen, under(completed, rows));
    readLoop(shell, screen, Reading(..reading, editing = completed, =hinted, last = Tabbed))
}

// Report §11.2: the candidates, a lone one too, a line each with the
// type they carry, or a command's help line. The region cuts the listing
// to the rows the screen has.
fn listing(completion : Ernest.Shell.Complete.Completion, color : Markdown.Output) : List(String) =
    List.map(completion.candidates, fn(name) = Ernest.Shell.Style.named(name.shown, color))

// Report §11.2: `Shift-Tab` says what the name at the cursor is: its
// type, the first sentence about it, and the version it appeared in, and
// the whole page when it is pressed again. Where no name at the cursor is
// documented and the cursor is inside a call or a constructor, it shows
// the call's signature instead. Under the line, as a listing is.
fn documenting(shell : Address(ShellMsg),
               screen : Address(ScreenMsg),
               reading : Reading,
               editing : Ernest.Shell.Editor.Editing) : Unit receiving ReaderMsg = {
    let Reading(=last, =color) = reading;
    let line = Ernest.Shell.Editor.text(editing);
    let cursor = Ernest.Shell.Editor.cursor(editing);
    // report §11.2: the whole name the cursor stands in, and a call is
    // looked for in a command's argument as in any input
    let name = Ernest.Shell.Complete.wordAt(line, cursor);
    let page = if String.isEmpty(name) then None else documentation(name);
    let skipped = if String.startsWith(line, ":") then
        Int.min(Ernest.Shell.Command.wordEnd(line), cursor)
    else
        0;
    let rows = match page {
        Some(#(text, version)) ->
            if last == Documented then
                rendered(text, reading.columns, color)
            else
                brief(text, version, reading.columns, color)
      | None ->
            match signature(String.slice(line, skipped, cursor)) {
                Some(#(head, marked, rest)) ->
                    [head <> Ernest.Shell.Style.emphasis(marked, color) <> rest]
              | None ->
                    []
            }
    };
    send(screen, under(editing, rows));
    readLoop(shell, screen, Reading(..reading, =editing, last = Documented))
}

// The declaration, the first sentence, and the version a page's
// declaration appeared in: the first line of its first code block, the
// first sentence of its first paragraph past its `Since` line (report
// §11.4), and the version, the name bold.
fn brief(text : String,
         version : Optional(String),
         width : Int,
         color : Markdown.Output) : List(String) = {
    let blocks = Markdown.parse(text);
    let declarations = List.flatMap(blocks, fn(block) = match block {
        Markdown.Code(=lines) -> List.take(lines, 1)
      | _ -> []
    });
    let paragraphs = List.filter(blocks, fn(block) = match block {
        Markdown.Paragraph(_) -> true
      | _ -> false
    });
    let prose = List.filter(paragraphs, fn(block) = !isVersion(block));
    let sentence = match Markdown.firstSentence(prose) {
        [] -> []
      | inlines -> [Markdown.Paragraph(inlines)]
    };
    let since = match version {
        Some(appeared) -> {
            let line = Markdown.Text("Since " <> appeared <> ".");
            [Markdown.Paragraph([Markdown.Emphasis([line])])]
        }
      | None ->
            []
    };
    List.map(List.take(declarations, 1),
             fn(declaration) = Ernest.Shell.Style.named(declaration, color))
        <> Markdown.render(sentence, width, color)
        <> Markdown.render(since, width, color)
}

// The line §11.4 writes for the version a declaration appeared in.
fn isVersion(block : Markdown.Block) : Bool =
    match block {
        Markdown.Paragraph([Markdown.Emphasis([Markdown.Text(text)])]) ->
            String.startsWith(text, "Since ")
      | _ ->
            false
    }

//
// Line mode: where standard output has no size or the reader's
// subscription is refused, the session reads lines itself, with no editing
//

fn lineLoop(state : State, screen : Address(ScreenMsg)) : Unit receiving ShellMsg = {
    let state = reportPending(state, screen, saidLine);
    prompt(screen);
    match nextLine(state) {
        None ->
            leaveLines(state, screen)
      | Some(line) ->
            // report §11.2: a fault reported while the session waited for
            // the line is said before the line runs, so that `:faults`
            // lists it
            takingLine(reportPending(state, screen, saidLine), screen, line)
    }
}

// Report §11.2: a line read, as `taking` takes one at a terminal: a blank
// line runs nothing, and any other runs with the lines `moreLines` takes
// after it.
fn takingLine(state : State, screen : Address(ScreenMsg), line : String) : Unit receiving ShellMsg =
    if String.isEmpty(String.trim(line)) then
        lineLoop(state, screen)
    else match submit(state, screen, String.trim(moreLines(state, screen, line))) {
        Leave -> leaveLines(state, screen)
      | Continue(state) -> lineLoop(state, screen)
    }

// Report §11.2: the session ends in line mode as `leave` says, the end of
// its input and `:quit` coming at a prompt whose line no input has ended.
// That line is ended first, once, so that each fault said as the session
// ends stands on a line of its own, as it stands above the region at a
// terminal; with no region, nothing is left to take away.
fn leaveLines(state : State, screen : Address(ScreenMsg)) : Unit receiving ShellMsg = {
    send(screen, Said("\n"));
    reportRemaining(state, screen, saidLine);
    drain(screen);
    detachNode(state)
}

// Report §11.2: in line mode the shell's own node reads each line, its
// local half answering with the next or none at the end of input, which
// the session takes as a line it read itself; an attached session takes
// its local half's end as the end of its input. Report §11.8: the screen's
// end faults the session while it waits, as at a terminal, since a line
// that never comes would keep it waiting with nothing to show itself on.
fn nextLine(state : State) : Optional(String) receiving ShellMsg = {
    send(state.local, ReadLine(lines = state.lines));
    receive {
        Line(line) ->
            line
      | LocalEnded(down) -> {
            endWithLocal(state, down);
            None
        }
      | ScreenDied(down) ->
            endWithScreen(down)
    }
}

// Report §11.2: what faulted while the session was reading, each report in
// the mailbox said wrapped as `reportFault` says, and each reload by another
// session as `sayReload` says. In line mode the session waits for its next
// line, so a fault is reported once the line has come, before the line
// runs, and before the next prompt, and as the session ends
// (`leaveLines`); §6.4 leaves every other message in the mailbox.
fn reportPending(state : State,
                 screen : Address(ScreenMsg),
                 wrap : (String) -> ScreenMsg) : State receiving ShellMsg =
    receive {
        Reported(report) ->
            reportPending(reportFault(state, screen, report, wrap), screen, wrap)
      | Reloaded(=by, =modules) ->
            reportPending(sayReload(state, screen, by, modules, wrap), screen, wrap)
      | ScreenDied(down) ->
            endWithScreen(down)
      | after 0 ->
            state
    }

// Report §11.2: in line mode, as at a terminal, an input the parser cannot
// finish takes the next line, under the prompt `... `, and a blank line or
// the end of input runs what there is.
fn moreLines(state : State,
             screen : Address(ScreenMsg),
             input : String) : String receiving ShellMsg =
    if continues(input) then {
        send(screen, Said("... "));
        match nextLine(state) {
            None -> input
          | Some(line) -> moreLines(state, screen, input <> "\n" <> line)
        }
    } else
        input

//
// The local half, on the shell's own node: the terminal and the operator's
// files, which the session touches through it alone
//

// Report §11.2: the local half holds the terminal, reads the startup
// files, the history and the environment, and starts its session with what
// it read, beside it in a plain shell or on the listed peer it attaches
// to; then it forwards the terminal's events to the session's reader,
// writes what the screen writes, and reads and appends the operator's
// files for the session, until the session ends.
fn localHalf(attachment : Attachment) : Unit receiving LocalMsg = {
    markSelfOwn();
    let size = holdKeys();
    // report §11.2: in line mode a reader of lines of its own holds the
    // terminal and reads each line the session asks for, so that the local
    // half writes while a line is awaited
    let lines = match size {
        Some(_) ->
            None
      | None -> {
            let reader = spawn(fn() = readLines());
            monitor(Process.fromAddress(reader), LinesEnded);
            Some(reader)
        }
    };
    let color = if Optional.isSome(size) && colorAllowed then Markdown.Styled else Markdown.Plain;
    // report §11.2: the startup files are checked and read as they are
    // found, and the person's directory is then made its owner's alone,
    // before the history makes it so at a terminal
    let startup = startupFiles();
    let read = List.map(startup, readOwnInputs);
    Ernest.Shell.History.keepOwn();
    let #(earlier, keeping, historyNotes) = match size {
        Some(_) -> readHistory()
      | None -> #([], false, [])
    };
    let desk =
        Desk(local = self(),
             =size,
             =color,
             =earlier,
             =keeping,
             notes = List.flatMap(read, fn(#(_, notes)) = notes) <> historyNotes,
             startup = List.flatMap(read, fn(#(inputs, _)) = inputs),
             sourceRoot = givenSourceRoot(),
             workingDirectory = Path.toString(Os.workingDirectory),
             attached = isAttaching(attachment));
    let serving =
        Serving(keys = None,
                =lines,
                peer = None,
                ending = "",
                sourceRoot = Path(desk.sourceRoot),
                startup = List.map(startup, Path),
                output = None);
    match attachment {
        Beside(session) -> {
            send(session, Begun(desk));
            attaching(serving, None)
        }
      | Attaching(name) -> {
            // report §11.2 *The attached shell*: twice a dial's time, the
            // dial's for the connection and as much again for the session,
            // so that a node nothing answers is unreachable at the dial's end
            let attachMs = 2 * dialMs();
            let deadline = Clock.monotonic() + attachMs;
            match Peer.spawnMonitored(name, fn() = attached(desk), EntryEnded, attachMs) {
                Right(_) -> attaching(Serving(..serving, peer = Some(name)), Some(deadline))
              | Left(error) -> end(1, refusal(name, error))
            }
        }
    }
}

fn isAttaching(attachment : Attachment) : Bool =
    match attachment {
        Attaching(_) -> true
      | Beside(_) -> false
    }

// Report §11.2, §12.1: the terminal's size where standard output has one
// and the keys are granted, and none in line mode. The local half holds
// the terminal before it subscribes, so that the keys are its alone and
// the interrupt reaches it as a key, and a granted subscription means the
// terminal no longer echoes, so nothing typed at an earlier prompt is read
// as a line.
fn holdKeys() : Optional(Terminal.Size) receiving LocalMsg =
    match Terminal.size() {
        Left(_) ->
            None
      | Right(size) -> {
            holdTerminal(self());
            match Terminal.subscribe(Pressed) {
                Right(_) -> Some(size)
              | Left(_) -> None
            }
        }
    }

// Report §11.2, §11.8: an attach that fails is the job's refusal, naming
// the spawn's `Io.Error` (Appendix E.27), and dials again never; a node
// that lacks the shell's units runs another build of `ern`, and one that
// holds them and could not load them answers why (§12.7), which the shell
// says as it is.
fn refusal(name : String, error : Io.Error) : String = {
    let peer = "ern shell: the peer " <> name;
    match error {
        Io.NotListed ->
            peer <> " is not listed"
      | Io.Unreachable ->
            peer <> " is unreachable"
      | Io.Timeout ->
            peer <> " did not answer in time"
      | Io.NotLoaded ->
            nodeRefusal(name, "runs another build of ern than this shell; attach with its release")
      | Io.Other(text) ->
            nodeRefusal(name, "could not load the shell: " <> text)
      | other ->
            peer <> ": " <> trouble(other)
    }
}

// Report §11.2: the root of the session's chain ended before the session
// started, which no connection gives: the connection lost or the node
// ended, which leaves the peer unreachable, or an end of its own, which
// the shell says as the start's reason.
fn startRefusal(name : String, reason : Reason) : String =
    match reason {
        Unreachable or ProgramEnd -> refusal(name, Io.Unreachable)
      | other -> nodeRefusal(name, "could not start the shell: " <> Io.show(other))
    }

// Report §11.2: a refusal of what the node itself did, `words` after its
// name.
fn nodeRefusal(name : String, words : String) : String =
    "ern shell: the node " <> name <> " " <> words

// Report §11.2: until the session has its screen, the terminal's events
// waiting meanwhile; an attached shell, `deadline` the moment its wait
// ends, waits for it twice as long as a dial is waited for, from the
// attach's start, and refuses the attach where it does not come.
fn attaching(serving : Serving, deadline : Optional(Int)) : Unit receiving LocalMsg =
    match #(serving.peer, deadline) {
        #(Some(name), Some(ending)) ->
            receive {
                Attached(=session, =keys, =screen, =reply) ->
                    served(joinSession(serving, session, keys, screen, reply))
              // report §11.2: the connection lost, or the node ended, before
              // the session started, which no connection gives
              | EntryEnded(down) ->
                    end(1, startRefusal(name, down.reason))
              | after ending - Clock.monotonic() ->
                    end(1, refusal(name, Io.Timeout))
            }
      | _ ->
            receive {
                Attached(=session, =keys, =screen, =reply) ->
                    served(joinSession(serving, session, keys, screen, reply))
            }
    }

// Report §11.2: the session has its screen: what the shell's own node
// writes goes there from now on, and an attached shell's local half and
// its session monitor each other.
fn joinSession(serving : Serving,
               session : Process,
               keys : Optional(Address(Terminal.Event)),
               screen : Process,
               reply : Reply(Unit)) : Serving receiving LocalMsg = {
    setNodeScreen(Some(screen));
    if Optional.isSome(serving.peer) then monitor(session, SessionEnded) else Unit;
    answer(reply, Unit);
    Serving(..serving, =keys)
}

// Report §11.2: what the local half does for its session, one message at a
// time, in the order they come.
fn served(serving : Serving) : Unit receiving LocalMsg =
    receive {
        Pressed(event) -> {
            match serving.keys {
                Some(keys) -> send(keys, event)
              | None -> Unit
            };
            served(serving)
        }
      | Write(=text, =ending) -> {
            write(text);
            served(Serving(..serving, =ending))
        }
      | Drain(reply) -> {
            answer(reply, Unit);
            served(serving)
        }
      | Remember(=input, =reply) -> {
            answer(reply, Ernest.Shell.History.add(input));
            served(serving)
        }
      // report §11.2: `:output`'s path, tried with an append of nothing,
      // which creates a file that is not there, and appended to from then
      // on, and no other
      | Output(=path, =reply) -> {
            let tried = Fs.append(path, <<>>, fileMs);
            answer(reply, tried);
            match tried {
                Right(_) -> served(Serving(..serving, output = Some(path)))
              | Left(_) -> served(serving)
            }
        }
      | Append(=path, =bytes, =reply) -> {
            answer(reply,
                   if serving.output == Some(path) then
                       Fs.append(path, bytes, fileMs)
                   else
                       Left(Io.Denied));
            served(serving)
        }
      | ReadLine(=lines) -> {
            match serving.lines {
                Some(reader) -> send(reader, NextLine(=lines))
              | None -> Unit
            };
            served(serving)
        }
      | Read(=path, =reply) -> {
            answer(reply, if isRead(serving, path) then Fs.read(path, fileMs) else Left(Io.Denied));
            served(serving)
        }
      | Stat(=path, =reply) -> {
            answer(reply, if isRead(serving, path) then Fs.stat(path, fileMs) else Left(Io.Denied));
            served(serving)
        }
      | ListEntries(=path, =reply) -> {
            answer(reply,
                   if isUnder(serving.sourceRoot, path) then
                       Fs.list(path, fileMs)
                   else
                       Left(Io.Denied));
            served(serving)
        }
      // report §11.2: the session is monitored where it is attached alone
      | SessionEnded(down) ->
            match serving.peer {
                Some(name) -> endWithSession(name, down, serving.ending)
              | None -> served(serving)
            }
      // the root of the session's chain, which ends with the session, whose
      // own end the local half monitors
      | EntryEnded(_) ->
            served(serving)
      // report §11.8: a standard input that faults its reader of lines
      // ends the shell as that fault
      | LinesEnded(down) ->
            match down {
                Down(reason = Fault(cause)) -> fault(cause)
              | _ -> served(serving)
            }
      | Attached(session = _, keys = _, screen = _, =reply) -> {
            answer(reply, Unit);
            served(serving)
        }
    }

// Report §11.2: whether the local half reads a file for its session: one
// under the source root, or a startup file it ran, whose diagnostics quote
// it.
fn isRead(serving : Serving, path : Path) : Bool =
    List.contains(serving.startup, path) || isUnder(serving.sourceRoot, path)

// Report §11.2: whether a path, named from the working directory where it
// is relative, lies under the root, which it may name itself, and takes no
// step out of it, `..` or `.`, which `Path.under` refuses.
fn isUnder(root : Path, path : Path) : Bool = {
    let rootSegments = Path.split(root);
    let segments = Path.split(Os.workingDirectory <> path);
    let rest = List.drop(segments, List.size(rootSegments));
    List.take(segments, List.size(rootSegments)) == rootSegments
        && (List.isEmpty(rest) || Optional.isSome(Path.under(root, Path.join(rest))))
}

// Report §11.2, §11.8: an attached session's end, and the shell's with it:
// a detach says nothing and exits with status 0. A detach has taken its
// region away; any other end leaves the screen as it last drew, so the
// local half ends it first, `ending` the bytes the screen sent for that,
// and the line the runner says stands on a row of its own. The screen has
// gone with the session, or with its node, so what the shell's own node
// writes from now on goes to its own standard output, and the end's drain
// asks no node that may be lost (§8.6).
fn endWithSession(name : String, down : Down, ending : String) : Unit = {
    setNodeScreen(None);
    match down.reason {
        Returned ->
            end(0, "")
      | reason -> {
            write(ending);
            let #(status, line) = nodeEnd(name, reason);
            end(status, line)
        }
    }
}

// Report §11.2, §11.8, Appendix E.23: the shell's end with a status, its
// line said first where it has one; `Os.exit` from the shell's own process
// ends the shell as it ends a run of `ern run`.
fn end(status : Int, line : String) : Unit = {
    if String.isEmpty(line) then Unit else sayEnd(line);
    Os.exit(status)
}

// Report §11.2, §11.8: the status and the line of a session's end other
// than a detach: a node that ended says so and exits with status 0, and a
// node lost says so and exits with status 1; any other end is a failure of
// the shell's own.
fn nodeEnd(name : String, reason : Reason) : #(Int, String) =
    match reason {
        ProgramEnd -> #(0, "the node " <> name <> " ended")
      | Unreachable -> #(1, "the node " <> name <> " is lost")
      | Fault(cause) -> #(70, "fault: the session on the node " <> name <> ": " <> cause)
      | other -> #(70, "fault: the session on the node " <> name <> " ended: " <> Io.show(other))
    }

// Report §11.2: in line mode, the reader of lines on the shell's own node,
// which holds the terminal, so that a process that asks for the keys or a
// line faults rather than taking them, and reads the next line each time
// the session asks.
fn readLines() : Unit receiving LinesMsg = {
    markSelfOwn();
    holdTerminal(self());
    nextRead()
}

fn nextRead() : Unit receiving LinesMsg =
    receive {
        NextLine(=lines) -> {
            send(lines, Io.readLine());
            nextRead()
        }
    }

//
// The front end
//

// Report §11.2: the session on its node, given the node's next number: its
// local half, which holds the terminal and the operator's files, the
// screen's process, which what its processes write goes to, the
// operator's source root and working directory, whether it is attached
// from another node, and its own address, which another session's reload
// is said at (`Reloaded`).
foreign fn start(local : Address(LocalMsg),
                 screen : Process,
                 sourceRoot : String,
                 workingDirectory : String,
                 attached : Bool,
                 shell : Address(ShellMsg)) : Session =
    "ern_shell:start/6"

// Report §11.2 *Startup and history*: the number the session's on its node,
// which the greeting says.
foreign fn number(session : Session) : Int =
    "ern_shell:number/1"

// Report §11.2 *The attached shell*: the lines a reload by the session
// numbered `by` is said with, and the session with the node's modules as
// they stand.
foreign fn reloadedBy(session : Session,
                      by : Int,
                      modules : List(String)) : #(Session, List(String)) =
    "ern_shell:reloaded_by/3"

// Report §11.2: an attached session's end, its own processes ended but the
// caller: what it started left to the node, its units that declare a
// function or build a function value kept for the node's life, and the
// rest let go as the purge allows; nothing where the session has detached
// already.
foreign fn detach() : Unit =
    "ern_shell:detach/0"

// The host's alone: the source root the runner was given, absolute.
foreign fn givenSourceRoot() : String =
    "ern_shell:given_source_root/0"

// The host's alone: the listed peer `--attach` names, which the runner was
// given, or none.
foreign fn attachTo() : Optional(String) =
    "ern_shell:attach_to/0"

// Report §11.2, §11.8: the line an attached shell's end says on the job's
// standard error, the job's own, which no screen takes.
foreign fn sayEnd(line : String) : Unit =
    "ern_shell:say_end/1"

foreign fn spawnProgram() : Unit =
    "ern_shell:spawn_program/0"

foreign fn load(session : Session, name : String) : Either(String, #(Session, String)) =
    "ern_shell:load/2"

foreign fn reload(session : Session) : Either(String, #(Session, List(String))) =
    "ern_shell:reload/1"

// Report §11.2: the parser cannot finish what is typed, so another line
// may. The parser is the compiler's, and only it knows.
foreign fn needsMore(input : String) : Bool =
    "ern_shell:needs_more/1"

// Report §11.2: where the bracket that ends the text was opened, in
// graphemes, as the compiler's lexer reads the text, which alone knows
// where a string or a comment stands.
foreign fn opening(before : String) : Optional(Int) =
    "ern_shell:opening/1"

// Report §11.2: the page for a name, which `Shift-Tab` shows a first
// sentence of and then the whole of, as `:doc` shows it, and the version
// the name appeared in.
foreign fn documentation(name : String) : Optional(#(String, Optional(String))) =
    "ern_shell:documentation/1"

// Report §11.2: the signature of the call the input stops inside, with the
// parameter at the cursor marked, which `Shift-Tab` shows where no name
// before the cursor is documented.
foreign fn signature(before : String) : Optional(#(String, String, String)) =
    "ern_shell:signature/1"

// Report §11.2: an input checked against the session; a diagnostic names
// where it came from, `input 3` for the third thing entered at the prompt,
// and a startup file by its path and the line it starts on there.
foreign fn check(session : Session,
                 origin : Origin,
                 input : String) : Either(String, #(Session, Checked)) =
    "ern_shell:check/3"

// Report §11.2: `:type`'s expression checked as an input is, in a
// namespace of its own that no input takes, and not run.
foreign fn checkType(session : Session,
                     origin : Origin,
                     input : String) : Either(String, #(Session, Checked)) =
    "ern_shell:check_type/3"

// The host's alone: the startup file of the configuration directory
// `--config-dir` names, which the runner was given, or none.
foreign fn configStartup() : Optional(String) =
    "ern_shell:config_startup/0"

// The host's alone: whether two paths name one file, by its device and its
// node, which no `Fs.Entry` holds.
foreign fn isSameFile(first : String, second : String) : Bool =
    "ern_shell:is_same_file/2"

foreign fn typeText(checked : Checked) : String =
    "ern_shell:type_text/1"

// Report §11.2, §4.9: the type of an input that is one name, as its
// declaration writes it, its requirement among it; none for any other
// input, which is checked.
foreign fn declaredType(session : Session, input : String) : Optional(String) =
    "ern_shell:declared_type/2"

// Report §11.2: a value of type `Unit` prints nothing.
foreign fn isUnit(checked : Checked) : Bool =
    "ern_shell:is_unit/1"

foreign fn isExpression(checked : Checked) : Bool =
    "ern_shell:is_expression/1"

// Report §11.2, §5.5: what the input declared, or none where its value is
// shown instead: an expression's, and a `let` with `<-` whose value is a
// `Left` or a `None`, which binds nothing.
foreign fn declared(checked : Checked, value : Value) : Optional(List(String)) =
    "ern_shell:declared/2"

// Report §11.2: the value is printed, and `it` is left as it was when
// this input did not settle its type.
foreign fn leavesItUnchanged(checked : Checked) : Bool =
    "ern_shell:leaves_it_unchanged/1"

// The session after an input has answered, its value with what it bound,
// or none where it faulted: what it bound bound by the session and joined,
// and what nothing reaches any more let go, the input's own unit among it
// (report §11.2).
foreign fn collect(session : Session, answer : Optional(#(Bound, Value))) : Session =
    "ern_shell:collect/2"

// Report §11.2 *Inputs*: the processes of the inputs the session's
// collections set to go, each with the names its holder held, which the
// session asks what each owned of before it lets them go.
foreign fn going() : List(#(Process, List(String))) =
    "ern_shell:going/0"

// Report §11.2 *Inputs*: the processes the collections set to go let go,
// what each owned ending with it.
foreign fn letGo() : Unit =
    "ern_shell:let_go/0"

foreign fn spawnInput(session : Session,
                      checked : Checked,
                      serial : Int,
                      address : Address(Outcome)) : Address(Never) =
    "ern_shell:spawn_input/4"

foreign fn show(value : Value, depth : Int, length : Int) : String =
    "ern_shell:show/3"

foreign fn bindings(session : Session) : List(String) =
    "ern_shell:bindings/1"

foreign fn forget(session : Session, name : String) : Either(String, Session) =
    "ern_shell:forget/2"

foreign fn browse(session : Session, name : String) : Either(String, List(String)) =
    "ern_shell:browse/2"

foreign fn doc(session : Session, name : String) : Either(String, String) =
    "ern_shell:doc/2"

// The toolchain's version, which the host was built with.
foreign fn version() : String =
    "ern_shell:version/0"

foreign fn write(text : String) : Unit =
    "ern_shell:write/1"

// Report §11.2, §12.1: the screen what the shell's own node writes goes
// to, its session's, or none once the session has ended, from when it goes
// to the node's own standard output and standard error.
foreign fn setNodeScreen(screen : Optional(Process)) : Unit =
    "ern_shell:node_screen/1"

// Report §8.7: the milliseconds after which the carrier gives up a dial
// that nothing answers, which an attached shell waits for its node.
foreign fn dialMs() : Int =
    "ern_carrier:dial_ms/0"

foreign fn holdTerminal(holder : Address(a)) : Unit =
    "ern_rt:hold_terminal/1"

// Report §11.2, Appendix E.21: the session's own processes, which
// `Process.live()` leaves out, and which its end ends.
foreign fn markOwn(processes : List(Process)) : Unit =
    "ern_shell:own/1"

// Report §11.2, Appendix E.21: the calling process, one of the session's
// own: the local half, its reader of lines, and the root of an attached
// session's chain.
fn markSelfOwn() : Unit =
    markOwn([Process.fromAddress(self())])

// Report §11.2: waits until each delivery of the runtime's own on its way
// to the session, a fault's report among them, has arrived, which the
// runtime alone sees.
foreign fn waitForDeliveries() : Unit =
    "ern_rt:wait_for_deliveries/0"
