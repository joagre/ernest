//
// Two modules: the program half
//
// From the guide, §7.1. Calls Net.Http.parse from net/http.ern by its
// qualified name; there is no import. See net/http.ern for how to build.
//
// Needs net/http.ern compiled first; ern build's directory mode does both in dependency
// order (§11.1).
//

export fn main() -> Unit with Never = match Net.Http.parse("GET /") {
    Some(Net.Http.Request(method = method, path = path)) ->
        Io.println(method <> " " <> path)
  | None -> Io.println("bad request")
}
