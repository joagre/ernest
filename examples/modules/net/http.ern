//
// Two modules: the library half
//
// From the guide, §6.1. This file's path under the source root, net/http.ern,
// gives it the namespace Net.Http; main.ern calls Net.Http.parse. Build the
// pair with ernc -o build examples/modules and run with
// ern --load-path build build/main.erc.
//
// Needs multi-module compilation (ernc directory mode).
//

export type Request = Request(method : String, path : String)

export fn parse(s : String) -> Optional(Request) =
    if s == "GET /" then Some(Request(method = "GET", path = "/"))
    else None
