//
// Two modules: the library half
//
// From the guide, §7.1. This file's path under the source root, net/http.ern,
// gives it the namespace Net.Http; main.ern calls Net.Http.parse. Build the
// pair with ern build --build-root build examples/modules and run with
// ern build/main.erc.
//
// Needs net/http.ern compiled first; ern build's directory mode does both in dependency
// order (§11.1).
//

export type Request = Request(method : String, path : String)

export fn parse(s : String) -> Optional(Request) =
    if s == "GET /" then Some(Request(method = "GET", path = "/"))
    else None
