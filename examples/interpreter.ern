//
// An interpreter
//
// An interpreter of a small language of numbers, `let`, and functions of
// one argument. It reads an expression a line, prints its value or what is
// wrong with it, and ends at the end of its input.
//
// What to look at:
//
// - The lexer, the parser and the evaluator are pure functions, and each
//   answers its errors as a value, an `Either`, which the loop turns into a
//   line of output (report §7.1).
// - Each expression is evaluated in a process of its own by `Process.run`,
//   which a helper waits on and answers to a call; one that does not end
//   within two seconds is killed with its helper, and the loop goes on
//   (report §6.6, §6.9, Appendix E.21).
//
// Run it from this directory, and type an expression a line:
//
//     ern build interpreter.ern
//     ern run interpreter.erc
//
// For example, `let x = 21`, then `x * 2`, then `(fun n -> n * n) 9`.
//

//
// Types
//

type Token =
    Number(Int)
  | Name(String)
  | Operator(Char)
  | OpenParen
  | CloseParen
  | LetKeyword
  | FunKeyword
  | Equals
  | Arrow

type LexError = BadChar(char : Char, index : Int)

type Expression =
    Literal(Int)
  | Variable(String)
  | Binary(operator : Char, left : Expression, right : Expression)
  | Let(name : String, value : Expression)
  | Function(parameter : String, body : Expression)
  | Apply(callee : Expression, argument : Expression)

type ParseError = Unexpected(Token) | EndOfInput

type Value = Integer(Int) | Closure(parameter : String, body : Expression, env : Map(String, Value))

type EvalError = Unbound(String) | DivisionByZero | NotAFunction | NotANumber

type TryError = Eval(EvalError) | Crashed | Timeout

type HelperMsg = Evaluate(Reply(Either(Reason, Either(EvalError, Value))))

//
// Program
//

export fn main() : Unit =
    interpret(Map.empty)

//
// Processes
//

fn interpret(env : Map(String, Value)) : Unit =
    match Io.readLine() {
        None -> Unit // end of input
      | Some(text) -> interpret(evaluateLine(env, text))
    }

// A line read: its tokens, its expression, and the value it came to,
// shown; then the environment, which a `let` adds its name to.
fn evaluateLine(env : Map(String, Value), text : String) : Map(String, Value) =
    match tokenize(text) {
        Left(BadChar(=char, =index)) -> {
            Io.println("illegal character "
                           <> Char.toString(char)
                           <> " at "
                           <> Int.toString(index));
            env
        }
      // a line with nothing on it answers nothing
      | Right([]) ->
            env
      | Right(tokens) ->
            match parse(tokens) {
                Left(error) -> {
                    Io.println(parseErrorText(error));
                    env
                }
              | Right(expression) -> {
                    let result = try(env, expression);
                    show(result);
                    match #(expression, result) {
                        #(Let(=name), Right(value)) -> Map.put(env, name, value)
                      | _ -> env
                    }
                }
            }
    }

// try as a process: evaluate in a child that `Process.run` starts, and
// wait at most two seconds for the helper that waits on it to answer. A
// helper killed on a timeout takes its child with it, and its late answer
// never reaches this process (report §6.6, Appendix E.21).
fn try(env : Map(String, Value), expression : Expression) : Either(TryError, Value) = {
    let helper = spawn(fn() = receive {
        Evaluate(reply) -> answer(reply, Process.run(fn() = eval(env, expression)))
    });
    match Address.call(helper, Evaluate, 2000) {
        Some(Right(result)) ->
            Either.mapLeft(result, Eval)
      | Some(Left(_)) ->
            Left(Crashed) // a fault in the child
      | None -> {
            kill(Process.fromAddress(helper));
            Left(Timeout)
        }
    }
}

fn show(result : Either(TryError, Value)) : Unit =
    Io.println(match result {
        Right(Integer(value)) -> Int.toString(value)
      | Right(Closure()) -> "<fun>"
      | Left(Eval(error)) -> "error: " <> evalErrorText(error)
      | Left(Crashed) -> "crashed"
      | Left(Timeout) -> "aborted after 2 s"
    })

fn parseErrorText(error : ParseError) : String =
    match error {
        Unexpected(token) -> "unexpected " <> tokenText(token)
      | EndOfInput -> "unexpected end of input"
    }

fn tokenText(token : Token) : String =
    match token {
        Number(value) -> Int.toString(value)
      | Name(name) -> name
      | Operator(char) -> Char.toString(char)
      | OpenParen -> "("
      | CloseParen -> ")"
      | LetKeyword -> "let"
      | FunKeyword -> "fun"
      | Equals -> "="
      | Arrow -> "->"
    }

fn evalErrorText(error : EvalError) : String =
    match error {
        Unbound(name) -> "unbound " <> name
      | DivisionByZero -> "division by zero"
      | NotAFunction -> "not a function"
      | NotANumber -> "not a number"
    }

//
// Pure code: lexer
//

fn tokenize(text : String) : Either(LexError, List(Token)) =
    lex(String.toList(text), 0, [])

fn lex(chars : List(Char), index : Int, acc : List(Token)) : Either(LexError, List(Token)) =
    match chars {
        [] ->
            Right(List.reverse(acc))
      | ' ' :: rest ->
            lex(rest, index + 1, acc)
      | '(' :: rest ->
            lex(rest, index + 1, OpenParen :: acc)
      | ')' :: rest ->
            lex(rest, index + 1, CloseParen :: acc)
      | '=' :: rest ->
            lex(rest, index + 1, Equals :: acc)
      | '-' :: '>' :: rest ->
            lex(rest, index + 2, Arrow :: acc)
      | char :: _ when Char.isAsciiDigit(char) -> {
            let #(digits, rest) = List.span(chars, Char.isAsciiDigit);
            let value = Optional.withDefault(String.toInt(String.fromList(digits)), 0);
            lex(rest, index + List.size(digits), Number(value) :: acc)
        }
      | char :: _ when Char.isAlpha(char) -> {
            let #(word, rest) = List.span(chars, Char.isAlpha);
            let token = match String.fromList(word) {
                "let" -> LetKeyword
              | "fun" -> FunKeyword
              | other -> Name(other)
            };
            lex(rest, index + List.size(word), token :: acc)
        }
      | char :: rest when List.contains(['+', '-', '*', '/'], char) ->
            lex(rest, index + 1, Operator(char) :: acc)
      | char :: _ ->
            Left(BadChar(=char, =index))
    }

//
// Pure code: parser
//

// line := 'let' name '=' expression | expression
// expression := 'fun' name '->' expression | sum
// sum := product (('+'|'-') product)*
// product := application (('*'|'/') application)*
// application := atom atom*
// atom := number | name | '(' expression ')'

// A `let` binds a name for the lines after it, so it stands only at a
// line's start; inside an expression it would bind nothing, and is refused
// as the token it is.
fn parse(tokens : List(Token)) : Either(ParseError, Expression) = {
    let #(expression, rest) <- match tokens {
        LetKeyword :: Name(name) :: Equals :: more -> {
            let #(value, remaining) <- parseExpression(more);
            Right(#(Let(=name, =value), remaining))
        }
      | _ ->
            parseExpression(tokens)
    };
    match rest {
        [] -> Right(expression)
      | token :: _ -> Left(Unexpected(token))
    }
}

fn parseExpression(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        FunKeyword :: Name(parameter) :: Arrow :: rest -> {
            let #(body, remaining) <- parseExpression(rest);
            Right(#(Function(=parameter, =body), remaining))
        }
      | _ ->
            parseSum(tokens)
    }

fn parseSum(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) = {
    let #(left, rest) <- parseProduct(tokens);
    sumRest(left, rest)
}

fn sumRest(left : Expression,
           tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        Operator(operator) :: rest when operator == '+' || operator == '-' -> {
            let #(right, remaining) <- parseProduct(rest);
            sumRest(Binary(=operator, =left, =right), remaining)
        }
      | _ ->
            Right(#(left, tokens))
    }

fn parseProduct(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) = {
    let #(left, rest) <- parseApplication(tokens);
    productRest(left, rest)
}

fn productRest(left : Expression,
               tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        Operator(operator) :: rest when operator == '*' || operator == '/' -> {
            let #(right, remaining) <- parseApplication(rest);
            productRest(Binary(=operator, =left, =right), remaining)
        }
      | _ ->
            Right(#(left, tokens))
    }

fn parseApplication(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) = {
    let #(callee, rest) <- parseAtom(tokens);
    applicationRest(callee, rest)
}

fn applicationRest(callee : Expression,
                   tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match parseAtom(tokens) {
        Left(_) -> Right(#(callee, tokens)) // no atom: the application is over
      | Right(#(argument, rest)) -> applicationRest(Apply(=callee, =argument), rest)
    }

fn parseAtom(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        Number(value) :: rest ->
            Right(#(Literal(value), rest))
      | Name(name) :: rest ->
            Right(#(Variable(name), rest))
      | OpenParen :: rest -> {
            let #(inner, remaining) <- parseExpression(rest);
            match remaining {
                CloseParen :: beyond -> Right(#(inner, beyond))
              | token :: _ -> Left(Unexpected(token))
              | [] -> Left(EndOfInput)
            }
        }
      | token :: _ ->
            Left(Unexpected(token))
      | [] ->
            Left(EndOfInput)
    }

//
// Pure code: evaluator
//

fn eval(env : Map(String, Value), expression : Expression) : Either(EvalError, Value) =
    match expression {
        Literal(value) ->
            Right(Integer(value))
      | Variable(name) ->
            match Map.get(env, name) {
                Some(value) -> Right(value)
              | None -> Left(Unbound(name))
            }
      | Function(=parameter, =body) ->
            Right(Closure(=parameter, =body, =env))
      | Let(=value) ->
            eval(env, value) // evaluateLine binds the name
      | Binary(=operator, =left, =right) -> {
            let leftValue <- eval(env, left);
            let rightValue <- eval(env, right);
            arithmetic(operator, leftValue, rightValue)
        }
      | Apply(=callee, =argument) -> {
            let closure <- eval(env, callee);
            let value <- eval(env, argument);
            match closure {
                Closure(=parameter, =body, env = captured) ->
                    eval(Map.put(captured, parameter, value), body)
              | Integer(_) ->
                    Left(NotAFunction)
            }
        }
    }

fn arithmetic(operator : Char, left : Value, right : Value) : Either(EvalError, Value) =
    match #(left, right) {
        #(Integer(first), Integer(second)) ->
            match operator {
                '+' ->
                    Right(Integer(first + second))
              | '-' ->
                    Right(Integer(first - second))
              | '*' ->
                    Right(Integer(first * second))
              | _ ->
                    match Int.div(first, second) {
                        Some(quotient) -> Right(Integer(quotient))
                      | None -> Left(DivisionByZero)
                    }
            }
      | _ ->
            Left(NotANumber)
    }
