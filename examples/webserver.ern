//
// Paper program 1: web server with sessions
//
// Written against the Ernest report, September 2026. A web server with
// sessions.
//
// Assumptions. Tcp and Clock are the standard library's system modules (report
// Appendix E) over Sys.tcp and Sys.clock (§8.2). The sessions are a process
// that owns a Map, since state shared by processes is a process (§10).
// errorText is a hand-written rendering for stdout, todo("on paper") here.
// main runs the acceptor itself so the program keeps running (report §8.6).
//
// Run under test since 2026-09-20: the harness starts the server, makes two
// requests over one session, and stops it, since the program itself serves
// until it is stopped.
//

//
// Types
//

type Request = Request(method : String, path : String, headers : List(#(String, String)))
type Response = Response(status : StatusCode, headers : List(#(String, String)), body : String)
type ParseError = BadEncoding | BadRequestLine | BadHeader(String)
type SessionMsg =
    Visit(id : SessionId, reply : Reply(Int)) // the session's visits, this one counted
  | Forget

abstract type StatusCode = StatusCode(Int) with {
    ok : StatusCode;
    notFound : StatusCode;
    render : (StatusCode) -> String
}

abstract type SessionId = SessionId(String) with {
    fresh : (Int) -> SessionId;
    parse : (String) -> Optional(SessionId);
    text : (SessionId) -> String
}

//
// Program
//

export fn main() -> Unit with Never = {
    let sessions = spawn(Local, fn() = sessionStore());
    match Tcp.listen(8080) {
        Right(listener) -> acceptor(sessions, 0, listener)
      | Left(e) -> Io.println("cannot listen: " <> errorText(e))
    }
}

//
// Processes
//

// The session store: the visits of each session, forgotten every ten minutes.
fn sessionStore() -> Unit with SessionMsg = {
    Clock.alarm(600000, fn(_) = Forget);
    store(Map.empty)
}

fn store(counts : Map(SessionId, Int)) -> Unit with SessionMsg = receive {
    Visit(id = id, reply = r) -> {
        let n = Optional.withDefault(Map.get(counts, id), 0) + 1;
        answer(r, n);
        store(Map.put(counts, id, n))
    }
  | Forget -> sessionStore()
}

// The acceptor: one handler process per connection.
fn acceptor(
    sessions : Address(SessionMsg),
    seq : Int,
    listener : Address(ListenerMsg)
) -> Unit with Never =
    match Tcp.accept(listener, 60000) {
        Right(sock) -> {
            let _ = spawn(Local, fn() = handler(sessions, seq, sock));
            acceptor(sessions, seq + 1, listener)
        }
      | Left(Timeout) -> acceptor(sessions, seq, listener)
      | Left(e) -> Io.println("cannot accept: " <> errorText(e))
    }

// One process per connection: reads a request, writes a response, closes.
fn handler(
    sessions : Address(SessionMsg),
    seq : Int,
    sock : Address(SockMsg)
) -> Unit with m = {
    match Tcp.read(sock, 5000) {
        Right(bytes) -> match parse(bytes) {
            Left(_) -> {
                let notFound = Response(status = StatusCode.notFound, headers = [], body = "");
                Tcp.write(sock, render(notFound));
                Tcp.close(sock)
            }
          | Right(req) -> {
                let id = match Optional.andThen(cookie(req, "sid"), SessionId.parse) {
                    Some(sid) -> sid
                  | None -> SessionId.fresh(seq)
                };
                let visits = Address.callForever(sessions, fn(r) = Visit(id = id, reply = r));
                let body = "Visit number " <> Int.toString(visits);
                let bytes = Response(status = StatusCode.ok, headers = [], body = body)
                    |> withCookie("sid", SessionId.text(id))
                    |> render;
                Tcp.write(sock, bytes);
                Tcp.close(sock)
            }
        }
      | Left(_) -> Tcp.close(sock) // nothing arrived in time
    }
}

//
// Pure code: HTTP parsing and rendering
//

fn parse(b : Bytes) -> Either(ParseError, Request) = {
    let t <- Either.fromOptional(String.fromUtf8(b), BadEncoding);
    let lines = String.lines(t);
    let #(method, path) <- requestLine(lines);
    let headers <- headerLines(lines);
    Right(Request(method = method, path = path, headers = headers))
}

// "GET /path HTTP/1.1"; the version is not used.
fn requestLine(lines : List(String)) -> Either(ParseError, #(String, String)) = match lines {
    line :: _ -> match String.split(String.trim(line), " ") {
        method :: path :: _ -> Right(#(method, path))
      | _ -> Left(BadRequestLine)
    }
  | [] -> Left(BadRequestLine)
}

// The lines after the request line, up to the empty one. A name is lowercased,
// since a header name is case-insensitive; a value keeps any colons in it.
fn headerLines(lines : List(String)) -> Either(ParseError, List(#(String, String))) = match lines {
    _ :: rest -> headerPairs(rest, [])
  | [] -> Right([])
}

fn headerPairs(
    lines : List(String),
    acc : List(#(String, String))
) -> Either(ParseError, List(#(String, String))) = match lines {
    [] -> Right(List.reverse(acc))
  | line :: rest ->
        if String.trim(line) == "" then Right(List.reverse(acc))
        else match String.split(line, ":") {
            name :: first :: more -> {
                let value = String.join(first :: more, ":");
                headerPairs(rest, #(String.toLower(String.trim(name)),
                    String.trim(value)) :: acc)
            }
          | _ -> Left(BadHeader(line))
        }
}

fn render(Response(status = s, headers = hs, body = b) : Response) -> Bytes = {
    let body = String.toUtf8(b);
    let start = "HTTP/1.1 " <> StatusCode.render(s);
    let length = "content-length: " <> Int.toString(Bytes.size(body));
    let rest = List.map(hs, fn(#(name, value)) = name <> ": " <> value);
    String.toUtf8(String.join(start :: length :: rest, "\r\n") <> "\r\n\r\n") <> body
}

fn cookie(Request(headers = hs) : Request, name : String) -> Optional(String) =
    Optional.andThen(List.find(hs, fn(#(n, _)) = n == "cookie"),
        fn(#(_, v)) = cookieValue(String.split(v, ";"), name))

fn cookieValue(parts : List(String), name : String) -> Optional(String) = match parts {
    [] -> None
  | part :: rest -> match String.split(String.trim(part), "=") {
        k :: v :: _ when k == name -> Some(v)
      | _ -> cookieValue(rest, name)
    }
}

fn withCookie(
    Response(status = s, headers = hs, body = b) : Response,
    name : String,
    value : String
) -> Response =
    Response(status = s, headers = #("set-cookie", name <> "=" <> value <> "; path=/") :: hs,
        body = b)

fn errorText(e : IoError) -> String = match e {
    NotFound -> "no such file"
  | Denied -> "permission denied"
  | Refused -> "refused"
  | Closed -> "closed"
  | Timeout -> "timed out"
  | Other(text) -> text
}

//
// Abstract-type definitions
//

let StatusCode.ok = StatusCode(200)
let StatusCode.notFound = StatusCode(404)
fn StatusCode.render(StatusCode(n)) = if n == 200 then "200 OK" else "404 Not Found"

fn SessionId.fresh(n) = SessionId(Int.toString(n)) // good enough on paper
fn SessionId.parse(t) =
    if List.all(String.toList(t), Char.isDigit) then Some(SessionId(t)) else None
fn SessionId.text(SessionId(t)) = t
