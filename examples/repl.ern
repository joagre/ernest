//
// REPL
//
// A read-evaluate-print loop for a small language of numbers, `let`, and
// functions of one argument. It reads an expression a line, prints its value
// or what is wrong with it, and ends at the end of its input.
//
// What to look at:
//
// - The lexer, the parser and the evaluator are pure functions, and each
//   answers its errors as a value, an `Either`, which the loop turns into a
//   line of output (report §7.1).
// - Each expression is evaluated in a process of its own, watched with
//   `spawnMonitored`; one that does not end within two seconds is killed
//   with `kill`, and the loop goes on (report §6.9).
//
// Run it from this directory, and type an expression a line:
//
//     ern build repl.ern
//     ern run repl.erc
//
// For example, `let x = 21`, then `x * 2`, then `(fun n -> n * n) 9`.
//

//
// Types
//

type Token =
    Number(Int)
  | Name(String)
  | Operator(Char)
  | OpenParen
  | CloseParen
  | LetKeyword
  | FunKeyword
  | Equals
  | Arrow

type LexError = BadChar(char : Char, index : Int)

type Expression =
    Literal(Int)
  | Variable(String)
  | Binary(operator : Char, left : Expression, right : Expression)
  | Let(name : String, value : Expression)
  | Function(parameter : String, body : Expression)
  | Apply(callee : Expression, argument : Expression)

type ParseError = Unexpected(Token) | EndOfInput

type Value = Integer(Int) | Closure(parameter : String, body : Expression, env : Map(String, Value))

type EvalError = Unbound(String) | DivisionByZero | NotAFunction | NotANumber

type TryError = Eval(EvalError) | Crashed | Timeout

type ReplMsg =
    Answered(serial : Int, result : Either(EvalError, Value))
  | Died(serial : Int, down : Down)

//
// Program
//

export fn main() : Unit with ReplMsg =
    repl(Map.empty, 0)

//
// Processes
//

fn repl(env : Map(String, Value), serial : Int) : Unit with ReplMsg =
    match Io.readLine() {
        None -> Unit // end of input
      | Some(text) -> {
            let #(env1, serial1) = evaluateLine(env, serial, text);
            repl(env1, serial1)
        }
    }

// A line read: its tokens, its expression, and the value it came to,
// shown; then the environment, which a `let` adds its name to, and the
// serial of the last expression tried.
fn evaluateLine(env : Map(String, Value),
                serial : Int,
                text : String) : #(Map(String, Value), Int) with ReplMsg =
    match tokenize(text) {
        Left(BadChar(char = char, index = index)) -> {
            Io.println("illegal character "
                           <> Char.toString(char)
                           <> " at "
                           <> Int.toString(index));
            #(env, serial)
        }
      // a line with nothing on it answers nothing
      | Right([]) -> #(env, serial)
      | Right(tokens) -> match parse(tokens) {
            Left(error) -> {
                Io.println(parseErrorText(error));
                #(env, serial)
            }
          | Right(expression) -> {
                let result = try(env, expression, serial + 1);
                show(result);
                match #(expression, result) {
                    #(Let(name = name), Right(value)) -> #(Map.put(env, name, value), serial + 1)
                  | _ -> #(env, serial + 1)
                }
            }
        }
    }

// try as a process: evaluate in a child, wait at most two seconds,
// kill the child if it does not answer.
fn try(env : Map(String, Value),
       expression : Expression,
       serial : Int) : Either(TryError, Value) with ReplMsg = {
    let me = self(); // not self() inside the lambda: that is the child's
    let child =
        spawnMonitored(fn() : Unit with Never =
                           send(me, Answered(serial = serial, result = eval(env, expression))),
                       fn(down) = Died(serial = serial, down = down));
    await(child, serial)
}

// Every monitor reports a death, a normal return included, and it arrives
// after the answer; a child killed on a timeout reports later still.
// A `Down` names no process, and the child's `Process` (report Appendix
// E.21) exists only after the spawn its wrap is made for, so the serial
// in the message is what tells this child's news from an earlier child's.
fn await(child : Address(Never), serial : Int) : Either(TryError, Value) with ReplMsg =
    receive {
        Answered(serial = carried, result = result) when carried == serial ->
            Either.mapLeft(result, Eval)
      | Died(serial = carried) when carried == serial -> Left(Crashed) // a fault in the child
      | Answered() or Died() -> await(child, serial) // an earlier expression's child
      | after 2000 -> {
            kill(child);
            Left(Timeout)
        }
    }

fn show(result : Either(TryError, Value)) : Unit with ReplMsg =
    Io.println(match result {
        Right(Integer(value)) -> Int.toString(value)
      | Right(Closure()) -> "<fun>"
      | Left(Eval(error)) -> "error: " <> evalErrorText(error)
      | Left(Crashed) -> "crashed"
      | Left(Timeout) -> "aborted after 2 s"
    })

fn parseErrorText(error : ParseError) : String =
    match error {
        Unexpected(token) -> "unexpected " <> tokenText(token)
      | EndOfInput -> "unexpected end of input"
    }

fn tokenText(token : Token) : String =
    match token {
        Number(value) -> Int.toString(value)
      | Name(name) -> name
      | Operator(char) -> Char.toString(char)
      | OpenParen -> "("
      | CloseParen -> ")"
      | LetKeyword -> "let"
      | FunKeyword -> "fun"
      | Equals -> "="
      | Arrow -> "->"
    }

fn evalErrorText(error : EvalError) : String =
    match error {
        Unbound(name) -> "unbound " <> name
      | DivisionByZero -> "division by zero"
      | NotAFunction -> "not a function"
      | NotANumber -> "not a number"
    }

//
// Pure code: lexer
//

fn tokenize(text : String) : Either(LexError, List(Token)) =
    lex(String.toList(text), 0, [])

fn lex(chars : List(Char), index : Int, acc : List(Token)) : Either(LexError, List(Token)) =
    match chars {
        [] -> Right(List.reverse(acc))
      | ' ' :: rest -> lex(rest, index + 1, acc)
      | '(' :: rest -> lex(rest, index + 1, OpenParen :: acc)
      | ')' :: rest -> lex(rest, index + 1, CloseParen :: acc)
      | '=' :: rest -> lex(rest, index + 1, Equals :: acc)
      | '-' :: '>' :: rest -> lex(rest, index + 2, Arrow :: acc)
      | char :: _ when Char.isAsciiDigit(char) -> {
            let #(digits, rest) = List.span(chars, Char.isAsciiDigit);
            let value = Optional.withDefault(String.toInt(String.fromList(digits)), 0);
            lex(rest, index + List.size(digits), Number(value) :: acc)
        }
      | char :: _ when Char.isAlpha(char) -> {
            let #(word, rest) = List.span(chars, Char.isAlpha);
            let token = match String.fromList(word) {
                "let" -> LetKeyword
              | "fun" -> FunKeyword
              | other -> Name(other)
            };
            lex(rest, index + List.size(word), token :: acc)
        }
      | char :: rest when List.contains(['+', '-', '*', '/'], char) ->
            lex(rest, index + 1, Operator(char) :: acc)
      | char :: _ -> Left(BadChar(char = char, index = index))
    }

//
// Pure code: parser
//

// line := 'let' name '=' expression | expression
// expression := 'fun' name '->' expression | sum
// sum := product (('+'|'-') product)*
// product := application (('*'|'/') application)*
// application := atom atom*
// atom := number | name | '(' expression ')'

// A `let` binds a name for the lines after it, so it stands only at a
// line's start; inside an expression it would bind nothing, and is refused
// as the token it is.
fn parse(tokens : List(Token)) : Either(ParseError, Expression) = {
    let #(expression, rest) <- match tokens {
        LetKeyword :: Name(name) :: Equals :: more -> {
            let #(value, remaining) <- parseExpression(more);
            Right(#(Let(name = name, value = value), remaining))
        }
      | _ -> parseExpression(tokens)
    };
    match rest {
        [] -> Right(expression)
      | token :: _ -> Left(Unexpected(token))
    }
}

fn parseExpression(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        FunKeyword :: Name(parameter) :: Arrow :: rest -> {
            let #(body, remaining) <- parseExpression(rest);
            Right(#(Function(parameter = parameter, body = body), remaining))
        }
      | _ -> parseSum(tokens)
    }

fn parseSum(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) = {
    let #(left, rest) <- parseProduct(tokens);
    sumRest(left, rest)
}

fn sumRest(left : Expression,
           tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        Operator(operator) :: rest when operator == '+' || operator == '-' -> {
            let #(right, remaining) <- parseProduct(rest);
            sumRest(Binary(operator = operator, left = left, right = right), remaining)
        }
      | _ -> Right(#(left, tokens))
    }

fn parseProduct(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) = {
    let #(left, rest) <- parseApplication(tokens);
    productRest(left, rest)
}

fn productRest(left : Expression,
               tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        Operator(operator) :: rest when operator == '*' || operator == '/' -> {
            let #(right, remaining) <- parseApplication(rest);
            productRest(Binary(operator = operator, left = left, right = right), remaining)
        }
      | _ -> Right(#(left, tokens))
    }

fn parseApplication(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) = {
    let #(callee, rest) <- parseAtom(tokens);
    applicationRest(callee, rest)
}

fn applicationRest(callee : Expression,
                   tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match parseAtom(tokens) {
        Left(_) -> Right(#(callee, tokens)) // no atom: the application is over
      | Right(#(argument, rest)) ->
            applicationRest(Apply(callee = callee, argument = argument), rest)
    }

fn parseAtom(tokens : List(Token)) : Either(ParseError, #(Expression, List(Token))) =
    match tokens {
        Number(value) :: rest -> Right(#(Literal(value), rest))
      | Name(name) :: rest -> Right(#(Variable(name), rest))
      | OpenParen :: rest -> {
            let #(inner, remaining) <- parseExpression(rest);
            match remaining {
                CloseParen :: beyond -> Right(#(inner, beyond))
              | token :: _ -> Left(Unexpected(token))
              | [] -> Left(EndOfInput)
            }
        }
      | token :: _ -> Left(Unexpected(token))
      | [] -> Left(EndOfInput)
    }

//
// Pure code: evaluator
//

fn eval(env : Map(String, Value), expression : Expression) : Either(EvalError, Value) =
    match expression {
        Literal(value) -> Right(Integer(value))
      | Variable(name) -> match Map.get(env, name) {
            Some(value) -> Right(value)
          | None -> Left(Unbound(name))
        }
      | Function(parameter = parameter, body = body) ->
            Right(Closure(parameter = parameter, body = body, env = env))
      | Let(value = value) -> eval(env, value) // the REPL binds the name, see evaluateLine
      | Binary(operator = operator, left = left, right = right) -> {
            let leftValue <- eval(env, left);
            let rightValue <- eval(env, right);
            arithmetic(operator, leftValue, rightValue)
        }
      | Apply(callee = callee, argument = argument) -> {
            let closure <- eval(env, callee);
            let value <- eval(env, argument);
            match closure {
                Closure(parameter = parameter, body = body, env = captured) ->
                    eval(Map.put(captured, parameter, value), body)
              | Integer(_) -> Left(NotAFunction)
            }
        }
    }

fn arithmetic(operator : Char, left : Value, right : Value) : Either(EvalError, Value) =
    match #(left, right) {
        #(Integer(first), Integer(second)) -> match operator {
            '+' -> Right(Integer(first + second))
          | '-' -> Right(Integer(first - second))
          | '*' -> Right(Integer(first * second))
          | _ -> match Int.div(first, second) {
                Some(quotient) -> Right(Integer(quotient))
              | None -> Left(DivisionByZero)
            }
        }
      | _ -> Left(NotANumber)
    }
