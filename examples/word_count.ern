//
// Word count, written once over two kinds of map
//
// Counts the words of the file named on the command line twice: once in the
// hash map `Map`, and once in `OrderedMap`, which keeps its keys in order.
// The counting is one function, `counted`, which takes the operations it
// needs as a record, so the caller chooses the map. Each map's counts are
// printed in the order the map gives them: the hash map's in an order of
// its own, the ordered map's alphabetically, with no sort written. Then the
// two most frequent words.
//
// What to look at:
//
// - `Counts(m)` is an operations record: a type the program declares, whose
//   fields are the operations `counted` uses, over the map's type `m`.
// - `Counts(..Map)` and `Counts(..OrderedMap)` fill it from each module, by
//   the names of its fields (report §5.6).
// - `OrderedMap.put` needs the keys' order, `needs k.compare`; the fill
//   supplies `String.compare` without a word written for it (report §4.9).
// - `Entry` derives its order, so the most frequent words sort by count and
//   then by word (report §3.5).
//
// Run it from this directory, on one of the examples:
//
//     ern build word_count.ern
//     ern run word_count.erc hello.ern
//

// The operations counting needs, over a map from words to counts.
type Counts(m) =
    Counts(empty : m,
           get : (m, String) -> Optional(Int),
           put : (m, String, Int) -> m,
           toList : (m) -> List(#(String, Int)))

// A word and how often it was seen, ordered by count and then by word.
type Entry = Entry(count : Int, word : String) derives compare

let hashed : Counts(Map(String, Int)) = Counts(..Map)

let ordered : Counts(OrderedMap.Map(String, Int)) = Counts(..OrderedMap)

export fn main() : Unit =
    match Os.arguments {
        [name] -> match Fs.read(Path(name), 5000) {
            Right(bytes) -> match String.fromUtf8(bytes) {
                Some(text) -> report(String.words(text))
              | None -> fail(name <> ": not UTF-8 text")
            }
          | Left(error) -> fail(name <> ": " <> Io.show(error))
        }
      | _ -> {
            Io.printlnError("usage: word_count file");
            Os.exit(2)
        }
    }

// Each map's counts of the words, and the two most frequent.
fn report(words : List(String)) : Unit = {
    let inOrder = counted(words, ordered);
    Io.println("by hash: " <> shown(counted(words, hashed)));
    Io.println("in order: " <> shown(inOrder));
    Io.println("most frequent: " <> String.join(List.map(mostFrequent(inOrder, 2), wordOf), ", "))
}

// Why the file could not be counted, on standard error, and the status 1.
fn fail(cause : String) : Unit = {
    Io.printlnError("word_count: " <> cause);
    Os.exit(1)
}

// Each word with how often it occurs, in the order the map gives.
fn counted(words : List(String), counts : Counts(m)) : List(#(String, Int)) =
    counts.toList(List.foldLeft(words,
                                counts.empty,
                                fn(map, word) =
                                    counts.put(map,
                                               word,
                                               Optional.withDefault(counts.get(map, word), 0) + 1)))

// The `count` words seen most, the most frequent first.
fn mostFrequent(pairs : List(#(String, Int)), count : Int) : List(Entry) =
    List.map(pairs, fn(#(word, seen)) = Entry(count = seen, word = word))
        |> List.sort(fn(left, right) = Entry.compare(right, left))
        |> List.take(count)

fn wordOf(entry : Entry) : String =
    entry.word

fn shown(pairs : List(#(String, Int))) : String =
    String.join(List.map(pairs, fn(#(word, count)) = word <> " " <> Int.toString(count)), ", ")
