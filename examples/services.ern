//
// Three services under one supervisor
//
// A store, a source of ids, and an audit log, each a top-level binding spawned as a child
// of `services` (report Appendix E.22). The store is corrupted on purpose. Under
// RestForOne the store restarts, and so do the two services that joined after it; every
// binding still names its service, and each answers from its first state.
//
// Needs MVP 2.66. The fault line on standard error names the binding,
// Services.store:26 (report §6.9).
//

type StoreMsg =
    Put(key : String, value : Int)
  | Get(key : String, reply : Reply(Optional(Int)))
  | Corrupt

type IdMsg = NextId(reply : Reply(Int))

type AuditMsg = Record(String) | Entries(reply : Reply(List(String)))

let services : Address(Supervisor.Msg) =
    spawn(Local,
          Supervisor.group(Supervisor.RestForOne, RestartLimit(restarts = 3, within = 10000)))

let store : Address(StoreMsg) = spawn(Local, Supervisor.child(services, fn() = storing(Map.empty)))

fn storing(items : Map(String, Int)) : Unit with StoreMsg =
    receive {
        Put(key = k, value = v) -> storing(Map.put(items, k, v))
      | Get(key = k, reply = r) -> {
            answer(r, Map.get(items, k));
            storing(items)
        }
      | Corrupt -> fault("the store was corrupted")
    }

let ids : Address(IdMsg) = spawn(Local, Supervisor.child(services, fn() = counting(1)))

fn counting(next : Int) : Unit with IdMsg =
    receive {
        NextId(reply = r) -> {
            answer(r, next);
            counting(next + 1)
        }
    }

let audit : Address(AuditMsg) = spawn(Local, Supervisor.child(services, fn() = recording([])))

fn recording(entries : List(String)) : Unit with AuditMsg =
    receive {
        Record(e) -> recording(entries <> [e])
      | Entries(reply = r) -> {
            answer(r, entries);
            recording(entries)
        }
    }

export fn main() : Unit with Never = {
    put("apples", 3);
    put("pears", 5);
    report("before");
    send(store, Corrupt);
    // the restart is asynchronous, and a call made during it may be answered from the old
    // state or end (report §6.6); main waits so that its output is the same on every run
    receive {
        after 500 -> Unit
    };
    report("after the restart")
}

fn put(key : String, value : Int) : Unit with m = {
    let id = Address.callForever(ids, fn(r) = NextId(reply = r));
    send(store, Put(key = key, value = value));
    send(audit, Record(Int.toString(id) <> ": put " <> key))
}

fn report(moment : String) : Unit with m = {
    let apples = match Address.callForever(store, fn(r) = Get(key = "apples", reply = r)) {
        Some(n) -> Int.toString(n)
      | None -> "none"
    };
    let entries = Address.callForever(audit, fn(r) = Entries(reply = r));
    let id = Address.callForever(ids, fn(r) = NextId(reply = r));
    Io.println(moment
                   <> ": apples "
                   <> apples
                   <> ", next id "
                   <> Int.toString(id)
                   <> ", audit ["
                   <> String.join(entries, "; ")
                   <> "]")
}
