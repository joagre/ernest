//
// Three services under one supervisor
//
// A store, a source of ids, and an audit log, each a top-level binding spawned as a child
// of `services` (report Appendix E.22). The store is corrupted on purpose. Under
// RestForOne the store restarts, and so do the two services spawned after it; every
// binding still names its service, and each answers from its first state.
//
// Needs MVP 2.66. The fault line on standard error names the binding,
// Services.store:25 (report §6.9).
//

type StoreMsg =
    Put(key : String, value : Int)
  | Get(key : String, reply : Reply(Optional(Int)))
  | Corrupt

type IdMsg = NextId(reply : Reply(Int))

type AuditMsg = Record(String) | Entries(reply : Reply(List(String)))

let services : Address(Supervisor.Msg) =
    spawn(Supervisor.group(Supervisor.RestForOne, RestartLimit(restarts = 3, within = 10000)))

let store : Address(StoreMsg) = spawn(Supervisor.child(services, fn() = storing(Map.empty)))

fn storing(items : Map(String, Int)) : Unit with StoreMsg =
    receive {
        Put(key = key, value = value) -> storing(Map.put(items, key, value))
      | Get(key = key, reply = reply) -> {
            answer(reply, Map.get(items, key));
            storing(items)
        }
      | Corrupt -> fault("the store was corrupted")
    }

let ids : Address(IdMsg) = spawn(Supervisor.child(services, fn() = counting(1)))

fn counting(next : Int) : Unit with IdMsg =
    receive {
        NextId(reply = reply) -> {
            answer(reply, next);
            counting(next + 1)
        }
    }

let audit : Address(AuditMsg) = spawn(Supervisor.child(services, fn() = recording([])))

fn recording(entries : List(String)) : Unit with AuditMsg =
    receive {
        Record(entry) -> recording(entries <> [entry])
      | Entries(reply = reply) -> {
            answer(reply, entries);
            recording(entries)
        }
    }

export fn main() : Unit with Never = {
    put("apples", 3);
    put("pears", 5);
    report("before");
    send(store, Corrupt);
    report("after the restart")
}

fn put(key : String, value : Int) : Unit with m = {
    let id = Address.callForever(ids, fn(reply) = NextId(reply = reply));
    send(store, Put(key = key, value = value));
    send(audit, Record(Int.toString(id) <> ": put " <> key))
}

fn report(label : String) : Unit with m = {
    let apples = match stored("apples") {
        Some(count) -> Int.toString(count)
      | None -> "none"
    };
    let entries = Address.callForever(audit, fn(reply) = Entries(reply = reply));
    let id = Address.callForever(ids, fn(reply) = NextId(reply = reply));
    Io.println(label
                   <> ": apples "
                   <> apples
                   <> ", next id "
                   <> Int.toString(id)
                   <> ", audit ["
                   <> String.join(entries, "; ")
                   <> "]")
}

// The store's value for a key. A call waiting on the store when it faults ends (report
// §6.6), and one made again is answered once its group has restarted whole (Appendix
// E.22), so the services asked after it answer from their first state too.
fn stored(key : String) : Optional(Int) with m =
    match Address.call(store, fn(reply) = Get(key = key, reply = reply), 1000) {
        Some(value) -> value
      | None -> stored(key)
    }
