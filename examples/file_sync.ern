//
// File sync
//
// Keeps two directories, a and b, identical. Each is watched by a process
// of its own, which sends what changed to its peer; a file the peer sends
// where this side's copy is newer is saved beside it as a conflict. It runs
// until it is stopped.
//
// What to look at:
//
// - The two processes learn each other's address from a message, `Link`,
//   since an address is a value that travels like any other (report §6.5).
// - A process asks the file system and the clock through the standard
//   library, and a failure comes back as a value (Fs and Clock, report
//   Appendix E.17 and E.15).
// - The program's own tests, `ern test`, check that a file the peer names is
//   stored only inside the directory.
//
// Both directories are served on one node. Each side knows its peer only by
// an address, so the same code would keep a directory on another node in
// step, once Ernest has peers.
//
// Run it from this directory, in a directory of its own:
//
//     ern build file_sync.ern
//     mkdir -p /tmp/sync/a /tmp/sync/b
//     cd /tmp/sync && ern run $OLDPWD/file_sync.erc
//

//
// Types
//

type Change = Change(path : Path, mtime : Int)

type Ack = Stored | Conflict | Failed(Io.Error)

type SyncMsg =
    Link(Address(SyncMsg))
  | Ticked
  | Listed(Either(Io.Error, List(Fs.Entry)))
  | Put(path : Path, mtime : Int, bytes : Bytes, reply : Reply(Ack))

//
// Program
//

export fn main() : Unit with SyncMsg = {
    let me = self();
    let peer = spawn(fn() = start(Path("b")));
    send(peer, Link(me));
    send(me, Link(peer));
    start(Path("a"))
}

//
// Processes
//

// Waiting phase: receive the peer's address, then the loop.
fn start(directory : Path) : Unit with SyncMsg =
    receive {
        Link(peer) -> {
            send(self(), Ticked);
            syncer(directory, peer, Map.empty)
        }
    }

// The sync process: one per directory.
fn syncer(directory : Path, peer : Address(SyncMsg), seen : Map(Path, Int)) : Unit with SyncMsg =
    receive {
        Ticked -> {
            let me = self();
            let _ = spawn(fn() : Unit with Never = send(me, Listed(Fs.list(directory, 10000))));
            listing(directory, peer, seen)
        }
      | Put(path = path, mtime = mtime, bytes = bytes, reply = reply) ->
            syncer(directory, peer, store(directory, seen, path, mtime, bytes, reply))
      | Listed(_) -> syncer(directory, peer, seen) // late listing, ignore
      | Link(_) -> syncer(directory, peer, seen) // already connected
    }

// Between the listing's start and Listed, a Put waits in the mailbox and is
// stored after it, so that the snapshot the listing gives does not lose the
// time of a file stored meanwhile.
fn listing(directory : Path, peer : Address(SyncMsg), seen : Map(Path, Int)) : Unit with SyncMsg = {
    let tick = fn() = Clock.alarm(5000, fn(_) = Ticked);
    receive {
        Listed(Right(entries)) -> {
            List.foreach(diff(seen, entries), fn(change) = {
                let _ = spawn(fn() = pusher(peer, change));
                Unit
            });
            tick();
            syncer(directory, peer, snapshot(entries))
        }
      | Listed(Left(error)) -> {
            Io.println("cannot list " <> Path.toString(directory) <> ": " <> errorText(error));
            tick();
            syncer(directory, peer, seen)
        }
    }
}

// Store a file from the peer, and what is known of the directory after
// it. A path that is not a name in this directory is refused: the peer is
// another program, and its paths are not this one's to follow.
fn store(directory : Path,
         seen : Map(Path, Int),
         path : Path,
         mtime : Int,
         bytes : Bytes,
         reply : Reply(Ack)) : Map(Path, Int) with SyncMsg =
    if !isName(path) then {
        // shown as a value, so that no character of it reaches the terminal
        // as a control
        Io.println("refused a path from the peer: " <> Io.show(path));
        answer(reply, Failed(Io.Denied));
        seen
    } else {
        let here = directory <> path;
        let _ = spawn(fn() = writer(here, bytes, mtime, reply));
        Map.put(seen, here, mtime)
    }

// A name in a directory: one segment, not `.` or `..`, and not a root
// (report E.17).
fn isName(path : Path) : Bool =
    match Path.split(path) {
        [name] -> !Path.isAbsolute(path) && name != "." && name != ".."
      | _ -> false
    }

// One process per write: waits for Fs and answers the peer. Where the
// file here is newer than the peer's, as it stands now, the peer's is saved
// beside it as a conflict. The file takes the peer's modification time,
// which the next listing then finds as it was recorded, so that a file
// stored is not sent back.
fn writer(path : Path, bytes : Bytes, mtime : Int, reply : Reply(Ack)) : Unit with n = {
    let isNewerHere = match Fs.stat(path, 10000) {
        Right(entry) -> entry.mtime > mtime
      | Left(_) -> false
    };
    let #(target, ack) = if isNewerHere then #(conflictPath(path), Conflict) else #(path, Stored);
    match Either.andThen(Fs.write(target, bytes, 10000),
                         fn(_) = Fs.setModified(target, mtime, 10000)) {
        Right(Unit) -> answer(reply, ack)
      | Left(error) -> answer(reply, Failed(error))
    }
}

// One process per changed file: reads and sends to the peer.
fn pusher(peer : Address(SyncMsg), Change(path = path, mtime = mtime) : Change) : Unit with n =
    match Fs.read(path, 10000) {
        Right(bytes) -> match Path.name(path) {
            Some(name) -> push(peer, Path(name), mtime, bytes)
          | None -> Io.println("cannot push " <> Path.toString(path) <> ", which names no file")
        }
      | Left(error) -> Io.println("cannot read " <> Path.toString(path) <> ": " <> errorText(error))
    }

fn push(peer : Address(SyncMsg), path : Path, mtime : Int, bytes : Bytes) : Unit with n =
    match Address.call(peer,
                       fn(reply) = Put(path = path, mtime = mtime, bytes = bytes, reply = reply),
                       30000) {
        Some(Stored) -> Unit
      | Some(Conflict) -> Io.println("conflict: " <> Path.toString(path))
      | Some(Failed(_)) -> Io.println("the peer failed: " <> Path.toString(path))
      | None -> Io.println("the peer is not answering: " <> Path.toString(path))
    }

//
// Pure helpers
//

// The files that have changed since the last snapshot; a directory, a
// link and anything else that is no regular file is passed over.
fn diff(seen : Map(Path, Int), entries : List(Fs.Entry)) : List(Change) =
    List.filterMap(entries,
                   fn(entry) = if entry.kind == Fs.File then changed(seen, entry) else None)

fn changed(seen : Map(Path, Int),
           Fs.Entry(path = path, mtime = mtime) : Fs.Entry) : Optional(Change) =
    match Map.get(seen, path) {
        None -> Some(Change(path = path, mtime = mtime))
      | Some(before) -> if mtime > before then Some(Change(path = path, mtime = mtime)) else None
    }

fn snapshot(entries : List(Fs.Entry)) : Map(Path, Int) =
    List.foldLeft(entries, Map.empty, fn(acc, entry) = Map.put(acc, entry.path, entry.mtime))

fn conflictPath(path : Path) : Path =
    Path(Path.toString(path) <> ".conflict")

fn errorText(error : Io.Error) : String =
    match error {
        Io.NotFound -> "no such file"
      | Io.Denied -> "permission denied"
      | Io.Refused -> "refused"
      | Io.Closed -> "closed"
      | Io.Timeout -> "timed out"
      | Io.NotATerminal -> "not a terminal"
      | Io.NotAFile -> "not a regular file"
      | Io.Exists -> "exists"
      | Io.NotUtf8(_) -> "not UTF-8"
      | Io.Invalid -> "invalid argument"
      | Io.NotListed -> "no peer listed"
      | Io.Unreachable -> "unreachable"
      | Io.NotOffered -> "not offered"
      | Io.OtherType -> "offered at another type"
      | Io.NotLoaded -> "not loaded"
      | Io.Other(text) -> text
    }

//
// Tests, run by `ern test`
//

let namesOnly =
    Test.Case(name = "a peer's path is stored only where it names a file here", run = fn() = {
        let accepted =
            List.map(["notes.txt", "../x", "/etc/x", "a/b", ".", "..", ""],
                     fn(text) = isName(Path(text)));
        Test.equal(accepted, [true, false, false, false, false, false, false])
    })
