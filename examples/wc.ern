//
// wc: lines, words and bytes of the files named
//
// A command-line tool in the manner of `wc`. For each file named on the
// command line it prints its lines, its words and its bytes, and then the
// total. A file it cannot read is reported on standard error by name, the
// others are still counted, and the program ends with status 1. Run with no
// file, it says how it is called and ends with status 2.
//
// What to look at:
//
// - `Os.arguments` is the command line after the program's own name, and
//   `Os.exit` ends the program with a status (report Appendix E.23).
// - `measured` is pure: it counts bytes it is given. Reading the file is
//   the one thing that acts, and its failure is a value, an `Either`, which
//   `counted` turns into a line on standard error (report §7.1).
// - `<-` takes the `Right` of an `Either` and gives up at the first `Left`
//   (report §5.5).
// - `Counts` is a record, read by field, `counts.words`, and summed with an
//   operator it declares, `Counts.+` (report §4.8).
//
// Run it from this directory, on two of the examples:
//
//     ern build wc.ern
//     ern run wc.erc hello.ern wc.ern
//

type Counts = Counts(lines : Int, words : Int, bytes : Int)

fn Counts.+(left : Counts, right : Counts) : Counts =
    Counts(lines = left.lines + right.lines,
           words = left.words + right.words,
           bytes = left.bytes + right.bytes)

let nothing : Counts = Counts(lines = 0, words = 0, bytes = 0)

export fn main() : Unit =
    match Os.arguments {
        [] -> {
            Io.printlnError("usage: wc file...");
            Os.exit(2)
        }
      | names -> {
            let results = List.map(names, counted);
            let total = List.foldLeft(results, nothing, fn(sum, result) = match result {
                Right(counts) -> sum + counts
              | Left(_) -> sum
            });
            Io.println(line(total, "total"));
            if List.any(results, Either.isLeft) then Os.exit(1) else Unit
        }
    }

// The file's counts, printed, or why it could not be read, on standard error.
fn counted(name : String) : Either(String, Counts) =
    match read(name) {
        Right(counts) -> {
            Io.println(line(counts, name));
            Right(counts)
        }
      | Left(cause) -> {
            Io.printlnError("wc: " <> name <> ": " <> cause);
            Left(cause)
        }
    }

fn read(name : String) : Either(String, Counts) = {
    let bytes <- Either.mapLeft(Fs.read(Path(name), 5000), errorText);
    match String.fromUtf8(bytes) {
        Some(text) -> Right(measured(text, Bytes.size(bytes)))
      | None -> Left("not UTF-8 text")
    }
}

// The errors the program says in its own words, and the rest as the
// library shows them.
fn errorText(error : Io.Error) : String =
    match error {
        Io.NotFound -> "no such file"
      | Io.Denied -> "permission denied"
      | Io.NotAFile -> "not a regular file"
      | _ -> Io.show(error)
    }

fn measured(text : String, size : Int) : Counts =
    Counts(lines = List.size(String.lines(text)),
           words = List.size(String.words(text)),
           bytes = size)

fn line(counts : Counts, name : String) : String =
    String.join([Int.toString(counts.lines),
                 Int.toString(counts.words),
                 Int.toString(counts.bytes),
                 name],
                " ")
