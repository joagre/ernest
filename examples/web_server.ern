//
// Web server with sessions
//
// A small web server that keeps a session for each client by a cookie and
// counts its visits. It serves until it is stopped.
//
// What to look at:
//
// - The sessions are a process that owns a `Map`: state that several
//   processes share is a process, and they ask it by request and reply
//   (report §6.6).
// - Each connection is a socket, itself a process, which the server reads
//   and writes through its address (Tcp, report Appendix E.18).
// - The request is read from the socket by `Http.readRequest`, and the
//   response written by `Http.renderResponse`, which adds its
//   `Content-Length` and its status's phrase (libs/http, report Appendix
//   G.11).
// - A session id is sixteen bytes drawn at random, which a client cannot
//   guess (libs/crypto, report Appendix G.9).
// - The session store forgets its sessions every ten minutes, by an alarm
//   it sets itself (Clock, report Appendix E.15).
//
// Run it from this directory, and visit it from a second terminal:
//
//     ern build web_server.ern
//     ern run web_server.erc
//     curl -c jar -b jar http://127.0.0.1:8080/
//

//
// Types
//

type SessionMsg =
    Visit(id : SessionId, reply : Reply(Int)) // the session's visits, this one counted
  | Forget

type SessionId = SessionId(Bytes)

//
// Program
//

export fn main() : Unit = {
    let sessions = spawn(fn() = sessionStore());
    match Tcp.listen("127.0.0.1", 8080) {
        Right(listener) -> {
            Io.println("listening on 127.0.0.1:8080");
            acceptor(sessions, listener)
        }
      | Left(error) ->
            Io.println("cannot listen: " <> errorText(error))
    }
}

//
// Processes
//

// The session store: the visits of each session, forgotten every ten minutes.
fn sessionStore() : Unit receiving SessionMsg = {
    let _ = Clock.alarm(600000, fn(_) = Forget);
    store(Map.empty)
}

fn store(counts : Map(SessionId, Int)) : Unit receiving SessionMsg =
    receive {
        Visit(=id, =reply) -> {
            let visits = Optional.withDefault(Map.get(counts, id), 0) + 1;
            answer(reply, visits);
            store(Map.put(counts, id, visits))
        }
      | Forget ->
            sessionStore()
    }

// The acceptor: one handler process per connection.
fn acceptor(sessions : Address(SessionMsg), listener : Address(Tcp.ListenerMsg)) : Unit =
    match Tcp.accept(listener, 60000) {
        Right(socket) -> {
            // the handler owns its connection, which ends with it
            let handler = spawn(fn() = handle(sessions, socket));
            Tcp.give(socket, Process.fromAddress(handler));
            acceptor(sessions, listener)
        }
      | Left(Io.Timeout) ->
            acceptor(sessions, listener)
      | Left(error) ->
            Io.println("cannot accept: " <> errorText(error))
    }

// One process per connection: reads a request, writes a response, closes.
fn handle(sessions : Address(SessionMsg), socket : Address(Tcp.SocketMsg)) : Unit =
    match Http.readRequest(socket, <<>>, limits, 5000) {
        Right(#(request, _)) -> {
            let id = match Optional.andThen(cookie(request.headers, "sid"), parseSessionId) {
                Some(found) -> found
              | None -> freshSessionId()
            };
            let visits = Address.callForever(sessions, fn(reply) = Visit(=id, =reply));
            let body = String.toUtf8("Visit number " <> Int.toString(visits));
            let setCookie = "sid=" <> sessionIdText(id) <> "; path=/";
            let headers = Http.Header(name = "Set-Cookie", value = setCookie) :: closingHeaders();
            let _ = Tcp.write(socket, Http.renderResponse(response(200, headers), body), 5000);
            Tcp.close(socket)
        }
      | Left(Http.Protocol(_)) -> {
            // the connection is closed whether the far end took it or not
            let _ =
                Tcp.write(socket, Http.renderResponse(response(400, closingHeaders()), <<>>), 5000);
            Tcp.close(socket)
        }
      | Left(Http.Socket(_)) ->
            Tcp.close(socket) // no whole request arrived in time
    }

//
// Pure code: requests and responses
//

// The most bytes of a request's line, and of its headers together.
let limits = Http.Limits(line = 8192, headers = 65536)

// A response of HTTP/1.1, the version the server speaks.
fn response(status : Int, headers : List(Http.Header)) : Http.Response =
    Http.Response(version = Http.Version(major = 1, minor = 1), =status, =headers)

// The headers every response carries: the date it is sent, which an origin
// server with a clock sends (RFC 9110 §6.6.1), and that the server closes
// the connection after it.
fn closingHeaders() : List(Http.Header) =
    [Http.Header(name = "Date", value = Http.date(Clock.now())),
     Http.Header(name = "Connection", value = "close")]

// The value of the cookie `name` in the request's `Cookie` header.
fn cookie(headers : List(Http.Header), name : String) : Optional(String) =
    Optional.andThen(Http.header(headers, "Cookie"),
                     fn(value) = cookieValue(String.split(value, ";"), name))

fn cookieValue(parts : List(String), name : String) : Optional(String) =
    match parts {
        [] ->
            None
      | part :: rest ->
            match String.splitOnce(String.trim(part), "=") {
                Some(#(key, value)) when key == name -> Some(value)
              | _ -> cookieValue(rest, name)
            }
    }

// The errors the program says in its own words, and the rest as the
// library shows them.
fn errorText(error : Io.Error) : String =
    match error {
        Io.Denied -> "permission denied"
      | Io.Other(text) -> text
      | _ -> Io.show(error)
    }

//
// Session ids
//

// Sixteen bytes from the host's strong random source.
fn freshSessionId() : SessionId =
    SessionId(Crypto.randomBytes(16))

// An id as `sessionIdText` writes it, thirty-two hexadecimal digits.
fn parseSessionId(text : String) : Optional(SessionId) = {
    let bytes <- Bytes.fromHex(text);
    if Bytes.size(bytes) == 16 then Some(SessionId(bytes)) else None
}

fn sessionIdText(SessionId(bytes) : SessionId) : String =
    Bytes.toHex(bytes)
