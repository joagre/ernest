//
// Web server with sessions
//
// A small web server that keeps a session for each client by a cookie and
// counts its visits. It serves until it is stopped.
//
// What to look at:
//
// - The sessions are a process that owns a `Map`: state that several
//   processes share is a process, and they ask it by request and reply
//   (report §6.6).
// - Each connection is a socket, itself a process, which the server reads
//   and writes through its address (Tcp, report Appendix E.18).
// - The session store forgets its sessions every ten minutes, by an alarm
//   it sets itself (Clock, report Appendix E.15).
//
// Two things are simpler than a real server would have them, and wait for
// libraries Ernest does not have yet. A session id is the connection's
// number, which a client could guess; a cryptographic library would draw it
// at random. And the request is parsed by hand, a small part of HTTP/1.1:
// the version is not read and a chunked body is not understood; an HTTP
// library would replace `parse` and `render`.
//
// Run it from this directory, and visit it from a second terminal:
//
//     ern build web_server.ern
//     ern run web_server.erc
//     curl -c jar -b jar http://127.0.0.1:8080/
//

//
// Types
//

type Request = Request(method : String, path : String, headers : List(#(String, String)))

type Response = Response(status : StatusCode, headers : List(#(String, String)), body : String)

type ParseError = BadEncoding | BadRequestLine | BadHeader(String)

type SessionMsg =
    Visit(id : SessionId, reply : Reply(Int)) // the session's visits, this one counted
  | Forget

type StatusCode = StatusCode(Int)

type SessionId = SessionId(String)

//
// Program
//

export fn main() : Unit with Never = {
    let sessions = spawn(fn() = sessionStore());
    match Tcp.listen("127.0.0.1", 8080) {
        Right(listener) -> {
            Io.println("listening on 127.0.0.1:8080");
            acceptor(sessions, 0, listener)
        }
      | Left(error) -> Io.println("cannot listen: " <> errorText(error))
    }
}

//
// Processes
//

// The session store: the visits of each session, forgotten every ten minutes.
fn sessionStore() : Unit with SessionMsg = {
    Clock.alarm(600000, fn(_) = Forget);
    store(Map.empty)
}

fn store(counts : Map(SessionId, Int)) : Unit with SessionMsg =
    receive {
        Visit(id = id, reply = reply) -> {
            let visits = Optional.withDefault(Map.get(counts, id), 0) + 1;
            answer(reply, visits);
            store(Map.put(counts, id, visits))
        }
      | Forget -> sessionStore()
    }

// The acceptor: one handler process per connection.
fn acceptor(sessions : Address(SessionMsg),
            accepted : Int,
            listener : Address(Tcp.ListenerMsg)) : Unit with Never =
    match Tcp.accept(listener, 60000) {
        Right(socket) -> {
            // the handler owns its connection, which ends with it
            let handler = spawn(fn() = handle(sessions, accepted, socket));
            Tcp.give(socket, Process.fromAddress(handler));
            acceptor(sessions, accepted + 1, listener)
        }
      | Left(Io.Timeout) -> acceptor(sessions, accepted, listener)
      | Left(error) -> Io.println("cannot accept: " <> errorText(error))
    }

// One process per connection: reads a request, writes a response, closes.
fn handle(sessions : Address(SessionMsg),
          connection : Int,
          socket : Address(Tcp.SocketMsg)) : Unit with m =
    match Tcp.read(socket, 5000) {
        Right(bytes) -> match parse(bytes) {
            Left(_) -> {
                let bad = Response(status = statusBadRequest, headers = [], body = "");
                // the connection is closed whether the far end took it or not
                let _ = Tcp.write(socket, render(bad), 5000);
                Tcp.close(socket)
            }
          | Right(request) -> {
                let id = match Optional.andThen(cookie(request, "sid"), parseSessionId) {
                    Some(found) -> found
                  | None -> freshSessionId(connection)
                };
                let visits =
                    Address.callForever(sessions, fn(reply) = Visit(id = id, reply = reply));
                let body = "Visit number " <> Int.toString(visits);
                let bytes =
                    Response(status = statusOk, headers = [], body = body)
                        |> withCookie("sid", sessionIdText(id))
                        |> render;
                let _ = Tcp.write(socket, bytes, 5000);
                Tcp.close(socket)
            }
        }
      | Left(_) -> Tcp.close(socket) // nothing arrived in time
    }

//
// Pure code: HTTP parsing and rendering
//

fn parse(bytes : Bytes) : Either(ParseError, Request) = {
    let text <- Either.fromOptional(String.fromUtf8(bytes), BadEncoding);
    let lines = String.lines(text);
    let #(method, path) <- requestLine(lines);
    let headers <- headerLines(lines);
    Right(Request(method = method, path = path, headers = headers))
}

// "GET /path HTTP/1.1"; the version is not used.
fn requestLine(lines : List(String)) : Either(ParseError, #(String, String)) =
    match lines {
        line :: _ -> match String.split(String.trim(line), " ") {
            method :: path :: _ -> Right(#(method, path))
          | _ -> Left(BadRequestLine)
        }
      | [] -> Left(BadRequestLine)
    }

// The lines after the request line, up to the empty one. A name is lowercased,
// since a header name is case-insensitive; a value keeps any colons in it.
fn headerLines(lines : List(String)) : Either(ParseError, List(#(String, String))) =
    match lines {
        _ :: rest -> headerPairs(rest, [])
      | [] -> Right([])
    }

fn headerPairs(lines : List(String),
               acc : List(#(String, String))) : Either(ParseError, List(#(String, String))) =
    match lines {
        [] -> Right(List.reverse(acc))
      | line :: rest -> if String.trim(line) == "" then
            Right(List.reverse(acc))
        else match String.split(line, ":") {
            name :: first :: more -> {
                let value = String.join(first :: more, ":");
                headerPairs(rest, #(String.toLower(String.trim(name)), String.trim(value)) :: acc)
            }
          | _ -> Left(BadHeader(line))
        }
    }

fn render(response : Response) : Bytes = {
    let body = String.toUtf8(response.body);
    let statusLine = "HTTP/1.1 " <> statusText(response.status);
    let lengthHeader = "content-length: " <> Int.toString(Bytes.size(body));
    let headers = List.map(response.headers, fn(#(name, value)) = name <> ": " <> value);
    String.toUtf8(String.join(statusLine :: lengthHeader :: headers, "\r\n") <> "\r\n\r\n") <> body
}

fn cookie(request : Request, name : String) : Optional(String) =
    Optional.andThen(List.find(request.headers, fn(#(field, _)) = field == "cookie"),
                     fn(#(_, value)) = cookieValue(String.split(value, ";"), name))

fn cookieValue(parts : List(String), name : String) : Optional(String) =
    match parts {
        [] -> None
      | part :: rest -> match String.split(String.trim(part), "=") {
            key :: value :: _ when key == name -> Some(value)
          | _ -> cookieValue(rest, name)
        }
    }

fn withCookie(response : Response, name : String, value : String) : Response =
    Response(..response,
             headers = #("set-cookie", name <> "=" <> value <> "; path=/") :: response.headers)

fn errorText(error : Io.Error) : String =
    match error {
        Io.NotFound -> "no such file"
      | Io.Denied -> "permission denied"
      | Io.Refused -> "refused"
      | Io.Closed -> "closed"
      | Io.Timeout -> "timed out"
      | Io.NotATerminal -> "not a terminal"
      | Io.NotAFile -> "not a regular file"
      | Io.Exists -> "exists"
      | Io.NotUtf8(_) -> "not UTF-8"
      | Io.Invalid -> "invalid argument"
      | Io.NotListed -> "no peer listed"
      | Io.Unreachable -> "unreachable"
      | Io.NotOffered -> "not offered"
      | Io.OtherType -> "offered at another type"
      | Io.NotLoaded -> "not loaded"
      | Io.Other(text) -> text
    }

//
// Status codes and session ids
//

let statusOk = StatusCode(200)

let statusBadRequest = StatusCode(400)

// The status line's code and reason, each code the program answers with
// its own; any other, which it does not answer, as its number, the reason
// being optional (RFC 9112).
fn statusText(StatusCode(code) : StatusCode) : String =
    match code {
        200 -> "200 OK"
      | 400 -> "400 Bad Request"
      | other -> Int.toString(other) <> " "
    }

fn freshSessionId(connection : Int) : SessionId =
    SessionId(Int.toString(connection))

fn parseSessionId(text : String) : Optional(SessionId) =
    if !String.isEmpty(text) && List.all(String.toList(text), Char.isAsciiDigit) then
        Some(SessionId(text))
    else
        None

fn sessionIdText(SessionId(text) : SessionId) : String =
    text
