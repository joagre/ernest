//
// Abstract stack
//
// The abstract type of the guide, §7.2 (and the report, §4.4), plus a small
// main that uses it. Another module sees the type Stack.Stack and its three
// operations, Stack.empty, Stack.push and Stack.pop, never its constructor;
// this module's own definitions, main among them, may use it. The main is not
// from the guide.
//
// Needs MVP 1, and is one of its test programs.
//

export abstract type Stack(a) = Stack(List(a))

export fn main() : Unit with Never = {
    let s = push(push(empty, 1), 2);
    match pop(s) {
        Some(#(top, _)) -> Io.println("top is " <> Int.toString(top))
      | None -> Io.println("empty")
    }
}

export let empty : Stack(a) = Stack([])

export fn push(Stack(xs) : Stack(a), x : a) : Stack(a) =
    Stack(x :: xs)

export fn pop(Stack(xs) : Stack(a)) : Optional(#(a, Stack(a))) =
    match xs {
        [] -> None
      | x :: rest -> Some(#(x, Stack(rest)))
    }
