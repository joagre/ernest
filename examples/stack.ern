//
// Abstract stack
//
// The abstract type of the guide, §7.2 (and the report, §4.4), plus a small
// main that uses it. Another module sees the type Stack and its three
// operations, never its constructor; this module's own definitions, main
// among them, may use it. The main is not from the guide.
//
// Needs MVP 1, and is one of its test programs.
//

export abstract type Stack(a) = Stack(List(a))

export fn main() -> Unit with Never = {
    let s = Stack.push(2, Stack.push(1, Stack.empty));
    match Stack.pop(s) {
        Some(#(top, _)) -> Io.println("top is " <> Int.toString(top))
      | None -> Io.println("empty")
    }
}

export let Stack.empty : Stack(a) = Stack([])
export fn Stack.push(x : a, Stack(xs) : Stack(a)) -> Stack(a) = Stack(x :: xs)
export fn Stack.pop(Stack(xs) : Stack(a)) -> Optional(#(a, Stack(a))) =
    match xs { [] -> None | x :: rest -> Some(#(x, Stack(rest))) }
