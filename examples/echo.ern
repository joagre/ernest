//
// An echo server and a client that measures it: the server accepts one
// connection and writes back what it reads, the client sends a message and
// waits for it to come back, and the program prints how long its round
// trips take once the server has ended. It is the measurement the plan asks of Tcp (report
// Appendix E.18), where each socket is a process.
//
// Compiles and runs since 2026-09-20; it is not an integration test, since
// its output is a measurement rather than a fixed line.
//

type Msg = Served(Down)

export fn main() : Unit with Msg = {
    let port = 7345;
    match Tcp.listen("127.0.0.1", port) {
        Left(_) -> Io.printlnError("cannot listen")
      | Right(listener) -> {
            let _ = spawnMonitored(Local, fn() = serve(listener), Served);
            match Tcp.connect("127.0.0.1", port, 1000) {
                Left(_) -> Io.printlnError("cannot connect")
              | Right(socket) -> {
                    let rounds = 2000;
                    let started = Clock.now();
                    let _ = roundTrips(socket, rounds);
                    let elapsed = Clock.now() - started;
                    Tcp.close(socket);
                    Tcp.closeListener(listener);
                    // the server ends once it reads the closed connection
                    receive {
                        Served(_) -> Unit
                    };
                    Io.println(Int.toString(rounds)
                                   <> " round trips in "
                                   <> Int.toString(elapsed)
                                   <> " ms")
                }
            }
        }
    }
}

// The round trips stop at the first write or read that fails.
fn roundTrips(socket : Address(Tcp.SocketMsg), left : Int) : Either(Io.Error, Unit) with m =
    if left <= 0 then
        Right(Unit)
    else {
        let _ <- Tcp.write(socket, String.toUtf8("ping"));
        let _ <- Tcp.read(socket, 5000);
        roundTrips(socket, left - 1)
    }

fn serve(listener : Address(Tcp.ListenerMsg)) : Unit with Never =
    match Tcp.accept(listener, 5000) {
        Right(socket) -> echo(socket)
      | Left(_) -> Unit
    }

// A socket lives until it is closed, so the server closes the one whose
// connection has ended, which a read or a write tells it (report Appendix
// E.18).
fn echo(socket : Address(Tcp.SocketMsg)) : Unit with Never =
    match Tcp.read(socket, 5000) {
        Right(bytes) -> match Tcp.write(socket, bytes) {
            Right(_) -> echo(socket)
          | Left(_) -> Tcp.close(socket)
        }
      | Left(_) -> Tcp.close(socket)
    }
