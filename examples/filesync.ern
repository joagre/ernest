//
// Paper program 2: file sync
//
// Written against the Ernest report, September 2026. Two directories are kept
// identical; changes are sent to the peer; conflicts are saved as an extra
// file. The peer is an Address, and the code is the same whether it lives on
// the same node or not.
//
// Assumptions. Fs and Clock are the standard library's system modules (report
// Appendix E) over Sys.fs and Sys.clock (§8.2); Path, Entry, and IoError are
// the prelude's (§9.3). errorText is a hand-written rendering for stdout,
// todo("on paper") here. main runs syncer a itself so the program keeps
// running (report §8.6).
//
// Compiles and type-checks since 2026-09-20; it is not run under test yet,
// since it runs until it is stopped.
//

//
// Types
//

type Change = Change(path : Path, mtime : Int)

type Ack = Stored | Conflict | Failed(IoError)

type SyncMsg
    = Link(Address(SyncMsg))
    | Tick
    | Listed(Either(IoError, List(Entry)))
    | Put(path : Path, mtime : Int, bytes : Bytes, ack : Reply(Ack))

//
// Program
//

export fn main() -> Unit with SyncMsg = {
    let me = self();
    let b = spawn(Local, fn() = start(Path("b")));
    send(b, Link(me));
    send(me, Link(b));
    start(Path("a"))
}

//
// Processes
//

// Waiting phase: receive the peer's address, then the loop.
fn start(dir : Path) -> Unit with SyncMsg = receive {
    Link(peer) -> { send(self(), Tick); syncer(dir, peer, Map.empty) }
}

// The sync process: one per directory.
fn syncer(dir : Path, peer : Address(SyncMsg), seen : Map(Path, Int)) -> Unit with SyncMsg =
    receive {
        Tick -> {
            let me = self();
            let _ = spawn(Local, fn() -> Unit with Never = send(me, Listed(Fs.list(dir, 10000))));
            listing(dir, peer, seen)
        }
      | Put(path = p, mtime = m, bytes = bytes, ack = ack) -> {
            store(dir, seen, p, m, bytes, ack);
            syncer(dir, peer, Map.put(seen, p, m))
        }
      | Listed(_) -> syncer(dir, peer, seen) // late listing, ignore
      | Link(_) -> syncer(dir, peer, seen) // already connected
    }

// Between the listing's start and Listed: accept Put, but not Tick.
fn listing(dir : Path, peer : Address(SyncMsg), seen : Map(Path, Int)) -> Unit with SyncMsg = {
    let tick = fn() = Clock.alarm(5000, fn(_) = Tick);
    receive {
        Listed(Right(entries)) -> {
            List.foreach(diff(seen, entries), fn(c) = {
                let _ = spawn(Local, fn() = pusher(dir, peer, c));
                Unit
            });
            tick();
            syncer(dir, peer, snapshot(entries))
        }
      | Listed(Left(e)) -> {
            Io.println("cannot list " <> Path.toString(dir) <> ": " <> errorText(e));
            tick();
            syncer(dir, peer, seen)
        }
      | Put(path = p, mtime = m, bytes = bytes, ack = ack) -> {
            store(dir, seen, p, m, bytes, ack);
            listing(dir, peer, Map.put(seen, p, m))
        }
    }
}

// Store a file from the peer. Newer local file: conflict.
fn store(
    dir : Path,
    seen : Map(Path, Int),
    p : Path,
    m : Int,
    bytes : Bytes,
    ack : Reply(Ack)
) -> Unit with SyncMsg =
    match Map.get(seen, p) {
        Some(local) when local > m -> {
            let _ = spawn(Local, fn() =
                writer(Path.join(dir, conflictPath(p)), bytes, ack, Conflict));
            Unit
        }
      | _ -> {
            let _ = spawn(Local, fn() = writer(Path.join(dir, p), bytes, ack, Stored));
            Unit
        }
    }

// One process per write: waits for fs and answers the peer.
fn writer(p : Path, bytes : Bytes, ack : Reply(Ack), okAck : Ack) -> Unit with n =
    match Fs.write(p, bytes, 10000) {
        Right(Unit) -> answer(ack, okAck)
      | Left(e) -> answer(ack, Failed(e))
    }

// One process per changed file: reads and sends to the peer.
fn pusher(
    dir : Path,
    peer : Address(SyncMsg),
    Change(path = p, mtime = m) : Change
) -> Unit with n =
    match Fs.read(Path.join(dir, p), 10000) {
        Right(bytes) -> push(peer, p, m, bytes)
      | Left(e) -> Io.println("cannot read " <> Path.toString(p) <> ": " <> errorText(e))
    }

fn push(peer : Address(SyncMsg), p : Path, m : Int, bytes : Bytes) -> Unit with n =
    match Address.call(peer, fn(r) = Put(path = p, mtime = m, bytes = bytes, ack = r), 30000) {
        Some(Stored) -> Unit
      | Some(Conflict) -> Io.println("conflict: " <> Path.toString(p))
      | Some(Failed(_)) -> Io.println("the peer failed: " <> Path.toString(p))
      | None -> Io.println("the peer is not answering: " <> Path.toString(p))
    }

//
// Pure helpers
//

// What has changed since the last snapshot?
fn diff(old : Map(Path, Int), entries : List(Entry)) -> List(Change) =
    List.filterMap(entries, fn(e) = changed(old, e))

fn changed(old : Map(Path, Int), Entry(path = p, mtime = m) : Entry) -> Optional(Change) =
    match Map.get(old, p) {
        None -> Some(Change(path = p, mtime = m))
      | Some(m0) -> if m > m0 then Some(Change(path = p, mtime = m)) else None
    }

fn snapshot(entries : List(Entry)) -> Map(Path, Int) =
    List.foldLeft(entries, Map.empty, fn(acc, Entry(path = p, mtime = m)) = Map.put(acc, p, m))

fn conflictPath(p : Path) -> Path = Path(Path.toString(p) <> ".conflict")

fn errorText(e : IoError) -> String = todo("on paper")
