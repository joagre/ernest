/// Shapes in the plane and their areas.
///
/// Use it where a program measures what it draws. A shape is a point alone
/// or a circle around one, and `area` is the one operation every shape
/// supports. Where shapes are only kept, in any order, a `List` of them
/// serves.
///
/// Coordinates and radii are whole units, and an area is a `Float`.
///
/// `Stack` keeps shapes in the order they were pushed. A stack is a value:
/// `push` and `pop` answer a new stack and leave the one given as it was.
///
/// ## Examples
///
/// A shape and its area:
///
/// ```ernest
/// {
///     let circle = Template.circle(Template.Point(x = 0, y = 0), 2);
///     Template.area(circle)
/// }
/// // => 12.566370614359172
/// ```
///
/// A stack of shapes, pushed and popped:
///
/// ```ernest
/// {
///     let stack = Template.push(Template.emptyStack, Template.Dot(Template.Point(x = 1, y = 1)));
///     match Template.pop(stack) {
///         Some(#(top, _)) -> Template.area(top)
///       | None -> -1.0
///     }
/// }
/// // => 0.0
/// ```
///
/// ## See also
///
/// `Float` (Appendix E.9) for the arithmetic of an area.
///
/// since 0.1.0

/// A point in the plane, in whole units.
///
/// ### Examples
///
/// ```ernest
/// Template.Point(x = 1, y = 2)
/// // => Point(x = 1, y = 2)
/// ```
export type Point = Point(
    /// The horizontal coordinate, growing to the right.
    x : Int,
    /// The vertical coordinate, growing upward.
    y : Int)

/// A shape: a point alone, or a circle of a radius around a centre.
///
/// ### Examples
///
/// ```ernest
/// Template.Circle(centre = Template.Point(x = 0, y = 0), radius = 1)
/// // => Circle(centre = Point(x = 0, y = 0), radius = 1)
/// ```
export type Shape =
    /// A point alone; its area is zero.
    Dot(Point)
  /// A circle by its centre and radius.
  | Circle(centre : Point, radius : Int)

/// Shapes in the order they were pushed, most recent on top. The
/// representation is private.
///
/// ### Examples
///
/// ```ernest
/// Template.push(Template.emptyStack, Template.Dot(Template.Point(x = 0, y = 0)))
/// ```
///
/// ### See also
///
/// `List` (Appendix E.2), which a stack is a restriction of.
export abstract type Stack = Stack(List(Shape))

/// The stack with nothing on it.
///
/// since 0.2.0
export let emptyStack = Stack([])

/// The stack with the shape on top.
///
/// since 0.2.0
export fn push(Stack(shapes) : Stack, shape : Shape) : Stack =
    Stack(shape :: shapes)

/// The top shape and the stack without it, or `None` when the stack is
/// empty. The stack given is left as it was.
///
/// ### Examples
///
/// ```ernest
/// Optional.isNone(Template.pop(Template.emptyStack))
/// // => true
/// ```
///
/// since 0.2.0
export fn pop(Stack(shapes) : Stack) : Optional(#(Shape, Stack)) =
    match shapes {
        [] -> None
      | top :: rest -> Some(#(top, Stack(rest)))
    }

/// The circle of the radius around the centre.
export fn circle(centre : Point, radius : Int) : Shape =
    Circle(centre = centre, radius = radius)

/// The area of the shape. A point's is zero, and a circle's is pi times
/// its radius squared.
///
/// ### See also
///
/// `circle`, which builds the shape whose area is not zero.
export fn area(shape : Shape) : Float =
    match shape {
        Dot(_) -> 0.0
      | Circle(radius = radius) -> Float.pi * Int.toFloat(radius * radius)
    }

/// The radius of a circle of that diameter, rounded toward zero.
///
/// ### Errors
///
/// Faults on a negative diameter, with the cause `negative diameter`. It
/// is the one fault in this module.
///
/// ### Examples
///
/// ```ernest
/// Template.radius(9)
/// // => 4
/// ```
export fn radius(diameter : Int) : Int =
    if diameter < 0 then fault("negative diameter") else half(diameter)

/// Half of a whole number, toward zero, which `radius` takes of a
/// diameter.
///
/// ### Examples
///
/// ```ernest
/// half(7)
/// // => 3
/// ```
fn half(number : Int) : Int =
    number / 2
