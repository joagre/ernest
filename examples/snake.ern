//
// Paper program 3: tick game
//
// Written against the Ernest report, September 2026. A multiplayer snake game
// in the terminal: the world is updated ten times per second, players send
// directions between ticks, apples appear at random, scores are counted. The
// aim is to hit local state in pure code, time drift, input faster than ticks,
// and randomness in pure code through a threaded seed rather than a hidden
// source.
//
// Assumptions. Terminal, Clock, and Random are the standard library's
// (report Appendix E); Terminal.Event and Terminal.Size are the module's.
// main runs the game loop itself so that the world is one value in one
// place, and while it runs the program keeps running (report §8.6).
//
// Compiled under test since 2026-09-20, and played under a pseudo-terminal by
// test/ern_terminal_tests.erl since the same day, since it reads keys from a
// terminal and runs until Escape.
//

//
// Types
//

type Dir = N | S | W | E
type Pos = Pos(x : Int, y : Int)

type Player = Player(id : Int, body : List(Pos), dir : Dir, score : Int, alive : Bool)

type World = World(
    w : Int,
    h : Int,
    players : Map(Int, Player),
    apples : List(Pos),
    seed : Random.Seed,
    tick : Int
)

type Input = Turn(id : Int, dir : Dir) | Leave(Int)

type GameMsg = Tick | In(Input)

//
// Program
//

export fn main() -> Unit with GameMsg = {
    // report §8.2: the board is the window the program was given. It keeps
    // that size: a `Resized` is ignored, the snake and the apples being
    // placed for the board they are on.
    let #(w, h) = board();
    let world0 =
        World(w = w, h = h, players = Map.empty, apples = [], seed = Random.seed(42), tick = 0);
    let me = self();
    // report §8.2: the keys are the game's input, so without a terminal
    // the player leaves, and with the last player the game is over
    let _ = spawn(Local, fn() = match Terminal.subscribe(fn(e) = e) {
        Right(_) -> player(1, me)
      | Left(_) -> {
            Io.printlnError("snake needs a terminal, since its keys are the game's input");
            send(me, In(Leave(1)))
        }
    });
    game(addPlayer(world0, 1))
}

//
// Processes
//

fn game(world : World) -> Unit with GameMsg = {
    Clock.alarm(100, fn(_) = Tick);
    receive {
        Tick -> {
            let world2 = step(drain(world, 64));
            Io.print(render(world2));
            // the last player left, so the game is over (report §8.6)
            if Map.isEmpty(world2.players) then Unit else game(world2)
        }
    }
}

// Drain the mailbox of input without blocking; at most n per tick.
fn drain(world : World, n : Int) -> World with GameMsg =
    if n == 0 then world
    else receive {
        In(i) -> drain(applyInput(world, i), n - 1)
      | after 0 -> world
    }

// One process per player: translates keys into Input.
fn player(id : Int, game : Address(GameMsg)) -> Unit with Terminal.Event = receive {
    Terminal.ArrowUp -> { send(game, In(Turn(id = id, dir = N))); player(id, game) }
  | Terminal.ArrowDown -> { send(game, In(Turn(id = id, dir = S))); player(id, game) }
  | Terminal.ArrowLeft -> { send(game, In(Turn(id = id, dir = W))); player(id, game) }
  | Terminal.ArrowRight -> { send(game, In(Turn(id = id, dir = E))); player(id, game) }
  | Terminal.Escape -> send(game, In(Leave(id)))
  | _ -> player(id, game)
}

// The board: the window the program was given, a row kept for the status
// line, and a size to fall back on where there is no terminal.
fn board() -> #(Int, Int) with m = match Terminal.size() {
    None -> #(40, 20)
  | Some(Terminal.Size(rows = rows, columns = columns)) -> #(Int.min(columns, 80), rows - 2)
}

//
// Pure world logic
//

// One tick: move everyone, eat apples, collide, refill apples.
// Three counters change: score per player, apples left, tick.
fn step(world : World) -> World = {
    fn movePlayer(#(acc, apples), _, p) = match p {
        Player(alive = false) or Player(body = []) -> #(acc, apples)
      | Player(body = head :: rest, dir = d, score = s) -> {
            let next = move(world.w, world.h, head, d);
            let ate = List.contains(apples, next);
            let #(body, s2) =
                if ate then #(next :: head :: rest, s + 1)
                else #(next :: head :: List.dropLast(rest), s);
            let p2 = Player(..p, body = body, score = s2);
            #(Map.put(acc, p.id, p2), List.remove(apples, next))
        }
    };
    let #(ps2, apples2) = Map.foldLeft(world.players, #(world.players, world.apples), movePlayer);
    let ps3 = Map.map(ps2, fn(_, p) = collide(ps2, p));
    let #(apples3, seed2) = refill(world.w, world.h, Map.size(ps3), apples2, world.seed);
    World(..world, players = ps3, apples = apples3, seed = seed2, tick = world.tick + 1)
}

fn applyInput(world : World, input : Input) -> World = match input {
    Turn(id = id, dir = d) -> match Map.get(world.players, id) {
        Some(p) -> World(..world, players = Map.put(world.players, id, turn(p, d)))
      | None -> world
    }
  | Leave(id) -> World(..world, players = Map.remove(world.players, id))
}

fn collide(ps : Map(Int, Player), p : Player) -> Player = match p {
    Player(body = head :: _, alive = true) ->
        if List.any(Map.values(ps), fn(q) = List.contains(tailOf(q), head))
        then Player(..p, alive = false) else p
  | _ -> p
}

fn refill(w : Int, h : Int, want : Int, apples : List(Pos), seed : Random.Seed)
    -> #(List(Pos), Random.Seed) =
    if List.size(apples) >= want then #(apples, seed)
    else {
        let #(x, s1) = Random.next(seed, w - 1);
        let #(y, s2) = Random.next(s1, h - 1);
        refill(w, h, want, Pos(x = x, y = y) :: apples, s2)
    }

fn addPlayer(world : World, id : Int) -> World = {
    let #(pos, seed2) = freePos(world, world.seed);
    let p = Player(id = id, body = [pos], dir = E, score = 0, alive = true);
    World(..world, players = Map.put(world.players, id, p), seed = seed2)
}

fn freePos(world : World, seed : Random.Seed) -> #(Pos, Random.Seed) = {
    let #(x, s1) = Random.next(seed, world.w - 1);
    let #(y, s2) = Random.next(s1, world.h - 1);
    let pos = Pos(x = x, y = y);
    if taken(world, pos) then freePos(world, s2) else #(pos, s2)
}

fn taken(world : World, pos : Pos) -> Bool =
    List.contains(world.apples, pos)
        || List.any(Map.values(world.players), fn(p) = List.contains(p.body, pos))

// The whole screen every tick: the terminal is cleared and drawn from the top,
// so a tick's picture replaces the one before it.
fn render(world : World) -> String = {
    let row = fn(y) = String.fromList(List.map(List.range(0, world.w - 1),
        fn(x) = cell(world.players, world.apples, Pos(x = x, y = y))));
    let rows = List.map(List.range(0, world.h - 1), row);
    "\u{1b}[H\u{1b}[2J" <> String.join(rows, "\n") <> "\n"
        <> status(world.players, world.tick) <> "\n"
}

fn cell(ps : Map(Int, Player), apples : List(Pos), pos : Pos) -> Char =
    if List.any(Map.values(ps), fn(p) = headOf(p) == Some(pos)) then '@'
    else if List.any(Map.values(ps), fn(p) = List.contains(p.body, pos)) then 'o'
    else if List.contains(apples, pos) then '*'
    else '.'

fn status(ps : Map(Int, Player), t : Int) -> String =
    "tick " <> Int.toString(t) <> "   "
        <> String.join(List.map(Map.values(ps), scoreText), "   ")
        <> "   (arrows steer, Escape leaves)"

fn scoreText(p : Player) -> String =
    "player " <> Int.toString(p.id) <> ": " <> Int.toString(p.score)
        <> (if p.alive then "" else " (dead)")

fn headOf(p : Player) -> Optional(Pos) = match p.body { head :: _ -> Some(head) | [] -> None }

//
// Small helpers
//

fn move(w : Int, h : Int, Pos(x = x, y = y) : Pos, d : Dir) -> Pos = match d {
    N -> Pos(x = x, y = (y + h - 1) % h)
  | S -> Pos(x = x, y = (y + 1) % h)
  | W -> Pos(x = (x + w - 1) % w, y = y)
  | E -> Pos(x = (x + 1) % w, y = y)
}

fn turn(p : Player, d : Dir) -> Player = match #(p.dir, d) {
    #(N, S) -> p | #(S, N) -> p | #(W, E) -> p | #(E, W) -> p // no U-turn
  | _ -> Player(..p, dir = d)
}

fn tailOf(p : Player) -> List(Pos) = match p.body { _ :: rest -> rest | [] -> [] }
