//
// Snake
//
// A snake game in the terminal: the world, which holds its players by
// number, is updated ten times a second, the player sends directions
// between ticks, apples appear at random on free cells, and scores are
// counted. It holds local state in pure code, keeps its ticks to a
// deadline so that they do not drift, takes input faster than ticks, and
// draws its randomness in pure code through a threaded seed rather than a
// hidden source.
//
// Terminal, Clock, and Random are the standard library's (report Appendix
// E), and Ansi is libs/ansi's (Appendix G.3), on the load path where the
// program is built and run; Terminal.Event and Terminal.Size are the
// module's. main runs the game loop itself so that the world is one value
// in one place, and while it runs the program keeps running (report §8.6).
//
// Compiled under test since 2026-09-20, and played under a pseudo-terminal by
// test/ern_terminal_tests.erl since the same day, since it reads keys from a
// terminal and runs until Escape or C-c.
//

//
// Types
//

type Direction = North | South | West | East

type Point = Point(x : Int, y : Int)

// A player: `direction` is where it goes next, and `moved` where it went at
// the last tick, which a turn may not reverse.
type Player =
    Player(id : Int,
           body : List(Point),
           direction : Direction,
           moved : Direction,
           score : Int,
           alive : Bool)

type World =
    World(width : Int,
          height : Int,
          players : Map(Int, Player),
          apples : List(Point),
          seed : Random.Seed,
          tick : Int)

type Input = Turn(id : Int, direction : Direction) | Leave(Int)

type GameMsg = Ticked | Played(Input) | Joined(Int)

//
// Program
//

export fn main() : Unit with GameMsg = {
    // report §8.2: the board is the window the program was given. It keeps
    // that size: a `Resized` is ignored, the snake and the apples being
    // placed for the board they are on.
    let #(width, height) = board();
    let world =
        World(width = width,
              height = height,
              players = Map.empty,
              apples = [],
              seed = Random.seed(42),
              tick = 0);
    let me = self();
    // report §8.2: the keys are the game's input, so the game begins once
    // the player has the terminal's keys, and without them the program
    // ends before it draws
    let _ = spawn(fn() = match Terminal.subscribe(fn(event) = event) {
        Right(_) -> {
            send(me, Joined(1));
            steering(1, me)
        }
      | Left(_) -> {
            Io.printlnError("snake needs a terminal, since its keys are the game's input");
            Os.exit(1)
        }
    });
    receive {
        Joined(id) -> game(addPlayer(world, id), Clock.monotonic() + tickMs)
    }
}

// The time between ticks, ten a second.
let tickMs = 100

//
// Processes
//

// Each tick is due at a deadline on the monotonic clock, and its alarm
// waits what is left of it, so that the time a tick's work takes does not
// put off the ticks after it (report Appendix E.15).
fn game(world : World, deadline : Int) : Unit with GameMsg = {
    Clock.alarm(Int.max(deadline - Clock.monotonic(), 0), fn(_) = Ticked);
    receive {
        Ticked -> {
            let world1 = step(drain(world, 64));
            Io.print(render(world1));
            // the last player left, so the game is over (report §8.6)
            if Map.isEmpty(world1.players) then Unit else game(world1, deadline + tickMs)
        }
    }
}

// Drain the mailbox of input without blocking; at most `count` per tick.
fn drain(world : World, count : Int) : World with GameMsg =
    if count == 0 then
        world
    else receive {
        Played(input) -> drain(applyInput(world, input), count - 1)
      | after 0 -> world
    }

// One process per player: translates keys into Input.
fn steering(id : Int, game : Address(GameMsg)) : Unit with Terminal.Event =
    receive {
        Terminal.Escape or Terminal.Interrupt -> send(game, Played(Leave(id)))
      | event -> {
            match directionOf(event) {
                Some(direction) -> send(game, Played(Turn(id = id, direction = direction)))
              | None -> Unit
            };
            steering(id, game)
        }
    }

// The direction an arrow key steers, and none for any other key.
fn directionOf(event : Terminal.Event) : Optional(Direction) =
    match event {
        Terminal.ArrowUp -> Some(North)
      | Terminal.ArrowDown -> Some(South)
      | Terminal.ArrowLeft -> Some(West)
      | Terminal.ArrowRight -> Some(East)
      | _ -> None
    }

// The board: the window the program was given, two rows kept for the
// status line and the line feed after it, and a size to fall back on
// where there is no terminal.
fn board() : #(Int, Int) with m =
    match Terminal.size() {
        Left(_) -> #(40, 20)
      | Right(Terminal.Size(rows = rows, columns = columns)) -> #(Int.min(columns, 80), rows - 2)
    }

//
// Pure world logic
//

// One tick: move everyone, eat apples, collide, refill apples.
// Three counters change: score per player, apples left, tick.
fn step(world : World) : World = {
    fn movePlayer(#(acc, apples), _, player) =
        match player {
            Player(alive = false) or Player(body = []) -> #(acc, apples)
          | Player(body = head :: rest, direction = direction, score = score) -> {
                let next = move(world.width, world.height, head, direction);
                let ate = List.contains(apples, next);
                let #(body, score1) = if ate then
                    #(next :: head :: rest, score + 1)
                else
                    #(next :: head :: List.dropLast(rest, 1), score);
                let moved = Player(..player, body = body, moved = direction, score = score1);
                #(Map.put(acc, player.id, moved), List.remove(apples, next))
            }
        };
    let #(moved, left) = Map.foldLeft(world.players, #(world.players, world.apples), movePlayer);
    let collided = Map.map(moved, fn(_, player) = collide(moved, player));
    refill(World(..world, players = collided, apples = left, tick = world.tick + 1),
           Map.size(collided))
}

fn applyInput(world : World, input : Input) : World =
    match input {
        Turn(id = id, direction = direction) -> match Map.get(world.players, id) {
            Some(player) ->
                World(..world, players = Map.put(world.players, id, turn(player, direction)))
          | None -> world
        }
      | Leave(id) -> World(..world, players = Map.remove(world.players, id))
    }

fn collide(players : Map(Int, Player), player : Player) : Player =
    match player {
        Player(body = head :: _, alive = true) ->
            if List.any(Map.values(players), fn(other) = List.contains(tailOf(other), head)) then
                Player(..player, alive = false)
            else
                player
      | _ -> player
    }

// Apples added on free cells until there are as many as wanted, or until
// no cell is free.
fn refill(world : World, wanted : Int) : World =
    if List.size(world.apples) >= wanted then
        world
    else match freePoint(world) {
        Some(#(point, seed)) ->
            refill(World(..world, apples = point :: world.apples, seed = seed), wanted)
      | None -> world
    }

fn addPlayer(world : World, id : Int) : World =
    match freePoint(world) {
        Some(#(point, seed)) -> {
            let player =
                Player(id = id,
                       body = [point],
                       direction = East,
                       moved = East,
                       score = 0,
                       alive = true);
            World(..world, players = Map.put(world.players, id, player), seed = seed)
        }
      | None -> world
    }

// A cell no snake and no apple takes, drawn from those there are, and the
// seed after the draw; none where every cell is taken.
fn freePoint(world : World) : Optional(#(Point, Random.Seed)) = {
    let cells =
        List.flatMap(List.range(0, world.height - 1),
                     fn(y) = List.map(List.range(0, world.width - 1), fn(x) = Point(x = x, y = y)));
    match List.filter(cells, fn(point) = !taken(world, point)) {
        [] -> None
      | free -> {
            let #(index, seed) = Random.next(world.seed, List.size(free) - 1);
            Optional.map(List.get(free, index), fn(point) = #(point, seed))
        }
    }
}

fn taken(world : World, point : Point) : Bool =
    List.contains(world.apples, point)
        || List.any(Map.values(world.players), fn(player) = List.contains(player.body, point))

// The whole screen every tick: the terminal is cleared and drawn from the top,
// so a tick's picture replaces the one before it.
fn render(world : World) : String = {
    let rows = List.map(List.range(0, world.height - 1), fn(y) = row(world, y));
    Ansi.clearScreen <> String.join(rows, "\n") <> "\n" <> status(world.players, world.tick) <> "\n"
}

// A row of the board, a character for each of its cells.
fn row(world : World, y : Int) : String =
    String.fromList(List.map(List.range(0, world.width - 1),
                             fn(x) = cell(world.players, world.apples, Point(x = x, y = y))))

fn cell(players : Map(Int, Player), apples : List(Point), point : Point) : Char =
    if List.any(Map.values(players), fn(player) = headOf(player) == Some(point)) then
        '@'
    else if List.any(Map.values(players), fn(player) = List.contains(player.body, point)) then
        'o'
    else if List.contains(apples, point) then
        '*'
    else
        '.'

fn status(players : Map(Int, Player), tick : Int) : String =
    "tick "
        <> Int.toString(tick)
        <> "   "
        <> String.join(List.map(Map.values(players), scoreText), "   ")
        <> "   (arrows steer, Escape leaves)"

fn scoreText(player : Player) : String =
    "player "
        <> Int.toString(player.id)
        <> ": "
        <> Int.toString(player.score)
        <> (if player.alive then "" else " (dead)")

fn headOf(player : Player) : Optional(Point) =
    match player.body {
        head :: _ -> Some(head)
      | [] -> None
    }

//
// Small helpers
//

fn move(width : Int, height : Int, Point(x = x, y = y) : Point, direction : Direction) : Point =
    match direction {
        North -> Point(x = x, y = (y + height - 1) % height)
      | South -> Point(x = x, y = (y + 1) % height)
      | West -> Point(x = (x + width - 1) % width, y = y)
      | East -> Point(x = (x + 1) % width, y = y)
    }

// No U-turn: a turn may not reverse the last move, which two turns within
// one tick would otherwise do.
fn turn(player : Player, direction : Direction) : Player =
    match #(player.moved, direction) {
        #(North, South) or #(South, North) or #(West, East) or #(East, West) -> player
      | _ -> Player(..player, direction = direction)
    }

fn tailOf(player : Player) : List(Point) =
    match player.body {
        _ :: rest -> rest
      | [] -> []
    }

//
// Tests, run by `ern test`
//

let noUTurn =
    Test.Case(name = "two turns within a tick do not reverse the last move", run = fn() = {
        let player =
            Player(id = 1,
                   body = [Point(x = 1, y = 0), Point(x = 0, y = 0)],
                   direction = East,
                   moved = East,
                   score = 0,
                   alive = true);
        Test.equal(turn(turn(player, North), West).direction, North)
    })

let applesOnFreeCells =
    Test.Case(name = "an apple goes on a free cell, and none where every cell is taken",
              run = fn() = {
                  let body = [Point(x = 0, y = 0), Point(x = 1, y = 0), Point(x = 0, y = 1)];
                  let player =
                      Player(id = 1,
                             body = body,
                             direction = East,
                             moved = East,
                             score = 0,
                             alive = true);
                  let almostFull =
                      World(width = 2,
                            height = 2,
                            players = Map.fromList([#(1, player)]),
                            apples = [],
                            seed = Random.seed(7),
                            tick = 0);
                  let full = World(..almostFull, apples = [Point(x = 1, y = 1)]);
                  Test.equal(#(refill(almostFull, 1).apples, refill(full, 2).apples),
                             #([Point(x = 1, y = 1)], [Point(x = 1, y = 1)]))
              })
