//
// Shout: a TCP server
//
// A server that answers each line it is sent in capitals, until it is
// stopped. Each connection it accepts is served by a process of its own, so
// a slow client holds up no other.
//
// What to look at:
//
// - A socket is a process, and its address is how the program talks to it:
//   `Tcp.read`, `Tcp.write` and `Tcp.close` take the address (report
//   Appendix E.18).
// - Port 0 asks the system for a free port, and `Tcp.port` says which it
//   gave, so the server never collides with another on a fixed one.
// - `serve` answers each whole line, since a read answers what has arrived
//   so far, which may be part of a line or more than one.
// - The process that accepts a connection owns its socket, and `Tcp.give`
//   hands it to the process that serves it, so that the socket is closed
//   when that process ends, however it ends.
// - Every wait has a limit in milliseconds, and an error is a value: a
//   connection silent for a minute, or one the client has closed, is
//   closed here too.
//
// Run it from this directory, and talk to it from a second terminal on the
// port it prints, a line at a time:
//
//     ern build shout.ern
//     ern run shout.erc
//     nc 127.0.0.1 PORT
//

export fn main() : Unit =
    match Tcp.listen("127.0.0.1", 0) {
        Left(error) -> {
            Io.printlnError("shout: cannot listen: " <> Io.show(error));
            Os.exit(1)
        }
      | Right(listener) ->
            match Tcp.port(listener) {
                Left(error) -> {
                    Io.printlnError("shout: no port: " <> Io.show(error));
                    Os.exit(1)
                }
              | Right(port) -> {
                    Io.println("listening on 127.0.0.1:" <> Int.toString(port));
                    accepting(listener)
                }
            }
    }

// Accepts connections for as long as the program runs, each served by a
// process of its own.
fn accepting(listener : Address(Tcp.ListenerMsg)) : Unit =
    match Tcp.accept(listener, 60000) {
        Right(socket) -> {
            let server = spawn(fn() = serve(socket, <<>>));
            Tcp.give(socket, Process.fromAddress(server));
            accepting(listener)
        }
      | Left(Io.Timeout) ->
            accepting(listener)
      | Left(error) ->
            Io.printlnError("shout: cannot accept: " <> Io.show(error))
    }

// Answers each line that has arrived, and reads for more, until the client
// closes the connection or falls silent.
fn serve(socket : Address(Tcp.SocketMsg), received : Bytes) : Unit =
    match Bytes.indexOf(received, newline) {
        Some(end) ->
            match Tcp.write(socket, shouted(Bytes.slice(received, 0, end)), 5000) {
                Right(Unit) -> serve(socket, Bytes.slice(received, end + 1, Bytes.size(received)))
              | Left(_) -> Tcp.close(socket)
            }
      | None ->
            match Tcp.read(socket, 60000) {
                Right(more) -> serve(socket, received <> more)
              | Left(_) -> Tcp.close(socket)
            }
    }

// A line in capitals, with its line feed; a line that is not UTF-8 text is
// answered as it came.
fn shouted(line : Bytes) : Bytes =
    match String.fromUtf8(line) {
        Some(text) -> String.toUtf8(String.toUpper(text)) <> newline
      | None -> line <> newline
    }

let newline : Bytes = String.toUtf8("\n")
